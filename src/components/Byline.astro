---
interface Props {
  updatedDate?: string;
  readingMinutes?: number;
}

// "Next review <date>" was removed 2026-10-01: a dated review promise is a forward
// commitment, which the editorial policy does not make. Dates are YYYY-MM-DD and
// formatted in UTC, so a build in a US timezone does not print the previous day.
// Both callers pass a pricing verified_date (the tool's own, or the newest among a
// trade's tools), not the date the page last changed, so the label says "Latest price
// check" rather than "Last updated" (2026-10-01).
const { updatedDate, readingMinutes } = Astro.props;
const fmt = (d: string) => new Date(d + 'T00:00:00Z').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<div class="mb-6 border-y border-slate-200 py-3 text-sm text-slate-500">
  <div class="font-medium text-slate-700">
    By the <a href="/about/" class="underline decoration-slate-300 underline-offset-2 hover:text-orange-600 hover:decoration-orange-400">WrenchStack editorial desk</a>
    <span aria-hidden="true" class="text-slate-300">·</span>
    <a href="/methodology/" class="underline decoration-slate-300 underline-offset-2 hover:text-orange-600 hover:decoration-orange-400">Independent: no vendor pays for placement</a>
  </div>
  <div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1">
    {updatedDate && (
      <span>Latest price check <time datetime={updatedDate}>{fmt(updatedDate)}</time></span>
    )}
    {readingMinutes && (
      <>{updatedDate && <span aria-hidden="true">·</span>}<span>{readingMinutes} min read</span></>
    )}
  </div>
</div>
