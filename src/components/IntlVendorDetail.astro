---
import Layout from '../layouts/Layout.astro';
import { INTL_CATEGORY_LABELS, INTL_MARKETS, intlNote, intlTierMeta, intlVendorIndex, type IntlVendor, type IntlMarket } from '../lib/intl';
import { asSentence, intlOutboundUrl, getTool, getLeadGenPlatform, getInsuranceProvider } from '../lib/data';

interface Props {
  vendor: IntlVendor;
  market: IntlMarket;
  siblings: IntlVendor[];
}
const { vendor, market, siblings } = Astro.props;

const categoryLabel = INTL_CATEGORY_LABELS[vendor.category] ?? vendor.category;
const note = intlNote(vendor, market);
const tier = intlTierMeta(vendor.tier);

// Related vendors: same category first, then the rest of the market.
const sameCategory = siblings.filter((s) => s.category === vendor.category);
const otherCategory = siblings.filter((s) => s.category !== vendor.category);
const related = [...sameCategory, ...otherCategory].slice(0, 6);

// Keep titles short + drop the duplicate market name. Certifications aren't
// "reviewed", so give them a neutral form.
const pageTitle = vendor.category === 'certification'
  ? `${vendor.name}: ${categoryLabel} in ${market.name} (2026)`
  : `${vendor.name} ${market.name} Review (2026): ${categoryLabel}`;
const pageDescription = `${vendor.name} for ${market.name} trades: ${asSentence(vendor.tagline)} Market position, ${note ? `${market.name}-specific notes, ` : ''}pros and cons, and typical pricing. Independent WrenchStack review.`;

// The cross-market link points at a US page (/tools/, /lead-gen/, /insurance/) or, for
// a few vendors, at another market's page (an Irish entry links to /uk/). It is not
// always the same company: HomeStars (Canada) links to the page of its parent, Angi.
// The button and FAQ used to call every target "US market context" and the FAQ said
// the vendor itself operates outside the market; they now name the linked page
// (2026-10-01). The "Cross-market vendor" header badge was removed the same day, as on
// the country hubs (51af381): 94 of the 119 flagged vendors have no linked page, and
// for HomeStars (a Canada-focused marketplace) the label was false.
const crossMarketCode = vendor.cross_market_link?.match(/^\/([a-z]{2})\//)?.[1];
const crossMarketName = crossMarketCode && INTL_MARKETS[crossMarketCode] ? INTL_MARKETS[crossMarketCode].name : 'US';
function linkedPageName(link: string | null): string | undefined {
  const m = link?.match(/^\/([a-z-]+)\/([^/]+)\/$/);
  if (!m) return undefined;
  const [, section, slug] = m;
  if (section === 'tools') return getTool(slug)?.name;
  if (section === 'lead-gen') return getLeadGenPlatform(slug)?.name;
  if (section === 'insurance') return getInsuranceProvider(slug)?.name;
  if (INTL_MARKETS[section]) {
    return intlVendorIndex().find((v) => v.url.endsWith(`/${section}/${slug}/`))?.name.replace(/ \([A-Z]{2}\)$/, '');
  }
  return undefined;
}
const crossMarketPage = linkedPageName(vendor.cross_market_link);
const crossMarketLabel = crossMarketPage
  ? `${crossMarketPage} review (${crossMarketName})`
  : `Full review (${crossMarketName} market context)`;

// The affiliate strip shows only when the Visit link is a tracked link (intlOutboundUrl
// routes some cross-market vendors to a US tool's affiliate URL).
const hasTrackedLink = intlOutboundUrl(vendor) !== vendor.vendor_url;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: market.name, url: `/${market.code}/` },
  { name: vendor.name, url: `/${market.code}/${vendor.slug}/` },
];

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${vendor.name} (${market.name})`,
  description: vendor.tagline,
  category: categoryLabel,
};

// Data-derived FAQ (no fabricated facts: built from the vendor's own fields).
const faqs: { q: string; a: string }[] = [
  {
    q: `Is ${vendor.name} a good fit for ${market.name} trades?`,
    a: `${vendor.market_position} ${note}`.trim(),
  },
  {
    q: `What does ${vendor.name} cost in ${market.name}?`,
    a: `${asSentence(vendor.typical_pricing)} Pricing and availability can change by region; confirm current ${market.name} pricing on the vendor's site before committing.`,
  },
];
if (vendor.tier === 'F' && vendor.reputation_flag) {
  faqs.push({ q: `Is ${vendor.name} reputable?`, a: `We flag a caution: ${vendor.reputation_flag} Weigh this against the pros before relying on it.` });
} else if (vendor.tier === 'S') {
  // Tier S means the check found the vendor's own site publishing its prices
  // (intl tier rule, 2026-09-30); it is not a recommendation or a quality rank.
  faqs.push({ q: `Does ${vendor.name} publish its prices?`, a: `Yes. ${vendor.name} is Tier S in our ${market.name} directory, which means our check found its prices published on its own website (see the typical pricing above). The tier is not a quality ranking, so compare it against the alternatives for your trade and region.` });
}
if (vendor.is_cross_market && vendor.cross_market_link && crossMarketPage) {
  faqs.push({ q: `Does WrenchStack have a related page outside ${market.name}?`, a: `Yes: our ${crossMarketName} review of ${crossMarketPage}, linked at the top of this page. Weigh it against the ${market.name} details on this one.` });
}
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs} affiliate={hasTrackedLink}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <article class="mx-auto max-w-4xl px-4 py-12">
    <header class="mb-8">
      <div class="mb-3 flex items-center gap-2">
        <span class="text-xl" aria-hidden="true">{market.flag}</span>
        <p class="text-sm font-semibold uppercase tracking-wider text-orange-600">{categoryLabel} · {market.name}</p>
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">{vendor.name}</h1>
      <p class="mt-3 text-lg italic text-slate-600">{vendor.tagline}</p>

      <div class="mt-5 flex flex-wrap items-center gap-2">
        <span class={`rounded-full px-3 py-1 text-xs font-bold ${tier.badge}`}>Tier {vendor.tier} · {tier.label}</span>
      </div>

      <div class="mt-6 flex flex-wrap gap-3">
        <a href={intlOutboundUrl(vendor)} rel="sponsored nofollow noopener" target="_blank" class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600">Visit {vendor.name} →</a>
        {vendor.cross_market_link && (
          <a href={vendor.cross_market_link} class="rounded-md border border-slate-300 bg-white px-4 py-3 text-sm font-medium text-slate-700 hover:bg-slate-50">{crossMarketLabel}</a>
        )}
        <a href={`/${market.code}/`} class="rounded-md border border-slate-300 bg-white px-4 py-3 text-sm font-medium text-slate-700 hover:bg-slate-50">All {market.name} vendors</a>
      </div>
    </header>

    {vendor.reputation_flag && (
      <section class="mb-8 rounded-lg border-2 border-rose-300 bg-rose-50 p-5">
        <p class="mb-1 text-xs font-bold uppercase tracking-wider text-rose-700">⚠ Reputation warning</p>
        <p class="text-sm text-rose-900 leading-relaxed">{vendor.reputation_flag}</p>
      </section>
    )}

    <section class="mb-8">
      <h2 class="mb-3 text-2xl font-bold text-slate-900">Market position</h2>
      <p class="text-slate-700 leading-relaxed">{vendor.market_position}</p>
    </section>

    {note && (
      <section class="mb-8 rounded-lg bg-slate-50 p-6">
        <h2 class="mb-2 text-lg font-bold text-slate-900">{market.name}-specific note</h2>
        <p class="text-slate-700 leading-relaxed">{note}</p>
      </section>
    )}

    <section class="mb-8 grid gap-5 sm:grid-cols-2">
      <div>
        <h2 class="mb-3 text-sm font-bold uppercase tracking-wider text-emerald-700">Pros</h2>
        <ul class="space-y-2">
          {vendor.pros.map((p) => (
            <li class="rounded-lg border-l-4 border-emerald-400 bg-emerald-50 px-4 py-2 text-sm text-emerald-900 leading-snug">+ {p}</li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="mb-3 text-sm font-bold uppercase tracking-wider text-rose-700">Cons</h2>
        <ul class="space-y-2">
          {vendor.cons.map((c) => (
            <li class="rounded-lg border-l-4 border-rose-400 bg-rose-50 px-4 py-2 text-sm text-rose-900 leading-snug">− {c}</li>
          ))}
        </ul>
      </div>
    </section>

    <section class="mb-8 rounded-lg border border-slate-200 bg-white p-5">
      <h2 class="mb-2 text-sm font-bold uppercase tracking-wider text-slate-500">Typical {market.name} pricing</h2>
      <p class="text-slate-800">{vendor.typical_pricing}</p>
    </section>

    <section class="mb-8 rounded-lg bg-orange-50 p-6">
      <h2 class="mb-2 text-lg font-bold text-slate-900">Why this matters for {market.name} trades</h2>
      <p class="text-sm text-slate-700 leading-relaxed">{market.certContext}</p>
      <p class="mt-2 text-sm text-slate-700 leading-relaxed">{market.intro}</p>
    </section>

    <section class="mb-10">
      <h2 class="mb-5 text-2xl font-bold text-slate-900">Frequently asked</h2>
      <div class="space-y-3">
        {faqs.map((f) => (
          <details class="rounded-lg border border-slate-200 bg-white p-4">
            <summary class="cursor-pointer font-semibold text-slate-900">{f.q}</summary>
            <p class="mt-3 text-slate-700 leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    {/* Certifications have no head-to-head compare pages (excluded from the compare route), so don't link to them; those links 404. */}
    {vendor.category !== 'certification' && sameCategory.length > 0 && (
      <section class="mb-10">
        <h2 class="mb-5 text-2xl font-bold text-slate-900">Compare {vendor.name} head-to-head</h2>
        <div class="grid gap-3 sm:grid-cols-2">
          {sameCategory.map((s) => {
            const [s1, s2] = [vendor.slug, s.slug].sort((x, y) => x.localeCompare(y));
            return (
              <a href={`/${market.code}/compare/${s1}-vs-${s2}/`} class="flex items-center justify-between rounded-lg border border-slate-200 bg-white px-4 py-3 no-underline transition hover:border-orange-300 hover:bg-orange-50">
                <span class="text-sm font-semibold text-slate-900">{vendor.name} <span class="text-slate-400">vs</span> {s.name}</span>
                <span class="text-orange-600" aria-hidden="true">→</span>
              </a>
            );
          })}
        </div>
      </section>
    )}

    {related.length > 0 && (
      <section class="mb-10">
        <h2 class="mb-5 text-2xl font-bold text-slate-900">Other {market.name} vendors</h2>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((s) => (
            <a href={`/${market.code}/${s.slug}/`} class="block rounded-lg border border-slate-200 bg-white p-4 no-underline transition hover:border-orange-300 hover:bg-orange-50">
              <p class="mb-1 font-semibold text-slate-900">{s.name}</p>
              <p class="text-xs text-slate-500 capitalize">{(INTL_CATEGORY_LABELS[s.category] ?? s.category)}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">Browse more</h2>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href={`/${market.code}/`} class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600">{market.flag} All {market.name} vendors</a>
        <a href="/" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">US directory</a>
        <a href="/methodology/" class="rounded-md border border-white/30 bg-white/10 px-5 py-3 text-sm font-semibold text-white hover:bg-white/20">Methodology</a>
      </div>
    </section>
  </article>
</Layout>
