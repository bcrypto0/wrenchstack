---
// Links to third-party review and complaint sources for a vendor. We do not reproduce
// third-party review scores: they change often and could not be verified (policy since
// 2026-09-30). Readers check the current score at the source.
// kind="software" links to G2 and Capterra; the default links to BBB and Trustpilot.
interface Props {
  name: string;
  url: string;
  note?: string;
  kind?: 'vendor' | 'software';
}
const { name, url, note, kind = 'vendor' } = Astro.props;
let domain = '';
try {
  domain = new URL(url).hostname.replace(/^www\./, '');
} catch {
  domain = '';
}
const q = encodeURIComponent(name);
const links =
  kind === 'software'
    ? [
        { label: 'G2 reviews', href: `https://www.g2.com/search?query=${q}` },
        { label: 'Capterra reviews', href: `https://www.capterra.com/search/?query=${q}` },
      ]
    : [
        { label: 'BBB profile search', href: `https://www.bbb.org/search?find_text=${q}` },
        ...(domain ? [{ label: 'Trustpilot reviews', href: `https://www.trustpilot.com/review/${domain}` }] : []),
      ];
---

<section id="ratings" class="mb-10 scroll-mt-8">
  <h2 class="mb-3 text-2xl font-bold text-slate-900">Reviews {kind === 'software' ? 'on review sites' : 'and complaints at the source'}</h2>
  <p class="mb-4 text-sm text-slate-600 leading-relaxed">
    We do not copy third-party review scores onto this page: they change often, and we list only facts we could check.
    Read {name}'s current reviews at the source.{note ? ` ${note}` : ''}
  </p>
  <div class="flex flex-wrap gap-2">
    {links.map((l) => (
      <a href={l.href} rel="nofollow noopener" target="_blank" class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-800 hover:bg-slate-50">{l.label}</a>
    ))}
  </div>
</section>
