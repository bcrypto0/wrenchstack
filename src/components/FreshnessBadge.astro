---
import { freshnessTier, type Tool } from '../lib/data';

interface Props {
  tool: Tool;
  // 'compact' shows a dot + month and year; 'full' shows the full date in a pill
  variant?: 'compact' | 'full';
  // Kept for callers; the full variant now always shows the date.
  showDate?: boolean;
}

const { tool, variant = 'compact' } = Astro.props;
const tier = freshnessTier(tool);
// Absolute dates, not "N days ago" (2026-10-01): pages are static, so a relative
// age is true only on the day of the build and grows wrong until the next one.
// Dates are YYYY-MM-DD and formatted in UTC so a US-timezone build does not print
// the previous day.
const verifiedDate = tool.pricing.verified_date;
const fmt = (d: string, opts: Intl.DateTimeFormatOptions) =>
  new Date(d + 'T00:00:00Z').toLocaleDateString('en-US', { ...opts, timeZone: 'UTC' });
const label = !verifiedDate
  ? 'No verified date'
  : variant === 'compact'
    ? `Verified ${fmt(verifiedDate, { month: 'short', year: 'numeric' })}`
    : `Pricing verified ${fmt(verifiedDate, { month: 'short', day: 'numeric', year: 'numeric' })}`;

const tierStyles = {
  fresh: {
    dot: 'bg-emerald-500',
    ring: 'ring-emerald-200',
    text: 'text-emerald-700',
  },
  aging: {
    dot: 'bg-amber-500',
    ring: 'ring-amber-200',
    text: 'text-amber-700',
  },
  stale: {
    dot: 'bg-rose-500',
    ring: 'ring-rose-200',
    text: 'text-rose-700',
  },
};

const style = tierStyles[tier];
const titleText = verifiedDate ? `Pricing last verified ${verifiedDate}` : 'No verified date';
---

{variant === 'compact' ? (
  <span
    class={`inline-flex items-center gap-1.5 text-xs font-medium ${style.text}`}
    title={titleText}
  >
    <span class={`h-1.5 w-1.5 rounded-full ${style.dot} ring-2 ${style.ring}`}></span>
    <span>{label}</span>
  </span>
) : (
  <span
    class={`inline-flex items-center gap-2 rounded-full bg-white px-2.5 py-1 text-xs font-medium ${style.text} ring-1 ${style.ring}`}
    title={titleText}
  >
    <span class={`h-2 w-2 rounded-full ${style.dot}`}></span>
    <span>{label}</span>
  </span>
)}
