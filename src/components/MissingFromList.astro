---
// Contextual vendor-submission prompt (added 2026-09-01, extended same day).
//
// Why: /for-vendors/ was reachable only from the footer, the international market
// pages and /badges/. It was linked from ZERO tool pages, comparison pages,
// category hubs or the homepage, which are precisely the pages a vendor lands on
// after searching for their own product or a competitor.
//
// The mechanism is already evidenced. Lavo CRM's submission said, in the vendor's
// own words, "Lavo CRM is not on WrenchStack's pressure-washing list today". He
// browsed a category page, noticed he was absent, and went hunting for the form.
// Nothing on that page asked him to. This component is that ask.
//
// Two modes, because the reader's situation differs:
//   listName  -> a category hub. The vendor is looking at the list they belong on.
//   competitors -> a tool or comparison page. The vendor is looking at a rival.
// Naming what they are looking at is the entire point; a generic "For vendors"
// footer link is what already existed and it converted rarely enough that we
// cannot attribute a single submission to it.
//
// Kept as ONE component rather than copies per template, for the same reason the
// median bug happened: a block repeated across 1,400 pages is 1,400 chances to
// drift.

interface Props {
  /** Category-hub mode: the list as a reader sees it, e.g. "AI tools for trades". */
  listName?: string;
  /** How many vendors that list holds, when the page already computes it. */
  count?: number;
  /** Tool/compare mode: the vendor(s) whose page this is. One name or two. */
  competitors?: string[];
}

const { listName, count, competitors } = Astro.props;
const rivals = competitors?.filter(Boolean) ?? [];
const isCompetitorMode = rivals.length > 0;

const heading = isCompetitorMode
  ? rivals.length > 1
    ? 'Should your product be in this comparison?'
    : `Do you build something that competes with ${rivals[0]}?`
  : 'Missing from this list?';

const rivalPhrase = rivals.length > 1 ? `${rivals[0]} and ${rivals[1]}` : rivals[0];
---

<section class="mt-12 rounded-lg border border-slate-200 bg-slate-50 p-6">
  <h2 class="text-lg font-bold text-slate-900">{heading}</h2>

  {isCompetitorMode ? (
    <p class="mt-2 text-sm leading-relaxed text-slate-700">
      We review {rivalPhrase} against {rivals.length > 1 ? 'their' : 'its'} own published pricing
      and terms, and we publish the cons next to the pros. If you build a competing product and
      it is not covered here, send it to us and it gets the same treatment.
    </p>
  ) : (
    <p class="mt-2 text-sm leading-relaxed text-slate-700">
      {count
        ? `We track ${count} ${listName} today, and we know that is not all of them.`
        : `We know our ${listName} coverage is not complete.`}
      {' '}If you build one and it is not here, send it to us and we will review it against your
      own published pricing and terms.
    </p>
  )}

  <p class="mt-2 text-sm leading-relaxed text-slate-700">
    Listings are free. No vendor can pay for placement, for a score, or to have a documented
    con removed.{' '}
    {isCompetitorMode
      ? 'Read this page first and decide whether you want that.'
      : 'We publish the cons next to the pros, so read an existing review before you decide you want one.'}
  </p>

  <div class="mt-4 flex flex-wrap gap-3">
    <a
      href="/for-vendors/"
      class="rounded-md bg-orange-500 px-5 py-2.5 text-sm font-semibold text-white hover:bg-orange-600"
      >Submit your product →</a
    >
    <a
      href="/methodology/"
      class="rounded-md border border-slate-300 bg-white px-5 py-2.5 text-sm font-semibold text-slate-800 hover:bg-slate-100"
      >How we review</a
    >
  </div>
</section>
