---
import Layout from '../../layouts/Layout.astro';
import { EN_MARKET_HREFLANG } from '../../lib/intl';
import zaData from '../../data/international/za.json';

interface ZaVendor {
  slug: string; name: string; category: string; vendor_url: string;
  tagline: string; market_position: string; za_specific_note?: string | null;
  tier: 'S' | 'A' | 'F'; reputation_flag: string | null;
  pros: string[]; cons: string[]; typical_pricing: string;
  is_cross_market: boolean; cross_market_link: string | null;
}

const vendors = (zaData as { vendors: ZaVendor[] }).vendors;
const categories = ['software', 'lead-gen', 'payroll', 'insurance', 'certification'];
const categoryMeta: Record<string, { label: string; description: string }> = {
  'software': { label: 'Job management & trades software', description: `Vendors with offices in South Africa and published rand prices (ServCraft in Randburg, Field Service Cloud in Pretoria, Odyssey Job Cards in Bloemfontein); Tradify and ServiceM8, which list rand prices on their South African sites; Eworks Manager, with a Gqeberha office, an offline mobile app and prices shown in GBP by default; and OpenSolar, solar design and proposal software that OpenSolar says is free for solar professionals.` },
  'lead-gen': { label: 'Lead generation', description: `Kandua, a home services marketplace owned by insurer Santam, where pros choose which job requests to quote on (fees for pros not published); ProCompare, which charges per lead from a published price list and sends each request to up to six pros; and Snupit, with a free pro profile and credits spent to unlock the leads you choose (credit prices not published).` },
  'payroll': { label: 'Payroll', description: `SimplePay generates the EMP201 for submission on eFiling, submits UIF declarations and exports the bi-annual tax certificate file for eFiling or e@syFile; PaySpace by Deel, now sold as Deel Local Payroll, handles PAYE, UIF, SDL and COIDA and produces IRP5, EMP201, EMP501 and employment-equity reports (no public prices); Sage Payroll (SA) publishes a starting price of R1,080 a year including VAT for 1-2 employees.` },
  'insurance': { label: 'Business insurance', description: `All quoted per business, with no published premiums: Santam (Contractors' All Risks, plant and equipment cover and defective workmanship liability, mainly through intermediaries); MiWay and Old Mutual iWYZE, sold direct (iWYZE names plumbers among the businesses it targets); and King Price and Hollard, sold through brokers, with contractors' all risks (King Price) and construction and engineering cover (Hollard).` },
  'certification': { label: 'Licensing & compliance', description: `Registration and compliance regimes: DoEL electrical contractor registration (only registered persons may issue the electrical CoC), SAQCC Gas registration of authorised gas practitioners, PIRB plumber registration and plumbing CoCs, cidb grading (registration needed for public sector contracts awarded by tender or quotation), NHBRC registration for home builders, SARS (VAT, EMP201 and EMP501), and COIDA registration and the Letter of Good Standing.` },
};
const vendorsByCategory: Record<string, ZaVendor[]> = {};
categories.forEach(c => { vendorsByCategory[c] = vendors.filter(v => v.category === c); });

const pageTitle = 'South Africa Trades Software & Services | WrenchStack';
const pageDescription = `Independent directory of ${vendors.length} South African listings for trades businesses: job management software, lead generation platforms, payroll, business insurance, and the PIRB, DoEL electrical, SAQCC Gas, cidb, NHBRC, SARS and COIDA registration and compliance regimes.`;
const breadcrumbs = [ { name: 'Home', url: '/' }, { name: 'South Africa', url: '/za/' } ];
---
<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs} alternateUrls={EN_MARKET_HREFLANG}>
  <article class="mx-auto max-w-5xl px-4 py-12">
    <header class="mb-10">
      <div class="mb-3 flex items-center gap-2">
        <span class="text-2xl" aria-hidden="true">🇿🇦</span>
        <p class="text-sm font-semibold uppercase tracking-wider text-orange-600">South Africa</p>
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">South Africa Trades Software & Services Directory</h1>
      <p class="mt-4 text-lg text-slate-600 leading-relaxed">
        Independent reviews of {vendors.length} South Africa-relevant listings: job management software (including South African options such as ServCraft, and global products with rand prices on their South African sites), lead generation platforms, payroll and business insurance, plus the registration and compliance regimes South African trades work under: certificates of compliance, cidb grading, NHBRC registration, SARS returns such as the EMP201, and the COIDA Letter of Good Standing.
      </p>
    </header>

    <section class="mb-10 grid gap-3 grid-cols-2 sm:grid-cols-4">
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">{vendors.length}</div>
        <div class="mt-1 text-xs text-slate-600">listings reviewed</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">7 days</div>
        <div class="mt-1 text-xs text-slate-600">to pay the monthly EMP201 after month-end</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">15%</div>
        <div class="mt-1 text-xs text-slate-600">VAT (compulsory registration from R2.3m of taxable supplies a year)</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">1-9</div>
        <div class="mt-1 text-xs text-slate-600">cidb grades cap public sector contract values</div>
      </div>
    </section>

    <section class="mb-10 flex flex-wrap items-center justify-between gap-4 rounded-lg border border-orange-200 bg-orange-50 p-5">
      <div>
        <h2 class="text-base font-bold text-slate-900">Deciding between two options?</h2>
        <p class="mt-1 text-sm text-slate-700">See SA vendors compared side by side: pros and cons, SA-specific notes, pricing, and which of the two publishes its prices.</p>
      </div>
      <a href="/za/compare/" class="shrink-0 rounded-md bg-slate-900 px-5 py-3 text-sm font-semibold text-white hover:bg-slate-700">Compare SA vendors →</a>
    </section>

    <section class="mb-10 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-3 text-base font-bold text-slate-900">What's different about running a trades business in South Africa</h2>
      <p class="text-sm text-slate-700 leading-relaxed">
        Three things shape vendor selection for SA trades businesses. First, <strong>certificates are tied to registration</strong>: only a registered person under the Electrical Installation Regulations may issue an electrical Certificate of Compliance, and a change of ownership may not be allowed if the CoC is more than two years old; a gas installation needs a certificate of conformity from an authorised person registered with SAQCC Gas, issued in its app since paper certificates stopped being valid on 1 April 2023; and under PIRB's rules only a PIRB Licensed Plumber may issue a plumbing CoC, which is needed for most work above R1,500 and, regardless of cost, for electric, solar and heat pump water heating, with each CoC logged within five days. Job software that records each certificate number against the job helps with all three. Second, <strong>registrations gate the work</strong>: contractors must be cidb-registered to carry out public sector contracts awarded by tender or quotation, and each grade (1-9) sets the contract value you can take on, from R500,000 at Grade 1 to no limit at Grade 9; the NHBRC says building homes without registering with it is an offence; and under the Construction Regulations, 2014, clients and principal contractors must confirm that contractors are registered and in good standing for COIDA (with the Compensation Fund or a licensed compensation insurer) before work starts. Third, <strong>SARS sets the calendar</strong>: 15% VAT, with compulsory registration from R2.3 million of taxable supplies a year from 1 April 2026; the monthly EMP201, paid within seven days after month-end; interim and annual EMP501 reconciliations; and e-invoicing, which is not mandatory yet (SARS's August 2026 consultation paper proposes a phased start from 2030, beginning with large taxpayers).
      </p>
    </section>

    {categories.map(c => {
      const cat = categoryMeta[c];
      const cv = vendorsByCategory[c];
      if (cv.length === 0) return null;
      return (
        <section class="mb-12">
          <div class="mb-5">
            <h2 class="text-2xl font-bold text-slate-900">{cat.label}</h2>
            <p class="mt-1 text-sm text-slate-600 leading-relaxed">{cat.description}</p>
          </div>
          <div class="space-y-4">
            {cv.map(v => {
              const isCert = v.category === 'certification';
              const tierColor = v.tier === 'S' ? 'border-emerald-300' : v.tier === 'F' ? 'border-rose-300' : 'border-blue-300';
              const tierLabel = isCert ? 'Official body / regime' : v.tier === 'S' ? 'Published prices' : v.tier === 'F' ? 'Reputation warning' : 'Listed';
              const tierBadge = v.tier === 'S' ? 'bg-emerald-100 text-emerald-900' : v.tier === 'F' ? 'bg-rose-100 text-rose-900' : 'bg-blue-100 text-blue-900';
              return (
                <article class={`rounded-lg border-2 ${tierColor} bg-white p-5`}>
                  <div class="mb-3 flex items-start justify-between gap-3">
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-2 mb-1 flex-wrap">
                        <h3 class="text-xl font-bold text-slate-900">{v.name}</h3>
                        <span class={`rounded-full px-2 py-0.5 text-xs font-bold ${tierBadge}`}>{isCert ? tierLabel : `Tier ${v.tier} · ${tierLabel}`}</span>
                        </div>
                      <p class="text-sm italic text-slate-500">{v.tagline}</p>
                    </div>
                  </div>
                  <p class="mb-3 text-sm text-slate-700 leading-relaxed">{v.market_position}</p>
                  {v.za_specific_note && (
                    <div class="mb-3 rounded-md bg-slate-50 px-4 py-3">
                      <p class="text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">SA-specific note</p>
                      <p class="text-sm text-slate-700 leading-relaxed">{v.za_specific_note}</p>
                    </div>
                  )}
                  <div class="mb-3 grid gap-3 sm:grid-cols-2">
                    <div>
                      <p class="text-xs font-bold uppercase tracking-wider text-emerald-700 mb-1">{isCert ? 'What it covers' : 'Pros'}</p>
                      <ul class="space-y-1 text-sm text-slate-700">{v.pros.slice(0, 4).map(p => <li class="leading-snug">+ {p}</li>)}</ul>
                    </div>
                    <div>
                      <p class="text-xs font-bold uppercase tracking-wider text-rose-700 mb-1">{isCert ? 'Watch out for' : 'Cons'}</p>
                      <ul class="space-y-1 text-sm text-slate-700">{v.cons.slice(0, 4).map(con => <li class="leading-snug">− {con}</li>)}</ul>
                    </div>
                  </div>
                  <div class="mb-3 text-xs text-slate-600"><strong class="text-slate-900">{isCert ? 'Cost / access:' : 'Typical SA pricing:'}</strong> {v.typical_pricing}</div>
                  <div class="flex flex-wrap gap-2">
                    <a href={`/za/${v.slug}/`} class="rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700">Full SA review →</a>
                    <a href={v.vendor_url} rel="sponsored nofollow noopener" target="_blank" class="rounded-md bg-orange-500 px-4 py-2 text-sm font-semibold text-white hover:bg-orange-600">{isCert ? 'Official site' : `Visit ${v.name}`} →</a>
                    {v.cross_market_link && (<a href={v.cross_market_link} class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">Full review (US market context)</a>)}
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      );
    })}

    <section class="mt-12 rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">Are you a South African vendor?</h2>
      <p class="mt-2 text-slate-300 leading-relaxed">If you build software or services for SA trades businesses and want to be reviewed or featured, get in touch through our <a href="/for-vendors/" class="underline">vendor program</a>.</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/for-vendors/" class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600">Work with us →</a>
        <a href="/software-by-country/" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">🌍 Software by country</a>
        <a href="/methodology/" class="rounded-md border border-white/30 bg-white/10 px-5 py-3 text-sm font-semibold text-white hover:bg-white/20">Methodology</a>
      </div>
    </section>
  </article>
</Layout>
