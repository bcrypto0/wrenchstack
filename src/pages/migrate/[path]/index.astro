---
import Layout from '../../../layouts/Layout.astro';
import migrationsData from '../../../data/migrations.json';
import { asSentence,
  getTool,
  formatPrice,
  wrenchStackScore,
  isQuoteOnly,
  priceScaling,
  seatUnit,
  type Tool,
} from '../../../lib/data';
import WrenchScore from '../../../components/WrenchScore.astro';
import ToolLogo from '../../../components/ToolLogo.astro';

export async function getStaticPaths() {
  return migrationsData.migrations.flatMap(m => {
    const fromTool = getTool(m.from);
    const toTool = getTool(m.to);
    if (!fromTool || !toTool) return [];
    return [{
      params: { path: `from-${m.from}-to-${m.to}` },
      props: { fromTool, toTool, intent: m.intent, reason: m.reason },
    }];
  });
}

interface Props {
  fromTool: Tool;
  toTool: Tool;
  intent: string;
  reason: string;
}

const { fromTool, toTool, intent } = Astro.props;

const fromScore = wrenchStackScore(fromTool);
const toScore = wrenchStackScore(toTool);

// Feature and integration lists are what our data records for each tool. They are
// not exhaustive and name things differently between tools, so the copy says
// "listed for" rather than "has" or "lacks" (2026-10-01; it used to promise "a clean
// upgrade" and say integrations "continue to work without disruption").
const onlyInFromFeatures = fromTool.key_features.filter(f => !toTool.key_features.includes(f));
const onlyInToFeatures = toTool.key_features.filter(f => !fromTool.key_features.includes(f));
const sharedIntegrations = fromTool.integrations.filter(i => toTool.integrations.includes(i));
const lostIntegrations = fromTool.integrations.filter(i => !toTool.integrations.includes(i));
const newIntegrations = toTool.integrations.filter(i => !fromTool.integrations.includes(i));
const human = (slug: string) => slug.replace(/_/g, ' ');
const listJoin = (names: string[]) =>
  names.length <= 1 ? (names[0] ?? '') : `${names.slice(0, -1).join(', ')} and ${names[names.length - 1]}`;
const toHasZapier = toTool.integrations.some((i) => /zapier/i.test(i));
const toQuickBooks = toTool.integrations.filter((i) => /quickbooks/i.test(i));
const toTrialDays = toTool.pricing.free_trial_days ?? 0;

// Cost-of-switch analysis
const fromPrice = fromTool.pricing.starting_at_usd;
const toPrice = toTool.pricing.starting_at_usd;
const monthlyDelta = (fromPrice !== null && toPrice !== null) ? Math.round(toPrice - fromPrice) : null;
const annualDelta = monthlyDelta !== null ? monthlyDelta * 12 : null;

// Starting prices are only like for like when both tools charge the same way, and
// per-seat prices only when they charge for the same seat (seatUnit: 'user' unless
// pricing.seat_unit names a route or a driver; 2026-10-05).
const scalingLabel = (t: Tool): string => {
  const s = priceScaling(t);
  if (s === 'per_user') return `per ${seatUnit(t)}`;
  if (s === 'flat') return 'per company';
  if (s === 'base_plus_seat') return 'per company with some users included, plus a fee per extra user';
  if (s === 'free') return 'nothing on its free tier, with paid plans above it';
  if (s === 'quote') return isQuoteOnly(t) ? 'by quote' : 'one-time or per-project prices';
  return 'in a way described in its pricing note';
};
const modelsDiffer = priceScaling(fromTool) !== priceScaling(toTool)
  || (priceScaling(fromTool) === 'per_user' && seatUnit(fromTool) !== seatUnit(toTool));
const modelCaveat = modelsDiffer
  ? ` These starting prices are not like for like: ${fromTool.name} charges ${scalingLabel(fromTool)} and ${toTool.name} charges ${scalingLabel(toTool)}, so compare them at your team size.`
  : '';
// "$29/mo", "$39/user/mo" or "a free tier", for sentences that already say "starts at".
const priceShort = (t: Tool) =>
  t.pricing.starting_at_usd === 0 ? 'a free tier' : `$${t.pricing.starting_at_usd}${priceScaling(t) === 'per_user' ? `/${seatUnit(t)}` : ''}/mo`;
// When both tools charge per user (per the same seat), the monthly difference is per that seat too.
const deltaUnit = priceScaling(fromTool) === 'per_user' && priceScaling(toTool) === 'per_user' && seatUnit(fromTool) === seatUnit(toTool) ? ` per ${seatUnit(fromTool)}` : '';
const noPriceText = (t: Tool) => isQuoteOnly(t) ? `${t.name} publishes no price` : `${t.name} publishes no monthly plan (see its pricing note)`;

// No tier-guessed fee: vendors at the same price differ (some include onboarding,
// some charge for it), so point to the pricing note and a written quote instead.
const implSummary = isQuoteOnly(toTool)
  ? `not published for ${toTool.name}; ask for it in the written quote`
  : `check ${toTool.name}'s pricing note and confirm its setup fee in writing, since some vendors include onboarding and others charge for it`;

const softwareCostChange = monthlyDelta === null
  ? `${[fromPrice === null ? noPriceText(fromTool) : null, toPrice === null ? noPriceText(toTool) : null].filter(Boolean).join(' and ')}, so compare your current bill with a written quote at your team size.`
  : monthlyDelta > 0
    ? `about $${monthlyDelta}/month${deltaUnit} more on ${toTool.name} at the starting price (${priceShort(toTool)} against ${priceShort(fromTool)}), or about $${annualDelta} a year${deltaUnit}.${modelCaveat}`
    : monthlyDelta < 0
      ? `about $${Math.abs(monthlyDelta)}/month${deltaUnit} less on ${toTool.name} at the starting price (${priceShort(toTool)} against ${priceShort(fromTool)}), or about $${Math.abs(annualDelta ?? 0)} a year${deltaUnit}.${modelCaveat}`
      : `the starting prices are the same (${priceShort(toTool)}).${modelCaveat}`;

const pageTitle = `How to migrate from ${fromTool.name} to ${toTool.name} (2026)`;
const pageDescription = `Guide to switching from ${fromTool.name} to ${toTool.name}: published prices, the features and integrations our data lists for both, the steps of a switch, a data export checklist, and what to ask both vendors.`;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Migration guides', url: '/migrate/' },
  { name: `${fromTool.name} to ${toTool.name}`, url: `/migrate/from-${fromTool.slug}-to-${toTool.slug}/` },
];

const faqs = [
  {
    q: `How long does it take to migrate from ${fromTool.name} to ${toTool.name}?`,
    a: `We have no measured timeline for this switch. It depends on how many customers, open jobs, recurring agreements and integrations you move, and on how much training your team needs. Ask ${toTool.name} for a written onboarding plan with dates before you sign, and keep ${fromTool.name} active until the new system is running.`,
  },
  {
    q: `Will all my ${fromTool.name} data transfer?`,
    a: `Ask both vendors before you cancel anything: what ${fromTool.name} lets you export and in which format, and what ${toTool.name} can import. Export everything you need while your ${fromTool.name} subscription is still active, including invoices, attachments and recurring service agreements, and ask ${fromTool.name} how long you keep access after cancelling. After importing, check a sample of customers and jobs against ${fromTool.name}.`,
  },
  {
    q: `What about integrations I rely on?`,
    a: lostIntegrations.length > 0
      ? `Our data lists ${listJoin(lostIntegrations.map(human))} for ${fromTool.name} but not for ${toTool.name}. Our integration lists are not exhaustive, so ask ${toTool.name} whether it connects to ${lostIntegrations.length === 1 ? 'it' : 'each'}${toHasZapier ? ', directly or through Zapier' : ''}, before cutover.`
      : `Every integration our data lists for ${fromTool.name} is also listed for ${toTool.name}${sharedIntegrations.length ? ` (${listJoin(sharedIntegrations.map(human))})` : ''}. You will still need to connect each one to ${toTool.name} and check that it syncs the way you use it.`,
  },
  {
    q: `Is ${toTool.name} more expensive than ${fromTool.name}?`,
    a: (() => {
      if (fromPrice === null && toPrice === null) return `${noPriceText(fromTool)} and ${noPriceText(toTool)}; request quotes from both for a comparison at your team size.`;
      if (fromPrice === null) return `${noPriceText(fromTool)}; ${toTool.name} starts at ${priceShort(toTool)}. Compare your current ${fromTool.name} bill against ${toTool.name}'s published plan for your team size.`;
      if (toPrice === null) return `${noPriceText(toTool)}; request a quote at your team size and compare it against your current ${fromTool.name} bill.`;
      if (toPrice === 0 && fromPrice > 0) return `${toTool.name} has a free tier; ${fromTool.name} starts at ${priceShort(fromTool)}. Check the free plan's limits in ${toTool.name}'s pricing note.${modelCaveat}`;
      if (toPrice > fromPrice && fromPrice > 0) return `${toTool.name} starts at ${priceShort(toTool)} against ${fromTool.name}'s ${priceShort(fromTool)}, about ${Math.round(((toPrice - fromPrice) / fromPrice) * 100)}% more at the starting price.${modelCaveat}`;
      if (toPrice > fromPrice) return `${toTool.name} starts at ${priceShort(toTool)}; ${fromTool.name} has a free tier.${modelCaveat}`;
      if (toPrice < fromPrice) return `${toTool.name} starts at ${priceShort(toTool)} against ${fromTool.name}'s ${priceShort(fromTool)}, about ${Math.round(((fromPrice - toPrice) / fromPrice) * 100)}% less at the starting price. Check the feature lists below for anything you would give up.${modelCaveat}`;
      return `Both start at ${priceShort(toTool)}. Compare features and integrations rather than price.${modelCaveat}`;
    })(),
  },
  {
    q: `What's the total cost of switching from ${fromTool.name} to ${toTool.name}?`,
    a: `Three components: (1) Software-cost change: ${softwareCostChange} (2) Implementation fees: ${implSummary}. (3) Staff time for setup, data checks and training. We have no measured figure for staff time; the cost-of-switch calculator adds it from stated assumptions (8 hours per tech and 60 office hours) and lets you enter the fee from your quote.`,
  },
  {
    q: `Can I run ${fromTool.name} and ${toTool.name} in parallel during migration?`,
    a: `Yes, if you pay for both subscriptions while they overlap. Entering new jobs in ${toTool.name} while finishing open jobs in ${fromTool.name} lets you check the new system before you cancel the old one. How long to overlap depends on your job cycle; the cost-of-switch calculator assumes one month.`,
  },
  {
    q: `What if my team resists the move from ${fromTool.name}?`,
    a: `Before signing, have the team members least comfortable with software try ${toTool.name}${toTrialDays > 0 ? ` (it lists a ${toTrialDays}-day free trial)` : ` (our data lists no free trial for it, so ask ${toTool.name} how your team can try it)`}, and ask what they would need to do their daily work in it. Present the switch in terms of the problems they already complain about, train a few willing people first, and have them help the rest.`,
  },
  {
    q: `Should I migrate during peak season or off-season?`,
    a: `In a quieter period for your business, because setup, data checks and training take office time away from customer work. Your own job history (jobs per month over the past year) shows which months are quieter.`,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs} affiliate>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <article class="mx-auto max-w-4xl px-4 py-12">

    <header class="mb-10">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-orange-600">Migration guide</p>
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 md:text-5xl">
        Migrating from {fromTool.name} to {toTool.name}
      </h1>
      <p class="mt-4 text-lg text-slate-600">
        For: <strong>{intent}.</strong> What our data records for both tools, the steps of a switch in order, and what to check with both vendors before you cancel anything.
      </p>

      <div class="mt-6 rounded-lg border border-orange-200 bg-orange-50 p-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <div class="font-semibold text-slate-900">Estimate the 12-month cost</div>
            <div class="text-sm text-slate-700">Subscription difference, the implementation fee from your quote, and training and overlap costs from stated assumptions, for your team size.</div>
          </div>
          <a
            href={`/cost-of-switch/?from=${fromTool.slug}&to=${toTool.slug}`}
            class="shrink-0 rounded-md bg-orange-500 px-4 py-2 text-sm font-semibold text-white hover:bg-orange-600"
          >
            Calculate switch cost →
          </a>
        </div>
      </div>
    </header>

    <section class="mb-12 grid gap-4 md:grid-cols-2">
      <div class="rounded-lg border border-slate-200 bg-white p-5">
        <div class="mb-3 flex items-center gap-3">
          <ToolLogo tool={fromTool} size={40} />
          <div class="flex-1">
            <div class="text-xs font-bold uppercase tracking-wide text-slate-500">From</div>
            <h2 class="text-lg font-bold text-slate-900">
              <a href={`/tools/${fromTool.slug}/`} class="hover:text-orange-600">{fromTool.name}</a>
            </h2>
          </div>
          <WrenchScore score={fromScore} size="sm" />
        </div>
        <dl class="space-y-1 text-sm">
          <div class="flex justify-between"><dt class="text-slate-500">Price</dt><dd class="font-medium">{formatPrice(fromTool)}</dd></div>
          <div class="flex justify-between"><dt class="text-slate-500">Best for</dt><dd class="font-medium text-right">{fromTool.best_team_size ? `${fromTool.best_team_size} techs` : '-'}</dd></div>
        </dl>
      </div>

      <div class="rounded-lg border border-orange-200 bg-orange-50 p-5">
        <div class="mb-3 flex items-center gap-3">
          <ToolLogo tool={toTool} size={40} />
          <div class="flex-1">
            <div class="text-xs font-bold uppercase tracking-wide text-orange-700">To</div>
            <h2 class="text-lg font-bold text-slate-900">
              <a href={`/tools/${toTool.slug}/`} class="hover:text-orange-600">{toTool.name}</a>
            </h2>
          </div>
          <WrenchScore score={toScore} size="sm" />
        </div>
        <dl class="space-y-1 text-sm">
          <div class="flex justify-between"><dt class="text-slate-500">Price</dt><dd class="font-medium">{formatPrice(toTool)}</dd></div>
          <div class="flex justify-between"><dt class="text-slate-500">Best for</dt><dd class="font-medium text-right">{toTool.best_team_size ? `${toTool.best_team_size} techs` : '-'}</dd></div>
        </dl>
        <a
          href={toTool.affiliate_url.startsWith('http') ? toTool.affiliate_url : toTool.vendor_url}
          rel="sponsored nofollow noopener"
          target="_blank"
          class="mt-4 block w-full rounded-md bg-orange-500 px-4 py-2 text-center text-sm font-semibold text-white hover:bg-orange-600"
        >
          Visit {toTool.name} →
        </a>
      </div>
    </section>

    <section class="mb-12 prose prose-slate max-w-none">
      <h2>Why you might make this switch</h2>
      <p>{asSentence(intent)} What our data says about the two tools:</p>
      <ul>
        <li><strong>{toTool.name} is listed as best for:</strong> {asSentence(toTool.best_for)}</li>
        <li><strong>{fromTool.name}'s listed weaknesses:</strong> {asSentence(fromTool.weaknesses)}</li>
      </ul>

      <h2>Features listed for {toTool.name} but not for {fromTool.name}</h2>
      <p>Our feature lists are not exhaustive and name features differently between tools, so check each one on the vendor's site.</p>
      {onlyInToFeatures.length > 0 ? (
        <ul>
          {onlyInToFeatures.map(f => <li><strong>{human(f)}</strong></li>)}
        </ul>
      ) : (
        <p>Every feature our data lists for {toTool.name} is also listed for {fromTool.name}.</p>
      )}

      <h2>Features listed for {fromTool.name} but not for {toTool.name}</h2>
      {onlyInFromFeatures.length > 0 ? (
        <ul>
          {onlyInFromFeatures.map(f => <li>{human(f)}</li>)}
        </ul>
      ) : (
        <p>Every feature our data lists for {fromTool.name} is also listed for {toTool.name}. Check the features you use daily on {toTool.name}'s site anyway.</p>
      )}

      <h2>Cost-of-switch analysis</h2>
      <p>Three cost components when migrating from {fromTool.name} to {toTool.name}:</p>
      <ul>
        <li><strong>Software-cost change:</strong> {softwareCostChange}</li>
        <li><strong>Implementation fees:</strong> {isQuoteOnly(toTool) ? `${toTool.name} publishes no price or setup fee, so ask for the implementation fee in the same written quote.` : `Check ${toTool.name}'s pricing note and confirm its setup fee in writing: some vendors include onboarding in the subscription and others charge for it.`}</li>
        <li><strong>Staff time:</strong> setup, data checks and training take time from office staff and techs. We have no measured figure for it; the <a href={`/cost-of-switch/?from=${fromTool.slug}&to=${toTool.slug}`}>cost-of-switch calculator</a> adds it from stated assumptions that you can scale to your own hours and wages.</li>
      </ul>

      <h2>Migration steps, in order</h2>
      <p>We have no measured durations for these steps; ask {toTool.name} for a written onboarding plan with dates.</p>

      <h3>1. Set up {toTool.name}</h3>
      <p>Configure company settings, users and permissions, and your price book if you use one. Get this right before you import anything.</p>

      <h3>2. Import your data</h3>
      <p>Export your customer list and active jobs from {fromTool.name} and import them into {toTool.name}. Check a sample of customers and jobs against {fromTool.name}. Check recurring service agreements one by one, and ask {toTool.name} whether its import carries them over.</p>

      <h3>3. Train the team and run both systems</h3>
      <p>Train dispatchers and office staff first, then field techs. While both systems run, enter new jobs in {toTool.name} and complete jobs already booked in {fromTool.name}.</p>

      <h3>4. Cut over</h3>
      <p>Stop entering new data in {fromTool.name}. Export all historical data before you cancel, then cancel the {fromTool.name} subscription.</p>

      <h3>5. After the switch</h3>
      <p>Set up the automations and reports you planned to use in {toTool.name}, and check them against the reasons you switched.</p>

      <h2>Data export checklist (before cancelling {fromTool.name})</h2>
      <p>Export everything from {fromTool.name} before you cancel, and ask {fromTool.name} how long you keep access afterwards. Your checklist:</p>
      <ul>
        <li><strong>Customer records</strong>: full export with names, addresses, contact info, custom fields, service notes</li>
        <li><strong>Active job data</strong>: open work orders, scheduled appointments, recurring service agreements</li>
        <li><strong>Historical invoices</strong>: as many years as your accountant needs for tax and audit records</li>
        <li><strong>Payment records</strong>: past payments and outstanding balances</li>
        <li><strong>Photo and document attachments</strong>: job site photos, signed agreements, equipment photos</li>
        <li><strong>Price book / service catalog</strong>: your service offerings with their prices</li>
        <li><strong>Membership/maintenance plan data</strong>: recurring billing setups, plan tiers, member status</li>
        <li><strong>Integration configurations</strong>: screenshot or write down your QuickBooks sync, payment setup and Zapier workflows so you can re-create them</li>
        <li><strong>User accounts and permissions</strong>: list of staff with their role assignments</li>
        <li><strong>Reports and saved views</strong>: note custom dashboards or reports you'll need to rebuild</li>
      </ul>

      <h2>Integration checklist</h2>
      <p>From the integrations our data lists for each tool. The lists are not exhaustive, so confirm each one with the vendor.</p>
      {sharedIntegrations.length > 0 && (
        <>
          <p><strong>Listed for both tools</strong> (you will still need to connect each one to {toTool.name} and check how it syncs):</p>
          <ul>
            {sharedIntegrations.map(i => <li>{human(i)}</li>)}
          </ul>
        </>
      )}
      {lostIntegrations.length > 0 && (
        <>
          <p><strong>Listed for {fromTool.name} but not for {toTool.name}:</strong></p>
          <ul>
            {lostIntegrations.map(i => <li><strong>{human(i)}</strong>: ask {toTool.name} whether it connects{toHasZapier ? ', directly or through Zapier' : ''}, or plan the workflow without it.</li>)}
          </ul>
        </>
      )}
      {newIntegrations.length > 0 && (
        <>
          <p><strong>Listed for {toTool.name} but not for {fromTool.name}</strong> (worth evaluating during migration):</p>
          <ul>
            {newIntegrations.map(i => <li>{human(i)}</li>)}
          </ul>
        </>
      )}

      <h2>Migration pitfalls to plan for</h2>
      <ul>
        <li><strong>Cancelling {fromTool.name} too early.</strong> Don't cancel until you've checked the exported data and {toTool.name} is running your daily work. Keep both subscriptions while they overlap.</li>
        <li><strong>Trusting an imported price book unchecked.</strong> If you use a price book, check every imported item and price in {toTool.name}, or rebuild it there, before you send quotes from it.</li>
        <li><strong>Forgetting custom workflows.</strong> If your office built custom workflows or automations in {fromTool.name} (dispatch rules, email templates, automated billing), list every one and ask {toTool.name} how to rebuild each before cutover.</li>
        <li><strong>Skipping the team.</strong> Have the team members least comfortable with software try {toTool.name} before you sign. Train a few willing people first and have them help the rest.</li>
        <li><strong>Switching in your busiest months.</strong> Setup, data checks and training take office time you need for customers when demand peaks.</li>
        <li><strong>Not budgeting for the overlap.</strong> While both tools run, you keep paying for {fromTool.name}: {fromPrice !== null && fromPrice > 0 ? `${priceShort(fromTool)} at its starting price, or more on a higher plan` : fromPrice === 0 ? 'nothing on its free plan, or your paid plan price' : 'your current monthly bill'}.</li>
      </ul>

      <h2>Things to verify BEFORE you sign the new contract</h2>
      <ul>
        <li><strong>Data export from {fromTool.name}.</strong> Confirm you can export customers, jobs and invoices in a format {toTool.name} can import.</li>
        <li><strong>QuickBooks integration.</strong> If you keep your books in QuickBooks, check that {toTool.name} supports your version (Online or Desktop) and the sync direction you need.{toQuickBooks.length > 0 ? ` Our data lists ${listJoin(toQuickBooks.map(human))} for ${toTool.name}.` : ` Our data lists no QuickBooks integration for ${toTool.name}.`}</li>
        <li><strong>Cancellation terms on {fromTool.name}.</strong> Check your contract for a minimum term or annual commitment and the notice period.</li>
        <li><strong>Implementation cost on {toTool.name}.</strong> Ask for the setup or onboarding fee in writing.</li>
        <li><strong>Team adoption.</strong> Have the team members least comfortable with software try {toTool.name} before you sign.</li>
      </ul>

      <h2>When to hold off</h2>
      <ul>
        <li>You're in your busiest months. Setup and training compete with customer work.</li>
        <li>Your current pain is a single missing feature that the new tool also doesn't solve. Verify the feature gap closes before signing.</li>
        <li>Your team adopted {fromTool.name} recently. Another change soon after can wear on a team; make sure the move is worth it.</li>
      </ul>
    </section>

    <section class="mb-12">
      <h2 class="mb-6 text-2xl font-bold text-slate-900">Frequently asked questions</h2>
      <div class="space-y-4">
        {faqs.map(f => (
          <details class="rounded-lg border border-slate-200 bg-white p-4">
            <summary class="cursor-pointer font-semibold text-slate-900">{f.q}</summary>
            <p class="mt-3 text-slate-700">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">Ready to evaluate {toTool.name}?</h2>
      <p class="mt-2 text-slate-300">
        Read the full review, check pricing, or compare with {fromTool.name} side-by-side.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a
          href={toTool.affiliate_url.startsWith('http') ? toTool.affiliate_url : toTool.vendor_url}
          rel="sponsored nofollow noopener"
          target="_blank"
          class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600"
        >
          Visit {toTool.name} →
        </a>
        <a href={`/tools/${toTool.slug}/`} class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">{toTool.name} review</a>
        <a href={`/compare/${[fromTool.slug, toTool.slug].sort()[0]}-vs-${[fromTool.slug, toTool.slug].sort()[1]}/`} class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">vs {fromTool.name}</a>
      </div>
    </section>
  </article>
</Layout>
