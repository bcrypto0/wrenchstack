---
import Layout from '../../layouts/Layout.astro';
import migrationsData from '../../data/migrations.json';
import { getTool, priceTier, isQuoteOnly, type Tool } from '../../lib/data';

const MIGRATIONS = migrationsData.migrations;

interface Resolved {
  fromTool: Tool;
  toTool: Tool;
  url: string;
  intent: string;
  reason?: string;
}

const resolved: Resolved[] = MIGRATIONS.map(m => {
  const fromTool = getTool(m.from);
  const toTool = getTool(m.to);
  if (!fromTool || !toTool) return null;
  return {
    fromTool,
    toTool,
    url: `/migrate/from-${m.from}-to-${m.to}/`,
    intent: m.intent,
    reason: m.reason,
  };
}).filter((r): r is Resolved => r !== null);

const listJoin = (names: string[]) =>
  names.length <= 1 ? (names[0] ?? '') : `${names.slice(0, -1).join(', ')} and ${names[names.length - 1]}`;

// Group migrations by the destination's price (where you're going). Uses priceTier,
// which compares cost per user (flat plans split across a 5-person team), and
// isQuoteOnly for tools that publish no price. Until 2026-10-01 quote-only tools were
// filed as "enterprise" and the section text named ServiceTitan, BuildOps and Procore
// whether or not they were destinations; the names below come from the data.
type Group = 'quote' | 'enterprise' | 'mid' | 'entry' | 'other';
function destinationGroup(t: Tool): Group {
  if (isQuoteOnly(t)) return 'quote';
  const tier = priceTier(t);
  if (tier === 'enterprise') return 'enterprise';
  if (tier === 'mid') return 'mid';
  if (tier === 'entry' || tier === 'free') return 'entry';
  return 'other';
}

const groupMeta: Array<{ key: Group; heading: string; blurb: string }> = [
  {
    key: 'quote',
    heading: 'Migrating to platforms that publish no price',
    blurb: 'These vendors publish no price or setup fee, so get the monthly cost, any implementation fee and the go-live plan in the written quote.',
  },
  {
    key: 'enterprise',
    heading: 'Migrating to platforms priced at $250+ per user per month',
    blurb: 'Ask whether onboarding is included or charged separately, and get it in writing.',
  },
  {
    key: 'mid',
    heading: 'Migrating to platforms priced at $100-$249 per user per month',
    blurb: 'Ask whether onboarding is included or charged separately, and get it in writing.',
  },
  {
    key: 'entry',
    heading: 'Migrating to platforms under $100 per user per month',
    blurb: 'Flat company plans are split across a 5-person team for this comparison. Ask whether the destination charges a setup fee, and get the answer in writing.',
  },
  {
    key: 'other',
    heading: 'Migrating to platforms with other published pricing',
    blurb: 'These publish module or per-project prices rather than a monthly plan; see the pricing note on the tool page.',
  },
];

const groups = groupMeta
  .map((g) => {
    const items = resolved.filter((r) => destinationGroup(r.toTool) === g.key);
    const destinations = [...new Set(items.map((r) => r.toTool.name))];
    return { ...g, items, destinations };
  })
  .filter((g) => g.items.length > 0);

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Migration guides', url: '/migrate/' },
];

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Trades software migration guides',
  numberOfItems: resolved.length,
  itemListElement: resolved.map((r, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `${r.fromTool.name} to ${r.toTool.name}`,
    url: `https://wrenchstack.com${r.url}`,
  })),
};
---

<Layout
  title={`Trades software migration guides: ${resolved.length} switching paths covered`}
  description={`Guides for switching between trades software platforms. ${resolved.length} migration paths, each with the published price difference, the features and integrations our data lists for both tools, a data export checklist, and what to ask both vendors before you switch.`}
  breadcrumbs={breadcrumbs}
>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  <section class="mx-auto max-w-5xl px-4 py-12">
    <header class="mb-10">
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 md:text-5xl">
        Migration guides
      </h1>
      <p class="mt-4 max-w-3xl text-lg text-slate-600">
        {resolved.length} switching paths between field service platforms. Each guide compares what our data records for both tools (published prices, listed features and integrations), sets out the steps of a switch in order, and lists what to export and what to ask both vendors before you cancel anything.
      </p>
      <p class="mt-3 text-sm text-slate-500">
        We have no measured timelines or transfer results for these switches. How long a switch takes, and what carries over cleanly, depends on your data and on each vendor's import and export, so the guides tell you what to ask rather than promise an outcome.
      </p>
    </header>

    {groups.map((g) => (
      <section class="mb-12">
        <h2 class="mb-2 text-2xl font-bold tracking-tight text-slate-900">{g.heading}</h2>
        <p class="mb-6 text-slate-600">
          Destinations: {listJoin(g.destinations)}. {g.blurb}
        </p>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {g.items.map(r => (
            <a
              href={r.url}
              class="group rounded-lg border border-slate-200 bg-white p-5 transition hover:border-orange-400 hover:shadow-sm"
            >
              <div class="font-semibold text-slate-900 group-hover:text-orange-600">
                {r.fromTool.name} → {r.toTool.name}
              </div>
              <div class="mt-1 text-xs text-slate-500 leading-snug">{r.intent}</div>
            </a>
          ))}
        </div>
      </section>
    ))}

    <section class="mb-12 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-3 text-xl font-bold text-slate-900">What's in every migration guide</h2>
      <div class="grid gap-4 text-sm text-slate-700 md:grid-cols-2">
        <div>
          <div class="font-semibold text-slate-900">Cost of switching</div>
          <p class="mt-1 text-slate-600">The difference between the two published starting prices, monthly and yearly, when both tools publish one; otherwise what to ask for in the quote. A link to the cost-of-switch calculator, which adds training and overlap costs from stated assumptions.</p>
        </div>
        <div>
          <div class="font-semibold text-slate-900">Migration steps in order</div>
          <p class="mt-1 text-slate-600">Setup, data import, training and overlap, cutover, then the follow-up work. No durations: ask the new vendor for a written onboarding plan with dates.</p>
        </div>
        <div>
          <div class="font-semibold text-slate-900">Data export checklist</div>
          <p class="mt-1 text-slate-600">What to export before cancelling (customer records, active jobs, invoices, payments, attachments, price book, integrations, users, reports), and a reminder to ask the old vendor how long you keep access after cancelling.</p>
        </div>
        <div>
          <div class="font-semibold text-slate-900">Integration checklist</div>
          <p class="mt-1 text-slate-600">Which integrations our data lists for both tools, which only for the tool you are leaving, and which only for the new one.</p>
        </div>
        <div>
          <div class="font-semibold text-slate-900">Pitfalls to plan for</div>
          <p class="mt-1 text-slate-600">Cancelling too early, unchecked price books, custom workflows, team adoption, switching in your busiest months, and the cost of running both tools at once.</p>
        </div>
        <div>
          <div class="font-semibold text-slate-900">FAQs per guide</div>
          <p class="mt-1 text-slate-600">Timing, data transfer, integrations, price, total cost, running both tools, team adoption and when to switch, with FAQPage schema.</p>
        </div>
      </div>
    </section>

    <section class="mt-8 rounded-lg bg-slate-50 p-6 text-sm text-slate-600">
      <p>
        Don't see your migration path? Email <a href="mailto:hello@wrenchstack.com" class="text-orange-600 hover:underline">hello@wrenchstack.com</a> with your current tool and the one you are considering.
      </p>
    </section>
  </section>
</Layout>
