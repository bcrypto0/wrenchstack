---
import Layout from '../../../../../layouts/Layout.astro';
import saData from '../../../../../data/international/sa.json';

interface SaVendor {
  slug: string; name: string; category: string;
}
const vendors = (saData as { vendors: SaVendor[] }).vendors;
const softwareCount = vendors.filter(v => v.category === 'software').length;
const inDirectory = (slug: string) => vendors.some(v => v.slug === slug);

// نفس بيانات النسخة الإنجليزية، من دليلنا السعودي الموثّق.
const zatcaReady = [
  { slug: 'qoyod', name: 'قيود (Qoyod)', status: 'تقول إنها معتمدة من هيئة الزكاة؛ ويضع دليل باقاتها ربط المرحلة الثانية في باقتي Pro (Professional) وAdvanced فقط', fit: 'محاسبة سحابية مع الفوترة الإلكترونية والمخزون ونقاط البيع؛ المشاريع والمهام في باقتي Pro وAdvanced', pricing: 'أسعار منشورة سنوياً بالريال: Basic بـ١,٢٠٠ (المرحلة الأولى فقط)، وProfessional بـ١,٨٠٠ (المرحلة الثانية)؛ تجربة مجانية ١٤ يوماً' },
  { slug: 'wafeq', name: 'وافِق (Wafeq)', status: 'تقول إنها تدعم المرحلة الثانية وترتبط مباشرة بمنصة فاتورة', fit: 'محاسبة بمشاريع ومراكز تكلفة تُصفّي تقرير الأرباح والخسائر: ربحية كل مشروع', pricing: 'أسعار منشورة: Starter بسعر ١١٩ ريالاً شهرياً أو ١,١٩٠ ريالاً سنوياً، دون الضريبة؛ تجربة مجانية ١٤ يوماً' },
  { slug: 'first-bit-erp', name: 'فرست بت (First Bit)', status: 'تقول إنه يرسل فواتير المرحلة الثانية إلى فاتورة ويُعد إقرارات القيمة المضافة والاستقطاع', fit: 'نظام تخطيط موارد للمقاولات: التحكم بتكاليف المشاريع والمشتريات والمالية والموارد البشرية والرواتب والمعدات', pricing: 'بعرض سعر' },
  { slug: 'medad-erp', name: 'مداد (Medad)', status: 'تقول إنه معتمد للمرحلة الثانية من الفوترة الإلكترونية', fit: 'نظام محاسبة وموارد سعودي للمنشآت الصغيرة والمتوسطة: مالية ومخزون ورواتب في نظام واحد', pricing: 'بعرض سعر (Medad Online حسب عدد المستخدمين)' },
  { slug: 'daftra', name: 'دفترة (Daftra)', status: 'تقول إنها متوافقة مع المرحلتين الأولى والثانية دون تكلفة إضافية', fit: 'وحدة مقاولات بالمستخلصات والمحتجزات وتقارير ربحية كل مشروع', pricing: 'أسعار منشورة بالدولار: من ٣٠ دولاراً شهرياً أو ٢٤٠ دولاراً سنوياً' },
  { slug: 'onyx-pro-erp', name: 'أونكس برو (Onyx Pro)', status: 'تقول الشركة إنه يُصدر فواتير المرحلة الثانية المرتبطة بمنصة فاتورة', fit: 'نظام موارد بالعربية والإنجليزية مع وحدتي إدارة المشاريع والرواتب؛ لا تصف صفحته خصائص خاصة بالمقاولات', pricing: 'بعرض سعر' },
  { slug: 'pact-erp', name: 'باكت (PACT)', status: 'يذكر موقعه دعم الفوترة الإلكترونية دون ادعاء اعتماد من الهيئة', fit: 'نظام موارد للمقاولات: جدولة وتتبع الميزانية والتكاليف ومشتريات ورواتب', pricing: 'بعرض سعر' },
].filter((row) => inDirectory(row.slug));
const zatcaCount = zatcaReady.length;

const notInvoicing = [
  { slug: 'oracle-aconex', name: 'أوراكل أكونكس' },
  { slug: 'oracle-primavera-p6', name: 'بريمافيرا P6' },
  { slug: 'autodesk-construction-cloud', name: 'أوتوديسك فورما' },
  { slug: 'procore', name: 'بروكور' },
  { slug: 'planradar', name: 'بلان رادار' },
  { slug: 'bentley-systems', name: 'بنتلي' },
].filter((row) => inDirectory(row.slug));

const faqs = [
  { q: 'هل تنطبق الفوترة الإلكترونية على شركات المقاولات؟', a: 'تصف EY المرحلة الأولى، السارية منذ ٤ ديسمبر ٢٠٢١، بأنها تُلزم بإصدار الفواتير والإشعارات إلكترونياً مع ما يتصل بها من معالجة وحفظ للسجلات، والمرحلة الثانية، السارية منذ ١ يناير ٢٠٢٣ والمطبقة على موجات، بأنها ربط نظام المكلّف بالهيئة وإرسال الفواتير والإشعارات الإلكترونية إليها. وتحدد تقارير EY عن الموجتين ٢٤ و٢٥ نطاقهما بالإيرادات الخاضعة للضريبة لا بالقطاع، فتُستدعى منشأة المقاولات إلى المرحلة الثانية عندما تتجاوز إيراداتها حد موجة ما؛ وتفيد EY بأن الموجة ٢٥ تشمل الإيرادات الخاضعة للضريبة فوق ١٨٧,٥٠٠ ريال.' },
  { q: 'هل انتهى الموعد النهائي للموجة ٢٤؟ وماذا عن الموجات اللاحقة؟', a: 'نعم. تفيد EY بأن الموجة ٢٤ شملت المكلّفين الذين تجاوزت إيراداتهم الخاضعة للضريبة ٣٧٥,٠٠٠ ريال في عام ٢٠٢٢ أو ٢٠٢٣ أو ٢٠٢٤، وكانت فترة ربطها بين ١ أبريل و٣٠ يونيو ٢٠٢٦. إن كنت ضمن نطاقها ولم تُكمل الربط بعد، فأنت الآن غير ممتثل وعليك المبادرة فوراً. وقد أُعلنت موجة لاحقة: تفيد EY بأن الهيئة أعلنت في ٢٤ يوليو ٢٠٢٦ الموجة ٢٥ للإيرادات الخاضعة للضريبة فوق ١٨٧,٥٠٠ ريال في أي عام من ٢٠٢٢ إلى ٢٠٢٥، وبأن على المكلّفين فيها الاستعداد للامتثال لمتطلبات المرحلة الثانية ابتداءً من ١ فبراير ٢٠٢٧. وتفيد EY أيضاً بأن الهيئة تُشعر المكلّفين المعنيين قبل ربط أنظمتهم بمنصة «فاتورة»، فتابع إشعاراتك فيها.' },
  { q: 'ما الذي تتطلبه المرحلة الثانية (الربط والتكامل) فعلياً؟', a: 'تصف EY المرحلة الثانية بأنها ربط نظام الفوترة لديك بالهيئة وإرسال الفواتير والإشعارات الإلكترونية إليها، عبر منصة «فاتورة». ويصف المزودون في دليلنا تفاصيل مختلفة: تقول Qoyod إنها ترسل كل فاتورة من المرحلة الثانية إلى «فاتورة» مع رمز QR وتوقيع رقمي وختم تشفير، وتقول First Bit إنها ترسل فواتير المرحلة الثانية بتوقيعات رقمية، وتقول Daftra إنها تضيف رمز QR تلقائياً. لا يعرض هذا الدليل المواصفات الفنية للهيئة، فراجعها في وثائق الفوترة الإلكترونية لدى الهيئة واطلب من المزود أن يعرض لك الربط مع «فاتورة» وهو يعمل.' },
  { q: 'هل Procore أو Aconex أو Primavera متوافقة مع هيئة الزكاة؟', a: 'السؤال لا ينطبق عليها، فهذه منصات لإدارة المشاريع والوثائق والجدولة، وليست أنظمة فوترة، ولا تُصدر فواتير ضريبية، لذا تبقى الفوترة الإلكترونية في نظام المحاسبة أو تخطيط الموارد (مثل Qoyod وWafeq وDaftra وFirst Bit، ويقول كل منها إنه يدعم المرحلة الثانية). والمقاول الذي يستخدم إحدى هذه المنصات يحتاج أيضاً إلى نظام محاسبة أو موارد متوافق مع هيئة الزكاة للفوترة الإلكترونية.' },
  { q: 'كيف تتعامل الفوترة الإلكترونية مع المستخلصات والدفعات المقدمة ومحتجزات الضمان؟', a: 'هذه هي الحالات الإنشائية التي يجب اختبارها قبل الشراء: كيف يُصدر النظام الفاتورة الضريبية لكل مستخلص معتمد على العقد، وكيف يفوتر الدفعات المقدمة ويسوّيها على المستخلصات اللاحقة، وكيف يتتبع محتجزات الضمان. ومعالجة النظام لهذه الحالات مسألة مستقلة عن دعمه للمرحلة الثانية، فاطلب من المورد عرضاً على سيناريوهات فوترتك أنت، وتحقق من المعالجة الضريبية لكل منها مع مستشارك الضريبي.' },
  { q: 'ماذا يحدث الآن إن لم نُكمل الربط بعد؟', a: 'إن كنت ضمن الموجة ٢٤ فقد أُغلقت فترة ربطها (١ أبريل إلى ٣٠ يونيو ٢٠٢٦، بحسب EY) وأنت الآن غير ممتثل. وإن كنت ضمن الموجة ٢٥ فبحسب EY عليك الاستعداد للامتثال للمرحلة الثانية ابتداءً من ١ فبراير ٢٠٢٧، فخطّط للربط قبل ذلك. وتقول EY إن على المنشآت الامتثال لتجنب غرامات محتملة؛ تحقق من قواعد الغرامات الحالية لدى الهيئة أو مستشارك الضريبي. إن كنت متأخراً، فعامِل الربط كأولوية عاجلة لا خياراً.' },
];

const pageTitle = 'الفوترة الإلكترونية (المرحلة الثانية) لشركات المقاولات في السعودية: دليل ٢٠٢٦';
const pageDescription = 'تفيد EY بأن فترة ربط الموجة ٢٤ (إيرادات خاضعة للضريبة فوق ٣٧٥,٠٠٠ ريال) كانت من ١ أبريل إلى ٣٠ يونيو ٢٠٢٦، وبأن على منشآت الموجة ٢٥ (فوق ١٨٧,٥٠٠ ريال) الاستعداد للامتثال للمرحلة الثانية ابتداءً من ١ فبراير ٢٠٢٧. ما تتطلبه المرحلة الثانية من المقاولين، وما يجب اختباره في المستخلصات والدفعات المقدمة ومحتجزات الضمان، وأي برامج المقاولات يقول مزودوها إنها تدعمها. دليل مستقل، مُحدّث أكتوبر ٢٠٢٦.';

const enUrl = new URL('/sa/guides/zatca-e-invoicing-contractors/', Astro.site).toString();
const arUrl = new URL('/sa/ar/guides/zatca-e-invoicing-contractors/', Astro.site).toString();

const breadcrumbs = [
  { name: 'الرئيسية', url: '/' },
  { name: 'السعودية', url: '/sa/ar/' },
  { name: 'الفوترة الإلكترونية للمقاولين', url: '/sa/ar/guides/zatca-e-invoicing-contractors/' },
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: pageTitle,
  description: pageDescription,
  datePublished: '2026-06-11',
  dateModified: '2026-10-01',
  inLanguage: 'ar',
  author: { '@type': 'Organization', name: 'WrenchStack Research', url: 'https://wrenchstack.com/research/' },
  publisher: { '@type': 'Organization', name: 'WrenchStack', url: 'https://wrenchstack.com' },
  mainEntityOfPage: arUrl,
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  lang="ar"
  dir="rtl"
  alternateUrls={[{ hreflang: 'en', href: enUrl }, { hreflang: 'ar', href: arUrl }, { hreflang: 'x-default', href: enUrl }]}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <article class="mx-auto max-w-4xl px-4 py-12">
    <header class="mb-8">
      <div class="mb-3 flex items-center justify-between gap-3">
        <p class="text-sm font-semibold tracking-wider text-orange-600">🇸🇦 السعودية · دليل امتثال</p>
        <a href="/sa/guides/zatca-e-invoicing-contractors/" class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">English</a>
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        الفوترة الإلكترونية (المرحلة الثانية) لشركات المقاولات
      </h1>
      <p class="mt-3 text-lg text-slate-600 leading-relaxed">
        ماذا يعني الربط مع منصة «فاتورة» للمقاولين في السعودية (المستخلصات والدفعات المقدمة ومحتجزات الضمان) وأي برامج المقاولات يقول مزودوها إنها تدعم متطلبات هيئة الزكاة والضريبة والجمارك.
      </p>
      <p class="mt-3 text-sm text-slate-500">إعداد فريق أبحاث WrenchStack · نُشر في يونيو ٢٠٢٦ · حُدّث في ١ أكتوبر ٢٠٢٦ · هذا الدليل معلومات عامة وليس استشارة ضريبية. تحقق من وضع منشأتك لدى الهيئة أو مستشارك الضريبي.</p>
    </header>

    <section class="mb-8 rounded-lg border-2 border-orange-300 bg-orange-50 p-6">
      <h2 class="mb-2 text-lg font-bold text-slate-900">✅ الخلاصة السريعة</h2>
      <p class="text-slate-800 leading-relaxed">
        <strong>أُغلقت فترة ربط الموجة ٢٤، وأُعلنت الموجة ٢٥.</strong> تفيد EY بأن <strong>الموجة ٢٤</strong> من المرحلة الثانية شملت الإيرادات الخاضعة للضريبة فوق <strong>٣٧٥,٠٠٠ ريال</strong> في عام ٢٠٢٢ أو ٢٠٢٣ أو ٢٠٢٤، وكانت فترة ربطها بين ١ أبريل و<strong>٣٠ يونيو ٢٠٢٦</strong>، وقد مضى هذا التاريخ. وتفيد EY بأن <strong>الموجة ٢٥</strong> التي أُعلنت في يوليو ٢٠٢٦ تشمل الإيرادات الخاضعة للضريبة فوق <strong>١٨٧,٥٠٠ ريال</strong> في أي عام من ٢٠٢٢ إلى ٢٠٢٥، وبأن على المكلّفين فيها الاستعداد للامتثال للمرحلة الثانية ابتداءً من <strong>١ فبراير ٢٠٢٧</strong>. تتطلب المرحلة الثانية ربط نظام الفوترة لديك بمنصة «فاتورة» وإرسال الفواتير الإلكترونية إليها. وإن كنت ضمن الموجة ٢٤ ولم تُكمل الربط بعد فأنت غير ممتثل وعليك المبادرة فوراً. منصات إدارة المشاريع مثل Procore وAconex <em>لا</em> تفي بهذا المتطلب: فهي لا تُصدر فواتير ضريبية، لذا يجب أن تصدر الفاتورة الإلكترونية من نظام المحاسبة أو تخطيط الموارد لديك.
      </p>
    </section>

    <section class="mb-10 grid gap-3 sm:grid-cols-3">
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">١ فبراير ٢٠٢٧</div>
        <div class="mt-1 text-xs text-slate-600">الموجة ٢٥: الامتثال للمرحلة الثانية ابتداءً من هذا التاريخ (بحسب EY)</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">١٨٧,٥٠٠ ريال</div>
        <div class="mt-1 text-xs text-slate-600">حد الإيرادات الخاضعة للضريبة في الموجة ٢٥ (بحسب EY)</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">{zatcaCount} من {softwareCount}</div>
        <div class="mt-1 text-xs text-slate-600">برامج في دليلنا السعودي يقول مزودوها إنها تدعم الفوترة الإلكترونية (سبتمبر ٢٠٢٦)</div>
      </div>
    </section>

    <section class="mb-10 space-y-4 text-slate-700 leading-relaxed">
      <h2 class="text-2xl font-bold text-slate-900">ما الذي تتطلبه المرحلة الثانية فعلياً</h2>
      <p>
        طُبّقت الفوترة الإلكترونية في السعودية على مرحلتين. تصف EY <strong>المرحلة الأولى (الإصدار)</strong>، السارية منذ ٤ ديسمبر ٢٠٢١، بأنها تُلزم بإصدار الفواتير والإشعارات إلكترونياً مع ما يتصل بها من معالجة وحفظ للسجلات. أما <strong>المرحلة الثانية (الربط والتكامل)</strong>، السارية منذ ١ يناير ٢٠٢٣ والمطبقة على موجات، فهي الخطوة الأصعب: يجب أن يرتبط نظامك بمنصة «فاتورة» التابعة للهيئة وأن يرسل إليها الفواتير والإشعارات الإلكترونية.
      </p>
      <p>
        يصف المزودون في دليلنا تفاصيل مختلفة: تقول Qoyod إنها ترسل كل فاتورة من المرحلة الثانية إلى «فاتورة» مع رمز QR وتوقيع رقمي وختم تشفير، وتقول First Bit إنها ترسل فواتير المرحلة الثانية بتوقيعات رقمية، وتقول Daftra إنها تضيف رمز QR تلقائياً. لا يعرض هذا الدليل المواصفات الفنية للهيئة، فراجعها في وثائق الفوترة الإلكترونية لدى الهيئة، واطلب من أي مزود أن يعرض لك الربط مع «فاتورة» وهو يعمل قبل التوقيع.
      </p>
      <p>
        تستدعي الهيئة المنشآت إلى المرحلة الثانية على <strong>موجات حسب الإيرادات الخاضعة للضريبة</strong>، وتفيد EY بأن الهيئة تُشعر المكلّفين المعنيين قبل ربط أنظمتهم بمنصة «فاتورة». وبحسب EY، شملت <strong>الموجة ٢٤ الإيرادات الخاضعة للضريبة فوق ٣٧٥ ألف ريال</strong> في عام ٢٠٢٢ أو ٢٠٢٣ أو ٢٠٢٤، وكانت فترة ربطها بين ١ أبريل و٣٠ يونيو ٢٠٢٦، وقد <strong>أُغلقت هذه الفترة</strong>. وتفيد EY بأن <strong>الموجة ٢٥</strong>، التي أُعلنت في يوليو ٢٠٢٦، تشمل الإيرادات الخاضعة للضريبة فوق <strong>١٨٧,٥٠٠ ريال</strong> في أي عام من ٢٠٢٢ إلى ٢٠٢٥، وبأن على المكلّفين فيها الاستعداد للامتثال للمرحلة الثانية ابتداءً من <strong>١ فبراير ٢٠٢٧</strong>. على المقاول الصغير الذي يتجاوز هذا الحد أن يتوقع إشعاراً من الهيئة، فتابع إشعاراتك في منصة «فاتورة».
      </p>

      <h2 class="text-2xl font-bold text-slate-900 pt-4">ما الذي يجب اختباره في فوترة المقاولات</h2>
      <p>
        تشمل فوترة المقاولات المستخلصات والدفعات المقدمة ومحتجزات الضمان وعقود التوريد والتركيب. ومعالجة النظام لهذه الحالات مسألة مستقلة عن دعمه للمرحلة الثانية، لذا قبل الالتزام بأي نظام، اطلب من المورد عرضاً على حالاتك أنت:
      </p>
      <ul class="list-disc pr-6 space-y-2">
        <li><strong>المستخلصات:</strong> هل يُصدر النظام فاتورة ضريبية نظامية على العقد لكل مستخلص معتمد، بكميات تراكمية صحيحة وخصم المستخلصات السابقة وضريبة القيمة المضافة؟</li>
        <li><strong>الدفعات المقدمة:</strong> هل يُصدر فاتورة دفعة مقدمة نظامية ثم يسوّيها بشكل صحيح على المستخلصات اللاحقة؟</li>
        <li><strong>محتجزات الضمان:</strong> المحتجزات تغيّر توقيت الاستحقاق. يجب أن يحافظ النظام على المعالجة الضريبية الصحيحة للمبالغ المفوترة مع تتبع المحتجز حتى المستخلص الختامي.</li>
        <li><strong>عقود التوريد والتركيب:</strong> فوترة سلع وخدمات معاً على عقد واحد.</li>
        <li><strong>سلسلة مقاولي الباطن:</strong> مطابقة فواتير مقاولي الباطن الإلكترونية الواردة مع الشهادات، ومعالجة ضريبة الاستقطاع حيث تنطبق.</li>
      </ul>

      <h2 class="text-2xl font-bold text-slate-900 pt-4">أي برامج المقاولات تقول إنها جاهزة لهيئة الزكاة؟</h2>
      <p>
        من بين {softwareCount} برنامجاً في <a href="/sa/ar/" class="text-orange-700 hover:underline font-medium">دليلنا السعودي</a>، هذه هي البرامج التي تعلن دعم الفوترة الإلكترونية، مع ملاحظاتنا على الملاءمة. وتبيع Focus Softnet أيضاً وحدة منفصلة للفوترة الإلكترونية لنظامها ولأنظمة أخرى، أما منتجها Focus CAFM فليس نظام فوترة. (تحقق دائماً من أي مورد في <a href="https://zatca.gov.sa/ar/E-Invoicing/SolutionProviders/Pages/SolutionProvidersDirectory.aspx" rel="nofollow noopener" target="_blank" class="text-orange-700 hover:underline font-medium">دليل مزودي الحلول الرسمي لدى الهيئة</a> قبل التوقيع.)
      </p>
    </section>

    <section class="mb-10 overflow-x-auto">
      <table class="w-full text-sm border border-slate-200 rounded-lg overflow-hidden">
        <thead class="bg-slate-50 text-right text-slate-700">
          <tr>
            <th class="p-3 font-semibold">المنصة</th>
            <th class="p-3 font-semibold">حالة الاعتماد</th>
            <th class="p-3 font-semibold">الملاءمة</th>
            <th class="p-3 font-semibold">التسعير</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 bg-white">
          {zatcaReady.map((v) => (
            <tr>
              <td class="p-3 font-semibold text-slate-900"><a href={`/sa/${v.slug}/`} class="text-orange-700 hover:underline">{v.name}</a></td>
              <td class="p-3 text-slate-700">{v.status}</td>
              <td class="p-3 text-slate-600">{v.fit}</td>
              <td class="p-3 text-slate-600">{v.pricing}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="mt-3 text-xs text-slate-500">المصدر: دليل WrenchStack السعودي، تم التحقق في سبتمبر ٢٠٢٦. الحالات بحسب ما ينشره كل مورد؛ أكّد نطاق الاعتماد لموجتك أثناء العرض. (المراجعات التفصيلية متاحة بالإنجليزية.)</p>
    </section>

    <section class="mb-10 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-2 text-lg font-bold text-slate-900">والأدوات التي لا يشملها الإلزام أصلاً</h2>
      <p class="text-sm text-slate-700 leading-relaxed">
        {notInvoicing.map((v, i) => (<><a href={`/sa/${v.slug}/`} class="font-medium text-orange-700 hover:underline">{v.name}</a>{i < notInvoicing.length - 1 ? '، ' : ''}</>))} منصات لإدارة المشاريع والنمذجة والموقع، <strong>وليست أنظمة فوترة</strong>: فهي لا تُصدر فواتير ضريبية، لذا تبقى الفوترة الإلكترونية في نظام المحاسبة أو تخطيط الموارد لديك. إن كنت تدير مشاريعك بإحداها، فاستخدم معها نظام محاسبة أو موارد من الجدول أعلاه للفوترة. لا ترفض منصة إدارة مشاريع بحجة «عدم اعتماد الهيئة»، ولا تفترض أن منصة المشاريع تغنيك عن الالتزام.
      </p>
    </section>

    <section class="mb-10 space-y-3 text-slate-700 leading-relaxed">
      <h2 class="text-2xl font-bold text-slate-900">قائمة الامتثال للمقاولين</h2>
      <ol class="list-decimal pr-6 space-y-2">
        <li><strong>تأكد من وضعك.</strong> تفيد EY بأن الموجة ٢٤ شملت الإيرادات الخاضعة للضريبة فوق ٣٧٥ ألف ريال في ٢٠٢٢ أو ٢٠٢٣ أو ٢٠٢٤، وكانت فترة ربطها بين ١ أبريل و٣٠ يونيو ٢٠٢٦ (انقضت). وإن تجاوزت إيراداتك الخاضعة للضريبة ١٨٧,٥٠٠ ريال في أي عام من ٢٠٢٢ إلى ٢٠٢٥ ولم تكن ضمن موجة سابقة، فبحسب EY تشملك الموجة ٢٥، ويبدأ الامتثال للمرحلة الثانية من ١ فبراير ٢٠٢٧. راجع بوابة «فاتورة» وبيانات تواصلك المسجّلة لمتابعة إشعار الهيئة.</li>
        <li><strong>اختر نظاماً الآن.</strong> اختر من الجدول أعلاه وتحقق من دليل مزودي الحلول لدى الهيئة. إن كان موعدك قد انقضى فالربط عاجل: لا تُراكم أشهراً أخرى من عدم الامتثال؛ وإلا فاترك وقتاً كافياً للإعداد والاختبار قبل موعدك.</li>
        <li><strong>اطلب عرضاً على حالات فوترتك أنت.</strong> المستخلصات، الدفعات المقدمة، المحتجزات، التوريد والتركيب، على هيكل عقودك الفعلي.</li>
        <li><strong>اربط نظامك بمنصة فاتورة.</strong> يتولى المورد أو المحاسب ربط حل الفوترة لديك بمنصة «فاتورة»؛ اتفقوا على من ينفّذ كل خطوة.</li>
        <li><strong>نفّذ اختباراً.</strong> أصدر دفعة محدودة من الفواتير الإلكترونية الفعلية عبر الربط قبل تحويل المنشأة كلها.</li>
        <li><strong>درّب الإدارة المالية.</strong> من يرفع المستخلصات يجب أن يعرف بيانات الفاتورة التي يتطلبها الربط. عالج الأخطاء من المصدر لا في نهاية الشهر.</li>
      </ol>
    </section>

    <section class="mb-10">
      <h2 class="mb-5 text-2xl font-bold text-slate-900">أسئلة شائعة</h2>
      <div class="space-y-3">
        {faqs.map((f) => (
          <details class="rounded-lg border border-slate-200 bg-white p-4">
            <summary class="cursor-pointer font-semibold text-slate-900">{f.q}</summary>
            <p class="mt-3 text-slate-700 leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mb-10 rounded-lg bg-slate-50 p-5 text-xs text-slate-500 leading-relaxed">
      <strong class="text-slate-700">المصادر والتحقق:</strong> وصف المرحلتين الأولى والثانية، والموجة ٢٤ (فوق ٣٧٥,٠٠٠ ريال في ٢٠٢٢ أو ٢٠٢٣ أو ٢٠٢٤؛ الربط من ١ أبريل إلى ٣٠ يونيو ٢٠٢٦) والموجة ٢٥ (فوق ١٨٧,٥٠٠ ريال في ٢٠٢٢ إلى ٢٠٢٥؛ الامتثال للمرحلة الثانية ابتداءً من ١ فبراير ٢٠٢٧) كما نقلتها نشرات EY الضريبية، وأُعيدت قراءتها في ١ أكتوبر ٢٠٢٦؛ وتعذّر الوصول إلى موقع zatca.gov.sa في هذا التحديث. قدرات الموردين كما يصفها كل مورد، أُعيد التحقق منها في سبتمبر ٢٠٢٦. هذا الدليل معلومات عامة وليس استشارة ضريبية. تحقق من التزاماتك لدى الهيئة أو مستشار مرخّص. وجدت خطأ؟ <a href="/contact/" class="underline">أخبرنا</a>.
    </section>

    <section class="rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">قارن الخيارات جنباً إلى جنب</h2>
      <p class="mt-2 text-slate-300 leading-relaxed">مراجعات مستقلة لـ {vendors.length} منصة وجهة في دليلنا السعودي: التسعير والمزايا والعيوب وسياق الامتثال، بلا ترتيب مدفوع.</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/sa/ar/" class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600">🇸🇦 الدليل السعودي ←</a>
        <a href="/sa/compare/" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">قارن الأنظمة (بالإنجليزية)</a>
        <a href="/for-vendors/" class="rounded-md border border-white/30 bg-white/10 px-5 py-3 text-sm font-semibold text-white hover:bg-white/20">هل أنت مورد؟ اعمل معنا</a>
      </div>
    </section>
  </article>
