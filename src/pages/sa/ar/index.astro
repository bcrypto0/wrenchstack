---
import Layout from '../../../layouts/Layout.astro';
import saData from '../../../data/international/sa.json';

interface SaVendor {
  slug: string; name: string; category: string; vendor_url: string;
  tagline: string; tier: 'S' | 'A' | 'F';
  is_cross_market: boolean;
}
const vendors = (saData as { vendors: SaVendor[] }).vendors;

// Concise Arabic positioning per vendor (the detailed reviews remain in English for now).
const ar: Record<string, string> = {
  'oracle-aconex': 'منصة Oracle السحابية للتحكم بالوثائق والمراسلات الرسمية وسير عمل المراجعة في سجل مشترك لكل أطراف المشروع، مع نسخة للسعودية (KSA1). أعلنت Oracle في يناير ٢٠٢٦ أن Red Sea Global اختارتها مع Primavera P6. لا تُصدر فواتير ضريبية.',
  'oracle-primavera-p6': 'برنامج Oracle لجدولة المشاريع وإدارة المحافظ، سحابياً أو محلياً (P6 EPPM)، ويحتاج إلى مخطط مدرّب. أعلنت Oracle في يناير ٢٠٢٦ أن Red Sea Global اختارته مع Aconex. السعر بعرض من Oracle أو أحد شركائها.',
  'autodesk-construction-cloud': 'منصة Autodesk السحابية للإنشاءات، وأصبحت جزءاً من Autodesk Forma في ٢٤ مارس ٢٠٢٦. تُباع في ثلاث حزم: إدارة النماذج، ومرحلة ما قبل التنفيذ، وعمليات التنفيذ، والأسعار بعرض سعر.',
  'procore': 'منصة لإدارة مشاريع الإنشاءات والجودة والسلامة والشؤون المالية، بعدد غير محدود من المستخدمين في كل عقد (بحسب Procore). مكتبها الإقليمي في دبي، ولا موقع سعودياً لها ولا خيار عربياً في موقعها. أعلن مطار الملك سلمان الدولي في يوليو ٢٠٢٦ بدء تطبيقها مع Tasama.',
  'planradar': 'تطبيق لفحص المواقع وتتبع الملاحظات والعيوب على المخططات الرقمية، بموقع سعودي بالعربية والإنجليزية ومكتب في الرياض. أسعار منشورة بالدولار تبدأ من ٣٢ دولاراً شهرياً، مع تجربة مجانية لمدة ٣٠ يوماً.',
  'bentley-systems': 'برامج هندسية للبنية التحتية ونمذجة المباني، منها SYNCHRO 4D وOpenBuildings Designer، مع مكتب سعودي في الخبر. أسعار اشتراك سنوي منشورة بالدولار لمستخدم واحد، منها OpenBuildings Designer ابتداءً من ٣,٨٤٤ دولاراً.',
  'first-bit-erp': 'نظام تخطيط موارد للمقاولات من First Bit، التي تأسست في موسكو ولها مكتب في الرياض: التحكم بتكاليف المشاريع والمشتريات والمحاسبة والرواتب والمعدات. تقول First Bit إنه يرسل فواتير المرحلة الثانية إلى منصة فاتورة. السعر بعرض سعر.',
  'pact-erp': 'نظام تخطيط موارد للمقاولات من PACT Software، ومقرها الهند ولها مكتب في الرياض: جدولة المشاريع وتتبع الميزانية والتكاليف والمشتريات والرواتب. تذكر صفحته دعم الفوترة الإلكترونية دون ادعاء اعتماد من هيئة الزكاة.',
  'medad-erp': 'نظام محاسبة وتخطيط موارد سعودي من Medad LLC للمنشآت الصغيرة والمتوسطة: المالية والمبيعات والمخزون والرواتب، سحابياً أو مكتبياً. تقول Medad إنه معتمد للمرحلة الثانية من الفوترة الإلكترونية. الأسعار عبر التواصل مع المبيعات.',
  'onyx-pro-erp': 'نظام Onyx ERP من Ultimate Solutions، التي تقول إنها تأسست في جدة عام ٢٠٠٧: المحاسبة والمخزون والمشتريات والرواتب مع وحدة لإدارة المشاريع، بالعربية والإنجليزية. تقول الشركة إنه يُصدر فواتير المرحلة الثانية المرتبطة بمنصة فاتورة.',
  'qoyod': 'محاسبة سحابية سعودية تأسست في الرياض عام ٢٠١٦، مع الفوترة الإلكترونية والمخزون ونقاط البيع. تقول Qoyod إنها معتمدة من هيئة الزكاة، والربط في المرحلة الثانية متاح في باقتي Pro وAdvanced فقط. أسعار سنوية منشورة بالريال على صفحة الباقات: Basic بـ١,٢٠٠ ريال (المرحلة الأولى فقط) وProfessional بـ١,٨٠٠ ريال (مع ربط المرحلة الثانية)، وتجربة مجانية لمدة ١٤ يوماً.',
  'wafeq': 'محاسبة سحابية من Wafeq FZ-LLC، وهي شركة إماراتية، بموقع سعودي وأسعار منشورة بالريال تبدأ من ١١٩ ريالاً شهرياً بالدفع الشهري (٩٩ ريالاً شهرياً بالدفع السنوي) دون ضريبة القيمة المضافة، مع تتبع الأرباح حسب المشروع ومركز التكلفة. تقول Wafeq إنها تدعم المرحلة الثانية وترتبط مباشرة بمنصة فاتورة.',
  'daftra': 'نظام سحابي للمحاسبة وإدارة الأعمال تشغّله Izam, Inc.، مع وحدة مقاولات تشمل المستخلصات والمحتجزات وربحية كل مشروع. أسعار منشورة بالدولار تبدأ من ٣٠ دولاراً شهرياً بالدفع الشهري (٢٠ دولاراً شهرياً بالدفع السنوي). تقول Daftra إنها متوافقة مع المرحلتين الأولى والثانية من الفوترة الإلكترونية.',
  'focus-softnet-centra': 'برنامج Focus CAFM لإدارة المرافق من Focus Softnet: أوامر العمل والصيانة وتتبع الأصول والوصول عبر الجوال، مع مكاتب في الرياض وجدة والخبر. تبيع Focus وحدة منفصلة للفوترة الإلكترونية. السعر بعرض سعر.',
  'saudi-council-of-engineers': 'الهيئة السعودية للمهندسين: يشترط نظام مزاولة المهن الهندسية الحصول على اعتمادها المهني قبل مزاولة الهندسة في السعودية، وتصل الغرامة إلى مليون ريال لمن يزاول دون اعتماد.',
  'contractor-classification': 'تصنيف المقاولين (وزارة البلديات والإسكان): لا تقبل الجهات الحكومية عرضاً لمشروع خاضع للتصنيف إلا من مقاول مصنّف في مجاله ونشاطه ودرجته. تُقدَّم الطلبات عبر منصة بلدي، وطلب شهادة التصنيف مجاني بحسب الوزارة.',
  'balady': 'منصة بلدي من وزارة البلديات والإسكان: رخص البناء وشهادات إتمام البناء والفحص خلال مراحل التنفيذ وطلبات التصنيف. تقول الوزارة إن رخصة البناء الجديدة تستغرق ١-١٠ أيام.',
  'saudi-building-code': 'كود البناء السعودي: إلزامي بموجب نظام تطبيق كود البناء السعودي (المرسوم الملكي م/٤٣ لعام ٢٠١٧) على كل أعمال البناء العامة والخاصة، مع غرامات تصل إلى مليون ريال لكل مخالفة في كل مبنى.',
  'zatca-fatoora': 'الفوترة الإلكترونية (فاتورة) من هيئة الزكاة والضريبة والجمارك: تتطلب المرحلة الثانية ربط أنظمة الفوترة بمنصة فاتورة، وتُطبَّق على موجات حسب حجم الأعمال. بحسب EY، تشمل الموجة ٢٥ الإيرادات الخاضعة للضريبة فوق ١٨٧,٥٠٠ ريال، وعلى منشآتها الاستعداد للامتثال للمرحلة الثانية ابتداءً من ١ فبراير ٢٠٢٧.',
  'qiwa-nitaqat': 'قوى ونطاقات: قوى منصة وزارة الموارد البشرية والتنمية الاجتماعية لخدمات نظام العمل، ونطاقات برنامج السعودة الذي يضع كل منشأة في أحد خمسة نطاقات تحدد الخدمات المتاحة لها، من التأشيرات الجديدة إلى تجديد رخص العمل.',
  'saudi-contractors-authority': 'الهيئة السعودية للمقاولين: أفادت Argaam في ٢٠١٨ بأن الشركات أُلزمت بالانضمام إلى الهيئة قبل التقدم للمنافسات، وقدّرت Arab News في يوليو ٢٠٢٦ عدد المقاولين المسجلين لديها بنحو ١١٧ ألفاً.',
  'etimad': 'اعتماد: منصة المنافسات والعقود والمدفوعات الحكومية التي يديرها المركز الوطني لنظم الموارد الحكومية. تتابع الشركات المنافسات والعروض والضمانات البنكية والمستحقات المالية عبر حساب أعمال في اعتماد.',
};

const tierAr: Record<string, string> = { S: 'أسعار منشورة', A: 'مدرج', F: 'تحذير بشأن السمعة' };
const cats = [
  { key: 'software', label: 'برامج المقاولات والإنشاءات', desc: 'منصات مشاريع من مزودين عالميين (Oracle وAutodesk وProcore وPlanRadar وBentley)، وأنظمة تخطيط موارد للمقاولات تُباع في السعودية (First Bit وPACT)، وأنظمة محاسبة وتخطيط موارد يقول مزودوها إنها تدعم الفوترة الإلكترونية (Qoyod وWafeq وDaftra وMedad وOnyx)، وبرنامج Focus Softnet لإدارة المرافق.' },
  { key: 'certification', label: 'التراخيص والامتثال', desc: 'الجهات والأنظمة السعودية التي يتعامل معها المقاولون: الهيئة السعودية للمهندسين، تصنيف المقاولين، بلدي، كود البناء السعودي، الفوترة الإلكترونية من هيئة الزكاة، قوى ونطاقات، الهيئة السعودية للمقاولين، واعتماد.' },
];

const enUrl = new URL('/sa/', Astro.site).toString();
const arUrl = new URL('/sa/ar/', Astro.site).toString();
const pageTitle = 'دليل برامج المقاولات والإنشاءات في السعودية';
const pageDescription = 'دليل مستقل لبرامج المقاولات والإنشاءات في السعودية: منصات إدارة المشاريع ونمذجة معلومات البناء، وأنظمة تخطيط الموارد والمحاسبة التي يقول مزودوها إنها تدعم الفوترة الإلكترونية، وبرامج إدارة المرافق، مع جهات الترخيص والامتثال المحلية.';
---

<Layout
  title={pageTitle}
  description={pageDescription}
  lang="ar"
  dir="rtl"
  alternateUrls={[{ hreflang: 'en', href: enUrl }, { hreflang: 'ar', href: arUrl }, { hreflang: 'x-default', href: enUrl }]}
>
  <article class="mx-auto max-w-5xl px-4 py-12">

    <div class="mb-6 flex items-center justify-between gap-3">
      <div class="flex items-center gap-2">
        <span class="text-2xl" aria-hidden="true">🇸🇦</span>
        <p class="text-sm font-semibold uppercase tracking-wider text-orange-600">المملكة العربية السعودية</p>
      </div>
      <a href="/sa/" class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">English</a>
    </div>

    <header class="mb-10">
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">دليل برامج المقاولات والإنشاءات في السعودية</h1>
      <p class="mt-4 text-lg text-slate-600 leading-relaxed">
        مراجعات مستقلة لـ {vendors.length} منتجاً وجهة ذات صلة بالسوق السعودي: منصات مشاريع من مزودين عالميين (Oracle Aconex وPrimavera P6 وAutodesk وProcore وPlanRadar وBentley)، وأنظمة تخطيط موارد للمقاولات تُباع في السعودية (First Bit وPACT)، وأنظمة محاسبة وتخطيط موارد يقول مزودوها إنها تدعم الفوترة الإلكترونية (Qoyod وWafeq وDaftra وMedad وOnyx)، وبرنامج لإدارة المرافق، مع سياق الامتثال المحلي (الهيئة السعودية للمهندسين، تصنيف المقاولين، بلدي، كود البناء السعودي، الفوترة الإلكترونية، نطاقات، الهيئة السعودية للمقاولين، اعتماد). أما شركات التأمين ومنصة ProTenders فتُعرض في الدليل الإنجليزي.
      </p>
    </header>

    <section class="mb-10 flex flex-wrap items-center justify-between gap-4 rounded-lg border-2 border-emerald-300 bg-emerald-50 p-5">
      <div>
        <p class="text-xs font-bold tracking-wider text-emerald-700">✅ دليل امتثال · الموجة ٢٥: الامتثال للمرحلة الثانية من ١ فبراير ٢٠٢٧ (بحسب EY)</p>
        <h2 class="mt-1 text-base font-bold text-slate-900">الفوترة الإلكترونية (المرحلة الثانية) لشركات المقاولات</h2>
        <p class="mt-1 text-sm text-slate-700">بحسب EY، تشمل الموجة ٢٥ من هيئة الزكاة المنشآت التي تتجاوز إيراداتها الخاضعة للضريبة ١٨٧,٥٠٠ ريال، وعليها الاستعداد للامتثال لمتطلبات المرحلة الثانية ابتداءً من ١ فبراير ٢٠٢٧؛ أما الموجة ٢٤ (أكثر من ٣٧٥,٠٠٠ ريال) فكانت فترة ربطها من ١ أبريل إلى ٣٠ يونيو ٢٠٢٦، بحسب EY أيضاً. ما تتطلبه المرحلة الثانية من نظام الفوترة، وما يجب اختباره في المستخلصات والمحتجزات، وأي الأنظمة يقول مزودوها إنها تدعم المرحلة الثانية.</p>
      </div>
      <a href="/sa/ar/guides/zatca-e-invoicing-contractors/" class="shrink-0 rounded-md bg-emerald-700 px-5 py-3 text-sm font-semibold text-white hover:bg-emerald-800">اقرأ الدليل ←</a>
    </section>

    <section class="mb-10 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-3 text-base font-bold text-slate-900">ما الذي يميّز اختيار البرامج في السعودية</h2>
      <p class="text-sm text-slate-700 leading-relaxed">
        يختلف اختيار برامج الإنشاءات في السعودية في جوانب هيكلية عن السوق الأمريكية. أولاً، <strong>الفوترة الإلكترونية (فاتورة) إلزامية</strong>: تتطلب المرحلة الثانية، المطبقة على موجات حسب حجم الإيرادات، ربط أنظمة الفوترة بمنصة «فاتورة» التابعة لهيئة الزكاة وإرسال الفواتير الإلكترونية إليها، لذا تحقق من أن مزود نظام المحاسبة أو تخطيط الموارد يقول إنه يدعم المرحلة الثانية. ثانياً، <strong>تحقق من اللغة والعملة</strong>: بعض الأدوات هنا تقدم واجهة عربية أو موقعاً سعودياً، وبعضها يعرض الأسعار بالدولار أو بعملات أجنبية أخرى فقط (PlanRadar وBentley وDaftra)، ولا يوفر موقع Procore خياراً عربياً. ثالثاً، لا تقبل الجهات الحكومية عرضاً لمشروع خاضع للتصنيف إلا من مقاول <strong>مصنّف</strong> في مجاله ونشاطه ودرجته، وتُطرح المنافسات الحكومية عبر منصة <strong>اعتماد</strong>، وأفادت Argaam في ٢٠١٨ بأن الشركات أُلزمت بالانضمام إلى <strong>الهيئة السعودية للمقاولين</strong> قبل التقدم للمنافسات. أما نظام <strong>نطاقات</strong> للسعودة (عبر قوى) فيضع كل منشأة في نطاق يحدد الخدمات المتاحة لها، من التأشيرات الجديدة إلى تجديد رخص العمل، وهو مفهوم لا مقابل له في الولايات المتحدة. وأخيراً، قد يحدد مالك المشروع الكبير أدواتك: أعلنت Oracle في يناير ٢٠٢٦ أن Red Sea Global اختارت Aconex وPrimavera P6، وأعلن مطار الملك سلمان الدولي في يوليو ٢٠٢٦ بدء تطبيق موحد لإدارة الإنشاءات رقمياً مع Tasama وProcore.
      </p>
    </section>

    {cats.map((cat) => {
      const cv = vendors.filter((v) => v.category === cat.key);
      if (cv.length === 0) return null;
      return (
        <section class="mb-12">
          <div class="mb-5">
            <h2 class="text-2xl font-bold text-slate-900">{cat.label}</h2>
            <p class="mt-1 text-sm text-slate-600 leading-relaxed">{cat.desc}</p>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            {cv.map((v) => {
              const isCert = v.category === 'certification';
              const tierColor = v.tier === 'S' ? 'border-emerald-300' : v.tier === 'F' ? 'border-rose-300' : 'border-blue-300';
              const tierBadge = v.tier === 'S' ? 'bg-emerald-100 text-emerald-900' : v.tier === 'F' ? 'bg-rose-100 text-rose-900' : 'bg-blue-100 text-blue-900';
              const label = isCert ? 'جهة رسمية' : tierAr[v.tier];
              return (
                <article class={`rounded-lg border-2 ${tierColor} bg-white p-4`}>
                  <div class="mb-1 flex items-center gap-2 flex-wrap">
                    <h3 class="text-lg font-bold text-slate-900">{v.name}</h3>
                    <span class={`rounded-full px-2 py-0.5 text-xs font-bold ${tierBadge}`}>{label}</span>
                  </div>
                  <p class="text-sm text-slate-700 leading-relaxed">{ar[v.slug] ?? v.tagline}</p>
                  <div class="mt-3 flex flex-wrap gap-2">
                    <a href={`/sa/${v.slug}/`} class="rounded-md bg-slate-900 px-3 py-1.5 text-xs font-semibold text-white hover:bg-slate-700">التفاصيل (بالإنجليزية) ←</a>
                    <a href={v.vendor_url} rel="sponsored nofollow noopener" target="_blank" class="rounded-md bg-orange-500 px-3 py-1.5 text-xs font-semibold text-white hover:bg-orange-600">{isCert ? 'الموقع الرسمي' : 'زيارة الموقع'} ←</a>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      );
    })}

    <section class="mb-10 rounded-lg border border-slate-200 bg-white p-5 text-sm text-slate-600">
      <p>المراجعات التفصيلية لكل منتج متاحة <a href="/sa/" class="font-medium text-orange-600 hover:underline">بالإنجليزية</a>، ويعرض الدليل الإنجليزي أيضاً شركات التأمين ومنصة معلومات المشاريع ProTenders.</p>
    </section>

    <section class="rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">هل أنت مزوّد برامج سعودي؟</h2>
      <p class="mt-2 text-slate-300 leading-relaxed">إذا كنت تطوّر برامج للمقاولات أو تخطيط الموارد أو المحاسبة أو الخدمة الميدانية للسوق السعودي/الخليجي وترغب في المراجعة أو الإدراج، تواصل معنا عبر <a href="/for-vendors/" class="underline">برنامج المزوّدين</a>.</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/for-vendors/" class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600">العمل معنا ←</a>
        <a href="/sa/" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">English directory</a>
      </div>
    </section>
  </article>
</Layout>
