---
import Layout from '../../layouts/Layout.astro';
import saData from '../../data/international/sa.json';

interface SaVendor {
  slug: string; name: string; category: string; vendor_url: string;
  tagline: string; market_position: string; sa_specific_note?: string | null;
  tier: 'S' | 'A' | 'F'; reputation_flag: string | null;
  pros: string[]; cons: string[]; typical_pricing: string;
  is_cross_market: boolean; cross_market_link: string | null;
}

const vendors = (saData as { vendors: SaVendor[] }).vendors;

const categories = ['software', 'insurance', 'lead-gen', 'certification'];
const categoryMeta: Record<string, { label: string; description: string }> = {
  'insurance': { label: 'Contractor insurance', description: "Saudi insurers with contractor-related business: Tawuniya, which the Insurance Authority selected to lead its Inherent Defects Insurance pool from June 2025; Walaa, which Reinsurance News reported in December 2024 leads the co-insurance pool issuing surety bonds for qualified contractors on PIF development-company projects; and GIG Saudi, which sells engineering insurance for construction and installation projects. No published rates were confirmed for any of them, so ask the insurer or a licensed broker for a quote." },
  'lead-gen': { label: 'Lead generation & project intelligence', description: "ProTenders' GCC construction project intelligence and eTendering, with a free company-profile tier. Saudi government tenders run separately on Etimad, listed under licensing & compliance." },
  'software': { label: 'Construction & trades software', description: "Project platforms from global vendors (Oracle Aconex, Primavera P6, Autodesk, Procore, PlanRadar, Bentley), construction ERPs sold in Saudi Arabia from Riyadh offices (First Bit, PACT), accounting and ERP systems whose vendors say they support ZATCA e-invoicing (Qoyod, Wafeq, Daftra, Medad, Onyx), and Focus Softnet's facility-management (CAFM) software." },
  'certification': { label: 'Licensing & compliance', description: 'Saudi bodies and rules that contractors deal with: Saudi Council of Engineers accreditation, contractor classification by the Ministry of Municipalities and Housing, Balady permits, the Saudi Building Code, ZATCA e-invoicing, Qiwa and Nitaqat Saudization, Saudi Contractors Authority membership and the Etimad government procurement platform.' },
};

const vendorsByCategory: Record<string, SaVendor[]> = {};
categories.forEach(c => { vendorsByCategory[c] = vendors.filter(v => v.category === c); });

const pageTitle = 'Saudi Arabia Construction & Trades Software | WrenchStack';
const pageDescription = `Independent directory of ${vendors.length} construction and trades vendors and official bodies for Saudi Arabia: project management and BIM software, construction ERPs, accounting and ERP systems whose vendors say they support ZATCA e-invoicing, facility-management software, contractor insurers and project leads, plus the SCE, contractor classification, Balady, SBC and ZATCA rules that apply.`;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Saudi Arabia', url: '/sa/' },
];

const enUrl = new URL('/sa/', Astro.site).toString();
const arUrl = new URL('/sa/ar/', Astro.site).toString();
---

<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs} alternateUrls={[{ hreflang: 'en', href: enUrl }, { hreflang: 'ar', href: arUrl }, { hreflang: 'x-default', href: enUrl }]}>
  <article class="mx-auto max-w-5xl px-4 py-12">

    <header class="mb-10">
      <div class="mb-3 flex items-center justify-between gap-3">
        <div class="flex items-center gap-2">
          <span class="text-2xl" aria-hidden="true">🇸🇦</span>
          <p class="text-sm font-semibold uppercase tracking-wider text-orange-600">Saudi Arabia · المملكة العربية السعودية</p>
        </div>
        <a href="/sa/ar/" class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">العربية</a>
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">
        Saudi Construction & Trades Software Directory
      </h1>
      <p class="mt-4 text-lg text-slate-600 leading-relaxed">
        Independent reviews of {vendors.length} Saudi-relevant vendors and official bodies: project platforms from global vendors (Oracle Aconex, Primavera P6, Autodesk, Procore, PlanRadar, Bentley), construction ERPs sold in Saudi Arabia (First Bit, PACT), accounting and ERP systems whose vendors say they support ZATCA e-invoicing (Qoyod, Wafeq, Daftra, Medad, Onyx), facility-management software, contractor insurers and project leads, with the local compliance context (SCE, contractor classification, Balady, Saudi Building Code, ZATCA e-invoicing, Nitaqat, Saudi Contractors Authority, Etimad).
      </p>
    </header>

    <section class="mb-10 grid gap-3 grid-cols-2 sm:grid-cols-4">
      {categories.map(c => (
        <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
          <div class="text-2xl font-bold text-slate-900">{vendorsByCategory[c].length}</div>
          <div class="mt-1 text-xs text-slate-600 capitalize">{c}</div>
        </div>
      ))}
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">~117k</div>
        <div class="mt-1 text-xs text-slate-600">contractors registered with SCA (Arab News, July 2026)</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">SAR 187.5k</div>
        <div class="mt-1 text-xs text-slate-600">ZATCA Wave 25 turnover threshold (per EY)</div>
      </div>
    </section>

    <section class="mb-10 flex flex-wrap items-center justify-between gap-4 rounded-lg border border-orange-200 bg-orange-50 p-5">
      <div>
        <h2 class="text-base font-bold text-slate-900">Deciding between two options?</h2>
        <p class="mt-1 text-sm text-slate-700">See Saudi vendors compared side by side: a short verdict, pros and cons, Saudi-specific notes, and pricing, head to head.</p>
      </div>
      <a href="/sa/compare/" class="shrink-0 rounded-md bg-slate-900 px-5 py-3 text-sm font-semibold text-white hover:bg-slate-700">Compare Saudi vendors →</a>
    </section>

    <section class="mb-10 flex flex-wrap items-center justify-between gap-4 rounded-lg border-2 border-emerald-300 bg-emerald-50 p-5">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-emerald-700">✅ Compliance guide · Wave 25: comply with Phase 2 from 1 Feb 2027 (per EY)</p>
        <h2 class="mt-1 text-base font-bold text-slate-900">ZATCA Phase 2 e-invoicing for construction companies</h2>
        <p class="mt-1 text-sm text-slate-700">EY reports that ZATCA's Wave 25 covers taxable turnover above SAR 187,500 and that businesses in it should prepare to comply with Phase 2 starting from 1 February 2027; Wave 24 (above SAR 375,000) had its integration window from 1 April to 30 June 2026, also per EY. What Phase 2 asks of your invoicing system, what to test for progress claims and retention, and which platforms say they support Phase 2.</p>
      </div>
      <a href="/sa/guides/zatca-e-invoicing-contractors/" class="shrink-0 rounded-md bg-emerald-700 px-5 py-3 text-sm font-semibold text-white hover:bg-emerald-800">Read the guide →</a>
    </section>

    <section class="mb-10 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-3 text-base font-bold text-slate-900">What's different about choosing software in Saudi Arabia</h2>
      <p class="text-sm text-slate-700 leading-relaxed">
        Saudi construction software selection has structural differences from the US. First, <strong>ZATCA e-invoicing (Fatoora) is mandatory</strong>: Phase 2, rolled out in waves by turnover, requires businesses to integrate their invoicing systems with ZATCA's Fatoora platform and send e-invoices to it, so check that your accounting or ERP vendor says it supports Phase 2. Second, <strong>check language and currency</strong>: some tools here have Arabic interfaces or Saudi websites, while others show prices only in USD or other foreign currencies (PlanRadar, Bentley, Daftra) or have no Arabic website option (Procore). Third, government bodies may not accept a bid on a project subject to classification unless the contractor is <strong>classified</strong> in that field, activity and grade; government tenders run on <strong>Etimad</strong>; and Argaam reported in 2018 that firms must join the <strong>Saudi Contractors Authority</strong> before bidding for tenders. <strong>Nitaqat Saudization</strong> (via Qiwa) places each entity in a range that decides which services it can use, from new expatriate visas to work permit renewals, a concept with no US equivalent. Finally, a large project owner's platform choice can shape your tools: Oracle announced in January 2026 that Red Sea Global had selected Aconex and Primavera P6, and King Salman International Airport said in July 2026 that it had begun a unified digital construction management rollout with Tasama and Procore.
      </p>
    </section>

    {categories.map(c => {
      const cat = categoryMeta[c];
      const cv = vendorsByCategory[c];
      if (cv.length === 0) return null;
      return (
        <section class="mb-12">
          <div class="mb-5">
            <h2 class="text-2xl font-bold text-slate-900">{cat.label}</h2>
            <p class="mt-1 text-sm text-slate-600 leading-relaxed">{cat.description}</p>
          </div>
          <div class="space-y-4">
            {cv.map(v => {
              const isCert = v.category === 'certification';
              const tierColor = v.tier === 'S' ? 'border-emerald-300' : v.tier === 'F' ? 'border-rose-300' : 'border-blue-300';
              const tierLabel = isCert ? 'Official body' : v.tier === 'S' ? 'Published prices' : v.tier === 'F' ? 'Reputation warning' : 'Listed';
              const tierBadge = v.tier === 'S' ? 'bg-emerald-100 text-emerald-900' : v.tier === 'F' ? 'bg-rose-100 text-rose-900' : 'bg-blue-100 text-blue-900';
              return (
                <article class={`rounded-lg border-2 ${tierColor} bg-white p-5`}>
                  <div class="mb-3 flex items-start justify-between gap-3">
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-2 mb-1 flex-wrap">
                        <h3 class="text-xl font-bold text-slate-900">{v.name}</h3>
                        <span class={`rounded-full px-2 py-0.5 text-xs font-bold ${tierBadge}`}>{isCert ? tierLabel : `Tier ${v.tier} · ${tierLabel}`}</span>
                        </div>
                      <p class="text-sm italic text-slate-500">{v.tagline}</p>
                    </div>
                  </div>

                  {v.reputation_flag && (
                    <div class="mb-3 rounded-md border-l-4 border-rose-500 bg-rose-50 px-4 py-3 text-sm text-rose-900">
                      <p class="font-bold uppercase tracking-wider text-xs text-rose-700 mb-1">⚠ Reputation warning</p>
                      <p class="leading-relaxed">{v.reputation_flag}</p>
                    </div>
                  )}

                  <p class="mb-3 text-sm text-slate-700 leading-relaxed">{v.market_position}</p>

                  {v.sa_specific_note && (
                    <div class="mb-3 rounded-md bg-slate-50 px-4 py-3">
                      <p class="text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Saudi-specific note</p>
                      <p class="text-sm text-slate-700 leading-relaxed">{v.sa_specific_note}</p>
                    </div>
                  )}

                  <div class="mb-3 grid gap-3 sm:grid-cols-2">
                    <div>
                      <p class="text-xs font-bold uppercase tracking-wider text-emerald-700 mb-1">{isCert ? 'What it covers' : 'Pros'}</p>
                      <ul class="space-y-1 text-sm text-slate-700">
                        {v.pros.slice(0, 4).map(p => <li class="leading-snug">+ {p}</li>)}
                      </ul>
                    </div>
                    <div>
                      <p class="text-xs font-bold uppercase tracking-wider text-rose-700 mb-1">{isCert ? 'Watch out for' : 'Cons'}</p>
                      <ul class="space-y-1 text-sm text-slate-700">
                        {v.cons.slice(0, 4).map(con => <li class="leading-snug">− {con}</li>)}
                      </ul>
                    </div>
                  </div>

                  <div class="mb-3 text-xs text-slate-600">
                    <strong class="text-slate-900">{isCert ? 'Cost / access:' : 'Typical Saudi pricing:'}</strong> {v.typical_pricing}
                  </div>

                  <div class="flex flex-wrap gap-2">
                    <a href={`/sa/${v.slug}/`} class="rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700">Full Saudi review →</a>
                    <a href={v.vendor_url} rel="sponsored nofollow noopener" target="_blank" class="rounded-md bg-orange-500 px-4 py-2 text-sm font-semibold text-white hover:bg-orange-600">{isCert ? 'Official site' : `Visit ${v.name}`} →</a>
                    {v.cross_market_link && (
                      <a href={v.cross_market_link} class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">Full review (US market context)</a>
                    )}
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      );
    })}

    <section class="mt-12 rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">Are you a Saudi software vendor?</h2>
      <p class="mt-2 text-slate-300 leading-relaxed">
        {vendors.length} Saudi vendors and official bodies are covered today. If you build construction, ERP, accounting or field-service software for the Saudi/Gulf market and want to be reviewed or listed, get in touch through our <a href="/for-vendors/" class="underline">vendor program</a>.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/for-vendors/" class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600">Work with us →</a>
        <a href="/" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">Back to US directory</a>
        <a href="/methodology/" class="rounded-md border border-white/30 bg-white/10 px-5 py-3 text-sm font-semibold text-white hover:bg-white/20">Methodology</a>
      </div>
    </section>
  </article>
</Layout>
