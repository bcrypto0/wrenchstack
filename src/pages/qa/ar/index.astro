---
import Layout from '../../../layouts/Layout.astro';
import qaData from '../../../data/international/qa.json';

interface QaVendor {
  slug: string; name: string; category: string; vendor_url: string;
  tagline: string; tier: 'S' | 'A' | 'F';
  is_cross_market: boolean;
}
const vendors = (qaData as { vendors: QaVendor[] }).vendors;
const software = vendors.filter((v) => v.category === 'software');
// Tier S = the vendor's own site publishes prices, so the rest publish none.
const softwareNoPriceCount = software.filter((v) => v.tier !== 'S').length;

// Concise Arabic positioning per vendor (detailed reviews remain in English for now).
const ar: Record<string, string> = {
  'oracle-aconex': 'منصة سحابية من Oracle تجمع وثائق المشروع والمراسلات الرسمية ومسارات المراجعة في سجل مشترك بين المالك والاستشاريين والمقاولين. الأسعار حسب الطلب.',
  'oracle-primavera-p6': 'برنامج Oracle لجدولة المسار الحرج وإدارة محافظ المشاريع (P6 EPPM وP6 Professional)، وتذكر Oracle هيئة الأشغال العامة (أشغال) عميلاً لـ Oracle Primavera. الأسعار حسب الطلب.',
  'autodesk-construction-cloud': 'منصة Autodesk للإنشاءات، نُقلت في ٢٤ مارس ٢٠٢٦ إلى علامة Autodesk Forma، وتُباع في ثلاث حزم بأسعار حسب الطلب لتنسيق النماذج وما قبل التنفيذ وعمليات البناء. لا تشمل المحاسبة أو الفوترة.',
  'procore': 'منصة لإدارة المشاريع الإنشائية والجودة والسلامة والإدارة المالية للمشاريع. لا مكتب لها في قطر وأقرب مكتب في دبي، والأسعار حسب الطلب برسوم سنوية لكل منتج بحسب الإيرادات السنوية.',
  'planradar': 'تطبيق لتوثيق الموقع والفحص وإدارة العيوب، بأسعار منشورة لكل مستخدم بالدولار الأمريكي (من ٣٢ دولاراً شهرياً) وتجربة مجانية لمدة ٣٠ يوماً. له موقعان باللغة العربية للإمارات والسعودية، ولا مكتب له في قطر.',
  'focus-softnet': 'نظام تخطيط موارد المؤسسات Focus X مع وحدات لإدارة المشاريع وضبط التكاليف للمقاولين، ونظام Focus CAFM لإدارة المرافق. للشركة مكتب في الدوحة، والأسعار حسب الطلب.',
  'pact-erp': 'نظام تخطيط موارد متعدد الوحدات من شركة PACT Software Services ومقرها حيدر آباد في الهند، يشمل جدولة المشاريع والمشتريات وضبط التكاليف والموارد البشرية والرواتب. تذكر الشركة رقم هاتف في الدوحة دون عنوان في قطر.',
  'skystruct': 'منصة لإدارة المشاريع الإنشائية من شركة مقرها واحة قطر للعلوم والتكنولوجيا في الدوحة، تشمل طلبات الاعتماد وطلبات المعلومات والجداول الزمنية والفحوص. الأسعار حسب الطلب بحد أدنى ٣ مستخدمين.',
  'insight-cafm': 'نظام سحابي لإدارة مرافق معسكرات العمال وسكن الموظفين من شركة E Concept في دبي. لا مكتب له في قطر، والأسعار حسب الطلب.',
  'monaqasat': 'مناقصات: بوابة وزارة المالية الموحدة للمشتريات الحكومية وتصنيف الموردين والمقاولين، والتصنيف شرط للمشاركة في المناقصات الحكومية.',
  'qatar-gta': 'الهيئة العامة للضرائب: ضريبة الدخل (١٠٪) وضريبة الاستقطاع والضريبة الانتقائية عبر بوابة ضريبة، ولا توجد ضريبة قيمة مضافة حتى الآن.',
  'qatar-einvoicing': 'الفوترة الإلكترونية: وافق مجلس الوزراء على مشروع القانون في ٦ مايو ٢٠٢٦ بحسب EY، ولم يُعلن موعد رسمي لتطبيقه حتى ٣٠ سبتمبر ٢٠٢٦.',
  'qatarization': 'التقطير (القانون رقم ١٢ لسنة ٢٠٢٤): يلزم أصحاب العمل في القطاع الخاص بإعطاء الأولوية للمواطنين القطريين وإبلاغ وزارة العمل بالشواغر والرواتب.',
  'qatar-baladiya-permits': 'وزارة البلدية: تصدر رخص البناء عبر نظام يعتمد على الذكاء الاصطناعي أُطلق في ٢٦ أكتوبر ٢٠٢٥ لتدقيق المخططات الهندسية قبل التقديم.',
  'ashghal-qcs': 'هيئة الأشغال العامة (أشغال) ومواصفات البناء القطرية QCS 2014 التي تسري على جميع المباني قيد الإنشاء بحسب The Peninsula، وتضيف أشغال ملاحظات إرشادية مؤقتة على مشاريعها فقط.',
  'kahramaa': 'كهرماء: المالك والمشغّل الوحيد لشبكات نقل وتوزيع الكهرباء والماء في قطر بحسب وصفها، وتنشر قوائم مقاولي الكهرباء والمياه المعتمدين والمواد المعتمدة، وترخّص مقاولي الطاقة الشمسية.',
};

const tierAr: Record<string, string> = { S: 'أسعار منشورة', A: 'مدرج', F: 'تحذير بشأن السمعة' };
const cats = [
  { key: 'software', label: 'برامج المقاولات والإنشاءات', desc: 'منصات إدارة المشاريع والوثائق والجدولة والنمذجة (Oracle Aconex، Oracle Primavera P6، Autodesk Forma، Procore)، وPlanRadar لفحص الموقع، وأنظمة تخطيط الموارد التي تذكر جهات اتصال في قطر (Focus Softnet، PACT ERP)، وSkyStruct من شركة مقرها الدوحة، وInsight CAFM لإدارة سكن العمال.' },
  { key: 'certification', label: 'التراخيص والامتثال', desc: 'الجهات والقواعد القطرية ذات الصلة بالمقاولين: مناقصات، الهيئة العامة للضرائب، الفوترة الإلكترونية (مشروع قانون)، التقطير، رخص البناء البلدية، مواصفات QCS 2014، وكهرماء.' },
];

const enUrl = new URL('/qa/', Astro.site).toString();
const arUrl = new URL('/qa/ar/', Astro.site).toString();
const pageTitle = 'دليل برامج المقاولات والإنشاءات في قطر';
const pageDescription = 'دليل مستقل لبرامج المقاولات والإنشاءات في قطر: منصات إدارة المشاريع وأنظمة تخطيط الموارد وإدارة المرافق، مع جهات الترخيص والامتثال المحلية (مناقصات، الضرائب، التقطير، مواصفات QCS، كهرماء).';
---

<Layout
  title={pageTitle}
  description={pageDescription}
  lang="ar"
  dir="rtl"
  alternateUrls={[{ hreflang: 'en', href: enUrl }, { hreflang: 'ar', href: arUrl }, { hreflang: 'x-default', href: enUrl }]}
>
  <article class="mx-auto max-w-5xl px-4 py-12">

    <div class="mb-6 flex items-center justify-between gap-3">
      <div class="flex items-center gap-2">
        <span class="text-2xl" aria-hidden="true">🇶🇦</span>
        <p class="text-sm font-semibold uppercase tracking-wider text-orange-600">دولة قطر</p>
      </div>
      <a href="/qa/" class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">English</a>
    </div>

    <header class="mb-10">
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">دليل برامج المقاولات والإنشاءات في قطر</h1>
      <p class="mt-4 text-lg text-slate-600 leading-relaxed">
        مراجعات مستقلة لـ {vendors.length} إدراجاً ذا صلة بالسوق القطري، منها منصات إدارة المشاريع (Oracle Aconex، Oracle Primavera P6، Autodesk Forma، Procore)، وSkyStruct من شركة مقرها الدوحة، وأنظمة تخطيط الموارد وإدارة المرافق، مع جهات الامتثال المحلية (مناقصات، التقطير، مواصفات QCS، كهرماء). أما شركات التأمين وقواعد بيانات المشاريع فتُعرض في الدليل الإنجليزي.
      </p>
    </header>

    <section class="mb-10 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-3 text-base font-bold text-slate-900">ما الذي يميّز اختيار البرامج في قطر</h2>
      <p class="text-sm text-slate-700 leading-relaxed">
        لا توجد في قطر <strong>ضريبة قيمة مضافة</strong> حتى الآن: تتوقع PwC ضريبة بنسبة ٥٪ ضمن الإطار الخليجي دون موعد محدد، وأفادت The New Arab في ٢٥ سبتمبر ٢٠٢٦ بأنها ما تزال قيد الدراسة. أما <strong>الفوترة الإلكترونية</strong> فقد وافق مجلس الوزراء على مشروع قانونها في ٦ مايو ٢٠٢٦ بحسب EY، على أن تتولاها الهيئة العامة للضرائب، ولم يُعلن موعد رسمي لتطبيقها حتى ٣٠ سبتمبر ٢٠٢٦، لذا اختر برنامج فوترة يمكن تحديثه عند صدور القواعد. ويخضع التوظيف في القطاع الخاص لـ<strong>التقطير (القانون رقم ١٢ لسنة ٢٠٢٤)</strong>، وقواعده تختلف عن نطاقات في السعودية والتوطين في الإمارات. ويُشترط التصنيف في بوابة <strong>مناقصات</strong> للمشاركة في المناقصات الحكومية، وتسري <strong>مواصفات البناء القطرية QCS 2014</strong> على أعمال البناء (مع الملاحظات الإرشادية المؤقتة التي تطبّقها أشغال على مشاريعها)، وتنشر <strong>كهرماء</strong> قوائم مقاولي الكهرباء والمياه والطاقة الشمسية المعتمدين. ولا ينشر {softwareNoPriceCount} من أصل {software.length} من البرامج المدرجة هنا أي أسعار، وتنشر PlanRadar أسعاراً لكل مستخدم بالدولار الأمريكي واليورو والجنيه الإسترليني والدولار الأسترالي، لا بالريال القطري.
      </p>
    </section>

    {cats.map((cat) => {
      const cv = vendors.filter((v) => v.category === cat.key);
      if (cv.length === 0) return null;
      return (
        <section class="mb-12">
          <div class="mb-5">
            <h2 class="text-2xl font-bold text-slate-900">{cat.label}</h2>
            <p class="mt-1 text-sm text-slate-600 leading-relaxed">{cat.desc}</p>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            {cv.map((v) => {
              const isCert = v.category === 'certification';
              const tierColor = v.tier === 'S' ? 'border-emerald-300' : v.tier === 'F' ? 'border-rose-300' : 'border-blue-300';
              const tierBadge = v.tier === 'S' ? 'bg-emerald-100 text-emerald-900' : v.tier === 'F' ? 'bg-rose-100 text-rose-900' : 'bg-blue-100 text-blue-900';
              const label = isCert ? 'جهة رسمية' : tierAr[v.tier];
              return (
                <article class={`rounded-lg border-2 ${tierColor} bg-white p-4`}>
                  <div class="mb-1 flex items-center gap-2 flex-wrap">
                    <h3 class="text-lg font-bold text-slate-900">{v.name}</h3>
                    <span class={`rounded-full px-2 py-0.5 text-xs font-bold ${tierBadge}`}>{label}</span>
                  </div>
                  <p class="text-sm text-slate-700 leading-relaxed">{ar[v.slug] ?? v.tagline}</p>
                  <div class="mt-3 flex flex-wrap gap-2">
                    <a href={`/qa/${v.slug}/`} class="rounded-md bg-slate-900 px-3 py-1.5 text-xs font-semibold text-white hover:bg-slate-700">التفاصيل (بالإنجليزية) ←</a>
                    <a href={v.vendor_url} rel="sponsored nofollow noopener" target="_blank" class="rounded-md bg-orange-500 px-3 py-1.5 text-xs font-semibold text-white hover:bg-orange-600">{isCert ? 'الموقع الرسمي' : 'زيارة الموقع'} ←</a>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      );
    })}

    <section class="mb-10 rounded-lg border border-slate-200 bg-white p-5 text-sm text-slate-600">
      <p>المراجعات التفصيلية لكل إدراج متاحة <a href="/qa/" class="font-medium text-orange-600 hover:underline">بالإنجليزية</a>.</p>
    </section>

    <section class="rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">هل أنت مزوّد برامج قطري؟</h2>
      <p class="mt-2 text-slate-300 leading-relaxed">إذا كنت تطوّر برامج للمقاولات أو تخطيط الموارد أو الخدمة الميدانية للسوق القطري/الخليجي وترغب في المراجعة أو الإدراج، تواصل معنا عبر <a href="/for-vendors/" class="underline">برنامج المزوّدين</a>.</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/for-vendors/" class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600">العمل معنا ←</a>
        <a href="/qa/" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">English directory</a>
      </div>
    </section>
  </article>
</Layout>
