---
import Layout from '../../layouts/Layout.astro';
import { EN_MARKET_HREFLANG } from '../../lib/intl';
import ukData from '../../data/international/uk.json';

interface UkVendor {
  slug: string;
  name: string;
  category: string;
  vendor_url: string;
  tagline: string;
  market_position: string;
  uk_specific_note: string;
  tier: 'S' | 'A' | 'F';
  reputation_flag: string | null;
  pros: string[];
  cons: string[];
  typical_pricing: string;
  is_cross_market: boolean;
  cross_market_link: string | null;
}

const vendors = (ukData as { vendors: UkVendor[] }).vendors;
const flaggedCount = vendors.filter(v => v.reputation_flag !== null).length;

const categories = ['software', 'lead-gen', 'insurance', 'payroll', 'certification'];
const categoryMeta: Record<string, { label: string; description: string }> = {
  'software': { label: 'Field service software', description: 'Job management software sold to UK trades: BigChange (Leeds), Joblogic (Birmingham) and Powered Now (Devon); Commusoft (London and Chicago); Tradify (founded in New Zealand, part of The Access Group since 2024) and ServiceM8 (an Australian company), both priced in sterling; and the AI quoting app Sleepless Tradesman.' },
  'lead-gen': { label: 'Lead-generation platforms', description: 'UK directories and marketplaces that connect customers with tradespeople: Checkatrade, MyBuilder, TrustATrader and Bark. Pricing models differ: Checkatrade publishes monthly plans, TrustATrader says it charges no commission or lead fees, on Bark you spend credits to respond to requests, and no MyBuilder prices could be read for this check.' },
  'insurance': { label: 'Business insurance', description: `Business insurance for UK tradespeople from three insurers selling direct (Hiscox UK, AXA Business UK, Direct Line for Business) and one online broker (Simply Business UK). Hiscox and AXA note that employers' liability is a legal requirement once you employ staff, and Simply Business says it usually is. How it is sold differs: Hiscox sells it only together with public liability, AXA lists it as one of the covers you select, Direct Line for Business includes it among the covers you build a policy from (up to £10 million as standard), and Simply Business offers it as an add-on.` },
  'payroll': { label: 'Payroll software', description: `Payroll software on HMRC's list of recognised payroll software: BrightPay, Sage Payroll UK and Xero Payroll (UK). Xero says it files RTI after each pay run, and BrightPay and Xero automate auto enrolment. For CIS returns, BrightPay needs the separate BrightCIS product and Xero has a £5 a month add-on.` },
  'certification': { label: 'Registration and certification schemes', description: 'Gas Safe Register is the HSE-approved register a business must be on to legally do gas work within the scope of the Gas Safety (Installation and Use) Regulations 1998. NICEIC (electrical) and OFTEC (oil, solid fuel and renewable heating) run competent person schemes that let members self-certify certain work instead of going through building control; other authorised schemes cover the same work.' },
};

const vendorsByCategory: Record<string, UkVendor[]> = {};
categories.forEach(c => { vendorsByCategory[c] = vendors.filter(v => v.category === c); });

const pageTitle = 'UK Trades Vendor Directory | WrenchStack United Kingdom';
const pageDescription = `WrenchStack's UK trades vendor directory: ${vendors.length} entries across software, lead generation, insurance, payroll and certification, with notes for UK contractors on Gas Safe registration, competent person schemes, RTI, CIS and VAT.`;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'United Kingdom', url: '/uk/' },
];
---

<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs} alternateUrls={EN_MARKET_HREFLANG}>
  <article class="mx-auto max-w-5xl px-4 py-12">

    <header class="mb-10">
      <div class="mb-3 flex items-center gap-2">
        <span class="text-2xl" aria-hidden="true">🇬🇧</span>
        <p class="text-sm font-semibold uppercase tracking-wider text-orange-600">United Kingdom</p>
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">
        UK Trades Vendor Directory
      </h1>
      <p class="mt-4 text-lg text-slate-600 leading-relaxed">
        Independent reviews of {vendors.length} UK-relevant vendors and schemes across 5 categories, written for UK contractors. Each entry notes the UK points the vendor covers or leaves out: Gas Safe Register, NICEIC and OFTEC schemes, HMRC RTI, CIS, employers' liability and VAT.
      </p>
    </header>

    <section class="mb-10 grid gap-3 grid-cols-2 sm:grid-cols-5">
      {categories.map(c => (
        <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
          <div class="text-2xl font-bold text-slate-900">{vendorsByCategory[c].length}</div>
          <div class="mt-1 text-xs text-slate-600 capitalize">{c.replace('-', ' ')}</div>
        </div>
      ))}
    </section>

    <section class="mb-10 flex flex-wrap items-center justify-between gap-4 rounded-lg border border-orange-200 bg-orange-50 p-5">
      <div>
        <h2 class="text-base font-bold text-slate-900">Deciding between two options?</h2>
        <p class="mt-1 text-sm text-slate-700">See UK vendors compared side by side: pros and cons, UK-specific notes and pricing, with a short summary of which one publishes its prices or carries a reputation warning.</p>
      </div>
      <a href="/uk/compare/" class="shrink-0 rounded-md bg-slate-900 px-5 py-3 text-sm font-semibold text-white hover:bg-slate-700">Compare UK vendors →</a>
    </section>

    <section class="mb-10 flex flex-wrap items-center justify-between gap-4 rounded-lg border-2 border-emerald-300 bg-emerald-50 p-5">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-emerald-700">⏰ Compliance guide · Live since 6 April 2026</p>
        <h2 class="mt-1 text-base font-bold text-slate-900">Making Tax Digital for Income Tax is live for sole traders</h2>
        <p class="mt-1 text-sm text-slate-700">Mandatory now over £50k, dropping to £30k in 2027 and £20k in 2028. What sole traders and CIS subbies must change, and which software actually files it.</p>
      </div>
      <a href="/uk/guides/making-tax-digital-tradespeople/" class="shrink-0 rounded-md bg-emerald-700 px-5 py-3 text-sm font-semibold text-white hover:bg-emerald-800">Read the guide →</a>
    </section>

    <section class="mb-10 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-3 text-base font-bold text-slate-900">What's different about UK trades vendor selection</h2>
      <p class="text-sm text-slate-700 leading-relaxed">
        Three UK points shape vendor choice here. First, <strong>gas work needs registration</strong>: a business must be on the Gas Safe Register to legally do gas work within the scope of the Gas Safety (Installation and Use) Regulations 1998, and HSE prosecutes unregistered gas fitters. For electrical and oil heating work, competent person schemes such as NICEIC and OFTEC let members self-certify certain work instead of going through building control, and other authorised schemes cover the same work. Second, <strong>payroll sits outside the job app</strong>: Powered Now, Tradify, ServiceM8 and Joblogic list no payroll features, so employers pair them with payroll software that files RTI to HMRC, and CIS returns may need a separate product or add-on (BrightCIS, or Xero's CIS add-on). Third, <strong>lead-generation pricing models differ</strong>: Checkatrade publishes monthly plans on 12-month memberships, TrustATrader says it charges no commission or lead fees, and on Bark you spend credits to respond to a request, with up to five professionals able to contact the same customer.
      </p>
    </section>

    {categories.map(c => {
      const cat = categoryMeta[c];
      const cv = vendorsByCategory[c];
      if (cv.length === 0) return null;
      return (
        <section class="mb-12">
          <div class="mb-5">
            <h2 class="text-2xl font-bold text-slate-900 capitalize">{cat.label}</h2>
            <p class="mt-1 text-sm text-slate-600 leading-relaxed">{cat.description}</p>
          </div>
          <div class="space-y-4">
            {cv.map(v => {
              const tierColor = v.tier === 'S' ? 'border-emerald-300' : v.tier === 'F' ? 'border-rose-300' : 'border-blue-300';
              const tierLabel = v.tier === 'S' ? 'Published prices' : v.tier === 'F' ? 'Reputation warning' : 'Listed';
              const tierBadge = v.tier === 'S' ? 'bg-emerald-100 text-emerald-900' : v.tier === 'F' ? 'bg-rose-100 text-rose-900' : 'bg-blue-100 text-blue-900';
              return (
                <article class={`rounded-lg border-2 ${tierColor} bg-white p-5`}>
                  <div class="mb-3 flex items-start justify-between gap-3">
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-2 mb-1 flex-wrap">
                        <h3 class="text-xl font-bold text-slate-900">{v.name}</h3>
                        <span class={`rounded-full px-2 py-0.5 text-xs font-bold ${tierBadge}`}>Tier {v.tier} · {tierLabel}</span>
                        </div>
                      <p class="text-sm italic text-slate-500">{v.tagline}</p>
                    </div>
                  </div>

                  {v.reputation_flag && (
                    <div class="mb-3 rounded-md border-l-4 border-rose-500 bg-rose-50 px-4 py-3 text-sm text-rose-900">
                      <p class="font-bold uppercase tracking-wider text-xs text-rose-700 mb-1">⚠ Reputation warning</p>
                      <p class="leading-relaxed">{v.reputation_flag}</p>
                    </div>
                  )}

                  <p class="mb-3 text-sm text-slate-700 leading-relaxed">{v.market_position}</p>

                  <div class="mb-3 rounded-md bg-slate-50 px-4 py-3">
                    <p class="text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">UK-specific note</p>
                    <p class="text-sm text-slate-700 leading-relaxed">{v.uk_specific_note}</p>
                  </div>

                  <div class="mb-3 grid gap-3 sm:grid-cols-2">
                    <div>
                      <p class="text-xs font-bold uppercase tracking-wider text-emerald-700 mb-1">Pros</p>
                      <ul class="space-y-1 text-sm text-slate-700">
                        {v.pros.slice(0, 4).map(p => <li class="leading-snug">+ {p}</li>)}
                      </ul>
                    </div>
                    <div>
                      <p class="text-xs font-bold uppercase tracking-wider text-rose-700 mb-1">Cons</p>
                      <ul class="space-y-1 text-sm text-slate-700">
                        {v.cons.slice(0, 4).map(con => <li class="leading-snug">− {con}</li>)}
                      </ul>
                    </div>
                  </div>

                  <div class="mb-3 text-xs text-slate-600">
                    <strong class="text-slate-900">Typical UK pricing:</strong> {v.typical_pricing}
                  </div>

                  <div class="flex flex-wrap gap-2">
                    <a href={`/uk/${v.slug}/`} class="rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700">Full UK review →</a>
                    <a href={v.vendor_url} rel="sponsored nofollow noopener" target="_blank" class="rounded-md bg-orange-500 px-4 py-2 text-sm font-semibold text-white hover:bg-orange-600">Visit {v.name} →</a>
                    {v.cross_market_link && (
                      <a href={v.cross_market_link} class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">Full review (US market context)</a>
                    )}
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      );
    })}

    <section class="mt-12 rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">About UK coverage</h2>
      <p class="mt-2 text-slate-300 leading-relaxed">
        {vendors.length} UK entries across {categories.length} categories. UK profiles are shorter than our US software reviews and focus on what UK contractors need to know. Want a UK vendor reviewed? Submit them via our <a href="/for-vendors/" class="underline">vendor program</a>.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/" class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600">Back to US directory →</a>
        <a href="/for-vendors/" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">Submit a UK vendor</a>
        <a href="/methodology/" class="rounded-md border border-white/30 bg-white/10 px-5 py-3 text-sm font-semibold text-white hover:bg-white/20">Methodology</a>
      </div>
    </section>
  </article>
</Layout>
