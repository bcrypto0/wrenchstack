---
import Layout from '../../../../layouts/Layout.astro';
import ukData from '../../../../data/international/uk.json';

interface UkVendor {
  slug: string; name: string; category: string;
}
const vendors = (ukData as { vendors: UkVendor[] }).vendors;
const bySlug = new Map(vendors.map((v) => [v.slug, v]));

// What each UK directory entry says about MTD for Income Tax, taken from the
// entries re-verified against vendor pages on 30 September 2026. Only Powered
// Now's entry claims MTD for Income Tax readiness; HMRC's software finder on
// GOV.UK is the source of truth for which products are compatible.
const mtdRows = [
  { slug: 'powered-now', mtd: 'Says it appears on HMRC’s software list for MTD for VAT and is ready for MTD for Income Tax', what: 'Job management for UK trades: quotes, invoices, certificates, CIS and Domestic Reverse Charge; Xero and QuickBooks integrations' },
  { slug: 'commusoft', mtd: 'No MTD for Income Tax filing described in our entry', what: 'Job management; integrates with Xero, QuickBooks Online, Sage Accounting and FreeAgent' },
  { slug: 'bigchange', mtd: 'No MTD for Income Tax filing described in our entry', what: 'Job management and vehicle tracking; names Xero and Sage among its accounting integrations' },
  { slug: 'joblogic', mtd: 'No MTD for Income Tax filing described in our entry', what: 'Field service management; links to Sage, QuickBooks, FreeAgent and KashFlow' },
  { slug: 'tradify-uk', mtd: 'No MTD for Income Tax filing described in our entry', what: 'Job management; syncs with Xero, Sage and QuickBooks Online' },
  { slug: 'servicem8-uk', mtd: 'No MTD for Income Tax filing described in our entry', what: 'Job management; connects to Xero and QuickBooks Online' },
  { slug: 'sleepless-tradesman', mtd: 'No MTD for Income Tax filing described in our entry', what: 'AI quoting and invoicing app; no accounting integration named in our entry' },
  { slug: 'xero-payroll-uk', mtd: 'Payroll on HMRC’s list of recognised payroll software; our entry covers payroll only', what: 'Payroll inside Xero’s UK accounting plans, with RTI filing after each pay run and an optional £5 a month CIS add-on' },
  { slug: 'sage-payroll-uk', mtd: 'Payroll on HMRC’s list of recognised payroll software; our entry covers payroll only', what: 'Cloud payroll from Sage for up to 150 employees' },
  { slug: 'brightpay', mtd: 'Payroll on HMRC’s list of recognised payroll software; our entry covers payroll only', what: 'Payroll; CIS returns need the separate BrightCIS product' },
]
  .filter((r) => bySlug.has(r.slug))
  .map((r) => ({ ...r, name: bySlug.get(r.slug)?.name ?? r.slug }));

const fsmTools = ['commusoft', 'bigchange', 'joblogic', 'tradify-uk', 'servicem8-uk']
  .filter((slug) => bySlug.has(slug))
  .map((slug) => ({ slug, name: bySlug.get(slug)?.name ?? slug }));

// Plain-prose list of the job apps above ("A, B and C"), without the "(UK)"
// suffix some entry names carry.
const fsmNames = fsmTools.map((t) => t.name.replace(/ \(UK\)$/, ''));
const fsmNameList = fsmNames.length > 1
  ? `${fsmNames.slice(0, -1).join(', ')} and ${fsmNames[fsmNames.length - 1]}`
  : fsmNames.join('');

const faqs = [
  { q: 'Does Making Tax Digital for Income Tax apply to tradespeople?', a: 'It applies to sole traders and landlords registered for Self Assessment who get income from self-employment or property, so it covers tradespeople who work as sole traders. GOV.UK says you should have started using it from 6 April 2026 if your qualifying income for the 2024 to 2025 tax year was over £50,000. The threshold is £30,000 from 6 April 2027 (based on 2025 to 2026 income) and £20,000 from 6 April 2028 (based on 2026 to 2027 income).' },
  { q: 'What changes compared with the old Self Assessment?', a: 'GOV.UK lists three things: keep digital records of your self-employment and property income and expenses; send quarterly updates every 3 months for each sole trader and property business, through compatible software; and submit your tax return through software by 31 January after the end of the tax year. If you keep your records in spreadsheets you can carry on, but you need software that links to them (bridging software).' },
  { q: 'Is my job-management app (Commusoft, Tradify, ServiceM8…) MTD software?', a: `Check rather than assume. Of the job-management apps in our UK directory, Powered Now says it is ready for MTD for Income Tax. Our entries for ${fsmNameList} describe no MTD filing, and each names integrations with accounting packages such as Xero, QuickBooks, Sage or FreeAgent. HMRC’s software finder on GOV.UK shows which products are compatible.` },
  { q: 'I’m a CIS subcontractor: what does MTD mean for me?', a: 'MTD for Income Tax covers how you keep records and report your self-employment income. If your qualifying income is over the threshold, the income you earn as a CIS subcontractor goes into your digital records and quarterly updates with the rest of your self-employment income. Ask any software vendor to show you how CIS deductions are recorded.' },
  { q: 'What is "qualifying income"?', a: 'GOV.UK defines it as your total income from self-employment and property before expenses (turnover), based on the tax return you submitted for the previous tax year. So a sole trader who turned over £55,000 in 2024 to 2025 is over the £50,000 threshold even if materials and van costs brought profit far below it.' },
  { q: 'What happens if I send a quarterly update late?', a: 'GOV.UK says HMRC will not apply penalty points for late quarterly updates during the 2026 to 2027 tax year, but you must send the quarterly updates before you can submit your tax return, and penalties for a late tax return still apply. After that tax year, each missed quarterly update deadline earns a late submission penalty point, and reaching 4 points brings a £200 penalty.' },
];

const pageTitle = 'Making Tax Digital for Tradespeople (2026): Who’s In, Deadlines & Software';
const pageDescription = 'MTD for Income Tax is now live: mandatory since 6 April 2026 for sole traders with qualifying income over £50k, then over £30k from April 2027 and £20k from April 2028. What it means for UK tradespeople and CIS subcontractors, and what the software in our UK directory says about it. Checked on GOV.UK, October 2026.';

const guideUrl = new URL('/uk/guides/making-tax-digital-tradespeople/', Astro.site).toString();

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'United Kingdom', url: '/uk/' },
  { name: 'Making Tax Digital for tradespeople', url: '/uk/guides/making-tax-digital-tradespeople/' },
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: pageTitle,
  description: pageDescription,
  datePublished: '2026-06-11',
  dateModified: '2026-10-01',
  inLanguage: 'en-GB',
  author: { '@type': 'Organization', name: 'WrenchStack Research', url: 'https://wrenchstack.com/research/' },
  publisher: { '@type': 'Organization', name: 'WrenchStack', url: 'https://wrenchstack.com' },
  mainEntityOfPage: guideUrl,
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <article class="mx-auto max-w-4xl px-4 py-12">
    <header class="mb-8">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-orange-600">🇬🇧 United Kingdom · Compliance guide</p>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        Making Tax Digital for Tradespeople: It’s Live. Here’s Who’s In and What to Check
      </h1>
      <p class="mt-3 text-lg text-slate-600 leading-relaxed">
        MTD for Income Tax became mandatory on 6 April 2026 for sole traders and landlords with qualifying income over £50,000. What changes, who comes in next, and what the software in our UK directory says about it.
      </p>
      <p class="mt-3 text-sm text-slate-500">By WrenchStack Research · Published June 2026 · Updated 1 October 2026 (thresholds, quarterly updates and penalty points checked on GOV.UK) · Not tax advice; confirm your position with HMRC or your accountant.</p>
    </header>

    <section class="mb-8 rounded-lg border-2 border-orange-300 bg-orange-50 p-6">
      <h2 class="mb-2 text-lg font-bold text-slate-900">⏰ The short version</h2>
      <p class="text-slate-800 leading-relaxed">
        If you’re a <strong>sole trader</strong> (or landlord) registered for Self Assessment and your qualifying income for 2024 to 2025 was over <strong>£50,000</strong>, GOV.UK says you should have started using Making Tax Digital for Income Tax from <strong>6 April 2026</strong>. You keep <strong>digital records</strong>, send HMRC <strong>quarterly updates through compatible software</strong>, and submit your tax return through software by 31 January. The threshold falls to <strong>£30,000 from April 2027</strong> and <strong>£20,000 from April 2028</strong>. HMRC will not apply penalty points for late quarterly updates during the 2026 to 2027 tax year. Of the job-management apps in our UK directory, only Powered Now’s entry says it is ready for MTD for Income Tax, so check your software on HMRC’s software finder.
      </p>
    </section>

    <section class="mb-10 grid gap-3 sm:grid-cols-3">
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">£50,000</div>
        <div class="mt-1 text-xs text-slate-600">mandatory since 6 Apr 2026 (on 2024-25 income)</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">£30,000</div>
        <div class="mt-1 text-xs text-slate-600">from 6 Apr 2027 (on 2025-26 income)</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">£20,000</div>
        <div class="mt-1 text-xs text-slate-600">from 6 Apr 2028 (on 2026-27 income)</div>
      </div>
    </section>

    <section class="mb-10 prose prose-slate max-w-none">
      <h2>What MTD for Income Tax requires</h2>
      <p>
        If you’re in scope, GOV.UK says you must:
      </p>
      <ul>
        <li>keep <strong>digital records</strong> of your self-employment and property income and expenses (spreadsheets are allowed if you use software that links to them);</li>
        <li>send HMRC a <strong>quarterly update</strong> every 3 months for each business, through <strong>compatible software</strong>;</li>
        <li>submit your <strong>tax return</strong> through software by 31 January after the end of the tax year.</li>
      </ul>
      <p>
        "Qualifying income" is your total self-employment and property income <strong>before expenses</strong>: turnover, not profit. An electrician billing £55,000 is in scope even if profit is half that. HMRC’s <a href="https://www.gov.uk/guidance/find-software-thats-compatible-with-making-tax-digital-for-income-tax" rel="nofollow noopener" target="_blank">software finder on GOV.UK</a> shows which products are compatible; that, not a vendor’s marketing page, is the source of truth.
      </p>

      <h2>Points for trades businesses</h2>
      <ul>
        <li><strong>CIS subcontractors:</strong> income you earn under the Construction Industry Scheme goes into your digital records and quarterly updates with the rest of your self-employment income. Ask any vendor to show how CIS deductions are recorded.</li>
        <li><strong>Materials in your turnover:</strong> the thresholds apply to income before expenses, so materials you buy and charge on to customers count towards £50,000 (or £30,000 from April 2027) even when your margin is modest.</li>
        <li><strong>Job apps and MTD:</strong> among the job-management apps in our UK directory, only Powered Now’s entry says it is ready for MTD for Income Tax. Our entries for {fsmNameList} name accounting integrations, which is how invoices raised in the job app can reach the records that feed your quarterly updates.</li>
      </ul>

      <h2>What the software in our UK directory says about MTD</h2>
      <p>
        From our <a href="/uk/">UK trades directory</a>, here is what each software and payroll entry says about MTD for Income Tax. HMRC’s software finder is what counts:
      </p>
    </section>

    <section class="mb-10 overflow-x-auto">
      <table class="w-full text-sm border border-slate-200 rounded-lg overflow-hidden">
        <thead class="bg-slate-50 text-left text-slate-700">
          <tr>
            <th class="p-3 font-semibold">Platform</th>
            <th class="p-3 font-semibold">MTD for Income Tax</th>
            <th class="p-3 font-semibold">What it is</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 bg-white">
          {mtdRows.map((v) => (
            <tr>
              <td class="p-3 font-semibold text-slate-900"><a href={`/uk/${v.slug}/`} class="text-orange-700 hover:underline">{v.name}</a></td>
              <td class="p-3 text-slate-700">{v.mtd}</td>
              <td class="p-3 text-slate-600">{v.what}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="mt-3 text-xs text-slate-500">Source: WrenchStack UK directory entries, checked against vendor pages on 30 September 2026. Check the exact product and plan on HMRC’s software finder before buying.</p>
    </section>

    <section class="mb-10 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-2 text-lg font-bold text-slate-900">Check whether your job-management app files MTD</h2>
      <p class="text-sm text-slate-700 leading-relaxed">
        {fsmTools.map((v, i) => (<><a href={`/uk/${v.slug}/`} class="font-medium text-orange-700 hover:underline">{v.name}</a>{i < fsmTools.length - 1 ? ', ' : ''}</>))} run quotes, scheduling, job tracking and customer invoicing, and our entries for them describe no MTD for Income Tax filing. Each names integrations with accounting packages such as Xero, QuickBooks, Sage or FreeAgent, so invoices raised in the job app can reach the digital records behind your quarterly updates. Don’t reject a job platform for "missing MTD", and don’t assume it covers you.
      </p>
    </section>

    <section class="mb-10 prose prose-slate max-w-none">
      <h2>Checklist for tradespeople</h2>
      <ol>
        <li><strong>Check your qualifying income.</strong> Over £50,000 in 2024 to 2025? You’re in scope now. Over £30,000 in 2025 to 2026? You’re in from 6 April 2027. Over £20,000 in 2026 to 2027? You’re in from 6 April 2028.</li>
        <li><strong>Pick software that HMRC’s finder lists as compatible</strong> with MTD for Income Tax, and confirm your plan includes it (not just MTD for VAT).</li>
        <li><strong>Connect your job-management app</strong> so invoices and expenses reach the digital records without re-keying.</li>
        <li><strong>Sort CIS handling</strong> if you work as a subcontractor: your CIS income and deductions belong in the same records.</li>
        <li><strong>Diarise the deadlines.</strong> Quarterly updates are due by 7 August, 7 November, 7 February and 7 May (standard periods), and the tax return by 31 January.</li>
        <li><strong>If you have an accountant,</strong> agree who sends the quarterly updates.</li>
      </ol>
    </section>

    <section class="mb-10">
      <h2 class="mb-5 text-2xl font-bold text-slate-900">Frequently asked questions</h2>
      <div class="space-y-3">
        {faqs.map((f) => (
          <details class="rounded-lg border border-slate-200 bg-white p-4">
            <summary class="cursor-pointer font-semibold text-slate-900">{f.q}</summary>
            <p class="mt-3 text-slate-700 leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mb-10 rounded-lg bg-slate-50 p-5 text-xs text-slate-500 leading-relaxed">
      <strong class="text-slate-700">Sources &amp; verification:</strong> Checked on GOV.UK on 1 October 2026: <a href="https://www.gov.uk/guidance/check-if-youre-eligible-for-making-tax-digital-for-income-tax" rel="nofollow noopener" target="_blank">eligibility guidance</a> (£50,000 from 6 April 2026 · £30,000 from 6 April 2027 · £20,000 from 6 April 2028), the definition of qualifying income, and the Use Making Tax Digital for Income Tax guide (digital records, quarterly update deadlines, the tax return by 31 January, bridging software, and no penalty points for late quarterly updates in the 2026 to 2027 tax year) · software positions from the WrenchStack UK directory, checked against vendor pages on 30 September 2026. General information, not tax advice; confirm your position with HMRC or your accountant. Spotted an error? <a href="/contact/" class="underline">Tell us</a>.
    </section>

    <section class="rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">Compare the UK options side by side</h2>
      <p class="mt-2 text-slate-300 leading-relaxed">Independent reviews of {vendors.length} UK entries: software, payroll, insurance, lead generation and certification schemes, with no pay-to-play.</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/uk/" class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600">🇬🇧 UK directory →</a>
        <a href="/uk/compare/" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">Compare vendors</a>
        <a href="/for-vendors/" class="rounded-md border border-white/30 bg-white/10 px-5 py-3 text-sm font-semibold text-white hover:bg-white/20">Are you a vendor? Work with us</a>
      </div>
    </section>
  </article>
</Layout>
