---
import Layout from '../../../layouts/Layout.astro';
import { awards, tools, getTool } from '../../../lib/data';
import ToolLogo from '../../../components/ToolLogo.astro';

const fmtDate = (d: string) => new Date(d + 'T00:00:00Z').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const publishedLabel = fmtDate(awards.published_date);
const archivedLabel = fmtDate(awards.archived_date ?? awards.published_date);

const pageTitle = `WrenchStack Awards ${awards.year} (archived)`;
const pageDescription = `Archived list of the WrenchStack Awards ${awards.year}, chosen on ${publishedLabel} under an earlier scoring method and no longer shown on reviews.`;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Awards', url: '/awards/' },
  { name: `${awards.year} Awards`, url: `/awards/${awards.year}/` },
];

// Build a category → tool map for rendering
const categoriesWithTools = awards.categories.map((cat) => {
  const winner = getTool(cat.winner_slug);
  const honorableMentions = cat.honorable_mentions
    .map((slug) => getTool(slug))
    .filter((t): t is NonNullable<typeof t> => !!t);
  return { ...cat, winner, honorableMentions };
});

// Archived 2026-11-14 (trust batch): no structured data, no live score and no
// outbound "Visit" link; the category texts stay as the record.
---

<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>
  <article class="mx-auto max-w-5xl px-4 py-12">
    <header class="mb-10">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-orange-600">
        Archive · {awards.year}
      </p>
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 md:text-5xl">
        WrenchStack Awards {awards.year} (archived)
      </h1>
      <h2 class="mt-6 text-xl font-bold text-slate-900">Archived on {archivedLabel}</h2>
      <p class="mt-2 rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-slate-700 leading-relaxed">
        The WrenchStack Awards {awards.year} were chosen on {publishedLabel} by editorial judgement informed by the
        Fit Score as it stood then. That score had five factors, two of which, third-party review ratings and
        feature depth, have since been removed, and the winners were not re-selected. The text under each category
        is archived as last edited on 8 October 2026 and its prices are not updated; current prices and features are on each review. The awards are
        archived: they are no longer shown on reviews, and the {awards.year} Pick badge is no longer offered. This
        page remains at its address so existing links work. The current method is on the
        <a href="/methodology/" class="underline hover:text-slate-900">methodology page</a>.
      </p>
      <p class="mt-2 text-sm text-slate-500">
        Published {publishedLabel}
      </p>
    </header>

    <section class="mb-10 rounded-lg border border-amber-200 bg-amber-50 p-6">
      <h2 class="mb-3 text-lg font-bold text-amber-900">How the winners were chosen</h2>
      <p class="text-sm text-amber-900 leading-relaxed">
        {/* Written here so the dates and weights sit next to the winners; awards.json's
            methodology_summary says the same thing (both corrected 2026-10-01). */}
        The winners were selected on {awards.published_date} by editorial judgement of fit for each category's buyer profile, informed by the WrenchStack Fit Score. The Fit Score now weights vertical fit (60%), pricing transparency (20%) and integration coverage (20%). When the winners were selected, the score had five factors with different weights, including third-party review ratings and feature depth (see the methodology changelog). Feature depth was removed on 2026-09-01 and the ratings factor on 2026-09-30 (we could not verify the ratings), and the winners below have not been re-selected since. No vendor paid for placement. Each tool's review page carries a general affiliate disclosure, and the affiliate ledger on the methodology page records our affiliate status with every tool. Recommendations are unchanged whether the affiliate is active or not. Prices in the award texts come from each winner's tool entry, and the date that entry's pricing was last verified is shown with each winner.
      </p>
      <p class="mt-3 text-sm text-amber-800">
        Read the full <a href="/methodology/" class="underline hover:text-amber-700">scoring methodology</a> for rubric weights, data sources, the per-vendor affiliate-disclosure ledger and the report ledger of pricing benchmark report sales.
      </p>
      <p class="mt-3 text-sm text-amber-800">
        <strong>Ownership disclosure:</strong> FieldRoutes (Best for Pest Control) and Aspire (Best for Landscaping) are owned by ServiceTitan (Best Enterprise FSM). We may earn a referral reward through our ServiceTitan referral link, as the ledger shows. We have no affiliate link to FieldRoutes or Aspire, and affiliate status plays no part in the awards.
      </p>
    </section>

    <nav class="mb-10 rounded-lg bg-slate-50 p-4">
      <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-slate-600">Jump to category</p>
      <div class="flex flex-wrap gap-x-3 gap-y-1 text-sm">
        {categoriesWithTools.map((cat) => (
          <a href={`#${cat.slug}`} class="text-orange-600 hover:underline">{cat.label.replace(/ \d{4}$/, '')}</a>
        ))}
      </div>
    </nav>

    <div class="space-y-12">
      {categoriesWithTools.map((cat) => (
        <section id={cat.slug} class="scroll-mt-8">
          <div class="mb-4 flex items-baseline justify-between gap-4">
            <h2 class="text-2xl font-bold text-slate-900">{cat.label}</h2>
            <a href={`#${cat.slug}`} class="text-xs text-slate-400 hover:text-slate-600">#</a>
          </div>

          <p class="mb-5 text-sm italic text-slate-600">{cat.buyer_signal}</p>

          {cat.winner && (
            <div class="rounded-lg border-2 border-amber-300 bg-gradient-to-br from-amber-50 to-white p-6">
              <div class="mb-3 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5 text-amber-600">
                  <path d="M12 2l2.39 4.84L20 7.5l-3.91 3.81.93 5.39L12 14.27l-5.02 2.43.93-5.39L4 7.5l5.61-.66L12 2z" />
                </svg>
                <span class="text-xs font-bold uppercase tracking-wider text-amber-700">Winner</span>
              </div>

              <div class="mb-4 flex items-start gap-4">
                <ToolLogo tool={cat.winner} size={56} />
                <div class="flex-1 min-w-0">
                  <h3 class="text-xl font-bold text-slate-900">
                    <a href={`/tools/${cat.winner.slug}/`} class="hover:text-orange-600">{cat.winner.name}</a>
                  </h3>
                  <p class="text-sm italic text-slate-600">{cat.winner.tagline}</p>
                </div>
              </div>

              <p class="mb-4 text-slate-700 leading-relaxed">{cat.why}</p>

              {/* Free trial prints only where the tool entry records one; a missing or
                  zero value prints nothing rather than a guessed "No" (2026-10-01). */}
              <dl class="mb-5 grid grid-cols-2 gap-3 text-sm md:grid-cols-4">
                <div>
                  <dt class="text-xs uppercase tracking-wider text-slate-500">Best team size</dt>
                  <dd class="font-semibold text-slate-900">{cat.winner.best_team_size ?? 'n/a'}</dd>
                </div>
                {cat.winner.pricing.free_trial_days && cat.winner.pricing.free_trial_days > 0 ? (
                  <div>
                    <dt class="text-xs uppercase tracking-wider text-slate-500">Free trial</dt>
                    <dd class="font-semibold text-slate-900">{cat.winner.pricing.free_trial_days} days</dd>
                  </div>
                ) : null}
              </dl>

              <div class="flex flex-wrap gap-2">
                <a
                  href={`/tools/${cat.winner.slug}/`}
                  class="rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800"
                >
                  Read the current {cat.winner.name} review →
                </a>
              </div>
            </div>
          )}

          {cat.honorableMentions.length > 0 && (
            <div class="mt-5">
              <p class="mb-3 text-xs font-bold uppercase tracking-wider text-slate-600">
                Honorable mentions
              </p>
              <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                {cat.honorableMentions.map((hm) => (
                  <a
                    href={`/tools/${hm.slug}/`}
                    class="flex items-center gap-3 rounded-lg border border-slate-200 bg-white p-3 no-underline hover:border-orange-300 hover:bg-orange-50"
                  >
                    <ToolLogo tool={hm} size={36} />
                    <div class="min-w-0 flex-1">
                      <p class="truncate text-sm font-semibold text-slate-900">{hm.name}</p>
                      <p class="truncate text-xs text-slate-500">{hm.tagline}</p>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}
        </section>
      ))}
    </div>

    <section class="mt-16 rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">Not finding your category?</h2>
      <p class="mt-2 text-slate-300 leading-relaxed">
        Take the matching quiz for a recommendation based on your trade, team size and budget, or browse all {tools.length} tools in our directory.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/quiz/" class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600">
          Take the matching quiz →
        </a>
        <a href="/tools/" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">
          Browse all tools
        </a>
        <a href="/compare-builder/" class="rounded-md border border-white/30 bg-white/10 px-5 py-3 text-sm font-semibold text-white hover:bg-white/20">
          Build a comparison
        </a>
      </div>
    </section>

    <section class="mt-10 rounded-lg border border-slate-200 bg-slate-50 p-6">
      <h2 class="mb-3 text-base font-bold text-slate-900">Editorial independence disclosure</h2>
      <ul class="space-y-2 text-sm text-slate-700 leading-relaxed">
        <li>
          <strong class="text-slate-900">No paid placements.</strong> No vendor paid for an award position, and we do not sell "shortlist" badges or featured listings.
        </li>
        <li>
          <strong class="text-slate-900">Affiliate relationships disclosed.</strong> Each tool's review page carries a general affiliate disclosure, and our public per-vendor <a href="/methodology/#affiliate-ledger" class="underline hover:text-slate-900">affiliate ledger</a> records our status with every tool.
        </li>
        <li>
          <strong class="text-slate-900">Methodology is published.</strong> The rubric, weights, data sources, and verification cadence live on the <a href="/methodology/" class="underline hover:text-slate-900">methodology page</a>.
        </li>
      </ul>
    </section>
  </article>
</Layout>
