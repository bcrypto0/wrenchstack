---
import Layout from '../../layouts/Layout.astro';
import { tools, verticals, medianUsd, perUserMedian, flatFeeMedian, perUserTools, flatFeeTools, accountingSoftware, paymentProcessors, bankingProviders, financingProviders, insuranceProviders, leadGenPlatforms, payrollServices, marketingAgencies, aiTools, reputationFlagGroups, totalReputationFlags, quoteOnlyCount } from '../../lib/data';

// --- THE FULL US CONTRACTOR STACK (computed live, never hardcoded) ---
const stackCats = [
  { name: 'accounting', items: accountingSoftware },
  { name: 'payments', items: paymentProcessors },
  { name: 'business banking', items: bankingProviders },
  { name: 'financing', items: financingProviders },
  { name: 'insurance', items: insuranceProviders },
  { name: 'lead generation', items: leadGenPlatforms },
  { name: 'payroll', items: payrollServices },
  { name: 'marketing agencies', items: marketingAgencies },
  { name: 'AI tools', items: aiTools },
];
const adjacentVendorCount = stackCats.reduce((s, c) => s + c.items.length, 0);
const totalStackVendors = tools.length + adjacentVendorCount;
const totalCategories = stackCats.length + 1; // + FSM software
const verticalCount = verticals.length;

// Flag counts come from the same helper as /reputation-flags/, so the two pages
// cannot disagree. Largest count first; ties keep the ledger's order.
const totalFlagged = totalReputationFlags();
const lowerFirst = (s: string) => (s.startsWith('AI') ? s : s.charAt(0).toLowerCase() + s.slice(1));
const flagBreakdown = [...reputationFlagGroups()]
  .sort((a, b) => b.entries.length - a.entries.length)
  .map((g) => `${lowerFirst(g.category)} ${g.entries.length} of ${g.total}`)
  .join(', ');

// Pricing opacity + QuickBooks prevalence
// Quote-only is pricing_model 'quote_only' (shared helper). A null starting
// price is not enough: Trash Flow and Pylon publish one-time or per-project
// prices and are not quote-only (2026-10-01).
const customQuotedPct = Math.round((quoteOnlyCount() / tools.length) * 100);
const pricedTools = tools.filter((t) => t.pricing.starting_at_usd !== null && t.pricing.starting_at_usd > 0);
const prices = pricedTools.map((t) => t.pricing.starting_at_usd!).sort((a, b) => a - b);
const medianPrice = medianUsd(prices);
// Model split of the same priced set the median uses, so the parts add up to it.
const perSeatPriced = perUserTools(pricedTools).length;
const flatPriced = flatFeeTools(pricedTools).length;
const annualPriced = pricedTools.filter((t) => t.pricing.pricing_model === 'annual_per_user').length;
// flatFeeTools() also takes in 'flat_plus_seat': a company fee plus a published
// monthly fee for each user or technician beyond those included (all 18 notes
// say so on 2026-10-01). Not "charge more as users are added": several 'flat'
// plans also cost more for more users, through user caps (Kickserv, QuoteIQ,
// CorkCRM and others) or an annual per-user fee (Solargraf).
const flatPlusSeatPriced = pricedTools.filter((t) => t.pricing.pricing_model === 'flat_plus_seat').length;
// Insurance providers whose premium field says the premium is quoted (27 of 27
// on 2026-10-01). Passive on purpose: the quote comes from the provider, an
// agent or broker, or a partner insurer (Tivly, Simply Business, Huckleberry),
// so "providers ... quote each policy" was wrong, as "carrier" was before it.
const insuranceQuoted = insuranceProviders.filter((p) => /\bquoted\b/i.test(String((p as any).typical_premium_range ?? ''))).length;
const qbCount = tools.filter((t) => t.integrations.some((i) => /quickbooks/i.test(i))).length;
const qbPct = Math.round((qbCount / tools.length) * 100);

// Citation date: the latest verified_date among the tools and the adjacent-stack
// vendors, the same derivation /trends-2026/ uses for its "data as of" line.
const allVerified = [
  ...tools.map((t) => t.pricing.verified_date),
  ...stackCats.flatMap((c) => (c.items as any[]).map((x) => x.verified_date)),
].filter((d): d is string => typeof d === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(d)).sort();
const dataAsOfDay = new Date(`${allVerified[allVerified.length - 1]}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

// --- INTERNATIONAL FOOTPRINT ---
const intlModules = import.meta.glob('../../data/international/*.json', { eager: true });
const intlMarkets = Object.keys(intlModules).length;
const intlVendorCount = Object.values(intlModules).reduce(
  (s: number, m: any) => s + (m.default?.vendors?.length ?? m.vendors?.length ?? 0),
  0
);

const pageTitle = 'Press & Media Room | WrenchStack';
const pageDescription = 'Press kit, fact sheet, ready-to-cite story leads and editorial contacts for journalists covering trades & construction software, contractor vendors, and e-invoicing compliance, including the independent reputation-flag ledger and the English-and-Arabic coverage of six Middle East markets.';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Press', url: '/press/' },
];

const boilerplate = `WrenchStack is an independent research desk for the trades and construction industries. It reviews software and services for contractors with no paid placements (vendors cannot pay for placement or scores). It evaluates ${totalStackVendors} US vendors across ${totalCategories} categories (field-service software, payments, accounting, banking, financing, payroll, insurance, lead generation, marketing agencies and AI tools) plus ${intlVendorCount} localized vendor listings across ${intlMarkets} international markets (UK, Canada, Australia, New Zealand, Ireland, the six GCC states, South Africa, France, Morocco, Jordan, Egypt and Malaysia), with Arabic pages for Saudi Arabia, the UAE, Qatar, Kuwait, Jordan and Egypt, and French pages for France and Morocco. Field-service software is ranked by the published WrenchStack Fit Score™, and each US vendor's affiliate relationship is disclosed, on its own page or in the methodology ledger.`;

// Recent citation log: empty until we land first citations. Structure ready.
const citations: Array<{ outlet: string; title: string; date: string; url: string }> = [];
---

<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>
  <article class="mx-auto max-w-4xl px-4 py-12">

    <header class="mb-10">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-orange-600">Press & Media</p>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">
        Press Room
      </h1>
      <p class="mt-4 text-lg text-slate-600 leading-relaxed">
        Resources for journalists, industry analysts and trade-publication editors, including ready-to-cite story leads with figures computed from the directory data. WrenchStack is independent: no vendor pays for placement or scores.
      </p>
    </header>

    <!-- STORY LEADS: the reason a journalist is here -->
    <section class="mb-12">
      <h2 class="mb-2 text-2xl font-bold text-slate-900">Story leads for journalists</h2>
      <p class="mb-5 text-sm text-slate-600 leading-relaxed">
        Four story angles. Every directory figure below is computed from the directory data when the site is built. Want a custom cut (by trade, by region)? <a href="mailto:press@wrenchstack.com" class="text-orange-600 hover:underline">Ask the press desk</a>.
      </p>

      <div class="space-y-4">
        <!-- Hook 3: Gulf e-invoicing (Wave 24 deadline has passed; kept first for the EN+AR angle) -->
        <article class="rounded-lg border-2 border-amber-300 bg-amber-50 p-5">
          <div class="mb-2 flex flex-wrap items-center gap-2">
            <span class="rounded-full bg-amber-200 px-2 py-0.5 text-xs font-bold uppercase tracking-wider text-amber-900">🧾 Deadline passed</span>
            <h3 class="text-lg font-bold text-slate-900">The Gulf e-invoicing deadline, covered in English and Arabic</h3>
          </div>
          <p class="text-sm text-slate-700 leading-relaxed">
            EY reports that Saudi Arabia's <strong>ZATCA Phase 2 Wave 24</strong> covered taxable turnover above SAR 375,000 in 2022, 2023 or 2024, with integration between 1 April and <strong>30 June 2026</strong>, a date that has passed, and that Wave 25, announced in July 2026, covers taxable turnover above SAR 187,500 in any year from 2022 to 2025, with Phase 2 compliance starting from <strong>1 February 2027</strong>. WrenchStack compares construction software in <strong>English and Arabic</strong>, with Arabic pages for Saudi Arabia, the UAE, Qatar, Kuwait, Jordan and Egypt, and covers the e-invoicing mandates in Egypt (ETA), Jordan (JoFotara), Malaysia (MyInvois) and Oman (Fawtara).
          </p>
          <p class="mt-2 text-xs text-slate-600">Read more: <a href="/sa/guides/zatca-e-invoicing-contractors/" class="font-semibold text-orange-600 hover:underline">ZATCA guide</a> · <a href="/software-by-country/" class="font-semibold text-orange-600 hover:underline">all {intlMarkets} markets</a></p>
        </article>

        <!-- Hook 1: the honesty ledger -->
        <article class="rounded-lg border border-slate-200 bg-white p-5">
          <h3 class="mb-2 text-lg font-bold text-slate-900">The reputation-flag ledger</h3>
          <p class="text-sm text-slate-700 leading-relaxed">
            We flag <strong>{totalFlagged} vendors</strong> across the US contractor stack with a documented reputation warning, and publish the specific reason on each. By category, largest count first: {flagBreakdown}.
          </p>
          <p class="mt-2 text-xs text-slate-600">→ <a href="/reputation-flags/" class="font-semibold text-orange-600 hover:underline">Reputation-flag ledger</a> · <a href="/lead-gen/" class="font-semibold text-orange-600 hover:underline">Lead-gen reviews</a></p>
        </article>

        <!-- Hook 2: pricing opacity -->
        <article class="rounded-lg border border-slate-200 bg-white p-5">
          <h3 class="mb-2 text-lg font-bold text-slate-900">Who publishes a price</h3>
          <p class="text-sm text-slate-700 leading-relaxed">
            <strong>{customQuotedPct}% of the trades-software platforms in our directory publish no price at all</strong> ({quoteOnlyCount()} of {tools.length}): you have to ask the vendor for a quote. The median <em>published</em> paid entry price is <strong>${medianPrice}/month</strong>, and that figure mixes pricing models: {perSeatPriced} platforms charge per seat (median <strong>${perUserMedian()} per user/month</strong>), {flatPriced} charge a fee for the company (median <strong>${flatFeeMedian()}/month</strong>; {flatPlusSeatPriced} of them publish a monthly fee for each user or technician beyond those included) and {annualPriced} {annualPriced === 1 ? 'sells' : 'sell'} annual per-user licences. The blended figure is not a per-seat rate and should not be quoted as one. In insurance, the premium is quoted individually for {insuranceQuoted === insuranceProviders.length ? 'all' : `${insuranceQuoted} of the`} {insuranceProviders.length} providers we list.
          </p>
          <p class="mt-2 text-xs text-slate-600">→ <a href="/trends-2026/" class="font-semibold text-orange-600 hover:underline">Market report</a> · <a href="/pricing/" class="font-semibold text-orange-600 hover:underline">Pricing comparison</a></p>
        </article>

        <!-- Hook 4: QuickBooks lock-in -->
        <article class="rounded-lg border border-slate-200 bg-white p-5">
          <h3 class="mb-2 text-lg font-bold text-slate-900">QuickBooks integration</h3>
          <p class="text-sm text-slate-700 leading-relaxed">
            <strong>{qbPct}% of the trades software platforms we track integrate with QuickBooks</strong> ({qbCount} of {tools.length} platforms in the directory).
          </p>
          <p class="mt-2 text-xs text-slate-600">→ <a href="/trends-2026/" class="font-semibold text-orange-600 hover:underline">Market report</a> · <a href="/accounting/" class="font-semibold text-orange-600 hover:underline">Accounting reviews</a></p>
        </article>
      </div>

      <p class="mt-4 rounded-lg bg-slate-50 px-4 py-3 text-xs text-slate-500 leading-relaxed">
        <strong class="text-slate-700">Standard citation line:</strong> "WrenchStack Trades Software Market Report 2026, WrenchStack Research, data as of {dataAsOfDay}". Free to cite with a link to <a href="/trends-2026/" class="underline">wrenchstack.com/trends-2026</a>. The figures are computed from the directory data as of that date.
      </p>
    </section>

    <section class="mb-12 rounded-lg border-2 border-slate-200 bg-slate-50 p-6">
      <h2 class="mb-4 text-lg font-bold text-slate-900">Press contact</h2>
      <p class="text-sm text-slate-700 leading-relaxed">
        For written commentary, data licensing, embargo arrangements and media inquiries:
      </p>
      <div class="mt-3">
        <p class="text-base font-semibold text-slate-900">Bilal Elhomsi</p>
        <p class="text-sm text-slate-600">Founder, WrenchStack</p>
        <p class="mt-1 text-base">
          <a href="mailto:press@wrenchstack.com" class="font-semibold text-orange-600 hover:underline">press@wrenchstack.com</a>
        </p>
      </div>
    </section>

    <section class="mb-12">
      <h2 class="mb-4 text-2xl font-bold text-slate-900">About WrenchStack: boilerplate</h2>
      <div class="rounded-lg border border-slate-200 bg-white p-5">
        <p class="text-slate-700 leading-relaxed">{boilerplate}</p>
        <div class="mt-4 flex flex-wrap gap-2">
          <button onclick="navigator.clipboard.writeText(document.querySelector('.boilerplate-text').textContent.trim()); this.textContent = 'Copied!'; setTimeout(() => this.textContent = 'Copy boilerplate', 2000)" class="rounded-md bg-orange-500 px-3 py-1.5 text-xs font-semibold text-white hover:bg-orange-600">Copy boilerplate</button>
        </div>
        <span class="boilerplate-text hidden">{boilerplate}</span>
      </div>
    </section>

    <section class="mb-12">
      <h2 class="mb-4 text-2xl font-bold text-slate-900">Fact sheet</h2>
      <div class="grid gap-3 sm:grid-cols-2">
        <div class="rounded-lg border border-slate-200 bg-white p-4">
          <p class="text-xs uppercase tracking-wider text-slate-500">Founded</p>
          <p class="mt-1 font-semibold text-slate-900">2026</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-4">
          <p class="text-xs uppercase tracking-wider text-slate-500">US coverage</p>
          <p class="mt-1 font-semibold text-slate-900">{totalStackVendors} vendors · {totalCategories} categories · {verticalCount} trade verticals</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-4">
          <p class="text-xs uppercase tracking-wider text-slate-500">International coverage</p>
          <p class="mt-1 font-semibold text-slate-900">{intlVendorCount} listings · {intlMarkets} markets (Arabic pages for 6, French for 2)</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-4">
          <p class="text-xs uppercase tracking-wider text-slate-500">Reputation flags issued</p>
          <p class="mt-1 font-semibold text-slate-900">{totalFlagged} vendors with documented concerns</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-4">
          <p class="text-xs uppercase tracking-wider text-slate-500">Methodology</p>
          <p class="mt-1 font-semibold text-slate-900">WrenchStack Fit Score™ v1.3 (effective 2026-09-30)</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-4">
          <p class="text-xs uppercase tracking-wider text-slate-500">Independence</p>
          <p class="mt-1 text-sm text-slate-700">No paid placement · affiliate status disclosed for each US vendor</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-4">
          <p class="text-xs uppercase tracking-wider text-slate-500">Verification</p>
          <p class="mt-1 text-sm text-slate-700">Each US entry shows the date it was last verified · see the <a href="/verification-log/" class="text-orange-600 hover:underline">verification log</a></p>
        </div>
      </div>
    </section>

    <section class="mb-12">
      <h2 class="mb-4 text-2xl font-bold text-slate-900">Citation guidance</h2>
      <div class="rounded-lg border border-slate-200 bg-white p-5">
        <p class="mb-3 text-sm text-slate-700 leading-relaxed">
          When citing WrenchStack research, please use this format:
        </p>
        <div class="rounded-md bg-slate-50 px-4 py-3 font-mono text-sm text-slate-800">
          WrenchStack Trades Software Market Report 2026. WrenchStack Research, data as of {dataAsOfDay}. https://wrenchstack.com/trends-2026/
        </div>
        <p class="mt-4 text-sm text-slate-700 leading-relaxed">
          For methodology citations, please reference: <em>WrenchStack Fit Score™ Methodology v1.3, effective September 30, 2026. WrenchStack Research. <a href="/methodology/" class="text-orange-600 hover:underline">https://wrenchstack.com/methodology/</a></em>
        </p>
        <p class="mt-3 text-xs text-slate-500">
          For written quotes or a custom data cut, please email <a href="mailto:press@wrenchstack.com" class="underline">press@wrenchstack.com</a> in advance of publication so we can verify accuracy and provide context.
        </p>
      </div>
    </section>

    <section class="mb-12">
      <h2 class="mb-4 text-2xl font-bold text-slate-900">Brand assets</h2>
      <div class="rounded-lg border border-slate-200 bg-white p-5">
        <h3 class="mb-3 text-base font-bold text-slate-900">Logo</h3>
        <div class="flex flex-wrap items-center gap-6 rounded-md bg-slate-50 px-6 py-4">
          <img src="/logo.png" alt="WrenchStack logo" class="h-11 w-auto" />
        </div>
        <p class="mt-3 text-sm text-slate-700">
          The logo files are PNG: <a href="/logo.png" class="text-orange-600 hover:underline">logo.png</a> (721 × 171) and <a href="/logo-square.png" class="text-orange-600 hover:underline">logo-square.png</a> (1024 × 1024). Use the files as supplied. For another size or format, email <a href="mailto:press@wrenchstack.com" class="text-orange-600 hover:underline">press@wrenchstack.com</a>.
        </p>

        <h3 class="mt-6 mb-3 text-base font-bold text-slate-900">Typography</h3>
        <p class="text-sm text-slate-700">The device's system sans-serif font (Tailwind's default stack: ui-sans-serif, system-ui, sans-serif)</p>
      </div>
    </section>

    <section class="mb-12">
      <h2 class="mb-4 text-2xl font-bold text-slate-900">Research products</h2>
      <p class="mb-4 text-sm text-slate-600 leading-relaxed">
        Recent research publications available for journalist reference and citation:
      </p>
      <div class="space-y-3">
        <a href="/trends-2026/" class="block rounded-lg border border-slate-200 bg-white p-4 no-underline hover:border-orange-300 hover:bg-orange-50">
          <p class="font-semibold text-slate-900">Trades Software Market Report 2026</p>
          <p class="mt-1 text-sm text-slate-600">Data findings across the full {totalStackVendors}-vendor contractor stack ({totalCategories} categories) and {intlMarkets} international markets: pricing transparency, integration prevalence, the reputation-flag ledger, and the international markets, six of them with Arabic pages.</p>
        </a>
        <a href="/research/" class="block rounded-lg border border-slate-200 bg-white p-4 no-underline hover:border-orange-300 hover:bg-orange-50">
          <p class="font-semibold text-slate-900">Research hub & the WrenchStack Index</p>
          <p class="mt-1 text-sm text-slate-600">Citable statistics computed from the directory data, including reputation-flag counts by category ({totalFlagged} flagged vendors) and coverage across {intlMarkets} international markets.</p>
        </a>
        <a href="/awards/2026/" class="block rounded-lg border border-slate-200 bg-white p-4 no-underline hover:border-orange-300 hover:bg-orange-50">
          <p class="font-semibold text-slate-900">WrenchStack Awards 2026</p>
          <p class="mt-1 text-sm text-slate-600">Editorial award categories for trades software, with the methodology and the reason for each winner.</p>
        </a>
        <a href="/methodology/" class="block rounded-lg border border-slate-200 bg-white p-4 no-underline hover:border-orange-300 hover:bg-orange-50">
          <p class="font-semibold text-slate-900">WrenchStack Fit Score™ Methodology v1.3</p>
          <p class="mt-1 text-sm text-slate-600">Published methodology documenting the scoring rubric, evaluation timeline, weights and independence statement.</p>
        </a>
      </div>
    </section>

    <section class="mb-12">
      <h2 class="mb-4 text-2xl font-bold text-slate-900">In the news</h2>
      {citations.length > 0 ? (
        <div class="space-y-3">
          {citations.map(c => (
            <a href={c.url} target="_blank" rel="noopener" class="block rounded-lg border border-slate-200 bg-white p-4 no-underline hover:border-orange-300 hover:bg-orange-50">
              <p class="font-semibold text-slate-900">{c.title}</p>
              <p class="mt-1 text-sm text-slate-600">{c.outlet} · {c.date}</p>
            </a>
          ))}
        </div>
      ) : (
        <div class="rounded-lg border border-dashed border-slate-300 bg-slate-50 p-6 text-center">
          <p class="text-sm text-slate-600">
            No media citations yet.
          </p>
          <p class="mt-2 text-xs text-slate-500">
            Cited WrenchStack in your publication? Email <a href="mailto:press@wrenchstack.com" class="underline">press@wrenchstack.com</a> with the link.
          </p>
        </div>
      )}
    </section>

    <section class="mb-12">
      <h2 class="mb-4 text-2xl font-bold text-slate-900">Written commentary available on</h2>
      <p class="mb-4 text-sm text-slate-600 leading-relaxed">
        Journalists can request written commentary or a custom data cut on:
      </p>
      <ul class="grid gap-2 sm:grid-cols-2 text-sm text-slate-700">
        <li class="rounded-md bg-slate-50 px-3 py-2">E-invoicing mandates in Saudi Arabia, Oman, Egypt, Jordan and Malaysia (ZATCA, Fawtara, ETA, JoFotara, MyInvois)</li>
        <li class="rounded-md bg-slate-50 px-3 py-2">The reputation-flag ledger: documented warnings by category</li>
        <li class="rounded-md bg-slate-50 px-3 py-2">Trades-software pricing transparency and benchmarks</li>
        <li class="rounded-md bg-slate-50 px-3 py-2">Lead-generation platform warnings, including the FTC's HomeAdvisor order</li>
        <li class="rounded-md bg-slate-50 px-3 py-2">Contractor insurance &amp; financing market structure</li>
        <li class="rounded-md bg-slate-50 px-3 py-2">Contractor banking: account terms and CFPB orders</li>
        <li class="rounded-md bg-slate-50 px-3 py-2">International trades-market differences ({intlMarkets} markets)</li>
        <li class="rounded-md bg-slate-50 px-3 py-2">Affiliate commissions, and why no vendor can pay for placement</li>
      </ul>
    </section>

    <section class="rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">Request data or written comment</h2>
      <p class="mt-2 text-slate-300 leading-relaxed">
        For a custom cut of the directory data (by trade or by region) or written answers to your questions, email the press desk.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="mailto:press@wrenchstack.com" class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600">Email press desk →</a>
        <a href="/methodology/" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">Read methodology</a>
        <a href="/trends-2026/" class="rounded-md border border-white/30 bg-white/10 px-5 py-3 text-sm font-semibold text-white hover:bg-white/20">Latest research</a>
      </div>
    </section>
  </article>
</Layout>
