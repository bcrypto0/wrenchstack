---
import Layout from '../layouts/Layout.astro';
import { tools, verticals, verticalToUrl, leadGenPlatforms, insuranceProviders, payrollServices, marketingAgencies, aiTools, paymentProcessors, financingProviders, accountingSoftware, bankingProviders } from '../lib/data';
import { reportRows, reportAsOf } from '../lib/reportLedger';

// Report announcements (offers/pricing-benchmark/decisions/DECISIONS.md, owner decision of
// 2026-10-07). Fill `sent` with the number of vendors emailed on that date, the day it goes out.
const reportAnnouncements: { label: string; sent: number | null }[] = [
  { label: 'October 13, 2026', sent: null },
  { label: 'October 27, 2026', sent: null },
];

// WrenchStack Fit Score™ methodology version metadata
const METHODOLOGY_VERSION = '1.3';
const METHODOLOGY_EFFECTIVE_DATE = '2026-09-30';

// Quantification: coverage stats across all categories
const totalVendorsCovered = tools.length + leadGenPlatforms.length + insuranceProviders.length + payrollServices.length + marketingAgencies.length + aiTools.length + paymentProcessors.length + financingProviders.length + accountingSoftware.length + bankingProviders.length;
const totalCategories = 10;
const totalTrades = verticals.length;
const totalCriteriaTracked = tools.length;
const totalCountries = 18; // US + 17 international markets, all live

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Methodology', url: '/methodology/' },
];

// Build affiliate-status table from the live tools.json. Active comes only
// from affiliate_url being a real tracked http URL; nothing else can make a
// tool Active. A tracked URL with affiliate_status 'unconfirmed' shows as
// Unconfirmed (link in use, program status not read in its dashboard). Every
// other state comes from the explicit affiliate_status field (mirrors
// docs/affiliate-status-ledger.md). affiliate_url "TBD" means only "no tracked
// link" and says nothing about an application, so a tool with no
// affiliate_status is shown as having no relationship.
type AffiliateStatus = 'Active' | 'Unconfirmed' | 'Approved' | 'Pending' | 'None';

interface ToolStatus {
  slug: string;
  name: string;
  status: AffiliateStatus;
  note: string;
}

const STATUS_FROM_DATA = {
  approved_unused: {
    status: 'Approved',
    note: 'Our affiliate account was approved, but we do not use its tracked link anywhere on the site. We earn nothing from this tool.',
  },
  applied: {
    status: 'Pending',
    note: 'Application submitted; no decision received. We earn nothing from this tool today.',
  },
  declined: {
    status: 'None',
    note: 'We applied and were not accepted. No affiliate relationship.',
  },
  no_program: {
    status: 'None',
    note: 'We found no affiliate program open to publishers (checked May to June 2026). No affiliate relationship.',
  },
} as const;

function classifyAffiliate(t: typeof tools[number]): ToolStatus {
  if (t.affiliate_url.startsWith('http') && t.affiliate_status === 'unconfirmed') {
    return {
      slug: t.slug,
      name: t.name,
      status: 'Unconfirmed',
      note: t.affiliate_note ?? 'Our "Visit" buttons for this tool use a tracked link from the vendor\'s partner program, but we have not confirmed the program\'s status in the vendor\'s partner dashboard, so we do not know whether we earn anything from it.',
    };
  }
  if (t.affiliate_status === 'unconfirmed') {
    // 'unconfirmed' only describes a tracked link in use.
    throw new Error(`tools.json: affiliate_status "unconfirmed" on ${t.slug} needs a tracked affiliate_url`);
  }
  if (t.affiliate_url.startsWith('http')) {
    return {
      slug: t.slug,
      name: t.name,
      status: 'Active',
      note: t.affiliate_note ?? 'WrenchStack may earn a commission on signups from this link.',
    };
  }
  if (t.affiliate_status === undefined) {
    return {
      slug: t.slug,
      name: t.name,
      status: 'None',
      note: t.affiliate_note ?? 'No affiliate relationship.',
    };
  }
  const known = STATUS_FROM_DATA[t.affiliate_status];
  if (!known) {
    // A typo here would otherwise publish silently as "None".
    throw new Error(`tools.json: unknown affiliate_status "${t.affiliate_status}" on ${t.slug}`);
  }
  return {
    slug: t.slug,
    name: t.name,
    status: known.status,
    note: t.affiliate_note ?? known.note,
  };
}

const STATUS_ORDER: AffiliateStatus[] = ['Active', 'Unconfirmed', 'Approved', 'Pending', 'None'];

const toolStatuses = tools
  .map(classifyAffiliate)
  .sort((a, b) => {
    // Active, Unconfirmed, Approved, Pending, then None; alphabetical within each
    const aIdx = STATUS_ORDER.indexOf(a.status);
    const bIdx = STATUS_ORDER.indexOf(b.status);
    if (aIdx !== bIdx) return aIdx - bIdx;
    return a.name.localeCompare(b.name);
  });

const counts = {
  Active: toolStatuses.filter((t) => t.status === 'Active').length,
  Unconfirmed: toolStatuses.filter((t) => t.status === 'Unconfirmed').length,
  Approved: toolStatuses.filter((t) => t.status === 'Approved').length,
  Pending: toolStatuses.filter((t) => t.status === 'Pending').length,
  None: toolStatuses.filter((t) => t.status === 'None').length,
};
---

<Layout
  title="WrenchStack Fit Score™ Methodology v1.3: How we rank trades vendors"
  description="WrenchStack's published, versioned methodology for trades vendors across 10 categories: the WrenchStack Fit Score™ (three weighted factors) for field-service software and rule-based tiers for payments, accounting, payroll, insurance, financing, banking, lead-gen, marketing and AI. Independence statement. Per-vendor affiliate ledger and report ledger."
  breadcrumbs={breadcrumbs}
>
  <article class="mx-auto max-w-3xl px-4 py-12 prose prose-slate">

    <div class="not-prose mb-8 rounded-lg border-2 border-slate-200 bg-slate-50 p-5">
      <div class="mb-2 flex flex-wrap items-baseline justify-between gap-2">
        <h1 class="text-2xl font-bold text-slate-900 m-0">WrenchStack Fit Score™ Methodology</h1>
        <div class="text-xs font-semibold uppercase tracking-wider text-slate-600">
          Version {METHODOLOGY_VERSION} · Effective {METHODOLOGY_EFFECTIVE_DATE}
        </div>
      </div>
      <p class="text-sm text-slate-700 leading-relaxed m-0">
        WrenchStack is an independent research desk covering trades-contractor vendors across {totalCategories} categories. This page documents the WrenchStack Fit Score™, our published methodology for evaluating and ranking vendors. The methodology is versioned, dated, and applied consistently across every vendor in the directory.
      </p>
    </div>

    <div class="not-prose mb-10 grid grid-cols-2 gap-3 sm:grid-cols-4 text-center">
      <div class="rounded-lg border border-slate-200 bg-white px-3 py-3">
        <div class="text-2xl font-bold text-slate-900">{totalVendorsCovered}</div>
        <div class="text-xs uppercase tracking-wider text-slate-500">Vendors evaluated</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white px-3 py-3">
        <div class="text-2xl font-bold text-slate-900">{totalCategories}</div>
        <div class="text-xs uppercase tracking-wider text-slate-500">Categories covered</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white px-3 py-3">
        <div class="text-2xl font-bold text-slate-900">{totalTrades}</div>
        <div class="text-xs uppercase tracking-wider text-slate-500">Trade verticals</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white px-3 py-3">
        <div class="text-2xl font-bold text-slate-900">{totalCriteriaTracked}</div>
        <div class="text-xs uppercase tracking-wider text-slate-500">Software tools scored</div>
      </div>
    </div>

    <div class="not-prose mb-8 rounded-lg border border-slate-200 bg-slate-50 p-5 text-sm text-slate-700">
      <h2 class="text-base font-bold text-slate-900 mb-2 mt-0">Changelog: non-software categories (2026-09-30)</h2>
      <ul class="list-disc pl-5 space-y-1 m-0">
        <li><strong>Entries re-verified.</strong> Accounting, payroll, insurance, lead generation, financing, banking, payments, marketing agencies and AI tools were checked against primary sources (vendor pages, filings, regulator and court documents), and prices were re-checked on the vendor's own pricing page wherever it could be read. The pricing pages of Patriot Accounting, Thumbtack, OnPay and Auris (formerly Heartland Payroll) could not be read, so those entries keep their earlier verified date.</li>
        <li><strong>No third-party review scores for these vendors.</strong> G2, Capterra, Trustpilot, Google, BBB and A.M. Best scores and forum sentiment are no longer shown in these categories: we could not verify them, and several were out of date. Lead-generation, insurance, payroll and marketing-agency review pages link to the vendor's BBB and Trustpilot pages instead. Software tool pages stopped showing G2 and Capterra ratings the same day (see v1.3).</li>
        <li><strong>Tiers use verified facts only.</strong> Lead generation: Recommended means no reputation warning and each lead or call goes to one business. Payroll: Tier S is online or specialty payroll with a published starting price and no warning; Tier B is legacy payroll, PEOs or a warning. Marketing agencies: Tier S is no warning plus published prices for the core service. Insurance: no Tier S; providers are listed with or without a warning, because nothing we could verify ranks insurers on quality.</li>
        <li><strong>Warnings need a readable source.</strong> A reputation warning must trace to a regulator order, court record, BBB profile or the vendor's own terms. Warnings that rested only on forum posts or on complaint text we could not read were removed.</li>
      </ul>
    </div>

    <div class="not-prose mb-8 rounded-lg border border-slate-200 bg-slate-50 p-5 text-sm text-slate-700">
      <h2 class="text-base font-bold text-slate-900 mb-2 mt-0">Changelog: v1.3 (2026-09-30)</h2>
      <ul class="list-disc pl-5 space-y-1 m-0">
        <li><strong>Removed the user-ratings factor.</strong> The Fit Score gave 30% of its weight to averaged G2 and Capterra ratings. We could not verify those ratings, and the two we checked were wrong. We would rather drop a factor than score tools on numbers we cannot check.</li>
        <li><strong>Weights are now 60/20/20.</strong> Vertical fit 60%, pricing transparency 20%, integration coverage 20%. Every score was recomputed with the new weights.</li>
        <li><strong>Tool pages link to G2 and Capterra instead.</strong> Software tool pages no longer show G2 or Capterra numbers, and rankings, comparisons and award text no longer cite them. Each tool page links to G2 and Capterra so readers can check current reviews at the source. Reviews submitted directly to WrenchStack are unchanged.</li>
        <li><strong>Trade fit is checked against the vendor's own pages.</strong> For every tool we read who the vendor says it serves. A trade the vendor shows it does not serve is removed; a trade it only names in a list is capped at 7; a trade it never names is capped at 5; a product built for one trade scores 10; and trades a vendor covers with a dedicated page were added at 7 (6 if only listed). Where a vendor's site could not be read, the previous values stand until it can be checked. UpKeep, MaintainX and Limble are maintenance software (CMMS) for teams that look after their own equipment and buildings; their own sites name no contractor trade, so they are no longer ranked on trade pages and are compared with each other instead.</li>
        <li><strong>The 2026 awards predate this change.</strong> They were selected while the ratings factor was part of the score and have not been re-selected.</li>
      </ul>
    </div>

    <div class="not-prose mb-8 rounded-lg border border-slate-200 bg-slate-50 p-5 text-sm text-slate-700">
      <h2 class="text-base font-bold text-slate-900 mb-2 mt-0">Changelog: v1.2 (2026-09-01)</h2>
      <ul class="list-disc pl-5 space-y-1 m-0">
        <li><strong>Removed the "Feature depth" factor.</strong> It scored a count of listed features, capped at 10. Our feature vocabulary is not controlled: 234 distinct labels across 125 tools, 118 of which appear exactly once, including outright duplicates (<em>reporting</em> and <em>reports</em>; <em>routing</em>, <em>route optimization</em> and <em>route planning</em>; <em>customer portal</em> and <em>client portal</em>) and even vendor product names entered as features. A tool whose entry split quoting into four labels scored four times one that wrote it once, which is a difference in how we took notes rather than in the software. It was also inflatable by simply submitting a longer list.</li>
        <li><strong>We tried to fix it rather than remove it, and the fix failed honestly.</strong> A rewrite scoring coverage of 14 canonical capabilities mapped only 69% of our labels and scored AccuLynx 0 out of 10 despite seven real features, because a generic vocabulary does not describe roofing. Making it work requires normalising the whole taxonomy, which is a data project we have not done. We would rather remove a factor than publish one we cannot defend, which is the same reason we refuse to invent a rating for an unlisted tool.</li>
        <li><strong>Integration coverage now uses a reachable scale.</strong> It counted integrations against a cap of 10 while the highest count in the directory is 7, so no tool could score above 7 on a 10-point factor and every tool took a silent reduction. Six or more native integrations now earns full marks.</li>
        <li><strong>Weights rebalanced.</strong> Pricing transparency and integration coverage move from 10% to 15% each. Vertical fit (40%) and user ratings (30%) are unchanged. Every score was recomputed: the mean moved by 0.07 and no tool moved by more than 1.0.</li>
      </ul>
    </div>

    <div class="not-prose mb-8 rounded-lg border border-slate-200 bg-slate-50 p-5 text-sm text-slate-700">
      <h2 class="text-base font-bold text-slate-900 mb-2 mt-0">Changelog: v1.1 (2026-08-27)</h2>
      <ul class="list-disc pl-5 space-y-1 m-0">
        <li><strong>Fixed a scoring bug.</strong> On pages with no trade context (tool pages, awards), the vertical-fit factor previously fell back to a flat 7.0 instead of the tool's actual fit data. It now uses the tool's best trade fit. Context-free scores published before this date understated most tools.</li>
        <li><strong>Unrated tools are no longer scored as if they had earned 2.5 stars.</strong> When no G2/Capterra listing exists, the ratings factor is excluded and remaining weights renormalize, instead of substituting a neutral 5/10.</li>
        <li><strong>Removed affiliate considerations from category tier rules.</strong> An insurance tier path required an affiliate program, and payroll and agency tiers contained hardcoded exceptions. All tiers are now rule-based on product and reputation data only, Affected tiers were recomputed.</li>
        <li><strong>One review cadence.</strong> This page previously said monthly in one section and quarterly in another. The cycle is monthly, matching the published <a href="/verification-log/">verification log</a>.</li>
      </ul>
    </div>

    <h2>What the WrenchStack Fit Score™ measures</h2>

    <p>
      Every field-service software platform in our directory carries a WrenchStack Fit Score™ on a 0-10 scale, calculated from three weighted factors. On each trade page, platforms are ordered by their fit for that trade first and by Fit Score second. The same formula applies to every platform, regardless of affiliate relationship or commercial alignment.
    </p>

    <h2>The WrenchStack Fit Score™ formula</h2>

    <table>
      <thead>
        <tr>
          <th>Factor</th>
          <th>Weight</th>
          <th>What it measures</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>Vertical fit</strong></td>
          <td>60%</td>
          <td>How well the tool is built for the specific trade being searched (HVAC, plumbing, roofing, etc.). Scored 1-10 per vertical, checked against the trades the vendor's own pages say it serves (see the v1.3 changelog). Weight raised from 40% in v1.3.</td>
        </tr>
        <tr>
          <td><strong>Pricing transparency</strong></td>
          <td>20%</td>
          <td>Tools that publish their prices score 10. Quote-only tools, which need a sales call for any number, score 5. Weight raised from 10% to 15% in v1.2 and to 20% in v1.3.</td>
        </tr>
        <tr>
          <td><strong>Integration coverage</strong></td>
          <td>20%</td>
          <td>Count of native integrations with adjacent tools (QuickBooks, Stripe, Zapier, payment processors, marketing platforms). Six or more earns full marks. Weight raised from 10% to 15% in v1.2 and to 20% in v1.3.</td>
        </tr>
      </tbody>
    </table>

    <p>
      The final score is the weighted sum, rounded to one decimal place. Vendors scoring 9.0+ get
      a dark-green badge; 8.0-8.9 light green; 7.0-7.9 orange; 6.0-6.9 light orange; below 6 gray.
    </p>

    <h2>Our evaluation timeline</h2>

    <p>
      Each vendor evaluation follows the same steps, in this order. How long it takes depends on what the vendor publishes and how readable its site is.
    </p>

    <ol>
      <li><strong>Discovery</strong>: vendor identified through editorial research or vendor self-submission. Initial fit assessment against category definition.</li>
      <li><strong>Data collection</strong>: pricing tiers verified directly from vendor pricing page with date stamp; feature and integration lists compiled from vendor documentation and product pages.</li>
      <li><strong>Reputation check</strong>: regulator actions (FTC, CFPB, SEC, state attorneys general), court records, BBB profiles and the vendor's own terms. We do not use forum or social-media sentiment, and a warning we cannot trace to a readable source is removed.</li>
      <li><strong>Scoring</strong>: for field-service software, the WrenchStack Fit Score™ is computed using published weights; reputation_flag attached if structural concerns warrant warning to readers.</li>
      <li><strong>Editorial draft</strong>: review written with structured pros and cons, FAQs and best-fit framing.</li>
      <li><strong>Publication</strong>: review goes live with verified_date stamp. Vendor profile becomes part of the directory.</li>
      <li><strong>Refresh</strong>: pricing re-verified and reputation warnings re-checked against their sources; each US entry shows the date of its latest check.</li>
    </ol>

    <h2>Our independence statement</h2>

    <div class="not-prose mb-6 rounded-lg border-2 border-emerald-200 bg-emerald-50 p-5">
      <p class="text-sm text-emerald-900 leading-relaxed m-0">
        <strong class="text-emerald-900">WrenchStack rankings are not for sale.</strong> Vendors cannot pay to be included in the directory, pay to receive a higher WrenchStack Fit Score™, pay to win awards, pay to soften reputation flags, or pay to remove cons from a review. Affiliate relationships are disclosed in the per-vendor ledger below and have no effect on rankings. Pricing benchmark reports sold to vendors are listed in the report ledger below. Whether a vendor bought a report is not an input to any listing, Fit Score, ranking, award or reputation flag, or to whether a product is listed. The methodology applies identically whether or not we earn a commission or a referral reward on a vendor, and whether or not it bought a report.
      </p>
    </div>

    <p>
      We list vendors we have no affiliate arrangement with on the same terms as everyone else (Acuity Insurance, Erie Insurance and Google Local Services Ads, for example), and a reputation warning goes on a vendor whatever our commercial relationship with it. This is the editorial position the methodology requires.
    </p>

    <h2>What "verified" means here</h2>

    <p>
      On WrenchStack, <strong>verified means the claim was checked against a named primary source on a named date.</strong> For pricing, that source is the vendor's own pricing page; the date is recorded per vendor and shown on the page. For reputation flags, the source is a regulator, a live court record, or a named complaint registry, cited in the flag itself. Anything we could not verify that way is either labeled as unverified or not published at all. Routine re-checks are automated: software reads the vendor's own page, and a change is published only after a second, independent check of that same page confirms it. What is never treated as verification: a figure copied from a third-party listing, an estimate, or the vendor's own say-so without a published source. You can watch the dates move on the <a href="/verification-log/">verification log</a>.
    </p>

    <h2>How often we update</h2>

    <p>
      <strong>Pricing</strong> carries the date it was last checked: each tool entry carries a verified date, and
      prices older than 90 days show an amber freshness pill and prices older than 180 days a red one.
    </p>

    <p>
      <strong>Third-party review scores</strong> from G2, Capterra and similar sites are not recorded or
      used in scoring (since v1.3). Tool pages link to those sites so readers can check current reviews there.
    </p>

    <h2 id="changelog">Methodology changelog</h2>

    <p>
      The WrenchStack Fit Score™ is versioned. Any material change to the formula, the weights, or
      the evaluation process bumps the version number and is logged here with a date; we don't
      silently change how scoring works.
    </p>

    <ul class="not-prose space-y-3">
      <li class="rounded-lg border border-slate-200 bg-white p-4">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <span class="font-semibold text-slate-900">Version 1.0</span>
          <span class="text-xs font-medium uppercase tracking-wider text-slate-500">2026-05-29</span>
        </div>
        <p class="mt-1 text-sm text-slate-600 leading-relaxed">Initial public methodology: the WrenchStack Fit Score™ (five weighted factors as of that date: vertical fit 40%, user ratings 30%, pricing transparency 10%, feature depth 10%, integration coverage 10%; feature depth was removed in v1.2 and user ratings in v1.3), the documented evaluation timeline, the independence statement, and the per-vendor affiliate ledger.</p>
      </li>
    </ul>

    <h2>Editorial corrections</h2>

    <p>
      If we publish something wrong about a tool (pricing, feature claim, weakness), we correct
      it once the error is confirmed against a primary source. Corrections are noted on the page
      with a dated stamp.
    </p>

    <p>
      If you're a vendor and spot an error about your product, email <a href="mailto:hello@wrenchstack.com">hello@wrenchstack.com</a> with
      the specific page URL and what's wrong. We fix and credit corrections fairly.
    </p>

    <h2>The data behind rankings</h2>

    <p>
      Pricing tier data comes from public vendor pricing pages. Feature lists and integration data
      come from the vendor's own product pages and documentation.
    </p>

    <p>
      Where a vendor publishes no price (ServiceTitan is one example), the listing says so and the
      tool counts as quote-only. Pricing notes carry no third-party price estimates.
    </p>

    <h2 id="how-we-make-money">How we make money</h2>

    <p>
      WrenchStack earns money in two ways: commissions and referral rewards from vendor programs,
      described here, and pricing benchmark reports sold to software vendors, described below the
      affiliate ledger. When you click a "Visit [Tool]" button and sign up for that tool,
      <strong>we may earn a commission or a referral reward</strong>, but only when the link
      belongs to a program we have joined. Some of those programs are affiliate programs and some
      are referral programs. The reward is not an input to any listing, Fit Score, rank or award.
      No vendor has paid for placement, ranking or inclusion in the directory, and payment is not
      an input to the Fit Score, a spot in a "best of" list or the tone of a review.
    </p>

    <p class="rounded-lg border border-emerald-200 bg-emerald-50 p-4 text-sm not-prose">
      <strong class="text-emerald-900">Affiliate status doesn't affect ranking.</strong>
      The WrenchStack Fit Score™ (vertical fit + pricing transparency +
      integration coverage) is computed the same way for every vendor, whether we have an active affiliate
      relationship, a pending application, or no commercial relationship at all.
    </p>

    <h3 id="affiliate-ledger">Per-tool affiliate ledger ({tools.length} software tools)</h3>

    <p>
      Full transparency. Below is the affiliate status of every software tool in the directory. Vendors in every other category (lead-gen, insurance, payroll, marketing agencies, AI tools, payments, financing, accounting, and business banking) follow the same independence rules, with vendor-specific affiliate disclosure on each review page.
    </p>

    <ul class="not-prose grid grid-cols-2 gap-3 text-sm md:grid-cols-5">
      <li class="rounded-lg bg-emerald-50 px-3 py-2 ring-1 ring-emerald-200">
        <span class="font-semibold text-emerald-900">Active:</span>
        <span class="text-emerald-700">{counts.Active} {counts.Active === 1 ? 'tool' : 'tools'}</span>
      </li>
      <li class="rounded-lg bg-orange-50 px-3 py-2 ring-1 ring-orange-200">
        <span class="font-semibold text-orange-900">Unconfirmed:</span>
        <span class="text-orange-700">{counts.Unconfirmed} {counts.Unconfirmed === 1 ? 'tool' : 'tools'}</span>
      </li>
      <li class="rounded-lg bg-sky-50 px-3 py-2 ring-1 ring-sky-200">
        <span class="font-semibold text-sky-900">Approved:</span>
        <span class="text-sky-700">{counts.Approved} {counts.Approved === 1 ? 'tool' : 'tools'}</span>
      </li>
      <li class="rounded-lg bg-amber-50 px-3 py-2 ring-1 ring-amber-200">
        <span class="font-semibold text-amber-900">Pending:</span>
        <span class="text-amber-700">{counts.Pending} {counts.Pending === 1 ? 'tool' : 'tools'}</span>
      </li>
      <li class="rounded-lg bg-slate-50 px-3 py-2 ring-1 ring-slate-200">
        <span class="font-semibold text-slate-900">None:</span>
        <span class="text-slate-700">{counts.None} {counts.None === 1 ? 'tool' : 'tools'}</span>
      </li>
    </ul>

    <table class="not-prose mt-6 w-full text-sm">
      <thead>
        <tr class="border-b border-slate-200 bg-slate-50 text-left text-slate-700">
          <th class="px-3 py-2 font-semibold">Tool</th>
          <th class="px-3 py-2 font-semibold">Affiliate status</th>
          <th class="px-3 py-2 font-semibold">Notes</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        {toolStatuses.map((t) => {
          const statusStyles = {
            Active: 'bg-emerald-100 text-emerald-800 ring-emerald-200',
            Unconfirmed: 'bg-orange-100 text-orange-800 ring-orange-200',
            Approved: 'bg-sky-100 text-sky-800 ring-sky-200',
            Pending: 'bg-amber-100 text-amber-800 ring-amber-200',
            None: 'bg-slate-100 text-slate-700 ring-slate-200',
          };
          return (
            <tr>
              <td class="px-3 py-2">
                <a href={`/tools/${t.slug}/`} class="font-medium text-slate-900 hover:text-orange-600">
                  {t.name}
                </a>
              </td>
              <td class="px-3 py-2">
                <span class={`inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium ring-1 ${statusStyles[t.status]}`}>
                  {t.status}
                </span>
              </td>
              <td class="px-3 py-2 text-slate-600">{t.note}</td>
            </tr>
          );
        })}
      </tbody>
    </table>

    <h3 class="mt-8">What "Active", "Unconfirmed", "Approved", "Pending", and "None" mean</h3>

    <ul>
      <li>
        <strong>Active</strong>: we have joined the vendor's affiliate or referral program, and our
        "Visit" buttons for this tool use its tracked link. If you sign up through that link, we may
        earn a commission (affiliate program) or a referral reward (referral program); the note says
        when it is a referral program. This does not affect what we write about the tool, including
        the cons section.
      </li>
      <li>
        <strong>Unconfirmed</strong>: our "Visit" buttons for this tool use a tracked link from the
        vendor's partner program, but we have not confirmed the program's status in the vendor's
        partner dashboard, so we do not know whether we earn anything from it. This does not affect
        what we write about the tool.
      </li>
      <li>
        <strong>Approved</strong>: the vendor accepted us into its affiliate program, but we do
        not use the tracked link anywhere on the site. The "Visit" button points to the vendor's
        public page and we earn nothing from it. We list it because an approved account is a
        relationship you should know about.
      </li>
      <li>
        <strong>Pending</strong>: we have applied to the vendor's affiliate program and have not
        had a decision. The "Visit" button points to the vendor's public page directly, so we
        don't earn anything from clicks on this tool today.
      </li>
      <li>
        <strong>None</strong>: we have no affiliate relationship with this vendor. Where we have
        a reason on record, the note gives it: the vendor has no program open to publishers, or
        we applied and were not accepted. The "Visit" button points to the vendor's public page.
        We earn no commission or referral reward from this tool.
      </li>
    </ul>

    <h3 id="reports">Pricing benchmark reports</h3>

    <p>
      We also sell pricing benchmark reports to software vendors, including vendors listed on this site.
      A report covers one trade: the published prices, price ladders, packaging and pricing terms of the
      platforms on that trade page, the medians for that trade, and where the buying vendor's own published
      price, packaging and pricing terms sit against them. It uses vendors' public pages and the data
      published here. Each price in it is read from the vendor's own page while the report is written, where
      that page can be read; where it cannot, the report says so and shows the page used and the date it was
      last read. Prices re-read for a report go through the same second check of the vendor's page as routine
      re-checks and are updated on the site for every platform in that trade, buyer or not, no later than the
      day the report is delivered. A report does not explain or recalculate any Fit
      Score and does not say how any vendor could change its position. Whether a product publishes a price is
      one of the three Fit Score factors (pricing transparency, 20%, above); the report describes published
      pricing for every platform, the buyer's included, and computes no score. We do not quote, invoice or
      take an order while an evaluation, correction, pricing question, dispute or reputation-flag review is
      open with a vendor, or within 30 days after the latest listing verdict, correction or reputation-flag
      email we sent it. One price applies to every vendor and every trade; it is on the
      <a href="/for-vendors/#reports">vendor page</a>, and the <a href="/report-terms/">report terms</a> apply.
    </p>

    <p class="rounded-lg border border-emerald-200 bg-emerald-50 p-4 text-sm not-prose">
      <strong class="text-emerald-900">Buying a report doesn't affect ranking.</strong>
      Whether a vendor bought a report is not an input to any listing, Fit Score, ranking, award or
      reputation flag, or to whether a product is listed. The WrenchStack Fit Score™ (vertical fit + pricing
      transparency + integration coverage) is computed the same way for every vendor. The ledger below shows
      each buyer's Fit Score, rank, award and reputation flag when it ordered and today, so anyone can check.
    </p>

    <h3 id="report-ledger">Report ledger</h3>

    <p>
      Every pricing benchmark report sold is listed here, including refunded orders. "When ordered" is the
      product's Fit Score and rank on that trade page, its award or honorable mention, and any reputation flag
      on the company's WrenchStack entries, on the day we sent the invoice; the buyer's invoice states the same
      figures. "Today" is computed from the current data, the same way as the affiliate ledger above. Where
      the two differ, the note gives each cause with its date: a methodology version in the
      <a href="#changelog">changelog</a>; a change on the buyer's own public page; a WrenchStack data
      correction, and whether it came from report work; changes to other platforms on the trade page (see the
      <a href="/verification-log/">verification log</a>); an award or reputation-flag change; or a product
      listed after it ordered. Until a cause is recorded, the note says so. The note also records the price
      re-read made for the report and any change to the buyer's own listing between invoice and delivery.
    </p>

    <p>
      <strong>Report announcements.</strong> On dates set in advance we email a one-time announcement of the
      report to software vendors listed on our trade pages: vendors that contacted us first about a listing,
      and US-based software vendors on our trade pages that have not. A vendor is skipped if it has an
      evaluation, correction, pricing question, dispute or reputation-flag review open with us, or received a
      listing verdict, correction or reputation-flag email from us in the previous 30 days. Each vendor gets at
      most one announcement and no follow-up, and can opt out by replying. The email does not mention the
      vendor's Fit Score, rank, award or verdict, and whether a vendor received it, replied or bought is not an
      input to any listing. Dates and the number of vendors emailed:
      {reportAnnouncements.map((a, i) => (
        <>{i > 0 && '; '}{a.label}, {a.sent === null ? 'not yet sent' : `${a.sent} ${a.sent === 1 ? 'vendor' : 'vendors'}`}</>
      ))}.
    </p>

    {reportRows.length === 0 ? (
      <p class="not-prose rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700">
        No reports sold as of {reportAsOf}.
      </p>
    ) : (
      <div class="not-prose mt-4 overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-slate-200 bg-slate-50 text-left text-slate-700">
              <th class="px-3 py-2 font-semibold">Vendor and product</th>
              <th class="px-3 py-2 font-semibold">Trade</th>
              <th class="px-3 py-2 font-semibold">Paid</th>
              <th class="px-3 py-2 font-semibold">Price</th>
              <th class="px-3 py-2 font-semibold">When ordered</th>
              <th class="px-3 py-2 font-semibold">Today</th>
              <th class="px-3 py-2 font-semibold">Status</th>
              <th class="px-3 py-2 font-semibold">Note</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {reportRows.map((r) => (
              <tr>
                <td class="px-3 py-2">{r.company}{r.tool && (<>: <a href={`/tools/${r.slug}/`} class="font-medium text-slate-900 hover:text-orange-600">{r.tool.name}</a></>)}</td>
                <td class="px-3 py-2"><a href={`/${verticalToUrl(r.trade)}/`} class="hover:text-orange-600">{r.tradeName}</a></td>
                <td class="px-3 py-2">{r.paidLabel}</td>
                <td class="px-3 py-2">${r.price_usd}</td>
                <td class="px-3 py-2">{r.atOrder}</td>
                <td class="px-3 py-2">{r.today}</td>
                <td class="px-3 py-2">{r.status}</td>
                <td class="px-3 py-2 text-slate-600">{r.noteText}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    <p>
      Questions about independence, including a claim that a report sale affected a listing, go to
      <a href="mailto:hello@wrenchstack.com">hello@wrenchstack.com</a> with the page URL. Each one gets a
      written reply, and a confirmed problem is corrected on the page and noted in this ledger.
    </p>

    <h3>What we do not do</h3>

    <ul>
      <li>Accept payment for placement in a "best of" list</li>
      <li>Accept payment to raise a tool's WrenchStack Fit Score™</li>
      <li>Accept payment to omit or soften cons in a tool review</li>
      <li>Hide an affiliate relationship: every tool's status is on this page</li>
      <li>Hide a report sale: every pricing benchmark report sold to a vendor is in the report ledger on this page</li>
      <li>Recommend a tool we wouldn't recommend if no commission, referral reward or report sale existed</li>
    </ul>

    <h2>Where pricing data comes from</h2>

    <p>
      Each pricing tier shows a <strong>verified date</strong>. We re-check pricing by visiting each vendor's
      public pricing page; where that page cannot be read, the entry keeps its earlier verified date. When a vendor publishes no prices, the page says so;
      we do not estimate prices from forum posts or other secondhand reports. Numbers older than 90 days get an amber freshness pill;
      older than 180 days, a red pill.
    </p>

    <p>
      Vendor-supplied pricing claims that contradict published pages are ignored. If a vendor
      tells us their pricing has changed but the public page still shows the old number, we keep
      the public number until the public page changes.
    </p>

    <h2>Questions or corrections?</h2>

    <p>
      Email <a href="mailto:hello@wrenchstack.com">hello@wrenchstack.com</a>. Include the page URL
      and a primary source; corrections are checked against the source you send.
    </p>
  </article>
