---
import Layout from '../../layouts/Layout.astro';
import { EN_MARKET_HREFLANG } from '../../lib/intl';
import nzData from '../../data/international/nz.json';

interface NzVendor {
  slug: string;
  name: string;
  category: string;
  vendor_url: string;
  tagline: string;
  market_position: string;
  nz_specific_note?: string | null;
  tier: 'S' | 'A' | 'F';
  reputation_flag: string | null;
  pros: string[];
  cons: string[];
  typical_pricing: string;
  is_cross_market: boolean;
  cross_market_link: string | null;
}

const vendors = (nzData as { vendors: NzVendor[] }).vendors;

const categories = ['software', 'lead-gen', 'insurance', 'payroll', 'certification'];
const categoryMeta: Record<string, { label: string; description: string }> = {
  'software': { label: 'Job management software', description: `Fergus and NextMinute are based in Auckland and Invven is a New Zealand company. Tradify was founded in New Zealand and is now owned by the UK's Access Group. ServiceM8 is an Australian company, Simpro started in Brisbane and AroFlo is headquartered in Melbourne; Simpro and AroFlo are both part of Simpro Group. GST treatment and accounting links differ by vendor, so check each entry.` },
  'lead-gen': { label: 'Lead-generation platforms', description: `Different models. Builderscrack (owned by Australia's hipages Group) and FairTrades NZ let homeowners post jobs free for tradies to quote on; Builderscrack does not publish its tradie fees. NoCowboys is a ratings site with a $999 a year business registration, Trade Me Services sells listings that run for 90 days, and Localist sells profile plans from $5 a month that include no leads or quote requests.` },
  'insurance': { label: 'Business insurance', description: `Two IAG New Zealand brands, NZI (sold through brokers) and AMI (direct, online or by phone); Suncorp-owned Vero, sold through brokers and advisers; Builtin, a Tauranga broker for builders and trades; and BizCover, an online platform that acts as the insurer's agent. AMI advertises its Tradies Insurance bundle from $19 a week and BizCover publishes average monthly costs as a guide; NZI, Vero and Builtin quote per business.` },
  'payroll': { label: 'Payroll software', description: 'New Zealand payroll services that file with Inland Revenue. iPayroll, Thankyou Payroll and Crystal Payroll say they act as PAYE intermediaries; Smartly and PayHero also file with Inland Revenue. Pricing models differ: per pay run, per employee per pay run, or a monthly base fee plus a per-employee charge.' },
  'certification': { label: 'Licensing, regulators and associations', description: 'EWRB registers and licenses electrical workers, PGDB registers and licenses plumbers, gasfitters and drainlayers, and Restricted Building Work on homes must be done or supervised by a Licensed Building Practitioner (LBP). WorkSafe New Zealand enforces health and safety duties that apply to every trade business. The Registered Master Builders Association and Master Plumbers, Gasfitters & Drainlayers NZ are voluntary memberships and do not replace licensing.' },
};

const vendorsByCategory: Record<string, NzVendor[]> = {};
categories.forEach(c => { vendorsByCategory[c] = vendors.filter(v => v.category === c); });

const pageTitle = 'NZ Trades Vendor Directory | WrenchStack New Zealand';
const pageDescription = `WrenchStack's New Zealand trades vendor directory: ${vendors.length} entries across job management software, lead generation, insurance, payroll, and licensing bodies and trade associations (EWRB, PGDB, LBP), with prices where the vendor or body publishes them.`;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'New Zealand', url: '/nz/' },
];
---

<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs} alternateUrls={EN_MARKET_HREFLANG}>
  <article class="mx-auto max-w-5xl px-4 py-12">

    <header class="mb-10">
      <div class="mb-3 flex items-center gap-2">
        <span class="text-2xl" aria-hidden="true">🇳🇿</span>
        <p class="text-sm font-semibold uppercase tracking-wider text-orange-600">New Zealand</p>
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">
        New Zealand Trades Vendor Directory
      </h1>
      <p class="mt-4 text-lg text-slate-600 leading-relaxed">
        Independent reviews of {vendors.length} New Zealand-relevant entries across 5 categories: job management software from Auckland-based Fergus and NextMinute, Tradify (founded in New Zealand, now owned by the UK's Access Group) and Australian-origin tools; licensing through EWRB for electrical work, PGDB for plumbing, gasfitting and drainlaying, and the LBP scheme for Restricted Building Work on homes; and payroll services that file with Inland Revenue.
      </p>
    </header>

    <section class="mb-10 grid gap-3 grid-cols-2 sm:grid-cols-5">
      {categories.map(c => (
        <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
          <div class="text-2xl font-bold text-slate-900">{vendorsByCategory[c].length}</div>
          <div class="mt-1 text-xs text-slate-600 capitalize">{c.replace('-', ' ')}</div>
        </div>
      ))}
    </section>

    <section class="mb-10 flex flex-wrap items-center justify-between gap-4 rounded-lg border border-orange-200 bg-orange-50 p-5">
      <div>
        <h2 class="text-base font-bold text-slate-900">Deciding between two options?</h2>
        <p class="mt-1 text-sm text-slate-700">See NZ vendors in the same category side by side: pros and cons, NZ-specific notes and pricing.</p>
      </div>
      <a href="/nz/compare/" class="shrink-0 rounded-md bg-slate-900 px-5 py-3 text-sm font-semibold text-white hover:bg-slate-700">Compare NZ vendors →</a>
    </section>

    <section class="mb-10 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-3 text-base font-bold text-slate-900">What to check before choosing an NZ vendor</h2>
      <p class="text-sm text-slate-700 leading-relaxed">
        Licensing: electrical work needs EWRB registration and a practising licence renewed every 2 years; plumbing, gasfitting and drainlaying need PGDB registration and a practising licence renewed each year; Restricted Building Work on homes must be done or supervised by a Licensed Building Practitioner. Customers can check each on a public register. GST: NextMinute, Tradify, PayHero and Invven quote NZD prices excluding GST, Localist includes GST, and Fergus, ServiceM8, NoCowboys and FairTrades NZ do not say. Payroll: iPayroll, Thankyou Payroll and Crystal Payroll say they act as PAYE intermediaries with Inland Revenue. Ownership: Tradify belongs to the UK's Access Group, Builderscrack to Australia's hipages Group, and Simpro and AroFlo to Simpro Group.
      </p>
    </section>

    {categories.map(c => {
      const cat = categoryMeta[c];
      const cv = vendorsByCategory[c];
      if (cv.length === 0) return null;
      return (
        <section class="mb-12">
          <div class="mb-5">
            <h2 class="text-2xl font-bold text-slate-900 capitalize">{cat.label}</h2>
            <p class="mt-1 text-sm text-slate-600 leading-relaxed">{cat.description}</p>
          </div>
          <div class="space-y-4">
            {cv.map(v => {
              const tierColor = v.tier === 'S' ? 'border-emerald-300' : v.tier === 'F' ? 'border-rose-300' : 'border-blue-300';
              const tierLabel = v.tier === 'S' ? 'Published prices' : v.tier === 'F' ? 'Reputation warning' : 'Listed';
              const tierBadge = v.tier === 'S' ? 'bg-emerald-100 text-emerald-900' : v.tier === 'F' ? 'bg-rose-100 text-rose-900' : 'bg-blue-100 text-blue-900';
              return (
                <article class={`rounded-lg border-2 ${tierColor} bg-white p-5`}>
                  <div class="mb-3 flex items-start justify-between gap-3">
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-2 mb-1 flex-wrap">
                        <h3 class="text-xl font-bold text-slate-900">{v.name}</h3>
                        <span class={`rounded-full px-2 py-0.5 text-xs font-bold ${tierBadge}`}>Tier {v.tier} · {tierLabel}</span>
                        {v.is_cross_market && (
                          <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-700">Cross-market</span>
                        )}
                      </div>
                      <p class="text-sm italic text-slate-500">{v.tagline}</p>
                    </div>
                  </div>

                  {v.reputation_flag && (
                    <div class="mb-3 rounded-md border-l-4 border-rose-500 bg-rose-50 px-4 py-3 text-sm text-rose-900">
                      <p class="font-bold uppercase tracking-wider text-xs text-rose-700 mb-1">⚠ Reputation warning</p>
                      <p class="leading-relaxed">{v.reputation_flag}</p>
                    </div>
                  )}

                  <p class="mb-3 text-sm text-slate-700 leading-relaxed">{v.market_position}</p>

                  {v.nz_specific_note && (
                    <div class="mb-3 rounded-md bg-slate-50 px-4 py-3">
                      <p class="text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">NZ-specific note</p>
                      <p class="text-sm text-slate-700 leading-relaxed">{v.nz_specific_note}</p>
                    </div>
                  )}

                  <div class="mb-3 grid gap-3 sm:grid-cols-2">
                    <div>
                      <p class="text-xs font-bold uppercase tracking-wider text-emerald-700 mb-1">Pros</p>
                      <ul class="space-y-1 text-sm text-slate-700">
                        {v.pros.slice(0, 4).map(p => <li class="leading-snug">+ {p}</li>)}
                      </ul>
                    </div>
                    <div>
                      <p class="text-xs font-bold uppercase tracking-wider text-rose-700 mb-1">Cons</p>
                      <ul class="space-y-1 text-sm text-slate-700">
                        {v.cons.slice(0, 4).map(con => <li class="leading-snug">− {con}</li>)}
                      </ul>
                    </div>
                  </div>

                  <div class="mb-3 text-xs text-slate-600">
                    <strong class="text-slate-900">Typical NZ pricing:</strong> {v.typical_pricing}
                  </div>

                  <div class="flex flex-wrap gap-2">
                    <a href={`/nz/${v.slug}/`} class="rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700">Full NZ review →</a>
                    <a href={v.vendor_url} rel="sponsored nofollow noopener" target="_blank" class="rounded-md bg-orange-500 px-4 py-2 text-sm font-semibold text-white hover:bg-orange-600">Visit {v.name} →</a>
                    {v.cross_market_link && (
                      <a href={v.cross_market_link} class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">Full review (US market context)</a>
                    )}
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      );
    })}

    <section class="mt-12 rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">Missing an NZ vendor?</h2>
      <p class="mt-2 text-slate-300 leading-relaxed">
        {vendors.length} NZ entries listed today. Want an NZ vendor reviewed? Submit them via our <a href="/for-vendors/" class="underline">vendor program</a>.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/" class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600">Back to US directory →</a>
        <a href="/for-vendors/" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">Submit an NZ vendor</a>
      </div>
    </section>
  </article>
</Layout>
