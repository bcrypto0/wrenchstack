---
import Layout from '../../layouts/Layout.astro';
import omData from '../../data/international/om.json';

interface OmVendor {
  slug: string; name: string; category: string; vendor_url: string;
  tagline: string; market_position: string; om_specific_note?: string | null;
  tier: 'S' | 'A' | 'F'; reputation_flag: string | null;
  pros: string[]; cons: string[]; typical_pricing: string;
  is_cross_market: boolean; cross_market_link: string | null;
}

const vendors = (omData as { vendors: OmVendor[] }).vendors;
const categories = ['software', 'insurance', 'lead-gen', 'certification'];
const categoryMeta: Record<string, { label: string; description: string }> = {
  'insurance': { label: 'Contractor insurance', description: "Contractor and engineering cover from insurers selling in Oman: GIG Gulf (formerly AXA Gulf), Liva Insurance (formed from NLGIC and Al Ahlia Insurance, per Liva) and Oman United Insurance, which publishes its CAR and EAR cover details online. All quote-based, with no published rates." },
  'lead-gen': { label: 'Lead generation & project intelligence', description: "ProTenders tracks GCC construction projects, with an Oman projects page, a free company profile, and custom-priced intelligence and eTendering. Omani government tenders run separately on the Esnad portal." },
  'software': { label: 'Construction & trades software', description: 'Global project management, scheduling, document-control and design platforms (Bentley Systems, Oracle Primavera P6, Oracle Aconex, Autodesk Forma, Procore), none with an Oman reseller or partner confirmed in our check; ERPs with Muscat offices (Focus Softnet, Onyx Pro ERP, Grey ERP) plus ePROMIS, which runs an Oman page; ClearTax for Fawtara e-invoicing; and accounting software from Zoho (Books), Wafeq and TallyPrime.' },
  'certification': { label: 'Licensing & compliance', description: 'Official bodies and rules for contractors in Oman: the Tax Authority (5% VAT and Fawtara e-invoicing), OSE engineer accreditation, the Authority for Projects, Tenders & Local Content (Esnad registration and classification), the Ministry of Labour (work permits and Omanisation), Muscat Municipality building permits, the unified Oman Building Code and the Civil Defence and Ambulance Authority (CDAA) for fire safety.' },
};
const vendorsByCategory: Record<string, OmVendor[]> = {};
categories.forEach(c => { vendorsByCategory[c] = vendors.filter(v => v.category === c); });

const pageTitle = 'Oman Construction & Trades Software | WrenchStack';
const pageDescription = `Independent directory of ${vendors.length} construction and trades vendors and official bodies for Oman: project and design platforms, ERPs, Fawtara e-invoicing and accounting software, contractor insurers, plus the Tax Authority's e-invoicing phases (2026-2027), OSE accreditation, contractor classification, Omanisation and the building code.`;
const breadcrumbs = [ { name: 'Home', url: '/' }, { name: 'Oman', url: '/om/' } ];
---
<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>
  <article class="mx-auto max-w-5xl px-4 py-12">
    <header class="mb-10">
      <div class="mb-3 flex items-center gap-2">
        <span class="text-2xl" aria-hidden="true">🇴🇲</span>
        <p class="text-sm font-semibold uppercase tracking-wider text-orange-600">Oman · سلطنة عُمان</p>
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">Oman Construction & Trades Software Directory</h1>
      <p class="mt-4 text-lg text-slate-600 leading-relaxed">
        Independent reviews of {vendors.length} Oman-relevant vendors and official bodies: global project, scheduling and design platforms (Bentley Systems, Oracle Primavera P6, Oracle Aconex, Autodesk Forma, Procore), ERPs (Focus Softnet, ePROMIS, Onyx Pro ERP, Grey ERP), accounting and e-invoicing software, and contractor insurers, alongside the local rules: 5% VAT, the phased Fawtara e-invoicing mandate, OSE accreditation, contractor classification, Omanisation and the unified Oman Building Code.
      </p>
    </header>

    <section class="mb-10 grid gap-3 grid-cols-2 sm:grid-cols-4">
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">{vendors.length}</div>
        <div class="mt-1 text-xs text-slate-600">vendors reviewed</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">5%</div>
        <div class="mt-1 text-xs text-slate-600">standard VAT rate</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">OMR 301</div>
        <div class="mt-1 text-xs text-slate-600">establishment work permit fee per non-Omani worker, issue or renewal (Ministry of Labour)</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">2030</div>
        <div class="mt-1 text-xs text-slate-600">building code enforced in all governorates (Muscat Daily)</div>
      </div>
    </section>

    <section class="mb-10 flex flex-wrap items-center justify-between gap-4 rounded-lg border-2 border-emerald-300 bg-emerald-50 p-5">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-emerald-700">⏰ Compliance guide · Fawtara e-invoicing phases 2026-2027</p>
        <h2 class="mt-1 text-base font-bold text-slate-900">Oman e-invoicing (Fawtara) for construction companies</h2>
        <p class="mt-1 text-sm text-slate-700">The Tax Authority's phase dates (its FAQ says implementation begins in August 2026 for 100 large VAT-registered companies and in August 2027 for all remaining VAT-registered taxpayers), how its 5-corner model works, and what accounting software says about Fawtara.</p>
      </div>
      <a href="/om/guides/oman-e-invoicing-contractors/" class="shrink-0 rounded-md bg-emerald-700 px-5 py-3 text-sm font-semibold text-white hover:bg-emerald-800">Read the guide →</a>
    </section>

    <section class="mb-10 flex flex-wrap items-center justify-between gap-4 rounded-lg border border-orange-200 bg-orange-50 p-5">
      <div>
        <h2 class="text-base font-bold text-slate-900">Deciding between two options?</h2>
        <p class="mt-1 text-sm text-slate-700">See Oman vendors compared side by side: a short verdict, pros and cons, Oman-specific notes, and pricing, head to head.</p>
      </div>
      <a href="/om/compare/" class="shrink-0 rounded-md bg-slate-900 px-5 py-3 text-sm font-semibold text-white hover:bg-slate-700">Compare Oman vendors →</a>
    </section>

    <section class="mb-10 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-3 text-base font-bold text-slate-900">What's different about choosing software in Oman</h2>
      <p class="text-sm text-slate-700 leading-relaxed">
        Oman is introducing mandatory <strong>e-invoicing</strong>. The Oman Tax Authority's Fawtara FAQ says implementation begins in <strong>August 2026 for 100 large VAT-registered companies</strong>, in February 2027 for all large VAT-registered companies and in <strong>August 2027 for all remaining VAT-registered taxpayers</strong>, the phase that includes SMEs; other sources give different dates, so check yours with the Tax Authority. E-invoices must flow through an OTA-accredited service provider, so ask any accounting or ERP vendor how it will connect. VAT itself is <strong>5%</strong>, with registration mandatory above OMR 38,500 of annual supplies. None of the global project and design platforms listed here has an Oman reseller or partner confirmed in our check, while Focus Softnet, Onyx Pro ERP and Grey ERP list Muscat offices. Compliance has structure too: <strong>OSE accreditation</strong> has been required for engineer work permits since 1 August 2025, the <strong>Authority for Projects, Tenders & Local Content</strong> registers and classifies contractors for government work on its Esnad portal, a firm's <strong>Omanisation</strong> category moves work permit and visa fees 30% down or doubles them (Muscat Daily), and the unified <strong>Oman Building Code</strong> is optional in 2026 and 2027, enforced in Muscat from 2028 and nationwide by 2030 (Muscat Daily).
      </p>
    </section>

    {categories.map(c => {
      const cat = categoryMeta[c];
      const cv = vendorsByCategory[c];
      if (cv.length === 0) return null;
      return (
        <section class="mb-12">
          <div class="mb-5">
            <h2 class="text-2xl font-bold text-slate-900">{cat.label}</h2>
            <p class="mt-1 text-sm text-slate-600 leading-relaxed">{cat.description}</p>
          </div>
          <div class="space-y-4">
            {cv.map(v => {
              const isCert = v.category === 'certification';
              const tierColor = v.tier === 'S' ? 'border-emerald-300' : v.tier === 'F' ? 'border-rose-300' : 'border-blue-300';
              const tierLabel = isCert ? 'Official body / regime' : v.tier === 'S' ? 'Published prices' : v.tier === 'F' ? 'Reputation warning' : 'Listed';
              const tierBadge = v.tier === 'S' ? 'bg-emerald-100 text-emerald-900' : v.tier === 'F' ? 'bg-rose-100 text-rose-900' : 'bg-blue-100 text-blue-900';
              return (
                <article class={`rounded-lg border-2 ${tierColor} bg-white p-5`}>
                  <div class="mb-3 flex items-start justify-between gap-3">
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-2 mb-1 flex-wrap">
                        <h3 class="text-xl font-bold text-slate-900">{v.name}</h3>
                        <span class={`rounded-full px-2 py-0.5 text-xs font-bold ${tierBadge}`}>{isCert ? tierLabel : `Tier ${v.tier} · ${tierLabel}`}</span>
                        </div>
                      <p class="text-sm italic text-slate-500">{v.tagline}</p>
                    </div>
                  </div>
                  <p class="mb-3 text-sm text-slate-700 leading-relaxed">{v.market_position}</p>
                  {v.om_specific_note && (
                    <div class="mb-3 rounded-md bg-slate-50 px-4 py-3">
                      <p class="text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Oman-specific note</p>
                      <p class="text-sm text-slate-700 leading-relaxed">{v.om_specific_note}</p>
                    </div>
                  )}
                  <div class="mb-3 grid gap-3 sm:grid-cols-2">
                    <div>
                      <p class="text-xs font-bold uppercase tracking-wider text-emerald-700 mb-1">{isCert ? 'What it covers' : 'Pros'}</p>
                      <ul class="space-y-1 text-sm text-slate-700">{v.pros.slice(0, 4).map(p => <li class="leading-snug">+ {p}</li>)}</ul>
                    </div>
                    <div>
                      <p class="text-xs font-bold uppercase tracking-wider text-rose-700 mb-1">{isCert ? 'Watch out for' : 'Cons'}</p>
                      <ul class="space-y-1 text-sm text-slate-700">{v.cons.slice(0, 4).map(con => <li class="leading-snug">− {con}</li>)}</ul>
                    </div>
                  </div>
                  <div class="mb-3 text-xs text-slate-600"><strong class="text-slate-900">{isCert ? 'Cost / access:' : 'Typical Oman pricing:'}</strong> {v.typical_pricing}</div>
                  <div class="flex flex-wrap gap-2">
                    <a href={`/om/${v.slug}/`} class="rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700">Full Oman review →</a>
                    <a href={v.vendor_url} rel="sponsored nofollow noopener" target="_blank" class="rounded-md bg-orange-500 px-4 py-2 text-sm font-semibold text-white hover:bg-orange-600">{isCert ? 'Official site' : `Visit ${v.name}`} →</a>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      );
    })}

    <section class="mt-12 rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">Are you an Oman vendor?</h2>
      <p class="mt-2 text-slate-300 leading-relaxed">If you build software or services for Oman construction and trades businesses and want to be reviewed or listed, get in touch through our <a href="/for-vendors/" class="underline">vendor program</a>.</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/for-vendors/" class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600">Work with us →</a>
        <a href="/software-by-country/" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">🌍 Software by country</a>
        <a href="/methodology/" class="rounded-md border border-white/30 bg-white/10 px-5 py-3 text-sm font-semibold text-white hover:bg-white/20">Methodology</a>
      </div>
    </section>
  </article>
</Layout>
