---
import Layout from '../../layouts/Layout.astro';
import aeData from '../../data/international/ae.json';

interface AeVendor {
  slug: string; name: string; category: string; vendor_url: string;
  tagline: string; market_position: string; ae_specific_note?: string | null;
  tier: 'S' | 'A' | 'F'; reputation_flag: string | null;
  pros: string[]; cons: string[]; typical_pricing: string;
  is_cross_market: boolean; cross_market_link: string | null;
}

const vendors = (aeData as { vendors: AeVendor[] }).vendors;
const categories = ['software', 'insurance', 'lead-gen', 'certification'];
const categoryMeta: Record<string, { label: string; description: string }> = {
  'insurance': { label: 'Contractor insurance', description: `Engineering and contractor cover from UAE insurers regulated by the Central Bank of the UAE: Sukoon (formerly Oman Insurance Company), ADNIC and the Shariah-compliant takaful insurer Salama. Each lists Contractor’s All Risk, Erection All Risk and plant and machinery cover; ADNIC and Salama add workmen’s or employee compensation and public liability. None publishes premiums; every policy is quoted.` },
  'lead-gen': { label: 'Lead generation & project intelligence', description: `Construction project intelligence and eTendering from ProTenders, which covers UAE projects within its GCC project data and lists an office in Abu Dhabi. A company profile is free; the Construction Intelligence and eTendering products are custom-priced, with a demo on request.` },
  'software': { label: 'Construction & trades software', description: `Document control and scheduling from Oracle (Aconex, Primavera P6), BIM and construction platforms from Autodesk (now sold as Autodesk Forma) and Bentley, project management from Procore and site inspections from PlanRadar; ERP and finance systems (Focus Softnet, First Bit, PACT, Sage); Zoho’s accounting, project and field-service apps; and CAFM and field-service tools (Horizon FMS, FSM Grid). Focus Softnet, PACT and Zoho are on the Ministry of Finance list of accredited e-invoicing service providers (list checked 30 September 2026).` },
  'certification': { label: 'Licensing & compliance', description: `Dubai Municipality’s Contractors Register under Dubai Law No. 7 of 2025, MOEI e-qualification for MOEI engineering projects, 5% VAT through the Federal Tax Authority, Peppol e-invoicing through accredited service providers (mandatory in phases from 1 January 2027), Emiratisation targets (MOHRE and Nafis), Abu Dhabi DMT permits with the Estidama Pearl rating, and Dubai’s BIM model requirement.` },
};
const vendorsByCategory: Record<string, AeVendor[]> = {};
categories.forEach(c => { vendorsByCategory[c] = vendors.filter(v => v.category === c); });

const pageTitle = 'UAE Construction & Trades Software | WrenchStack';
const pageDescription = `Independent directory of ${vendors.length} construction and trades vendors and official bodies for the UAE: BIM and project platforms, ERP, accounting and field-service tools, contractor insurers, plus Dubai Municipality registration, 5% VAT (FTA), Peppol e-invoicing, Emiratisation and Estidama.`;
const breadcrumbs = [ { name: 'Home', url: '/' }, { name: 'UAE', url: '/ae/' } ];
const enUrl = new URL('/ae/', Astro.site).toString();
const arUrl = new URL('/ae/ar/', Astro.site).toString();
---
<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs} alternateUrls={[{ hreflang: 'en', href: enUrl }, { hreflang: 'ar', href: arUrl }, { hreflang: 'x-default', href: enUrl }]}>
  <article class="mx-auto max-w-5xl px-4 py-12">
    <header class="mb-10">
      <div class="mb-3 flex items-center justify-between gap-3">
        <div class="flex items-center gap-2">
          <span class="text-2xl" aria-hidden="true">🇦🇪</span>
          <p class="text-sm font-semibold uppercase tracking-wider text-orange-600">United Arab Emirates · الإمارات العربية المتحدة</p>
        </div>
        <a href="/ae/ar/" class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">العربية</a>
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">UAE Construction & Trades Software Directory</h1>
      <p class="mt-4 text-lg text-slate-600 leading-relaxed">
        Independent reviews of {vendors.length} UAE-relevant vendors and official bodies across Dubai and Abu Dhabi: project and BIM platforms (Oracle Aconex, Autodesk, Procore), ERP and accounting software (Focus Softnet, First Bit, PACT, Sage, Zoho Books), field-service and CAFM tools, contractor insurers and project intelligence, with the local compliance context: Dubai Municipality’s Contractors Register, 5% VAT through the FTA, Peppol e-invoicing mandatory in phases from January 2027, Emiratisation, Abu Dhabi’s Estidama Pearl rating and Dubai’s BIM requirement.
      </p>
    </header>
    <section class="mb-10 grid gap-3 grid-cols-2 sm:grid-cols-4">
      {categories.map(c => (
        <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
          <div class="text-2xl font-bold text-slate-900">{vendorsByCategory[c].length}</div>
          <div class="mt-1 text-xs text-slate-600 capitalize">{c}</div>
        </div>
      ))}
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center"><div class="text-2xl font-bold text-slate-900">5%</div><div class="mt-1 text-xs text-slate-600">VAT (FTA)</div></div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center"><div class="text-2xl font-bold text-slate-900">2</div><div class="mt-1 text-xs text-slate-600">emirate regulators listed</div></div>
    </section>
    <section class="mb-10 flex flex-wrap items-center justify-between gap-4 rounded-lg border border-orange-200 bg-orange-50 p-5">
      <div>
        <h2 class="text-base font-bold text-slate-900">Deciding between two options?</h2>
        <p class="mt-1 text-sm text-slate-700">See UAE vendors compared side by side: verdict, pros and cons, UAE-specific notes, and pricing, head to head.</p>
      </div>
      <a href="/ae/compare/" class="shrink-0 rounded-md bg-slate-900 px-5 py-3 text-sm font-semibold text-white hover:bg-slate-700">Compare UAE vendors →</a>
    </section>
    <section class="mb-10 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-3 text-base font-bold text-slate-900">What’s different about choosing software in the UAE</h2>
      <p class="text-sm text-slate-700 leading-relaxed">
        Several UAE rules shape what your software has to handle. <strong>VAT is 5%</strong>, administered by the Federal Tax Authority since 1 January 2018: registration is mandatory once taxable supplies and imports exceed AED 375,000 over 12 months, and returns and payments are due through EmaraTax within 28 days of the end of each tax period, so set your invoicing up for UAE VAT at 5%. <strong>E-invoicing</strong> runs on a decentralised <strong>Peppol</strong> model through Accredited Service Providers: under Ministerial Decision No. 244 of 2025, as amended by Ministerial Resolution No. 66 of 2026, businesses with revenue of AED 50 million or more must appoint one by 30 October 2026 and implement e-invoicing by 1 January 2027, and smaller businesses by 31 March 2027 and 1 July 2027. E-invoice-capable software is not enough on its own; you need a contract with a provider on the Ministry of Finance list. <strong>Emiratisation</strong> targets from MOHRE apply to companies with 50 or more employees, and to companies with 20-49 employees in 14 sectors, with a financial contribution for each missed position; MOHRE points employers to the <strong>Nafis</strong> platform to find Emirati candidates. Rules also differ by emirate: Dubai work needs entry in <strong>Dubai Municipality’s Contractors Register</strong> under Dubai Law No. 7 of 2025, while Abu Dhabi runs <strong>DMT</strong> classification and building permits, which require at least one <strong>Estidama Pearl</strong> (two for government-funded projects). Dubai Municipality also announced that from 1 January 2024 it would accept planning applications above set size thresholds, and for hospitals, universities and all government projects, only with a <strong>BIM model</strong> (as reported by Global Construction Review).
      </p>
    </section>
    {categories.map(c => {
      const cat = categoryMeta[c];
      const cv = vendorsByCategory[c];
      if (cv.length === 0) return null;
      return (
        <section class="mb-12">
          <div class="mb-5">
            <h2 class="text-2xl font-bold text-slate-900">{cat.label}</h2>
            <p class="mt-1 text-sm text-slate-600 leading-relaxed">{cat.description}</p>
          </div>
          <div class="space-y-4">
            {cv.map(v => {
              const isCert = v.category === 'certification';
              const tierColor = v.tier === 'S' ? 'border-emerald-300' : v.tier === 'F' ? 'border-rose-300' : 'border-blue-300';
              const tierLabel = isCert ? 'Official body' : v.tier === 'S' ? 'Published prices' : v.tier === 'F' ? 'Reputation warning' : 'Listed';
              const tierBadge = v.tier === 'S' ? 'bg-emerald-100 text-emerald-900' : v.tier === 'F' ? 'bg-rose-100 text-rose-900' : 'bg-blue-100 text-blue-900';
              return (
                <article class={`rounded-lg border-2 ${tierColor} bg-white p-5`}>
                  <div class="mb-3 flex items-start justify-between gap-3">
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-2 mb-1 flex-wrap">
                        <h3 class="text-xl font-bold text-slate-900">{v.name}</h3>
                        <span class={`rounded-full px-2 py-0.5 text-xs font-bold ${tierBadge}`}>{isCert ? tierLabel : `Tier ${v.tier} · ${tierLabel}`}</span>
                        </div>
                      <p class="text-sm italic text-slate-500">{v.tagline}</p>
                    </div>
                  </div>
                  <p class="mb-3 text-sm text-slate-700 leading-relaxed">{v.market_position}</p>
                  {v.ae_specific_note && (
                    <div class="mb-3 rounded-md bg-slate-50 px-4 py-3">
                      <p class="text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">UAE-specific note</p>
                      <p class="text-sm text-slate-700 leading-relaxed">{v.ae_specific_note}</p>
                    </div>
                  )}
                  <div class="mb-3 grid gap-3 sm:grid-cols-2">
                    <div>
                      <p class="text-xs font-bold uppercase tracking-wider text-emerald-700 mb-1">{isCert ? 'What it covers' : 'Pros'}</p>
                      <ul class="space-y-1 text-sm text-slate-700">{v.pros.slice(0, 4).map(p => <li class="leading-snug">+ {p}</li>)}</ul>
                    </div>
                    <div>
                      <p class="text-xs font-bold uppercase tracking-wider text-rose-700 mb-1">{isCert ? 'Watch out for' : 'Cons'}</p>
                      <ul class="space-y-1 text-sm text-slate-700">{v.cons.slice(0, 4).map(con => <li class="leading-snug">− {con}</li>)}</ul>
                    </div>
                  </div>
                  <div class="mb-3 text-xs text-slate-600"><strong class="text-slate-900">{isCert ? 'Cost / access:' : 'Typical UAE pricing:'}</strong> {v.typical_pricing}</div>
                  <div class="flex flex-wrap gap-2">
                    <a href={`/ae/${v.slug}/`} class="rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700">Full UAE review →</a>
                    <a href={v.vendor_url} rel="sponsored nofollow noopener" target="_blank" class="rounded-md bg-orange-500 px-4 py-2 text-sm font-semibold text-white hover:bg-orange-600">{isCert ? 'Official site' : `Visit ${v.name}`} →</a>
                    {v.cross_market_link && (<a href={v.cross_market_link} class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">Full review (US market context)</a>)}
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      );
    })}
    <section class="mt-12 rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">Are you a UAE software vendor?</h2>
      <p class="mt-2 text-slate-300 leading-relaxed">If you build construction, ERP, accounting or field-service software for the UAE/Gulf market and want to be reviewed or listed, get in touch through our <a href="/for-vendors/" class="underline">vendor program</a>.</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/for-vendors/" class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600">Work with us →</a>
        <a href="/sa/" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">🇸🇦 Saudi directory</a>
        <a href="/methodology/" class="rounded-md border border-white/30 bg-white/10 px-5 py-3 text-sm font-semibold text-white hover:bg-white/20">Methodology</a>
      </div>
    </section>
  </article>
</Layout>
