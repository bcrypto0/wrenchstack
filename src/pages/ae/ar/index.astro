---
import Layout from '../../../layouts/Layout.astro';
import aeData from '../../../data/international/ae.json';

interface AeVendor {
  slug: string; name: string; category: string; vendor_url: string;
  tagline: string; tier: 'S' | 'A' | 'F';
  is_cross_market: boolean;
}
const vendors = (aeData as { vendors: AeVendor[] }).vendors;

// Concise Arabic positioning per vendor (detailed reviews remain in English for now).
const ar: Record<string, string> = {
  'oracle-aconex': 'منصة سحابية من Oracle للتحكم بالوثائق والمراسلات وسير عمل المراجعة في سجل مشترك لجميع أطراف المشروع. الأسعار بطلب عرض سعر.',
  'oracle-primavera-p6': 'برنامج Oracle لجدولة المسار الحرج وإدارة محافظ المشاريع (P6 EPPM وP6 Professional). للجدولة فقط، دون محاسبة أو ضريبة قيمة مضافة.',
  'autodesk-construction-cloud': 'منصة Autodesk للإنشاءات، تُباع منذ مارس ٢٠٢٦ تحت علامة Autodesk Forma: تنسيق النماذج وإدارة الوثائق والحصر والتسعير. الأسعار بطلب عرض سعر.',
  'procore': 'منصة لإدارة المشاريع والجودة والسلامة والشؤون المالية للمشاريع، ولها مكتب في مدينة دبي للإنترنت منذ ٢٠٢٢. عدد غير محدود من المستخدمين في كل عقد (بحسب Procore).',
  'bentley-systems': 'برامج هندسة البنية التحتية (ProjectWise وSYNCHRO 4D وOpenRoads Designer وMicroStation)، بأسعار منشورة بالدولار على موقعها، ولها مكتب في دبي.',
  'planradar': 'تطبيق لتوثيق الموقع والفحص ومتابعة العيوب، له موقع إماراتي بالعربية ومكتب في وسط دبي. أسعار منشورة لكل مستخدم، والمقاولون من الباطن مجاناً.',
  'first-bit-erp': 'نظام تخطيط موارد تقول الشركة إنه مصمم لمقاولي الإمارات: مراقبة تكاليف المشاريع والمشتريات والمحاسبة والضرائب والرواتب. مكتبها في مجمع دبي للاستثمار.',
  'focus-softnet': 'نظام تخطيط موارد مع تكاليف المشاريع وإدارة العقود وإدارة المرافق (Focus CAFM)، بمكاتب في دبي وأبوظبي والشارقة. مزوّد خدمة فوترة إلكترونية معتمد من وزارة المالية.',
  'pact-erp': 'نظام تخطيط موارد متعدد الوحدات مع حل للمقاولات: تخطيط المشاريع ومراقبة التكاليف والمشتريات والرواتب مع ملفات WPS. مزوّد خدمة فوترة إلكترونية معتمد من وزارة المالية.',
  'sage-uae': 'أنظمة Sage للمالية وتخطيط الموارد (Sage 300 وSage X3 وSage Intacct) تُباع عبر شركاء في الإمارات. ضريبة القيمة المضافة في Sage Intacct تأتي من وحدة بناها شريك.',
  'zoho': 'Zoho Books للمحاسبة وضريبة القيمة المضافة، مع Zoho Projects وZoho FSM، بأسعار منشورة بالدرهم وخطة مجانية. مزوّد خدمة فوترة إلكترونية معتمد من وزارة المالية.',
  'horizon-fms': 'نظام إدارة مرافق (CAFM) من شركة FIT في دبي: الأصول والصيانة الوقائية وأوامر العمل والعقود.',
  'fsm-grid': 'منصة لإدارة الخدمة الميدانية من FSM Global التابعة لـ Ducont Systems: الجدولة والتوزيع وأوامر العمل وقطع الغيار، مع وحدة للتكييف (HVAC) ومكتب في دبي.',
  'dubai-municipality': 'بلدية دبي: سجل المقاولين الإلكتروني الإلزامي وتصنيف المقاولين بموجب قانون دبي رقم ٧ لسنة ٢٠٢٥، ورخص البناء.',
  'moei': 'وزارة الطاقة والبنية التحتية: تسجيل وتأهيل الاستشاريين والمقاولين والموردين إلكترونياً لمشاريعها الهندسية.',
  'uae-vat-fta': 'ضريبة القيمة المضافة ٥٪، تديرها الهيئة الاتحادية للضرائب منذ ١ يناير ٢٠١٨.',
  'uae-einvoicing': 'الفوترة الإلكترونية عبر مزوّدي خدمة معتمدين بنموذج Peppol: إلزامية من ١ يناير ٢٠٢٧ للشركات بإيرادات ٥٠ مليون درهم فأكثر، ومن ١ يوليو ٢٠٢٧ للشركات الأصغر.',
  'mohre-emiratisation': 'وزارة الموارد البشرية والتوطين: مستهدفات التوطين للشركات الخاصة ومساهمات مالية عن الوظائف غير المشغولة، ومنصة نافس للعثور على مرشحين مواطنين.',
  'abu-dhabi-dmt-estidama': 'دائرة البلديات والنقل في أبوظبي: رخص البناء وتصنيف المقاولين، ونظام استدامة للتقييم باللآلئ (لؤلؤة واحدة على الأقل للمشاريع الخاصة ولؤلؤتان للمشاريع الحكومية).',
  'dubai-bim-mandate': 'إلزام بلدية دبي بنماذج BIM في طلبات التخطيط للمباني التي تتجاوز حدوداً محددة، وللمستشفيات والجامعات وجميع المشاريع الحكومية (بحسب إعلان ٢٠٢٣).',
};

const tierAr: Record<string, string> = { S: 'أسعار منشورة', A: 'مدرج', F: 'تنبيه بشأن السمعة' };
const cats = [
  { key: 'software', label: 'برامج المقاولات والإنشاءات', desc: 'منصات المشاريع ونمذجة معلومات البناء (Oracle وAutodesk وBentley وProcore وPlanRadar)، وأنظمة تخطيط الموارد والمحاسبة (First Bit وFocus Softnet وPACT وSage وZoho)، وأدوات إدارة المرافق والخدمة الميدانية (Horizon FMS وFSM Grid).' },
  { key: 'certification', label: 'التراخيص والامتثال', desc: 'الجهات والأنظمة الإماراتية المدرجة: سجل المقاولين لدى بلدية دبي، ووزارة الطاقة والبنية التحتية، وضريبة القيمة المضافة، والفوترة الإلكترونية (Peppol)، والتوطين (نافس)، ودائرة البلديات والنقل في أبوظبي (استدامة)، وإلزام نمذجة معلومات البناء في دبي.' },
];

const enUrl = new URL('/ae/', Astro.site).toString();
const arUrl = new URL('/ae/ar/', Astro.site).toString();
const pageTitle = 'دليل برامج المقاولات والإنشاءات في الإمارات';
const pageDescription = 'دليل مستقل لبرامج المقاولات والإنشاءات في الإمارات: منصات إدارة المشاريع وأنظمة تخطيط الموارد وأدوات إدارة المرافق، مع جهات الترخيص والامتثال المحلية (بلدية دبي، الضرائب، الفوترة الإلكترونية، التوطين، استدامة).';
---

<Layout
  title={pageTitle}
  description={pageDescription}
  lang="ar"
  dir="rtl"
  alternateUrls={[{ hreflang: 'en', href: enUrl }, { hreflang: 'ar', href: arUrl }, { hreflang: 'x-default', href: enUrl }]}
>
  <article class="mx-auto max-w-5xl px-4 py-12">

    <div class="mb-6 flex items-center justify-between gap-3">
      <div class="flex items-center gap-2">
        <span class="text-2xl" aria-hidden="true">🇦🇪</span>
        <p class="text-sm font-semibold uppercase tracking-wider text-orange-600">الإمارات العربية المتحدة</p>
      </div>
      <a href="/ae/" class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">English</a>
    </div>

    <header class="mb-10">
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">دليل برامج المقاولات والإنشاءات في الإمارات</h1>
      <p class="mt-4 text-lg text-slate-600 leading-relaxed">
        مراجعات مستقلة لـ {vendors.length} إدراجاً ذا صلة بالسوق الإماراتي، منها منصات المشاريع ونمذجة معلومات البناء (Oracle Aconex وOracle Primavera P6 وAutodesk)، وأنظمة تخطيط الموارد والمحاسبة (First Bit وFocus Softnet وPACT وSage وZoho)، وأدوات إدارة المرافق والخدمة الميدانية، مع سياق الامتثال المحلي: بلدية دبي، وضريبة القيمة المضافة، والفوترة الإلكترونية، والتوطين، واستدامة.
      </p>
    </header>

    <section class="mb-10 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-3 text-base font-bold text-slate-900">ما الذي يميّز اختيار البرامج في الإمارات</h2>
      <p class="text-sm text-slate-700 leading-relaxed">
        تؤثر عدة قواعد إماراتية فيما يجب أن يتعامل معه برنامجك. أولاً، <strong>ضريبة القيمة المضافة ٥٪</strong> تديرها الهيئة الاتحادية للضرائب منذ ١ يناير ٢٠١٨، والتسجيل إلزامي عندما تتجاوز التوريدات والواردات الخاضعة للضريبة ٣٧٥ ألف درهم خلال ١٢ شهراً، وتُقدَّم الإقرارات وتُسدَّد الضريبة عبر منصة EmaraTax خلال ٢٨ يوماً من نهاية كل فترة ضريبية، فاضبط الفوترة على ضريبة الإمارات بنسبة ٥٪. ثانياً، تعمل <strong>الفوترة الإلكترونية</strong> بنموذج Peppol اللامركزي عبر مزوّدي خدمة معتمدين: على الشركات التي تبلغ إيراداتها ٥٠ مليون درهم فأكثر تعيين مزوّد بحلول ٣٠ أكتوبر ٢٠٢٦ وبدء التطبيق في ١ يناير ٢٠٢٧، وعلى الشركات الأصغر التعيين بحلول ٣١ مارس ٢٠٢٧ وبدء التطبيق في ١ يوليو ٢٠٢٧. ولا يكفي برنامج قادر على إصدار الفواتير الإلكترونية وحده، بل تحتاج إلى عقد مع مزوّد مدرج في قائمة وزارة المالية. ثالثاً، تضع وزارة الموارد البشرية والتوطين <strong>مستهدفات التوطين</strong> للشركات التي يعمل بها ٥٠ موظفاً فأكثر، وللشركات التي يعمل بها ٢٠ إلى ٤٩ موظفاً في ١٤ قطاعاً، مع مساهمة مالية عن كل وظيفة غير مشغولة، وتوجّه أصحاب العمل إلى منصة <strong>نافس</strong> للعثور على مرشحين مواطنين. رابعاً، تختلف القواعد بين الإمارات: العمل في دبي يتطلب القيد في <strong>سجل المقاولين لدى بلدية دبي</strong> بموجب قانون دبي رقم ٧ لسنة ٢٠٢٥، بينما تتولى <strong>دائرة البلديات والنقل</strong> في أبوظبي تصنيف المقاولين ورخص البناء التي تشترط تصنيف <strong>استدامة</strong> بلؤلؤة واحدة على الأقل (ولؤلؤتين للمشاريع الممولة حكومياً). كما أعلنت بلدية دبي أنها اعتباراً من ١ يناير ٢٠٢٤ لن تقبل طلبات التخطيط للمباني التي تتجاوز حدوداً محددة، ولا للمستشفيات والجامعات وجميع المشاريع الحكومية، إلا مع <strong>نموذج BIM</strong> (بحسب Global Construction Review).
      </p>
    </section>

    {cats.map((cat) => {
      const cv = vendors.filter((v) => v.category === cat.key);
      if (cv.length === 0) return null;
      return (
        <section class="mb-12">
          <div class="mb-5">
            <h2 class="text-2xl font-bold text-slate-900">{cat.label}</h2>
            <p class="mt-1 text-sm text-slate-600 leading-relaxed">{cat.desc}</p>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            {cv.map((v) => {
              const isCert = v.category === 'certification';
              const tierColor = v.tier === 'S' ? 'border-emerald-300' : v.tier === 'F' ? 'border-rose-300' : 'border-blue-300';
              const tierBadge = v.tier === 'S' ? 'bg-emerald-100 text-emerald-900' : v.tier === 'F' ? 'bg-rose-100 text-rose-900' : 'bg-blue-100 text-blue-900';
              const label = isCert ? 'جهة رسمية' : tierAr[v.tier];
              return (
                <article class={`rounded-lg border-2 ${tierColor} bg-white p-4`}>
                  <div class="mb-1 flex items-center gap-2 flex-wrap">
                    <h3 class="text-lg font-bold text-slate-900">{v.name}</h3>
                    <span class={`rounded-full px-2 py-0.5 text-xs font-bold ${tierBadge}`}>{label}</span>
                  </div>
                  <p class="text-sm text-slate-700 leading-relaxed">{ar[v.slug] ?? v.tagline}</p>
                  <div class="mt-3 flex flex-wrap gap-2">
                    <a href={`/ae/${v.slug}/`} class="rounded-md bg-slate-900 px-3 py-1.5 text-xs font-semibold text-white hover:bg-slate-700">التفاصيل (بالإنجليزية) ←</a>
                    <a href={v.vendor_url} rel="sponsored nofollow noopener" target="_blank" class="rounded-md bg-orange-500 px-3 py-1.5 text-xs font-semibold text-white hover:bg-orange-600">{isCert ? 'الموقع الرسمي' : 'زيارة الموقع'} ←</a>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      );
    })}

    <section class="mb-10 rounded-lg border border-slate-200 bg-white p-5 text-sm text-slate-600">
      <p>المراجعات التفصيلية لكل إدراج متاحة <a href="/ae/" class="font-medium text-orange-600 hover:underline">بالإنجليزية</a>، ويعرض الدليل الإنجليزي أيضاً شركات التأمين ومنصة معلومات المشاريع ProTenders.</p>
    </section>

    <section class="rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">هل أنت مزوّد برامج إماراتي؟</h2>
      <p class="mt-2 text-slate-300 leading-relaxed">إذا كنت تطوّر برامج للمقاولات أو تخطيط الموارد أو الخدمة الميدانية للسوق الإماراتي/الخليجي وترغب في المراجعة أو الإدراج، تواصل معنا عبر <a href="/for-vendors/" class="underline">برنامج المزوّدين</a>.</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/for-vendors/" class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600">العمل معنا ←</a>
        <a href="/ae/" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">English directory</a>
      </div>
    </section>
  </article>
</Layout>
