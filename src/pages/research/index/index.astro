---
import Layout from '../../../layouts/Layout.astro';
import { tools, medianUsd, leadGenPlatforms, insuranceProviders, payrollServices, marketingAgencies, paymentProcessors, financingProviders, accountingSoftware, bankingProviders, aiTools, verticals, reputationFlagGroups, totalReputationFlags, usVendorLists, isQuoteOnly, hasFreeTier, quoteOnlyCount } from '../../../lib/data';

// Computed live from directory data: every stat is reproducible from our published methodology
const totalTools = tools.length;
const phase2Tools = tools.filter(t => 'long_description' in t && t.long_description).length;
// Quote-only is pricing_model 'quote_only', not a null starting price: Trash Flow
// and Pylon have no monthly starting price but publish one-time or per-project
// prices (2026-10-01; this page said 51, the right count was 49).
const customQuotedTools = quoteOnlyCount();
const customQuotedPct = Math.round((customQuotedTools / totalTools) * 100);
const freeTierTools = tools.filter(hasFreeTier).length;
// Tools that publish prices but no monthly starting price (one-time or per-project).
const otherPricedTools = tools.filter(t => !isQuoteOnly(t) && t.pricing.starting_at_usd === null).length;
const freeTrialTools = tools.filter(t => (t.pricing.free_trial_days ?? 0) > 0).length;
const freeTrialPct = Math.round((freeTrialTools / totalTools) * 100);
const trial14or30 = tools.filter(t => t.pricing.free_trial_days === 14 || t.pricing.free_trial_days === 30).length;
// Paid entry prices only. This page previously included the $0 free-tier tools and
// took the upper-middle value, publishing a $59 "median" against the $79 on
// /trends-2026/. Both were wrong; the shared helper gives $77 on the same basis
// every other page now uses. (2026-08-30)
const avgPriceTools = tools.filter(t => t.pricing.starting_at_usd !== null && t.pricing.starting_at_usd > 0);
const medianPrice = medianUsd(avgPriceTools.map(t => t.pricing.starting_at_usd!));
const quickbooksIntegrated = tools.filter(t => t.integrations.some(i => i.includes('quickbooks'))).length;
const quickbooksPct = Math.round((quickbooksIntegrated / totalTools) * 100);
const stripeIntegrated = tools.filter(t => t.integrations.some(i => i.includes('stripe'))).length;
const stripePct = Math.round((stripeIntegrated / totalTools) * 100);
// Share of the tools whose founding year is known, not of all tools: the year is
// null where it is not published, and counting those as "before 2015" understated it.
const foundedKnown = tools.filter(t => t.founded).length;
const modernCohort = tools.filter(t => t.founded && t.founded >= 2015).length;
const modernPct = Math.round((modernCohort / foundedKnown) * 100);

// Reputation flags across the FULL adjacent-category stack (9 categories beyond FSM)
const flaggedIn = (arr: readonly any[]) => arr.filter((x) => x && x.reputation_flag).length;
const adjacentCats = [
  { name: 'Lead generation', items: leadGenPlatforms },
  { name: 'Financing', items: financingProviders },
  { name: 'Business banking', items: bankingProviders },
  { name: 'Payments', items: paymentProcessors },
  { name: 'Marketing agencies', items: marketingAgencies },
  { name: 'Insurance', items: insuranceProviders },
  { name: 'Accounting', items: accountingSoftware },
  { name: 'Payroll', items: payrollServices },
  { name: 'AI tools', items: aiTools },
];
const leadGenWithFlags = flaggedIn(leadGenPlatforms);
const leadGenFlagPct = Math.round((leadGenWithFlags / leadGenPlatforms.length) * 100);
const insuranceWithFlags = flaggedIn(insuranceProviders);
const agencyWithFlags = flaggedIn(marketingAgencies);
// The total and the per-category counts come from the same helper as
// /reputation-flags/, so the two pages cannot disagree.
const totalFlags = totalReputationFlags();
const totalReputationVendors = adjacentCats.reduce((s, c) => s + c.items.length, 0);
const totalFlagPct = Math.round((totalFlags / totalReputationVendors) * 100);
const lowerFirst = (s: string) => (s.startsWith('AI') ? s : s.charAt(0).toLowerCase() + s.slice(1));
const flagBreakdown = [...reputationFlagGroups()]
  .sort((a, b) => b.entries.length - a.entries.length)
  .map((g) => `${lowerFirst(g.category)} ${g.entries.length}`)
  .join(', ');

// Most recent verified_date in the US data files: the date the figures below
// are current to (they are computed from those files at build time).
const dataAsOf = [
  ...tools.map(t => t.pricing.verified_date),
  ...adjacentCats.flatMap((c) => (c.items as any[]).map((x) => x.verified_date)),
].filter((d): d is string => !!d).sort().pop() ?? '';

// International footprint
const intlModules = import.meta.glob('../../../data/international/*.json', { eager: true });
const intlMarkets = Object.keys(intlModules).length;
const intlVendorCount = Object.values(intlModules).reduce((s: number, m: any) => s + (m.default?.vendors?.length ?? m.vendors?.length ?? 0), 0);

const totalCategories = usVendorLists().length;
const totalVendors = totalTools + adjacentCats.reduce((s, c) => s + c.items.length, 0);

const pageTitle = 'WrenchStack Index 2026: Trades Vendor Benchmarks';
const pageDescription = `Data benchmark across WrenchStack's ${totalCategories} US trades-vendor categories and ${intlMarkets} international markets. Software pricing distribution, reputation-flag counts by category, and multi-market coverage. Citable headline stats.`;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Research', url: '/research/' },
  { name: 'WrenchStack Index 2026', url: '/research/index/' },
];

// Not a quarter label: every figure recomputes from the data on each build, so
// the edition is the year and citations carry the data date (2026-10-01).
const edition = '2026';
// Local (UTC+3) dates of the pushes that deployed the page (8e3c56d, pushed
// 2026-05-28 02:21) and the expansion (b872ea6, pushed 2026-06-19 02:28), per
// the remote-ref log. The page said 2026-05-29 until 2026-10-01. The research
// hub (src/pages/research/index.astro, pubDate of this entry) must show the same date.
const publishDate = '2026-05-28';
const updatedDate = '2026-06-19';
---

<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>
  <article class="mx-auto max-w-4xl px-4 py-12">

    <header class="mb-10">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-orange-600">WrenchStack Index · {edition}</p>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">
        WrenchStack Index {edition}
      </h1>
      <p class="mt-4 text-lg text-slate-600 leading-relaxed">
        Benchmarks computed from WrenchStack's directory of vendors for trades contractors: {totalVendors} US vendors across {totalCategories} categories, plus {intlVendorCount} localized listings across {intlMarkets} international markets. Every stat is computed from the WrenchStack directory data when the site is built; the <a href="/methodology/" class="text-orange-600 hover:underline">methodology</a> explains how entries are sourced and verified.
      </p>
      <p class="mt-2 text-sm text-slate-500">Published {publishDate} · Expanded to 10 categories + international {updatedDate} · Figures computed from the directory data as of {dataAsOf}</p>
    </header>

    <section class="mb-10 grid grid-cols-2 gap-3 sm:grid-cols-4">
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-3xl font-bold text-slate-900">{totalVendors}</div>
        <div class="mt-1 text-xs text-slate-600">US vendors</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-3xl font-bold text-slate-900">{totalCategories}</div>
        <div class="mt-1 text-xs text-slate-600">Categories</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-3xl font-bold text-slate-900">{intlMarkets}</div>
        <div class="mt-1 text-xs text-slate-600">Intl. markets ({intlVendorCount} listings)</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-3xl font-bold text-slate-900">{totalFlags}</div>
        <div class="mt-1 text-xs text-slate-600">Reputation-flagged</div>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="mb-5 text-2xl font-bold text-slate-900">Software pricing & structure</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="rounded-lg border-2 border-slate-200 bg-white p-5">
          <div class="text-4xl font-bold text-slate-900">{customQuotedPct}%</div>
          <p class="mt-2 text-sm text-slate-700 leading-relaxed">
            of the trades software platforms in WrenchStack's directory publish no price and quote on request ({customQuotedTools} of {totalTools} platforms). The remaining {100 - customQuotedPct}% publish at least one price.
          </p>
        </div>
        <div class="rounded-lg border-2 border-slate-200 bg-white p-5">
          <div class="text-4xl font-bold text-slate-900">${medianPrice}/mo</div>
          <p class="mt-2 text-sm text-slate-700 leading-relaxed">
            is the median paid starting price among the {avgPriceTools.length} platforms that publish one in WrenchStack's {totalTools}-tool directory. Left out of the median: {freeTierTools} that start on a free plan{otherPricedTools > 0 && ` and ${otherPricedTools} that publish only one-time or per-project prices`}.
          </p>
        </div>
        <div class="rounded-lg border-2 border-slate-200 bg-white p-5">
          <div class="text-4xl font-bold text-slate-900">{freeTrialPct}%</div>
          <p class="mt-2 text-sm text-slate-700 leading-relaxed">
            of the trades software platforms in WrenchStack's directory offer a free trial ({freeTrialTools} of {totalTools} platforms). {trial14or30} of those trials run 14 or 30 days.
          </p>
        </div>
        <div class="rounded-lg border-2 border-slate-200 bg-white p-5">
          <div class="text-4xl font-bold text-slate-900">{modernPct}%</div>
          <p class="mt-2 text-sm text-slate-700 leading-relaxed">
            of the {foundedKnown} trades software platforms in WrenchStack with a published founding year were founded in 2015 or later ({modernCohort} platforms).
          </p>
        </div>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="mb-5 text-2xl font-bold text-slate-900">Integration prevalence</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="rounded-lg border-2 border-slate-200 bg-white p-5">
          <div class="text-4xl font-bold text-slate-900">{quickbooksPct}%</div>
          <p class="mt-2 text-sm text-slate-700 leading-relaxed">
            of the trades software platforms in WrenchStack's directory list a QuickBooks integration ({quickbooksIntegrated} of {totalTools}).
          </p>
        </div>
        <div class="rounded-lg border-2 border-slate-200 bg-white p-5">
          <div class="text-4xl font-bold text-slate-900">{stripePct}%</div>
          <p class="mt-2 text-sm text-slate-700 leading-relaxed">
            of the trades software platforms in WrenchStack's directory list a Stripe integration ({stripeIntegrated} of {totalTools}).
          </p>
        </div>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="mb-5 text-2xl font-bold text-slate-900">Reputation patterns across categories</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="rounded-lg border-2 border-rose-200 bg-rose-50 p-5">
          <div class="text-4xl font-bold text-rose-900">{leadGenFlagPct}%</div>
          <p class="mt-2 text-sm text-rose-900 leading-relaxed">
            of lead-generation platforms WrenchStack covers carry a reputation warning ({leadGenWithFlags} of {leadGenPlatforms.length}). The source for each one is on the <a href="/reputation-flags/" class="underline">reputation ledger</a>.
          </p>
        </div>
        <div class="rounded-lg border-2 border-rose-200 bg-rose-50 p-5">
          <div class="text-4xl font-bold text-rose-900">{totalFlags}</div>
          <p class="mt-2 text-sm text-rose-900 leading-relaxed">
            vendors across the full adjacent-category stack (lead-gen, financing, banking, payments, insurance, accounting, payroll, marketing, AI) carry a documented reputation warning: {totalFlagPct}% of {totalReputationVendors} vendors. By category, largest count first: {flagBreakdown}. We publish the specific reason on every one.
          </p>
        </div>
        <div class="rounded-lg border-2 border-slate-200 bg-white p-5">
          <div class="text-4xl font-bold text-slate-900">{insuranceProviders.length}</div>
          <p class="mt-2 text-sm text-slate-700 leading-relaxed">
            insurance providers covered, {insuranceProviders.filter(p => p.distribution_model === 'agent-only').length} of which sell through agents, brokers or partner platforms rather than direct.
          </p>
        </div>
        <div class="rounded-lg border-2 border-slate-200 bg-white p-5">
          <div class="text-4xl font-bold text-slate-900">{marketingAgencies.length}</div>
          <p class="mt-2 text-sm text-slate-700 leading-relaxed">
            marketing agencies covered: {marketingAgencies.filter(a => a.agency_type === 'trade-specific').length} trade-specific specialists, {agencyWithFlags} with a documented reputation warning.
          </p>
        </div>
      </div>
    </section>

    <section class="mb-10 rounded-lg border-2 border-slate-200 bg-white p-6">
      <h2 class="mb-3 text-lg font-bold text-slate-900">Citation guidance</h2>
      <p class="text-sm text-slate-700 leading-relaxed">
        When citing WrenchStack Index data, please use this format:
      </p>
      <div class="mt-3 rounded-md bg-slate-50 px-4 py-3 font-mono text-sm text-slate-800">
        WrenchStack Index {edition}, data as of {dataAsOf}. WrenchStack Research. https://wrenchstack.com/research/index/
      </div>
      <p class="mt-3 text-sm text-slate-700">
        For written quotes or a custom segment (e.g., "what % of HVAC-specific platforms integrate with QuickBooks"), email <a href="mailto:press@wrenchstack.com" class="text-orange-600 hover:underline">press@wrenchstack.com</a>.
      </p>
    </section>

    <section class="mb-10 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-3 text-lg font-bold text-slate-900">Methodology notes</h2>
      <p class="text-sm text-slate-700 leading-relaxed mb-3">
        WrenchStack Index stats are counts, shares and medians computed from the public WrenchStack directory data each time the site is built. None of them uses the Fit Score, which ranks software on the trade pages. Each US entry carries the date it was last checked against primary sources: see the <a href="/methodology/" class="text-orange-600 hover:underline">methodology</a> and the <a href="/verification-log/" class="text-orange-600 hover:underline">verification log</a>.
      </p>
      <ul class="space-y-1 text-sm text-slate-700">
        <li>• <strong>Sample size:</strong> All {totalVendors} US vendors across {totalCategories} categories, plus {intlVendorCount} localized listings across {intlMarkets} international markets, as of {dataAsOf}</li>
        <li>• <strong>Geographic scope:</strong> United States plus {intlMarkets} international markets: UK, Ireland, Canada, Australia, New Zealand, the six Gulf states (Saudi Arabia, UAE, Qatar, Kuwait, Bahrain, Oman), Egypt, Jordan, Morocco, France, Malaysia and South Africa</li>
        <li>• <strong>Refresh cadence:</strong> Figures recompute from the directory data on every site build</li>
        <li>• <strong>Data freshness:</strong> Each US vendor page shows the date its entry was last verified</li>
        <li>• <strong>Reproducibility:</strong> Every stat is a count, share or median over the directory entries; none is sampled or estimated</li>
      </ul>
    </section>

    <section class="rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">More research</h2>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/trends-2026/" class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600">2026 Market Report →</a>
        <a href="/awards/2026/" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">2026 Awards</a>
        <a href="/research/" class="rounded-md border border-white/30 bg-white/10 px-5 py-3 text-sm font-semibold text-white hover:bg-white/20">All research</a>
        <a href="/press/" class="rounded-md border border-white/30 bg-white/10 px-5 py-3 text-sm font-semibold text-white hover:bg-white/20">Press room</a>
      </div>
    </section>
  </article>
</Layout>
