---
import Layout from '../../layouts/Layout.astro';
import { EN_MARKET_HREFLANG } from '../../lib/intl';
import myData from '../../data/international/my.json';

interface MyVendor {
  slug: string; name: string; category: string; vendor_url: string;
  tagline: string; market_position: string; my_specific_note?: string | null;
  tier: 'S' | 'A' | 'F'; reputation_flag: string | null;
  pros: string[]; cons: string[]; typical_pricing: string;
  is_cross_market: boolean; cross_market_link: string | null;
}

const vendors = (myData as { vendors: MyVendor[] }).vendors;
const categories = ['software', 'lead-gen', 'insurance', 'payroll', 'certification'];
const categoryMeta: Record<string, { label: string; description: string }> = {
  'software': { label: 'Accounting / invoicing & construction software', description: 'Accounting products that say they handle LHDN MyInvois e-invoices: AutoCount and SQL Account (desktop or cloud), the cloud products Bukku (with a free invoicing plan for new companies), Financio and Biztory, and UBS, formerly Sage UBS and now sold as Access UBS Evo by The Access Group. For construction, BuildSpace covers tendering, estimating and progress evaluation, and IFCA (listed on Bursa Malaysia) covers progress claims and property development; Cubicost by Glodon and RIB CostX are takeoff and estimating tools; Globe3 and HashMicro are ERPs with construction modules.' },
  'lead-gen': { label: 'Tenders & home services', description: 'The federal government’s official online procurement system for goods and services (ePerolehan), tender notices posted by the construction regulator CIDB, a subscription search and alert service for government agency tenders with past award records on its Pro plan (Tenderpanel), and a home-services marketplace where customers get quotes from vetted pros, including renovation firms (Recommend.my).' },
  'insurance': { label: 'Construction insurance: Contractor’s All Risks', description: 'Contractors’ All Risks (CAR) cover from general insurers in Malaysia, with combined CAR/EAR (Erection All Risks) products from Zurich and Tokio Marine: Allianz General Malaysia (Allianz Group), Lonpac (LPI Capital group), Tokio Marine Malaysia and MSIG Malaysia (both part of Japanese insurance groups) and Zurich General Malaysia, whose sister company sells Shariah-compliant Takaful versions. MSIG’s current website has no CAR page. All five are quote-based, with no published premium rates.' },
  'payroll': { label: 'Payroll: EPF, SOCSO, EIS, PCB & HRDF', description: 'Payroll software for Malaysian statutory deductions (EPF/KWSP, SOCSO/PERKESO, EIS and PCB/MTD); SQL Payroll, Talenox and BrioHR also state HRDF levy handling. All five are on LHDN’s list of payroll software whose PCB (MTD) calculation meets its specification: SQL Payroll, AutoCount Cloud Payroll (now branded AutoCount HRMS), Talenox, Kakitangan.com and BrioHR.' },
  'certification': { label: 'Compliance & official bodies', description: 'The official bodies a Malaysian contractor deals with: SSM for business or company registration, LHDN for tax registration, PCB and MyInvois, CIDB for contractor registration (G1-G7) and the Green Card for site personnel under Act 520, the Board of Engineers (BEM) where a job needs engineering submissions, and employer registration with EPF, SOCSO/PERKESO and, at 10 or more employees in a covered industry, HRD Corp.' },
};
const vendorsByCategory: Record<string, MyVendor[]> = {};
categories.forEach(c => { vendorsByCategory[c] = vendors.filter(v => v.category === c); });

const pageTitle = 'Malaysia Construction & Trades Software (MyInvois) | WrenchStack';
const pageDescription = `Independent directory of ${vendors.length} vendors for Malaysia: MyInvois-ready accounting/invoicing software, construction and takeoff software, government tender access, EPF/SOCSO payroll, and Contractor's All Risks insurance, plus the MyInvois e-invoicing mandate (LHDN/IRBM; construction's no-consolidation rule and the relaxation to 2027), CIDB G1-G7 grading and the official registrations contractors deal with.`;
const breadcrumbs = [ { name: 'Home', url: '/' }, { name: 'Malaysia', url: '/my/' } ];
---
<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs} alternateUrls={EN_MARKET_HREFLANG}>
  <article class="mx-auto max-w-5xl px-4 py-12">
    <header class="mb-10">
      <div class="mb-3 flex items-center gap-2">
        <span class="text-2xl" aria-hidden="true">🇲🇾</span>
        <p class="text-sm font-semibold uppercase tracking-wider text-orange-600">Malaysia</p>
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">Malaysia Construction & Trades Software Directory</h1>
      <p class="mt-4 text-lg text-slate-600 leading-relaxed">
        Independent reviews of {vendors.length} Malaysia-relevant vendors, organised around <strong>MyInvois</strong>, the national e-invoicing system run by LHDN/IRBM: accounting tools that say they submit e-invoices to LHDN (AutoCount, SQL Account, Bukku and others), construction software for tendering, progress evaluation and progress claims (BuildSpace, IFCA), EPF/SOCSO payroll and Contractor’s All Risks insurance, with the local context: the Ringgit, 6% SST on construction services, CIDB G1-G7 grading and the Green Card.
      </p>
    </header>

    <section class="mb-10 grid gap-3 grid-cols-2 sm:grid-cols-4">
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">{vendors.length}</div>
        <div class="mt-1 text-xs text-slate-600">vendors reviewed</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">G1-G7</div>
        <div class="mt-1 text-xs text-slate-600">CIDB contractor grades</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">RM3m</div>
        <div class="mt-1 text-xs text-slate-600">MyInvois exemption threshold</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">6%</div>
        <div class="mt-1 text-xs text-slate-600">SST on construction services</div>
      </div>
    </section>

    <section class="mb-10 flex flex-wrap items-center justify-between gap-4 rounded-lg border-2 border-emerald-300 bg-emerald-50 p-5">
      <div class="min-w-0 flex-1">
        <p class="text-xs font-bold uppercase tracking-wider text-emerald-700">⏰ Compliance guide · MyInvois e-invoicing is LIVE (LHDN/IRBM) · construction has a special rule</p>
        <h2 class="mt-1 text-base font-bold text-slate-900">MyInvois e-invoicing for Malaysian contractors</h2>
        <p class="mt-1 text-sm text-slate-700">Construction is a “no-consolidation” industry, but the interim relaxation lets ≤RM5m contractors keep batching progress claims until 31 Dec 2027. The phases, the RM3m exemption threshold, the RM10k rule, and which tools say they submit to LHDN.</p>
      </div>
      <a href="/my/guides/myinvois-e-invoicing/" class="shrink-0 rounded-md bg-emerald-700 px-5 py-3 text-sm font-semibold text-white hover:bg-emerald-800">Read the guide →</a>
    </section>

    <section class="mb-10 flex flex-wrap items-center justify-between gap-4 rounded-lg border border-orange-200 bg-orange-50 p-5">
      <div>
        <h2 class="text-base font-bold text-slate-900">Deciding between two options?</h2>
        <p class="mt-1 text-sm text-slate-700">See Malaysian vendors compared side by side: a clear verdict, pros and cons, Malaysia-specific notes, and pricing, head to head.</p>
      </div>
      <a href="/my/compare/" class="shrink-0 rounded-md bg-slate-900 px-5 py-3 text-sm font-semibold text-white hover:bg-slate-700">Compare Malaysian vendors →</a>
    </section>

    <section class="mb-10 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-3 text-base font-bold text-slate-900">What’s different about choosing software in Malaysia</h2>
      <p class="text-sm text-slate-700 leading-relaxed">
        Start with <strong>MyInvois</strong>, the e-invoicing system run by LHDN/IRBM. It’s live and phasing in by turnover (largest firms since August 2024; businesses up to <strong>RM5m</strong> from January 2026), and since LHDN's August 2026 guideline, businesses with turnover under <strong>RM3m</strong> are exempt unless they belong to a larger group. You submit structured XML/JSON through the MyInvois portal or an API, IRBM validates in near real-time and returns a <strong>UIN and a QR code</strong>. The construction point needs care: construction <em>is</em> on the official <strong>“no-consolidation” list</strong>, meaning each progress claim should in principle be e-invoiced individually, <strong>but</strong> the interim relaxation (§16.2) expressly lets every business, construction included, keep issuing consolidated e-invoices through the grace window, which for firms up to <strong>RM5m runs to 31 December 2027</strong>. So contractors up to RM5m that meet the relaxation’s conditions are not yet forced into per-claim invoicing; larger ones already are. Beyond that: the second-order rule that <strong>any single transaction over RM10,000</strong> needs its own e-invoice, a new <strong>6% SST on construction services</strong> (since July 2025; residential and government work exempt), and the CIDB layer (Act 520 requires every contractor to register with CIDB, in grades <strong>G1 to G7</strong>, and every site worker, supervisor and project manager needs a <strong>Green Card</strong>). The general accounting tools listed here are not construction-specific; for construction work, BuildSpace covers tendering, estimating and progress evaluation, IFCA’s ContractX covers progress claims, variation orders and retention, and HashMicro and Globe3 add construction modules to a full ERP.
      </p>
    </section>

    {categories.map(c => {
      const cat = categoryMeta[c];
      const cv = vendorsByCategory[c];
      if (cv.length === 0) return null;
      return (
        <section class="mb-12">
          <div class="mb-5">
            <h2 class="text-2xl font-bold text-slate-900">{cat.label}</h2>
            <p class="mt-1 text-sm text-slate-600 leading-relaxed">{cat.description}</p>
          </div>
          <div class="space-y-4">
            {cv.map(v => {
              const isCert = v.category === 'certification';
              const tierColor = v.tier === 'S' ? 'border-emerald-300' : v.tier === 'F' ? 'border-rose-300' : 'border-blue-300';
              const tierLabel = isCert ? 'Official body / regime' : v.tier === 'S' ? 'Published prices' : v.tier === 'F' ? 'Reputation warning' : 'Listed';
              const tierBadge = v.tier === 'S' ? 'bg-emerald-100 text-emerald-900' : v.tier === 'F' ? 'bg-rose-100 text-rose-900' : 'bg-blue-100 text-blue-900';
              return (
                <article class={`rounded-lg border-2 ${tierColor} bg-white p-5`}>
                  <div class="mb-3 flex items-start justify-between gap-3">
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-2 mb-1 flex-wrap">
                        <h3 class="text-xl font-bold text-slate-900">{v.name}</h3>
                        <span class={`rounded-full px-2 py-0.5 text-xs font-bold ${tierBadge}`}>{isCert ? tierLabel : `Tier ${v.tier} · ${tierLabel}`}</span>
                        </div>
                      <p class="text-sm italic text-slate-500">{v.tagline}</p>
                    </div>
                  </div>
                  <p class="mb-3 text-sm text-slate-700 leading-relaxed">{v.market_position}</p>
                  {v.reputation_flag && (
                    <div class="mb-3 rounded-md border-l-4 border-amber-400 bg-amber-50 px-4 py-2">
                      <p class="text-sm text-amber-900 leading-relaxed"><strong>Heads up:</strong> {v.reputation_flag}</p>
                    </div>
                  )}
                  {v.my_specific_note && (
                    <div class="mb-3 rounded-md bg-slate-50 px-4 py-3">
                      <p class="text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Malaysia-specific note</p>
                      <p class="text-sm text-slate-700 leading-relaxed">{v.my_specific_note}</p>
                    </div>
                  )}
                  <div class="mb-3 grid gap-3 sm:grid-cols-2">
                    <div>
                      <p class="text-xs font-bold uppercase tracking-wider text-emerald-700 mb-1">{isCert ? 'What it covers' : 'Pros'}</p>
                      <ul class="space-y-1 text-sm text-slate-700">{v.pros.slice(0, 4).map(p => <li class="leading-snug">+ {p}</li>)}</ul>
                    </div>
                    <div>
                      <p class="text-xs font-bold uppercase tracking-wider text-rose-700 mb-1">{isCert ? 'Watch out for' : 'Cons'}</p>
                      <ul class="space-y-1 text-sm text-slate-700">{v.cons.slice(0, 4).map(con => <li class="leading-snug">− {con}</li>)}</ul>
                    </div>
                  </div>
                  <div class="mb-3 text-xs text-slate-600"><strong class="text-slate-900">{isCert ? 'Cost / access:' : 'Typical Malaysia pricing:'}</strong> {v.typical_pricing}</div>
                  <div class="flex flex-wrap gap-2">
                    <a href={`/my/${v.slug}/`} class="rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700">Full Malaysia review →</a>
                    <a href={v.vendor_url} rel="sponsored nofollow noopener" target="_blank" class="rounded-md bg-orange-500 px-4 py-2 text-sm font-semibold text-white hover:bg-orange-600">{isCert ? 'Official site' : `Visit ${v.name}`} →</a>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      );
    })}

    <section class="mt-12 rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">Are you a Malaysian software vendor?</h2>
      <p class="mt-2 text-slate-300 leading-relaxed">If you build software or services for Malaysian contractors and the building trades and want to be reviewed or featured, get in touch through our <a href="/for-vendors/" class="underline">vendor program</a>.</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/for-vendors/" class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600">Work with us →</a>
        <a href="/software-by-country/" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">Software by country →</a>
        <a href="/methodology/" class="rounded-md border border-white/30 bg-white/10 px-5 py-3 text-sm font-semibold text-white hover:bg-white/20">Methodology</a>
      </div>
    </section>
  </article>
</Layout>
