---
import Layout from '../../layouts/Layout.astro';
import VendorLogo from '../../components/VendorLogo.astro';
import { payrollServices, payrollTier, type PayrollService } from '../../lib/data';
import MissingFromList from '../../components/MissingFromList.astro';

const pageTitle = `Best Payroll Software for Trades Contractors (2026)`;
const pageDescription = `Independent reviews of ${payrollServices.length} payroll services for HVAC, plumbing, electrical, roofing and other trades: Gusto, OnPay, Patriot, Hourly.io (payroll with pay-as-you-go workers' comp), QuickBooks Payroll, construction payroll such as Fingercheck and Miter, and more, with published prices where vendors list them.`;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Payroll', url: '/payroll/' },
];

const tierOrder: Array<'S' | 'A' | 'B'> = ['S', 'A', 'B'];
const byTier: Record<'S' | 'A' | 'B', PayrollService[]> = { S: [], A: [], B: [] };
for (const s of payrollServices) byTier[payrollTier(s)].push(s);

const tierMeta = {
  S: { label: 'Tier S: online or specialty payroll with a published price, no warning', description: `Online payroll services and trades-specialty payroll with no reputation warning whose vendors publish a starting price, so you can compare costs before a sales call: Gusto from $49/mo plus $6 per person, OnPay at $49/mo plus $6 per person on one plan, Patriot from $17/mo plus $4 per worker if you file taxes yourself, SurePayroll at $29/mo plus $7 per worker, Roll by ADP at $39/mo plus $5 per worker, Auris (formerly Heartland Payroll) with bundles from $89/mo, Hourly.io from $80/mo plus $12 per active user with pay-as-you-go workers' comp, and Fingercheck from $79/mo plus $10 per employee with certified payroll reports. The tier does not rank them against each other.`, badgeColor: 'bg-emerald-100 text-emerald-900 ring-emerald-300', cardBorder: 'border-emerald-300' },
  A: { label: 'Tier A: no warning; built-in payroll, HR suite or no published US price', description: `No reputation warning, not legacy payroll or a PEO, and outside the Tier S rule. That covers payroll built into other software (QuickBooks Payroll, Square Payroll), HR and team-management platforms with payroll (Rippling, Homebase, Paycor, Paylocity, Arcoro), construction payroll sold by quote (eBacon, Payroll4Construction, Miter), and Wagepoint, which serves Canada only and whose pricing page does not label the currency. Which one fits depends on the software you already use and the work you do.`, badgeColor: 'bg-blue-100 text-blue-900 ring-blue-300', cardBorder: 'border-blue-300' },
  B: { label: 'Tier B: legacy, PEO or reputation warning', description: 'Legacy payroll (ADP Run, priced by quote, and Paychex Flex), PEOs that co-employ your staff to bundle payroll, benefits and workers\' comp (Justworks, TriNet), and services with a reputation warning (Wave Payroll, Paycom). Read the warning on each flagged card before you sign up.', badgeColor: 'bg-amber-100 text-amber-900 ring-amber-300', cardBorder: 'border-amber-300' },
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Payroll Services for Trades Contractors',
  numberOfItems: payrollServices.length,
  itemListElement: payrollServices.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'SoftwareApplication',
      name: s.name,
      description: s.tagline,
      url: `https://wrenchstack.com/payroll/${s.slug}/`,
    },
  })),
};
---

<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  <article class="mx-auto max-w-5xl px-4 py-12">
    <header class="mb-10">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-orange-600">Payroll</p>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">
        Best Payroll Software for Trades Contractors (2026)
      </h1>
      <p class="mt-4 text-lg text-slate-600 leading-relaxed">
        Independent reviews of {payrollServices.length} payroll services for trades contractors, with prices taken from each vendor's published pricing where it has one. OnPay sells one plan at $49/mo plus $6 per person, Gusto starts at $49/mo plus $6 per person on its one-state Simple plan, and Patriot starts at $17/mo plus $4 per worker if you file taxes yourself. Hourly.io pairs payroll with pay-as-you-go workers' comp, and Fingercheck, eBacon, Payroll4Construction, Miter and Arcoro describe certified payroll reporting for prevailing-wage work. ADP Run, Rippling, Paylocity and Paycom sell by quote.
      </p>
    </header>

    <section class="mb-10 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-3 text-base font-bold text-slate-900">The headline filter: company size</h2>
      <p class="text-sm text-slate-700 leading-relaxed">
        For certified, union or prevailing-wage work, look at the services that describe certified payroll reporting: Fingercheck, eBacon, Payroll4Construction, Miter and Arcoro. For other payroll, use these <strong>company-size guides</strong> to compare services for your headcount:
      </p>
      <div class="mt-4 grid gap-2 sm:grid-cols-3">
        <a href="/payroll/by-size/1-5-employees/" class="block rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 no-underline hover:border-orange-400 hover:bg-orange-50 hover:text-orange-700">1-5 employees →</a>
        <a href="/payroll/by-size/6-20-employees/" class="block rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 no-underline hover:border-orange-400 hover:bg-orange-50 hover:text-orange-700">6-20 employees →</a>
        <a href="/payroll/by-size/20-plus-employees/" class="block rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 no-underline hover:border-orange-400 hover:bg-orange-50 hover:text-orange-700">20+ employees →</a>
      </div>
    </section>

    {tierOrder.map((tier) => {
      const services = byTier[tier];
      if (services.length === 0) return null;
      const meta = tierMeta[tier];
      return (
        <section class="mb-12">
          <div class="mb-5">
            <span class={`inline-block rounded-full px-3 py-1 text-xs font-bold ring-1 ${meta.badgeColor}`}>{meta.label}</span>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">{meta.description}</p>
          </div>

          <div class="space-y-4">
            {services.map((s) => (
              <article class={`rounded-lg border-2 ${meta.cardBorder} bg-white p-5`}>
                <div class="mb-3 flex items-start justify-between gap-3">
                  <div class="flex min-w-0 flex-1 items-center gap-3">
                    <VendorLogo name={s.name} url={s.vendor_url} size={40} />
                    <div class="min-w-0">
                      <h3 class="text-xl font-bold text-slate-900">
                        <a href={`/payroll/${s.slug}/`} class="hover:text-orange-600">{s.name}</a>
                      </h3>
                      <p class="text-sm italic text-slate-500">{s.tagline}</p>
                    </div>
                  </div>
                  <div class="shrink-0 text-right text-xs">
                    <p class="font-bold text-slate-900 uppercase tracking-wider">{s.service_type.replace(/-/g, ' ')}</p>
                    <p class="text-slate-500">{s.pricing_summary.split(';')[0].trim()}</p>
                  </div>
                </div>

                {s.reputation_flag && (
                  <div class="mb-3 rounded-md border-l-4 border-rose-500 bg-rose-50 px-4 py-3 text-sm text-rose-900">
                    <p class="font-bold uppercase tracking-wider text-xs text-rose-700 mb-1">⚠ Reputation warning</p>
                    <p class="leading-relaxed">{s.reputation_flag.split('.')[0]}.</p>
                  </div>
                )}

                <dl class="mb-3 grid grid-cols-2 gap-2 text-xs sm:grid-cols-4">
                  <div>
                    <dt class="text-slate-500 uppercase tracking-wider">Best team size</dt>
                    <dd class="font-semibold text-slate-900">{s.best_team_size.split('(')[0].trim()}</dd>
                  </div>
                  <div>
                    <dt class="text-slate-500 uppercase tracking-wider">Free trial</dt>
                    <dd class="font-semibold text-slate-900">{s.free_trial_days > 0 ? `${s.free_trial_days} days` : 'No'}</dd>
                  </div>
                  <div>
                    <dt class="text-slate-500 uppercase tracking-wider">Affiliate link</dt>
                    <dd class="font-semibold text-slate-900">{s.affiliate_url.startsWith('http') ? 'Yes' : 'No'}</dd>
                  </div>
                  <div>
                    <dt class="text-slate-500 uppercase tracking-wider">Verified</dt>
                    <dd class="font-semibold text-slate-900">{s.verified_date}</dd>
                  </div>
                </dl>

                <p class="mb-3 text-sm text-slate-700 leading-relaxed">
                  <strong class="text-slate-900">Best for:</strong> {s.best_for}
                </p>

                <div class="flex flex-wrap gap-2">
                  <a href={`/payroll/${s.slug}/`} class="rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800">Read full review →</a>
                  <a href={s.affiliate_url.startsWith('http') ? s.affiliate_url : s.vendor_url} rel="sponsored nofollow noopener" target="_blank" class="rounded-md border border-orange-300 bg-white px-4 py-2 text-sm font-semibold text-orange-700 hover:bg-orange-50">Visit {s.name}</a>
                </div>
              </article>
            ))}
          </div>
        </section>
      );
    })}

    <section class="mt-12 rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">Where to start</h2>
      <p class="mt-2 text-slate-300 leading-relaxed">
        Start from what you need payroll to do. For W-2 staff and 1099 subcontractors with automatic tax filing and published prices, compare <strong>Gusto</strong> (from $49/mo plus $6 per person on Simple, which covers one state) with <strong>OnPay</strong> ($49/mo plus $6 per person on its one plan, with year-end W-2 and 1099 forms included). If you can file payroll taxes yourself, <strong>Patriot</strong> Basic is $17/mo plus $4 per worker; its Full Service plan with tax filing in one state is $37/mo plus $5 per worker. For workers' comp premiums tied to each payroll run, <strong>Hourly.io</strong> includes GPS time tracking and job costing on every plan, from $80/mo plus $12 per active user. For certified payroll on prevailing-wage jobs, see Fingercheck, eBacon, Payroll4Construction, Miter and Arcoro.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/payroll/gusto/" class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600">Read the Gusto review →</a>
        <a href="/insurance/" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">Insurance providers</a>
        <a href="/tools/" class="rounded-md border border-white/30 bg-white/10 px-5 py-3 text-sm font-semibold text-white hover:bg-white/20">Software directory</a>
      </div>
    </section>
    <MissingFromList listName="payroll services for trades" count={payrollServices.length} />
  </article>
</Layout>
