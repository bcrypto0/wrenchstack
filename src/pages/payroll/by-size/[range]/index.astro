---
import Layout from '../../../../layouts/Layout.astro';
import { asSentence, payrollServices, payrollTier, payrollPicksForBucket, type PayrollService, type EmployeeBucket } from '../../../../lib/data';

const SIZE_BUCKETS: Record<string, { bucket: EmployeeBucket; label: string; intro: string }> = {
  '1-5-employees': {
    bucket: '1-5',
    label: '1-5 employees',
    intro: 'For trades shops with 1-5 employees, compare the monthly base fee, the per-person fee and whether tax filing is included. Every service on this page publishes its prices: Patriot from $17/mo plus $4 per worker (you file taxes) or $37/mo plus $5 per worker with tax filing in one state; Square Payroll at $35/mo plus $6 per person paid, or $6 per contractor with no base fee and no tax filings for 1099-only crews; Gusto Simple and OnPay at $49/mo plus $6 per person; and Hourly.io from $80/mo plus $12 per active user, with pay-as-you-go workers\' comp in the same app.',
  },
  '6-20-employees': {
    bucket: '6-20',
    label: '6-20 employees',
    intro: 'At 6-20 employees, per-person fees add up, so compare the total monthly cost as well as multi-state payroll, time tracking and job costing. Gusto Plus ($80/mo plus $12 per person) adds multi-state payroll and time tracking to Gusto\'s one-state Simple plan. OnPay stays on one plan at $49/mo plus $6 per person. Patriot Full Service is $37/mo plus $5 per worker, plus $12/mo for each extra state. QuickBooks Payroll, now sold as QuickBooks Workforce, runs inside QuickBooks Online from $50/mo plus $7 per employee. Hourly.io pairs payroll with pay-as-you-go workers\' comp and includes GPS time tracking and job costing on every plan.',
  },
  '20-plus-employees': {
    bucket: '20+',
    label: '20+ employees',
    intro: 'At 20 or more employees, check whether a service covers multi-state payroll, HR tools and benefits as well as payroll. Gusto Plus ($80/mo plus $12 per person) adds multi-state payroll, and Gusto Premium is $180/mo plus $22 per person. OnPay keeps one plan at $49/mo plus $6 per person, with HR tools as a $15/mo plus $2 per worker add-on; our editorial range for OnPay is 1-25 employees. Rippling (HR, IT and finance on one platform), ADP Run (four packages for 1-49 employees) and Paychex Flex (payroll and HR with add-on insurance, 401(k) and HR services) are sold by quote or through a sales rep. For certified, union or prevailing-wage payroll, see the construction payroll services on the main payroll page.',
  },
};

export async function getStaticPaths() {
  const buckets = ['1-5-employees', '6-20-employees', '20-plus-employees'];
  return buckets.map((range) => ({
    params: { range },
    props: { range },
  }));
}

interface Props { range: string; }
const { range } = Astro.props;
const sizeInfo = SIZE_BUCKETS[range];
if (!sizeInfo) throw new Error(`Unknown bucket: ${range}`);

const picks = payrollPicksForBucket(sizeInfo.bucket);
const byTier: Record<'S' | 'A' | 'B', PayrollService[]> = { S: [], A: [], B: [] };
for (const s of picks) byTier[payrollTier(s)].push(s);

const pageTitle = `Best Payroll for ${sizeInfo.label} Trades Shops (2026)`;
const pageDescription = `Independent payroll comparison for trades contractors with ${sizeInfo.label}: published prices where vendors list them, what each plan covers, and an affiliate disclosure on every review.`;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Payroll', url: '/payroll/' },
  { name: sizeInfo.label, url: `/payroll/by-size/${range}/` },
];

const tierMeta = {
  S: { label: 'Recommended', color: 'bg-emerald-100 text-emerald-900 ring-emerald-300', cardBorder: 'border-emerald-300' },
  A: { label: 'Context-specific fit', color: 'bg-blue-100 text-blue-900 ring-blue-300', cardBorder: 'border-blue-300' },
  B: { label: 'Legacy, PEO or reputation warning', color: 'bg-amber-100 text-amber-900 ring-amber-300', cardBorder: 'border-amber-300' },
};

const faqs = [
  {
    q: `Which payroll service fits a ${sizeInfo.label} trades shop?`,
    a: byTier.S.length > 0
      ? `It depends on what you need besides payroll, such as tax filing in more than one state, workers' comp, time tracking or job costing. ${byTier.S[0].name} is in the recommended group on this page. Who it suits, from our review: ${asSentence(byTier.S[0].best_for)}${byTier.S.length > 1 ? ` ${byTier.S[1].name} is also in the recommended group.` : ''} Compare published prices before you choose.`
      : 'It depends on what you need besides payroll. Compare the published prices and plan limits of the services on this page, and get quotes from any that sell by quote.',
  },
  {
    q: `What does payroll cost for ${sizeInfo.label}?`,
    a: sizeInfo.bucket === '1-5'
      ? 'For 1-5 people at published list prices, before add-ons, extra states and promotions: Square Payroll $41-$65/mo ($35 plus $6 per person paid), Patriot Full Service $42-$62/mo ($37 plus $5 per worker, one state), Gusto Simple and OnPay $55-$79/mo ($49 plus $6 per person) and Hourly.io $92-$140/mo ($80 plus $12 per active user). Patriot Basic is $21-$37/mo ($17 plus $4 per worker) if you file payroll taxes yourself.'
      : sizeInfo.bucket === '6-20'
      ? 'For 6-20 people at published list prices, before add-ons, extra states and promotions: Patriot Full Service $67-$137/mo ($37 plus $5 per worker, one state), Gusto Simple (one state) and OnPay $85-$169/mo ($49 plus $6 per person), QuickBooks Workforce Payroll $92-$190/mo ($50 plus $7 per employee), and Gusto Plus and Hourly.io $152-$320/mo ($80 plus $12 per person or active user).'
      : 'At 20 people, published list prices before add-ons and promotions are OnPay $169/mo ($49 plus $6 per person), Gusto Plus $320/mo ($80 plus $12 per person) and Gusto Premium $620/mo ($180 plus $22 per person), with the per-person fee added for each extra person. Rippling and ADP Run publish no prices, and this listing does not quote a Paychex Flex price, so get quotes to compare them. ADP\'s stated range for RUN is 1-49 employees.',
  },
  {
    q: `Do I really need payroll software at this size?`,
    a: 'With W-2 employees, someone has to withhold, deposit and file payroll taxes and issue W-2s at year end. Full-service plans do the filing for you: Patriot Full Service is $37/mo plus $5 per worker in one state, and Gusto Simple and OnPay are $49/mo plus $6 per person. Patriot Basic ($17/mo plus $4 per worker) runs payroll but leaves tax deposits and filings to you.',
  },
  {
    q: `What about my 1099 subcontractors?`,
    a: 'Several services here pay W-2 employees and 1099 contractors from the same account: Gusto lists W-2 and 1099 payments, and OnPay includes year-end W-2 and 1099 forms in its price. For 1099-only crews, Square Payroll\'s contractor-only plan is $6 per contractor paid with no base fee but no tax filings or multistate payroll, and Gusto\'s Contractor Only plan is $35/mo plus $6 per contractor.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <article class="mx-auto max-w-5xl px-4 py-12">
    <header class="mb-10">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-orange-600">Payroll · {sizeInfo.label}</p>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">
        Best Payroll for {sizeInfo.label} Trades Shops (2026)
      </h1>
      <p class="mt-4 text-lg text-slate-600 leading-relaxed">{sizeInfo.intro}</p>
    </header>

    {(['S', 'A', 'B'] as const).map((tier) => {
      const services = byTier[tier];
      if (services.length === 0) return null;
      const meta = tierMeta[tier];
      return (
        <section class="mb-12">
          <div class="mb-5 flex items-baseline gap-3">
            <h2 class="text-2xl font-bold text-slate-900">{meta.label}</h2>
            <span class={`inline-block rounded-full px-2 py-0.5 text-xs font-bold ring-1 ${meta.color}`}>{services.length}</span>
          </div>

          <div class="space-y-4">
            {services.map((s) => (
              <article class={`rounded-lg border-2 ${meta.cardBorder} bg-white p-5`}>
                <div class="mb-3 flex items-start justify-between gap-3">
                  <div class="min-w-0 flex-1">
                    <h3 class="text-xl font-bold text-slate-900">
                      <a href={`/payroll/${s.slug}/`} class="hover:text-orange-600">{s.name}</a>
                    </h3>
                    <p class="text-sm italic text-slate-500">{s.tagline}</p>
                  </div>
                  <div class="shrink-0 text-right text-xs">
                    <p class="text-slate-500">{s.pricing_summary.split(';')[0].trim()}</p>
                  </div>
                </div>

                {s.reputation_flag && (
                  <div class="mb-3 rounded-md border-l-4 border-rose-500 bg-rose-50 px-4 py-3 text-sm text-rose-900">
                    <p class="font-bold uppercase tracking-wider text-xs text-rose-700 mb-1">⚠ Reputation warning</p>
                    <p class="leading-relaxed">{s.reputation_flag.split('.')[0]}.</p>
                  </div>
                )}

                <p class="mb-3 text-sm text-slate-700 leading-relaxed">
                  <strong class="text-slate-900">Best for:</strong> {s.best_for}
                </p>

                <div class="flex flex-wrap gap-2">
                  <a href={`/payroll/${s.slug}/`} class="rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800">Read full review →</a>
                  <a href={s.affiliate_url.startsWith('http') ? s.affiliate_url : s.vendor_url} rel="sponsored nofollow noopener" target="_blank" class="rounded-md border border-orange-300 bg-white px-4 py-2 text-sm font-semibold text-orange-700 hover:bg-orange-50">Visit {s.name}</a>
                </div>
              </article>
            ))}
          </div>
        </section>
      );
    })}

    <section class="mb-10">
      <h2 class="mb-5 text-2xl font-bold text-slate-900">Frequently asked</h2>
      <div class="space-y-3">
        {faqs.map((f) => (
          <details class="rounded-lg border border-slate-200 bg-white p-4">
            <summary class="cursor-pointer font-semibold text-slate-900">{f.q}</summary>
            <p class="mt-3 text-slate-700 leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">More for trades shops your size</h2>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/payroll/" class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600">All payroll services</a>
        <a href="/insurance/" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">Insurance providers</a>
        <a href="/lead-gen/" class="rounded-md border border-white/30 bg-white/10 px-5 py-3 text-sm font-semibold text-white hover:bg-white/20">Lead-gen platforms</a>
      </div>
    </section>
  </article>
</Layout>
