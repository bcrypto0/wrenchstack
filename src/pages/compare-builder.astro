---
import Layout from '../layouts/Layout.astro';
import triosData from '../data/trios.json';
import { tools, verticals, formatPrice, entryPriceLabel, toolType, getTool } from '../lib/data';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Compare', url: '/compare/' },
  { name: 'Build comparison', url: '/compare-builder/' },
];

// Counts shown in the copy, computed so they cannot go stale.
const choose = (n: number, k: number) => { let r = 1; for (let i = 1; i <= k; i++) r = (r * (n - k + i)) / i; return Math.round(r); };
const comboCount = [2, 3, 4, 5].reduce((sum, k) => sum + choose(tools.length, k), 0);
const comboMillions = Math.round(comboCount / 1e6);
// Comparison pages exist for every pair of tools that share a trade, plus the CMMS
// tools compared with each other (as /compare/[pair]/ builds them); 3-way pages for
// each trio in trios.json whose tools all exist (as /multi-compare/[trio]/ builds them).
const isCmms = (t: (typeof tools)[number]) => toolType(t) === 'cmms';
let pairPages = 0;
for (let i = 0; i < tools.length; i++) {
  for (let j = i + 1; j < tools.length; j++) {
    if (tools[i].verticals.some((v) => tools[j].verticals.includes(v)) || (isCmms(tools[i]) && isCmms(tools[j]))) pairPages++;
  }
}
const trioPages = triosData.trios.filter((tr) => tr.slugs.every((s) => getTool(s))).length;
const verticalNames: Record<string, string> = Object.fromEntries(verticals.map((v) => [v.slug, v.name]));

// Tool data shipped to client-side JS
const builderTools = tools.map((t) => ({
  slug: t.slug,
  name: t.name,
  tagline: t.tagline,
  bestFor: t.best_for,
  startingPrice: t.pricing.starting_at_usd,
  formattedPrice: formatPrice(t),
  priceLabel: entryPriceLabel(t),
  freeTrialDays: t.pricing.free_trial_days ?? 0,
  // Only the date ships: the age and the green/amber/red tier are worked out in the
  // browser when the page is viewed. Computed at build time, "Verified 2 days ago" was
  // false the day after deploy (2026-10-01).
  verifiedDate: t.pricing.verified_date ?? '',
  bestTeamSize: t.best_team_size ?? '-',
  verticals: t.verticals,
  // Trades with our fit score, highest first.
  fits: t.verticals
    .map((v) => ({ name: verticalNames[v] ?? v.replace(/_/g, ' '), fit: t.vertical_fit?.[v] ?? 5 }))
    .sort((x, y) => y.fit - x.fit || x.name.localeCompare(y.name)),
  isCmms: isCmms(t),
  keyFeatures: t.key_features,
  integrations: t.integrations,
  hasQuickBooks: t.integrations.some((i) => i.includes('quickbooks')),
  hasStripe: t.integrations.some((i) => i.includes('stripe')),
  hasZapier: t.integrations.some((i) => i.includes('zapier')),
  hasXero: t.integrations.some((i) => i.includes('xero')),
  hasLSA: t.integrations.some((i) => i.includes('google_local_services')),
  hasFreeTier: t.pricing.starting_at_usd === 0,
  pricingNote: t.pricing.pricing_note ?? '',
  founded: t.founded ?? null,
  headquartered: t.headquartered ?? '',
  vendorUrl: t.vendor_url,
  affiliateUrl: t.affiliate_url,
}));
---

<Layout
  title="Build your own comparison: pick any 2-5 trades software tools"
  description="Side-by-side comparison builder. Pick any 2-5 trades software platforms from our directory and compare their pricing, listed features and integrations, fit by trade and when each price was checked."
  breadcrumbs={breadcrumbs}
>
  <article class="mx-auto max-w-6xl px-4 py-12">
    <header class="mb-8">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-orange-600">
        Free · no email required
      </p>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">
        Build your own side-by-side comparison
      </h1>
      <p class="mt-4 text-lg text-slate-600">
        Pick any 2-5 trades software platforms from our directory and see them side by side: pricing, listed features and integrations, fit by trade, and when each price was last checked.
      </p>
    </header>

    <section class="mb-8 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm md:p-6">
      <label for="cb-search" class="mb-2 block text-sm font-semibold text-slate-900">
        Add a tool to compare (search by name)
      </label>
      <div class="relative">
        <input
          id="cb-search"
          type="search"
          autocomplete="off"
          placeholder="Start typing, e.g. ServiceTitan, Jobber, MaintainX…"
          class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-orange-500 focus:outline-none focus:ring-1 focus:ring-orange-500"
        />
        <div
          id="cb-search-results"
          class="absolute left-0 right-0 top-full z-30 mt-1 hidden max-h-80 overflow-y-auto rounded-md border border-slate-200 bg-white shadow-lg"
        ></div>
      </div>
      <div class="mt-4 flex flex-wrap items-center gap-2">
        <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Selected:</span>
        <div id="cb-selected" class="flex flex-wrap gap-2"></div>
        <button
          id="cb-clear"
          type="button"
          class="hidden ml-2 text-xs font-medium text-orange-600 hover:text-orange-700"
        >
          Clear all
        </button>
      </div>
      <p class="mt-3 text-xs text-slate-500">
        Tip: paste a URL like <code class="rounded bg-slate-100 px-1.5 py-0.5">/compare-builder/?tools=jobber,housecall-pro,workiz</code> to share a specific comparison.
      </p>
    </section>

    <section id="cb-output" class="hidden">
      <!-- populated by JS -->
    </section>

    <section id="cb-prompt" class="rounded-lg border-2 border-dashed border-slate-300 bg-slate-50 p-12 text-center text-slate-500">
      <svg class="mx-auto h-12 w-12 text-slate-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2" />
      </svg>
      <p class="mt-3 text-sm">
        Pick at least 2 tools above to see your custom side-by-side comparison.
      </p>
      <p class="mt-2 text-xs text-slate-500">
        Need a pre-built comparison instead? Head-to-head pages exist for {pairPages.toLocaleString('en-US')} pairs; <a href="/compare/" class="text-orange-600 hover:underline">browse the comparisons</a>.
      </p>
    </section>

    <section class="mt-12 prose prose-slate max-w-none">
      <h2>Why an interactive builder?</h2>
      <p>
        Pre-built comparison pages cover pairs of tools that share a trade, and a set of three-way comparisons. To compare four or five tools at once, or a combination that has no page, use the builder: there are about {comboMillions} million possible combinations of 2 to 5 of our {tools.length} platforms.
      </p>

      <h2>What the comparison includes</h2>
      <ul>
        <li><strong>Headline facts</strong>: starting price and how it scales (per user, a flat company price, or a base price plus users), best team size, free trial or free tier, founded year, headquarters.</li>
        <li><strong>Freshness badge</strong>: when we last checked the price against the vendor's own pricing page. Green at 90 days or less, amber at 91-180 days, red after that.</li>
        <li><strong>Integration check</strong>: whether our entry lists an integration with QuickBooks, Stripe, Xero, Zapier or Google Local Services Ads. "Not listed" means our entry does not record one, not that the tool cannot connect.</li>
        <li><strong>Features and integrations as listed</strong>: the key features and integrations in our entry for each tool, with the number of integrations (a Fit Score factor). Entries use different words for similar features, so check a feature you need on the vendor's site.</li>
        <li><strong>Fit by trade</strong>: each trade the tool serves, with our 1-10 fit score.</li>
        <li><strong>Best for</strong>: the target customer in our entry for each tool.</li>
      </ul>

      <h2>Sharing your comparison</h2>
      <p>
        The URL updates as you add and remove tools, so you can copy the URL bar to share your specific comparison with a colleague, business partner, or industry advisor. The URL pattern is <code>/compare-builder/?tools=slug1,slug2,slug3</code>. No account required.
      </p>

      <h2>Other ways to compare</h2>
      <p>
        For side-by-side pricing, the differences in our data and FAQs for two tools, see the <a href="/compare/">pre-built head-to-head comparisons</a>: {pairPages.toLocaleString('en-US')} pairs, every pair of tools that share a trade plus the maintenance (CMMS) tools compared with each other. For three tools, see the <a href="/multi-compare/">{trioPages} three-way comparison pages</a>.
      </p>
    </section>
  </article>

  <script define:vars={{ allTools: builderTools }}>
    (() => {
      const tools = allTools;

      const search = document.getElementById('cb-search');
      const results = document.getElementById('cb-search-results');
      const selectedBox = document.getElementById('cb-selected');
      const clearBtn = document.getElementById('cb-clear');
      const output = document.getElementById('cb-output');
      const prompt = document.getElementById('cb-prompt');
      if (!search || !results || !selectedBox || !output || !prompt || !clearBtn) return;

      const MAX_TOOLS = 5;
      let selectedSlugs = [];

      function escHtml(s) {
        return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      }

      function findTool(slug) {
        return tools.find((t) => t.slug === slug);
      }

      // Age of a price check when the page is viewed, with the thresholds of
      // freshnessTier and freshnessLabel in lib/data.ts (fresh up to 90 days, aging up
      // to 180, stale after that).
      function freshnessOf(dateStr) {
        const ms = dateStr ? Date.parse(dateStr + 'T00:00:00Z') : NaN;
        if (Number.isNaN(ms)) return { tier: 'stale', label: 'No verified date' };
        const d = Math.max(0, Math.floor((Date.now() - ms) / 86400000));
        const tier = d <= 90 ? 'fresh' : d <= 180 ? 'aging' : 'stale';
        let label;
        if (d === 0) label = 'Verified today';
        else if (d === 1) label = 'Verified yesterday';
        else if (d < 14) label = `Verified ${d} days ago`;
        else if (d < 60) label = `Verified ${Math.round(d / 7)} weeks ago`;
        else if (d < 365) label = `Verified ${Math.round(d / 30)} months ago`;
        else label = `Verified over ${Math.floor(d / 365)} year${d >= 730 ? 's' : ''} ago`;
        return { tier, label };
      }

      function searchTools(q) {
        const qLower = q.toLowerCase().trim();
        if (qLower.length === 0) return [];
        const scored = [];
        for (const t of tools) {
          if (selectedSlugs.includes(t.slug)) continue;
          const name = t.name.toLowerCase();
          let score = 0;
          if (name === qLower) score = 100;
          else if (name.startsWith(qLower)) score = 80;
          else if (name.split(/\s+/).some((w) => w.startsWith(qLower))) score = 60;
          else if (name.includes(qLower)) score = 40;
          else if (t.tagline && t.tagline.toLowerCase().includes(qLower)) score = 20;
          else if (t.verticals.some((v) => v.includes(qLower))) score = 15;
          if (score > 0) scored.push({ t, score });
        }
        return scored.sort((a, b) => b.score - a.score).slice(0, 8).map((s) => s.t);
      }

      function renderSearchResults(matches) {
        if (matches.length === 0) {
          results.innerHTML = '<div class="px-3 py-2 text-sm text-slate-500">No matches. Try another name.</div>';
          results.classList.remove('hidden');
          return;
        }
        results.innerHTML = matches
          .map(
            (t) => `
            <button
              type="button"
              data-add-slug="${t.slug}"
              class="block w-full px-3 py-2 text-left text-sm transition hover:bg-orange-50 focus:bg-orange-50 focus:outline-none"
            >
              <div class="font-medium text-slate-900">${escHtml(t.name)}</div>
              <div class="text-xs text-slate-500">${escHtml(t.formattedPrice)} · best team size ${escHtml(t.bestTeamSize)}</div>
            </button>
          `,
          )
          .join('');
        results.classList.remove('hidden');
      }

      function hideSearchResults() {
        results.classList.add('hidden');
      }

      function syncUrl() {
        const url = new URL(window.location.href);
        if (selectedSlugs.length > 0) {
          url.searchParams.set('tools', selectedSlugs.join(','));
        } else {
          url.searchParams.delete('tools');
        }
        history.replaceState(null, '', url.toString());
      }

      function renderSelected() {
        selectedBox.innerHTML = selectedSlugs
          .map((slug) => {
            const t = findTool(slug);
            if (!t) return '';
            return `
              <span class="inline-flex items-center gap-2 rounded-full bg-orange-100 px-3 py-1 text-sm font-medium text-orange-800">
                ${escHtml(t.name)}
                <button type="button" data-remove-slug="${slug}" class="text-orange-600 hover:text-orange-800" aria-label="Remove ${escHtml(t.name)}">
                  ×
                </button>
              </span>
            `;
          })
          .join('');
        clearBtn.classList.toggle('hidden', selectedSlugs.length === 0);
      }

      function renderComparison() {
        if (selectedSlugs.length < 2) {
          output.classList.add('hidden');
          prompt.classList.remove('hidden');
          return;
        }
        prompt.classList.add('hidden');
        output.classList.remove('hidden');

        const cols = selectedSlugs.map(findTool).filter((t) => !!t);
        if (cols.length < 2) return;

        const freshnessColors = {
          fresh: 'bg-emerald-100 text-emerald-800',
          aging: 'bg-amber-100 text-amber-800',
          stale: 'bg-rose-100 text-rose-800',
        };

        // Build rows
        const rows = [
          {
            label: 'Starting price',
            cells: cols.map((t) => `<strong>${escHtml(t.formattedPrice)}</strong><div class="mt-1 text-xs text-slate-700">${escHtml(t.priceLabel)}</div>${t.pricingNote ? `<div class="mt-1 text-xs text-slate-500">${escHtml(t.pricingNote.slice(0, 80))}${t.pricingNote.length > 80 ? '…' : ''}</div>` : ''}`),
          },
          {
            label: 'Best team size',
            cells: cols.map((t) => escHtml(t.bestTeamSize)),
          },
          {
            label: 'Free trial',
            cells: cols.map((t) => t.freeTrialDays > 0 ? `<span class="text-emerald-700">${t.freeTrialDays}-day trial</span>` : (t.hasFreeTier ? '<span class="text-emerald-700">Free tier</span>' : '<span class="text-slate-400">None listed</span>')),
          },
          {
            label: 'Pricing freshness',
            cells: cols.map((t) => {
              const f = freshnessOf(t.verifiedDate);
              const color = freshnessColors[f.tier] ?? freshnessColors.stale;
              return `<span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium ${color}">${escHtml(f.label)}</span>${t.verifiedDate ? `<div class="mt-1 text-xs text-slate-500">${escHtml(t.verifiedDate)}</div>` : ''}`;
            }),
          },
          {
            label: 'Founded',
            cells: cols.map((t) => t.founded ? `${t.founded}` : '<span class="text-slate-400">-</span>'),
          },
          {
            label: 'Headquarters',
            cells: cols.map((t) => escHtml(t.headquartered || '-')),
          },
          {
            label: 'QuickBooks',
            cells: cols.map((t) => t.hasQuickBooks ? '<span class="text-emerald-700 font-semibold">✓ Listed</span>' : '<span class="text-slate-400">Not listed</span>'),
          },
          {
            label: 'Stripe',
            cells: cols.map((t) => t.hasStripe ? '<span class="text-emerald-700 font-semibold">✓ Listed</span>' : '<span class="text-slate-400">Not listed</span>'),
          },
          {
            label: 'Xero',
            cells: cols.map((t) => t.hasXero ? '<span class="text-emerald-700 font-semibold">✓ Listed</span>' : '<span class="text-slate-400">Not listed</span>'),
          },
          {
            label: 'Zapier',
            cells: cols.map((t) => t.hasZapier ? '<span class="text-emerald-700 font-semibold">✓ Listed</span>' : '<span class="text-slate-400">Not listed</span>'),
          },
          {
            label: 'Google LSA',
            cells: cols.map((t) => t.hasLSA ? '<span class="text-emerald-700 font-semibold">✓ Listed</span>' : '<span class="text-slate-400">Not listed</span>'),
          },
          {
            // No count: feature lists use an uncontrolled vocabulary, so their length says how
            // finely an entry was written, not how much the product does (methodology v1.2).
            label: 'Key features (as listed)',
            cells: cols.map((t) => `<div class="text-xs text-slate-700">${escHtml(t.keyFeatures.map((f) => f.replace(/_/g, ' ')).join(', '))}</div>`),
          },
          {
            label: 'Integrations listed',
            cells: cols.map((t) => `<strong>${t.integrations.length}</strong><div class="mt-1 text-xs text-slate-500">${escHtml(t.integrations.map((i) => i.replace(/_/g, ' ')).join(', '))}</div>`),
          },
          {
            label: 'Fit by trade (1-10)',
            cells: cols.map((t) => t.fits.length
              ? `<strong>${t.fits.length} ${t.fits.length === 1 ? 'trade' : 'trades'}</strong><div class="mt-1 text-xs text-slate-700">${t.fits.map((f) => `${escHtml(f.name)} ${f.fit}`).join(', ')}</div>`
              : '<span class="text-slate-400">No trades in our data</span>'),
          },
          {
            label: 'Best for',
            cells: cols.map((t) => `<div class="text-xs text-slate-700 leading-snug">${escHtml(t.bestFor)}</div>`),
          },
        ];

        const header = `
          <h2 class="mb-4 text-2xl font-bold text-slate-900">Side-by-side comparison</h2>
          <p class="mb-6 text-sm text-slate-500">${cols.length} tools selected. ${cols.length < MAX_TOOLS ? `Add up to ${MAX_TOOLS - cols.length} more.` : `At maximum (${MAX_TOOLS} tools).`}</p>
        `;

        // Tool header cards
        const headerCards = `
          <div class="mb-6 grid gap-3" style="grid-template-columns: repeat(${cols.length}, minmax(0, 1fr));">
            ${cols
              .map(
                (t) => `
              <div class="rounded-lg border border-slate-200 bg-white p-4">
                <a href="/tools/${t.slug}/" class="font-semibold text-slate-900 hover:text-orange-600">${escHtml(t.name)}</a>
                <div class="mt-1 text-xs italic text-slate-500">${escHtml(t.tagline)}</div>
                <a
                  href="${t.affiliateUrl.startsWith('http') ? t.affiliateUrl : t.vendorUrl}"
                  rel="sponsored nofollow noopener"
                  target="_blank"
                  class="mt-3 inline-block rounded-md bg-orange-500 px-3 py-1.5 text-xs font-semibold text-white hover:bg-orange-600"
                >Visit →</a>
              </div>
            `,
              )
              .join('')}
          </div>
        `;

        // Big table
        const table = `
          <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
            <table class="w-full text-sm">
              <thead class="bg-slate-50 text-left text-slate-700">
                <tr>
                  <th class="px-4 py-3 font-semibold">Field</th>
                  ${cols.map((t) => `<th class="px-4 py-3 font-semibold">${escHtml(t.name)}</th>`).join('')}
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                ${rows
                  .map(
                    (r) => `
                  <tr>
                    <td class="px-4 py-3 font-medium text-slate-700 align-top whitespace-nowrap">${r.label}</td>
                    ${r.cells.map((c) => `<td class="px-4 py-3 text-slate-900 align-top">${c}</td>`).join('')}
                  </tr>
                `,
                  )
                  .join('')}
              </tbody>
            </table>
          </div>
        `;

        // Pairwise links, only for pairs that have a comparison page: tools that share a
        // trade, or two CMMS tools (the rule /compare/[pair]/ builds by). Other pairs used
        // to get a link too, which redirected or 404'd.
        let pairLinks = '';
        if (cols.length >= 2) {
          const pairs = [];
          for (let i = 0; i < cols.length; i++) {
            for (let j = i + 1; j < cols.length; j++) {
              const x = cols[i];
              const y = cols[j];
              const hasPage = x.verticals.some((v) => y.verticals.includes(v)) || (x.isCmms && y.isCmms);
              if (!hasPage) continue;
              const [a, b] = [x.slug, y.slug].sort();
              pairs.push(`<a href="/compare/${a}-vs-${b}/" class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-900 hover:border-orange-400 hover:text-orange-600">${escHtml(x.name)} vs ${escHtml(y.name)} →</a>`);
            }
          }
          if (pairs.length > 0) {
            pairLinks = `
              <div class="mt-6 rounded-lg bg-slate-50 p-5">
                <h3 class="mb-3 text-sm font-semibold uppercase tracking-wider text-slate-700">Head-to-head comparison pages</h3>
                <p class="mb-3 text-sm text-slate-600">For pricing, the differences in our data and FAQs for two of these tools, see the comparison pages:</p>
                <div class="flex flex-wrap gap-2">${pairs.join('')}</div>
              </div>
            `;
          }
        }

        output.innerHTML = header + headerCards + table + pairLinks;
      }

      function addTool(slug) {
        if (selectedSlugs.includes(slug)) return;
        if (selectedSlugs.length >= MAX_TOOLS) {
          alert(`Maximum ${MAX_TOOLS} tools at once. Remove one before adding another.`);
          return;
        }
        selectedSlugs.push(slug);
        renderSelected();
        renderComparison();
        syncUrl();
        search.value = '';
        hideSearchResults();
        search.focus();
      }

      function removeTool(slug) {
        selectedSlugs = selectedSlugs.filter((s) => s !== slug);
        renderSelected();
        renderComparison();
        syncUrl();
      }

      // URL state restore
      const urlParams = new URLSearchParams(window.location.search);
      const toolsParam = urlParams.get('tools');
      if (toolsParam) {
        for (const slug of toolsParam.split(',').slice(0, MAX_TOOLS)) {
          if (findTool(slug)) selectedSlugs.push(slug);
        }
        renderSelected();
        renderComparison();
      }

      search.addEventListener('input', () => {
        const q = search.value;
        if (q.length === 0) {
          hideSearchResults();
          return;
        }
        renderSearchResults(searchTools(q));
      });

      results.addEventListener('click', (e) => {
        const target = e.target.closest('[data-add-slug]');
        if (target) {
          const slug = target.dataset.addSlug;
          if (slug) addTool(slug);
        }
      });

      selectedBox.addEventListener('click', (e) => {
        const target = e.target.closest('[data-remove-slug]');
        if (target) {
          const slug = target.dataset.removeSlug;
          if (slug) removeTool(slug);
        }
      });

      clearBtn.addEventListener('click', () => {
        selectedSlugs = [];
        renderSelected();
        renderComparison();
        syncUrl();
      });

      // Close search results when clicking outside
      document.addEventListener('click', (e) => {
        if (!search.contains(e.target) && !results.contains(e.target)) {
          hideSearchResults();
        }
      });
    })();
  </script>
</Layout>
