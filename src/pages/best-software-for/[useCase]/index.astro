---
import Layout from '../../../layouts/Layout.astro';
import useCasesData from '../../../data/use_cases.json';
import {
  getTool,
  verticals,
  verticalToUrl,
  isQuoteOnly,
  entryPriceLabel,
  type Tool,
} from '../../../lib/data';

interface UseCase {
  slug: string;
  h1: string;
  meta_description: string;
  buyer_profile: string;
  intro: string;
  verticals: string[];
  ranked_picks: string[];
  buying_criteria: string[];
}

const useCases: UseCase[] = useCasesData.use_cases as UseCase[];

export async function getStaticPaths() {
  const cases = (useCasesData.use_cases as UseCase[]);
  return cases.map((uc) => ({
    params: { useCase: uc.slug },
    props: { useCase: uc },
  }));
}

interface Props {
  useCase: UseCase;
}

const { useCase } = Astro.props;

const picks: Tool[] = useCase.ranked_picks
  .map((slug) => getTool(slug))
  .filter((t): t is Tool => t !== undefined);

const relevantVerticals = useCase.verticals
  .map((v) => verticals.find((x) => x.slug === v))
  .filter((v): v is NonNullable<typeof v> => v !== undefined);

// "A, B and C", for answers that name tied tools.
const namesList = (list: Tool[]): string =>
  list.length <= 1
    ? (list[0]?.name ?? '')
    : `${list.slice(0, -1).map((t) => t.name).join(', ')} and ${list[list.length - 1].name}`;
const tradeNames = relevantVerticals.map((v) => v.name);
const tradeNamesText = tradeNames.length <= 1
  ? (tradeNames[0] ?? '')
  : `${tradeNames.slice(0, -1).join(', ')} or ${tradeNames[tradeNames.length - 1]}`;

// Trade fit for this guide's trade(s), counted only where the tool serves the trade;
// for a guide that names several trades, the tool's highest fit among them.
const guideFit = (t: Tool): number | null => {
  const fits = useCase.verticals
    .filter((v) => t.verticals.includes(v) && typeof t.vertical_fit?.[v] === 'number')
    .map((v) => t.vertical_fit![v] as number);
  return fits.length > 0 ? Math.max(...fits) : null;
};
const fitLabel = relevantVerticals.length === 1
  ? `${relevantVerticals[0].name} fit score`
  : 'trade fit score';
const fitRule = relevantVerticals.length > 1
  ? ` (each tool's highest across ${tradeNames.slice(0, -1).join(', ')} and ${tradeNames[tradeNames.length - 1]})`
  : '';

// QuickBooks editions each tool lists, from its integrations.
const qbEditionsFor = (t: Tool): string[] =>
  [
    t.integrations.includes('quickbooks_online') ? 'Online' : null,
    t.integrations.includes('quickbooks_desktop') ? 'Desktop' : null,
    t.integrations.includes('quickbooks_enterprise') ? 'Enterprise' : null,
  ].filter((e): e is string => !!e);
const hasQb = (t: Tool) => t.integrations.some((i) => i.includes('quickbooks'));
const qbLabel = (t: Tool): string => {
  if (!hasQb(t)) return 'None listed';
  const ed = qbEditionsFor(t);
  return ed.length > 0 ? `QuickBooks ${ed.join(', ')}` : 'QuickBooks (edition not recorded)';
};

// FAQ answers rewritten 2026-10-01. They said the first pick "ranks first because" of its
// best_for text (the order is hand-picked, per use_cases.json, not scored), compared bare
// starting prices across per-user and per-company plans, said "some tools are
// iPhone-first", said "all five picks" whatever the count, and said tools without a
// QuickBooks integration "use Zapier". Each answer now comes from the data.
const fitRanked = picks.filter((t) => guideFit(t) !== null);
const topFit = fitRanked.length > 0 ? Math.max(...fitRanked.map((t) => guideFit(t) as number)) : null;
const topFitPicks = topFit === null ? [] : fitRanked.filter((t) => guideFit(t) === topFit);
const pricedPicks = picks.filter((t) => t.pricing.starting_at_usd !== null);
const lowestPrice = pricedPicks.length > 0 ? Math.min(...pricedPicks.map((t) => t.pricing.starting_at_usd as number)) : null;
const lowestPricePicks = lowestPrice === null ? [] : pricedPicks.filter((t) => t.pricing.starting_at_usd === lowestPrice);
const quoteOnlyPicks = picks.filter(isQuoteOnly);
const qbPicks = picks.filter(hasQb);
const noQbPicks = picks.filter((t) => !hasQb(t));

const faqs = [
  {
    q: `Which of these has the highest ${fitLabel}?`,
    a: topFitPicks.length > 0
      ? `${namesList(topFitPicks)} ${topFitPicks.length === 1 ? 'has' : 'share'} the highest ${fitLabel}${fitRule} of these ${picks.length} picks (${topFit}/10). The order above was picked by hand for this buyer profile; it is not a score. Each tool's fit score is on its review page.`
      : `None of these picks is listed for ${tradeNamesText} in our data. The order above was picked by hand for this buyer profile; it is not a score.`,
  },
  {
    q: `Which of these has the lowest starting price?`,
    a: lowestPricePicks.length > 0
      ? `${namesList(lowestPricePicks)} ${lowestPricePicks.length === 1 ? 'has' : 'share'} the lowest published starting price here: ${entryPriceLabel(lowestPricePicks[0])}.${
          quoteOnlyPicks.length > 0
            ? ` ${namesList(quoteOnlyPicks)} ${quoteOnlyPicks.length === 1 ? 'publishes' : 'publish'} no price, so you need a quote to compare ${quoteOnlyPicks.length === 1 ? 'it' : 'them'}.`
            : ''
        } A per-user price grows with each seat and a company price does not, so compare the total at your team size.`
      : `None of these picks publishes a monthly starting price${quoteOnlyPicks.length > 0 ? `: ${namesList(quoteOnlyPicks)} ${quoteOnlyPicks.length === 1 ? 'is' : 'are'} quote-only` : ''}. Ask each for a written quote at your team size to compare them.`,
  },
  {
    q: `Which one has the best mobile app?`,
    a: 'We do not rate mobile apps, and our key-feature lists are not a complete record of each tool\'s apps. Confirm iOS and Android support with each vendor, and try the app during a trial or demo before you buy.',
  },
  {
    q: `Do these integrate with QuickBooks?`,
    a: qbPicks.length > 0
      ? `${qbPicks.length === picks.length ? `All ${picks.length} picks list` : `${qbPicks.length} of the ${picks.length} picks list`} a QuickBooks integration in our data: ${qbPicks.map((t) => `${t.name} (${qbEditionsFor(t).join(', ') || 'edition not recorded'})`).join('; ')}.${
          noQbPicks.length > 0 ? ` ${namesList(noQbPicks)} ${noQbPicks.length === 1 ? 'lists' : 'list'} none.` : ''
        } Check which edition you use and what each one syncs before you buy.`
      : `None of these picks lists a QuickBooks integration in our data. Ask each vendor how invoices and payments reach your accounting software.`,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: useCase.h1,
  itemListElement: picks.map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'SoftwareApplication',
      name: t.name,
      applicationCategory: 'BusinessApplication',
      url: `https://wrenchstack.com/tools/${t.slug}/`,
    },
  })),
};

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Buyer Guides', url: '/best-software-for/' },
  { name: useCase.h1, url: `/best-software-for/${useCase.slug}/` },
];
---

<Layout title={useCase.h1} description={useCase.meta_description} breadcrumbs={breadcrumbs} affiliate>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  <article class="mx-auto max-w-4xl px-4 py-12">
    <nav class="mb-6 text-sm text-slate-500">
      <a href="/" class="hover:text-slate-900">Home</a>
      <span class="mx-2">/</span>
      <span class="text-slate-900">Best Software For</span>
      <span class="mx-2">/</span>
      <span class="text-slate-900">{useCase.h1}</span>
    </nav>

    <header class="mb-10">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-orange-600">
        Buyer Guide
      </p>
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 md:text-5xl">
        {useCase.h1}
      </h1>
      <p class="mt-4 text-lg text-slate-600">
        For: <strong>{useCase.buyer_profile}</strong>
      </p>
    </header>

    <section class="mb-10 rounded-lg border border-slate-200 bg-slate-50 p-6">
      <h2 class="mb-3 text-lg font-bold text-slate-900">Why we picked these</h2>
      <p class="text-slate-700">{useCase.intro}</p>
    </section>

    {/* Was "What we looked for": the picks do not all meet these points (in the solo HVAC
        guide, FieldPulse is quote-only with no free trial against "no contact-sales pricing"
        and "free trial"), so the list is offered as a checklist, not as our selection test.
        The facts under each pick come from the data so a reader can check (2026-10-01). */}
    <section class="mb-12">
      <h2 class="mb-4 text-2xl font-bold text-slate-900">What to check before you buy</h2>
      <ul class="space-y-2 text-slate-700">
        {useCase.buying_criteria.map((criterion) => (
          <li class="flex gap-2">
            <span class="font-bold text-orange-500">✓</span>
            <span>{criterion}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="mb-12">
      <h2 class="mb-2 text-2xl font-bold text-slate-900">The picks</h2>
      <p class="mb-6 text-sm text-slate-600">
        Picked by hand for this buyer profile and listed in that order; the order is not a score. The facts under each pick come from its review page, so check them against the list above.
      </p>
      <div class="space-y-10">
        {picks.map((tool, i) => {
          const fit = guideFit(tool);
          const trial = tool.pricing.free_trial_days;
          const priceLabel = entryPriceLabel(tool);
          return (
            <div class="rounded-lg border border-slate-200 bg-white p-6">
              <div class="mb-3 flex flex-wrap items-baseline justify-between gap-3">
                <h3 class="text-2xl font-bold text-slate-900">
                  <span class="text-orange-500">#{i + 1}</span>{' '}
                  <a href={`/tools/${tool.slug}/`} class="hover:text-orange-600">{tool.name}</a>
                </h3>
              </div>
              <p class="mb-4 italic text-slate-600">{tool.tagline}</p>

              <dl class="grid gap-3 text-sm md:grid-cols-2">
                <div>
                  <dt class="font-semibold text-slate-900">Starting price</dt>
                  <dd class="text-slate-700">{priceLabel.charAt(0).toUpperCase() + priceLabel.slice(1)}</dd>
                </div>
                <div>
                  <dt class="font-semibold text-slate-900">Best team size</dt>
                  <dd class="text-slate-700">{tool.best_team_size ?? 'n/a'}</dd>
                </div>
                <div>
                  <dt class="font-semibold text-slate-900">{relevantVerticals.length === 1 ? `${relevantVerticals[0].name} fit` : 'Trade fit'}</dt>
                  <dd class="text-slate-700">{fit === null ? `Not listed for ${tradeNamesText}` : `${fit}/10`}</dd>
                </div>
                <div>
                  <dt class="font-semibold text-slate-900">Free trial</dt>
                  <dd class="text-slate-700">{typeof trial === 'number' && trial > 0 ? `${trial} days` : trial === 0 ? 'None listed' : 'Not recorded (see the pricing note)'}</dd>
                </div>
                <div>
                  <dt class="font-semibold text-slate-900">QuickBooks</dt>
                  <dd class="text-slate-700">{qbLabel(tool)}</dd>
                </div>
                <div class="md:col-span-2">
                  <dt class="font-semibold text-slate-900">Best for</dt>
                  <dd class="text-slate-700">{tool.best_for}</dd>
                </div>
                <div class="md:col-span-2">
                  <dt class="font-semibold text-slate-900">Watch out for</dt>
                  <dd class="text-slate-700">{tool.weaknesses}</dd>
                </div>
              </dl>

              <div class="mt-5 flex flex-wrap gap-3">
                <a
                  href={tool.affiliate_url.startsWith('http') ? tool.affiliate_url : tool.vendor_url}
                  rel="sponsored nofollow noopener"
                  target="_blank"
                  class="rounded-md bg-orange-500 px-4 py-2 text-sm font-semibold text-white hover:bg-orange-600"
                >
                  Visit {tool.name} →
                </a>
                <a
                  href={`/tools/${tool.slug}/`}
                  class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-900 hover:border-slate-400"
                >
                  Full review
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    {relevantVerticals.length > 0 && (
      <section class="mb-12">
        <h2 class="mb-4 text-2xl font-bold text-slate-900">Related guides</h2>
        <div class="flex flex-wrap gap-2">
          {relevantVerticals.map((v) => (
            <a
              href={`/${verticalToUrl(v.slug)}/`}
              class="rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-900 hover:border-orange-500 hover:text-orange-600"
            >
              All {v.name} software →
            </a>
          ))}
          <a
            href="/compare/"
            class="rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-900 hover:border-orange-500 hover:text-orange-600"
          >
            Compare any two tools →
          </a>
        </div>
      </section>
    )}

    <section class="mb-12">
      <h2 class="mb-6 text-2xl font-bold text-slate-900">Frequently asked questions</h2>
      <div class="space-y-4">
        {faqs.map((f) => (
          <details class="rounded-lg border border-slate-200 bg-white p-4">
            <summary class="cursor-pointer font-semibold text-slate-900">{f.q}</summary>
            <p class="mt-3 text-slate-700">{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </article>
</Layout>
