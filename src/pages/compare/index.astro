---
import Layout from '../../layouts/Layout.astro';
import { tools, verticals, verticalFitScore, verticalToUrl, toolType, type Tool } from '../../lib/data';
import { isComparisonIndexable } from '../../lib/compare-index.mjs';

interface Pair {
  a: Tool;
  b: Tool;
}

// Build all pairs that share at least one vertical (matches the comparison-page generator).
const pairs: Pair[] = [];
for (let i = 0; i < tools.length; i++) {
  for (let j = i + 1; j < tools.length; j++) {
    const a = tools[i];
    const b = tools[j];
    if (!a.verticals.some((v) => b.verticals.includes(v))) continue;
    const [first, second] = [a, b].sort((x, y) => x.slug.localeCompare(y.slug));
    // Only surface indexable comparisons (see compare-index.mjs) so crawl budget
    // and internal links concentrate on the pages that can rank, not on the
    // noindexed long-tail pairs.
    if (!isComparisonIndexable(first.slug, second.slug)) continue;
    pairs.push({ a: first, b: second });
  }
}

// Every comparison page that exists (one per unordered pair, as /compare/[pair]/ builds
// them: tools that share a trade, plus CMMS tools compared with each other), and the
// tools that appear in the pairs listed here. Computed so the copy cannot go stale.
let totalPairs = 0;
for (let i = 0; i < tools.length; i++) {
  for (let j = i + 1; j < tools.length; j++) {
    const shared = tools[i].verticals.some((v) => tools[j].verticals.includes(v));
    const bothCmms = toolType(tools[i]) === 'cmms' && toolType(tools[j]) === 'cmms';
    if (shared || bothCmms) totalPairs++;
  }
}
const listedToolCount = new Set(pairs.flatMap((p) => [p.a.slug, p.b.slug])).size;

// Featured comparisons: a hand-picked list (no search-volume data behind it).
const featuredSlugPairs: [string, string][] = [
  ['jobber', 'housecall-pro'],
  ['jobber', 'servicetitan'],
  ['housecall-pro', 'servicetitan'],
  ['fieldedge', 'servicetitan'],
  ['buildops', 'servicetitan'],
  ['buildertrend', 'procore'],
  ['acculynx', 'jobnimbus'],
  ['jobber', 'workiz'],
  ['servicefusion', 'jobber'],
  ['housecall-pro', 'workiz'],
  ['buildops', 'procore'],
  ['knowify', 'buildertrend'],
];
const featuredPairs = featuredSlugPairs
  .map(([slugA, slugB]) => {
    const a = tools.find((t) => t.slug === slugA);
    const b = tools.find((t) => t.slug === slugB);
    if (!a || !b) return null;
    const [first, second] = [a, b].sort((x, y) => x.slug.localeCompare(y.slug));
    return { a: first, b: second };
  })
  .filter((p): p is Pair => p !== null);

// Comparisons grouped by vertical. Each pair appears in every shared-vertical section.
// Ordered by the two tools' combined fit for that trade, then alphabetically. (Until
// 2026-09-30 this sorted by summed G2/Capterra ratings, which are no longer used.)
const pairsByVertical = verticals.map((v) => ({
  vertical: v,
  pairs: pairs
    .filter((p) => p.a.verticals.includes(v.slug) && p.b.verticals.includes(v.slug))
    .sort((p, q) => {
      const fitP = verticalFitScore(p.a, v.slug) + verticalFitScore(p.b, v.slug);
      const fitQ = verticalFitScore(q.a, v.slug) + verticalFitScore(q.b, v.slug);
      if (fitQ !== fitP) return fitQ - fitP;
      return `${p.a.name} vs ${p.b.name}`.localeCompare(`${q.a.name} vs ${q.b.name}`);
    }),
})).filter((g) => g.pairs.length > 0);

// All pairs alphabetical (for the full browse list)
const allPairsAlphabetical = [...pairs].sort((p, q) => {
  const labelP = `${p.a.name} vs ${p.b.name}`;
  const labelQ = `${q.a.name} vs ${q.b.name}`;
  return labelP.localeCompare(labelQ);
});

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Compare', url: '/compare/' },
];
---

<Layout
  title={`Compare trades software side-by-side: ${pairs.length} head-to-head comparisons`}
  description={`${pairs.length} head-to-head comparisons of trades software from our data: pricing side by side, where the two differ, fit by trade and FAQs.`}
  breadcrumbs={breadcrumbs}
>
  <section class="mx-auto max-w-6xl px-4 py-12">
    <header class="mb-10">
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 md:text-5xl">
        Compare trades software, side-by-side
      </h1>
      <p class="mt-4 max-w-3xl text-lg text-slate-600">
        This page lists {pairs.length} head-to-head comparisons among {listedToolCount} tools, across {pairsByVertical.length} trades. Comparison pages exist for {totalPairs.toLocaleString('en-US')} pairs in all (every pair of tools that share a trade, plus the maintenance tools compared with each other); open any of them from the <a href="/compare-builder/" class="text-orange-600 hover:underline">comparison builder</a>. Each template-built comparison includes a decision matrix ("pick A if…" / "pick B if…"), side-by-side pricing, pros and cons from our data, FAQs, and fit in each trade both tools serve (the maintenance tools are listed under no trade, so their comparisons have no fit table). The Housecall Pro vs Jobber page is written separately and sets out prices, seat costs, where each comes out ahead in our data, and fit by trade.
      </p>
      <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm text-slate-500">
        <span><span class="font-bold text-slate-900">{pairs.length}</span> comparisons listed</span>
        <span class="text-slate-300">·</span>
        <span><span class="font-bold text-slate-900">{listedToolCount}</span> tools</span>
        <span class="text-slate-300">·</span>
        <span><span class="font-bold text-slate-900">{pairsByVertical.length}</span> trades</span>
      </div>
    </header>

    <nav class="mb-8 rounded-lg border border-slate-200 bg-slate-50 p-4">
      <div class="text-sm font-semibold text-slate-700">Jump to:</div>
      <div class="mt-2 flex flex-wrap gap-x-4 gap-y-2 text-sm">
        <a href="#featured" class="text-orange-600 hover:underline">Featured ({featuredPairs.length})</a>
        <span class="text-slate-300">·</span>
        <a href="#by-trade" class="text-orange-600 hover:underline">Browse by trade</a>
        <span class="text-slate-300">·</span>
        <a href="#all-pairs" class="text-orange-600 hover:underline">All {pairs.length} listed comparisons</a>
      </div>
    </nav>

    <section class="mb-12 rounded-2xl border border-orange-200 bg-gradient-to-br from-orange-50 to-amber-50 p-6 md:p-8">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="max-w-2xl">
          <div class="mb-2 text-xs font-bold uppercase tracking-wider text-orange-700">Interactive</div>
          <h2 class="text-xl font-bold text-slate-900 md:text-2xl">
            Don't see your specific matchup? Build a custom 2-5 tool comparison.
          </h2>
          <p class="mt-2 text-sm text-slate-700">
            The interactive builder lets you pick any 2 to 5 of our {tools.length} tools and see pricing, freshness and integrations side-by-side, with links to the full comparison page for each pair that has one.
          </p>
        </div>
        <a
          href="/compare-builder/"
          class="shrink-0 rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-orange-600"
        >
          Open the builder →
        </a>
      </div>
    </section>

    <section id="featured" class="mb-16 scroll-mt-8">
      <h2 class="mb-2 text-2xl font-bold tracking-tight text-slate-900">Featured comparisons</h2>
      <p class="mb-6 text-slate-600">
        A hand-picked set of head-to-head pages between field service and construction tools.
      </p>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {featuredPairs.map(({ a, b }) => {
          return (
            <a
              href={`/compare/${a.slug}-vs-${b.slug}/`}
              class="group rounded-lg border border-slate-200 bg-white p-5 transition hover:border-orange-400 hover:shadow-sm"
            >
              <h3 class="text-base font-semibold text-slate-900 group-hover:text-orange-600">
                {a.name} vs {b.name}
              </h3>
              <p class="mt-1 text-xs text-slate-500">
                {a.slug === 'housecall-pro' && b.slug === 'jobber' ? 'Prices · seat costs · fit by trade' : 'Decision matrix · pricing · pros and cons'}
              </p>
            </a>
          );
        })}
      </div>
    </section>

    <section id="by-trade" class="mb-16 scroll-mt-8">
      <h2 class="mb-2 text-2xl font-bold tracking-tight text-slate-900">Browse by trade</h2>
      <p class="mb-6 text-slate-600">
        Comparisons within each trade, ordered by the two tools' combined fit score for that trade.
      </p>
      <div class="space-y-10">
        {pairsByVertical.map(({ vertical, pairs: verticalPairs }) => (
          <div>
            <div class="mb-4 flex items-baseline justify-between border-b border-slate-200 pb-2">
              <h3 class="text-xl font-bold text-slate-900">
                <a href={`/${verticalToUrl(vertical.slug)}/`} class="hover:text-orange-600">
                  {vertical.name} comparisons
                </a>
              </h3>
              <span class="text-sm text-slate-500">{verticalPairs.length} pairs</span>
            </div>
            <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {verticalPairs.slice(0, 9).map(({ a, b }) => (
                <a
                  href={`/compare/${a.slug}-vs-${b.slug}/`}
                  class="group rounded-lg border border-slate-200 bg-white p-3 transition hover:border-slate-400"
                >
                  <div class="font-semibold text-slate-900 group-hover:text-orange-600 text-sm">
                    {a.name} vs {b.name}
                  </div>
                </a>
              ))}
            </div>
            {verticalPairs.length > 9 && (
              <div class="mt-3 text-sm text-slate-500">
                + {verticalPairs.length - 9} more {vertical.name.toLowerCase()} comparisons in the full list below
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    <section id="all-pairs" class="mb-12 scroll-mt-8">
      <h2 class="mb-2 text-2xl font-bold tracking-tight text-slate-900">All comparisons (alphabetical)</h2>
      <p class="mb-6 text-slate-600">
        Every comparison listed on this page, alphabetical by first tool. Use ⌘F / Ctrl+F to find a specific matchup, or the comparison builder for any other pair.
      </p>
      <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {allPairsAlphabetical.map(({ a, b }) => (
          <a
            href={`/compare/${a.slug}-vs-${b.slug}/`}
            class="rounded border border-slate-200 bg-white p-2 text-xs text-slate-700 transition hover:border-slate-400 hover:text-orange-600"
          >
            {a.name} vs {b.name}
          </a>
        ))}
      </div>
    </section>
  </section>
</Layout>
