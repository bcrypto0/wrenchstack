---
import Layout from '../../../layouts/Layout.astro';
import { asSentence,
  tools,
  formatPrice,
  verticalToUrl,
  verticals,
  isQuoteOnly,
  nonMonthlyPricingOnly,
  entryPriceLabel,
  type Tool, toolType} from '../../../lib/data';
import FreshnessBadge from '../../../components/FreshnessBadge.astro';
import { isComparisonIndexable } from '../../../lib/compare-index.mjs';
import MissingFromList from '../../../components/MissingFromList.astro';
import { priceScaling, seatUnit, formatUsd } from '../../../lib/data';

export async function getStaticPaths() {
  // Generate both directions per pair (e.g. jobber-vs-servicetitan AND
  // servicetitan-vs-jobber). The canonical tag points to the alphabetical
  // version to consolidate ranking signals.
  const pairs: { a: Tool; b: Tool }[] = [];
  for (let i = 0; i < tools.length; i++) {
    for (let j = 0; j < tools.length; j++) {
      if (i === j) continue;
      const a = tools[i];
      const b = tools[j];
      const sharedVertical = a.verticals.some((v) => b.verticals.includes(v));
      // CMMS tools serve in-house maintenance teams, not a contractor trade, so
      // they carry no trades (2026-09-30) and are compared with each other.
      const bothCmms = toolType(a) === 'cmms' && toolType(b) === 'cmms';
      if (!sharedVertical && !bothCmms) continue;
      pairs.push({ a, b });
    }
  }
  // Pairs with a hand-written definitive page (static route) are excluded
  // here so the template does not collide with the custom version. The
  // reverse-order URL stays template-generated and canonicals to the custom
  // page.
  const HAND_WRITTEN = new Set(['housecall-pro-vs-jobber']);
  return pairs
    .filter(({ a, b }) => !HAND_WRITTEN.has(`${a.slug}-vs-${b.slug}`))
    .map(({ a, b }) => ({
      params: { pair: `${a.slug}-vs-${b.slug}` },
      props: { a, b },
    }));
}

interface Props {
  a: Tool;
  b: Tool;
}

const { a, b } = Astro.props;

// Feature and integration lists are our entries' labels, not a controlled vocabulary
// (the methodology's v1.2 note: "quotes" on one entry, "estimates" on another). A label
// missing from one list means our entry does not record it, not that the tool lacks
// it, so the copy below says "listed" and never "only X has" (2026-10-01).
const label = (s: string) => s.replace(/_/g, ' ');
const sharedFeatures = a.key_features.filter((f) => b.key_features.includes(f));
const onlyA = a.key_features.filter((f) => !b.key_features.includes(f));
const onlyB = b.key_features.filter((f) => !a.key_features.includes(f));

const sharedIntegrations = a.integrations.filter((f) => b.integrations.includes(f));
const onlyAIntegrations = a.integrations.filter((f) => !b.integrations.includes(f));
const onlyBIntegrations = b.integrations.filter((f) => !a.integrations.includes(f));

const sharedVerticals = a.verticals
  .filter((v) => b.verticals.includes(v))
  .map((v) => verticals.find((x) => x.slug === v))
  .filter((v): v is NonNullable<typeof v> => v !== undefined);

// Monthly starting prices (null for quote-only tools and for the two that publish
// only one-time or per-project prices).
const aStart = a.pricing.starting_at_usd;
const bStart = b.pricing.starting_at_usd;
const cheaperTool =
  aStart !== null && bStart !== null && aStart !== bStart
    ? aStart < bStart
      ? a
      : b
    : null;
const otherOf = (t: Tool) => (t === a ? b : a);

// Price transparency: quote-only is pricing_model 'quote_only' (isQuoteOnly), never
// "starting_at_usd is null". Until 2026-10-01 these pages told readers that Trash Flow
// and Pylon, which publish one-time and per-project prices, "quote only".
const aQuote = isQuoteOnly(a);
const bQuote = isQuoteOnly(b);
// "From $29/mo", "Free tier available", or the non-monthly wording.
function shortPrice(t: Tool): string {
  if (nonMonthlyPricingOnly(t)) return 'one-time or per-project prices, not a monthly plan';
  return formatPrice(t);
}

// "starts at $29 per user a month" / "has a free tier" ("starts at a free tier" read badly).
const startsAt = (t: Tool) => (t.pricing.starting_at_usd === 0 ? 'has a free tier' : `starts at ${entryPriceLabel(t)}`);

// "a 14-day free trial" / "a free tier" / null when our data records neither.
function trialPhrase(t: Tool): string | null {
  if ((t.pricing.free_trial_days ?? 0) > 0) return `a ${t.pricing.free_trial_days}-day free trial`;
  if (t.pricing.starting_at_usd === 0) return 'a free tier';
  return null;
}

// --- VERTICAL-FIT WINNER PER SHARED VERTICAL ---
// Computed up here because the differences list, decision matrix, pros and verdict
// all use it. Since 2026-09-30 these compare vertical fit, published price and
// integrations only; the G2/Capterra ratings they used to cite were never verified.
function getVerticalWinners(): Array<{ vertical: typeof sharedVerticals[number]; aFit: number; bFit: number; winner: Tool | null }> {
  return sharedVerticals.map((v) => {
    const aFit = a.vertical_fit?.[v.slug] ?? 5;
    const bFit = b.vertical_fit?.[v.slug] ?? 5;
    const winner = aFit > bFit ? a : bFit > aFit ? b : null;
    return { vertical: v, aFit, bFit, winner };
  });
}
const verticalWinners = getVerticalWinners();
const fitWinsA = verticalWinners.filter((vw) => vw.winner === a);
const fitWinsB = verticalWinners.filter((vw) => vw.winner === b);
// The tool that fits more of the shared trades better; null on a tie.
const fitLeader = fitWinsA.length > fitWinsB.length ? a : fitWinsB.length > fitWinsA.length ? b : null;
const fitLeaderWins = fitLeader === a ? fitWinsA.length : fitWinsB.length;

// "HVAC, Plumbing or Electrical"
function joinOr(names: string[]): string {
  if (names.length <= 1) return names.join('');
  return `${names.slice(0, -1).join(', ')} or ${names[names.length - 1]}`;
}
function fitNames(wins: typeof verticalWinners): string {
  return joinOr(wins.slice(0, 3).map((vw) => vw.vertical.name));
}

// QuickBooks products named in a tool's integration list.
const QB_NAMES: Record<string, string> = {
  quickbooks_online: 'QuickBooks Online',
  quickbooks_desktop: 'QuickBooks Desktop',
  quickbooks_enterprise: 'QuickBooks Enterprise',
  quickbooks_time: 'QuickBooks Time',
  quickbooks: 'QuickBooks (product not specified)',
};
const qbList = (t: Tool) => t.integrations.filter((i) => i.includes('quickbooks')).map((i) => QB_NAMES[i] ?? label(i));

const aHasQB = qbList(a).length > 0;
const bHasQB = qbList(b).length > 0;
const aHasGLS = a.integrations.some((i) => i.includes('google_local_services'));
const bHasGLS = b.integrations.some((i) => i.includes('google_local_services'));
const aHasTrial = (a.pricing.free_trial_days ?? 0) > 0;
const bHasTrial = (b.pricing.free_trial_days ?? 0) > 0;

// Lower-case the first letter of a data phrase unless it starts an acronym ("HVAC").
const lcFirst = (s: string) => (s.length > 1 && /[a-z]/.test(s[1]) ? s.charAt(0).toLowerCase() + s.slice(1) : s);

// --- WHAT ACTUALLY SEPARATES THEM (added 2026-09-07, thin-page audit) -------
// Measured 2026-09-07: two comparison pages shared 801 of 857 unique word
// tokens (93%). This builds a list of ONLY the things that differ for this
// specific pair, from data, and the template renders it directly under the H1.
// If a pair differs in nothing here, the block renders nothing.
const verticalLabel = (slug: string) =>
  verticals.find((x) => x.slug === slug)?.name ?? slug.replace(/_/g, ' ');

const differences: string[] = [];

if (cheaperTool) {
  const dearer = otherOf(cheaperTool);
  const lo = cheaperTool.pricing.starting_at_usd as number;
  const hi = dearer.pricing.starting_at_usd as number;
  // A ratio only means something when both prices scale the same way (and the lower
  // one is not $0, which printed "Infinityx" until 2026-10-01), and per-seat prices
  // charge for the same seat (a route or a driver is not a user; seatUnit, 2026-10-05).
  const mult = lo > 0 && priceScaling(cheaperTool) === priceScaling(dearer) && seatUnit(cheaperTool) === seatUnit(dearer) ? hi / lo : null;
  differences.push(
    `**Entry price:** ${cheaperTool.name} ${startsAt(cheaperTool)}; ${dearer.name} ${startsAt(dearer)}` +
      (mult !== null && mult >= 1.5 ? `, so ${dearer.name}'s entry price is ${mult >= 10 ? Math.round(mult) : mult.toFixed(1)} times ${cheaperTool.name}'s.` : '.')
  );
} else if (aQuote !== bQuote) {
  const open = aQuote ? b : a;
  const closed = aQuote ? a : b;
  differences.push(
    `**Price transparency:** ${open.name} publishes its prices (${shortPrice(open)}). ${closed.name} does not, so you need a quote from ${closed.name} to compare them.`
  );
} else if (!aQuote && !bQuote && nonMonthlyPricingOnly(a) !== nonMonthlyPricingOnly(b)) {
  const nm = nonMonthlyPricingOnly(a) ? a : b;
  const monthly = otherOf(nm);
  differences.push(
    `**Price structure:** ${nm.name} publishes one-time or per-project prices rather than a monthly plan; ${monthly.name} ${startsAt(monthly)}. Compare the total over the period you expect to use each.`
  );
}

const aOnlyVerticals = a.verticals.filter((v: string) => !b.verticals.includes(v));
const bOnlyVerticals = b.verticals.filter((v: string) => !a.verticals.includes(v));
if (aOnlyVerticals.length || bOnlyVerticals.length) {
  const parts: string[] = [];
  if (aOnlyVerticals.length) parts.push(`${a.name} serves ${aOnlyVerticals.map(verticalLabel).join(', ')}`);
  if (bOnlyVerticals.length) parts.push(`${b.name} serves ${bOnlyVerticals.map(verticalLabel).join(', ')}`);
  differences.push(`**Trades served:** ${parts.join('; ')}. The other tool's entry does not list ${aOnlyVerticals.length + bOnlyVerticals.length === 1 ? 'it' : 'them'}.`);
}

if (aHasTrial !== bHasTrial) {
  const t = aHasTrial ? a : b;
  const other = otherOf(t);
  differences.push(
    `**Free trial:** ${t.name} offers a ${t.pricing.free_trial_days}-day free trial. ${other.pricing.starting_at_usd === 0 ? `${other.name} has a free tier instead.` : `Our data records no free trial for ${other.name}.`}`
  );
}

if (onlyAIntegrations.length || onlyBIntegrations.length) {
  const fmt = (list: string[]) => list.slice(0, 4).map(label).join(', ');
  const parts: string[] = [];
  if (onlyAIntegrations.length) parts.push(`${a.name}: ${fmt(onlyAIntegrations)}`);
  if (onlyBIntegrations.length) parts.push(`${b.name}: ${fmt(onlyBIntegrations)}`);
  differences.push(`**Integrations listed for one tool only:** ${parts.join('; ')}.`);
}

if (fitWinsA.length || fitWinsB.length) {
  const parts: string[] = [];
  const fmtWins = (wins: typeof verticalWinners, t: Tool) =>
    `${t.name} scores higher for ${wins.slice(0, 3).map((vw) => `${vw.vertical.name} (${t === a ? vw.aFit : vw.bFit}/10 vs ${t === a ? vw.bFit : vw.aFit}/10)`).join(', ')}`;
  if (fitWinsA.length) parts.push(fmtWins(fitWinsA, a));
  if (fitWinsB.length) parts.push(fmtWins(fitWinsB, b));
  differences.push(`**Fit for shared trades:** ${parts.join('; ')}.`);
}

if (onlyA.length || onlyB.length) {
  const parts: string[] = [];
  if (onlyA.length) parts.push(`${a.name}: ${onlyA.slice(0, 3).map(label).join(', ')}`);
  if (onlyB.length) parts.push(`${b.name}: ${onlyB.slice(0, 3).map(label).join(', ')}`);
  differences.push(`**Features listed for one tool only:** ${parts.join('; ')}.`);
}

// --- DECISION MATRIX ---
// Every line states a difference in our data. Removed 2026-10-01: "requires a demo"
// and "requires Zapier or manual workarounds" (no source said so), and the feature-count
// line (the methodology dropped feature counts in v1.2 as a measure of how finely an
// entry was written, not of the product).
function getDecisionMatrix(): { pickA: string[]; pickB: string[] } {
  const pickA: string[] = [];
  const pickB: string[] = [];
  const side = (t: Tool) => (t === a ? pickA : pickB);

  // Best-for lines (always include)
  pickA.push(`Your situation matches **${a.name}'s target profile**: ${a.best_for}`);
  pickB.push(`Your situation matches **${b.name}'s target profile**: ${b.best_for}`);

  // Lower entry price
  if (cheaperTool) {
    const other = otherOf(cheaperTool);
    side(cheaperTool).push(`**Entry price matters most**: ${cheaperTool.name} ${startsAt(cheaperTool)}; ${other.name} ${startsAt(other)}`);
  }

  // Free trial
  for (const t of [a, b]) {
    const other = otherOf(t);
    if ((t.pricing.free_trial_days ?? 0) > 0 && !((other.pricing.free_trial_days ?? 0) > 0) && other.pricing.starting_at_usd !== 0) {
      side(t).push(`**You want to try before buying**: ${t.name} offers a ${t.pricing.free_trial_days}-day free trial; our data records none for ${other.name}`);
    }
  }

  // QuickBooks
  if (aHasQB && !bHasQB) {
    pickA.push(`**QuickBooks matters**: ${a.name} lists a QuickBooks integration (${qbList(a).join(', ')}); our entry for ${b.name} lists none`);
  } else if (bHasQB && !aHasQB) {
    pickB.push(`**QuickBooks matters**: ${b.name} lists a QuickBooks integration (${qbList(b).join(', ')}); our entry for ${a.name} lists none`);
  }

  // Better vertical fit in the buyer's trade
  if (fitWinsA.length) {
    pickA.push(`**You work in ${fitNames(fitWinsA)}**: ${a.name} has the higher vertical-fit score there (${fitWinsA[0].vertical.name}: ${fitWinsA[0].aFit}/10 vs ${fitWinsA[0].bFit}/10)`);
  }
  if (fitWinsB.length) {
    pickB.push(`**You work in ${fitNames(fitWinsB)}**: ${b.name} has the higher vertical-fit score there (${fitWinsB[0].vertical.name}: ${fitWinsB[0].bFit}/10 vs ${fitWinsB[0].aFit}/10)`);
  }

  // Published prices vs quote-only
  if (!aQuote && bQuote) {
    pickA.push(`**You want to budget before asking for a quote**: ${a.name} publishes its prices (${shortPrice(a)}); ${b.name} quotes only`);
  } else if (!bQuote && aQuote) {
    pickB.push(`**You want to budget before asking for a quote**: ${b.name} publishes its prices (${shortPrice(b)}); ${a.name} quotes only`);
  }

  // Multi-vertical
  if (a.verticals.length > b.verticals.length + 1) {
    pickA.push(`**You serve several trades**: ${a.name} serves ${a.verticals.length} trades in our data, against ${b.verticals.length} for ${b.name}`);
  } else if (b.verticals.length > a.verticals.length + 1) {
    pickB.push(`**You serve several trades**: ${b.name} serves ${b.verticals.length} trades in our data, against ${a.verticals.length} for ${a.name}`);
  }

  // Integration count (a Fit Score factor)
  if (a.integrations.length > b.integrations.length + 1) {
    pickA.push(`**Integrations matter**: ${a.name} lists ${a.integrations.length} integrations in our data, against ${b.integrations.length} for ${b.name}`);
  } else if (b.integrations.length > a.integrations.length + 1) {
    pickB.push(`**Integrations matter**: ${b.name} lists ${b.integrations.length} integrations in our data, against ${a.integrations.length} for ${a.name}`);
  }

  // Google Local Services Ads
  if (aHasGLS && !bHasGLS) {
    pickA.push(`**Google Local Services Ads bring in your calls**: ${a.name} lists a Google Local Services Ads integration; our entry for ${b.name} does not`);
  } else if (bHasGLS && !aHasGLS) {
    pickB.push(`**Google Local Services Ads bring in your calls**: ${b.name} lists a Google Local Services Ads integration; our entry for ${a.name} does not`);
  }

  // Founding year (only if more than five years apart)
  if (a.founded && b.founded && (a.founded < b.founded - 5)) {
    pickA.push(`**You want a longer track record**: ${a.name} was founded in ${a.founded}, ${b.name} in ${b.founded}`);
  } else if (b.founded && a.founded && (b.founded < a.founded - 5)) {
    pickB.push(`**You want a longer track record**: ${b.name} was founded in ${b.founded}, ${a.name} in ${a.founded}`);
  }

  return { pickA: pickA.slice(0, 6), pickB: pickB.slice(0, 6) };
}

const decisionMatrix = getDecisionMatrix();

// --- PRICING TABLE AND ANALYSIS ---
// Bluebeam Revu's tier prices are per user per YEAR (pricing_model annual_per_user);
// until 2026-10-01 the table printed them as "$590/mo". Tools that publish only
// one-time or per-project prices have no tier figures: the price is in the tier name
// or the pricing note, so the cell no longer says "Custom".
function tierCell(t: Tool, i: number): string {
  const tierName = t.pricing.tiers[i];
  if (!tierName) return '-';
  const p = t.pricing.tier_prices_usd?.[i];
  if (nonMonthlyPricingOnly(t)) return tierName;
  if (p === null || p === undefined) return `${tierName}: quote`;
  if (p === 0) return `${tierName}: free`;
  if (t.pricing.pricing_model === 'annual_per_user') return `${tierName}: $${formatUsd(p)} per ${seatUnit(t)} a year`;
  return `${tierName}: $${formatUsd(p)}/mo`;
}

function topTierPhrase(t: Tool): string {
  const n = t.pricing.tiers.length;
  const top = t.pricing.tier_prices_usd?.[n - 1];
  if (n < 2 || typeof top !== 'number' || top <= 0 || top === t.pricing.starting_at_usd) return '';
  const unit = t.pricing.pricing_model === 'annual_per_user' ? `per ${seatUnit(t)} a year` : 'a month';
  return `; its top published tier, ${t.pricing.tiers[n - 1]}, is $${formatUsd(top)} ${unit}`;
}

function describePrice(t: Tool): string {
  if (isQuoteOnly(t)) return `${t.name} publishes no price, so ask for a written quote for your team size.`;
  if (nonMonthlyPricingOnly(t)) return `${t.name} publishes one-time or per-project prices rather than a monthly plan (listed in its full review), so compare the total over the period you expect to use it.`;
  if (t.pricing.starting_at_usd === 0) return `${t.name} has a free tier (${t.pricing.tiers[0]})${topTierPhrase(t)}.`;
  return `${t.name} starts at ${entryPriceLabel(t)} on ${t.pricing.tiers[0]}${topTierPhrase(t)}.`;
}

function pricingAnalysis(): string {
  if (aQuote && bQuote) {
    return `Neither ${a.name} nor ${b.name} publishes a price, so both need a quote before you can compare them. Request quotes for the same team size and feature set, and get what is included (users, integrations, onboarding) in writing.`;
  }
  let analysis = `${describePrice(a)} ${describePrice(b)}`;

  // Structure comes from pricing_model (2026-09-10); matching 'unlimited users'
  // in the note text called per-user tools flat.
  const aIsFlat = priceScaling(a) === 'flat';
  const bIsFlat = priceScaling(b) === 'flat';
  const flatVsPerUser = (aIsFlat && priceScaling(b) === 'per_user') || (bIsFlat && priceScaling(a) === 'per_user');
  if (flatVsPerUser) {
    const flatTool = aIsFlat ? a : b;
    const perUserTool = aIsFlat ? b : a;
    analysis += ` ${flatTool.name} charges a flat monthly price per plan while ${perUserTool.name} charges per ${seatUnit(perUserTool)}, so ${flatTool.name} gets relatively cheaper as your team grows; check each plan's user or usage limits.`;
  } else if (cheaperTool) {
    // An invented "both platforms typically converge in price at scale" followed this
    // until 2026-10-01; no data supports it.
    const diff = Math.abs((aStart as number) - (bStart as number));
    const diffText = Number.isInteger(diff) ? String(diff) : diff.toFixed(2);
    analysis += ` ${cheaperTool.name}'s entry price is $${diffText} a month lower.`;
  }

  return analysis;
}

// --- PROS PER TOOL (from data) ---
function getPros(t: Tool, isCheaper: boolean, fitWins: typeof verticalWinners): string[] {
  const pros: string[] = [];
  const other = otherOf(t);
  const qb = qbList(t);
  const hasStripe = t.integrations.some((i) => i.includes('stripe'));
  const hasGLS = t.integrations.some((i) => i.includes('google_local_services'));
  const hasFreeTrial = (t.pricing.free_trial_days ?? 0) > 0;

  if (isCheaper) pros.push(`Lower entry price: ${formatPrice(t)}`);
  if (!isQuoteOnly(t) && isQuoteOnly(other)) pros.push(`Publishes its prices; ${other.name} quotes only`);
  if (hasFreeTrial) pros.push(`${t.pricing.free_trial_days}-day free trial`);
  if (fitWins.length) pros.push(`Higher vertical-fit score for ${fitNames(fitWins)}`);
  if (qb.length) pros.push(`QuickBooks integration listed (${qb.join(', ')})`);
  if (hasStripe) pros.push(`Stripe integration listed`);
  if (hasGLS) pros.push(`Google Local Services Ads integration listed`);
  if (t.verticals.length >= 5) pros.push(`Serves ${t.verticals.length} trades in our data`);
  if (t.founded && t.founded <= 2015) pros.push(`Founded in ${t.founded}`);
  if (priceScaling(t) === 'flat') pros.push(`Flat monthly price per plan, not per user`);

  return pros.slice(0, 5);
}

// --- CONS PER TOOL (parsed from weaknesses + data gaps) ---
function getCons(t: Tool, otherT: Tool): string[] {
  const cons: string[] = [];
  // Parse the weaknesses string into bullets. Split on semicolons and sentence ends
  // only: splitting on every "." cut prices such as "$29.90" in two.
  if (t.weaknesses) {
    const parsed = t.weaknesses
      .split(/;\s*|\.\s+(?=[A-Z])/)
      .map((s) => s.trim().replace(/\.$/, ''))
      .filter((s) => s.length > 5)
      .map((s) => s.charAt(0).toUpperCase() + s.slice(1));
    cons.push(...parsed);
  }
  if (qbList(otherT).length && !qbList(t).length) cons.push(`No QuickBooks integration in our data (${otherT.name} lists one)`);

  const tHasTrial = (t.pricing.free_trial_days ?? 0) > 0;
  const otherHasTrial = (otherT.pricing.free_trial_days ?? 0) > 0;
  if (otherHasTrial && !tHasTrial && t.pricing.starting_at_usd !== 0) cons.push(`No free trial in our data (${otherT.name} offers ${otherT.pricing.free_trial_days} days)`);

  if (isQuoteOnly(t)) cons.push(`No published price: you need a quote`);

  return cons.slice(0, 5);
}

const prosA = getPros(a, cheaperTool === a, fitWinsA);
const prosB = getPros(b, cheaperTool === b, fitWinsB);
const consA = getCons(a, b);
const consB = getCons(b, a);

// --- FAQs ---
// Rewritten 2026-10-01 from data. Removed: implementation durations by price tier
// ("3-6 months", "4-8 weeks", "1-3 weeks"), migration and parallel-run durations,
// support channels and response times by tier, and "the lower-priced option typically
// wins": none came from a vendor or from our data.
function cheaperAnswer(): string {
  if (cheaperTool) {
    const other = otherOf(cheaperTool);
    return `${cheaperTool.name} has the lower entry price: ${entryPriceLabel(cheaperTool)}, against ${entryPriceLabel(other)} for ${other.name}. Total cost depends on your team size, the plan you need and any add-ons; see the pricing table above.`;
  }
  if (aQuote && bQuote) return `Neither publishes a price. Request quotes from both for the same team size and features.`;
  if (aQuote !== bQuote) {
    const open = aQuote ? b : a;
    const closed = aQuote ? a : b;
    return `${open.name} publishes its prices (${shortPrice(open)}); ${closed.name} quotes only, so ask ${closed.name} for a written quote at your team size before comparing.`;
  }
  if (nonMonthlyPricingOnly(a) || nonMonthlyPricingOnly(b)) {
    return `${[a, b].filter(nonMonthlyPricingOnly).map((t) => t.name).join(' and ')} ${nonMonthlyPricingOnly(a) && nonMonthlyPricingOnly(b) ? 'publish' : 'publishes'} one-time or per-project prices rather than a monthly plan, so compare the total over the period you expect to use each.`;
  }
  if (aStart === 0 && bStart === 0) return `Both have a free tier. Total cost depends on the paid plan you need, if any; see the pricing table above.`;
  // Same figure, charged differently ($60 per user against $60 a month for the company):
  // until 2026-10-01 this said "Both start at $60 per user a month" and then contradicted
  // itself in brackets.
  if (entryPriceLabel(a) !== entryPriceLabel(b)) {
    return `${a.name} starts at ${entryPriceLabel(a)}; ${b.name} starts at ${entryPriceLabel(b)}. The figure is the same but it is charged differently, so compare the two at your team size.`;
  }
  return `Both start at ${entryPriceLabel(a)}. Total cost depends on your team size and the plan you need.`;
}

const qbSentence = (t: Tool) =>
  qbList(t).length ? `${t.name} lists ${qbList(t).join(' and ')}.` : `Our entry for ${t.name} lists no QuickBooks integration.`;
const trialAnswer = (t: Tool) => {
  const p = trialPhrase(t);
  return p ? `${t.name}: ${p}.` : `${t.name}: no free trial in our data.`;
};

const faqs = [
  {
    q: `Which is better, ${a.name} or ${b.name}?`,
    a: `It depends on your trade, team size and budget. ${a.name} is best for ${lcFirst(asSentence(a.best_for))} ${b.name} is best for ${lcFirst(asSentence(b.best_for))} ${verticalWinners.length ? 'See the decision matrix above, and the trade-by-trade fit table if you work in one trade.' : 'See the decision matrix above.'}`,
  },
  {
    q: `Is ${a.name} cheaper than ${b.name}?`,
    a: cheaperAnswer(),
  },
  {
    q: `Can ${a.name} and ${b.name} integrate with QuickBooks?`,
    a: `${qbSentence(a)} ${qbSentence(b)} Check which way each sync runs, and on which plans, in each tool's full review before you buy.`,
  },
  {
    q: `Do ${a.name} or ${b.name} offer a free trial?`,
    a: `${trialAnswer(a)} ${trialAnswer(b)}`,
  },
  {
    q: `Can I move from ${a.name} to ${b.name} (or the other way)?`,
    a: `Our data does not record migration support for either tool. Ask both vendors which records they import and export (customers, jobs, invoices, recurring agreements, price books), in which file format, and whether they help with the import.`,
  },
  {
    q: `${a.name} vs ${b.name}: which has better customer support?`,
    a: `Our data does not record support channels or response times for either tool. Ask each vendor which support comes with the plan you would buy. Each full review links to G2 and Capterra, where you can read current user reviews.`,
  },
  {
    q: `Which suits a solo contractor, and which a growing team?`,
    a: `Our data puts ${a.name}'s best team size at ${a.best_team_size ?? 'an unrecorded size'} and ${b.name}'s at ${b.best_team_size ?? 'an unrecorded size'}. ${a.name}'s entry price is ${entryPriceLabel(a)}; ${b.name}'s is ${entryPriceLabel(b)}. Price both at the team size you expect to have, not only today's.`,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// The year in the title is the year of the older of the two price checks, so a
// rebuild in a later year does not claim a fresher comparison than the data.
const checkedDates = [...new Set([a.pricing.verified_date, b.pricing.verified_date].filter(Boolean))].sort();
const titleYear = checkedDates.length ? checkedDates[0].slice(0, 4) : String(new Date().getFullYear());
const pageTitle = `${a.name} vs ${b.name} (${titleYear}): Side-by-Side Comparison`;
const pageDescription = `${a.name} vs ${b.name} compared head-to-head: pricing, features, integrations, pros and cons.${checkedDates.length ? ` Prices checked ${checkedDates.join(' and ')}.` : ''}`;

// Canonical URL points to the alphabetical version of the pair so Google
// consolidates ranking signals across both directions (X-vs-Y and Y-vs-X).
const canonicalSlugs = [a.slug, b.slug].sort();
const canonical = `https://wrenchstack.com/compare/${canonicalSlugs.join('-vs-')}/`;

// Keep only canonical-direction, high-demand pairs in the index; noindex the
// reverse-order dupes and long-tail pairs (see compare-index.mjs / SEO audit).
const noindex = !isComparisonIndexable(a.slug, b.slug);

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Compare', url: '/compare/' },
  { name: `${a.name} vs ${b.name}`, url: `/compare/${a.slug}-vs-${b.slug}/` },
];
---

<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs} canonical={canonical} noindex={noindex} affiliate>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <article class="mx-auto max-w-5xl px-4 py-12">
    <nav class="mb-6 text-sm text-slate-500">
      <a href="/" class="hover:text-slate-900">Home</a>
      <span class="mx-2">/</span>
      <a href="/tools/" class="hover:text-slate-900">Tools</a>
      <span class="mx-2">/</span>
      <span class="text-slate-900">{a.name} vs {b.name}</span>
    </nav>

    <header class="mb-10">
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">
        {a.name} vs {b.name}
      </h1>
      <p class="mt-4 text-base text-slate-600 sm:text-lg">
        Head-to-head comparison of pricing, features, integrations, and use-case fit.
      </p>
      <div class="mt-4 flex flex-wrap items-center gap-3">
        <FreshnessBadge tool={a} variant="full" showDate={true} />
        <FreshnessBadge tool={b} variant="full" showDate={true} />
      </div>

      <div class="mt-6 rounded-lg border border-orange-200 bg-orange-50 p-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <div class="font-semibold text-slate-900">Considering switching {a.name} → {b.name}?</div>
            <div class="text-sm text-slate-700">Estimate a 12-month switching cost: the subscription difference, the implementation fee from your quote, and assumed training time and a month of running both systems.</div>
          </div>
          <a
            href={`/cost-of-switch/?from=${a.slug}&to=${b.slug}`}
            class="shrink-0 rounded-md bg-orange-500 px-4 py-2 text-sm font-semibold text-white hover:bg-orange-600"
          >
            Calculate switch cost →
          </a>
        </div>
      </div>
    </header>

    <section class="mb-12 grid gap-6 md:grid-cols-2">
      {[a, b].map((t) => {
        return (
          <div class="rounded-lg border border-slate-200 bg-white p-6">
            <h2 class="text-2xl font-bold text-slate-900">
              <a href={`/tools/${t.slug}/`} class="hover:text-orange-600">{t.name}</a>
            </h2>
            <p class="mt-2 text-sm italic text-slate-600">{t.tagline}</p>
            <dl class="mt-4 space-y-2 text-sm">
              <div class="flex justify-between">
                <dt class="text-slate-500">Starting price</dt>
                <dd class="font-semibold text-slate-900">{formatPrice(t)}</dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-slate-500">Best team size</dt>
                <dd class="font-semibold text-slate-900">{t.best_team_size ?? 'n/a'}</dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-slate-500">Free trial</dt>
                <dd class="font-semibold text-slate-900">
                  {t.pricing.free_trial_days && t.pricing.free_trial_days > 0 ? `${t.pricing.free_trial_days} days` : t.pricing.starting_at_usd === 0 ? 'Free tier instead' : 'None listed'}
                </dd>
              </div>
            </dl>
            <a
              href={t.affiliate_url.startsWith('http') ? t.affiliate_url : t.vendor_url}
              rel="sponsored nofollow noopener"
              target="_blank"
              class="mt-4 inline-block rounded-md bg-orange-500 px-4 py-2 text-sm font-semibold text-white hover:bg-orange-600"
            >
              Visit {t.name} →
            </a>
          </div>
        );
      })}
    </section>

    {differences.length > 0 && (
      <section class="mb-12">
        <h2 class="mb-4 text-2xl font-bold text-slate-900">What actually separates them</h2>
        <p class="mb-4 text-sm text-slate-600">
          Only the points where our data on {a.name} and {b.name} differs. A feature or integration missing from one tool's list means our entry does not record it, not that the tool lacks it.
          Everything they share is further down.
        </p>
        <ul class="space-y-3 rounded-lg border border-orange-200 bg-orange-50 p-6">
          {differences.map((d) => (
            <li class="flex gap-3 text-slate-800">
              <span class="font-bold text-orange-600">→</span>
              <span set:html={d.replace(/\*\*(.+?)\*\*/g, '<strong class="text-slate-900">$1</strong>')} />
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="mb-12">
      <h2 class="mb-4 text-2xl font-bold text-slate-900">Quick verdict</h2>
      <div class="rounded-lg bg-slate-50 p-6 text-slate-800">
        <p class="mb-2">
          <strong class="text-slate-900">{a.name}:</strong> {asSentence(a.best_for)}
        </p>
        <p>
          <strong class="text-slate-900">{b.name}:</strong> {asSentence(b.best_for)}
        </p>
        {fitLeader && (
          <p class="mt-3 text-sm text-slate-600">
            Vertical fit favors <strong>{fitLeader.name}</strong> in {fitLeaderWins} of {verticalWinners.length} shared {verticalWinners.length === 1 ? 'trade' : 'trades'}.
          </p>
        )}
        {cheaperTool && (
          <p class="mt-1 text-sm text-slate-600">
            <strong>{cheaperTool.name}</strong> has the lower starting price ({formatPrice(cheaperTool)}).
          </p>
        )}
        {aQuote !== bQuote && (
          <p class="mt-1 text-sm text-slate-600">
            <strong>{aQuote ? b.name : a.name}</strong> publishes its prices ({shortPrice(aQuote ? b : a)}); {aQuote ? a.name : b.name} quotes only.
          </p>
        )}
        {a.integrations.length !== b.integrations.length && (
          <p class="mt-1 text-sm text-slate-600">
            <strong>{a.integrations.length > b.integrations.length ? a.name : b.name}</strong> lists more integrations in our data ({Math.max(a.integrations.length, b.integrations.length)} vs {Math.min(a.integrations.length, b.integrations.length)}).
          </p>
        )}
      </div>
    </section>

    <section class="mb-12">
      <h2 class="mb-4 text-2xl font-bold text-slate-900">Decision matrix: which one is right for you?</h2>
      <div class="grid gap-6 md:grid-cols-2">
        <div class="rounded-lg border border-emerald-200 bg-emerald-50 p-6">
          <h3 class="mb-4 text-lg font-bold text-emerald-900">Pick {a.name} if…</h3>
          <ul class="space-y-3 text-sm text-emerald-900">
            {decisionMatrix.pickA.map((item) => (
              <li class="flex gap-2">
                <span class="font-bold text-emerald-700">→</span>
                <span set:html={item.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')} />
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-lg border border-blue-200 bg-blue-50 p-6">
          <h3 class="mb-4 text-lg font-bold text-blue-900">Pick {b.name} if…</h3>
          <ul class="space-y-3 text-sm text-blue-900">
            {decisionMatrix.pickB.map((item) => (
              <li class="flex gap-2">
                <span class="font-bold text-blue-700">→</span>
                <span set:html={item.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')} />
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="mb-12">
      <h2 class="mb-4 text-2xl font-bold text-slate-900">Pricing side-by-side</h2>
      <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
        <table class="w-full text-sm">
          <thead class="bg-slate-50 text-left text-slate-700">
            <tr>
              <th class="p-3 font-semibold">Tier</th>
              <th class="p-3 font-semibold">{a.name}</th>
              <th class="p-3 font-semibold">{b.name}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {[0, 1, 2, 3].map((i) => {
              if (!a.pricing.tiers[i] && !b.pricing.tiers[i]) return null;
              return (
                <tr>
                  <td class="p-3 font-semibold text-slate-900">Tier {i + 1}</td>
                  <td class="p-3 text-slate-700">{tierCell(a, i)}</td>
                  <td class="p-3 text-slate-700">{tierCell(b, i)}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-slate-700 leading-relaxed">{pricingAnalysis()}</p>
    </section>

    <section class="mb-12">
      <h2 class="mb-4 text-2xl font-bold text-slate-900">Pros & cons</h2>
      <div class="grid gap-6 md:grid-cols-2">
        <div>
          <h3 class="mb-3 text-lg font-bold text-slate-900">{a.name}</h3>
          {prosA.length > 0 && (
            <div class="mb-4 rounded-lg border border-emerald-200 bg-emerald-50 p-4">
              <div class="mb-2 text-xs font-semibold uppercase tracking-wider text-emerald-700">Pros</div>
              <ul class="space-y-1.5 text-sm text-emerald-900">
                {prosA.map((p) => <li>+ {p}</li>)}
              </ul>
            </div>
          )}
          <div class="rounded-lg border border-orange-200 bg-orange-50 p-4">
            <div class="mb-2 text-xs font-semibold uppercase tracking-wider text-orange-700">Cons</div>
            <ul class="space-y-1.5 text-sm text-orange-900">
              {consA.map((c) => <li>− {c}</li>)}
            </ul>
          </div>
        </div>
        <div>
          <h3 class="mb-3 text-lg font-bold text-slate-900">{b.name}</h3>
          {prosB.length > 0 && (
            <div class="mb-4 rounded-lg border border-emerald-200 bg-emerald-50 p-4">
              <div class="mb-2 text-xs font-semibold uppercase tracking-wider text-emerald-700">Pros</div>
              <ul class="space-y-1.5 text-sm text-emerald-900">
                {prosB.map((p) => <li>+ {p}</li>)}
              </ul>
            </div>
          )}
          <div class="rounded-lg border border-orange-200 bg-orange-50 p-4">
            <div class="mb-2 text-xs font-semibold uppercase tracking-wider text-orange-700">Cons</div>
            <ul class="space-y-1.5 text-sm text-orange-900">
              {consB.map((c) => <li>− {c}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="mb-12">
      <h2 class="mb-4 text-2xl font-bold text-slate-900">Feature comparison</h2>
      <p class="mb-4 text-sm text-slate-600">
        Features as listed in our entries. The lists use different words for similar features, so check a feature you need on both vendors' sites.
      </p>
      <div class="grid gap-4 md:grid-cols-3">
        <div class="rounded-lg border border-slate-200 bg-white p-4">
          <h3 class="mb-2 text-sm font-semibold uppercase tracking-wider text-slate-500">
            Listed for {a.name} only
          </h3>
          {onlyA.length > 0 ? (
            <ul class="space-y-1 text-sm text-slate-700">
              {onlyA.map((f) => <li>+ {label(f)}</li>)}
            </ul>
          ) : (
            <p class="text-sm text-slate-500">None</p>
          )}
        </div>
        <div class="rounded-lg border border-green-200 bg-green-50 p-4">
          <h3 class="mb-2 text-sm font-semibold uppercase tracking-wider text-green-700">
            Listed for both
          </h3>
          {sharedFeatures.length > 0 ? (
            <ul class="space-y-1 text-sm text-green-900">
              {sharedFeatures.map((f) => <li>✓ {label(f)}</li>)}
            </ul>
          ) : (
            <p class="text-sm text-green-700">None</p>
          )}
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-4">
          <h3 class="mb-2 text-sm font-semibold uppercase tracking-wider text-slate-500">
            Listed for {b.name} only
          </h3>
          {onlyB.length > 0 ? (
            <ul class="space-y-1 text-sm text-slate-700">
              {onlyB.map((f) => <li>+ {label(f)}</li>)}
            </ul>
          ) : (
            <p class="text-sm text-slate-500">None</p>
          )}
        </div>
      </div>
    </section>

    <section class="mb-12">
      <h2 class="mb-4 text-2xl font-bold text-slate-900">Integrations</h2>
      <div class="grid gap-4 md:grid-cols-3">
        <div class="rounded-lg border border-slate-200 bg-white p-4">
          <h3 class="mb-2 text-sm font-semibold uppercase tracking-wider text-slate-500">
            Listed for {a.name} only
          </h3>
          {onlyAIntegrations.length > 0 ? (
            <ul class="space-y-1 text-sm text-slate-700">
              {onlyAIntegrations.map((f) => <li>+ {label(f)}</li>)}
            </ul>
          ) : (
            <p class="text-sm text-slate-500">None</p>
          )}
        </div>
        <div class="rounded-lg border border-green-200 bg-green-50 p-4">
          <h3 class="mb-2 text-sm font-semibold uppercase tracking-wider text-green-700">
            Listed for both
          </h3>
          {sharedIntegrations.length > 0 ? (
            <ul class="space-y-1 text-sm text-green-900">
              {sharedIntegrations.map((f) => <li>✓ {label(f)}</li>)}
            </ul>
          ) : (
            <p class="text-sm text-green-700">None in common in our data</p>
          )}
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-4">
          <h3 class="mb-2 text-sm font-semibold uppercase tracking-wider text-slate-500">
            Listed for {b.name} only
          </h3>
          {onlyBIntegrations.length > 0 ? (
            <ul class="space-y-1 text-sm text-slate-700">
              {onlyBIntegrations.map((f) => <li>+ {label(f)}</li>)}
            </ul>
          ) : (
            <p class="text-sm text-slate-500">None</p>
          )}
        </div>
      </div>
    </section>

    {verticalWinners.length > 0 && (
      <section class="mb-12">
        <h2 class="mb-4 text-2xl font-bold text-slate-900">Which fits better in each trade</h2>
        <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
          <table class="w-full text-sm">
            <thead class="bg-slate-50 text-left text-slate-700">
              <tr>
                <th class="p-3 font-semibold">Trade</th>
                <th class="p-3 font-semibold text-center">{a.name} fit</th>
                <th class="p-3 font-semibold text-center">{b.name} fit</th>
                <th class="p-3 font-semibold">Winner</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {verticalWinners.map((vw) => (
                <tr>
                  <td class="p-3 font-semibold text-slate-900">
                    <a href={`/${verticalToUrl(vw.vertical.slug)}/`} class="hover:text-orange-600">{vw.vertical.name}</a>
                  </td>
                  <td class="p-3 text-center text-slate-700">{vw.aFit} / 10</td>
                  <td class="p-3 text-center text-slate-700">{vw.bFit} / 10</td>
                  <td class="p-3 text-slate-700">
                    {vw.winner ? (
                      <span class="font-semibold text-slate-900">{vw.winner.name}</span>
                    ) : (
                      <span class="text-slate-500">Tie</span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-2 text-xs text-slate-500">
          Vertical-fit scores (1-10) rate how well each tool is built for the trade, checked against the trades the vendor's own pages say it serves. See <a href="/methodology/" class="underline hover:text-slate-700">methodology</a>.
        </p>
      </section>
    )}

    <section class="mb-12">
      <h2 class="mb-6 text-2xl font-bold text-slate-900">Frequently asked questions</h2>
      <div class="space-y-4">
        {faqs.map((f) => (
          <details class="rounded-lg border border-slate-200 bg-white p-4">
            <summary class="cursor-pointer font-semibold text-slate-900">{f.q}</summary>
            <p class="mt-3 text-slate-700 leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">Need a deeper look?</h2>
      <p class="mt-2 text-slate-300">
        See our full reviews with each tool's pricing tiers, integrations and weaknesses.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a
          href={`/tools/${a.slug}/`}
          class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100"
        >
          Full {a.name} review →
        </a>
        <a
          href={`/tools/${b.slug}/`}
          class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100"
        >
          Full {b.name} review →
        </a>
      </div>
    </section>
    <MissingFromList competitors={[a.name, b.name]} />
  </article>
</Layout>
