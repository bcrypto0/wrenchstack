---
import Layout from '../../../layouts/Layout.astro';
import { getTool, aggregateRating, wrenchStackScore } from '../../../lib/data';

// The definitive, hand-written version of the most-searched residential FSM
// comparison. This static route overrides the generic [pair] template (which
// excludes this slug in getStaticPaths). Every price on this page was
// re-verified by a human against both vendors' live pricing pages on
// 2026-08-27; the seat-cost tables are computed from those published numbers
// at build time.

const jobber = getTool('jobber')!;
const hcp = getTool('housecall-pro')!;
const VERIFIED = '2026-08-27';

const jScore = wrenchStackScore(jobber);
const hScore = wrenchStackScore(hcp);
const jRating = aggregateRating(jobber)?.toFixed(1);
const hRating = aggregateRating(hcp)?.toFixed(1);

// Housecall Pro's published structure (verified 2026-08-27):
// annual-billed monthly equivalents. Basic $59 (1 user only), Essentials $149
// (5 users included, +$100/extra), MAX $299 (8 users included, +$75/extra).
function hcpCheapest(techs: number): { plan: string; monthly: number } {
  const options: { plan: string; monthly: number }[] = [];
  if (techs <= 1) options.push({ plan: 'Basic', monthly: 59 });
  options.push({ plan: 'Essentials', monthly: 149 + Math.max(0, techs - 5) * 100 });
  options.push({ plan: 'MAX', monthly: 299 + Math.max(0, techs - 8) * 75 });
  return options.sort((x, y) => x.monthly - y.monthly)[0];
}
const teamSizes = [1, 2, 3, 5, 6, 7, 8, 10, 12];
const hcpTable = teamSizes.map((n) => ({ n, ...hcpCheapest(n) }));

const sharedVerticals: { slug: string; name: string }[] = [
  { slug: 'hvac', name: 'HVAC' },
  { slug: 'plumbing', name: 'Plumbing' },
  { slug: 'electrical', name: 'Electrical' },
  { slug: 'cleaning', name: 'Cleaning' },
  { slug: 'handyman', name: 'Handyman' },
  { slug: 'pressure_washing', name: 'Pressure washing' },
  { slug: 'waste_removal', name: 'Waste removal' },
];

const faqs = [
  {
    q: 'Is Jobber or Housecall Pro cheaper?',
    a: `For a solo operator, Jobber: Core is $29/month billed annually against Housecall Pro Basic at $59. For a 5-person team the gap narrows or flips depending on which Jobber plan the team needs, because Housecall Pro's Essentials covers 5 users at a flat $149 while Jobber prices every plan by user count. From 6 techs up, model both carefully: Housecall Pro adds $100 per extra user on Essentials ($75 on MAX), and Jobber's team pricing is only visible through its own calculator. Neither is simply "the cheap one" past solo scale.`,
  },
  {
    q: 'Which is better for HVAC or plumbing specifically?',
    a: `Housecall Pro, by a nose. We score it 10/10 for both HVAC and plumbing against Jobber's 9/10, on the strength of built-in consumer financing (big-ticket replacements close measurably better with monthly-payment offers on the tablet) and native payment processing. Jobber wins on mobile UX and multi-trade breadth, so a shop that also runs landscaping or lawn-care crews should read that trade-off carefully: Jobber covers landscaping at 10/10 and Housecall Pro does not target it.`,
  },
  {
    q: 'What did Jobber’s 2026 pricing change actually do?',
    a: `Jobber retired the four-tier ladder that topped out at Plus ($399/month) and now sells three plans (Core, Connect, Grow) priced by team size, with $29/$99/$149 as the annual-billed 1-user rates ($49/$139/$199 billed monthly). The practical effect: entry costs look lower, but growing headcount raises the bill continuously instead of at tier jumps, and there is no published price for a large team. We verified this against the live pricing page on ${'2026-08-27'}.`,
  },
  {
    q: 'What does Housecall Pro really cost for a 6-person shop?',
    a: `$249/month billed annually: Essentials at $149 covers 5 users, and the sixth costs $100. At 7 techs the math flips to MAX ($299 covering 8) being cheaper than Essentials plus two extra seats ($349). This bundle arithmetic is the single most misunderstood thing about Housecall Pro pricing, and the marketing "from $59/mo" figure is a 1-user Basic plan most real crews outgrow immediately.`,
  },
  {
    q: 'Can I switch from Housecall Pro to Jobber (or back) without losing my data?',
    a: `Customer records, and open estimates and invoices, move cleanly via CSV export/import in either direction. Historical job records, recurring service agreements, and saved pricebooks rarely transfer intact; most shops keep read-only access to the old system for a season as an archive. Budget two to four weeks of running both in parallel, and do the cutover in your slow season, not July.`,
  },
  {
    q: 'Do these prices include payment processing?',
    a: `No, and this is where the real monthly cost hides on both. Housecall Pro processes cards through its own built-in system (with an extra fee for instant payouts); Jobber pairs with Stripe-based Jobber Payments. On $50,000/month of card volume, processing fees on either platform will exceed the software subscription itself. Compare effective processing rates for your card mix before the subscription price decides anything.`,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Compare', url: '/compare/' },
  { name: 'Housecall Pro vs Jobber', url: '/compare/housecall-pro-vs-jobber/' },
];
---

<Layout
  title="Jobber vs Housecall Pro (2026): Prices Verified, Seat Math Done"
  description={`The most-searched FSM comparison, with both vendors' prices human-verified ${VERIFIED}: Jobber's new team-size pricing ($29+ annual) vs Housecall Pro's seat bundles ($59 to $449+ real-world). Who wins by trade, by team size, and by total cost.`}
  breadcrumbs={breadcrumbs}
  canonical="https://wrenchstack.com/compare/housecall-pro-vs-jobber/"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <article class="mx-auto max-w-3xl px-4 py-12 prose prose-slate">
    <div class="not-prose mb-8">
      <p class="mb-2 text-sm font-semibold uppercase tracking-wider text-orange-600">Head to head</p>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl m-0">Jobber vs Housecall Pro (2026)</h1>
      <p class="mt-3 text-lg text-slate-600">
        The most-searched comparison in residential field service, and the one where both vendors' pricing changed under everyone's published reviews. Every price below was checked by a human against both live pricing pages on {VERIFIED}.
      </p>
    </div>

    <div class="not-prose my-8 rounded-lg border-2 border-orange-200 bg-orange-50 p-6">
      <h2 class="text-lg font-bold text-slate-900 mb-2 mt-0">The verdict in four sentences</h2>
      <p class="text-slate-700 text-sm m-0">
        <strong>Housecall Pro</strong> is the pick for HVAC and plumbing shops that sell big-ticket replacements: built-in consumer financing and native payments close expensive jobs, and its flat 5-user Essentials bundle is genuinely good value for a small crew. <strong>Jobber</strong> is the pick for multi-trade and outdoor businesses (it covers landscaping, which Housecall Pro does not), for solo operators (its $29 entry beats $59), and for anyone who weights field-tech adoption: its mobile app is the best in the category. Past 6 techs, neither is simply cheaper; the seat math below decides it. If you are choosing between them for a 2-to-8-person residential service crew, you are choosing between financing power and usability, not between good and bad.
      </p>
    </div>

    <h2>At a glance</h2>
    <div class="not-prose overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-slate-300 text-left text-xs uppercase tracking-wide text-slate-500">
            <th class="py-2 pr-4"></th>
            <th class="py-2 pr-4">Jobber</th>
            <th class="py-2">Housecall Pro</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-slate-100"><td class="py-2 pr-4 text-slate-500">WrenchStack Fit Score</td><td class="py-2 pr-4 font-semibold">{jScore}</td><td class="py-2 font-semibold">{hScore}</td></tr>
          <tr class="border-b border-slate-100"><td class="py-2 pr-4 text-slate-500">G2 + Capterra average</td><td class="py-2 pr-4">{jRating} (G2 {jobber.g2_rating} / Capterra {jobber.capterra_rating})</td><td class="py-2">{hRating} (G2 {hcp.g2_rating} / Capterra {hcp.capterra_rating})</td></tr>
          <tr class="border-b border-slate-100"><td class="py-2 pr-4 text-slate-500">Entry price (annual-billed)</td><td class="py-2 pr-4">$29/mo (Core, 1 user)</td><td class="py-2">$59/mo (Basic, 1 user)</td></tr>
          <tr class="border-b border-slate-100"><td class="py-2 pr-4 text-slate-500">Pricing model</td><td class="py-2 pr-4">3 plans, priced by team size</td><td class="py-2">3 bundles with included seats + per-seat overage</td></tr>
          <tr class="border-b border-slate-100"><td class="py-2 pr-4 text-slate-500">Best team size</td><td class="py-2 pr-4">{jobber.best_team_size}</td><td class="py-2">{hcp.best_team_size}</td></tr>
          <tr class="border-b border-slate-100"><td class="py-2 pr-4 text-slate-500">Founded / HQ</td><td class="py-2 pr-4">{jobber.founded}, {jobber.headquartered}</td><td class="py-2">{hcp.founded}, {hcp.headquartered}</td></tr>
          <tr class="border-b border-slate-100"><td class="py-2 pr-4 text-slate-500">Free trial</td><td class="py-2 pr-4">14 days, no card</td><td class="py-2">14 days, no card</td></tr>
        </tbody>
      </table>
    </div>

    <h2>Pricing, as verified {VERIFIED}</h2>

    <p>
      Both vendors restructured pricing in 2026, and most comparison pages on the internet still describe ladders that no longer exist. Here is what each actually sells today.
    </p>

    <h3>Jobber: three plans, priced by your team size</h3>
    <p>
      Jobber retired its old four-tier ladder (the $399 Plus plan is gone) and now prices Core, Connect, and Grow by user count. The published figures are the 1-user rates; adding techs raises the price on every plan, and the only way to see your team's number is Jobber's own calculator. A promotion running at verification (ends 2026-08-31) discounts the first 12 months of annual plans.
    </p>
    <div class="not-prose overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-slate-300 text-left text-xs uppercase tracking-wide text-slate-500">
            <th class="py-2 pr-4">Plan (1 user)</th><th class="py-2 pr-4">Billed annually</th><th class="py-2">Billed monthly</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-slate-100"><td class="py-2 pr-4 font-medium">Core</td><td class="py-2 pr-4">$29/mo</td><td class="py-2">$49/mo</td></tr>
          <tr class="border-b border-slate-100"><td class="py-2 pr-4 font-medium">Connect</td><td class="py-2 pr-4">$99/mo</td><td class="py-2">$139/mo</td></tr>
          <tr class="border-b border-slate-100"><td class="py-2 pr-4 font-medium">Grow</td><td class="py-2 pr-4">$149/mo</td><td class="py-2">$199/mo</td></tr>
        </tbody>
      </table>
      <p class="mt-2 text-xs text-slate-500">Paid add-ons at verification: Marketing Suite $99/mo, AI Receptionist $29/mo, Sales Pipeline $49/mo. Franchise and multi-location pricing is custom.</p>
    </div>

    <h3>Housecall Pro: three bundles with seats included</h3>
    <div class="not-prose overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-slate-300 text-left text-xs uppercase tracking-wide text-slate-500">
            <th class="py-2 pr-4">Plan</th><th class="py-2 pr-4">Billed annually</th><th class="py-2 pr-4">Billed monthly</th><th class="py-2 pr-4">Users included</th><th class="py-2">Extra user</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-slate-100"><td class="py-2 pr-4 font-medium">Basic</td><td class="py-2 pr-4">$59/mo</td><td class="py-2 pr-4">$79/mo</td><td class="py-2 pr-4">1</td><td class="py-2">n/a</td></tr>
          <tr class="border-b border-slate-100"><td class="py-2 pr-4 font-medium">Essentials</td><td class="py-2 pr-4">$149/mo</td><td class="py-2 pr-4">$189/mo</td><td class="py-2 pr-4">5</td><td class="py-2">$100/mo</td></tr>
          <tr class="border-b border-slate-100"><td class="py-2 pr-4 font-medium">MAX</td><td class="py-2 pr-4">$299/mo</td><td class="py-2 pr-4">$329/mo</td><td class="py-2 pr-4">8</td><td class="py-2">$75/mo</td></tr>
        </tbody>
      </table>
    </div>

    <h3>The seat math nobody does for you</h3>
    <p>
      Housecall Pro's bundles make its real cost fully computable from published numbers, so we computed it. This table shows the cheapest legitimate Housecall Pro configuration at each team size (annual billing). Note where the plan flips: at 7 techs, MAX becomes cheaper than Essentials plus overage seats.
    </p>
    <div class="not-prose overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-slate-300 text-left text-xs uppercase tracking-wide text-slate-500">
            <th class="py-2 pr-4">Team size</th><th class="py-2 pr-4">Cheapest Housecall Pro config</th><th class="py-2">Cost (annual-billed)</th>
          </tr>
        </thead>
        <tbody>
          {hcpTable.map((r) => (
            <tr class="border-b border-slate-100">
              <td class="py-2 pr-4">{r.n} {r.n === 1 ? 'user' : 'users'}</td>
              <td class="py-2 pr-4">{r.plan}</td>
              <td class="py-2 tabular-nums">${r.monthly}/mo</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="mt-2 text-xs text-slate-500">
        Computed at build time from the bundle prices and per-seat fees published on housecallpro.com/pricing, verified {VERIFIED}. Jobber's equivalent table cannot be computed honestly: its team pricing is not published beyond the 1-user rate, which is itself worth knowing when a vendor's price transparency matters to you.
      </p>
    </div>

    <p>
      The processing-fee footnote both vendors would rather stay a footnote: card processing is where the real money moves on both platforms. Housecall Pro processes payments natively (instant payouts cost extra); Jobber pairs with Stripe-based Jobber Payments. At meaningful card volume the processing line exceeds the subscription line on either platform, so compare effective rates for your card mix before letting a $30 subscription difference decide a multi-thousand-dollar-a-year choice.
    </p>

    <h2>Where Jobber wins</h2>
    <ul>
      <li><strong>Field-tech adoption.</strong> The best mobile app UX in the category; techs use it without resistance, which means less training and fewer unlogged jobs. If your last software rollout died in the truck, this is the argument that matters.</li>
      <li><strong>Multi-trade and outdoor businesses.</strong> Jobber scores 9 to 10 across eight trades including a 10/10 for landscaping, a trade Housecall Pro does not target. Mixed HVAC-plus-lawn operations have exactly one good answer here.</li>
      <li><strong>Solo and starting out.</strong> $29/month annual-billed entry against $59, with fully self-serve purchase: public prices, no sales call, run real jobs through the 14-day trial.</li>
      <li><strong>QuickBooks depth.</strong> Native two-way sync covering both QuickBooks Online and Desktop; Housecall Pro syncs Online only.</li>
      <li><strong>Automation plumbing.</strong> A modern API plus Zapier reach into 5,000+ apps for stitching lead sources, marketing, and accounting together without custom development.</li>
    </ul>

    <h2>Where Housecall Pro wins</h2>
    <ul>
      <li><strong>Closing big tickets.</strong> Built-in consumer financing through Wisetack puts monthly-payment offers on the tablet during the kitchen-table conversation. For $5,000+ HVAC replacements and repipes, this is the single most commercially important feature difference on this page.</li>
      <li><strong>Payments without bolt-ons.</strong> Card processing is native, with instant-payout options; no separate processor account to reconcile.</li>
      <li><strong>Review generation.</strong> The strongest automated review-request system in the category, with real local-SEO impact for shops that live on Google Maps rankings.</li>
      <li><strong>Google Local Services Ads.</strong> Native integration that attributes booked jobs back to specific ads; most competitors handle LSA manually.</li>
      <li><strong>Flat-price small crews.</strong> Essentials covering 5 users at $149 annual-billed is a genuinely strong bundle for the 3-to-5-tech shop, cheaper than most rivals' per-seat math at that size.</li>
    </ul>

    <h2>When to pick neither</h2>
    <ul>
      <li><strong>You run 20+ techs, multiple locations, or commercial service contracts.</strong> Both platforms thin out at enterprise scale: reporting, permissions, and multi-location management are where ServiceTitan and BuildOps earn their quote-only prices.</li>
      <li><strong>Dispatch-heavy on-demand work with heavy phone volume.</strong> Neither has a built-in phone system; Workiz ships native VoIP with call masking and recording.</li>
      <li><strong>You carry serious parts inventory.</strong> Neither treats inventory as a first-class feature. Shops with real warehouse counts should look at platforms where inventory is native rather than integrated.</li>
    </ul>

    <h2>Fit by trade</h2>
    <div class="not-prose overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-slate-300 text-left text-xs uppercase tracking-wide text-slate-500">
            <th class="py-2 pr-4">Trade</th><th class="py-2 pr-4">Jobber</th><th class="py-2">Housecall Pro</th>
          </tr>
        </thead>
        <tbody>
          {sharedVerticals.map((v) => (
            <tr class="border-b border-slate-100">
              <td class="py-2 pr-4">{v.name}</td>
              <td class="py-2 pr-4 tabular-nums">{jobber.vertical_fit?.[v.slug] ?? '-'}/10</td>
              <td class="py-2 tabular-nums">{hcp.vertical_fit?.[v.slug] ?? '-'}/10</td>
            </tr>
          ))}
          <tr class="border-b border-slate-100">
            <td class="py-2 pr-4">Landscaping</td>
            <td class="py-2 pr-4 tabular-nums">{jobber.vertical_fit?.['landscaping']}/10</td>
            <td class="py-2 text-slate-400">not targeted</td>
          </tr>
        </tbody>
      </table>
      <p class="mt-2 text-xs text-slate-500">Fit scores combine feature coverage, customer-base concentration, and each vendor's own positioning per trade. See <a href="/methodology/" class="underline">methodology</a>.</p>
    </div>

    <h2>Switching between them</h2>
    <p>
      This is one of the most common migrations in the category, in both directions, and it is routine but not free. Customers, open estimates, and invoices move via CSV cleanly. Job history, recurring service agreements, and pricebooks rarely land intact; the standard playbook is to keep read-only access to the old system for a season and rebuild recurring schedules by hand in the new one. Run both in parallel for two to four weeks, cut over in your slow season, and re-collect card-on-file authorizations early, because stored payment methods do not transfer between processors.
    </p>

    <h2>Frequently asked questions</h2>
    {faqs.map((f) => (
      <details class="group border-b border-slate-200 py-3">
        <summary class="cursor-pointer font-semibold text-slate-900">{f.q}</summary>
        <p class="mt-2 text-slate-600">{f.a}</p>
      </details>
    ))}

    <div class="not-prose mt-10 rounded-lg bg-slate-50 p-5 text-sm text-slate-600">
      <p class="m-0">
        <strong>How this page was made:</strong> prices were checked by a human against
        <a href="https://www.getjobber.com/pricing/" rel="noopener nofollow" class="underline">getjobber.com/pricing</a> and
        <a href="https://www.housecallpro.com/pricing/" rel="noopener nofollow" class="underline">housecallpro.com/pricing</a> on {VERIFIED}; the seat-cost table is computed from those published numbers at build time, and scores come from the same data as every listing (see the <a href="/verification-log/" class="underline">verification log</a>). Neither vendor paid for placement or saw this page before publication, and no AI-crawled "verified facts" appear here. Full reviews: <a href="/tools/jobber/" class="underline">Jobber</a> · <a href="/tools/housecall-pro/" class="underline">Housecall Pro</a>.
      </p>
    </div>
  </article>
</Layout>
