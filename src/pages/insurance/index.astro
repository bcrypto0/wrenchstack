---
import Layout from '../../layouts/Layout.astro';
import VendorLogo from '../../components/VendorLogo.astro';
import { insuranceProviders, insuranceTier, type InsuranceProvider } from '../../lib/data';
import MissingFromList from '../../components/MissingFromList.astro';

const pageTitle = `Best Business Insurance for Trades Contractors (2026)`;
const pageDescription = `Independent reviews of ${insuranceProviders.length} business-insurance providers for HVAC, plumbing, electrical, roofing and other trades: online insurers and marketplaces such as ERGO NEXT, Simply Business, Insureon and Hiscox, and carriers sold through independent agents such as Acuity, Erie and Travelers. Reputation warnings cite a documented record, and every review shows the provider's affiliate status.`;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Insurance', url: '/insurance/' },
];

// Tiers use verified facts only (2026-09-30): F = reputation warning, A = no warning.
// Insurance has only these two groups: nothing we could verify ranks insurers on quality.
const tierOrder: Array<'A' | 'F'> = ['A', 'F'];
const byTier: Record<'A' | 'F', InsuranceProvider[]> = { A: [], F: [] };
for (const p of insuranceProviders) {
  byTier[insuranceTier(p) === 'F' ? 'F' : 'A'].push(p);
}

const tierMeta = {
  A: {
    label: 'Tier A: no reputation warning',
    description: `Providers with no reputation warning. This is not a quality ranking: nothing we could verify ranks insurers on quality, so every provider without a documented warning is in Tier A. They differ in how you buy. Online insurers and marketplaces: ERGO NEXT, biBERK, Simply Business, Insureon, Huckleberry, Thimble and Cerity (workers' comp only). Online and through agents or brokers: The Hartford, Hiscox, Liberty Mutual, Chubb and Progressive Commercial. Through agents or brokers: Acuity, Erie, Travelers, Nationwide, Selective, CNA, Markel, Zurich, Berkshire Hathaway GUARD and AmTrust, and Coterie, which also sells through partner platforms. Tivly is a free matching service that connects you with an agent. Fit depends on your trade, size, state and whether you want to work with an agent.`,
    badgeColor: 'bg-blue-100 text-blue-900 ring-blue-300',
    cardBorder: 'border-blue-300',
  },
  F: {
    label: 'Tier F: listed with reputation warnings',
    description: 'Providers with a reputation warning based on a documented record: a BBB F rating and a 2024 Florida fine for late data filings (Pie Insurance), a class action over an agent\'s telemarketing calls that Farmers agreed to settle while denying the claims, and an undecided Los Angeles County lawsuit over its handling of 2025 wildfire claims (State Farm). Read the warning on each card before you buy.',
    badgeColor: 'bg-rose-100 text-rose-900 ring-rose-300',
    cardBorder: 'border-rose-300',
  },
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Insurance Providers for Trades Contractors`,
  numberOfItems: insuranceProviders.length,
  itemListElement: insuranceProviders.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Service',
      name: p.name,
      description: p.tagline,
      url: `https://wrenchstack.com/insurance/${p.slug}/`,
    },
  })),
};
---

<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  <article class="mx-auto max-w-5xl px-4 py-12">
    <header class="mb-10">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-orange-600">Insurance</p>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">
        Best Business Insurance for Trades Contractors (2026)
      </h1>
      <p class="mt-4 text-lg text-slate-600 leading-relaxed">
        Independent reviews of {insuranceProviders.length} business-insurance providers for HVAC, plumbing, electrical, roofing and other trades: online insurers and marketplaces, carriers sold through independent agents, and specialty construction insurers. We do not rank insurers: nothing we could verify ranks them on quality, and most providers here quote premiums business by business. Tier F marks a provider with a reputation warning that cites a documented record, such as a BBB rating, a regulatory fine, a settlement or a lawsuit; every other provider is Tier A. Affiliate programs are not part of the tier rule.
      </p>
    </header>

    <section class="mb-10 rounded-lg border-l-4 border-orange-500 bg-orange-50/40 p-5">
      <p class="text-xs font-bold uppercase tracking-wider text-orange-600">The short answer</p>
      <p class="mt-2 text-slate-800 leading-relaxed">
        Compare quotes from more than one route. Online, <a href="/insurance/next-insurance/" class="font-semibold text-orange-700 hover:underline">ERGO NEXT</a> (owned by Munich Re's ERGO) sells general liability, a BOP, workers' comp and professional liability, and marketplaces such as Simply Business and Insureon show quotes from several carriers from one application. Through a local independent agent you can also get quotes from carriers sold only through agents, such as <a href="/insurance/acuity/" class="font-semibold text-orange-700 hover:underline">Acuity</a> (more than 30 states) and <a href="/insurance/erie-insurance/" class="font-semibold text-orange-700 hover:underline">Erie</a> (12 states and Washington, DC). Acuity and Erie have no affiliate program, so we earn nothing from them. No vendor pays for placement.
      </p>
    </section>

    <section class="mb-10 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-3 text-base font-bold text-slate-900">The headline filter: agent vs direct</h2>
      <p class="text-sm text-slate-700 leading-relaxed">
        A structural choice in contractor insurance is how you buy. <strong>Online providers</strong> let you apply, get a price and buy on their site: ERGO NEXT and biBERK sell their own policies, Cerity sells workers' comp, and marketplaces such as Simply Business, Insureon and Huckleberry show quotes from several carriers. Some carriers sell both online and through agents, including The Hartford, Hiscox, Liberty Mutual and Progressive Commercial. <strong>Agent-sold carriers</strong> such as Acuity, Erie, Travelers, Nationwide and Selective are quoted through a local independent agent, and turnaround depends on the agent. An online quote plus an agent quote gives you two prices to compare.
      </p>
    </section>

    {tierOrder.map((tier) => {
      const providers = byTier[tier];
      if (providers.length === 0) return null;
      const meta = tierMeta[tier];
      return (
        <section class="mb-12">
          <div class="mb-5">
            <span class={`inline-block rounded-full px-3 py-1 text-xs font-bold ring-1 ${meta.badgeColor}`}>
              {meta.label}
            </span>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">{meta.description}</p>
          </div>

          <div class="space-y-4">
            {providers.map((p) => (
              <article class={`rounded-lg border-2 ${meta.cardBorder} bg-white p-5`}>
                <div class="mb-3 flex items-start justify-between gap-3">
                  <div class="flex min-w-0 flex-1 items-center gap-3">
                    <VendorLogo name={p.name} url={p.vendor_url} size={40} />
                    <div class="min-w-0">
                      <h3 class="text-xl font-bold text-slate-900">
                        <a href={`/insurance/${p.slug}/`} class="hover:text-orange-600">{p.name}</a>
                      </h3>
                      <p class="text-sm italic text-slate-500">{p.tagline}</p>
                    </div>
                  </div>
                  <div class="shrink-0 text-right text-xs">
                    <p class="font-bold text-slate-900 uppercase tracking-wider">{p.provider_type.replace(/-/g, ' ')}</p>
                    <p class="text-slate-500">{p.distribution_model.replace(/-/g, ' ')}</p>
                  </div>
                </div>

                {p.reputation_flag && (
                  <div class="mb-3 rounded-md border-l-4 border-rose-500 bg-rose-50 px-4 py-3 text-sm text-rose-900">
                    <p class="font-bold uppercase tracking-wider text-xs text-rose-700 mb-1">⚠ Reputation warning</p>
                    <p class="leading-relaxed">{p.reputation_flag.split('.')[0]}.</p>
                  </div>
                )}

                <dl class="mb-3 grid grid-cols-2 gap-2 text-xs sm:grid-cols-4">
                  <div>
                    <dt class="text-slate-500 uppercase tracking-wider">Quote speed</dt>
                    <dd class="font-semibold text-slate-900">{p.quote_speed}</dd>
                  </div>
                  <div>
                    <dt class="text-slate-500 uppercase tracking-wider">Lines</dt>
                    <dd class="font-semibold text-slate-900">{p.insurance_lines.length}</dd>
                  </div>
                  <div>
                    <dt class="text-slate-500 uppercase tracking-wider">Founded</dt>
                    <dd class="font-semibold text-slate-900">{p.founded ?? '-'}</dd>
                  </div>
                  <div>
                    <dt class="text-slate-500 uppercase tracking-wider">HQ</dt>
                    <dd class="font-semibold text-slate-900">{p.headquartered.split('(')[0].trim()}</dd>
                  </div>
                </dl>

                <p class="mb-3 text-sm text-slate-700 leading-relaxed">
                  <strong class="text-slate-900">Best for:</strong> {p.best_for}
                </p>

                <div class="flex flex-wrap gap-2">
                  <a href={`/insurance/${p.slug}/`} class="rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800">Read full review →</a>
                  <a href={p.affiliate_url.startsWith('http') ? p.affiliate_url : p.vendor_url} rel="sponsored nofollow noopener" target="_blank" class="rounded-md border border-orange-300 bg-white px-4 py-2 text-sm font-semibold text-orange-700 hover:bg-orange-50">Visit {p.name}</a>
                </div>
              </article>
            ))}
          </div>
        </section>
      );
    })}

    <section class="mt-12 rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">Where to start</h2>
      <p class="mt-2 text-slate-300 leading-relaxed">
        One way to shop: get an online quote from <strong>ERGO NEXT</strong>, which sells general liability, a BOP, workers' comp and professional liability online; compare it with a marketplace such as <strong>Simply Business or Insureon</strong>, which show quotes from several carriers from one application; and, if you are in their states, ask a local independent agent for an <strong>Acuity or Erie</strong> quote. If your trucks and vans are central to the work, Progressive publishes 2025 new-customer figures for contractor commercial auto (median $203/month per vehicle for liability and physical damage). Before buying workers' comp from Pie, read its BBB record and ask how its year-end premium audit works.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/insurance/next-insurance/" class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600">ERGO NEXT review →</a>
        <a href="/lead-gen/" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">Lead-gen platforms</a>
        <a href="/tools/" class="rounded-md border border-white/30 bg-white/10 px-5 py-3 text-sm font-semibold text-white hover:bg-white/20">Software directory</a>
      </div>
    </section>
    <MissingFromList listName="insurance providers for contractors" count={insuranceProviders.length} />
  </article>
</Layout>
