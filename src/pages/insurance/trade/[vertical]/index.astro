---
import Layout from '../../../../layouts/Layout.astro';
import {
  insuranceProviders,
  insuranceTier,
  verticalToUrl,
  getVertical,
  type InsuranceProvider,
} from '../../../../lib/data';

export async function getStaticPaths() {
  const TARGET_VERTICALS = [
    'hvac', 'plumbing', 'electrical', 'roofing',
    'general_contractor', 'landscaping', 'cleaning', 'pest_control',
  ];
  return TARGET_VERTICALS.map((slug) => {
    const v = getVertical(slug);
    if (!v) return null;
    return {
      params: { vertical: verticalToUrl(slug) },
      props: { verticalSlug: slug },
    };
  }).filter((p): p is NonNullable<typeof p> => !!p);
}

interface Props {
  verticalSlug: string;
}

const { verticalSlug } = Astro.props;
const vertical = getVertical(verticalSlug)!;

const providersForVertical = insuranceProviders.filter((p) => p.verticals.includes(verticalSlug));
// Two tiers only (2026-09-30): F = reputation warning, A = no warning.
const byTier: Record<'A' | 'F', InsuranceProvider[]> = { A: [], F: [] };
for (const p of providersForVertical) {
  byTier[insuranceTier(p) === 'F' ? 'F' : 'A'].push(p);
}

const pageTitle = `Best Insurance for ${vertical.name} Contractors (2026)`;
const pageDescription = `Independent reviews of ${providersForVertical.length} business-insurance providers for ${vertical.name.toLowerCase()} contractors: online insurers and marketplaces, carriers sold through independent agents, and reputation warnings where a documented record calls for one.`;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Insurance', url: '/insurance/' },
  { name: vertical.name, url: `/insurance/trade/${verticalToUrl(verticalSlug)}/` },
];

const tierMeta = {
  A: { label: 'No reputation warning', color: 'bg-blue-100 text-blue-900 ring-blue-300', cardBorder: 'border-blue-300' },
  F: { label: 'Reputation warning applies', color: 'bg-rose-100 text-rose-900 ring-rose-300', cardBorder: 'border-rose-300' },
};

function tradeIntro(slug: string): string {
  switch (slug) {
    case 'hvac':
      return 'HVAC work involves ladders, electrical components and refrigerant. The core lines to price are general liability, workers\' comp if you have employees, and commercial auto if you drive a work vehicle. Workers\' comp is quoted by class of work and payroll, so check that each quote uses the right class for your crew.';
    case 'plumbing':
      return 'Plumbing work can cause water damage in a customer\'s home or building, so check how each general liability quote handles property damage and completed operations (claims that arise after a job is finished). Price workers\' comp if you have employees and commercial auto if you drive a work vehicle.';
    case 'electrical':
      return 'Electrical work can lead to injury and property-damage claims, so general liability and workers\' comp (if you have employees) are the core lines to price. Licensing rules vary by state; make sure each policy lists your licensed class of work accurately.';
    case 'roofing':
      return 'Roofing means work at height and in the weather, and not every provider in this directory covers it; the providers below list roofing among their trades. Confirm that each one writes roofing for the lines you need in your state before you rely on a quote.';
    case 'general_contractor':
      return 'GCs often need more lines than a single trade: general liability with completed operations, builder\'s risk for projects in progress, professional liability for design-build work, commercial auto, umbrella, and workers\' comp. Among the providers below, CNA and Zurich list builder\'s risk, and Erie, Nationwide, Markel and Zurich list surety bonds.';
    case 'landscaping':
      return 'Landscaping work is often seasonal, and workers\' comp is priced on payroll, so ask how each carrier\'s premium audit handles payroll that changes through the year. Thimble sells liability coverage by the job, month or year for crews with irregular or seasonal work.';
    case 'cleaning':
      return 'Cleaning crews work inside customers\' homes and businesses and use cleaning chemicals, so check how each general liability quote covers damage to the property you are working on.';
    case 'pest_control':
      return 'Pest control involves applying pesticides at customers\' properties, so ask whether each general liability quote covers pesticide and chemical-related claims, and whether professional liability is available for your work.';
    default:
      return `Business-insurance providers for ${vertical.name.toLowerCase()} contractors.`;
  }
}

const faqs = [
  {
    q: `Which insurance provider is best for ${vertical.name.toLowerCase()} contractors?`,
    a: `We do not rank insurers for ${vertical.name.toLowerCase()} work: nothing we could verify ranks them on quality, and your premium depends on your trade class, state, payroll, vehicles, claims history and coverage limits. Get quotes from several of the ${providersForVertical.length} providers listed on this page, including an online quote and a quote from a local independent agent, who can price carriers sold only through agents. Read any reputation warning on a provider's card before you buy.`,
  },
  {
    q: `What does typical insurance cost for ${vertical.name.toLowerCase()} contractors?`,
    a: `Most providers here quote per business and do not publish premiums; your price depends on your trade class, state, payroll, vehicles, claims history and coverage limits. One published reference point: Progressive's 2025 figures for new customers show a median of $203/month (average $260) per vehicle for contractor commercial auto liability and physical damage, and a BOP median of $80/month (average $127). The only way to know your own cost is to get quotes.`,
  },
  {
    q: `Should I use a digital carrier or an agent?`,
    a: `Both have a place. Online providers such as ERGO NEXT and marketplaces such as Simply Business let you quote and buy online; Simply Business says you can compare quotes and buy within 10 minutes. A local independent agent can quote carriers that sell only through agents, which you cannot buy online directly. Each provider card on this page shows whether a provider is direct digital, agent only or hybrid (online and through agents). Getting both kinds of quote gives you two prices to compare.`,
  },
  {
    q: `What insurance lines do I actually need?`,
    a: `It depends on your crew, vehicles and contracts. The core lines for ${vertical.name.toLowerCase()} contractors are general liability, workers' comp if you have employees (state rules apply), and commercial auto if you drive a work vehicle. Tools and equipment coverage is for gear you carry between jobs, professional liability covers design or consulting work, and an umbrella adds liability limits above your other policies. Ask your agent or provider which lines your state and your contracts require.`,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <article class="mx-auto max-w-5xl px-4 py-12">
    <header class="mb-10">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-orange-600">
        Insurance · {vertical.name}
      </p>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">
        Best Insurance for {vertical.name} Contractors (2026)
      </h1>
      <p class="mt-4 text-lg text-slate-600 leading-relaxed">{tradeIntro(verticalSlug)}</p>
    </header>

    {(['A', 'F'] as const).map((tier) => {
      const providers = byTier[tier];
      if (providers.length === 0) return null;
      const meta = tierMeta[tier];
      return (
        <section class="mb-12">
          <div class="mb-5 flex items-baseline gap-3">
            <h2 class="text-2xl font-bold text-slate-900">{meta.label}</h2>
            <span class={`inline-block rounded-full px-2 py-0.5 text-xs font-bold ring-1 ${meta.color}`}>{providers.length}</span>
          </div>

          <div class="space-y-4">
            {providers.map((p) => (
              <article class={`rounded-lg border-2 ${meta.cardBorder} bg-white p-5`}>
                <div class="mb-3 flex items-start justify-between gap-3">
                  <div class="min-w-0 flex-1">
                    <h3 class="text-xl font-bold text-slate-900">
                      <a href={`/insurance/${p.slug}/`} class="hover:text-orange-600">{p.name}</a>
                    </h3>
                    <p class="text-sm italic text-slate-500">{p.tagline}</p>
                  </div>
                  <div class="shrink-0 text-right text-xs">
                    <p class="font-bold text-slate-900 uppercase tracking-wider">{p.provider_type.replace(/-/g, ' ')}</p>
                    <p class="text-slate-500">{p.distribution_model.replace(/-/g, ' ')}</p>
                  </div>
                </div>

                {p.reputation_flag && (
                  <div class="mb-3 rounded-md border-l-4 border-rose-500 bg-rose-50 px-4 py-3 text-sm text-rose-900">
                    <p class="font-bold uppercase tracking-wider text-xs text-rose-700 mb-1">⚠ Reputation warning</p>
                    <p class="leading-relaxed">{p.reputation_flag.split('.')[0]}.</p>
                  </div>
                )}

                <p class="mb-3 text-sm text-slate-700 leading-relaxed">
                  <strong class="text-slate-900">Best for:</strong> {p.best_for}
                </p>

                <div class="flex flex-wrap gap-2">
                  <a href={`/insurance/${p.slug}/`} class="rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800">Read full review →</a>
                  <a href={p.affiliate_url.startsWith('http') ? p.affiliate_url : p.vendor_url} rel="sponsored nofollow noopener" target="_blank" class="rounded-md border border-orange-300 bg-white px-4 py-2 text-sm font-semibold text-orange-700 hover:bg-orange-50">Visit {p.name}</a>
                </div>
              </article>
            ))}
          </div>
        </section>
      );
    })}

    <section class="mb-10">
      <h2 class="mb-5 text-2xl font-bold text-slate-900">Frequently asked for {vertical.name.toLowerCase()} contractors</h2>
      <div class="space-y-3">
        {faqs.map((f) => (
          <details class="rounded-lg border border-slate-200 bg-white p-4">
            <summary class="cursor-pointer font-semibold text-slate-900">{f.q}</summary>
            <p class="mt-3 text-slate-700 leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">More for {vertical.name.toLowerCase()} contractors</h2>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href={`/${verticalToUrl(verticalSlug)}/`} class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600">{vertical.name} software directory →</a>
        <a href={`/lead-gen/trade/${verticalToUrl(verticalSlug)}/`} class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">Lead-gen for {vertical.name.toLowerCase()}</a>
        <a href="/insurance/" class="rounded-md border border-white/30 bg-white/10 px-5 py-3 text-sm font-semibold text-white hover:bg-white/20">All insurance providers</a>
      </div>
    </section>
  </article>
</Layout>
