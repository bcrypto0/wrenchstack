---
import Layout from '../layouts/Layout.astro';
import {
  leadGenPlatforms,
  insuranceProviders,
  payrollServices,
  marketingAgencies,
  paymentProcessors,
  financingProviders,
  accountingSoftware,
  bankingProviders,
} from '../lib/data';

// The reputation ledger: every documented warning in the directory, on one
// page, with the policy that governs it. Counts and entries are computed at
// build time from the same data files that power the category pages, so this
// page can never disagree with the listings.

interface FlaggedEntry {
  name: string;
  slug: string;
  url: string;
  flag: string;
  verified: string;
}

interface FlagGroup {
  category: string;
  categoryUrl: string;
  entries: FlaggedEntry[];
}

function collect(
  arr: Array<{ name: string; slug: string; reputation_flag: string | null; verified_date?: string }>,
  category: string,
  prefix: string
): FlagGroup {
  return {
    category,
    categoryUrl: `/${prefix}/`,
    entries: arr
      .filter((e) => e.reputation_flag)
      .map((e) => ({
        name: e.name,
        slug: e.slug,
        url: `/${prefix}/${e.slug}/`,
        flag: e.reputation_flag as string,
        verified: e.verified_date ?? '',
      })),
  };
}

const groups: FlagGroup[] = [
  collect(leadGenPlatforms, 'Lead generation', 'lead-gen'),
  collect(financingProviders, 'Consumer financing', 'financing'),
  collect(insuranceProviders, 'Insurance', 'insurance'),
  collect(paymentProcessors, 'Payments', 'payments'),
  collect(bankingProviders, 'Business banking', 'banking'),
  collect(marketingAgencies, 'Marketing agencies', 'agencies'),
  collect(payrollServices, 'Payroll', 'payroll'),
  collect(accountingSoftware, 'Accounting', 'accounting'),
].filter((g) => g.entries.length > 0);

const totalFlags = groups.reduce((n, g) => n + g.entries.length, 0);
const totalVendors = 725; // directory-wide; the flag universe below is the US adjacent stack

const removedFlags = [
  {
    name: 'Thumbtack',
    reason:
      'We had cited an "active class action." On re-verification (July 2026) the case had been compelled to arbitration and terminated on 20 July 2026. Citing it as live would have been false, so the flag came down.',
  },
  {
    name: 'Houzz',
    reason:
      'The underlying complaint was stricken and the case closed in June 2025. A stricken complaint is not evidence. Removed.',
  },
  {
    name: 'Liberty Mutual',
    reason:
      'The "data breach" we referenced traced back to a ransomware group\'s own unverified claim, which the company denies; the related suit was voluntarily dismissed. An attacker\'s press release is not a primary source. Removed.',
  },
  {
    name: 'biBerk',
    reason:
      'The complaint-index figure we found existed only on affiliate SEO sites and could not be traced to the named regulator, while BBB showed an A+ rating. Unsourceable, so removed.',
  },
];

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Reputation Flags', url: '/reputation-flags/' },
];
---

<Layout
  title={`The Reputation Ledger: ${totalFlags} Documented Vendor Warnings`}
  description={`Every reputation flag in the WrenchStack directory on one page: ${totalFlags} vendors with documented regulatory actions or sustained complaint patterns, each with its evidence. No vendor can pay to remove a flag.`}
  breadcrumbs={breadcrumbs}
>
  <article class="mx-auto max-w-3xl px-4 py-12 prose prose-slate">
    <div class="not-prose mb-8">
      <p class="mb-2 text-sm font-semibold uppercase tracking-wider text-orange-600">The honesty ledger</p>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl m-0">
        Reputation flags: {totalFlags} vendors with documented problems
      </h1>
      <p class="mt-3 text-lg text-slate-600">
        Of the {totalVendors} vendors WrenchStack reviews, {totalFlags} carry a documented warning. This page lists every one of them, with the evidence. It is the part of the directory that costs us money, and the part we are proudest of.
      </p>
    </div>

    <h2>What earns a flag</h2>
    <p>
      A reputation flag is reserved for <strong>documented, current evidence</strong>: a regulatory action (FTC, SEC, CFPB, a state insurance regulator), a court record that is actually live, or a sustained, specific complaint pattern at a named source such as a BBB profile with counts. The flag text states the source so you can check it yourself.
    </p>
    <p>
      What does <em>not</em> earn a flag: a handful of angry reviews, an anonymous forum post, a lawsuit that has been dismissed or sent to arbitration and terminated, a security "breach" that exists only in an attacker's claims, or any figure we cannot trace to a primary source. If we cannot verify it, we do not publish it.
    </p>

    <div class="not-prose my-8 rounded-lg border-2 border-orange-200 bg-orange-50 p-6">
      <h2 class="text-lg font-bold text-slate-900 mb-2">The policy, in four lines</h2>
      <ul class="space-y-2 text-slate-700 text-sm">
        <li><strong>No vendor can pay to remove a flag.</strong> Not through advertising, not through an affiliate program, not through partnership. There is no price.</li>
        <li><strong>Flags run on evidence, both ways.</strong> Send a primary source showing a flag is factually wrong or outdated and it is corrected the same day. See the removals below: it happens.</li>
        <li><strong>Affiliate relationships never touch flags.</strong> Some flagged vendors run affiliate programs we could earn from. The flags stay.</li>
        <li><strong>Every flag is re-verified</strong> on the monthly data cycle, against the original source.</li>
      </ul>
    </div>

    <h2>Flags we removed, and why</h2>
    <p>
      The standard only means something if it runs both directions. In July 2026 we re-verified every flag in the directory and <strong>removed four</strong> that no longer held up:
    </p>
    <ul>
      {removedFlags.map((r) => (
        <li>
          <strong>{r.name}:</strong> {r.reason}
        </li>
      ))}
    </ul>
    <p>
      Publishing a warning that is not true is worse than publishing no warning at all. That cut both ways then, and it will again.
    </p>

    <h2>The ledger</h2>
    <p>
      Grouped by category. Each entry links to the full review, where the flag appears in context alongside the vendor's strengths. A flag is a documented caution, not a verdict: several flagged vendors remain the right choice for specific situations, and the reviews say so.
    </p>

    {groups.map((g) => (
      <section>
        <h3>
          <a href={g.categoryUrl}>{g.category}</a>
          <span class="text-slate-400 font-normal"> ({g.entries.length} of the category flagged)</span>
        </h3>
        <div class="not-prose space-y-4">
          {g.entries.map((e) => (
            <div class="rounded-lg border border-slate-200 bg-white p-4">
              <p class="m-0 font-semibold text-slate-900">
                <a href={e.url} class="text-orange-700 hover:underline">{e.name}</a>
                {e.verified && (
                  <span class="ml-2 text-xs font-normal text-slate-400">flag re-verified {e.verified}</span>
                )}
              </p>
              <p class="mt-2 mb-0 text-sm text-slate-600">{e.flag}</p>
            </div>
          ))}
        </div>
      </section>
    ))}

    <h2>Why we publish this at all</h2>
    <p>
      Most software directories are funded by the vendors they review, which makes a page like this structurally impossible for them. WrenchStack is affiliate-supported with per-vendor disclosure, and no vendor can pay for placement, ranking, or silence. The ledger exists because a contractor about to route customer financing, payroll, or insurance through one of these companies deserves to know what the record shows.
    </p>
    <p class="text-sm text-slate-500">
      See something wrong on this page, in either direction? Email <a href="mailto:press@wrenchstack.com">press@wrenchstack.com</a> with a primary source. Corrections are applied the same day, and this page regenerates from the live directory on every build. Related: <a href="/methodology/">methodology</a>, <a href="/editorial-standards/">editorial standards</a>, <a href="/verification-log/">verification log</a>.
    </p>
  </article>
</Layout>
