---
import Layout from '../layouts/Layout.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Contact', url: '/contact/' },
];

// Response-time promises ("48 hours", "5 business days", "2-3 weeks", "3 business
// days") and the press offer of interviews were removed on 2026-10-01: they were
// commitments, not facts, and WrenchStack answers press questions in writing.
const inboxes = [
  {
    address: 'hello@wrenchstack.com',
    role: 'General inquiries, corrections, suggestions',
    detail: 'Pricing changed and we missed it? Feature claim looks wrong? Glossary term missing? Editorial question? This is the inbox.',
  },
  {
    address: 'partners@wrenchstack.com',
    role: 'Vendor partnerships, affiliate programs',
    detail: 'Software vendors interested in partnership with WrenchStack. We run affiliate links only for tools we would recommend to readers without a commission.',
  },
  {
    address: 'press@wrenchstack.com',
    role: 'Press, media, syndication',
    detail: 'Journalists and industry publications with questions about our methodology or the figures published on WrenchStack. We answer in writing and can send data cuts by email.',
  },
];

const policies = [
  {
    title: 'Editorial corrections',
    text: 'We correct factual errors once they are confirmed against a primary source. If you have published a price change and our page still shows the old number, email hello@ with the URL and the new figure.',
  },
  {
    title: 'Ranking disputes',
    text: 'If you believe your product ranks lower than the WrenchStack Fit Score formula should produce, send the factor inputs you believe are wrong (vertical fit, pricing transparency, integration coverage) with a public source for each. We check them against the published formula and the sources, not against sales pressure.',
  },
  {
    title: 'Removal requests',
    text: 'We do not remove tools from the directory at vendor request. We do correct factual errors. If you want your product removed from comparison pages and best-of lists, you would need to demonstrate the listing materially misrepresents the product after we have already attempted correction.',
  },
  {
    title: 'Off-record context',
    text: 'Vendors may send context in writing that is not for publication, such as an upcoming price change or a roadmap item. We do not publish or omit anything on the strength of it: readers see what a public source supports.',
  },
];
---

<Layout
  title="Contact WrenchStack: inboxes and editorial policies"
  description="Three inboxes for different types of inquiries: corrections, partnerships, and press. Editorial policies on corrections, ranking disputes, removal requests, and off-record context."
  breadcrumbs={breadcrumbs}
>
  <article class="mx-auto max-w-3xl px-4 py-12">
    <header class="mb-10">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-orange-600">Contact</p>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">
        Get in touch
      </h1>
      <p class="mt-4 text-lg text-slate-600">
        Three inboxes for different types of inquiries. Picking the right one gets your message to the right place.
      </p>
    </header>

    <section class="mb-12 space-y-4">
      {inboxes.map((i) => (
        <div class="rounded-lg border border-slate-200 bg-white p-5">
          <a
            href={`mailto:${i.address}`}
            class="text-lg font-semibold text-orange-600 hover:underline"
          >
            {i.address}
          </a>
          <div class="mt-1 text-sm font-medium text-slate-700">{i.role}</div>
          <p class="mt-2 text-sm text-slate-700 leading-relaxed">{i.detail}</p>
        </div>
      ))}
    </section>

    <section class="prose prose-slate max-w-none">
      <h2>Editorial policies</h2>
      <p>
        These are the explicit rules we follow when handling inbound. Publishing them means you can hold us accountable to them.
      </p>

      {policies.map((p) => (
        <div class="not-prose mb-4 rounded-lg border-l-2 border-orange-300 bg-white py-3 pl-4 pr-3">
          <div class="mb-1 font-semibold text-slate-900">{p.title}</div>
          <p class="text-sm text-slate-700 leading-relaxed">{p.text}</p>
        </div>
      ))}
    </section>

    <section class="mt-12 rounded-lg bg-slate-50 p-6 text-sm text-slate-600">
      <p>
        Looking for ranking methodology or affiliate disclosure? See the <a href="/methodology/" class="text-orange-600 hover:underline">methodology page</a> for the full WrenchStack Fit Score formula and per-tool affiliate status ledger.
      </p>
    </section>
  </article>
</Layout>
