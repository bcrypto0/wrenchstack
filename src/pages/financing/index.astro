---
import Layout from '../../layouts/Layout.astro';
import VendorLogo from '../../components/VendorLogo.astro';
import { financingProviders, financingByModel, FINANCING_MODEL_META } from '../../lib/data';
import MissingFromList from '../../components/MissingFromList.astro';

const grouped = financingByModel();

const pageTitle = `Best Contractor Financing for Big-Ticket Jobs (2026)`;
const pageDescription = `Independent comparison of ${financingProviders.length} consumer-financing options for contractors, including Wisetack, Sunbit, GreenSky, Hearth, Acorn Finance, Synchrony and Regions, grouped by model: embedded point-of-sale, lender marketplaces, direct lenders and promotional credit cards. Merchant fees, customer APRs and loan sizes where each provider publishes them.`;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Financing', url: '/financing/' },
];

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Consumer Financing Providers for Contractors',
  numberOfItems: financingProviders.length,
  itemListElement: financingProviders.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'FinancialProduct',
      name: p.name,
      description: p.tagline,
      url: `https://wrenchstack.com/financing/${p.slug}/`,
    },
  })),
};
---

<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  <article class="mx-auto max-w-5xl px-4 py-12">
    <header class="mb-10">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-amber-600">Financing</p>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">
        Best Contractor Financing for Big-Ticket Jobs (2026)
      </h1>
      <p class="mt-4 text-lg text-slate-600 leading-relaxed">
        Consumer financing lets a customer pay for a repair or project in monthly installments. We compare {financingProviders.length} options contractors can offer, grouped by how they work, with what each costs you, what your customer pays and who receives the loan funds, plus the promotional terms (including deferred interest) to explain up front.
      </p>
    </header>

    <section class="mb-10 rounded-lg border-l-4 border-orange-500 bg-orange-50/40 p-5">
      <p class="text-xs font-bold uppercase tracking-wider text-orange-600">The short answer</p>
      <p class="mt-2 text-slate-800 leading-relaxed">
        The first choice is the <strong>financing model</strong>, and with it who pays the fee and who receives the loan funds. <a href="/financing/wisetack/" class="font-semibold text-orange-700 hover:underline">Wisetack</a> publishes a flat 3.9% fee per financed job ($500-$65,000) and runs inside field-service apps such as Housecall Pro and Jobber. <a href="/financing/sunbit/" class="font-semibold text-orange-700 hover:underline">Sunbit</a> covers smaller tickets ($50-$20,000) and pays the business up front; its one published fee is 6% + 30 cents per charge through Stripe. <a href="/financing/greensky/" class="font-semibold text-orange-700 hover:underline">GreenSky</a> charges a transaction fee that it sets and does not publish; read its regulatory record before enrolling. <a href="/financing/hearth/" class="font-semibold text-orange-700 hover:underline">Hearth</a> charges an annual subscription instead of a per-loan dealer fee, and <a href="/financing/acorn-finance/" class="font-semibold text-orange-700 hover:underline">Acorn Finance</a> says it charges contractors no fees; with both, the loan funds go to the customer, who then pays you. Explain deferred-interest terms to every customer, not just the headline "0%." No vendor pays for placement.
      </p>
    </section>

    <section class="mb-10 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-3 text-base font-bold text-slate-900">The headline filter: financing model</h2>
      <p class="text-sm text-slate-700 leading-relaxed">
        <strong>Embedded point-of-sale</strong> financing (Wisetack, GreenSky, Sunbit) is offered with your quote, invoice or checkout; you pay a fee on each financed sale, and the lender or platform pays you. <strong>Lender marketplaces and platforms</strong> (Hearth, Acorn Finance, PowerPay) connect the customer with partner lenders: Hearth and Acorn send the loan funds to the customer, who pays you, while PowerPay says the provider is paid directly. <strong>Direct lenders</strong> (Service Finance, Foundation Finance, Regions) make home-improvement installment loans themselves; none of the three publishes a full dealer-fee schedule. <strong>Promotional credit cards</strong> (Synchrony) give the customer a revolving credit line with deferred-interest or fixed-APR promotions, and the merchant fee depends on the promotion. For any model, explain deferred-interest terms to customers, not just the headline "0%."
      </p>
    </section>

    {grouped.map(({ model, providers }) => {
      const meta = FINANCING_MODEL_META[model];
      return (
        <section class="mb-12">
          <div class="mb-5">
            <span class="inline-block rounded-full bg-amber-100 px-3 py-1 text-xs font-bold uppercase tracking-wider text-amber-900 ring-1 ring-amber-300">{meta.label}</span>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">{meta.blurb}</p>
          </div>

          <div class="space-y-4">
            {providers.map((p) => (
              <article class="rounded-lg border-2 border-amber-200 bg-white p-5">
                <div class="mb-3 flex items-start justify-between gap-3">
                  <div class="flex min-w-0 flex-1 items-center gap-3">
                    <VendorLogo name={p.name} url={p.vendor_url} size={40} />
                    <div class="min-w-0">
                      <h3 class="text-xl font-bold text-slate-900">
                        <a href={`/financing/${p.slug}/`} class="hover:text-amber-600">{p.name}</a>
                      </h3>
                      <p class="text-sm italic text-slate-500">{p.tagline}</p>
                    </div>
                  </div>
                </div>

                {p.reputation_flag && (
                  <div class="mb-3 rounded-md border-l-4 border-rose-500 bg-rose-50 px-4 py-3 text-sm text-rose-900">
                    <p class="font-bold uppercase tracking-wider text-xs text-rose-700 mb-1">⚠ Heads up</p>
                    <p class="leading-relaxed">{p.reputation_flag.split('.')[0]}.</p>
                  </div>
                )}

                <div class="mb-3 grid gap-2 sm:grid-cols-2">
                  <p class="rounded-md bg-slate-50 px-4 py-2 text-sm text-slate-700 leading-snug">
                    <strong class="text-slate-900">Cost to you:</strong> {p.contractor_cost}
                  </p>
                  <p class="rounded-md bg-slate-50 px-4 py-2 text-sm text-slate-700 leading-snug">
                    <strong class="text-slate-900">Loan size:</strong> {p.loan_range}
                  </p>
                </div>

                <dl class="mb-3 grid grid-cols-2 gap-2 text-xs sm:grid-cols-3">
                  <div>
                    <dt class="text-slate-500 uppercase tracking-wider">Model</dt>
                    <dd class="font-semibold text-slate-900 capitalize">{p.financing_model.replace(/-/g, ' ')}</dd>
                  </div>
                  <div>
                    <dt class="text-slate-500 uppercase tracking-wider">Founded</dt>
                    <dd class="font-semibold text-slate-900">{p.founded ?? '-'}</dd>
                  </div>
                  <div>
                    <dt class="text-slate-500 uppercase tracking-wider">Customer APR</dt>
                    <dd class="font-semibold text-slate-900">{p.apr_range.split(';')[0].split('(')[0].trim()}</dd>
                  </div>
                </dl>

                <p class="mb-3 text-sm text-slate-700 leading-relaxed">
                  <strong class="text-slate-900">Best for:</strong> {p.best_for}
                </p>

                <div class="flex flex-wrap gap-2">
                  <a href={`/financing/${p.slug}/`} class="rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800">Read full review →</a>
                  <a href={p.affiliate_url.startsWith('http') ? p.affiliate_url : p.vendor_url} rel="sponsored nofollow noopener" target="_blank" class="rounded-md border border-amber-300 bg-white px-4 py-2 text-sm font-semibold text-amber-700 hover:bg-amber-50">Visit {p.name}</a>
                </div>
              </article>
            ))}
          </div>
        </section>
      );
    })}

    <section class="mt-12 rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">Where to start</h2>
      <p class="mt-2 text-slate-300 leading-relaxed">
        Start with job size and how you want to be paid. <strong>Service and repair tickets:</strong> Wisetack (3.9% per financed job, $500-$65,000, inside Housecall Pro, Jobber, FieldPulse, JobNimbus and Contractor Plus) or Sunbit ($50-$20,000, business paid up front). <strong>No fee to you:</strong> Acorn Finance, which says it charges contractors no setup, platform, monthly or dealer fees; the customer receives the loan and pays you. <strong>Large projects:</strong> Foundation Finance (contracts up to $100,000 over 12-240 months) or, for remodelers with 5+ years in business and $5,000+ average projects, Regions. <strong>Bundled sales tools:</strong> Hearth, whose annual subscription replaces per-loan dealer fees. <strong>Manufacturer dealer programs:</strong> Synchrony, where some manufacturers rebate the merchant fee. Before enrolling with GreenSky, read its regulatory record and get its transaction fee in writing.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/financing/wisetack/" class="rounded-md bg-amber-500 px-5 py-3 text-sm font-semibold text-white hover:bg-amber-600">See Wisetack →</a>
        <a href="/payments/" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">Payments</a>
        <a href="/tools/" class="rounded-md border border-white/30 bg-white/10 px-5 py-3 text-sm font-semibold text-white hover:bg-white/20">Software directory</a>
      </div>
    </section>
    <MissingFromList listName="consumer-financing providers" count={financingProviders.length} />
  </article>
</Layout>
