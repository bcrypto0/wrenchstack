---
import Layout from '../layouts/Layout.astro';
import { tools, verticals, medianUsd as sharedMedianUsd, perUserMedian, flatFeeMedian, perUserTools, flatFeeTools, priceTier, perUserEquivalentUsd, isQuoteOnly, hasFreeTier, quoteOnlyCount, REFERENCE_TEAM_SIZE, teamSizeBucket, freshnessTier, accountingSoftware, paymentProcessors, bankingProviders, financingProviders, insuranceProviders, leadGenPlatforms, payrollServices, marketingAgencies, aiTools } from '../lib/data';
import { INTL_MARKETS } from '../lib/intl';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Trends 2026', url: '/trends-2026/' },
];

// --- COMPUTE STATS FROM OUR DIRECTORY ---

// Pricing distribution
const tierDist = { free: 0, entry: 0, mid: 0, enterprise: 0, 'quote-only': 0 };
for (const t of tools) tierDist[priceTier(t)]++;
// FastEST, the one tool in this tier today, prices per application license on a
// single PC or tablet, not per named user, so the sentence says "per seat" and
// spells out its unit (from its pricing_note).
const topPricedTools = tools.filter((t) => priceTier(t) === 'enterprise');
const topPricedSentence = topPricedTools.length === 0
  ? 'None publishes a starting price of $250 or more per seat.'
  : topPricedTools.length === 1
  ? `Only one, ${topPricedTools[0].name}, publishes a starting price of $250 or more per seat${topPricedTools[0].slug === 'fastest' ? `: $${topPricedTools[0].pricing.starting_at_usd} a month per application license on a single PC or tablet` : ''}.`
  : `A further ${topPricedTools.length} publish a starting price of $250 or more per seat.`;

const pricedTools = tools.filter((t) => t.pricing.starting_at_usd !== null && t.pricing.starting_at_usd > 0);
const prices = pricedTools.map((t) => t.pricing.starting_at_usd!).sort((a, b) => a - b);
const medianPrice = sharedMedianUsd(prices);
const minPrice = prices[0];
const maxPrice = prices[prices.length - 1];

// The blended median above mixes pricing models. Count each model among the same
// priced tools, so the per-user, flat and any other counts add up to pricedTools
// (until 2026-10-01 the prose gave 15 + 45 against 61 priced tools, because Bluebeam's
// annual per-user plan was in neither group). Counting over pricedTools also keeps a
// $0 plan whose pricing_model is still 'flat' (Calday) out of the flat-fee count.
const perUserPriced = perUserTools(pricedTools).length;
const flatPriced = flatFeeTools(pricedTools).length;
const otherModelTools = pricedTools.filter((t) => perUserTools([t]).length === 0 && flatFeeTools([t]).length === 0);
const otherModelClause = otherModelTools.length === 0
  ? ''
  : otherModelTools.every((t) => t.pricing.pricing_model === 'annual_per_user')
  ? `${otherModelTools.length} ${otherModelTools.length === 1 ? 'sells' : 'sell'} an annual per-user subscription`
  : `${otherModelTools.length} ${otherModelTools.length === 1 ? 'uses' : 'use'} another pricing model`;

// Free tier prevalence
const withFreeTier = tools.filter(hasFreeTier).length;
const withFreeTrial = tools.filter((t) => (t.pricing.free_trial_days ?? 0) > 0).length;
const avgTrialDays = Math.round(
  tools.filter((t) => (t.pricing.free_trial_days ?? 0) > 0)
    .reduce((sum, t) => sum + (t.pricing.free_trial_days ?? 0), 0) /
  Math.max(withFreeTrial, 1)
);

// Custom-quoted prevalence (enterprise opacity). Quote-only is the pricing model,
// not a null starting price: Trash Flow (one-time licenses) and Pylon (per-project
// prices) have no monthly starting price but do publish prices.
const customQuoted = quoteOnlyCount();
const customQuotedPct = Math.round((customQuoted / tools.length) * 100);
const nonMonthlyPriced = tools.filter((t) => t.pricing.starting_at_usd === null && !isQuoteOnly(t));

// Founded years
const foundedYears = tools.filter((t) => t.founded).map((t) => t.founded!);
const avgFounded = Math.round(foundedYears.reduce((a, b) => a + b, 0) / foundedYears.length);
const post2015 = tools.filter((t) => t.founded && t.founded >= 2015).length;
const pre2010 = tools.filter((t) => t.founded && t.founded < 2010).length;
// Named cohort examples take their years from tools.json so the prose can't drift from the data.
const cohortExamples = (picks: [string, string][], inCohort: (year: number) => boolean) =>
  picks
    .map(([slug, label]) => ({ label, year: tools.find((t) => t.slug === slug)?.founded }))
    .filter((p): p is { label: string; year: number } => !!p.year && inCohort(p.year))
    .sort((a, b) => a.year - b.year)
    .map((p) => `${p.label} (${p.year})`)
    .join(', ');
const post2015Examples = cohortExamples([
  ['fieldpulse', 'FieldPulse'], ['limble', 'Limble CMMS'], ['skimmer', 'Skimmer'], ['maintainx', 'MaintainX'],
  ['jobtread', 'JobTread'], ['sera-systems', 'Sera Systems'], ['roofr', 'Roofr'],
], (y) => y >= 2015);
const pre2010Examples = cohortExamples([
  ['pestpac', 'PestPac'], ['vonigo', 'Vonigo'], ['cleantelligent', 'Otuvy'], ['fieldedge', 'FieldEdge'],
  ['simpro', 'Simpro'], ['service-autopilot', 'Service Autopilot'], ['acculynx', 'AccuLynx'], ['tradify', 'Tradify'], ['procore', 'Procore'],
], (y) => y < 2010);

// Integration prevalence
const withQuickBooks = tools.filter((t) => t.integrations.some((i) => i.includes('quickbooks'))).length;
const withStripe = tools.filter((t) => t.integrations.some((i) => i.includes('stripe'))).length;
const withZapier = tools.filter((t) => t.integrations.some((i) => i.includes('zapier'))).length;
const withXero = tools.filter((t) => t.integrations.some((i) => i.includes('xero'))).length;
const withLSA = tools.filter((t) => t.integrations.some((i) => i.includes('google_local_services'))).length;
// Sage Intacct and NetSuite only, matching the table label. Until 2026-10-01 this
// matched any 'sage' slug, so Sage 100, Sage 300 CRE and plain 'sage' were counted too.
const isSageOrNetsuite = (i: string) => i === 'sage_intacct' || i.includes('netsuite');
const withSageOrNetsuite = tools.filter((t) => t.integrations.some(isSageOrNetsuite)).length;

// Vertical coverage
const verticalSizes = verticals.map((v) => ({
  slug: v.slug,
  name: v.name,
  count: tools.filter((t) => t.verticals.includes(v.slug)).length,
})).sort((a, b) => b.count - a.count);

// HQ distribution. Match by known non-US country, not by the literal 'USA'
// (fixed 2026-08-27: 'Addison, Illinois' and 'Cedar Park, TX' were being
// counted as international because they do not contain the string 'USA').
const NON_US_COUNTRIES = ['Canada', 'Australia', 'New Zealand', 'United Kingdom', 'UK', 'Ireland', 'Netherlands', 'Germany', 'France', 'Israel', 'India', 'Denmark', 'Sweden', 'Norway', 'Finland', 'Estonia', 'Lithuania', 'Poland', 'Spain', 'Portugal', 'South Africa', 'Singapore', 'Japan', 'Brazil', 'Ukraine'];
// Compare whole place segments, not substrings, so 'India' can never match
// 'Indianapolis'. "London, UK / New York, USA" splits into London, UK, New York, USA.
const isNonUsHQ = (hq: string) => hq.split(/[,/]/).some((seg) => NON_US_COUNTRIES.includes(seg.trim()));
const usHQ = tools.filter((t) => t.headquartered && !isNonUsHQ(t.headquartered)).length;
const intlHQ = tools.filter((t) => t.headquartered && isNonUsHQ(t.headquartered)).length;

// (A G2/Capterra rating-distribution section was removed 2026-09-30: those
// third-party scores could not be verified and are no longer stored.)

// Per-company vs per-user pricing
function detectsPerCompany(t: typeof tools[number]): boolean {
  const note = (t.pricing.pricing_note ?? '').toLowerCase();
  return note.includes('per company') || (note.includes('per month') && !note.includes('per user'));
}
const perCompanyCount = tools.filter(detectsPerCompany).length;
// pricedTools already excludes free ($0) tools, so free-tier tools must not be
// subtracted a second time (fixed 2026-08-27).
const perUserCount = pricedTools.length - perCompanyCount;

// Median entry price by trade (publicly-priced paid tools; trades with >=4 such tools).
// Cost per user, the same basis as the price tiers: flat and base-plus-seat plans are
// split across REFERENCE_TEAM_SIZE users. Until 2026-10-01 this took a median of raw
// starting prices across pricing models, so a trade served mostly by per-user tools
// (Fire Protection) ranked "cheapest" against trades priced by flat company plans.
const medianUsd = sharedMedianUsd;
const pricedByTrade = verticals
  .map((v) => {
    const ps = pricedTools.filter((t) => t.verticals.includes(v.slug)).map((t) => perUserEquivalentUsd(t)!);
    return { name: v.name, n: ps.length, median: ps.length ? Math.round(medianUsd(ps)) : 0, min: ps.length ? Math.round(Math.min(...ps)) : 0, max: ps.length ? Math.round(Math.max(...ps)) : 0 };
  })
  .filter((r) => r.n >= 4)
  .sort((a, b) => a.median - b.median);
const cheapestTrade = pricedByTrade[0];
const priciestTrade = pricedByTrade[pricedByTrade.length - 1];

// Freshness
const freshCount = tools.filter((t) => freshnessTier(t) === 'fresh').length;

// --- THE FULL CONTRACTOR STACK (beyond FSM): June 2026 expansion ---
const stackCats = [
  { name: 'Accounting', items: accountingSoftware },
  { name: 'Payments', items: paymentProcessors },
  { name: 'Business banking', items: bankingProviders },
  { name: 'Financing', items: financingProviders },
  { name: 'Insurance', items: insuranceProviders },
  { name: 'Lead generation', items: leadGenPlatforms },
  { name: 'Payroll', items: payrollServices },
  { name: 'Marketing agencies', items: marketingAgencies },
  { name: 'AI tools', items: aiTools },
];
const flaggedIn = (arr: readonly any[]) => arr.filter((x) => x && x.reputation_flag).length;
const stackRows = stackCats.map((c) => ({ name: c.name, total: c.items.length, flagged: flaggedIn(c.items as any[]) }));
const adjacentVendorCount = stackCats.reduce((s, c) => s + c.items.length, 0);
const totalStackVendors = tools.length + adjacentVendorCount;
const totalCategories = stackCats.length + 1; // + FSM software
const totalFlagged = stackRows.reduce((s, c) => s + c.flagged, 0);
const flagsSorted = [...stackRows].filter((r) => r.flagged > 0).sort((a, b) => b.flagged - a.flagged);
const acctPriced = accountingSoftware.filter((a: any) => a.starting_price_usd !== null && a.starting_price_usd !== undefined).length;

// --- INTERNATIONAL FOOTPRINT (markets beyond the US) ---
const intlModules = import.meta.glob('../data/international/*.json', { eager: true });
const intlMarkets = Object.keys(intlModules).length;
const intlVendorCount = Object.values(intlModules).reduce(
  (s: number, m: any) => s + (m.default?.vendors?.length ?? m.vendors?.length ?? 0),
  0
);
// Entries with category 'certification' are regulators and schemes (ZATCA, Gas Safe
// Register and the like), not vendors, so the prose counts them separately.
const intlCertCount = Object.values(intlModules).reduce(
  (s: number, m: any) => s + (m.default?.vendors ?? m.vendors ?? []).filter((v: any) => v.category === 'certification').length,
  0
);

// --- PROSE FIGURES (2026-10-01) ---
// Names, counts and rankings quoted in the prose are computed here from the data
// files, so the copy cannot drift from the tables beside it. Until 2026-10-01 the
// flag paragraph ranked financing second against a table that showed banking
// second, and the specialty paragraph named one pool platform when there were four.
type DirTool = (typeof tools)[number];
const listJoin = (xs: string[]) => (xs.length > 1 ? `${xs.slice(0, -1).join(', ')} and ${xs[xs.length - 1]}` : xs[0] ?? '');
const catLabel = (name: string) => (name.startsWith('AI ') ? name : name.charAt(0).toLowerCase() + name.slice(1));
const capFirst = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const pickTools = (slugs: string[], keep: (t: DirTool) => boolean = () => true) =>
  slugs.map((s) => tools.find((t) => t.slug === s)).filter((t): t is DirTool => !!t && keep(t));
const pickNames = (slugs: string[], keep?: (t: DirTool) => boolean) => listJoin(pickTools(slugs, keep).map((t) => t.name));
const priceOf = (slug: string) => tools.find((t) => t.slug === slug)?.pricing;

// The data date: the latest verified_date among the tools and the adjacent-stack
// vendors this report counts. It is derived from the data, so a data edit moves the
// citation date with the figures (until 2026-10-01 it was a hand-edited constant).
// The header label and both suggested citations use it.
const allVerified = [
  ...tools.map((t) => t.pricing.verified_date),
  ...stackCats.flatMap((c) => (c.items as any[]).map((x) => x.verified_date)),
].filter((d): d is string => typeof d === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(d)).sort();
const DATA_AS_OF = allVerified[allVerified.length - 1];
const toolVerified = tools.map((t) => t.pricing.verified_date).filter((d): d is string => typeof d === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(d)).sort();
const priceOldestDay = toolVerified.length ? new Date(`${toolVerified[0]}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }) : '';
const dataAsOfDay = new Date(`${DATA_AS_OF}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
// The last edit to this page's copy. dateModified is whichever is later, the copy
// edit or the data date.
const PAGE_MODIFIED = '2026-10-01';
const dateModified = PAGE_MODIFIED > DATA_AS_OF ? PAGE_MODIFIED : DATA_AS_OF;

// Named prices
const joistPricing = priceOf('joist');
const tradifyPricing = priceOf('tradify');
const markatePricing = priceOf('markate');

// Free trials
const trialLengths = tools.map((t) => t.pricing.free_trial_days ?? 0).filter((d) => d > 0);
const trialTally = new Map<number, number>();
for (const d of trialLengths) trialTally.set(d, (trialTally.get(d) ?? 0) + 1);
const [trialModeDays, trialModeCount] = [...trialTally].sort((a, b) => b[1] - a[1])[0] ?? [0, 0];
const trials30plus = trialLengths.filter((d) => d >= 30).length;
const longTrialExamples = pickNames(['maintainx', 'limble'], (t) => (t.pricing.free_trial_days ?? 0) >= 30);

// Integrations
const hasXero = (t: DirTool) => t.integrations.some((i) => i.includes('xero'));
const nonUsXero = (t: DirTool) => hasXero(t) && !!t.headquartered && isNonUsHQ(t.headquartered);
const xeroNonUsCount = tools.filter(nonUsXero).length;
const xeroNonUsExamples = pickNames(['tradify', 'bigchange', 'powered-now'], nonUsXero);
const xeroExamples = pickNames(['tradify', 'simpro', 'bigchange'], hasXero);
const sageExamples = pickNames(['buildops', 'procore', 'servicetrade'], (t) => t.integrations.some(isSageOrNetsuite));
const withQBDesktop = tools.filter((t) => t.integrations.includes('quickbooks_desktop')).length;
const withQBOnlineOnly = tools.filter((t) => t.integrations.includes('quickbooks_online') && !t.integrations.some((i) => i === 'quickbooks' || i === 'quickbooks_desktop')).length;
// Plain 'quickbooks' with no edition named; Desktop + Online-only + this = withQuickBooks.
const withQBUnspecified = tools.filter((t) => t.integrations.includes('quickbooks') && !t.integrations.includes('quickbooks_desktop')).length;
// CompanyCam integrations from both sides: CompanyCam's own list and every tool that
// lists CompanyCam (until 2026-10-01 only CompanyCam's side was read, which left out
// Housecall Pro, FieldPulse and others that list it).
const ccSide = new Set(tools.find((t) => t.slug === 'companycam')?.integrations ?? []);
const companyCamPartnerTools = tools
  .filter((t) => t.slug !== 'companycam' && (ccSide.has(t.slug) || t.integrations.includes('companycam')))
  .sort((a, b) => a.name.localeCompare(b.name));
const companyCamPartners = listJoin(companyCamPartnerTools.map((t) => t.name));

// Large teams: tools whose listed best-fit team size reaches past 50 (or is open-ended)
const largeTeamTools = tools.filter((t) => teamSizeBucket(t) === 'large');
const largeQuoteOnly = largeTeamTools.filter(isQuoteOnly).length;

// Adjacent-stack category nouns for the "Beyond" paragraph
const stackNoun: Record<string, string> = {
  Accounting: 'accounting tools',
  Payments: 'payment processors',
  'Business banking': 'business banks',
  Financing: 'financing providers',
  Insurance: 'insurance providers',
  'Lead generation': 'lead-generation platforms',
  Payroll: 'payroll services',
  'Marketing agencies': 'marketing agencies',
  'AI tools': 'AI tools',
};
const stackRowsText = listJoin(stackRows.map((r) => `${r.total} ${stackNoun[r.name] ?? catLabel(r.name)}`));

// Headquarters
const hqExamples = listJoin(
  pickTools(['tradify', 'bigchange', 'powered-now', 'praxedo', 'vonigo', 'joist'], (t) => !!t.headquartered && isNonUsHQ(t.headquartered))
    .map((t) => `${t.name} (${t.headquartered})`)
);

// Vertical coverage and specialty depth (a vertical-fit score of 10, the top of the 1-10 scale)
const topCovered = verticalSizes.slice(0, 3);
const topCoveredText = listJoin(topCovered.map((v, i) => `${v.name} (${v.count}${i === 0 ? ' platforms' : ''})`));
const listAllTopCovered = tools.filter((t) => topCovered.every((v) => t.verticals.includes(v.slug))).length;
const specialistsFor = (slug: string) =>
  tools.filter((t) => t.vertical_fit?.[slug] === 10).map((t) => t.name.split(' (formerly ')[0]);
const specialtyFor = (slug: string) => {
  const names = specialistsFor(slug);
  return names.length ? `${names.length} (${listJoin(names)})` : 'none';
};
const tradesWithoutSpecialist = listJoin(verticals.filter((v) => specialistsFor(v.slug).length === 0).map((v) => v.name));

// Reputation-flag ranking, from the same rows as the flag table
const flagTop = flagsSorted.filter((r) => r.flagged === flagsSorted[0]?.flagged);
const flagNext = flagsSorted.filter((r) => r.flagged === flagsSorted[flagTop.length]?.flagged);
const flagLeaders = listJoin([...flagTop, ...flagNext].map((r) => `${catLabel(r.name)} (${r.flagged})`));
const flagRankSentence = flagTop.length
  ? `${capFirst(listJoin(flagTop.map((r) => `${catLabel(r.name)} (${r.flagged} of ${r.total} vendors tracked)`)))} ${flagTop.length > 1 ? 'share' : 'has'} the most flags` +
    (flagNext.length ? `, followed by ${listJoin(flagNext.map((r) => `${catLabel(r.name)} (${r.flagged} of ${r.total})`))}` : '') +
    '.'
  : '';

// International market names, from the same data files as intlMarkets
const intlMarketNames = listJoin(
  Object.keys(intlModules)
    .map((p) => (p.split('/').pop() ?? '').replace('.json', ''))
    .map((code) => INTL_MARKETS[code]?.name ?? code.toUpperCase())
    .sort((a, b) => a.localeCompare(b))
);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Trades software market report 2026: pricing, integrations, and the state of the industry',
  description: `Original analysis of ${tools.length} trades software platforms across ${verticals.length} verticals, expanded to a ${totalStackVendors}-vendor contractor software stack and ${intlMarkets} international markets. Pricing distribution, integration prevalence, the reputation-flag ledger, and the multi-market picture from the WrenchStack directory.`,
  datePublished: '2026-05-26',
  dateModified,
  author: {
    '@type': 'Organization',
    name: 'WrenchStack Research',
    url: 'https://wrenchstack.com/research/',
  },
  publisher: {
    '@type': 'Organization',
    name: 'WrenchStack',
    logo: { '@type': 'ImageObject', url: 'https://wrenchstack.com/logo.png' },
  },
};
---

<Layout
  title="Trades software market report 2026: pricing, integrations, state of the industry"
  description={`Original analysis of ${tools.length} trades software platforms: pricing, integrations, founding years and vendor reputation flags. Data as of ${dataAsOfDay}.`}
  breadcrumbs={breadcrumbs}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <article class="mx-auto max-w-4xl px-4 py-12">
    <header class="mb-12">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-orange-600">
        Original Research · Data as of {dataAsOfDay}
      </p>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">
        Trades software market report 2026
      </h1>
      <p class="mt-4 text-lg text-slate-700 leading-relaxed sm:text-xl">
        Original data findings from analysis of {tools.length} trades software platforms across {verticals.length} verticals, now expanded to a {totalStackVendors}-vendor contractor software stack ({totalCategories} categories) and {intlMarkets} international markets. What pricing actually looks like in 2026, which integrations matter, who we flag and why, and where the gaps are.
      </p>
      <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm text-slate-500">
        <span><a href="/research/" class="text-orange-600 hover:underline">WrenchStack Research</a></span>
        <span class="text-slate-300">·</span>
        <span>Data: <a href="/methodology/" class="text-orange-600 hover:underline">WrenchStack methodology</a></span>
        <span class="text-slate-300">·</span>
        <span>{tools.length} platforms · {verticals.length} verticals</span>
      </div>
    </header>

    <section class="mb-12 rounded-lg border border-orange-200 bg-orange-50 p-6">
      <h2 class="mb-3 text-lg font-bold text-slate-900">TL;DR for journalists and analysts</h2>
      <ul class="space-y-1 text-sm text-slate-700">
        <li>· Median published entry price across the directory: <strong>${medianPrice}/month</strong> blended across per-user and flat-fee plans (range ${minPrice}-${maxPrice}); per-user median <strong>${perUserMedian()}/user/month</strong>, flat-fee median <strong>${flatFeeMedian()}/month</strong></li>
        <li>· <strong>{customQuotedPct}%</strong> of platforms use custom-quoted "request a demo" pricing instead of publishing tier prices</li>
        <li>· <strong>{withQuickBooks}</strong> of {tools.length} platforms integrate with QuickBooks ({Math.round(withQuickBooks/tools.length*100)}%), the most common integration we track</li>
        <li>· <strong>{post2015}</strong> of the {foundedYears.length} platforms with a founding year on record were founded in 2015 or later</li>
        <li>· <strong>{avgTrialDays}-day</strong> average free trial across the {withFreeTrial} platforms that offer one; {trials30plus} offer 30 days or more</li>
        <li>· <strong>{totalStackVendors}</strong> vendors tracked across <strong>{totalCategories} categories</strong>: trades software plus accounting, payments, banking, financing, insurance, lead-gen, payroll, marketing and AI</li>
        <li>· <strong>{totalFlagged}</strong> vendors across the adjacent-category stack carry a documented reputation warning, led by {flagLeaders}</li>
        <li>· <strong>{intlMarkets} international markets</strong> covered ({intlVendorCount} localized listings: {intlVendorCount - intlCertCount} vendors and {intlCertCount} certification and regulatory bodies)</li>
        <li>· By trade, counting cost per user (flat plans split across a {REFERENCE_TEAM_SIZE}-person team), <strong>{cheapestTrade?.name}</strong> has the lowest median published entry price (<strong>${cheapestTrade?.median}/user/mo</strong>) and <strong>{priciestTrade?.name}</strong> the highest (<strong>${priciestTrade?.median}/user/mo</strong>)</li>
      </ul>
      <p class="mt-3 text-xs text-slate-600">
        Prices are taken from each vendor's own pricing page and dated per row. Cite as: "WrenchStack Trades Software Market Report 2026," WrenchStack Research, data as of {dataAsOfDay} · <a href="mailto:press@wrenchstack.com" class="text-orange-600 hover:underline">press@wrenchstack.com</a>
      </p>
    </section>

    <section class="prose prose-slate max-w-none">

      <h2>Pricing: what trades software actually costs</h2>

      <p>
        Published entry prices in the directory run from ${minPrice} to ${maxPrice} a month, before allowing for whether a plan is priced per user or per company. Entry-tier platforms like Joist (${joistPricing?.starting_at_usd}/month {joistPricing?.tiers[0]}) and Tradify (${tradifyPricing?.starting_at_usd}/user/month {tradifyPricing?.tiers[0]} tier) live alongside platforms like ServiceTitan and BuildOps that publish no price at all. The median published entry price across our directory is <strong>${medianPrice}/month</strong>. That blended figure mixes pricing models and is not a per-seat rate: {perUserPriced} platforms charge per user each month (median <strong>${perUserMedian()} per user/month</strong>){otherModelClause ? ', ' : ' and '}{flatPriced} charge a flat monthly platform fee (median <strong>${flatFeeMedian()}/month</strong>){otherModelClause ? ` and ${otherModelClause}` : ''}. Our price tiers compare cost per user instead, with each flat plan split across a {REFERENCE_TEAM_SIZE}-person team: {tierDist.entry} platforms come in under $100 per user a month, {tierDist.mid} at $100-$249, {tierDist.enterprise} at $250 or more, and {tierDist['quote-only']} have no monthly price to compare. Of those, {customQuoted} publish no price at all{nonMonthlyPriced.length ? `, and ${listJoin(nonMonthlyPriced.map((t) => t.name))} ${nonMonthlyPriced.length === 1 ? 'publishes' : 'publish'} only non-monthly prices, such as one-time licenses or per-project fees` : ''}.
      </p>

