---
import Layout from '../../layouts/Layout.astro';
import statesData from '../../data/states.json';

interface State {
  slug: string;
  name: string;
  abbr: string;
  region: string;
}

const states = (statesData as { states: State[] }).states;
const stateCount = states.length;

// Group by region for nicer browsing
const REGION_ORDER = ['Northeast', 'Mid-Atlantic', 'Southeast', 'South', 'Midwest', 'Southwest', 'West'];
const byRegion: Record<string, State[]> = {};
for (const s of states) {
  (byRegion[s.region] ||= []).push(s);
}

const pageTitle = `Trades Software by State: All ${stateCount} States`;
// The state pages used to promise "state-specific licensing context" and "market
// characteristics". The licensing notes were never verified (removed 2026-10-01) and we
// hold no state-level data, so the copy now says what the pages are: the national
// ranking for each trade, linked by state.
const pageDescription = `Field service and trades software for HVAC, plumbing, electrical, roofing and general contractors, linked by state for all ${stateCount} US states. Each state page shows our national ranking for each trade.`;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'States', url: '/state/' },
];
---

<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>
  <article class="mx-auto max-w-5xl px-4 py-12">
    <header class="mb-10">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-orange-600">
        State-by-state
      </p>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">
        Trades Software by State
      </h1>
      <p class="mt-4 text-lg text-slate-600 leading-relaxed">
        Field service software for HVAC, plumbing, electrical, roofing and general contractors, linked by state for all {stateCount} US states. We hold no state-level data, so each state page shows our national ranking for each trade.
      </p>
    </header>

    <div class="space-y-8">
      {REGION_ORDER.filter((r) => byRegion[r]).map((region) => (
        <section>
          <h2 class="mb-3 text-xl font-bold text-slate-900">{region}</h2>
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {byRegion[region]!.map((state) => (
              <a
                href={`/state/${state.slug}/`}
                class="flex items-center justify-between rounded-lg border border-slate-200 bg-white px-4 py-3 no-underline transition hover:border-orange-300 hover:bg-orange-50"
              >
                <span class="font-semibold text-slate-900">{state.name}</span>
                <span class="text-xs text-slate-500">{state.abbr}</span>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>

    <section class="mt-16 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-3 text-base font-bold text-slate-900">What the state pages show</h2>
      <ul class="space-y-2 text-sm text-slate-700 leading-relaxed">
        <li>
          <strong class="text-slate-900">The same ranking in every state.</strong> Each trade is ranked by fit for the trade, then by our <a href="/methodology/" class="underline hover:text-slate-900">Fit Score</a> (vertical fit, pricing transparency and integration coverage), then by name. We have no data on which tools contractors use in a given state, or on state-level prices, so nothing is ranked by state.
        </li>
        <li>
          <strong class="text-slate-900">No licensing summaries.</strong> We have not verified each state's contractor licensing rules, so the state pages do not summarize them. Check the current requirements for your trade with your state's licensing agencies and with the city or county where you work.
        </li>
        <li>
          <strong class="text-slate-900">Looking for software not by location?</strong> Try our <a href="/quiz/" class="underline hover:text-slate-900">matching quiz</a> or browse <a href="/tools/" class="underline hover:text-slate-900">all tools</a>.
        </li>
      </ul>
    </section>
  </article>
</Layout>
