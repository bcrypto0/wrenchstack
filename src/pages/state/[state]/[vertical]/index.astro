---
import Layout from '../../../../layouts/Layout.astro';
import { isStatePageIndexable } from '../../../../lib/compare-index.mjs';
import statesData from '../../../../data/states.json';
import {
  rankToolsForVertical,
  getVertical,
  verticalToUrl,
  formatPrice,
  wrenchStackScore,
  verticalFitScore,
  isQuoteOnly,
  hasFreeTier,
  type Tool,
} from '../../../../lib/data';
import ToolLogo from '../../../../components/ToolLogo.astro';
import WrenchScore from '../../../../components/WrenchScore.astro';
import FreshnessBadge from '../../../../components/FreshnessBadge.astro';

interface State {
  slug: string;
  name: string;
  abbr: string;
  region: string;
}

// Top verticals where state-level long-tail SEO is most productive.
// Slugs match the verticals defined in categories.json
const TARGET_VERTICALS = ['hvac', 'plumbing', 'electrical', 'roofing', 'general_contractor'];

export async function getStaticPaths() {
  const states = (statesData as { states: State[] }).states;
  const TARGET_VERTICALS = ['hvac', 'plumbing', 'electrical', 'roofing', 'general_contractor'];
  const paths = [];
  for (const state of states) {
    for (const verticalSlug of TARGET_VERTICALS) {
      const vertical = getVertical(verticalSlug);
      if (!vertical) continue;
      paths.push({
        params: { state: state.slug, vertical: verticalToUrl(verticalSlug) },
        props: { state, verticalSlug },
      });
    }
  }
  return paths;
}

interface Props {
  state: State;
  verticalSlug: string;
}

const { state, verticalSlug } = Astro.props;
const vertical = getVertical(verticalSlug)!;

// Keep acronyms (HVAC) in capitals and use the singular trade name, as the trade pages do.
const verticalLower = vertical.name
  .split(' ')
  .map((w) => (/^[A-Z]{2,}$/.test(w) ? w : w.toLowerCase()))
  .join(' ')
  .replace(/^general contractors$/, 'general contractor');

// The national ranking for this trade. We hold no state-level data, so it is the same
// ranking as the trade page and every other state's page.
const allTools = rankToolsForVertical(verticalSlug);
const topTools = allTools.slice(0, 8);

// Tools tied with #1 on both trade fit and Fit Score; the order among them is
// alphabetical, so no single one is presented as the top pick (same rule as the trade page).
const topTied = allTools.length
  ? allTools.filter((t) => verticalFitScore(t, verticalSlug) === verticalFitScore(allTools[0], verticalSlug)
      && wrenchStackScore(t, verticalSlug) === wrenchStackScore(allTools[0], verticalSlug))
  : [];
const nameList = (names: string[]) =>
  names.length > 1 ? `${names.slice(0, -1).join(', ')} and ${names[names.length - 1]}` : names.join('');
const topSentence = topTied.length > 1
  ? `${nameList(topTied.map((t) => t.name))} tie at the top on trade fit and Fit Score (ties are listed alphabetically).`
  : allTools[0]
    ? `${allTools[0].name} ranks first (${formatPrice(allTools[0])}).`
    : '';

// Price facts computed from this trade's tools (2026-10-01). They replace invented
// spend ranges ("$50-$250/user/month", "0.3-0.8% of revenue"). A starting price is not
// always a monthly plan: Bluebeam Revu bills yearly only, and Workyard, Jobber and
// Housecall Pro quote their starting prices with annual billing.
const paidStarts = allTools
  .map((t) => t.pricing.starting_at_usd)
  .filter((p): p is number => p !== null && p > 0)
  .sort((a, b) => a - b);
const quoteOnlyN = allTools.filter(isQuoteOnly).length;
const freeTierN = allTools.filter(hasFreeTier).length;
const otherPricingN = allTools.filter((t) => t.pricing.starting_at_usd === null && !isQuoteOnly(t)).length;
const toolsWord = (n: number) => (n === 1 ? 'tool' : 'tools');
const priceSentence = [
  paidStarts.length
    ? `${paidStarts.length} publish a paid starting price, which we show as a monthly figure: from $${paidStarts[0]} to $${paidStarts[paidStarts.length - 1]} a month. Some of those prices are per user and some per company, and some apply only with annual billing, so price your own team size and billing term on each vendor's page.`
    : '',
  freeTierN ? `${freeTierN} ${freeTierN === 1 ? 'has' : 'have'} a free tier.` : '',
  quoteOnlyN ? `${quoteOnlyN} ${quoteOnlyN === 1 ? 'is' : 'are'} quote-only and publish no price.` : '',
  otherPricingN ? `${otherPricingN} publish one-time or per-project prices instead of a monthly plan.` : '',
].filter(Boolean).join(' ');

// "How to choose" brackets, filled from this trade's ranking with the trade page's
// rule: a tool counts in every bracket its stated best team size range overlaps, and
// tools with no stated team size are left out. They replace fixed picks ("Jobber,
// Housecall Pro, Workiz dominate here") and an invented 3-6 month implementation.
const teamRange = (t: Tool): [number, number] | null => {
  const s = t.best_team_size ?? '';
  const plus = s.match(/^\s*(\d+)\s*\+\s*$/);
  if (plus) return [Number(plus[1]), Infinity];
  const m = s.match(/(\d+)-(\d+)/);
  return m ? [Number(m[1]), Number(m[2])] : null;
};
const sizeBracket = (heading: string, rule: string, lo: number, hi: number) => {
  const fits = allTools.filter((t) => {
    const r = teamRange(t);
    return r !== null && r[0] <= hi && r[1] >= lo;
  });
  return { heading, rule, total: fits.length, picks: fits.slice(0, 3) };
};
const sizeBrackets = [
  sizeBracket('Solo or 1-3 techs', 'overlaps 1 to 3 techs', 1, 3),
  sizeBracket('4-15 techs', 'overlaps 4 to 15 techs', 4, 15),
  sizeBracket('More than 15 techs', 'goes past 15 techs', 16, Infinity),
];

const pageTitle = `Best ${vertical.name} Software for ${state.name} Contractors (2026)`;
const pageDescription = `${verticalLower.charAt(0).toUpperCase()}${verticalLower.slice(1)} software for ${state.name} contractors, ranked by trade fit and Fit Score, with starting prices and the date each price was verified. The ranking is the same in every state.`;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'States', url: '/state/' },
  { name: state.name, url: `/state/${state.slug}/` },
  { name: vertical.name, url: `/state/${state.slug}/${verticalToUrl(verticalSlug)}/` },
];

const faqs = [
  {
    q: `What's the best ${verticalLower} software for ${state.name} contractors?`,
    a: `Our ${verticalLower} ranking is the same in every state, because we hold no state-level data. It is ordered by fit for the trade, then by our Fit Score (vertical fit, pricing transparency and integration coverage), then by name. ${topSentence} The right choice depends on your team size and budget; see the team-size brackets on this page or take our matching quiz.`,
  },
  {
    q: `Do I need ${verticalLower} software that's specific to ${state.name}?`,
    a: `Our tool data records no state-specific features or restrictions, so we do not rank tools by state. If you need license numbers on quotes and invoices, or want to keep insurance certificates and each tech's credentials on file, check that the tool does it before you buy. We have not verified ${state.name}'s licensing rules; check them with ${state.name}'s licensing agencies and with your city or county.`,
  },
  {
    q: `How much does ${verticalLower} software cost in ${state.name}?`,
    a: `We record each vendor's published prices, not state-level prices. Of the ${allTools.length} ${verticalLower} ${toolsWord(allTools.length)} in our directory, ${priceSentence} Our <a href="/roi-calculator/" class="underline">ROI calculator</a> works from your own numbers.`,
  },
  {
    q: `Which platforms are most popular with ${state.name} contractors?`,
    a: `We have no data on which platforms ${state.name} contractors use, so this page does not rank by popularity. The order above is our national ranking for ${verticalLower} software.`,
  },
  {
    q: `Can I switch ${verticalLower} software easily in ${state.name}?`,
    a: `We have no state-specific information on switching. What moves across depends on each vendor's export and import options, so ask both vendors what they carry over (customer records, job history, recurring agreements) before you commit. Our <a href="/cost-of-switch/" class="underline">cost-of-switch calculator</a> gives a rough estimate from your current tool, target tool and team size.`,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
  })),
};
// Doorway-page gate: these pages are ~98.6% identical across states, so they
// are noindexed unless they have earned external links (see compare-index.mjs).
const noindex = !isStatePageIndexable(state.slug, verticalToUrl(verticalSlug));
---

<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs} affiliate noindex={noindex}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <article class="mx-auto max-w-5xl px-4 py-12">
    <header class="mb-10">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-orange-600">
        {state.name} · {vertical.name}
      </p>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">
        Best {vertical.name} Software for {state.name} Contractors (2026)
      </h1>
      <p class="mt-4 text-lg text-slate-600 leading-relaxed">
        The first {topTools.length} of the {allTools.length} {verticalLower} {toolsWord(allTools.length)} in our directory, ranked by fit for the trade, then by our <a href="/methodology/" class="underline hover:text-slate-900">Fit Score</a> (vertical fit, pricing transparency and integration coverage), then by name. {topSentence} We hold no state-level data on usage, prices or licensing, so this is the same ranking as on our <a href={`/${verticalToUrl(verticalSlug)}/`} class="underline hover:text-slate-900">{verticalLower} software page</a> and every other state's page.
      </p>
    </header>

    <section class="mb-10 rounded-lg border border-blue-200 bg-blue-50 p-6">
      <h2 class="mb-2 text-base font-bold text-blue-900">{state.name} licensing for {verticalLower} work</h2>
      <p class="text-sm text-blue-900 leading-relaxed">
        This page does not summarize {state.name}'s licensing rules for {verticalLower} work, because we have not verified them. Check the current requirements with {state.name}'s licensing agencies and with the city or county where you work before you bid or sign a contract.
      </p>
    </section>

    <section class="mb-12">
      <h2 class="mb-5 text-2xl font-bold text-slate-900">First {topTools.length} in the {verticalLower} ranking</h2>
      <div class="space-y-4">
        {topTools.map((tool, i) => {
          return (
            <div class="rounded-lg border border-slate-200 bg-white p-5">
              <div class="mb-3 flex items-start gap-4">
                <div class="hidden shrink-0 items-center justify-center rounded-full bg-orange-100 text-orange-700 font-bold sm:flex" style="width:36px;height:36px">
                  {i + 1}
                </div>
                <ToolLogo tool={tool} size={48} />
                <div class="min-w-0 flex-1">
                  <h3 class="text-lg font-bold text-slate-900">
                    <a href={`/tools/${tool.slug}/`} class="hover:text-orange-600">{tool.name}</a>
                  </h3>
                  <p class="text-sm italic text-slate-500">{tool.tagline}</p>
                </div>
                <div class="hidden shrink-0 sm:block">
                  <WrenchScore score={wrenchStackScore(tool, verticalSlug)} size="sm" />
                </div>
              </div>

              <p class="mb-3 text-sm text-slate-700 leading-relaxed">
                <strong class="text-slate-900">Best for:</strong> {tool.best_for}
              </p>

              <dl class="grid grid-cols-2 gap-2 text-xs sm:grid-cols-3">
                <div>
                  <dt class="text-slate-500">Starting price</dt>
                  <dd class="font-semibold text-slate-900">{formatPrice(tool)}</dd>
                </div>
                <div>
                  <dt class="text-slate-500">Best team size</dt>
                  <dd class="font-semibold text-slate-900">{tool.best_team_size ?? 'n/a'}</dd>
                </div>
                <div>
                  <dt class="text-slate-500">Pricing verified</dt>
                  <dd class="font-semibold text-slate-900">
                    <FreshnessBadge tool={tool} variant="compact" />
                  </dd>
                </div>
              </dl>

              <div class="mt-4 flex flex-wrap gap-2">
                <a
                  href={`/tools/${tool.slug}/`}
                  class="rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800"
                >
                  Read review →
                </a>
                <a
                  href={tool.affiliate_url.startsWith('http') ? tool.affiliate_url : tool.vendor_url}
                  rel="sponsored nofollow noopener"
                  target="_blank"
                  class="rounded-md border border-orange-300 bg-white px-4 py-2 text-sm font-semibold text-orange-700 hover:bg-orange-50"
                >
                  Visit {tool.name}
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <section class="mb-10 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-3 text-xl font-bold text-slate-900">How to choose by team size</h2>
      <p class="mb-3 text-sm text-slate-700 leading-relaxed">
        Each tool counts in every bracket that its stated best team size range overlaps. Tools with no stated team size are left out.
      </p>
      <ul class="space-y-2 text-sm text-slate-700 leading-relaxed">
        {sizeBrackets.map((b) => (
          <li>
            <strong class="text-slate-900">{b.heading}:</strong>{' '}
            {b.picks.length > 0
              ? `${b.total} of the ${allTools.length} ${toolsWord(allTools.length)} ${b.total === 1 ? 'lists' : 'list'} a best team size range that ${b.rule}${b.total > b.picks.length ? `; the first ${b.picks.length} in the ranking are` : ':'} ${nameList(b.picks.map((t) => `${t.name} (${formatPrice(t)})`))}.`
              : `No tool in this ranking lists a best team size range that ${b.rule}.`}
          </li>
        ))}
        <li><strong class="text-slate-900">Licensing:</strong> if you need license numbers on quotes and invoices, or want to keep insurance certificates and each tech's credentials on file, check that the tool does it before you buy.</li>
      </ul>
    </section>

    <section class="mb-10">
      <h2 class="mb-5 text-xl font-bold text-slate-900">Frequently asked</h2>
      <div class="space-y-3">
        {faqs.map((f) => (
          <details class="rounded-lg border border-slate-200 bg-white p-4">
            <summary class="cursor-pointer font-semibold text-slate-900">{f.q}</summary>
            <p class="mt-3 text-slate-700 leading-relaxed" set:html={f.a} />
          </details>
        ))}
      </div>
    </section>

    <section class="rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">More for {state.name} contractors</h2>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href={`/state/${state.slug}/`} class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600">
          All trades in {state.abbr} →
        </a>
        <a href={`/${verticalToUrl(verticalSlug)}/`} class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">
          {vertical.name} buyer guide
        </a>
        <a href="/quiz/" class="rounded-md border border-white/30 bg-white/10 px-5 py-3 text-sm font-semibold text-white hover:bg-white/20">
          Take the matching quiz
        </a>
      </div>
    </section>
  </article>
</Layout>
