---
import Layout from '../../layouts/Layout.astro';
import VendorLogo from '../../components/VendorLogo.astro';
import { bankingProviders, bankingByFocus, BANKING_FOCUS_META } from '../../lib/data';
import MissingFromList from '../../components/MissingFromList.astro';

const grouped = bankingByFocus();

const pageTitle = `Best Business Banking for Contractors & Trades (2026)`;
const pageDescription = `Compare ${bankingProviders.length} business bank accounts for contractors by focus (self-employed, small-business checking, banking plus credit), from fintechs such as Found, Relay and Mercury to banks with branches such as Chase and U.S. Bank. Published monthly fees, APYs, cash-deposit rules and account terms.`;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Banking', url: '/banking/' },
];

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Business Banking Providers for Contractors',
  numberOfItems: bankingProviders.length,
  itemListElement: bankingProviders.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'FinancialProduct',
      name: p.name,
      description: p.tagline,
      url: `https://wrenchstack.com/banking/${p.slug}/`,
    },
  })),
};
---

<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  <article class="mx-auto max-w-5xl px-4 py-12">
    <header class="mb-10">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-emerald-600">Banking</p>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">
        Best Business Banking for Contractors & Trades (2026)
      </h1>
      <p class="mt-4 text-lg text-slate-600 leading-relaxed">
        A business account keeps job money separate from personal money, and some accounts add tax set-aside, interest on balances or a line of credit. We compare online fintech accounts and big-bank checking by what each is built for, with the fees and limits that matter to trades: monthly fees, cash deposits, wires and account terms.
      </p>
    </header>

    <section class="mb-10 rounded-lg border-l-4 border-orange-500 bg-orange-50/40 p-5">
      <p class="text-xs font-bold uppercase tracking-wider text-orange-600">The short answer</p>
      <p class="mt-2 text-slate-800 leading-relaxed">
        Start with how you get paid. If your trade takes cash, check each account's cash rules first: <a href="/banking/mercury/" class="font-semibold text-orange-700 hover:underline">Mercury</a> and Novo take <strong>no cash deposits</strong>, the other fintechs here take cash through retailers or ATMs with limits or fees, and Chase, Bank of America and U.S. Bank take cash at branches with a free amount each statement cycle. If you are paid by card, ACH or check, pick by the feature you need: tax set-aside (Found, Lili), separate accounts for Profit First (<a href="/banking/relay/" class="font-semibold text-orange-700 hover:underline">Relay</a>), interest on balances (Bluevine checking, Relay and Lili savings, paid Found plans) or a line of credit (Bluevine). Mercury's partner-bank deposit agreement allows <strong>freezes and holds</strong>, and Lili's account agreement allows closure for any reason, so keep a backup account and a cash buffer. No vendor pays for placement.
      </p>
    </section>

    <section class="mb-10 rounded-lg border-2 border-amber-200 bg-amber-50 p-6">
      <h2 class="mb-2 text-base font-bold text-amber-900">Two things to know before you switch</h2>
      <p class="text-sm text-amber-900 leading-relaxed">
        <strong>1. Cash deposits:</strong> Found, Novo, Relay, Mercury, Lili and Bluevine are fintechs whose banking services come from partner banks with FDIC coverage. Mercury and Novo do <em>not</em> accept cash, and the others cap cash deposits or charge for them. If your trade takes a lot of cash, look at a bank with branches (Chase, Bank of America, U.S. Bank) or keep a second account. <strong>2. Account terms:</strong> Mercury's partner-bank deposit agreement allows freezes and holds during investigations and closure at any time, and Lili's account agreement says Lili may close an account for any reason, with or without notice. Relay's partner bank, Thread Bank, agreed to an FDIC consent order in May 2024. Keep a backup account and a cash buffer rather than running your <em>only</em> operating account through one provider.
      </p>
    </section>

    {grouped.map(({ focus, providers }) => {
      const meta = BANKING_FOCUS_META[focus];
      return (
        <section class="mb-12">
          <div class="mb-5">
            <span class="inline-block rounded-full bg-emerald-100 px-3 py-1 text-xs font-bold uppercase tracking-wider text-emerald-900 ring-1 ring-emerald-300">{meta.label}</span>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">{meta.blurb}</p>
          </div>

          <div class="space-y-4">
            {providers.map((p) => (
              <article class="rounded-lg border-2 border-emerald-200 bg-white p-5">
                <div class="mb-3 flex items-start justify-between gap-3">
                  <div class="flex min-w-0 flex-1 items-center gap-3">
                    <VendorLogo name={p.name} url={p.vendor_url} size={40} />
                    <div class="min-w-0">
                      <h3 class="text-xl font-bold text-slate-900">
                        <a href={`/banking/${p.slug}/`} class="hover:text-emerald-600">{p.name}</a>
                      </h3>
                      <p class="text-sm italic text-slate-500">{p.tagline}</p>
                    </div>
                  </div>
                  <div class="shrink-0 text-right text-xs">
                    <p class="font-bold text-slate-900">{p.monthly_fee.split(';')[0]}</p>
                    <p class="text-slate-500">monthly</p>
                  </div>
                </div>

                {p.reputation_flag && (
                  <div class="mb-3 rounded-md border-l-4 border-rose-500 bg-rose-50 px-4 py-3 text-sm text-rose-900">
                    <p class="font-bold uppercase tracking-wider text-xs text-rose-700 mb-1">⚠ Reputation warning</p>
                    <p class="leading-relaxed">{p.reputation_flag.split('.')[0]}.</p>
                  </div>
                )}

                <p class="mb-3 rounded-md bg-slate-50 px-4 py-2 text-sm text-slate-700 leading-snug">
                  <strong class="text-slate-900">APY / yield:</strong> {p.apy}
                </p>

                <dl class="mb-3 grid grid-cols-2 gap-2 text-xs sm:grid-cols-3">
                  <div>
                    <dt class="text-slate-500 uppercase tracking-wider">Focus</dt>
                    <dd class="font-semibold text-slate-900 capitalize">{p.banking_focus.replace(/-/g, ' ')}</dd>
                  </div>
                  <div>
                    <dt class="text-slate-500 uppercase tracking-wider">Founded</dt>
                    <dd class="font-semibold text-slate-900">{p.founded ?? 'n/a'}</dd>
                  </div>
                  <div>
                    <dt class="text-slate-500 uppercase tracking-wider">Trustpilot</dt>
                    <dd class="font-semibold text-slate-900">{p.ratings.trustpilot !== null ? `${p.ratings.trustpilot.toFixed(1)} / 5` : 'n/a'}</dd>
                  </div>
                </dl>

                <p class="mb-3 text-sm text-slate-700 leading-relaxed">
                  <strong class="text-slate-900">Best for:</strong> {p.best_for}
                </p>

                <div class="flex flex-wrap gap-2">
                  <a href={`/banking/${p.slug}/`} class="rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800">Read full review →</a>
                  <a href={p.affiliate_url.startsWith('http') ? p.affiliate_url : p.vendor_url} rel="sponsored nofollow noopener" target="_blank" class="rounded-md border border-emerald-300 bg-white px-4 py-2 text-sm font-semibold text-emerald-700 hover:bg-emerald-50">Visit {p.name}</a>
                </div>
              </article>
            ))}
          </div>
        </section>
      );
    })}

    <section class="mt-12 rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">Where to start</h2>
      <p class="mt-2 text-slate-300 leading-relaxed">
        Solo or 1099 operator: <strong>Found</strong> (tax estimates and set-aside, bookkeeping and 1099 filing, with a free plan) or <strong>Lili</strong> (automatic tax set-aside from the $15/mo Pro plan, cash deposits at retailers). Profit First cash management: <strong>Relay</strong> (up to 20 checking accounts, 50 on Scale, with auto-transfer rules). No-monthly-fee checking with invoicing: <strong>Novo</strong> (no cash deposits). Interest on checking plus a line of credit: <strong>Bluevine</strong> (1.3% APY on Standard in months you meet the activity requirement; lines of $1,000-$250,000 for LLCs and corporations), which Valley National Bancorp agreed in September 2026 to acquire, with closing expected in early 2027. Online-only with large FDIC coverage: <strong>Mercury</strong> (up to $5M through its sweep, no cash deposits). Regular cash deposits: a bank with branches, such as <strong>Chase</strong> (no fee for cash at Chase ATMs; $15/mo unless waived), <strong>U.S. Bank</strong> (no monthly fee; 25 cash units free per cycle) or <strong>Bank of America</strong> (Fundamentals has no monthly fee for the first 12 statement cycles).
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/banking/relay/" class="rounded-md bg-emerald-500 px-5 py-3 text-sm font-semibold text-white hover:bg-emerald-600">See Relay →</a>
        <a href="/payments/" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">Payments</a>
        <a href="/accounting/" class="rounded-md border border-white/30 bg-white/10 px-5 py-3 text-sm font-semibold text-white hover:bg-white/20">Accounting</a>
      </div>
    </section>
    <MissingFromList listName="business-banking providers" count={bankingProviders.length} />
  </article>
</Layout>
