---
import Layout from '../../layouts/Layout.astro';
import {
  tools,
  leadGenPlatforms,
  insuranceProviders,
  payrollServices,
  marketingAgencies,
  aiTools,
  paymentProcessors,
  financingProviders,
  accountingSoftware,
  bankingProviders,
} from '../../lib/data';
import { intlVendorIndex } from '../../lib/intl';
import awardsData from '../../data/awards.json';

// Which vendors may use the 2026 Pick badge. The picker rewrites BOTH snippets,
// so without this a listed vendor who is not an editorial pick could pick their
// name and copy the restricted badge in good faith. The rules block above says
// picks only; this makes the page enforce it rather than merely state it.
const pickWinnerSlugs = new Set(
  (awardsData.categories as Array<{ winner_slug?: string }>)
    .map((c) => c.winner_slug)
    .filter((x): x is string => Boolean(x))
);

// Vendor picker, added 2026-09-04.
//
// The embed code used to hardcode the homepage, with a paragraph further down
// telling the vendor to hand-edit the URL to their own review page. That is a
// step most people will not take, so the default outcome of this page was a
// badge pointing at wrenchstack.com/ rather than at the write-up the badge is
// actually claiming. Picking your product now rewrites the snippet for you.
const vendorIndex: Array<{ name: string; url: string }> = [
  ...tools.map((t) => ({ name: t.name, url: `https://wrenchstack.com/tools/${t.slug}/`, pick: pickWinnerSlugs.has(t.slug) })),
  ...leadGenPlatforms.map((v) => ({ name: v.name, url: `https://wrenchstack.com/lead-gen/${v.slug}/` })),
  ...insuranceProviders.map((v) => ({ name: v.name, url: `https://wrenchstack.com/insurance/${v.slug}/` })),
  ...payrollServices.map((v) => ({ name: v.name, url: `https://wrenchstack.com/payroll/${v.slug}/` })),
  ...marketingAgencies.map((v) => ({ name: v.name, url: `https://wrenchstack.com/agencies/${v.slug}/` })),
  ...aiTools.map((v) => ({ name: v.name, url: `https://wrenchstack.com/ai-tools/${v.slug}/` })),
  ...paymentProcessors.map((v) => ({ name: v.name, url: `https://wrenchstack.com/payments/${v.slug}/` })),
  ...financingProviders.map((v) => ({ name: v.name, url: `https://wrenchstack.com/financing/${v.slug}/` })),
  ...accountingSoftware.map((v) => ({ name: v.name, url: `https://wrenchstack.com/accounting/${v.slug}/` })),
  ...bankingProviders.map((v) => ({ name: v.name, url: `https://wrenchstack.com/banking/${v.slug}/` })),
  ...intlVendorIndex(),
].sort((a, b) => a.name.localeCompare(b.name));

const pageTitle = 'Embeddable Badges: Rated on WrenchStack';
const pageDescription = 'Free embeddable badges for vendors listed or selected on WrenchStack. Independent: no vendor pays to be listed, and displaying a badge never changes a rating. Copy-paste HTML, links back to your independent review.';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Badges', url: '/badges/' },
];

const ratedEmbed = `<a href="https://wrenchstack.com/" target="_blank" rel="noopener">
  <img src="https://wrenchstack.com/badges/rated-on-wrenchstack.svg"
       alt="Rated on WrenchStack, independent review" width="240" height="64" />
</a>`;

const pickEmbed = `<a href="https://wrenchstack.com/" target="_blank" rel="noopener">
  <img src="https://wrenchstack.com/badges/wrenchstack-2026-pick.svg"
       alt="WrenchStack 2026 Pick" width="240" height="64" />
</a>`;
---

<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>
  <article class="mx-auto max-w-4xl px-4 py-12">

    <header class="mb-10">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-orange-600">For vendors</p>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">
        Embeddable badges
      </h1>
      <p class="mt-4 text-lg text-slate-600 leading-relaxed">
        Listed or selected on WrenchStack? Show it. These badges are free to embed on your site, link back to your independent review, and tell your customers a third party assessed you, not that you bought a placement.
      </p>
    </header>

    <section class="mb-10 rounded-lg border-2 border-emerald-200 bg-emerald-50 p-6">
      <h2 class="mb-3 text-base font-bold text-slate-900">The rules (because independence is the whole point)</h2>
      <ul class="space-y-2 text-sm text-slate-700">
        <li class="flex gap-2"><span class="text-emerald-600">✓</span> <span><strong>Free for any vendor we list.</strong> Listing, rating and badge display carry no charge.</span></li>
        <li class="flex gap-2"><span class="text-emerald-600">✓</span> <span><strong>Displaying a badge does not change your rating.</strong> Our <a href="/methodology/" class="text-orange-600 hover:underline">Fit Score</a> is computed the same way whether or not you embed anything.</span></li>
        <li class="flex gap-2"><span class="text-emerald-600">✓</span> <span><strong>Link it to your review.</strong> Point the badge at your own WrenchStack review page (see below) so visitors can read the full, independent write-up.</span></li>
        <li class="flex gap-2"><span class="text-rose-500">✗</span> <span><strong>Use the "2026 Pick" badge only if you're an <a href="/awards/2026/" class="text-orange-600 hover:underline">editorial pick</a>.</strong> The "Rated on WrenchStack" badge is for any listed vendor.</span></li>
      </ul>
    </section>

    <section class="mb-8 rounded-lg border border-slate-200 bg-white p-6">
      <label for="vendor-picker" class="block text-base font-bold text-slate-900">
        Pick your product and the code below points at your review
      </label>
      <p class="mt-1 text-sm text-slate-600">
        Optional. Leave it unset and the badge links to our homepage instead.
      </p>
      <select
        id="vendor-picker"
        class="mt-3 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 focus:border-orange-500 focus:outline-none"
      >
        <option value="https://wrenchstack.com/">Not listed yet, or link to the homepage</option>
        {vendorIndex.map((v) => <option value={v.url} data-pick={v.pick ? 'yes' : 'no'}>{v.name}</option>)}
      </select>
      <p class="mt-3 text-xs text-slate-500">
        {vendorIndex.length} vendors listed. Missing? <a href="/for-vendors/" class="text-orange-600 hover:underline">Send us your product</a> and we will review it.
      </p>
    </section>

    <!-- Badge 1 -->
    <section class="mb-8">
      <h2 class="mb-4 text-2xl font-bold text-slate-900">"Rated on WrenchStack": any listed vendor</h2>
      <div class="rounded-lg border border-slate-200 bg-white p-6">
        <div class="mb-5 flex items-center justify-center rounded-md bg-slate-50 py-8">
          <img src="/badges/rated-on-wrenchstack.svg" alt="Rated on WrenchStack, independent review" width="240" height="64" />
        </div>
        <p class="mb-2 text-xs font-bold uppercase tracking-wider text-slate-500">Embed code</p>
        <pre class="overflow-x-auto rounded-md bg-slate-900 p-4 text-xs leading-relaxed text-slate-100"><code id="rated-code">{ratedEmbed}</code></pre>
        <button
          onclick="navigator.clipboard.writeText(document.getElementById('rated-code').textContent); this.textContent='Copied!'; setTimeout(() => this.textContent='Copy embed code', 1500)"
          class="mt-3 rounded-md bg-orange-500 px-4 py-2 text-sm font-semibold text-white hover:bg-orange-600">Copy embed code</button>
      </div>
    </section>

    <!-- Badge 2 -->
    <section id="pick-badge-section" class="mb-10 transition-opacity">
      <h2 class="mb-4 text-2xl font-bold text-slate-900">"WrenchStack 2026 Pick": editorial picks only</h2>
      <div class="rounded-lg border border-slate-200 bg-white p-6">
        <div class="mb-5 flex items-center justify-center rounded-md bg-slate-50 py-8">
          <img src="/badges/wrenchstack-2026-pick.svg" alt="WrenchStack 2026 Pick" width="240" height="64" />
        </div>
        <p class="mb-2 text-xs font-bold uppercase tracking-wider text-slate-500">Embed code</p>
        <pre class="overflow-x-auto rounded-md bg-slate-900 p-4 text-xs leading-relaxed text-slate-100"><code id="pick-code">{pickEmbed}</code></pre>
        <button
          id="pick-copy-btn"
          onclick="if (this.disabled) return; navigator.clipboard.writeText(document.getElementById('pick-code').textContent); this.textContent='Copied!'; setTimeout(() => this.textContent='Copy embed code', 1500)"
          class="mt-3 rounded-md bg-orange-500 px-4 py-2 text-sm font-semibold text-white hover:bg-orange-600">Copy embed code</button>
        <p id="pick-badge-note" hidden class="mt-3 rounded-md bg-amber-50 px-3 py-2 text-xs font-semibold text-amber-900"></p>
        <p class="mt-3 text-xs text-slate-500">Won a category in the <a href="/awards/2026/" class="underline">2026 Awards</a>? You're cleared to use this one.</p>
      </div>
    </section>

    <section class="mb-10 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-2 text-lg font-bold text-slate-900">Linking the badge to your review</h2>
      <p class="text-sm text-slate-700 leading-relaxed">
        Use the picker above and the snippet already carries your review URL. If you would rather
        edit it by hand, replace <code class="rounded bg-slate-200 px-1 text-xs">https://wrenchstack.com/</code>
        with your own page: US software vendors live at <code class="rounded bg-slate-200 px-1 text-xs">wrenchstack.com/tools/your-name/</code>,
        international vendors at <code class="rounded bg-slate-200 px-1 text-xs">wrenchstack.com/&lt;country&gt;/your-name/</code>.
        Cannot find yours? <a href="/contact/" class="text-orange-600 hover:underline">Ask us</a> and we will send the exact link.
      </p>
    </section>

    <section class="rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">Something to correct, or want to be reviewed?</h2>
      <p class="mt-2 text-slate-300 leading-relaxed">
        We list vendors on the merits, with no paid placement. If your details are out of date, or you'd like us to review your product, start here.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/for-vendors/" class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600">Vendor program →</a>
        <a href="/methodology/" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">How we score</a>
        <a href="/editorial-standards/" class="rounded-md border border-white/30 bg-white/10 px-5 py-3 text-sm font-semibold text-white hover:bg-white/20">Editorial standards</a>
      </div>
    </section>
  </article>

  <script is:inline>
    // Rewrites both embed snippets to the picked vendor review URL. The copy
    // buttons read the same textContent, so they copy the rewritten code.
    //
    // The 2026 Pick badge is restricted to editorial picks, and the picker would
    // otherwise hand a non-pick vendor working code for it the moment they chose
    // their own name. Picking a vendor who did not win a category now dims that
    // section and disables its copy button, so the page enforces the rule the
    // rules block states.
    (function () {
      var NL = String.fromCharCode(10);
      var picker = document.getElementById('vendor-picker');
      if (!picker) return;
      var pickSection = document.getElementById('pick-badge-section');
      var pickNote = document.getElementById('pick-badge-note');
      var pickCopy = document.getElementById('pick-copy-btn');
      var targets = [
        {
          el: document.getElementById('rated-code'),
          file: 'rated-on-wrenchstack.svg',
          alt: 'Rated on WrenchStack - independent review',
        },
        {
          el: document.getElementById('pick-code'),
          file: 'wrenchstack-2026-pick.svg',
          alt: 'WrenchStack 2026 Pick',
        },
      ];
      function render(url) {
        targets.forEach(function (t) {
          if (!t.el) return;
          t.el.textContent =
            '<a href="' + url + '" target="_blank" rel="noopener">' + NL +
            '  <img src="https://wrenchstack.com/badges/' + t.file + '"' + NL +
            '       alt="' + t.alt + '" width="240" height="64" />' + NL +
            '</a>';
        });
      }
      function gatePick() {
        if (!pickSection) return;
        var opt = picker.options[picker.selectedIndex];
        var chose = picker.value !== 'https://wrenchstack.com/';
        var eligible = !chose || (opt && opt.getAttribute('data-pick') === 'yes');
        pickSection.style.opacity = eligible ? '' : '0.45';
        if (pickCopy) {
          pickCopy.disabled = !eligible;
          pickCopy.style.cursor = eligible ? '' : 'not-allowed';
        }
        if (pickNote) {
          pickNote.hidden = eligible;
          if (!eligible && opt) {
            pickNote.textContent =
              opt.textContent + ' is not a 2026 editorial pick, so this badge is not one to use. The Rated on WrenchStack badge above is.';
          }
        }
      }
      picker.addEventListener('change', function () {
        render(picker.value);
        gatePick();
      });
      gatePick();
    })();
  </script>
</Layout>
