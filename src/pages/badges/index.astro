---
import Layout from '../../layouts/Layout.astro';
import {
  tools,
  leadGenPlatforms,
  insuranceProviders,
  payrollServices,
  marketingAgencies,
  aiTools,
  paymentProcessors,
  financingProviders,
  accountingSoftware,
  bankingProviders,
} from '../../lib/data';
import { intlVendorIndex } from '../../lib/intl';

// Vendor picker, added 2026-09-04.
//
// The embed code used to hardcode the homepage, with a paragraph further down
// telling the vendor to hand-edit the URL to their own review page. That is a
// step most people will not take, so the default outcome of this page was a
// badge pointing at wrenchstack.com/ rather than at the write-up the badge is
// actually claiming. Picking your product now rewrites the snippet for you.
//
// International entries in the 'certification' category are regulators, tax
// offices, laws and trade bodies, not vendors we rate, so they are not offered
// the badge and not counted as vendors (2026-10-01: the count read 712, which
// included 105 of them).
const intlCertUrls = new Set(
  Object.entries(import.meta.glob('../../data/international/*.json', { eager: true })).flatMap(([path, m]: [string, any]) => {
    const code = path.split('/').pop()?.replace('.json', '') ?? '';
    const list: Array<{ slug?: string; category?: string }> = (m.default ?? m).vendors ?? [];
    return list
      .filter((v) => v?.category === 'certification' && v?.slug)
      .map((v) => `https://wrenchstack.com/${code}/${v.slug}/`);
  })
);
const vendorIndexRaw: Array<{ name: string; url: string }> = [
  ...tools.map((t) => ({ name: t.name, url: `https://wrenchstack.com/tools/${t.slug}/` })),
  ...leadGenPlatforms.map((v) => ({ name: v.name, url: `https://wrenchstack.com/lead-gen/${v.slug}/` })),
  ...insuranceProviders.map((v) => ({ name: v.name, url: `https://wrenchstack.com/insurance/${v.slug}/` })),
  ...payrollServices.map((v) => ({ name: v.name, url: `https://wrenchstack.com/payroll/${v.slug}/` })),
  ...marketingAgencies.map((v) => ({ name: v.name, url: `https://wrenchstack.com/agencies/${v.slug}/` })),
  ...aiTools.map((v) => ({ name: v.name, url: `https://wrenchstack.com/ai-tools/${v.slug}/` })),
  ...paymentProcessors.map((v) => ({ name: v.name, url: `https://wrenchstack.com/payments/${v.slug}/` })),
  ...financingProviders.map((v) => ({ name: v.name, url: `https://wrenchstack.com/financing/${v.slug}/` })),
  ...accountingSoftware.map((v) => ({ name: v.name, url: `https://wrenchstack.com/accounting/${v.slug}/` })),
  ...bankingProviders.map((v) => ({ name: v.name, url: `https://wrenchstack.com/banking/${v.slug}/` })),
  ...intlVendorIndex().filter((v) => !intlCertUrls.has(v.url)),
];
// Picker clean up (diff review visitor S7): one entry per URL, a country code printed once
// ("AroFlo (NZ) (NZ)" came from a name that already ends in its code), and a name that
// appears on two pages gets its section, so the two options can be told apart.
const SECTION_LABELS: Record<string, string> = { tools: 'software', 'lead-gen': 'lead generation', insurance: 'insurance', payroll: 'payroll', agencies: 'marketing agency', 'ai-tools': 'AI tools', payments: 'payments', financing: 'financing', accounting: 'accounting', banking: 'banking' };
const seenUrls = new Set<string>();
const deduped = vendorIndexRaw
  .filter((v) => (seenUrls.has(v.url) ? false : (seenUrls.add(v.url), true)))
  .map((v) => ({ ...v, name: v.name.replace(/ \(([A-Z]{2})\) \(\1\)$/, ' ($1)') }));
const nameCounts = new Map<string, number>();
for (const v of deduped) nameCounts.set(v.name, (nameCounts.get(v.name) ?? 0) + 1);
const vendorIndex = deduped
  .map((v) => {
    if ((nameCounts.get(v.name) ?? 0) < 2) return v;
    const section = new URL(v.url).pathname.split('/')[1] ?? '';
    return SECTION_LABELS[section] ? { ...v, name: `${v.name} (${SECTION_LABELS[section]})` } : v;
  })
  .sort((a, b) => a.name.localeCompare(b.name));

const pageTitle = 'Embeddable badge: Listed on WrenchStack';
const pageDescription = 'A free embeddable badge for vendors listed on WrenchStack. No vendor pays to be listed, and displaying the badge does not change a Fit Score or tier. Copy-paste HTML that links to your WrenchStack page.';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Badges', url: '/badges/' },
];

const listedEmbed = `<a href="https://wrenchstack.com/" target="_blank" rel="noopener">
  <img src="https://wrenchstack.com/badges/listed-on-wrenchstack.svg"
       alt="Listed on WrenchStack" width="240" height="64" />
</a>`;
---

<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>
  <article class="mx-auto max-w-4xl px-4 py-12">

    <header class="mb-10">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-orange-600">For vendors</p>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">
        Embeddable badge
      </h1>
      <p class="mt-4 text-lg text-slate-600 leading-relaxed">
        Listed on WrenchStack? This badge is free to embed on your site and can link to your WrenchStack page (pick your product below). It shows where you are listed; it is not a rating, and no vendor pays to be listed.
      </p>
    </header>

    <section class="mb-10 rounded-lg border-2 border-emerald-200 bg-emerald-50 p-6">
      <h2 class="mb-3 text-base font-bold text-slate-900">The rules (because independence is the whole point)</h2>
      <ul class="space-y-2 text-sm text-slate-700">
        <li class="flex gap-2"><span class="text-emerald-600">✓</span> <span><strong>Free for any vendor we list.</strong> Listing and badge display carry no charge.</span></li>
        <li class="flex gap-2"><span class="text-emerald-600">✓</span> <span><strong>Displaying a badge does not change your Fit Score or tier.</strong> Both are worked out under the <a href="/methodology/" class="text-orange-600 hover:underline">methodology</a> the same way whether or not you embed anything.</span></li>
        <li class="flex gap-2"><span class="text-emerald-600">✓</span> <span><strong>Link it to your review.</strong> Point the badge at your own WrenchStack review page (see below) so visitors can read the full, independent write-up.</span></li>
      </ul>
    </section>

    <section class="mb-8 rounded-lg border border-slate-200 bg-white p-6">
      <label for="vendor-picker" class="block text-base font-bold text-slate-900">
        Pick your product and the code below points at your review
      </label>
      <p class="mt-1 text-sm text-slate-600">
        Optional. Leave it unset and the badge links to our homepage instead.
      </p>
      <select
        id="vendor-picker"
        class="mt-3 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 focus:border-orange-500 focus:outline-none"
      >
        <option value="https://wrenchstack.com/">Link to the WrenchStack homepage</option>
        {vendorIndex.map((v) => <option value={v.url}>{v.name}</option>)}
      </select>
      <p class="mt-3 text-xs text-slate-500">
        {vendorIndex.length} vendors listed. Missing? <a href="/for-vendors/" class="text-orange-600 hover:underline">Send us your product</a>.
      </p>
    </section>

    <section class="mb-8">
      <h2 class="mb-4 text-2xl font-bold text-slate-900">"Listed on WrenchStack": any listed vendor</h2>
      <div class="rounded-lg border border-slate-200 bg-white p-6">
        <div class="mb-5 flex items-center justify-center rounded-md bg-slate-50 py-8">
          <img src="/badges/listed-on-wrenchstack.svg" alt="Listed on WrenchStack" width="240" height="64" />
        </div>
        <p class="mb-2 text-xs font-bold uppercase tracking-wider text-slate-500">Embed code</p>
        <pre class="overflow-x-auto rounded-md bg-slate-900 p-4 text-xs leading-relaxed text-slate-100"><code id="listed-code">{listedEmbed}</code></pre>
        <button
          onclick="navigator.clipboard.writeText(document.getElementById('listed-code').textContent); this.textContent='Copied!'; setTimeout(() => this.textContent='Copy embed code', 1500)"
          class="mt-3 rounded-md bg-orange-500 px-4 py-2 text-sm font-semibold text-white hover:bg-orange-600">Copy embed code</button>
      </div>
    </section>

    <section class="mb-10 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-2 text-lg font-bold text-slate-900">Linking the badge to your review</h2>
      <p class="text-sm text-slate-700 leading-relaxed">
        Use the picker above and the snippet already carries your review URL. If you would rather
        edit it by hand, replace <code class="rounded bg-slate-200 px-1 text-xs">https://wrenchstack.com/</code>
        with your own page: US software vendors live at <code class="rounded bg-slate-200 px-1 text-xs">wrenchstack.com/tools/your-name/</code>,
        international vendors at <code class="rounded bg-slate-200 px-1 text-xs">wrenchstack.com/&lt;country&gt;/your-name/</code>.
        Cannot find yours? <a href="/contact/" class="text-orange-600 hover:underline">Ask us</a> for the exact link.
      </p>
    </section>

    <section class="rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">Something to correct, or want to be reviewed?</h2>
      <p class="mt-2 text-slate-300 leading-relaxed">
        No vendor pays to be listed or placed. If your details are out of date, or you'd like us to review your product, start here.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/for-vendors/" class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600">Vendor program →</a>
        <a href="/methodology/" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">How we score</a>
        <a href="/editorial-standards/" class="rounded-md border border-white/30 bg-white/10 px-5 py-3 text-sm font-semibold text-white hover:bg-white/20">Editorial standards</a>
      </div>
    </section>
  </article>

  <script is:inline>
    // Rewrites the embed snippet to the picked vendor page.
    (function () {
      var NL = String.fromCharCode(10);
      var picker = document.getElementById('vendor-picker');
      var code = document.getElementById('listed-code');
      if (!picker || !code) return;
      picker.addEventListener('change', function () {
        code.textContent =
          '<a href="' + picker.value + '" target="_blank" rel="noopener">' + NL +
          '  <img src="https://wrenchstack.com/badges/listed-on-wrenchstack.svg"' + NL +
          '       alt="Listed on WrenchStack" width="240" height="64" />' + NL +
          '</a>';
      });
    })();
  </script>
</Layout>
