---
import Layout from '../../layouts/Layout.astro';
import maData from '../../data/international/ma.json';

interface MaVendor {
  slug: string; name: string; category: string; vendor_url: string;
  tagline: string; market_position: string; ma_specific_note?: string | null;
  tier: 'S' | 'A' | 'F'; reputation_flag: string | null;
  pros: string[]; cons: string[]; typical_pricing: string;
  is_cross_market: boolean; cross_market_link: string | null;
}

const vendors = (maData as { vendors: MaVendor[] }).vendors;
const categories = ['software', 'lead-gen', 'payroll', 'insurance', 'certification'];
const categoryMeta: Record<string, { label: string; description: string }> = {
  'software': { label: 'BTP software & invoicing', description: `Construction and invoicing software sold in Morocco: Gestion BTP (web-based construction management with accounting, per the vendor), EBP Bâtiment Édition Maroc and Sage Batigest Connect (quotes and invoicing for the building trades, with accounting sold as a separate product), Odoo (Morocco accounting localization and a General Contractor package) and Oasis Techno Cloud (an Odoo Community installer with published BTP packs), the Sage and EBP reseller Ciel Informatique, and the online invoicing apps Hisab, Fawatir AI and Aube. None of those three invoicing apps claims DGI accreditation.` },
  'lead-gen': { label: 'Lead generation & tender intelligence', description: `Two kinds of listing: public-tender monitoring services with published prices (Datao, Aljady), which cover construction works along with other sectors, and consumer directories and apps that connect clients with artisans (Sabab.ma, Bricole, Allopro, Bricoul.ma). Sabab.ma publishes no fees for professionals and Bricole is free for them; Allopro sells paid listing packs and Bricoul.ma sells plans that lift a monthly lead cap and raise ranking. None of the four describes charging per lead.` },
  'payroll': { label: 'Payroll (paie): CNSS / IR / AMO', description: `Sage 100 Paie & RH (CNSS, CIMR, CNRA and IR declarations, per Sage), OJRA from Casablanca-based NSE (Windows software with built-in Damancom and Simpl-IR modules, per NSE) and Humantal (CNSS, AMO and IR calculations and Damancom filing, per Humantal). None of the three publishes prices or describes construction-specific features.` },
  'insurance': { label: 'Construction insurance: TRC & décennale', description: `Tous Risques Chantier (TRC) and RC décennale from Moroccan insurers. Wafa Assurance, RMA, AtlantaSanad and Sanlam Maroc (which absorbed Allianz Maroc in July 2026) list both covers; AXA Assurance Maroc lists TR Chantier Batissur but no décennale product. Moroccan press reported in January 2025 that both covers had become mandatory. No insurer here publishes prices: ask for a quote per project.` },
  'certification': { label: 'Compliance & official bodies', description: `The official systems in this directory: the DGI (identifiant fiscal, SIMPL online filing and the e-invoicing reported to start in phases from late 2026), the Qualification & Classification system whose classes cap the size of public works contracts a firm can bid for, the CNSS and its Damancom portal, the ICE (mandatory on official documents since July 2016) and the Registre de Commerce.` },
};
const vendorsByCategory: Record<string, MaVendor[]> = {};
categories.forEach(c => { vendorsByCategory[c] = vendors.filter(v => v.category === c); });

const pageTitle = 'Morocco Construction & Trades Software (BTP) | WrenchStack';
const pageDescription = `Independent directory of ${vendors.length} vendors and official bodies for Moroccan building trades (BTP): construction and invoicing software, public-tender monitoring, artisan directories, payroll with CNSS declarations, and Tous Risques Chantier and RC décennale insurance, plus DGI e-invoicing, Qualification & Classification, CNSS, the ICE and the Registre de Commerce.`;
const breadcrumbs = [ { name: 'Home', url: '/' }, { name: 'Morocco', url: '/ma/' } ];
const enUrl = new URL('/ma/', Astro.site).toString();
const frUrl = new URL('/ma/fr/', Astro.site).toString();
---
<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs} alternateUrls={[{ hreflang: 'en', href: enUrl }, { hreflang: 'fr', href: frUrl }, { hreflang: 'x-default', href: enUrl }]}>
  <article class="mx-auto max-w-5xl px-4 py-12">
    <header class="mb-10">
      <div class="mb-3 flex items-center justify-between gap-3">
        <div class="flex items-center gap-2">
          <span class="text-2xl" aria-hidden="true">🇲🇦</span>
          <p class="text-sm font-semibold uppercase tracking-wider text-orange-600">Morocco · Maroc · BTP</p>
        </div>
        <a href="/ma/fr/" class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">Français</a>
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">Morocco Construction & Trades Software Directory</h1>
      <p class="mt-4 text-lg text-slate-600 leading-relaxed">
        Independent reviews of {vendors.length} Morocco-relevant vendors and official bodies for the building trades (BTP): Moroccan and imported construction and invoicing software, public-tender monitoring (Datao, Aljady), artisan directories, payroll (Sage, OJRA, Humantal) and construction insurance (Wafa, RMA, AtlantaSanad, AXA, Allianz Maroc, now Sanlam), set against the local rules: DGI e-invoicing, reported to start in phases from late 2026; the TRC and RC décennale covers that Moroccan press reported as mandatory in January 2025; the Qualification & Classification system for public works; and the ICE on your invoices.
      </p>
    </header>

    <section class="mb-10 grid gap-3 grid-cols-2 sm:grid-cols-4">
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">{vendors.length}</div>
        <div class="mt-1 text-xs text-slate-600">vendors reviewed</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">Late 2026</div>
        <div class="mt-1 text-xs text-slate-600">e-invoicing phased start reported</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">July 2016</div>
        <div class="mt-1 text-xs text-slate-600">ICE mandatory on official documents</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">20%</div>
        <div class="mt-1 text-xs text-slate-600">standard TVA</div>
      </div>
    </section>

    <section class="mb-10 flex flex-wrap items-center justify-between gap-4 rounded-lg border-2 border-emerald-300 bg-emerald-50 p-5">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-emerald-700">⏰ Compliance guide · Phased start reported from late 2026 · large companies first · technical rules pending</p>
        <h2 class="mt-1 text-base font-bold text-slate-900">Facturation électronique (DGI e-invoicing) for Moroccan contractors</h2>
        <p class="mt-1 text-sm text-slate-700">The reported timeline, who is affected first, the model vendors describe and what the invoicing tools in this directory say about the mandate, without inventing a date or format the DGI has not published.</p>
      </div>
      <a href="/ma/guides/facturation-electronique-maroc/" class="shrink-0 rounded-md bg-emerald-700 px-5 py-3 text-sm font-semibold text-white hover:bg-emerald-800">Read the guide →</a>
    </section>

    <section class="mb-10 flex flex-wrap items-center justify-between gap-4 rounded-lg border border-orange-200 bg-orange-50 p-5">
      <div>
        <h2 class="text-base font-bold text-slate-900">Deciding between two options?</h2>
        <p class="mt-1 text-sm text-slate-700">See Moroccan vendors compared side by side: a short summary, pros and cons, Morocco-specific notes, and pricing, head to head.</p>
      </div>
      <a href="/ma/compare/" class="shrink-0 rounded-md bg-slate-900 px-5 py-3 text-sm font-semibold text-white hover:bg-slate-700">Compare Moroccan vendors →</a>
    </section>

    <section class="mb-10 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-3 text-base font-bold text-slate-900">What’s different about choosing software in Morocco</h2>
      <p class="text-sm text-slate-700 leading-relaxed">
        Four things shape software choices for Moroccan BTP firms. First, <strong>electronic invoicing is coming</strong>: Hespress reported in August 2026 that it will start in phases from the end of 2026, beginning with large companies and suppliers to the public sector, and the DGI had not yet published the technical rules, so be wary of any source that quotes a firm date or format. None of the invoicing apps listed here (Hisab, Fawatir AI, Aube) claims DGI accreditation. Second, <strong>check what each package covers</strong>: EBP Bâtiment and Sage Batigest Connect handle quotes and invoicing for the building trades, with accounting sold as a separate product (EBP Comptabilité Édition Maroc; Sage 100), and ebp.ma lists no payroll product; Odoo ships a Morocco accounting localization; Gestion BTP’s pricing page says its Entreprise licence includes accounting, payroll and DGI and CNSS exports, so ask on its demo which steps it completes for you and which it only exports. Third, <strong>construction insurance</strong>: Moroccan press reported in January 2025 that Tous Risques Chantier and RC décennale had become mandatory, and Wafa says its décennale cover depends on checks by an approved technical-control body, so book the contrôle technique before asking for cover. Fourth, public tenders can ask for a <strong>Qualification & Classification</strong> class, which caps the contract size you can bid for, and a CNSS certificate issued within the last year; and Hespress reported in July 2025 that the tax administration accepts only invoices that carry your <strong>ICE</strong>. Published prices here are in dirham, except Odoo’s (read in USD) and Hisab’s monthly plans (billed in USD).
      </p>
    </section>

    {categories.map(c => {
      const cat = categoryMeta[c];
      const cv = vendorsByCategory[c];
      if (cv.length === 0) return null;
      return (
        <section class="mb-12">
          <div class="mb-5">
            <h2 class="text-2xl font-bold text-slate-900">{cat.label}</h2>
            <p class="mt-1 text-sm text-slate-600 leading-relaxed">{cat.description}</p>
          </div>
          <div class="space-y-4">
            {cv.map(v => {
              const isCert = v.category === 'certification';
              const tierColor = v.tier === 'S' ? 'border-emerald-300' : v.tier === 'F' ? 'border-rose-300' : 'border-blue-300';
              const tierLabel = isCert ? 'Official body / regime' : v.tier === 'S' ? 'Published prices' : v.tier === 'F' ? 'Reputation warning' : 'Listed';
              const tierBadge = v.tier === 'S' ? 'bg-emerald-100 text-emerald-900' : v.tier === 'F' ? 'bg-rose-100 text-rose-900' : 'bg-blue-100 text-blue-900';
              return (
                <article class={`rounded-lg border-2 ${tierColor} bg-white p-5`}>
                  <div class="mb-3 flex items-start justify-between gap-3">
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-2 mb-1 flex-wrap">
                        <h3 class="text-xl font-bold text-slate-900">{v.name}</h3>
                        <span class={`rounded-full px-2 py-0.5 text-xs font-bold ${tierBadge}`}>{isCert ? tierLabel : `Tier ${v.tier} · ${tierLabel}`}</span>
                        </div>
                      <p class="text-sm italic text-slate-500">{v.tagline}</p>
                    </div>
                  </div>
                  <p class="mb-3 text-sm text-slate-700 leading-relaxed">{v.market_position}</p>
                  {v.ma_specific_note && (
                    <div class="mb-3 rounded-md bg-slate-50 px-4 py-3">
                      <p class="text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Morocco-specific note</p>
                      <p class="text-sm text-slate-700 leading-relaxed">{v.ma_specific_note}</p>
                    </div>
                  )}
                  <div class="mb-3 grid gap-3 sm:grid-cols-2">
                    <div>
                      <p class="text-xs font-bold uppercase tracking-wider text-emerald-700 mb-1">{isCert ? 'What it covers' : 'Pros'}</p>
                      <ul class="space-y-1 text-sm text-slate-700">{v.pros.slice(0, 4).map(p => <li class="leading-snug">+ {p}</li>)}</ul>
                    </div>
                    <div>
                      <p class="text-xs font-bold uppercase tracking-wider text-rose-700 mb-1">{isCert ? 'Watch out for' : 'Cons'}</p>
                      <ul class="space-y-1 text-sm text-slate-700">{v.cons.slice(0, 4).map(con => <li class="leading-snug">− {con}</li>)}</ul>
                    </div>
                  </div>
                  <div class="mb-3 text-xs text-slate-600"><strong class="text-slate-900">{isCert ? 'Cost / access:' : 'Typical Morocco pricing:'}</strong> {v.typical_pricing}</div>
                  <div class="flex flex-wrap gap-2">
                    <a href={`/ma/${v.slug}/`} class="rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700">Full Morocco review →</a>
                    <a href={v.vendor_url} rel="sponsored nofollow noopener" target="_blank" class="rounded-md bg-orange-500 px-4 py-2 text-sm font-semibold text-white hover:bg-orange-600">{isCert ? 'Official site' : `Visit ${v.name}`} →</a>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      );
    })}

    <section class="mt-12 rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">Are you a Moroccan software vendor?</h2>
      <p class="mt-2 text-slate-300 leading-relaxed">If you build software or services for Moroccan contractors and the building trades and want to be reviewed, get in touch through our <a href="/for-vendors/" class="underline">vendor program</a>.</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/for-vendors/" class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600">Work with us →</a>
        <a href="/sa/" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">🇸🇦 Saudi directory</a>
        <a href="/methodology/" class="rounded-md border border-white/30 bg-white/10 px-5 py-3 text-sm font-semibold text-white hover:bg-white/20">Methodology</a>
      </div>
    </section>
  </article>
</Layout>
