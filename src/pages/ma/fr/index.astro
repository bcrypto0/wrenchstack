---
import Layout from '../../../layouts/Layout.astro';
import maData from '../../../data/international/ma.json';

interface MaVendor {
  slug: string; name: string; category: string; vendor_url: string;
  tagline: string; tier: 'S' | 'A' | 'F';
  is_cross_market: boolean;
}
const vendors = (maData as { vendors: MaVendor[] }).vendors;

// Concise French positioning per vendor (the detailed reviews remain in English for now).
const fr: Record<string, string> = {
  'gestion-btp-ma': 'Logiciel web marocain de gestion BTP et de comptabilité : devis, factures, chantiers, pointage et paie, avec exports DGI et CNSS selon l’éditeur. Prix publiés dès 950 MAD HT par mois, facturation annuelle ; pas d’essai gratuit.',
  'ebp-batiment-maroc': 'EBP Maroc (Rabat, filiale d’EBP, groupe Cegid depuis juillet 2024) : éditions ACTIV, PRO et ELITE pour devis, factures, situations de travaux et retenue de garantie. Windows, prix sur devis ; comptabilité vendue à part, aucun produit de paie sur ebp.ma.',
  'sage-batigest-connect-maroc': 'Sage Batigest Connect : devis, métré, facturation et suivi de chantier, avec application mobile. Proposé au Maroc par des revendeurs comme Ciel Informatique (Casablanca), avec Sage 100 pour la comptabilité ; prix sur devis.',
  'odoo-btp-maroc': 'ERP Odoo avec un package « General Contractor » (facturation à l’avancement, avenants, suivi des coûts par rapport au devis) et une localisation comptable marocaine. Prix publiés sur odoo.com (relevés en USD) ; paie et applications mobiles réservées à l’édition Enterprise.',
  'hisab': 'Facturation en ligne pour PME et fiduciaires marocaines, lancée début 2026 et exploitée par Boltpath LLC (Nouveau-Mexique, États-Unis) : factures FR/AR, export UBL 2.1 et CII, archivage 10 ans. Dès 1 490 MAD/an ; aucun agrément DGI revendiqué.',
  'fawatir-ai': 'Application marocaine de facturation, devis, caisse, stock et paie (CNSS, AMO et IR selon l’éditeur), avec un copilote IA en français, arabe ou darija. Pro à 1 699 DH/an ; déclare n’être ni certifiée ni agréée par la DGI.',
  'aube-ma': 'Devis, factures, avoirs et situations (avancement par ligne) pour PME, par Aisobotics SARL (Casablanca) : ICE, RC et adresse du client remplis depuis le registre, TVA par ligne. 450 DH HT/mois avec 2 utilisateurs ; données hébergées en Irlande.',
  'ciel-informatique-maroc': 'Revendeur et prestataire casablancais de Sage 50, Sage 100, Sage Batigest Connect et EBP : paramétrage, formation, import de données, assistance et télédéclaration SIMPL (TVA, IS, IR). Prix sur devis.',
  'oasis-techno-cloud': 'Installateur marocain d’Odoo Community avec un pack BTP à prix publiés (MonChantier.ma) : chantiers, budgets, situations avec retenue, sous-traitants. Dès 12 900 MAD en installation locale ; comptabilité marocaine en option ; absent de la liste des partenaires officiels Odoo.',
  'datao': 'Veille IA des appels d’offres publics (travaux, services, fournitures) par UXS SARL AU (Rabat) : résumés, questions sur le CPS, lecture des bordereaux des prix, suivi des attributions. Dès 490 DH HT/mois, payé à l’année.',
  'aljady': 'Veille des marchés publics par Side Invest SARL (Casablanca) : alertes IA, extraction des bordereaux de prix, lots et quantités, historique des concurrents. Dès 590 MAD HT/mois ; essai gratuit de 7 jours.',
  'sabab-ma': 'Application marocaine qui liste les artisans proches dans 8 métiers, dont plomberie, électricité, climatisation, peinture et maçonnerie ; le client appelle ou écrit sur WhatsApp directement. Gratuit pour les clients ; aucun tarif publié pour les pros.',
  'bricole': 'Application Android gratuite de services à domicile (Maroc et Égypte), avec construction, réparation et installation parmi ses catégories. Sans abonnement ni commission ; selon ses conditions, Bricole ne vérifie ni l’identité ni les qualifications des pros.',
  'allopro-bricall': 'Annuaire marocain de services à domicile (ex-Bricall) : jusqu’à 5 devis par demande ; les pros achètent des packs de visibilité (Base 99, Pro 199, Master 399 DH/mois), sans prospects garantis.',
  'bricoul-ma': 'Annuaire d’artisans : profil Basic gratuit (10 prospects/mois), Pro 99 MAD et Premium 199 MAD/mois TTC. Bricoul dit vérifier la CIN et le RC ou le statut d’auto-entrepreneur de chaque artisan.',
  'wafa-assurance': 'Tous Risques Chantier pour les entreprises BTP de toute taille et RC décennale (dix ans à compter de la réception). Selon Wafa, la décennale est subordonnée au contrôle des travaux par un organisme de contrôle technique agréé. Via conseiller, sans prix publiés.',
  'rma-assurance': 'Assureur marocain agréé (liste ACAPS) avec une rubrique BTP : Tous Risques Chantier et RC décennale. Plus de 300 points de vente selon RMA ; sans prix publiés.',
  'atlantasanad': 'Assureur agréé issu de la fusion d’Atlanta et Sanad (2020) : police Tous Risques Chantiers et produit RC décennale distinct. Sans prix publiés ; vérifiez les conditions de contrôle technique.',
  'axa-assurance-maroc': '« TR Chantier Batissur » : tous risques chantier jusqu’à la réception provisoire, avec période de garantie après réception en option. Aucun produit RC décennale listé sur axa.ma ; sans prix publiés.',
  'allianz-maroc': 'Allianz Maroc a été absorbée par Sanlam Maroc en juillet 2026 : Tous Risques Chantier et RC décennale (10 ans après livraison) sous la marque Sanlam. Polices Allianz valables jusqu’à échéance, selon Sanlam ; sans prix publiés.',
  'sage-paie-maroc': 'Sage 100 Paie & RH : déclarations CNSS, CIMR, CNRA et IR produites depuis la paie, mises à jour légales automatiques, selon Sage. Sans prix publics ; demandez comment le fichier CNSS est transmis via Damancom.',
  'ojra-paie': 'Logiciel de paie Windows de NSE (Casablanca) : calcul CNSS, AMO, CIMR et IR, modules Damancom et Simpl-IR intégrés, selon NSE. Prix sur devis.',
  'humantal': 'Paie et RH pour le droit du travail marocain : calculs CNSS, AMO et IR et déclarations via Damancom, selon Humantal. Produit de paie généraliste, sans fonctions chantier décrites ; prix après démo.',
  'qualification-classification-btp': 'Système du Ministère de l’Équipement et de l’Eau (décret n° 2-94-223 de 1994) : la classe détenue fixe le montant maximal des marchés publics auxquels l’entreprise peut soumissionner. Dépôt en ligne depuis 2020.',
  'cnss-immatriculation': 'Caisse Nationale de Sécurité Sociale : déclarations et paiements en ligne via Damancom (double authentification depuis 2025), AMO des salariés. Les marchés publics demandent une attestation CNSS de moins d’un an.',
  'ice-identifiant-commun-entreprise': 'ICE : identifiant commun de l’entreprise, partagé entre administrations et obligatoire sur les documents officiels depuis le 1er juillet 2016 ; à faire figurer sur vos factures.',
  'registre-de-commerce': 'Registre de Commerce : inscription au greffe du tribunal compétent, centralisée par l’OMPIC ; recherche gratuite sur Directinfo (n° RC, tribunal, ICE, activité). Création d’entreprise via la plateforme Direct Entreprise.',
  'dgi-simpl': 'DGI : identifiant fiscal (IF) et services en ligne SIMPL (IS, TVA, IR). Prépare la facturation électronique, annoncée par étapes à partir de fin 2026 (Hespress, août 2026).',
};

const tierFr: Record<string, string> = { S: 'Prix publiés', A: 'Répertorié', F: 'Alerte de réputation' };
const cats = [
  { key: 'software', label: 'Logiciels BTP & facturation', desc: 'Logiciels de gestion BTP et de facturation vendus au Maroc : Gestion BTP (gestion de chantier web avec comptabilité, selon l’éditeur), EBP Bâtiment Édition Maroc et Sage Batigest Connect (devis et facturation du bâtiment, comptabilité vendue à part), Odoo (localisation comptable marocaine et package General Contractor) et Oasis Techno Cloud (installateur Odoo Community avec des packs BTP à prix publiés), le revendeur Sage et EBP Ciel Informatique, et les applications de facturation en ligne Hisab, Fawatir AI et Aube. Aucune de ces trois applications ne revendique d’agrément DGI.' },
  { key: 'lead-gen', label: 'Prospection & veille des marchés', desc: 'Deux types d’offres : la veille des marchés publics à prix publiés (Datao, Aljady), qui couvre les travaux parmi d’autres secteurs, et les annuaires et applications qui mettent les particuliers en relation avec des artisans (Sabab.ma, Bricole, Allopro, Bricoul.ma). Sabab.ma ne publie aucun tarif pour les pros et Bricole est gratuit pour eux ; Allopro vend des packs de visibilité et Bricoul.ma des formules qui lèvent un plafond mensuel de prospects et améliorent le classement. Aucun des quatre ne décrit de facturation au prospect.' },
  { key: 'payroll', label: 'Paie : CNSS / IR / AMO', desc: 'Sage 100 Paie & RH (déclarations CNSS, CIMR, CNRA et IR, selon Sage), OJRA de NSE à Casablanca (logiciel Windows avec modules Damancom et Simpl-IR intégrés, selon NSE) et Humantal (calculs CNSS, AMO et IR et déclarations Damancom, selon Humantal). Aucun des trois ne publie de prix ni ne décrit de fonctions propres au BTP.' },
  { key: 'insurance', label: 'Assurance construction : TRC & décennale', desc: 'Tous Risques Chantier (TRC) et RC décennale auprès d’assureurs marocains. Wafa Assurance, RMA, AtlantaSanad et Sanlam Maroc (qui a absorbé Allianz Maroc en juillet 2026) proposent les deux garanties ; AXA Assurance Maroc propose TR Chantier Batissur mais aucun produit décennale. La presse marocaine a rapporté en janvier 2025 que ces deux garanties étaient devenues obligatoires. Aucun assureur ne publie de prix : demandez un devis par projet.' },
  { key: 'certification', label: 'Conformité & organismes officiels', desc: 'Les systèmes officiels de cet annuaire : la DGI (identifiant fiscal, services en ligne SIMPL et facturation électronique annoncée par étapes à partir de fin 2026), le système de Qualification & Classification, dont la classe plafonne le montant des marchés publics accessibles, la CNSS et son portail Damancom, l’ICE (obligatoire sur les documents officiels depuis juillet 2016) et le Registre de Commerce.' },
];

const enUrl = new URL('/ma/', Astro.site).toString();
const frUrl = new URL('/ma/fr/', Astro.site).toString();
const pageTitle = 'Annuaire des logiciels et services BTP au Maroc | WrenchStack';
const pageDescription = `Avis indépendants sur ${vendors.length} solutions et organismes pour le BTP marocain : logiciels de gestion BTP et de facturation, veille des marchés publics, annuaires d’artisans, paie avec déclarations CNSS et assurance Tous Risques Chantier et RC décennale, avec la facturation électronique DGI, la Qualification & Classification, la CNSS, l’ICE et le Registre de Commerce.`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  lang="fr"
  alternateUrls={[{ hreflang: 'en', href: enUrl }, { hreflang: 'fr', href: frUrl }, { hreflang: 'x-default', href: enUrl }]}
>
  <article class="mx-auto max-w-5xl px-4 py-12">

    <div class="mb-6 flex items-center justify-between gap-3">
      <div class="flex items-center gap-2">
        <span class="text-2xl" aria-hidden="true">🇲🇦</span>
        <p class="text-sm font-semibold uppercase tracking-wider text-orange-600">Maroc · BTP</p>
      </div>
      <a href="/ma/" class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">English</a>
    </div>

    <header class="mb-10">
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">Annuaire des logiciels et services BTP au Maroc</h1>
      <p class="mt-4 text-lg text-slate-600 leading-relaxed">
        Avis indépendants sur {vendors.length} solutions et organismes pertinents pour le BTP marocain : logiciels de gestion BTP et de facturation marocains et importés, veille des marchés publics (Datao, Aljady), annuaires d’artisans, paie (Sage, OJRA, Humantal) et assurance construction (Wafa, RMA, AtlantaSanad, AXA, Allianz Maroc devenue Sanlam), au regard des règles locales : la facturation électronique DGI, annoncée par étapes à partir de fin 2026 ; les garanties TRC et RC décennale que la presse marocaine a présentées comme obligatoires en janvier 2025 ; la Qualification & Classification pour les marchés publics ; et l’ICE sur vos factures.
      </p>
    </header>

    <section class="mb-10 flex flex-wrap items-center justify-between gap-4 rounded-lg border-2 border-emerald-300 bg-emerald-50 p-5">
      <div>
        <p class="text-xs font-bold tracking-wider text-emerald-700">⏰ Guide de conformité · Démarrage par étapes annoncé à partir de fin 2026 · grandes entreprises d’abord · règles techniques en attente</p>
        <h2 class="mt-1 text-base font-bold text-slate-900">La facturation électronique (DGI) pour les entrepreneurs marocains</h2>
        <p class="mt-1 text-sm text-slate-700">La base légale, le calendrier annoncé, qui est concerné en premier et ce que disent les outils de facturation de cet annuaire, sans inventer une date ou un format que la DGI n’a pas publiés.</p>
      </div>
      <a href="/ma/fr/guides/facturation-electronique-maroc/" class="shrink-0 rounded-md bg-emerald-700 px-5 py-3 text-sm font-semibold text-white hover:bg-emerald-800">Lire le guide →</a>
    </section>

    <section class="mb-10 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-3 text-base font-bold text-slate-900">Ce qui distingue le choix d’un logiciel au Maroc</h2>
      <p class="text-sm text-slate-700 leading-relaxed">
        Quatre points orientent le choix d’un logiciel pour une entreprise BTP marocaine. D’abord, <strong>la facturation électronique arrive</strong> : Hespress a rapporté en août 2026 qu’elle démarrera par étapes à partir de fin 2026, en commençant par les grandes entreprises et les fournisseurs du secteur public, et la DGI n’avait pas encore publié les règles techniques : méfiez-vous de toute source qui annonce une date ou un format fermes. Aucune des applications de facturation listées ici (Hisab, Fawatir AI, Aube) ne revendique d’agrément DGI. Ensuite, <strong>vérifiez ce que couvre chaque logiciel</strong> : EBP Bâtiment et Sage Batigest Connect gèrent les devis et la facturation du bâtiment, la comptabilité étant vendue à part (EBP Comptabilité Édition Maroc ; Sage 100), et ebp.ma ne liste aucun produit de paie ; Odoo inclut une localisation comptable marocaine ; Gestion BTP annonce la comptabilité, mais ses fonctions fiscales et de paie n’ont pas pu être confirmées. Par ailleurs, <strong>l’assurance construction</strong> : la presse marocaine a rapporté en janvier 2025 que la Tous Risques Chantier et la RC décennale étaient devenues obligatoires, et Wafa indique que sa garantie décennale est subordonnée au contrôle des travaux par un organisme de contrôle technique agréé : prévoyez le contrôle technique avant de demander la garantie. Enfin, les marchés publics peuvent exiger une classe de <strong>Qualification & Classification</strong>, qui plafonne le montant des marchés accessibles, et une attestation CNSS de moins d’un an ; et Hespress a rapporté en juillet 2025 que l’administration fiscale n’accepte que les factures portant votre <strong>ICE</strong>. La plupart des prix publiés ici sont en dirham ; ceux d’Odoo ont été relevés en USD.
      </p>
    </section>

    {cats.map((cat) => {
      const cv = vendors.filter((v) => v.category === cat.key);
      if (cv.length === 0) return null;
      return (
        <section class="mb-12">
          <div class="mb-5">
            <h2 class="text-2xl font-bold text-slate-900">{cat.label}</h2>
            <p class="mt-1 text-sm text-slate-600 leading-relaxed">{cat.desc}</p>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            {cv.map((v) => {
              const isCert = v.category === 'certification';
              const tierColor = v.tier === 'S' ? 'border-emerald-300' : v.tier === 'F' ? 'border-rose-300' : 'border-blue-300';
              const tierBadge = v.tier === 'S' ? 'bg-emerald-100 text-emerald-900' : v.tier === 'F' ? 'bg-rose-100 text-rose-900' : 'bg-blue-100 text-blue-900';
              const label = isCert ? 'Organisme officiel' : tierFr[v.tier];
              return (
                <article class={`rounded-lg border-2 ${tierColor} bg-white p-4`}>
                  <div class="mb-1 flex items-center gap-2 flex-wrap">
                    <h3 class="text-lg font-bold text-slate-900">{v.name}</h3>
                    <span class={`rounded-full px-2 py-0.5 text-xs font-bold ${tierBadge}`}>{label}</span>
                  </div>
                  <p class="text-sm text-slate-700 leading-relaxed">{fr[v.slug] ?? v.tagline}</p>
                  <div class="mt-3 flex flex-wrap gap-2">
                    <a href={`/ma/${v.slug}/`} class="rounded-md bg-slate-900 px-3 py-1.5 text-xs font-semibold text-white hover:bg-slate-700">Détails (en anglais) →</a>
                    <a href={v.vendor_url} rel="sponsored nofollow noopener" target="_blank" class="rounded-md bg-orange-500 px-3 py-1.5 text-xs font-semibold text-white hover:bg-orange-600">{isCert ? 'Site officiel' : 'Visiter le site'} →</a>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      );
    })}

    <section class="mb-10 rounded-lg border border-slate-200 bg-white p-5 text-sm text-slate-600">
      <p>Les avis détaillés par solution sont disponibles <a href="/ma/" class="font-medium text-orange-600 hover:underline">en anglais</a>.</p>
    </section>

    <section class="rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">Vous êtes éditeur ou prestataire au Maroc ?</h2>
      <p class="mt-2 text-slate-300 leading-relaxed">Si vous proposez un logiciel ou un service pour les entrepreneurs marocains du bâtiment et souhaitez être évalué ou mis en avant, contactez-nous via notre <a href="/for-vendors/" class="underline">programme prestataires</a>.</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/for-vendors/" class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600">Travailler avec nous →</a>
        <a href="/ma/" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">English directory</a>
      </div>
    </section>
  </article>
</Layout>
