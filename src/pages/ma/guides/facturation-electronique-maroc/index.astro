---
import Layout from '../../../../layouts/Layout.astro';

// Tools from our Morocco directory and what each says about the DGI mandate,
// from the entries re-verified on 30 September 2026. None of the invoicing apps
// claims DGI accreditation, and the DGI had not published the technical rules
// as of August 2026 (see the data file).
const tools = [
  { name: 'Hisab', status: 'Exports UBL 2.1 and CII, with e-signature and 10-year archiving; says it is ready for the 2026 mandate and will submit invoices to the DGI for validation; claims no DGI accreditation', fit: 'Online invoicing for SMEs and accounting firms (not a construction tool)', note: 'From 1,490 MAD a year (Starter)', href: '/ma/hisab/' },
  { name: 'Fawatir AI', status: 'Says its invoices carry ICE, IF and TVA; states it is not certified, accredited or approved by the DGI and does not transmit invoices to the tax administration', fit: 'Shops, auto-entrepreneurs, freelancers and small firms', note: 'Pro 1,699 DH a year', href: '/ma/fawatir-ai/' },
  { name: 'Aube', status: 'Says its PDFs carry the article 145 CGI mentions, with unbroken numbering and TVA by line, and that it is ready for the 2026 roadmap; claims no DGI accreditation', fit: 'SME quotes, invoices and situations (progress billing)', note: '450 DH a month excl. VAT, 2 users', href: '/ma/aube-ma/' },
  { name: 'Gestion BTP', status: 'Construction and accounting web app; DGI and CNSS exports per the vendor; e-invoicing features not confirmed', fit: 'BTP management with accounting and payroll, per the vendor', note: 'Published prices from 950 MAD HT a month, billed annually; no free trial', href: '/ma/gestion-btp-ma/' },
  { name: 'Sage Batigest Connect', status: 'Moroccan TVA, CNSS and e-invoicing features not described on the reseller page read', fit: 'Quotes, métré, invoicing and worksite tracking; accounting via Sage 100', note: 'Quote-based; no public prices in Morocco', href: '/ma/sage-batigest-connect-maroc/' },
  { name: 'Odoo', status: 'Ships a Morocco accounting localization (chart of accounts, tax report); an e-invoicing connection is not covered in our entry', fit: 'One system for quotes, projects, purchasing, invoicing and accounting', note: 'Published on odoo.com (USD); implementation extra', href: '/ma/odoo-btp-maroc/' },
];

const faqs = [
  { q: 'When does e-invoicing become mandatory in Morocco?', a: `Hespress reported in August 2026 that e-invoicing will start in phases from the end of 2026, beginning with large companies and suppliers to the public sector. Le360, citing Challenge (June 2026), reported that SMEs follow in 2027-2028 and small firms after 2028. The DGI had not published the technical rules as of August 2026, and Fawatir AI says the official calendar and format for SMEs and the self-employed are not yet published. Treat any source quoting a specific go-live day as unverified.` },
  { q: 'What is the "clearance" model, and is it confirmed?', a: `In a clearance model, each invoice is validated by the tax authority's platform before it reaches the client. Hisab's mandate guide (updated June 2026) describes the Moroccan system this way, and Hisab says it will submit invoices to the DGI for validation. But as of August 2026 the DGI had not published the technical rules, so treat the model as described by vendors, not final.` },
  { q: 'What is the legal basis?', a: 'Hisab’s mandate guide (updated June 2026) says the system rests on article 145 of the Code Général des Impôts (CGI), the same article Aube cites for the mandatory invoice mentions. The implementing technical rules had not been published by the DGI as of August 2026.' },
  { q: 'What format will invoices use?', a: `The DGI had not published the technical rules, including the format, as of August 2026, and Fawatir AI notes that the official format for SMEs and the self-employed is not yet published. Hisab's guide cites UBL 2.1 or UN/CEFACT CII, and Hisab already exports both, but treat the format as pending. Invoices already carry mandatory mentions: Aube lists the ICE, IF, RC, TVA detail and HT/TVA/TTC totals under article 145 of the CGI.` },
  { q: 'Who is affected, and am I (a small contractor) in scope yet?', a: `Hespress (August 2026) reports that the first phase, from the end of 2026, covers large companies and suppliers to the public sector. Le360, citing Challenge (June 2026), put the first wave at about 1,655 companies with turnover above 200 million dirhams, with SMEs in 2027-2028 and small firms after 2028; confirm these thresholds when the implementing text is published. On those reports a small contractor is not in the first wave unless it supplies the public sector, in which case it should check whether the first phase applies to it.` },
  { q: 'What should I do now?', a: `Two practical steps. First, make sure your ICE appears correctly on every invoice and devis: it has been mandatory on official documents since July 2016, and Hespress reported in July 2025 that the tax administration accepts only invoices that carry it. Second, ask your invoicing software one question: "Which mandatory mentions do your invoices carry, and how will you connect to the DGI e-invoicing platform once the DGI publishes the technical rules?" If you are still on Word or Excel, choose invoicing software that stores your ICE and your clients’ ICE numbers.` },
];

const pageTitle = 'DGI E-Invoicing (Facturation Électronique) in Morocco: 2026 Guide for Contractors';
const pageDescription = `Morocco’s planned e-invoicing explained for the building trades: the phased rollout reported from late 2026 for large companies and public-sector suppliers first (with no invented go-live date), the clearance model vendors describe, the ICE requirement, and what invoicing tools say about it. Independent; published June 2026, updated October 2026.`;

const guideUrl = new URL('/ma/guides/facturation-electronique-maroc/', Astro.site).toString();
const frUrl = new URL('/ma/fr/guides/facturation-electronique-maroc/', Astro.site).toString();
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Morocco', url: '/ma/' },
  { name: 'DGI e-invoicing for contractors', url: '/ma/guides/facturation-electronique-maroc/' },
];

const articleSchema = {
  '@context': 'https://schema.org', '@type': 'Article', headline: pageTitle, description: pageDescription,
  datePublished: '2026-06-20', dateModified: '2026-10-01', inLanguage: 'en',
  author: { '@type': 'Organization', name: 'WrenchStack Research', url: 'https://wrenchstack.com/research/' },
  publisher: { '@type': 'Organization', name: 'WrenchStack', url: 'https://wrenchstack.com' },
  mainEntityOfPage: guideUrl,
};
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs} alternateUrls={[{ hreflang: 'en', href: guideUrl }, { hreflang: 'fr', href: frUrl }, { hreflang: 'x-default', href: guideUrl }]}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <article class="mx-auto max-w-4xl px-4 py-12">
    <header class="mb-8">
      <div class="mb-3 flex items-center justify-between gap-3">
        <p class="text-sm font-semibold uppercase tracking-wider text-orange-600">🇲🇦 Morocco · Compliance guide</p>
        <a href="/ma/fr/guides/facturation-electronique-maroc/" class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">Français</a>
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        DGI E-Invoicing (Facturation Électronique) in Morocco
      </h1>
      <p class="mt-3 text-lg text-slate-600 leading-relaxed">
        What Morocco's planned e-invoicing means for the building trades: who is reported to be affected first, the model vendors describe, and what the tools in our directory say about it. We frame this on what has been reported, not on a deadline or format the DGI hasn't published.
      </p>
      <p class="mt-3 text-sm text-slate-500">By WrenchStack Research · Published June 2026 · Timeline and tool details updated 1 October 2026 · Not tax advice: confirm your situation with the DGI (tax.gov.ma) or your fiduciaire/comptable.</p>
    </header>

    <section class="mb-8 rounded-lg border-2 border-orange-300 bg-orange-50 p-6">
      <h2 class="mb-2 text-lg font-bold text-slate-900">⏰ The short version</h2>
      <p class="text-slate-800 leading-relaxed">
        Morocco is preparing <strong>mandatory e-invoicing</strong>. Hespress reported in August 2026 that it will start <strong>in phases from the end of 2026, with large companies and suppliers to the public sector first</strong>; Le360, citing Challenge, reported SMEs following in 2027-2028 and small firms after 2028. Vendors such as Hisab describe a <strong>clearance model</strong>, in which each invoice is validated by a DGI platform <em>before</em> it reaches the client, but the DGI had not published the technical rules as of August 2026. <strong>Treat any specific go-live day or format as unconfirmed</strong> until the DGI publishes them.
      </p>
    </section>

    <section class="mb-10 grid gap-3 sm:grid-cols-3">
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">Late 2026</div>
        <div class="mt-1 text-xs text-slate-600">phased start reported, large companies and public-sector suppliers first</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">Clearance</div>
        <div class="mt-1 text-xs text-slate-600">model described by vendors: DGI validation before sending; rules not yet published</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">ICE</div>
        <div class="mt-1 text-xs text-slate-600">required on invoices; mandatory on official documents since July 2016</div>
      </div>
    </section>

    <section class="mb-10 prose prose-slate max-w-none">
      <h2>What has been reported, and what isn't published</h2>
      <p><strong>Reported:</strong></p>
      <ul>
        <li>Hespress reported in August 2026 that e-invoicing will be deployed <strong>in phases from the end of 2026</strong>, beginning with <strong>large companies and suppliers to the public sector</strong>.</li>
        <li>Le360, citing Challenge (June 2026), reported a first wave of about 1,655 companies with turnover above 200 million dirhams, then <strong>SMEs in 2027-2028</strong> and <strong>small firms after 2028</strong>.</li>
        <li>Hisab’s mandate guide (updated June 2026) says a pilot phase started in October 2025.</li>
      </ul>
      <p><strong>Not yet published by the DGI (do not treat as fact):</strong></p>
      <ul>
        <li><strong>A firm go-live date.</strong> The dates above are press reports; the DGI had not published the technical rules as of August 2026.</li>
        <li>The first-wave <strong>threshold</strong>: confirm the reported 1,655 companies and 200 million dirham turnover when the implementing text is published.</li>
        <li>The <strong>model and format</strong>. Hisab’s guide describes clearance with UBL 2.1 or CII invoices, but the DGI had not published the technical rules as of August 2026.</li>
      </ul>

      <h2>The reported phases</h2>
      <ul>
        <li><strong>From the end of 2026: large companies and suppliers to the public sector</strong> (Hespress, August 2026); Le360, citing Challenge, counts about 1,655 companies with turnover above 200 million dirhams in this wave.</li>
        <li><strong>2027-2028: SMEs</strong> (Le360, citing Challenge, June 2026).</li>
        <li><strong>After 2028: small firms (TPE).</strong> On these reports a small contractor is not in the first wave unless it supplies the public sector, in which case it should check whether the first phase applies to it.</li>
      </ul>

      <h2>Why this matters for contractors</h2>
      <p>
        Two points are specific to the building trades. First, <strong>check what your quoting tool covers</strong>: EBP Bâtiment and Sage Batigest Connect handle quotes and invoicing, with accounting sold as a separate product, and neither of our entries describes a DGI e-invoicing connection, so the platform path matters as much as the quoting features. Second, your <strong>ICE</strong> (Identifiant Commun de l'Entreprise) has been mandatory on official documents since July 2016, and Hespress reported in July 2025 that the tax administration accepts only invoices that carry it; get it right now.
      </p>

      <h2>The wider Moroccan tax context</h2>
      <ul>
        <li><strong>TVA:</strong> 20% standard; Aube, for example, applies TVA at 20, 14, 10, 7 or 0% line by line. Your software must apply the right rate per line.</li>
        <li><strong>IS and IR:</strong> rules change with Finance Laws; our DGI entry notes that IR changed in 2026.</li>
        <li><strong>SIMPL</strong> is the DGI's online service for TVA, IS and IR declarations (SIMPL-TVA, SIMPL-IS, SIMPL-IR); the DGI had not published how e-invoices will be transmitted as of August 2026.</li>
      </ul>

      <h2>What the tools in our directory say</h2>
      <p>
        From the software in our <a href="/ma/">Morocco directory</a>, here is what each tool says about the mandate, or what our entry could not confirm. <strong>None of the invoicing apps (Hisab, Fawatir AI, Aube) claims DGI accreditation</strong>, and the DGI had not published the technical rules as of August 2026. Treat "ready for 2026" as a vendor claim, and ask vendors the concrete question below.
      </p>
    </section>

    <section class="mb-10 overflow-x-auto">
      <table class="w-full text-sm border border-slate-200 rounded-lg overflow-hidden">
        <thead class="bg-slate-50 text-left text-slate-700">
          <tr>
            <th class="p-3 font-semibold">Tool</th>
            <th class="p-3 font-semibold">E-invoicing position</th>
            <th class="p-3 font-semibold">Scope</th>
            <th class="p-3 font-semibold">Pricing</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 bg-white">
          {tools.map((t) => (
            <tr>
              <td class="p-3 font-semibold text-slate-900"><a href={t.href} class="hover:text-orange-600">{t.name}</a></td>
              <td class="p-3 text-slate-700">{t.status}</td>
              <td class="p-3 text-slate-600">{t.fit}</td>
              <td class="p-3 text-slate-600">{t.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="mt-3 text-xs text-slate-500">The e-invoicing column reports what each vendor says, or what our entry could not confirm, as checked on 30 September 2026. None of it is a DGI accreditation. Confirm directly with each vendor.</p>
    </section>

    <section class="mb-10 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-2 text-lg font-bold text-slate-900">The one question to ask any vendor</h2>
      <p class="text-sm text-slate-700 leading-relaxed">
        Don't assume a quoting tool covers the mandate. Ask: <strong>"Which mandatory mentions (ICE, IF, TVA) do your invoices carry, and how will you connect to the DGI e-invoicing platform once the DGI publishes the technical rules?"</strong> If the answer is vague, that's your signal. And confirm your <a href="/ma/ice-identifiant-commun-entreprise/" class="font-medium text-orange-700 hover:underline">ICE</a> is correct on every document today.
      </p>
    </section>

    <section class="mb-10">
      <h2 class="mb-5 text-2xl font-bold text-slate-900">Frequently asked questions</h2>
      <div class="space-y-3">
        {faqs.map((f) => (
          <details class="rounded-lg border border-slate-200 bg-white p-4">
            <summary class="cursor-pointer font-semibold text-slate-900">{f.q}</summary>
            <p class="mt-3 text-slate-700 leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mb-10 rounded-lg bg-slate-50 p-5 text-xs text-slate-500 leading-relaxed">
      <strong class="text-slate-700">Sources &amp; verification:</strong> Timeline from our re-verified directory entries (30 September 2026): Hespress (August 2026) and Le360 citing Challenge (June 2026). Model, format, legal article and pilot as described in Hisab's mandate guide (updated 5 June 2026, read on 1 October 2026); invoice mentions from Aube; each tool's position from its own statements. Not published by the DGI as of August 2026, and NOT stated as fact here: the technical rules, the invoice format, the exact go-live date and the first-wave threshold. General information, not tax advice. Spotted an error? <a href="/contact/" class="underline">Tell us</a>.
    </section>

    <section class="rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">Compare Moroccan trades software & services</h2>
      <p class="mt-2 text-slate-300 leading-relaxed">Independent reviews of Moroccan BTP software, tender intelligence, CNSS payroll and TRC and décennale construction insurance, with no pay-to-play.</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/ma/" class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600">🇲🇦 Morocco directory →</a>
        <a href="/ma/compare/" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">Compare vendors</a>
        <a href="/for-vendors/" class="rounded-md border border-white/30 bg-white/10 px-5 py-3 text-sm font-semibold text-white hover:bg-white/20">Are you a vendor? Work with us</a>
      </div>
    </section>
  </article>
</Layout>
