---
import Layout from '../../../layouts/Layout.astro';
import featuresData from '../../../data/features.json';
import fs from 'node:fs';
import path from 'node:path';
import { asSentence,
  tools,
  toolsForVertical,
  formatPrice,
  verticalToUrl,
  verticals,
  wrenchStackScore,
  wrenchStackScoreBreakdown,
  readingTimeMinutes,
  linkifyTools,
  smartAlternatives,
  toolType,
  priceTier,
  priceScaling,
  perUserEquivalentUsd,
  REFERENCE_TEAM_SIZE,
  hasFreeTier,
  quoteOnlyCount,
  isQuoteOnly as isQuoteOnlyTool,
  type Tool,
} from '../../../lib/data';

// Set of feature slugs that have dedicated landing pages
const featurePageSlugs = new Set(Object.keys((featuresData as { features: Record<string, unknown> }).features));
function featureToUrl(slug: string): string {
  return slug.replace(/_/g, '-');
}
import Byline from '../../../components/Byline.astro';
import WrenchScore from '../../../components/WrenchScore.astro';
import ToolLogo from '../../../components/ToolLogo.astro';
import FreshnessBadge from '../../../components/FreshnessBadge.astro';
import AwardBadge from '../../../components/AwardBadge.astro';
import UserReviews from '../../../components/UserReviews.astro';
import ReviewSubmissionForm from '../../../components/ReviewSubmissionForm.astro';
import AffiliateDisclosure from '../../../components/AffiliateDisclosure.astro';
import { awardsForTool, awards, userRatingForTool, reviewsForTool } from '../../../lib/data';
import MissingFromList from '../../../components/MissingFromList.astro';
import SourceReviews from '../../../components/SourceReviews.astro';

export async function getStaticPaths() {
  return tools.map((t) => ({
    params: { slug: t.slug },
    props: { tool: t },
  }));
}

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const toolScore = wrenchStackScore(tool);
const scoreBreakdown = wrenchStackScoreBreakdown(tool);
// Self-hosted homepage screenshot (generated via _gen_screenshots.mjs). Build-
// time existence check so tools without a screenshot fall back gracefully.
const hasScreenshot = fs.existsSync(path.join(process.cwd(), 'public', 'screenshots', `${tool.slug}.webp`));
const vendorHost = (() => { try { return new URL(tool.vendor_url).hostname.replace(/^www\./, ''); } catch { return tool.vendor_url; } })();
const toolAwards = awardsForTool(tool.slug);
const wins = toolAwards.filter((a) => a.kind === 'winner');
const honorableMentions = toolAwards.filter((a) => a.kind === 'honorable_mention');
const userRating = userRatingForTool(tool.slug);
const userReviews = reviewsForTool(tool.slug);
const startingPrice = tool.pricing.starting_at_usd;
const hasPublicPricing = startingPrice !== null;
const isFree = startingPrice === 0;
// Split 2026-09-01. These were one flag and they are not one thing: an unpublished price
// is not evidence of an expensive one. Conflating them made this page assert an enterprise
// rollout and $1M+ revenue requirements for products that may cost $40/month.
const isQuoteOnly = isQuoteOnlyTool(tool);
// Published prices that are not a monthly plan (one-time license, per project): not quote-only.
const nonMonthlyPricing = !hasPublicPricing && !isQuoteOnly;
// Tiers come from priceTier, which compares cost per user: until 2026-09-27 this page
// used the starting price alone, so a $297/mo flat company plan was called
// "enterprise" next to per-user plans a 5-person team pays more for.
const tier = priceTier(tool);
const isMidTier = tier === 'mid';
const isEntryTier = tier === 'entry';
const scaling = priceScaling(tool);
const perUserEq = perUserEquivalentUsd(tool);
// "$297/mo for the company", "$29/mo base, plus seats" or "$47/user/mo", for prose that
// quotes the entry price. A base-plus-seat plan was "for the company" until 2026-10-01,
// which hid the per-seat charge on top.
// FastEST is recorded as per_user in tools.json, but its pricing note prices each
// application installed on one PC or tablet ("$250/user/mo" and a per-tech widget
// estimate were false). Worded from the note until the data's pricing_model is
// corrected (2026-10-01); the scaling guard turns this off once it is.
const PER_INSTALL_SLUGS = new Set(['fastest']);
const perInstall = scaling === 'per_user' && PER_INSTALL_SLUGS.has(tool.slug);
const priceText = startingPrice === null
  ? ''
  : perInstall
  ? `$${startingPrice}/mo per application install`
  : scaling === 'flat'
  ? `$${startingPrice}/mo for the company`
  : scaling === 'base_plus_seat'
  ? `$${startingPrice}/mo base, plus seats`
  : scaling === 'per_user'
  ? `$${startingPrice}/user/mo`
  : `$${startingPrice}/mo`;
// Tier prices as the vendor lists them: per user a year for annual_per_user (Bluebeam
// Revu), per user a month for per_user, a month otherwise (see the schema note in
// pages/data/trades-software-pricing-2026.json.ts). Until 2026-10-01 the pricing table
// printed every tier as "$X/mo", so Bluebeam's $260 a year read as $260 a month.
const tierUnit = tool.pricing.pricing_model === 'annual_per_user'
  ? '/user/yr'
  : tool.pricing.pricing_model === 'per_user'
  ? '/user/mo'
  : '/mo';
const tierPrices: (number | null)[] = tool.pricing.tiers.map((_, i) => tool.pricing.tier_prices_usd?.[i] ?? null);
const paidTierPrices = tierPrices.filter((p): p is number => typeof p === 'number' && p > 0);
const lowTierPrice = paidTierPrices.length > 0 ? Math.min(...paidTierPrices) : null;
const highTierPrice = paidTierPrices.length > 0 ? Math.max(...paidTierPrices) : null;
const unpricedTierCount = tierPrices.filter((p) => p === null).length;
// A tier with no recorded price is a custom quote only for a quote-only tool. For the
// others it can be a quote, a project package or a band shown in a price selector
// (Workyard, Fastest, Bodhi, Encircle), so the table points to the pricing note; until
// 2026-10-01 it printed "Custom quote" for all of them.
const tierPriceCell = (price: number | null): string =>
  price === null ? (isQuoteOnly ? 'Custom quote' : 'See pricing note') : price === 0 ? 'Free' : `$${price}${tierUnit}`;
// Notes column: the lowest and highest tier prices in the table. It said "Entry tier" for
// the first row and "Top tier" for the last, and the last is not always the dearest; then
// "Lowest/Highest published tier price" until 2026-10-01, but some pricing notes publish
// higher prices than the table holds (Jobber $529, Housecall Pro $329 monthly).
const tierPriceNote = (price: number | null): string =>
  price === null || price === 0 || lowTierPrice === highTierPrice
    ? ''
    : price === lowTierPrice
    ? 'Lowest price in this table'
    : price === highTierPrice
    ? 'Highest price in this table'
    : '';
// A clause naming a setup, onboarding or implementation fee, unless it says "no" fee:
// the old single regex also matched "no setup fees" (8 of the 17 notes it hit).
const hasSetupFee = (tool.pricing.pricing_note ?? '')
  .split(/[.;]/)
  .some((c) => /(setup|set-up|onboarding|implementation)[^.;]*fee/i.test(c) && !/\bno\b/i.test(c));
const hasFreeTrial = (tool.pricing.free_trial_days ?? 0) > 0;
const hasQuickBooks = tool.integrations.some((i) => i.includes('quickbooks'));
const hasStripe = tool.integrations.some((i) => i.includes('stripe'));
const hasZapier = tool.integrations.some((i) => i.includes('zapier'));
// QuickBooks editions named in the integrations data, so copy can say which one a
// tool connects to instead of asserting what the sync covers (2026-10-01).
const qbEditions = [
  tool.integrations.includes('quickbooks_online') ? 'Online' : null,
  tool.integrations.includes('quickbooks_desktop') ? 'Desktop' : null,
  tool.integrations.includes('quickbooks_enterprise') ? 'Enterprise' : null,
].filter((e): e is string => !!e);
const qbText = qbEditions.length > 0
  ? `QuickBooks ${qbEditions.length > 1 ? `${qbEditions.slice(0, -1).join(', ')} and ${qbEditions[qbEditions.length - 1]}` : qbEditions[0]}`
  : 'QuickBooks';
// "No credit card" only where the pricing note records it. Until 2026-10-01 the
// closing call to action said it for every tool with a trial or a free tier.
const noCardNoted = /no credit card/i.test(tool.pricing.pricing_note ?? '');
const freeTierCount = tools.filter(hasFreeTier).length;
const currentYear = new Date().getFullYear();

// Top verticals where this tool fits best (≥8/10)
const strongVerticals = Object.entries(tool.vertical_fit ?? {})
  .filter(([_, score]) => score >= 8)
  .sort(([, a], [, b]) => (b as number) - (a as number))
  .map(([slug]) => verticals.find((v) => v.slug === slug)?.name)
  .filter((n): n is string => !!n);

// Smart alternatives: type-compatible + vertical-fit + price-tier matched.
// Replaces the previous rating-only sort that surfaced CMMS tools as
// alternatives to FSM platforms on every page.
const smartAlts = smartAlternatives(tool, 6);
const topCompetitor: Tool | undefined = smartAlts[0]?.tool;
// What the matcher compares on (smartAlternatives in lib/data.ts: a tool-type check,
// then trade overlap, price tier and team size). Tools with no trades (the CMMS tools)
// are matched with each other by tool type, so "shared trades" would be false for them.
const matchBasis = tool.verticals.length > 0
  ? 'tool type, shared trades, price tier and team size'
  : 'tool type, price tier and team size';

// "Also worth comparing": the matcher's top alternative, chosen without regard to
// whether we earn on it. Until 2026-09-27 this picked the best match that had an
// affiliate link, which contradicted the methodology's promise.
const comparePick = smartAlts[0] ?? null;

const verticalsForThisTool = tool.verticals
  .map((v) => verticals.find((x) => x.slug === v))
  .filter((v): v is NonNullable<typeof v> => v !== undefined);

// --- PRICING ANALYSIS NARRATIVE ---
// Rewritten 2026-10-01: the free-tier text claimed free tiers were "uncommon" and that
// buyers should "upgrade once you cross 2-3 users", the band text said what tools at
// each price "usually" include, and tools without a recorded trial were told there was
// "no public free trial" (several pricing notes say there is one). None of it came
// from the data; counts are now computed and the rest removed.
function pricingAnalysis(): string {
  const tierCount = tool.pricing.tiers.length;
  const trialNote = hasFreeTrial ? ` ${tool.pricing.free_trial_days}-day free trial.` : '';

  if (nonMonthlyPricing) {
    return `${tool.name} publishes its prices, but not as a monthly plan: see the pricing note for its one-time or per-project prices, and compare the total over the period you expect to use it.`;
  }
  if (!hasPublicPricing) {
    return `${tool.name} does not publish a price, so you need a quote before you can compare it (${quoteOnlyCount()} of the ${tools.length} tools we list are quote-only). A missing price is not evidence of a high one. Get the quote in writing and confirm what it includes (number of users, integrations, onboarding, support) before you sign.`;
  }

  if (isFree) {
    return `${tool.name} has a free tier (${freeTierCount} of the ${tools.length} tools we list have one). The pricing note above lists what the free plan includes and its limits; check them against your team size and job volume before you plan around it.${trialNote}`;
  }

  const band = isEntryTier
    ? 'entry price band (under $100 per user per month)'
    : isMidTier
    ? 'mid price band ($100-$249 per user per month)'
    : 'top price band ($250 or more per user per month)';
  const perUserNote = perUserEq === null
    ? ''
    : perInstall
    ? `That is a price for one application installed on one PC or tablet; see the pricing note for additional applications, purchase prices and network licensing. `
    : scaling === 'flat'
    ? `That is a price for the company, not per user: spread across a ${REFERENCE_TEAM_SIZE}-person team it works out to about $${Math.round(perUserEq)} per user. `
    : scaling === 'base_plus_seat'
    ? `That is a base price for the account, with seats added on top (see the pricing note): spread across a ${REFERENCE_TEAM_SIZE}-person team the base alone works out to about $${Math.round(perUserEq)} per user. `
    : scaling === 'per_user'
    ? `That is a per-seat price, so the bill grows as you add seats; check the pricing note for what counts as a seat, seat minimums and plan limits. `
    : `We have not confirmed how that price scales with team size, so check before you compare it. `;

  // Until 2026-10-01 this said "starts at $X/mo on the <first tier> tier and scales to
  // $Y/mo on <last tier>". The first listed tier is not always the starting price
  // (MeasureSquare's $45 is its $540 annual price divided by 12; Bluebeam lists yearly
  // prices), and the last listed tier is not always the dearest (MeasureSquare, The
  // Customer Factor). The tier is now named only when its price is the starting price,
  // and the range runs from the lowest to the highest tier price in the table. It said
  // "Its published tier prices run from", but several pricing notes publish higher prices
  // (Jobber: $529, and $499 month to month, against $399 in the table).
  // Prices are compared to within 50 cents, not by rounding the tier price: rounding
  // made QuoteIQ's $29.99 start "below" its $29.99 Essentials tier (also MrTask, DRS).
  const firstTierPrice = tierPrices[0];
  const firstTierIsStart = typeof firstTierPrice === 'number'
    && tool.pricing.pricing_model !== 'annual_per_user'
    && startingPrice !== null
    && Math.abs(firstTierPrice - startingPrice) < 0.5;
  const range = lowTierPrice !== null && highTierPrice !== null && lowTierPrice !== highTierPrice
    ? ` The tier prices in the table above run from $${lowTierPrice} to $${highTierPrice}${tierUnit}; the pricing note gives the billing terms and any other published prices.`
    : '';
  // MeasureSquare's starting price is an annual price divided by 12, below every
  // month-to-month tier price in its table.
  const belowTiers = lowTierPrice !== null && tierUnit !== '/user/yr' && startingPrice !== null && startingPrice < lowTierPrice - 0.5
    ? ' The starting price is below the tier prices in the table; see the pricing note for how each is billed.'
    : '';
  const unpriced = tierCount > 1 && unpricedTierCount === tierCount
    ? ` None of its ${tierCount} tiers has a price in our table; see the pricing note.`
    : tierCount > 1 && unpricedTierCount > 0
    ? ` ${unpricedTierCount} of its ${tierCount} tiers ${unpricedTierCount === 1 ? 'has' : 'have'} no price in our table; see the pricing note.`
    : '';

  // "Check which features X keeps for its higher tiers" was removed 2026-10-01: it
  // printed for every multi-tier tool, including CorkCRM, Pool Founder and Estimate
  // Rocket, whose notes say every plan has the same features.
  // The band counts FastEST's per-install price as per user (priceTier), so it says so.
  const bandSentence = perInstall
    ? `We place it in our ${band} by counting one install as one user.`
    : `Its starting price places it in our ${band}.`;
  return `${tool.name} starts at ${priceText}${firstTierIsStart ? ` (${tool.pricing.tiers[0]} tier)` : ''}. ${perUserNote}${bandSentence}${range}${belowTiers}${unpriced}${trialNote}`;
}

// --- PROS, CONS AND FAQS: FALLBACKS ---
// Used only for a tool with no pros_detail / cons_detail / tool_faqs in tools.json
// (all 126 had them on 2026-10-01). Rewritten that day to state only what the data
// holds: the old text invented sync depth, "5,000+ apps", bankruptcy risk by founding
// year, "no credit card", "purpose-built" and named replacement tools.
function getPros(): string[] {
  const pros: string[] = [];

  // Trade fit
  if (strongVerticals.length > 0) {
    pros.push(
      `**Trade fit of 8/10 or higher for ${strongVerticals.slice(0, 3).join(', ')}${
        strongVerticals.length > 3 ? ` and ${strongVerticals.length - 3} more` : ''
      }**: see those trade pages to compare it with the other tools there.`,
    );
  }

  // Pricing transparency
  // "Every tier price is published" only when it is: until 2026-09-27 this claimed it for
  // any tool with a starting price, including ones whose top tier is quote-only.
  const allTiersPriced = tierPrices.length > 0 && tierPrices.every((p) => typeof p === 'number');
  if (hasPublicPricing) {
    pros.push(
      allTiersPriced
        ? `**Transparent public pricing**: every tier price is published, so you can budget without a sales call.`
        : `**Published starting price**: the entry price is public, so you can budget the first tier without a sales call.`,
    );
  }

  // QuickBooks integration
  if (hasQuickBooks) {
    pros.push(
      `**${qbText} integration**: listed in its integrations. Check what it syncs (customers, invoices, payments) before you rely on it.`,
    );
  }

  // Stripe
  if (hasStripe) {
    pros.push(`**Stripe integration**: listed in its integrations.`);
  }

  // Free trial
  if (hasFreeTrial) {
    pros.push(`**${tool.pricing.free_trial_days}-day free trial**: run real jobs through it before you pay.`);
  } else if (isFree) {
    pros.push(`**Free tier**: try the core workflow before you pay; the pricing note lists its limits.`);
  }

  // Zapier
  if (hasZapier) {
    pros.push(`**Zapier integration**: connect ${tool.name} to other apps through Zapier without custom development.`);
  }

  return pros.slice(0, 7);
}

// --- CONS (DETAILED) ---
function getCons(): string[] {
  const cons: string[] = [];

  // Parse existing weaknesses string into bullets: split on ';' or on a full stop that
  // ends a sentence. Splitting on every '.' cut "$149.99" and "U.S." in two (2026-10-01).
  if (tool.weaknesses) {
    const parsed = tool.weaknesses
      .split(/;\s*|\.\s+(?=[A-Z])/)
      .map((s) => s.trim().replace(/\.$/, ''))
      .filter((s) => s.length > 5);
    parsed.forEach((w) => {
      // Capitalize first letter
      cons.push(w.charAt(0).toUpperCase() + w.slice(1));
    });
  }

  // No published price
  if (isQuoteOnly) {
    cons.push(`**No published price**: you need a quote before you can compare its cost.`);
  }

  // No free trial: only when the data records zero days (a missing value is unknown,
  // and several pricing notes describe a trial with no stated length).
  if (tool.pricing.free_trial_days === 0 && !isFree) {
    cons.push(`**No free trial listed**: see the pricing note for how to evaluate it.`);
  }

  // Missing QuickBooks
  if (!hasQuickBooks) {
    cons.push(
      `**No QuickBooks integration listed**: ask ${tool.name} how invoices and payments reach your accounting software before you buy.`,
    );
  }

  // Lower trade fit
  const weakVerticals = Object.entries(tool.vertical_fit ?? {})
    .filter(([_, score]) => score < 7 && score > 0)
    .map(([slug]) => verticals.find((v) => v.slug === slug)?.name)
    .filter((n): n is string => !!n);
  if (weakVerticals.length > 0) {
    cons.push(
      `**Trade fit under 7/10 for ${weakVerticals.slice(0, 3).join(', ')}**: compare it with the other tools on those trade pages.`,
    );
  }

  return cons.slice(0, 7);
}

// --- IMPLEMENTATION: FALLBACK ---
// Used only when the tool has no implementation_notes. Until 2026-10-01 this function
// also set the section headline on every tool page from the price band alone ("1-3
// weeks for a small team", "4-8 weeks is typical", "3-6 months is typical"), with
// invented week-by-week plans. Those durations were never measured; removed.
function implementationFallback(): string {
  return `We have not recorded an implementation plan for ${tool.name}. Ask for the onboarding steps and a go-live date in writing before you sign, and ${
    hasSetupFee ? 'ask what the setup or onboarding fee in the pricing note covers' : 'ask whether onboarding costs extra'
  }.`;
}

// --- FAQs (TEMPLATED PER TOOL) ---
function getFaqs(): { q: string; a: string }[] {
  const faqs: { q: string; a: string }[] = [];

  // 1. Worth the money
  faqs.push({
    q: `Is ${tool.name} worth the money?`,
    a: `That depends on whether you fit its target profile: ${asSentence(tool.best_for)} ${
      isQuoteOnly
        ? `${tool.name} does not publish a price, so get a written quote for your seat count before you compare it with anything here.`
        : nonMonthlyPricing
        ? `${tool.name} publishes one-time or per-project prices rather than a monthly plan (see the pricing note), so compare its total cost over the period you expect to use it.`
        : isFree
        ? `The free tier lets you try it with real jobs before you pay; check which features the paid tiers add.`
        : `At ${priceText}, weigh the price against the admin time it saves you, and run real jobs through it in a trial or demo before you commit.`
    } The alternatives below are matched on ${matchBasis}.`,
  });

  // 2. QuickBooks integration
  faqs.push({
    q: `Does ${tool.name} integrate with QuickBooks?`,
    a: hasQuickBooks
      ? `Yes: our data lists a ${qbText} integration for ${tool.name}. Confirm which QuickBooks edition you use and what syncs before you sign.`
      : `Our data lists no QuickBooks integration for ${tool.name}. Ask ${tool.name} how invoices and payments reach your accounting software before you buy.`,
  });

  // 3. Free trial
  faqs.push({
    q: `Does ${tool.name} offer a free trial?`,
    a: hasFreeTrial
      ? `Yes, a ${tool.pricing.free_trial_days}-day free trial${noCardNoted ? ' (the pricing note records that no credit card is needed)' : ''}. Use it to run a few real jobs from scheduling to payment.`
      : isFree
      ? `${tool.name} has a free tier; the pricing note above lists its limits.`
      : `We have not recorded a free trial for ${tool.name}. See the pricing note, or ask ${tool.name} for a demo with your own data.`,
  });

  // 4. Implementation
  faqs.push({
    q: `What does implementing ${tool.name} involve?`,
    a: implementationFallback(),
  });

  // 5. Alternative
  if (topCompetitor) {
    faqs.push({
      q: `What is the closest alternative to ${tool.name}?`,
      a: `Our matcher's closest alternative is ${topCompetitor.name} (${formatPrice(topCompetitor)}), matched on ${matchBasis}. ${asSentence(topCompetitor.best_for)} See the ${tool.name} vs ${topCompetitor.name} comparison for a side-by-side view.`,
    });
  }

  return faqs;
}

// Custom content overrides: use Phase-2 deep content when present,
// fall back to generated content otherwise.
const hasCustomPros = (tool.pros_detail?.length ?? 0) > 0;
const hasCustomCons = (tool.cons_detail?.length ?? 0) > 0;
const hasCustomFaqs = (tool.tool_faqs?.length ?? 0) > 0;
const hasCustomImpl = !!tool.implementation_notes;
const hasLongDesc = !!tool.long_description;

const prosList = hasCustomPros ? [] : getPros();
const consList = hasCustomCons ? [] : getCons();
const faqsList = hasCustomFaqs ? tool.tool_faqs! : getFaqs();
const implementationText = hasCustomImpl ? tool.implementation_notes : implementationFallback();

// Reading time from this page's own content (2026-10-01). It was a fixed
// readingTimeMinutes(1600) on every tool page, whatever the page held. The words each
// page draws from the data are counted here. FIXED_WORDS is the fixed text, counted with
// a script on 2026-10-01 (markup and expressions stripped): 115 words in this template
// and 294 in the shared components it renders (SourceReviews 29, AffiliateDisclosure 31,
// UserReviews 5, ReviewSubmissionForm 193, MissingFromList 25, Byline 11). Recount them
// when that text changes.
const FIXED_WORDS = 115 + 294;
const wc = (s?: string | null) => (s ?? '').split(/\s+/).filter(Boolean).length;
const slugWords = (list: string[]) => list.reduce((n, s) => n + s.split('_').filter(Boolean).length, 0);
const pageWords = FIXED_WORDS
  + [tool.tagline, tool.long_description, tool.pricing.pricing_note, pricingAnalysis(), tool.best_for, tool.weaknesses, implementationText]
    .reduce((n, s) => n + wc(s), 0)
  + tool.pricing.tiers.reduce((n, t, i) => n + wc(t) + wc(tierPriceCell(tierPrices[i])) + wc(tierPriceNote(tierPrices[i])), 0)
  + slugWords(tool.key_features) + slugWords(tool.integrations)
  + verticalsForThisTool.reduce((n, v) => n + wc(v.name) + 1, 0)
  + (hasCustomPros ? tool.pros_detail!.reduce((n, p) => n + wc(p.title) + wc(p.explanation), 0) : prosList.reduce((n, p) => n + wc(p), 0))
  + (hasCustomCons ? tool.cons_detail!.reduce((n, c) => n + wc(c.title) + wc(c.explanation), 0) : consList.reduce((n, c) => n + wc(c), 0))
  + faqsList.reduce((n, f) => n + wc(f.q) + wc(f.a), 0)
  + smartAlts.reduce((n, a) => n + wc(a.tool.name) + wc(a.reason) + wc(a.tool.tagline) + wc(formatPrice(a.tool)), 0);

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: tool.name,
  applicationCategory: 'BusinessApplication',
  // operatingSystem ('Web, iOS, Android') removed 2026-10-01: it was asserted for every
  // tool, and the data does not record which platforms each one runs on.
  // Only emit a valid Offer when there's a real public price (incl. $0 free).
  // Custom-quoted tools have no price, so we omit offers rather than ship an
  // empty/invalid Offer (which Google flags as an incomplete Product snippet).
  ...(tool.pricing.starting_at_usd !== null && {
    offers: {
      '@type': 'Offer',
      price: tool.pricing.starting_at_usd,
      priceCurrency: 'USD',
    },
  }),
  // Only emit aggregateRating from REAL first-party reviews. Emitting a
  // fabricated reviewCount (e.g. a baseline of 50 with zero real reviews) is a
  // Google structured-data violation. reviews.json is currently empty, so no
  // aggregateRating is emitted until genuine reviews exist. Third-party review
  // scores are not shown (2026-09-30); the page links to the review sites instead.
  ...(userRating && {
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: userRating.avg.toFixed(1),
      bestRating: '5',
      reviewCount: userRating.count,
    },
  }),
  ...(userReviews.length > 0 && {
    review: userReviews.slice(0, 10).map((r) => ({
      '@type': 'Review',
      reviewRating: {
        '@type': 'Rating',
        ratingValue: r.rating,
        bestRating: 5,
      },
      author: {
        '@type': 'Person',
        name: `${r.reviewer_role.charAt(0).toUpperCase() + r.reviewer_role.slice(1)} (${r.team_size} users, ${r.vertical})`,
      },
      datePublished: r.submitted_date,
      reviewBody: `Pros: ${r.pros} Cons: ${r.cons}`,
    })),
  }),
};

// Only emit the SoftwareApplication schema when it carries at least one of
// offers / aggregateRating / review; otherwise Google flags it as an
// incomplete Product snippet. Custom-quoted tools with no first-party reviews
// have none, so we skip it (the page still ranks; it just isn't eligible for a
// product rich result, which is correct: we have nothing to show in one).
const emitProductSchema =
  tool.pricing.starting_at_usd !== null || !!userRating || userReviews.length > 0;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqsList.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// The year shown is the year the pricing was last verified, not the build year: a
// build-year stamp would call an entry current that nobody has rechecked.
const reviewYear = (tool.pricing.verified_date ?? '').slice(0, 4) || String(currentYear);
const pageTitle = `${tool.name} Review (${reviewYear}): Pricing, Features, Pros & Cons`;
const pageDescription = `${tool.name} review: pricing tiers, key features, pros and cons, integrations and weaknesses. ${asSentence(tool.tagline)} Pricing verified ${tool.pricing.verified_date ?? reviewYear}.`;

// (Removed the standalone Review schema: it recast the third-party G2/Capterra
// aggregate as WrenchStack's own review rating, and its embedded SoftwareApplication
// had no offers/rating, which is what Google flagged as an incomplete Product
// snippet. Honest review-stars should come from real first-party reviews, which the
// productSchema's aggregateRating already emits once reviews.json has entries.)

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Tools', url: '/tools/' },
  { name: tool.name, url: `/tools/${tool.slug}/` },
];
---

<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>
  {emitProductSchema && <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />}
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <article class="mx-auto max-w-4xl px-4 py-12">
    <nav class="mb-6 text-sm text-slate-500">
      <a href="/" class="hover:text-slate-900">Home</a>
      <span class="mx-2">/</span>
      <a href="/tools/" class="hover:text-slate-900">All tools</a>
      <span class="mx-2">/</span>
      <span class="text-slate-900">{tool.name}</span>
    </nav>

    <header class="mb-10">
      <div class="mb-4 flex items-start gap-4">
        <ToolLogo tool={tool} size={64} />
        <div class="min-w-0 flex-1">
          <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">
            {tool.name} Review
          </h1>
          <p class="mt-2 text-base italic text-slate-600 sm:text-lg">{tool.tagline}</p>
        </div>
        <div class="hidden shrink-0 sm:block">
          <WrenchScore score={wrenchStackScore(tool)} size="lg" />
        </div>
      </div>
      <div class="mb-4 block sm:hidden">
        <WrenchScore score={wrenchStackScore(tool)} size="lg" />
      </div>
      <Byline updatedDate={tool.pricing.verified_date} readingMinutes={readingTimeMinutes(pageWords)} />

      <div class="mt-4 flex flex-wrap items-center gap-2">
        <FreshnessBadge tool={tool} variant="full" showDate={true} />
        {wins.map((a) => (
          <AwardBadge category={a.category} kind="winner" variant="pill" hideYear={false} />
        ))}
        {honorableMentions.length > 0 && wins.length === 0 && (
          // If no wins, surface the top honorable mention in the hero
          <AwardBadge category={honorableMentions[0].category} kind="honorable_mention" variant="pill" hideYear={false} />
        )}
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-slate-600">
        {tool.founded &&<span>Founded {tool.founded}</span>}
        {tool.headquartered && <span>HQ {tool.headquartered}</span>}
        <span>Best team size: {tool.best_team_size ?? 'n/a'}</span>
      </div>

      <details class="mt-4 rounded-lg border border-slate-200 bg-white text-sm">
        <summary class="cursor-pointer list-none px-4 py-2.5 font-medium text-slate-700 hover:text-orange-600">
          <span class="select-none">▸</span> How we scored {tool.name}: <span class="font-bold text-slate-900">{toolScore.toFixed(1)}/10</span>
        </summary>
        <div class="border-t border-slate-100 px-4 py-3">
          <table class="w-full text-xs">
            <thead>
              <tr class="text-left text-slate-500">
                <th class="pb-1 font-semibold">Factor</th>
                <th class="pb-1 font-semibold">Weight</th>
                <th class="pb-1 font-semibold text-right">Sub-score</th>
              </tr>
            </thead>
            <tbody>
              {scoreBreakdown.map((b) => (
                <tr class="border-t border-slate-50">
                  <td class="py-1 text-slate-700">{b.factor}</td>
                  <td class="py-1 text-slate-500">{Math.round(b.weight * 100)}%</td>
                  <td class="py-1 text-right font-medium text-slate-900">{b.raw.toFixed(1)}/10</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="mt-2 text-xs leading-relaxed text-slate-500">
            Weighted composite, applied identically to every vendor; no vendor pays to change it. <a href="/methodology/" class="underline hover:text-orange-600">Full Fit Score methodology →</a>
          </p>
        </div>
      </details>

      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href={tool.affiliate_url.startsWith('http') ? tool.affiliate_url : tool.vendor_url}
          rel="sponsored nofollow noopener"
          target="_blank"
          class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600"
        >
          Visit {tool.name} →
        </a>
        {hasFreeTrial && (
          <span class="rounded-md border border-slate-300 bg-white px-4 py-3 text-sm font-medium text-slate-700">
            {tool.pricing.free_trial_days}-day free trial
          </span>
        )}
      </div>

      <AffiliateDisclosure />

      {comparePick && (
        <aside class="mt-6 rounded-lg border border-orange-200 bg-orange-50/70 p-4">
          <div class="flex items-start gap-3">
            <div class="hidden shrink-0 sm:block">
              <ToolLogo tool={comparePick.tool} size={40} />
            </div>
            <div class="min-w-0 flex-1">
              <div class="text-xs font-semibold uppercase tracking-wider text-orange-700">Also worth comparing</div>
              <p class="mt-1 text-sm leading-relaxed text-slate-700">
                Considering {tool.name}? <a href={`/tools/${comparePick.tool.slug}/`} class="font-semibold text-slate-900 hover:text-orange-700">{comparePick.tool.name}</a> ({formatPrice(comparePick.tool)}) {tool.verticals.length > 0
                  ? `shares ${comparePick.tool.verticals.filter((v) => tool.verticals.includes(v)).length} of ${tool.name}'s ${tool.verticals.length} ${tool.verticals.length === 1 ? 'trade' : 'trades'}.`
                  : `is another maintenance (CMMS) tool.`}
              </p>
              <p class="mt-1 text-xs italic text-slate-500">{comparePick.tool.tagline}</p>
              <div class="mt-3 flex flex-wrap gap-2">
                <a
                  href={comparePick.tool.affiliate_url.startsWith('http') ? comparePick.tool.affiliate_url : comparePick.tool.vendor_url}
                  rel="sponsored nofollow noopener"
                  target="_blank"
                  class="rounded-md bg-orange-500 px-4 py-2 text-sm font-semibold text-white hover:bg-orange-600"
                >
                  Visit {comparePick.tool.name} →
                </a>
                <a
                  href={`/compare/${[tool.slug, comparePick.tool.slug].sort().join('-vs-')}/`}
                  class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:border-orange-400 hover:bg-orange-50"
                >
                  Compare side-by-side →
                </a>
              </div>
            </div>
          </div>
        </aside>
      )}

      {smartAlts.length > 0 && (
        <div class="mt-6 rounded-lg border border-slate-200 bg-slate-50 px-4 py-3">
          <div class="mb-2 text-xs font-semibold uppercase tracking-wider text-slate-600">
            Compare {tool.name} head-to-head
          </div>
          <div class="flex flex-wrap gap-2">
            {smartAlts.slice(0, 3).map(({ tool: alt }) => {
              const pair = [tool.slug, alt.slug].sort().join('-vs-');
              return (
                <a
                  href={`/compare/${pair}/`}
                  class="inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:border-orange-400 hover:bg-orange-50 hover:text-orange-700"
                >
                  vs {alt.name}
                </a>
              );
            })}
            <a
              href="/compare/"
              class="inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-sm font-medium text-slate-600 hover:text-orange-700"
            >
              All comparisons →
            </a>
          </div>
        </div>
      )}
    </header>

    {hasScreenshot && (
      <figure class="mb-8 overflow-hidden rounded-lg border border-slate-200 bg-white">
        <div class="aspect-[16/10] w-full overflow-hidden bg-slate-50">
          <img
            src={`/screenshots/${tool.slug}.webp`}
            alt={`${tool.name} homepage screenshot`}
            loading="lazy"
            class="h-full w-full object-cover object-top"
          />
        </div>
        <figcaption class="border-t border-slate-100 px-4 py-2 text-xs text-slate-500">
          {tool.name} homepage · <a href={tool.vendor_url} rel="sponsored nofollow noopener" target="_blank" class="hover:text-orange-600">{vendorHost}</a>
        </figcaption>
      </figure>
    )}

    <nav id="jump-to-nav" class="mb-8 rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 md:sticky md:top-2 md:z-30 md:bg-white/95 md:backdrop-blur">
      <div class="text-xs font-semibold uppercase tracking-wider text-slate-700">Jump to</div>
      <div class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-sm">
        <a href="#pricing" data-jump-link="pricing" class="jump-link text-orange-600 hover:underline">Pricing</a>
        <span class="text-slate-300">·</span>
        <a href="#features" data-jump-link="features" class="jump-link text-orange-600 hover:underline">Features</a>
        <span class="text-slate-300">·</span>
        <a href="#pros" data-jump-link="pros" class="jump-link text-orange-600 hover:underline">Pros</a>
        <span class="text-slate-300">·</span>
        <a href="#cons" data-jump-link="cons" class="jump-link text-orange-600 hover:underline">Cons</a>
        <span class="text-slate-300">·</span>
        <a href="#implementation" data-jump-link="implementation" class="jump-link text-orange-600 hover:underline">Implementation</a>
        <span class="text-slate-300">·</span>
        <a href="#alternatives" data-jump-link="alternatives" class="jump-link text-orange-600 hover:underline">Alternatives</a>
        {toolAwards.length > 0 && (
          <>
            <span class="text-slate-300">·</span>
            <a href="#awards" data-jump-link="awards" class="jump-link text-orange-600 hover:underline">Awards</a>
          </>
        )}
        <span class="text-slate-300">·</span>
        <a href="#user-reviews" data-jump-link="user-reviews" class="jump-link text-orange-600 hover:underline">Reviews</a>
        <span class="text-slate-300">·</span>
        <a href="#faqs" data-jump-link="faqs" class="jump-link text-orange-600 hover:underline">FAQs</a>
      </div>
    </nav>

    <section class="mb-10 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-3 text-lg font-bold text-slate-900">Quick verdict</h2>
      <p class="text-slate-700">
        <strong class="text-slate-900">{tool.name}</strong> is best for {asSentence(tool.best_for)}
        Pricing {isFree ? 'starts with a free tier' : hasPublicPricing ? `starts at ${priceText}` : isQuoteOnly ? 'is quote-only (no published price)' : 'is published as one-time or per-project prices (see the pricing note)'}.
        {strongVerticals.length > 0 && ` Trade fit of 8/10 or higher: ${strongVerticals.slice(0, 3).join(', ')}${strongVerticals.length > 3 ? ` and ${strongVerticals.length - 3} more` : ''}.`}
        {hasFreeTrial && ` ${tool.pricing.free_trial_days}-day free trial available.`}
      </p>
    </section>

    <SourceReviews name={tool.name} url={tool.vendor_url} kind="software" />

    {hasLongDesc && (
      <section class="mb-10 prose prose-slate max-w-none">
        <h2>About {tool.name}</h2>
        <div set:html={tool.long_description!.split('\n\n').map(p => `<p>${linkifyTools(p, tool.slug)}</p>`).join('')} />
      </section>
    )}

    <section id="pricing" class="mb-10 scroll-mt-8">
      <h2 class="mb-4 text-2xl font-bold text-slate-900">Pricing</h2>
      <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
        <table class="w-full text-sm">
          <thead class="bg-slate-50 text-left text-slate-700">
            <tr>
              <th class="p-3 font-semibold">Tier</th>
              <th class="p-3 font-semibold">Price</th>
              <th class="p-3 font-semibold">Notes</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {tool.pricing.tiers.map((tier, i) => {
              const price = tierPrices[i];
              return (
                <tr>
                  <td class="p-3 font-semibold text-slate-900">{tier}</td>
                  <td class="p-3 text-slate-700">{tierPriceCell(price)}</td>
                  <td class="p-3 text-slate-500">{tierPriceNote(price)}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      {tool.pricing.pricing_note && (
        <p class="mt-3 text-sm italic text-slate-500">{tool.pricing.pricing_note}</p>
      )}
      <p class="mt-4 text-slate-700 leading-relaxed">
        {pricingAnalysis()}
      </p>
      <p class="mt-2 text-xs text-slate-500">
        Pricing verified {tool.pricing.verified_date}. Prices can change, so confirm them with {tool.name} before purchasing.
      </p>

      <div
        class="mt-6 rounded-lg border border-orange-200 bg-orange-50 p-5"
        data-pricing-widget
        data-starting-price={tool.pricing.starting_at_usd ?? ''}
        data-pricing-note={tool.pricing.pricing_note ?? ''}
        data-pricing-model={perInstall ? 'per_install' : (tool.pricing.pricing_model ?? '')}
        data-tool-name={tool.name}
      >
        <div class="mb-3 text-sm font-semibold uppercase tracking-wider text-orange-700">
          What does {tool.name} cost at your team size?
        </div>
        <div class="flex flex-wrap items-end gap-4">
          <div>
            <label for="pw-techs" class="mb-1 block text-xs font-medium text-slate-700">Number of techs</label>
            <input
              type="number"
              id="pw-techs"
              value="5"
              min="1"
              max="500"
              class="w-28 rounded-md border border-slate-300 px-3 py-1.5 text-sm focus:border-orange-500 focus:outline-none focus:ring-1 focus:ring-orange-500"
            />
          </div>
          <div class="flex-1 min-w-[200px]">
            <div class="text-xs font-medium text-slate-700">Estimated monthly cost</div>
            <div class="mt-1 text-2xl font-bold text-slate-900" id="pw-monthly">-</div>
          </div>
          <div class="flex-1 min-w-[200px]">
            <div class="text-xs font-medium text-slate-700">Annual cost</div>
            <div class="mt-1 text-2xl font-bold text-slate-900" id="pw-annual">-</div>
          </div>
        </div>
        <p class="mt-3 text-xs text-slate-600" id="pw-note">
          {hasPublicPricing
            ? `Estimate uses the published starting tier and whether that price is per user or per company. For an exact price at your team size and feature requirements, ask ${tool.name}.`
            : `${tool.name} has no published monthly price we can model at your team size, so we do not estimate one: any figure here would be a guess. ${isQuoteOnly ? `Ask ${tool.name} for a quote.` : 'See the pricing note for its published prices.'}`}
        </p>
        <div class="mt-3 flex flex-wrap gap-2 text-xs">
          <a
            href={`/cost-of-switch/?to=${tool.slug}`}
            class="font-medium text-orange-700 hover:underline"
          >
            Switching from another tool? Estimate the 12-month cost of switching →
          </a>
        </div>
      </div>
    </section>

    <section id="features" class="mb-10 scroll-mt-8">
      <h2 class="mb-4 text-2xl font-bold text-slate-900">Key features</h2>
      <div class="flex flex-wrap gap-2">
        {tool.key_features.map((f) =>
          featurePageSlugs.has(f) ? (
            <a
              href={`/features/${featureToUrl(f)}/`}
              class="rounded-full border border-slate-200 bg-white px-3 py-1 text-sm text-slate-700 hover:border-orange-500 hover:text-orange-600"
            >
              {f.replace(/_/g, ' ')}
            </a>
          ) : (
            <span class="rounded-full border border-slate-200 bg-white px-3 py-1 text-sm text-slate-700">
              {f.replace(/_/g, ' ')}
            </span>
          )
        )}
      </div>
    </section>

    <section class="mb-10">
      <h2 class="mb-4 text-2xl font-bold text-slate-900">Integrations</h2>
      <div class="flex flex-wrap gap-2">
        {tool.integrations.map((i) => (
          <span class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-sm text-slate-700">
            {i.replace(/_/g, ' ')}
          </span>
        ))}
      </div>
    </section>

    <section id="pros" class="mb-10 scroll-mt-8">
      <h2 class="mb-4 text-2xl font-bold text-slate-900">Pros</h2>
      <ul class="space-y-3">
        {hasCustomPros
          ? tool.pros_detail!.map((p) => (
              <li class="rounded-lg border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-900">
                <div class="mb-1 font-semibold text-emerald-900">+ {p.title}</div>
                <p class="text-emerald-900/90 leading-relaxed" set:html={linkifyTools(p.explanation, tool.slug)} />
              </li>
            ))
          : prosList.map((p) => (
              <li class="flex gap-3 rounded-lg border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-900">
                <span class="font-bold text-emerald-700">+</span>
                <span set:html={linkifyTools(p, tool.slug).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')} />
              </li>
            ))}
      </ul>
    </section>

    <section id="cons" class="mb-10 scroll-mt-8">
      <h2 class="mb-4 text-2xl font-bold text-slate-900">Cons</h2>
      <ul class="space-y-3">
        {hasCustomCons
          ? tool.cons_detail!.map((c) => (
              <li class="rounded-lg border border-orange-200 bg-orange-50 p-4 text-sm text-orange-900">
                <div class="mb-1 font-semibold text-orange-900">− {c.title}</div>
                <p class="text-orange-900/90 leading-relaxed" set:html={linkifyTools(c.explanation, tool.slug)} />
              </li>
            ))
          : consList.map((c) => (
              <li class="flex gap-3 rounded-lg border border-orange-200 bg-orange-50 p-4 text-sm text-orange-900">
                <span class="font-bold text-orange-700">−</span>
                <span set:html={linkifyTools(c, tool.slug).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')} />
              </li>
            ))}
      </ul>
    </section>

    <section id="implementation" class="mb-10 scroll-mt-8">
      <h2 class="mb-4 text-2xl font-bold text-slate-900">Implementation</h2>
      <div class="rounded-lg border border-slate-200 bg-white p-6">
        <p class="text-slate-700 leading-relaxed" set:html={linkifyTools(implementationText, tool.slug)} />
      </div>
    </section>

    <section class="mb-10">
      <h2 class="mb-4 text-2xl font-bold text-slate-900">Best for / Watch out for</h2>
      <div class="grid gap-6 md:grid-cols-2">
        <div class="rounded-lg border border-green-200 bg-green-50 p-5">
          <h3 class="mb-2 font-bold text-green-900">Best for</h3>
          <p class="text-sm text-green-900" set:html={linkifyTools(tool.best_for, tool.slug)} />
        </div>
        <div class="rounded-lg border border-orange-200 bg-orange-50 p-5">
          <h3 class="mb-2 font-bold text-orange-900">Watch out for</h3>
          <p class="text-sm text-orange-900" set:html={linkifyTools(tool.weaknesses, tool.slug)} />
        </div>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="mb-4 text-2xl font-bold text-slate-900">Available for these trades</h2>
      {verticalsForThisTool.length === 0 && (
        <p class="text-sm text-slate-600 leading-relaxed">
          {toolType(tool) === 'cmms'
            ? `${tool.name} is maintenance software (CMMS), and its own site names none of the contractor trades we cover, so it is not ranked on our trade pages. The alternatives below compare it with other CMMS tools.`
            : `${tool.name}'s own site does not name any of the trades we cover, so it is not ranked on our trade pages.`}
        </p>
      )}
      <div class="flex flex-wrap gap-2">
        {verticalsForThisTool.map((v) => (
          <a
            href={`/${verticalToUrl(v.slug)}/`}
            class="rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-900 hover:border-orange-500 hover:text-orange-600"
          >
            {v.name} software →
          </a>
        ))}
      </div>
    </section>

    {toolAwards.length > 0 && (
      <section id="awards" class="mb-10 scroll-mt-8">
        <h2 class="mb-2 text-2xl font-bold text-slate-900">WrenchStack Awards</h2>
        <p class="mb-5 text-sm text-slate-500">
          Editorial recognitions {tool.name} received in our {awards.year} awards. <a href={`/awards/${awards.year}/`} class="underline hover:text-slate-700">See full methodology →</a>
        </p>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {wins.map((a) => (
            <AwardBadge category={a.category} kind="winner" variant="card" />
          ))}
          {honorableMentions.map((a) => (
            <AwardBadge category={a.category} kind="honorable_mention" variant="card" />
          ))}
        </div>
      </section>
    )}

    {smartAlts.length > 0 && (
      <section id="alternatives" class="mb-10 scroll-mt-8">
        <h2 class="mb-2 text-2xl font-bold text-slate-900">Alternatives to {tool.name}</h2>
        <p class="mb-5 text-sm text-slate-500">
          Matched on {matchBasis}.
        </p>
        <div class="grid gap-4 sm:grid-cols-2">
          {smartAlts.map(({ tool: c, reason }) => {
            return (
              <a
                href={`/tools/${c.slug}/`}
                class="group rounded-lg border border-slate-200 bg-white p-4 transition hover:border-orange-300 hover:shadow-sm"
              >
                <div class="flex items-start justify-between gap-3">
                  <div class="font-semibold text-slate-900 group-hover:text-orange-600">{c.name}</div>
                </div>
                <div class="mt-1 flex flex-wrap gap-x-3 gap-y-1 text-xs text-slate-500">
                  <span>{formatPrice(c)}</span>
                  {c.best_team_size && <span>Team {c.best_team_size}</span>}
                </div>
                <p class="mt-2 text-sm text-slate-700 leading-snug">{reason}</p>
                <div class="mt-3 flex items-center justify-between gap-2">
                  <span class="text-xs italic text-slate-500 line-clamp-1">{c.tagline}</span>
                  <FreshnessBadge tool={c} variant="compact" />
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <UserReviews tool={tool} />

    <ReviewSubmissionForm tool={tool} />

    <section id="faqs" class="mb-10 scroll-mt-8">
      <h2 class="mb-6 text-2xl font-bold text-slate-900">Frequently asked questions</h2>
      <div class="space-y-4">
        {faqsList.map((f) => (
          <details class="rounded-lg border border-slate-200 bg-white p-4">
            <summary class="cursor-pointer font-semibold text-slate-900">{f.q}</summary>
            <p class="mt-3 text-slate-700 leading-relaxed" set:html={linkifyTools(f.a, tool.slug)} />
          </details>
        ))}
      </div>
    </section>

    <section class="rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">Ready to try {tool.name}?</h2>
      <p class="mt-2 text-slate-300">
        {[
          isFree
            ? 'Free tier available.'
            : hasPublicPricing
            ? `Pricing starts at ${priceText}.`
            : isQuoteOnly
            ? `No published price: ask ${tool.name} for a quote.`
            : 'Prices are one-time or per project: see the pricing note above.',
          hasFreeTrial ? `${tool.pricing.free_trial_days}-day free trial.` : '',
          (hasFreeTrial || isFree) && noCardNoted ? 'The pricing note records that no credit card is needed.' : '',
        ].filter(Boolean).join(' ')}
      </p>
      <a
        href={tool.affiliate_url.startsWith('http') ? tool.affiliate_url : tool.vendor_url}
        rel="sponsored nofollow noopener"
        target="_blank"
        class="mt-4 inline-block rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600"
      >
        Visit {tool.name} →
      </a>
    </section>
    <MissingFromList competitors={[tool.name]} />
  </article>

  <script>
    // Scroll-spy: highlight the current section's link in the jump-to nav
    // as the user scrolls. Uses IntersectionObserver to detect which
    // section is most in viewport.
    (() => {
      const jumpLinks = document.querySelectorAll<HTMLAnchorElement>('.jump-link');
      if (jumpLinks.length === 0) return;
      const linkBySection = new Map<string, HTMLAnchorElement>();
      const sections: HTMLElement[] = [];
      for (const link of jumpLinks) {
        const sectionId = link.dataset.jumpLink;
        if (!sectionId) continue;
        linkBySection.set(sectionId, link);
        const section = document.getElementById(sectionId);
        if (section) sections.push(section);
      }
      if (sections.length === 0) return;

      const ACTIVE_CLASSES = ['font-bold', 'text-orange-700'];
      const INACTIVE_CLASSES = ['text-orange-600'];

      let currentActive: string | null = null;

      function setActive(sectionId: string | null) {
        if (sectionId === currentActive) return;
        currentActive = sectionId;
        for (const [id, link] of linkBySection.entries()) {
          if (id === sectionId) {
            link.classList.add(...ACTIVE_CLASSES);
            link.classList.remove(...INACTIVE_CLASSES);
          } else {
            link.classList.remove(...ACTIVE_CLASSES);
            link.classList.add(...INACTIVE_CLASSES);
          }
        }
      }

      // Track which sections are currently intersecting; the topmost one wins.
      const intersecting = new Set<string>();

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const id = entry.target.id;
            if (entry.isIntersecting) intersecting.add(id);
            else intersecting.delete(id);
          }
          if (intersecting.size === 0) {
            // No section in viewport: default to nothing or first if scrolled past everything
            return;
          }
          // Pick the topmost intersecting section in source order
          for (const s of sections) {
            if (intersecting.has(s.id)) {
              setActive(s.id);
              return;
            }
          }
        },
        {
          // Trigger when section's top crosses the 20%-from-top line
          rootMargin: '0px 0px -75% 0px',
          threshold: 0,
        },
      );

      for (const s of sections) observer.observe(s);
    })();

    // Per-tool pricing widget: takes team size input, shows live monthly +
    // annual cost. Reads per-user vs flat structure from pricing_model.
    (() => {
      const widget = document.querySelector<HTMLElement>('[data-pricing-widget]');
      if (!widget) return;
      const techsInput = document.getElementById('pw-techs') as HTMLInputElement | null;
      const monthlyEl = document.getElementById('pw-monthly');
      const annualEl = document.getElementById('pw-annual');
      const noteEl = document.getElementById('pw-note');
      if (!techsInput || !monthlyEl || !annualEl || !noteEl) return;

      const startingPriceRaw = widget.dataset.startingPrice;
      const pricingNote = (widget.dataset.pricingNote ?? '').toLowerCase();
      const toolName = widget.dataset.toolName ?? 'this tool';

      // No published price: show that instead of inventing a figure (a per-user
      // fallback was removed 2026-09-27).
      const isCustomQuoted = !startingPriceRaw || startingPriceRaw === '';
      const startingPrice = isCustomQuoted ? 0 : parseFloat(startingPriceRaw);
      const isFree = startingPrice === 0;
      // Structure comes from pricing_model (hand-classified 2026-09-09); the old
      // note-text guess treated any note mentioning "per month" as per-company.
      const pricingModel = widget.dataset.pricingModel ?? '';
      const isPerUser = pricingModel === 'per_user' || pricingModel === 'annual_per_user';
      const isFlat = pricingModel === 'flat';
      const isBasePlusSeat = pricingModel === 'flat_plus_seat';
      // FastEST (see PER_INSTALL_SLUGS): priced per application install, not per tech,
      // so the estimate is not multiplied (it multiplied $250 by the techs until 2026-10-01).
      const isPerInstall = pricingModel === 'per_install';

      function format(n: number): string {
        return '$' + Math.round(n).toLocaleString('en-US');
      }

      function update() {
        const techs = parseInt(techsInput!.value, 10) || 1;
        if (isCustomQuoted) {
          // No monthly price is either quote-only or a one-time / per-project price
          // (Trash Flow, Pylon), which until 2026-10-01 also showed "Quote only".
          const label = pricingModel === 'quote_only' ? 'Quote only' : 'See pricing note';
          techsInput!.disabled = true;
          monthlyEl!.textContent = label;
          annualEl!.textContent = label;
          return;
        }
        if (isFree) {
          monthlyEl!.textContent = 'Free';
          annualEl!.textContent = 'Free';
          // Was "usable indefinitely for solo or 1-2 person operations": invented (free
          // plans here cap seats, jobs, projects or clients differently). 2026-10-01.
          noteEl!.innerHTML = `${toolName} has a free tier. The pricing note above lists what it includes and its limits; paid tiers are priced there too.`;
          return;
        }
        const monthly = isPerUser ? startingPrice * techs : startingPrice;
        const annual = monthly * 12;
        monthlyEl!.textContent = format(monthly);
        annualEl!.textContent = format(annual);
        if (isPerInstall) {
          noteEl!.innerHTML = `${toolName}'s lease price is $${startingPrice}/mo for <strong>one application installed on one PC or tablet</strong>, so this estimate doesn't multiply it by the number of techs. See the pricing note above for additional applications, purchase prices and network licensing.`;
        } else if (isFlat) {
          noteEl!.innerHTML = `${toolName} charges a <strong>flat monthly price per plan</strong>, so this estimate doesn't scale with team size. Plans can cap users or usage, so check which plan fits your team in the pricing note above.`;
        } else if (isBasePlusSeat) {
          noteEl!.innerHTML = `${toolName} charges a <strong>base price that includes some users</strong>, plus a fee for each extra seat. This estimate shows the base price only; see the pricing note above for seat costs.`;
        } else if (isPerUser) {
          noteEl!.innerHTML = `${toolName} uses <strong>per-user</strong> pricing at $${startingPrice}/user/mo on the entry tier, so this estimate multiplies it by the number of techs. See the pricing note above for seat minimums and higher tiers.`;
        } else {
          noteEl!.innerHTML = `${toolName}'s published entry price is $${startingPrice}/mo. How it scales with team size isn't clear from the vendor's page, so this estimate doesn't multiply it; check the pricing note above.`;
        }
      }

      techsInput.addEventListener('input', update);
      update();
    })();
  </script>
</Layout>
