---
import Layout from '../../../layouts/Layout.astro';
import featuresData from '../../../data/features.json';
import fs from 'node:fs';
import path from 'node:path';
import { asSentence,
  tools,
  toolsForVertical,
  formatPrice,
  verticalToUrl,
  verticals,
  wrenchStackScore,
  wrenchStackScoreBreakdown,
  readingTimeMinutes,
  linkifyTools,
  smartAlternatives,
  toolType,
  priceTier,
  priceScaling,
  perUserEquivalentUsd,
  REFERENCE_TEAM_SIZE,
  type Tool,
} from '../../../lib/data';

// Set of feature slugs that have dedicated landing pages
const featurePageSlugs = new Set(Object.keys((featuresData as { features: Record<string, unknown> }).features));
function featureToUrl(slug: string): string {
  return slug.replace(/_/g, '-');
}
import Byline from '../../../components/Byline.astro';
import WrenchScore from '../../../components/WrenchScore.astro';
import ToolLogo from '../../../components/ToolLogo.astro';
import FreshnessBadge from '../../../components/FreshnessBadge.astro';
import AwardBadge from '../../../components/AwardBadge.astro';
import UserReviews from '../../../components/UserReviews.astro';
import ReviewSubmissionForm from '../../../components/ReviewSubmissionForm.astro';
import AffiliateDisclosure from '../../../components/AffiliateDisclosure.astro';
import { awardsForTool, awards, userRatingForTool, reviewsForTool } from '../../../lib/data';
import MissingFromList from '../../../components/MissingFromList.astro';
import SourceReviews from '../../../components/SourceReviews.astro';

export async function getStaticPaths() {
  return tools.map((t) => ({
    params: { slug: t.slug },
    props: { tool: t },
  }));
}

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const toolScore = wrenchStackScore(tool);
const scoreBreakdown = wrenchStackScoreBreakdown(tool);
// Self-hosted homepage screenshot (generated via _gen_screenshots.mjs). Build-
// time existence check so tools without a screenshot fall back gracefully.
const hasScreenshot = fs.existsSync(path.join(process.cwd(), 'public', 'screenshots', `${tool.slug}.webp`));
const vendorHost = (() => { try { return new URL(tool.vendor_url).hostname.replace(/^www\./, ''); } catch { return tool.vendor_url; } })();
const toolAwards = awardsForTool(tool.slug);
const wins = toolAwards.filter((a) => a.kind === 'winner');
const honorableMentions = toolAwards.filter((a) => a.kind === 'honorable_mention');
const userRating = userRatingForTool(tool.slug);
const userReviews = reviewsForTool(tool.slug);
const startingPrice = tool.pricing.starting_at_usd;
const hasPublicPricing = startingPrice !== null;
const isFree = startingPrice === 0;
// Split 2026-09-01. These were one flag and they are not one thing: an unpublished price
// is not evidence of an expensive one. Conflating them made this page assert an enterprise
// rollout and $1M+ revenue requirements for products that may cost $40/month.
const isQuoteOnly = !hasPublicPricing;
// Tiers come from priceTier, which compares cost per user: until 2026-09-27 this page
// used the starting price alone, so a $297/mo flat company plan was called
// "enterprise" next to per-user plans a 5-person team pays more for.
const tier = priceTier(tool);
const isEnterprise = tier === 'enterprise';
const isMidTier = tier === 'mid';
const isEntryTier = tier === 'entry';
const scaling = priceScaling(tool);
const perUserEq = perUserEquivalentUsd(tool);
const isCompanyPlan = scaling === 'flat' || scaling === 'base_plus_seat';
// "$297/mo for the company" vs "$29/user/mo", for prose that quotes the entry price.
const priceText = startingPrice === null
  ? ''
  : isCompanyPlan
  ? `$${startingPrice}/mo for the company`
  : scaling === 'per_user'
  ? `$${startingPrice}/user/mo`
  : `$${startingPrice}/mo`;
const hasSetupFee = /(setup|set-up|onboarding|implementation) fee/i.test(tool.pricing.pricing_note ?? '');
const hasFreeTrial = (tool.pricing.free_trial_days ?? 0) > 0;
const hasQuickBooks = tool.integrations.some((i) => i.includes('quickbooks'));
const hasStripe = tool.integrations.some((i) => i.includes('stripe'));
const hasZapier = tool.integrations.some((i) => i.includes('zapier'));

// Top verticals where this tool fits best (≥8/10)
const strongVerticals = Object.entries(tool.vertical_fit ?? {})
  .filter(([_, score]) => score >= 8)
  .sort(([, a], [, b]) => (b as number) - (a as number))
  .map(([slug]) => verticals.find((v) => v.slug === slug)?.name)
  .filter((n): n is string => !!n);

// Smart alternatives: type-compatible + vertical-fit + price-tier matched.
// Replaces the previous rating-only sort that surfaced CMMS tools as
// alternatives to FSM platforms on every page.
const smartAlts = smartAlternatives(tool, 6);
const topCompetitor: Tool | undefined = smartAlts[0]?.tool;

// "Also worth comparing": the matcher's top alternative, chosen without regard to
// whether we earn on it. Until 2026-09-27 this picked the best match that had an
// affiliate link, which contradicted the methodology's promise.
const comparePick = smartAlts[0] ?? null;

const verticalsForThisTool = tool.verticals
  .map((v) => verticals.find((x) => x.slug === v))
  .filter((v): v is NonNullable<typeof v> => v !== undefined);

// --- PRICING ANALYSIS NARRATIVE ---
function pricingAnalysis(): string {
  const tierCount = tool.pricing.tiers.length;
  const topPrice = tool.pricing.tier_prices_usd?.[tierCount - 1];

  if (!hasPublicPricing) {
    return `${tool.name} does not publish a list price we can compare, so you need a quote first. Quote-only is not the same as expensive or enterprise: vendors quote by team size, customer count, company size or usage. Get the quote in writing and confirm what's included (number of users, integrations, onboarding, support tier) before signing.`;
  }

  if (isFree) {
    return `${tool.name} offers a genuinely free tier, uncommon in this category. The free tier typically covers the basics (quoting, invoicing, sometimes scheduling) but lacks the multi-user team management, automation, and reporting depth that paid tiers add. Use it to evaluate the UX before committing, but plan to upgrade once you cross 2-3 users or need recurring service tracking.`;
  }

  const tierLadder = tool.pricing.tiers.join(' → ');
  const band = isEntryTier
    ? 'entry price band (under $100 per user per month)'
    : isMidTier
    ? 'mid price band ($100-$249 per user per month)'
    : 'top price band ($250 or more per user per month)';
  const perUserNote = perUserEq === null
    ? ''
    : scaling === 'flat'
    ? `That is a price for the company, not per user: spread across a ${REFERENCE_TEAM_SIZE}-person team it works out to about $${Math.round(perUserEq)} per user. `
    : scaling === 'base_plus_seat'
    ? `That is a base price for the account, with seats added on top (see the pricing note): spread across a ${REFERENCE_TEAM_SIZE}-person team the base alone works out to about $${Math.round(perUserEq)} per user. `
    : scaling === 'per_user'
    ? `That is a per-user price, so the bill grows as you add seats; check the pricing note for seat minimums and plan limits. `
    : `We have not confirmed how that price scales with team size, so check before you compare it. `;

  return `${tool.name} starts at $${startingPrice}/mo on the ${tool.pricing.tiers[0]} tier${
    tierCount > 1 && topPrice && typeof topPrice === 'number' && topPrice > 0 && topPrice !== startingPrice
      ? ` and scales to $${topPrice}/mo on ${tool.pricing.tiers[tierCount - 1]}`
      : ''
  }. ${perUserNote}The ${tierLadder} ladder places it in our ${band}. ${
    isEntryTier
      ? `Tools in this band usually cover the core workflow. Check the tier list before you buy: features like dispatch optimization, automated reminders and recurring-service contracts are often kept for higher plans.`
      : isMidTier
      ? `At this price, expect the core workflow plus automation and reporting. Check which features ${tool.name} keeps for its higher tiers.`
      : `At this price you are paying for depth: reporting, custom workflows and integration work. Confirm each one in the demo, since vendors package them differently.`
  }${hasFreeTrial ? ` ${tool.pricing.free_trial_days}-day free trial available.` : ` No public free trial, so plan on a demo to evaluate it.`}`;
}

// --- PROS (DETAILED, TEMPLATED FROM EXISTING DATA) ---
function getPros(): string[] {
  const pros: string[] = [];

  // Vertical fit pros
  if (strongVerticals.length > 0) {
    pros.push(
      `**Strong vertical fit for ${strongVerticals.slice(0, 3).join(', ')}${
        strongVerticals.length > 3 ? ` and ${strongVerticals.length - 3} more` : ''
      }**: ${tool.name} is purpose-built for these trades, not a generic FSM repurposed.`,
    );
  }

  // Pricing transparency
  // "Every tier price is published" only when it is: until 2026-09-27 this claimed it for
  // any tool with a starting price, including ones whose top tier is quote-only.
  const tierPrices = tool.pricing.tier_prices_usd ?? [];
  const allTiersPriced = tierPrices.length === tool.pricing.tiers.length && tierPrices.every((p) => typeof p === 'number');
  if (hasPublicPricing) {
    pros.push(
      allTiersPriced
        ? `**Transparent public pricing**: every tier price is published, so you can budget without a sales call.`
        : `**Published starting price**: the entry price is public, so you can budget the first tier without a sales call.`,
    );
  }

  // QuickBooks integration
  if (hasQuickBooks) {
    pros.push(
      `**Native QuickBooks integration**: bidirectional sync for customers, invoices, and payments. Critical for keeping the books reconciled without manual exports.`,
    );
  }

  // Stripe/payments
  if (hasStripe) {
    pros.push(
      `**Built-in payments via Stripe**: collect deposits, invoices, and recurring billing in-app without juggling a separate payment processor.`,
    );
  }

  // Free trial
  if (hasFreeTrial) {
    pros.push(
      `**${tool.pricing.free_trial_days}-day free trial**: long enough to actually run a few jobs through the system before committing.`,
    );
  } else if (isFree) {
    pros.push(`**Free tier available**: you can evaluate the core workflow with zero financial risk.`);
  }

  // Zapier
  if (hasZapier) {
    pros.push(
      `**Zapier integration**: connect ${tool.name} to 5,000+ apps without custom development. Useful for stitching together marketing, accounting, and ops tools you already use.`,
    );
  }

  // Feature breadth
  if (tool.key_features.length >= 7) {
    pros.push(
      `**Broad feature coverage**: ${tool.key_features.length} core capabilities including ${tool.key_features
        .slice(0, 4)
        .map((f) => f.replace(/_/g, ' '))
        .join(', ')}.`,
    );
  }

  // Founded maturity
  if (tool.founded && tool.founded <= 2018) {
    pros.push(
      `**${2026 - tool.founded}-year track record**: dates from ${tool.founded}. Less risk of bankruptcy, missing features, or unstable APIs vs a 2-year-old startup.`,
    );
  }

  return pros.slice(0, 7);
}

// --- CONS (DETAILED) ---
function getCons(): string[] {
  const cons: string[] = [];

  // Parse existing weaknesses string into bullets (split on ';' or '.')
  if (tool.weaknesses) {
    const parsed = tool.weaknesses
      .split(/[;.]\s*/)
      .map((s) => s.trim())
      .filter((s) => s.length > 5);
    parsed.forEach((w) => {
      // Capitalize first letter
      cons.push(w.charAt(0).toUpperCase() + w.slice(1));
    });
  }

  // No public pricing
  if (!hasPublicPricing) {
    cons.push(
      `**No public pricing**: every quote requires a sales call. Hard to comparison-shop without committing time to a demo.`,
    );
  }

  // No free trial
  if (!hasFreeTrial && !isFree) {
    cons.push(`**No free trial**: must commit to a paid plan or schedule a demo to evaluate.`);
  }

  // Missing QuickBooks
  if (!hasQuickBooks) {
    cons.push(
      `**No native QuickBooks integration**: accounting sync requires Zapier or manual exports, which adds friction for QuickBooks-heavy shops.`,
    );
  }

  // Lower vertical fit warning
  const weakVerticals = Object.entries(tool.vertical_fit ?? {})
    .filter(([_, score]) => score < 7 && score > 0)
    .map(([slug]) => verticals.find((v) => v.slug === slug)?.name)
    .filter((n): n is string => !!n);
  if (weakVerticals.length > 0) {
    cons.push(
      `**Weaker fit for ${weakVerticals.slice(0, 3).join(', ')}**: possible but not the strongest option in those verticals. Check vertical-specific alternatives if you're in those trades.`,
    );
  }

  return cons.slice(0, 7);
}

// --- IMPLEMENTATION TIMELINE ---
function implementationTimeline(): { headline: string; detail: string } {
  if (isQuoteOnly) {
    return {
      headline: 'Not published',
      detail: `${tool.name} does not publish a price, and it does not publish an implementation timeline either. That is not the same as being an enterprise rollout: plenty of quote-only products onboard in days. Ask for the onboarding plan and the go-live date in writing during the sales call, and treat any timeline given verbally as an estimate rather than a commitment.`,
    };
  }
  if (isEnterprise) {
    return {
      headline: '3-6 months is typical at this price level',
      detail: `Platforms at this price level usually involve deeper data migration (customer history, recurring service agreements, custom pricebooks), staff training on advanced workflows, and often integration work. ${tool.name} does not publish an implementation timeline, so ask for the onboarding plan and the go-live date in writing, and don't sign a contract that locks you into a go-live date you can't realistically hit.`,
    };
  }
  if (isMidTier) {
    return {
      headline: '4-8 weeks is typical at this price level',
      detail: `Mid-tier platforms typically have a self-serve setup wizard for the basics, and some sell optional paid onboarding, so check ${tool.name}'s price for it before you budget. Plan to spend the first 2 weeks importing customer data and configuring basic workflows, then 2-4 weeks running parallel (old system + new system) before cutting over fully. Field tech training is usually the longest-tail item; budget extra time for adoption resistance.`,
    };
  }
  return {
    headline: '1-3 weeks for a small team',
    detail: hasSetupFee
      ? `${tool.name} charges a one-time setup or onboarding fee (see the pricing note), so ask what it covers and how long it takes before you sign. Most tools in this price band can be running real jobs within a few weeks once customers are imported and services and pricing are configured. The bigger time sink is usually adapting your existing workflow rather than the software setup itself.`
      : `Most tools in this price band are built for self-service setup. You can typically be running real jobs through the system within a week: import customers (or build from scratch), configure your services and pricing, and start scheduling. The bigger time sink is usually adapting your existing workflow rather than the software setup itself.`,
  };
}

// --- FAQs (TEMPLATED PER TOOL) ---
function getFaqs(): { q: string; a: string }[] {
  const faqs: { q: string; a: string }[] = [];

  // 1. Worth the money
  faqs.push({
    q: `Is ${tool.name} worth the money?`,
    a: `${tool.name} is worth it if you fit the target profile: ${asSentence(tool.best_for)} ${
      isQuoteOnly
        ? `${tool.name} does not publish a price, so the ROI maths cannot be done from public information. Get a written quote for your seat count before comparing it against anything here.`
        : isFree
        ? `The free tier lets you test that with real jobs before you pay anything; check which features the paid tiers add before your team grows into them.`
        : isEnterprise
        ? `At ${priceText}, the maths works only for a team large enough to use the depth you are paying for, so price it for your seat count and compare it with the alternatives below.`
        : `At ${priceText}, weigh the price against the admin time it saves on scheduling, invoicing and follow-up, and run a real week of jobs through it in a trial or demo before you commit.`
    } If you're outside the target profile, alternatives below are likely a better fit.`,
  });

  // 2. QuickBooks integration
  faqs.push({
    q: `Does ${tool.name} integrate with QuickBooks?`,
    a: hasQuickBooks
      ? `Yes, ${tool.name} integrates natively with QuickBooks. The sync covers customers, invoices, and payments. Always confirm whether you need QuickBooks Online or Desktop support before signing; they're not interchangeable across all FSM tools.`
      : `No, ${tool.name} does not have a native QuickBooks integration. You can typically bridge via Zapier (manual setup) or export/import CSVs (manual ongoing), but this adds friction for QuickBooks-heavy shops. If deep QuickBooks integration is critical, consider FieldEdge or Knowify instead.`,
  });

  // 3. Free trial
  faqs.push({
    q: `Does ${tool.name} offer a free trial?`,
    a: hasFreeTrial
      ? `Yes, ${tool.name} offers a ${tool.pricing.free_trial_days}-day free trial. No credit card is typically required to start. Use the trial to actually run a few jobs end-to-end (schedule → dispatch → invoice → payment) rather than just clicking around the UI.`
      : isFree
      ? `${tool.name} offers a free tier you can use indefinitely. The free tier covers core workflows but lacks the multi-user team features, automation, and reporting depth that paid tiers add.`
      : `No, ${tool.name} does not offer a free trial. You'll need to schedule a demo with their sales team to evaluate. Ask for a sandbox or guided walkthrough with your real data to get a meaningful sense of fit.`,
  });

  // 4. Implementation time
  const timeline = implementationTimeline();
  faqs.push({
    q: `How long does ${tool.name} implementation take?`,
    a: `${asSentence(timeline.headline)} ${timeline.detail.split('.').slice(0, 2).join('.')}.`,
  });

  // 5. Alternative
  if (topCompetitor) {
    faqs.push({
      q: `What's the best alternative to ${tool.name}?`,
      a: `The closest alternative in the same trades is ${topCompetitor.name} (${formatPrice(topCompetitor)}). ${asSentence(topCompetitor.best_for)} See our full ${tool.name} vs ${topCompetitor.name} comparison for a side-by-side breakdown.`,
    });
  }

  return faqs;
}

// Custom content overrides: use Phase-2 deep content when present,
// fall back to generated content otherwise.
const hasCustomPros = (tool.pros_detail?.length ?? 0) > 0;
const hasCustomCons = (tool.cons_detail?.length ?? 0) > 0;
const hasCustomFaqs = (tool.tool_faqs?.length ?? 0) > 0;
const hasCustomImpl = !!tool.implementation_notes;
const hasLongDesc = !!tool.long_description;

const prosList = hasCustomPros ? [] : getPros();
const consList = hasCustomCons ? [] : getCons();
const faqsList = hasCustomFaqs ? tool.tool_faqs! : getFaqs();
const timeline = implementationTimeline();

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: tool.name,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web, iOS, Android',
  // Only emit a valid Offer when there's a real public price (incl. $0 free).
  // Custom-quoted tools have no price, so we omit offers rather than ship an
  // empty/invalid Offer (which Google flags as an incomplete Product snippet).
  ...(tool.pricing.starting_at_usd !== null && {
    offers: {
      '@type': 'Offer',
      price: tool.pricing.starting_at_usd,
      priceCurrency: 'USD',
    },
  }),
  // Only emit aggregateRating from REAL first-party reviews. Emitting a
  // fabricated reviewCount (e.g. a baseline of 50 with zero real reviews) is a
  // Google structured-data violation. reviews.json is currently empty, so no
  // aggregateRating is emitted until genuine reviews exist. Third-party review
  // scores are not shown (2026-09-30); the page links to the review sites instead.
  ...(userRating && {
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: userRating.avg.toFixed(1),
      bestRating: '5',
      reviewCount: userRating.count,
    },
  }),
  ...(userReviews.length > 0 && {
    review: userReviews.slice(0, 10).map((r) => ({
      '@type': 'Review',
      reviewRating: {
        '@type': 'Rating',
        ratingValue: r.rating,
        bestRating: 5,
      },
      author: {
        '@type': 'Person',
        name: `${r.reviewer_role.charAt(0).toUpperCase() + r.reviewer_role.slice(1)} (${r.team_size} users, ${r.vertical})`,
      },
      datePublished: r.submitted_date,
      reviewBody: `Pros: ${r.pros} Cons: ${r.cons}`,
    })),
  }),
};

// Only emit the SoftwareApplication schema when it carries at least one of
// offers / aggregateRating / review; otherwise Google flags it as an
// incomplete Product snippet. Custom-quoted tools with no first-party reviews
// have none, so we skip it (the page still ranks; it just isn't eligible for a
// product rich result, which is correct: we have nothing to show in one).
const emitProductSchema =
  tool.pricing.starting_at_usd !== null || !!userRating || userReviews.length > 0;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqsList.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const pageTitle = `${tool.name} Review (2026): Pricing, Features, Pros & Cons`;
const pageDescription = `${tool.name} review: pricing tiers, key features, pros and cons, integrations, and honest weaknesses. ${asSentence(tool.tagline)} Updated ${new Date().getFullYear()}.`;

// (Removed the standalone Review schema: it recast the third-party G2/Capterra
// aggregate as WrenchStack's own review rating, and its embedded SoftwareApplication
// had no offers/rating, which is what Google flagged as an incomplete Product
// snippet. Honest review-stars should come from real first-party reviews, which the
// productSchema's aggregateRating already emits once reviews.json has entries.)

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Tools', url: '/tools/' },
  { name: tool.name, url: `/tools/${tool.slug}/` },
];
---

<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>
  {emitProductSchema && <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />}
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <article class="mx-auto max-w-4xl px-4 py-12">
    <nav class="mb-6 text-sm text-slate-500">
      <a href="/" class="hover:text-slate-900">Home</a>
      <span class="mx-2">/</span>
      <a href="/tools/" class="hover:text-slate-900">All tools</a>
      <span class="mx-2">/</span>
      <span class="text-slate-900">{tool.name}</span>
    </nav>

    <header class="mb-10">
      <div class="mb-4 flex items-start gap-4">
        <ToolLogo tool={tool} size={64} />
        <div class="min-w-0 flex-1">
          <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">
            {tool.name} Review
          </h1>
          <p class="mt-2 text-base italic text-slate-600 sm:text-lg">{tool.tagline}</p>
        </div>
        <div class="hidden shrink-0 sm:block">
          <WrenchScore score={wrenchStackScore(tool)} size="lg" />
        </div>
      </div>
      <div class="mb-4 block sm:hidden">
        <WrenchScore score={wrenchStackScore(tool)} size="lg" />
      </div>
      <Byline updatedDate={tool.pricing.verified_date} readingMinutes={readingTimeMinutes(1600)} />

      <div class="mt-4 flex flex-wrap items-center gap-2">
        <FreshnessBadge tool={tool} variant="full" showDate={true} />
        {wins.map((a) => (
          <AwardBadge category={a.category} kind="winner" variant="pill" hideYear={false} />
        ))}
        {honorableMentions.length > 0 && wins.length === 0 && (
          // If no wins, surface the top honorable mention in the hero
          <AwardBadge category={honorableMentions[0].category} kind="honorable_mention" variant="pill" hideYear={false} />
        )}
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-slate-600">
        {tool.founded &&<span>Founded {tool.founded}</span>}
        {tool.headquartered && <span>HQ {tool.headquartered}</span>}
        <span>Best team size: {tool.best_team_size ?? 'n/a'}</span>
      </div>

      <details class="mt-4 rounded-lg border border-slate-200 bg-white text-sm">
        <summary class="cursor-pointer list-none px-4 py-2.5 font-medium text-slate-700 hover:text-orange-600">
          <span class="select-none">▸</span> How we scored {tool.name}: <span class="font-bold text-slate-900">{toolScore.toFixed(1)}/10</span>
        </summary>
        <div class="border-t border-slate-100 px-4 py-3">
          <table class="w-full text-xs">
            <thead>
              <tr class="text-left text-slate-500">
                <th class="pb-1 font-semibold">Factor</th>
                <th class="pb-1 font-semibold">Weight</th>
                <th class="pb-1 font-semibold text-right">Sub-score</th>
              </tr>
            </thead>
            <tbody>
              {scoreBreakdown.map((b) => (
                <tr class="border-t border-slate-50">
                  <td class="py-1 text-slate-700">{b.factor}</td>
                  <td class="py-1 text-slate-500">{Math.round(b.weight * 100)}%</td>
                  <td class="py-1 text-right font-medium text-slate-900">{b.raw.toFixed(1)}/10</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="mt-2 text-xs leading-relaxed text-slate-500">
            Weighted composite, applied identically to every vendor; no vendor pays to change it. <a href="/methodology/" class="underline hover:text-orange-600">Full Fit Score methodology →</a>
          </p>
        </div>
      </details>

      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href={tool.affiliate_url.startsWith('http') ? tool.affiliate_url : tool.vendor_url}
          rel="sponsored nofollow noopener"
          target="_blank"
