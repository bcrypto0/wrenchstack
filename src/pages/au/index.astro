---
import Layout from '../../layouts/Layout.astro';
import { EN_MARKET_HREFLANG } from '../../lib/intl';
import auData from '../../data/international/au.json';

interface AuVendor {
  slug: string;
  name: string;
  category: string;
  vendor_url: string;
  tagline: string;
  market_position: string;
  au_specific_note?: string | null;
  uk_specific_note?: string | null;
  tier: 'S' | 'A' | 'F';
  reputation_flag: string | null;
  pros: string[];
  cons: string[];
  typical_pricing: string;
  is_cross_market: boolean;
  cross_market_link: string | null;
}

const vendors = (auData as { vendors: AuVendor[] }).vendors;

const categories = ['software', 'lead-gen', 'insurance', 'payroll', 'certification'];
const categoryMeta: Record<string, { label: string; description: string }> = {
  'software': { label: 'Field service software', description: `Job management software sold to Australian trade businesses. AroFlo (Melbourne) and Simpro (founded in Brisbane) are both owned by Simpro Group; ServiceM8, from an Australian company, prices by jobs per month with unlimited users on paid plans; Tradify (founded in New Zealand, owned by the UK's Access Group) and Fergus price per user. AroFlo lists supplier integrations with wholesalers such as Reece, Rexel and Actrol, and Fergus says supplier invoices from merchants such as Reece and Tradelink import and match to jobs automatically.` },
  'lead-gen': { label: 'Lead-generation platforms', description: 'Ways Australian tradies find work, each charging differently. On hipages and ServiceSeeking customers post jobs and tradies pay a subscription; on Bark pros spend credits to respond to requests shared with up to five pros; Localsearch and Yellow Pages are directories with free listings plus paid marketing or ads. ServiceSeeking and Bark carry reputation warnings: read them before signing up.' },
  'insurance': { label: 'Business insurance', description: `Three ways to buy tradie cover: online platforms that act as the insurer's agent rather than yours (BizCover, with a panel of 13 insurers, and upcover), brokers that quote each business (Trade Risk and Smart Business Insurance), and insurers that sell their own policies direct (NRMA Insurance and Allianz). BizCover and upcover list their own per-policy fees on top of the premium: $20-$200 plus GST at BizCover and $0-$300 ex GST at upcover.` },
  'payroll': { label: 'Payroll software', description: 'Payroll software that reports to the ATO through Single Touch Payroll. MYOB, Employment Hero (formerly KeyPay), Xero and Reckon each describe Payday Super support on their payroll pages, and Deputy sells payroll as an add-on to its rostering and timesheet plans. Award handling differs: Employment Hero says pay rates update automatically for modern awards and Deputy includes award interpretation from its Lite plan, while MYOB, Xero and Reckon do not describe an award-interpretation feature on their payroll pages.' },
  'certification': { label: 'State licensing bodies and the ATO', description: 'Trade licensing is run by each state: Building Commission NSW issues building and trade licences in NSW (NSW Fair Trading is the consumer protection regulator), QBCC covers Queensland (electrical work is licensed separately by the Electrical Safety Office), the Building and Plumbing Commission (formerly the VBA) covers Victoria, Building and Energy covers WA and Consumer and Business Services covers SA. Under Automatic Mutual Recognition, licence holders from participating states can work in NSW, usually after a free notification; Queensland does not take part. The ATO is the federal tax office for GST, BAS, Single Touch Payroll and super, and does not license trades.' },
};

const vendorsByCategory: Record<string, AuVendor[]> = {};
categories.forEach(c => { vendorsByCategory[c] = vendors.filter(v => v.category === c); });
const activeCategoryCount = categories.filter(c => vendorsByCategory[c].length > 0).length;

const pageTitle = 'AU Trades Vendor Directory | WrenchStack Australia';
const pageDescription = `WrenchStack's Australia trades directory: ${vendors.length} entries across job management software, lead generation, insurance, payroll, and state licensing and tax bodies, with published prices where vendors list them, Single Touch Payroll and Payday Super notes, and state licensing rules.`;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Australia', url: '/au/' },
];
---

<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs} alternateUrls={EN_MARKET_HREFLANG}>
  <article class="mx-auto max-w-5xl px-4 py-12">

    <header class="mb-10">
      <div class="mb-3 flex items-center gap-2">
        <span class="text-2xl" aria-hidden="true">🇦🇺</span>
        <p class="text-sm font-semibold uppercase tracking-wider text-orange-600">Australia</p>
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">
        Australia Trades Vendor Directory
      </h1>
      <p class="mt-4 text-lg text-slate-600 leading-relaxed">
        Independent reviews of {vendors.length} Australia-relevant vendors and regulators across {activeCategoryCount} categories, for Australian contractors: Single Touch Payroll and Payday Super in payroll, how each payroll product handles awards, supplier integrations with wholesalers such as Reece, state licensing (Building Commission NSW, QBCC, the Building and Plumbing Commission in Victoria, and the WA and SA regulators), and how each lead platform charges.
      </p>
    </header>

    <section class="mb-10 grid gap-3 grid-cols-2 sm:grid-cols-5">
      {categories.map(c => (
        <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
          <div class="text-2xl font-bold text-slate-900">{vendorsByCategory[c].length}</div>
          <div class="mt-1 text-xs text-slate-600 capitalize">{c.replace('-', ' ')}</div>
        </div>
      ))}
    </section>

    <section class="mb-10 flex flex-wrap items-center justify-between gap-4 rounded-lg border border-orange-200 bg-orange-50 p-5">
      <div>
        <h2 class="text-base font-bold text-slate-900">Deciding between two options?</h2>
        <p class="mt-1 text-sm text-slate-700">See AU vendors compared side by side: pros and cons, AU-specific notes and pricing, head to head.</p>
      </div>
      <a href="/au/compare/" class="shrink-0 rounded-md bg-slate-900 px-5 py-3 text-sm font-semibold text-white hover:bg-slate-700">Compare AU vendors →</a>
    </section>

    <section class="mb-10 flex flex-wrap items-center justify-between gap-4 rounded-lg border-2 border-emerald-300 bg-emerald-50 p-5">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-emerald-700">✅ Compliance guide · In effect since 1 July 2026</p>
        <h2 class="mt-1 text-base font-bold text-slate-900">Payday super is law: the quarterly batch is over</h2>
        <p class="mt-1 text-sm text-slate-700">Super with every pay run, received by the fund within 7 business days of payday, per Treasury. The cash-flow shift, the super guarantee charge and what to confirm with your payroll vendor.</p>
      </div>
      <a href="/au/guides/payday-super-payroll-software/" class="shrink-0 rounded-md bg-emerald-700 px-5 py-3 text-sm font-semibold text-white hover:bg-emerald-800">Read the guide →</a>
    </section>

    <section class="mb-10 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-3 text-base font-bold text-slate-900">What's different about AU trades vendor selection</h2>
      <p class="text-sm text-slate-700 leading-relaxed">
        Three things shape the Australian picture. First, <strong>trade licensing is run by the states</strong>: building and trade licences in NSW come from Building Commission NSW, Queensland uses QBCC (with electrical work licensed by the Electrical Safety Office), and Victoria uses the Building and Plumbing Commission, which the VBA is now part of. Under Automatic Mutual Recognition, licence holders from participating states can work in NSW, usually after a free notification, but Queensland does not take part, so a licence from another state does not automatically cover work there. Second, <strong>payroll carries Single Touch Payroll reporting and Payday Super</strong>: from 1 July 2026 the super guarantee is due when wages are paid rather than quarterly, and award handling varies, with Employment Hero and Deputy describing automated award handling while MYOB, Xero and Reckon do not describe an award-interpretation feature. Third, <strong>lead platforms charge in different ways</strong>: hipages and ServiceSeeking sell subscriptions, Bark sells credits to respond to requests shared with up to five pros, and Localsearch and Yellow Pages offer free listings with paid marketing or ads, some on 6- or 12-month minimum terms.
      </p>
    </section>

    {categories.map(c => {
      const cat = categoryMeta[c];
      const cv = vendorsByCategory[c];
      if (cv.length === 0) return null;
      return (
        <section class="mb-12">
          <div class="mb-5">
            <h2 class="text-2xl font-bold text-slate-900 capitalize">{cat.label}</h2>
            <p class="mt-1 text-sm text-slate-600 leading-relaxed">{cat.description}</p>
          </div>
          <div class="space-y-4">
            {cv.map(v => {
              const tierColor = v.tier === 'S' ? 'border-emerald-300' : v.tier === 'F' ? 'border-rose-300' : 'border-blue-300';
              const tierLabel = v.tier === 'S' ? 'Published prices' : v.tier === 'F' ? 'Reputation warning' : 'Listed';
              const tierBadge = v.tier === 'S' ? 'bg-emerald-100 text-emerald-900' : v.tier === 'F' ? 'bg-rose-100 text-rose-900' : 'bg-blue-100 text-blue-900';
              return (
                <article class={`rounded-lg border-2 ${tierColor} bg-white p-5`}>
                  <div class="mb-3 flex items-start justify-between gap-3">
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-2 mb-1 flex-wrap">
                        <h3 class="text-xl font-bold text-slate-900">{v.name}</h3>
                        <span class={`rounded-full px-2 py-0.5 text-xs font-bold ${tierBadge}`}>Tier {v.tier} · {tierLabel}</span>
                        </div>
                      <p class="text-sm italic text-slate-500">{v.tagline}</p>
                    </div>
                  </div>

                  {v.reputation_flag && (
                    <div class="mb-3 rounded-md border-l-4 border-rose-500 bg-rose-50 px-4 py-3 text-sm text-rose-900">
                      <p class="font-bold uppercase tracking-wider text-xs text-rose-700 mb-1">⚠ Reputation warning</p>
                      <p class="leading-relaxed">{v.reputation_flag}</p>
                    </div>
                  )}

                  <p class="mb-3 text-sm text-slate-700 leading-relaxed">{v.market_position}</p>

                  {v.au_specific_note && (
                    <div class="mb-3 rounded-md bg-slate-50 px-4 py-3">
                      <p class="text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">AU-specific note</p>
                      <p class="text-sm text-slate-700 leading-relaxed">{v.au_specific_note}</p>
                    </div>
                  )}

                  <div class="mb-3 grid gap-3 sm:grid-cols-2">
                    <div>
                      <p class="text-xs font-bold uppercase tracking-wider text-emerald-700 mb-1">Pros</p>
                      <ul class="space-y-1 text-sm text-slate-700">
                        {v.pros.slice(0, 4).map(p => <li class="leading-snug">+ {p}</li>)}
                      </ul>
                    </div>
                    <div>
                      <p class="text-xs font-bold uppercase tracking-wider text-rose-700 mb-1">Cons</p>
                      <ul class="space-y-1 text-sm text-slate-700">
                        {v.cons.slice(0, 4).map(con => <li class="leading-snug">− {con}</li>)}
                      </ul>
                    </div>
                  </div>

                  <div class="mb-3 text-xs text-slate-600">
                    <strong class="text-slate-900">Typical AU pricing:</strong> {v.typical_pricing}
                  </div>

                  <div class="flex flex-wrap gap-2">
                    <a href={`/au/${v.slug}/`} class="rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700">Full AU review →</a>
                    <a href={v.vendor_url} rel="sponsored nofollow noopener" target="_blank" class="rounded-md bg-orange-500 px-4 py-2 text-sm font-semibold text-white hover:bg-orange-600">Visit {v.name} →</a>
                    {v.cross_market_link && (
                      <a href={v.cross_market_link} class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">Full review (US market context)</a>
                    )}
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      );
    })}

    <section class="mt-12 rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">Missing an AU vendor?</h2>
      <p class="mt-2 text-slate-300 leading-relaxed">
        {vendors.length} AU entries covered today across {activeCategoryCount} categories. Want an AU vendor reviewed? Submit them via our <a href="/for-vendors/" class="underline">vendor program</a>.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/" class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600">Back to US directory →</a>
        <a href="/for-vendors/" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">Submit an AU vendor</a>
        <a href="/methodology/" class="rounded-md border border-white/30 bg-white/10 px-5 py-3 text-sm font-semibold text-white hover:bg-white/20">Methodology</a>
      </div>
    </section>
  </article>
</Layout>
