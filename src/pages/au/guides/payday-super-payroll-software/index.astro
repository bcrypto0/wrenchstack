---
import Layout from '../../../../layouts/Layout.astro';
import auData from '../../../../data/international/au.json';

interface AuVendor {
  slug: string; name: string; category: string;
}
const vendors = (auData as { vendors: AuVendor[] }).vendors;
const bySlug = new Map(vendors.map((v) => [v.slug, v]));

// Payroll platforms in our AU directory: payday super is paid from the payroll layer.
// Each row restates what the vendor's own pages say, from the entries re-verified
// on 30 September 2026; the buyer's job is confirming it for their plan.
const payrollPlatforms = [
  { slug: 'xero-payroll-au', fit: 'Payroll included in Xero’s Australian accounting plans (2, 5 or 10 people by plan); STP Phase 2 reporting each payday', note: 'Xero says super is calculated and paid in each pay run at no extra cost; check your plan covers your headcount' },
  { slug: 'myob', fit: 'Accounting and payroll for AU and NZ businesses since 1991; Single Touch Payroll reporting; standalone Payroll Only plan for up to 4 employees', note: 'MYOB has a Pay Super setting for the Payday Super changes; confirm it is switched on for your product' },
  { slug: 'keypay-employment-hero', fit: 'Pay rates update automatically for modern awards (per Employment Hero); STP Phase 2; minimum of 10 Users', note: 'Confirm HeroClear super clearing is set up on your plan' },
  { slug: 'deputy', fit: 'Rostering, timesheets and award interpretation, with Deputy Payroll as a paid add-on designed for STP Phase 2 (per Deputy)', note: 'Confirm how super is paid on each payday with the Payroll add-on on your plan' },
  { slug: 'reckon', fit: 'Standalone payroll app, Payroll Essentials $16 a month for up to 4 employees; STP Phase 2', note: 'Reckon says its payroll is Payday Super compliant with built-in SuperStream; confirm on your plan' },
]
  .filter((r) => bySlug.has(r.slug))
  .map((r) => ({ ...r, name: bySlug.get(r.slug)?.name ?? r.slug }));

const fsmTools = ['aroflo', 'simpro-au', 'servicem8-au', 'tradify-au', 'fergus-au']
  .filter((slug) => bySlug.has(slug))
  .map((slug) => ({ slug, name: bySlug.get(slug)?.name ?? slug }));

const faqs = [
  { q: 'Is payday super law, or still a proposal?', a: 'It is law. Treasury announced on 4 November 2025 that the legislation had passed Parliament, and the new rules started on 1 July 2026. Employers now pay super at the same time as salary and wages, whether staff are paid weekly, fortnightly or monthly, instead of quarterly.' },
  { q: 'What changed from the old quarterly system?', a: 'Super guarantee contributions used to be due quarterly. Since 1 July 2026 every payday triggers a contribution, and it must be received by the employee’s fund within 7 business days of payday, per Treasury. Treasury’s September 2024 factsheet had proposed 7 calendar days; the law as passed uses 7 business days.' },
  { q: 'What happens if contributions arrive late?', a: 'The employer becomes liable for the super guarantee charge. Treasury’s payday super factsheet (September 2024) describes its parts: the shortfall, notional earnings (daily interest at the general interest charge rate) and an administrative uplift of up to 60% of the shortfall, reduced for employers who voluntarily disclose. For the first year, Treasury said in November 2025 that the ATO was consulting on its compliance approach for the 12 months after the start, treating low-risk and high-risk employers differently; check the ATO’s current guidance rather than planning around it.' },
  { q: 'Does my job-management software (AroFlo, Simpro, Tradify…) handle payday super?', a: 'Our entries for AroFlo, Simpro, ServiceM8, Tradify and Fergus describe no payroll or super payments, so super is paid from your payroll software (such as Xero, MYOB or Employment Hero), which our entries say calculates or pays super with each pay run. Payday super readiness is a payroll question; the job app matters for getting timesheets to payroll on time.' },
  { q: 'I paid super through the ATO’s free clearing house (SBSCH). What now?', a: 'Treasury’s payday super factsheet said the ATO’s Small Business Superannuation Clearing House would be retired from 1 July 2026. If you used it for quarterly payments, that step now moves into your payroll software or another clearing service that pays super with each pay run; check the ATO’s site for its transition guidance.' },
  { q: 'What should a trades business check now that payday super has started?', a: 'Four things: confirm your payroll platform’s payday super support is switched on and included in your plan; work out the cash-flow change, since super now leaves your account with every pay run instead of quarterly; check employee super-fund details, including stapled-fund checks for new hires, so contributions are not delayed; and watch your pay runs to confirm contributions reach funds within 7 business days.' },
];

const pageTitle = 'Payday Super Is Now in Effect (1 July 2026): Is Your Payroll Software Ready? (AU Trades Guide)';
const pageDescription = 'Payday super is now in effect: since 1 July 2026, super must be paid with every pay run and received by the employee’s fund within 7 business days of payday. What it means for Australian trades businesses, the super guarantee charge, the cash-flow shift, and what to confirm with Xero, MYOB or Employment Hero. Updated October 2026.';

const guideUrl = new URL('/au/guides/payday-super-payroll-software/', Astro.site).toString();

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Australia', url: '/au/' },
  { name: 'Payday super for trades businesses', url: '/au/guides/payday-super-payroll-software/' },
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: pageTitle,
  description: pageDescription,
  datePublished: '2026-06-11',
  dateModified: '2026-10-01',
  inLanguage: 'en-AU',
  author: { '@type': 'Organization', name: 'WrenchStack Research', url: 'https://wrenchstack.com/research/' },
  publisher: { '@type': 'Organization', name: 'WrenchStack', url: 'https://wrenchstack.com' },
  mainEntityOfPage: guideUrl,
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <article class="mx-auto max-w-4xl px-4 py-12">
    <header class="mb-8">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-orange-600">🇦🇺 Australia · Compliance guide</p>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        Payday Super Is Now in Effect: Is Your Payroll Ready?
      </h1>
      <p class="mt-3 text-lg text-slate-600 leading-relaxed">
        The quarterly super batch is over: since 1 July 2026, super goes out with every pay run and must be received by each employee’s fund within 7 business days of payday. What that means for Australian trades businesses: cash flow, clearing houses, and what to confirm with your payroll vendor.
      </p>
      <p class="mt-3 text-sm text-slate-500">By WrenchStack Research · Published June 2026 · Updated 1 October 2026 · General information, not financial advice; confirm your obligations with the ATO or your adviser.</p>
    </header>

    <section class="mb-8 rounded-lg border-2 border-orange-300 bg-orange-50 p-6">
      <h2 class="mb-2 text-lg font-bold text-slate-900">✅ The short version</h2>
      <p class="text-slate-800 leading-relaxed">
        Payday super <strong>passed Parliament</strong> (Treasury, November 2025) and has been <strong>in effect since 1 July 2026</strong>. Every pay run (weekly, fortnightly or monthly) must now include super, and the contribution must be <strong>received by the employee’s fund within 7 business days of payday</strong>. Late contributions bring the <strong>super guarantee charge</strong>, which Treasury’s factsheet says includes daily interest and an administrative uplift of up to 60% of the shortfall. Our entries for the job-management apps in our AU directory describe no payroll, so this sits with <strong>your payroll software</strong>: confirm its payday super support is switched on for your plan.
      </p>
    </section>

    <section class="mb-10 grid gap-3 sm:grid-cols-3">
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">1 Jul 2026</div>
        <div class="mt-1 text-xs text-slate-600">payday super in effect since (law commenced)</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">7 business days</div>
        <div class="mt-1 text-xs text-slate-600">for super to reach the employee’s fund after payday</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">up to 60%</div>
        <div class="mt-1 text-xs text-slate-600">administrative uplift on the shortfall, plus daily interest (Treasury factsheet)</div>
      </div>
    </section>

    <section class="mb-10 prose prose-slate max-w-none">
      <h2>What changes</h2>
      <p>
        Before <strong>1 July 2026</strong>, super guarantee contributions were due <strong>quarterly</strong>. Since then:
      </p>
      <ul>
        <li><strong>Super goes with every pay run.</strong> Pay wages weekly, and super goes weekly too.</li>
        <li><strong>Received, not just sent:</strong> the contribution must <em>arrive</em> in the employee’s fund within <strong>7 business days</strong> of payday; Treasury says the window covers the time payments take to move through the payment system, including clearing houses.</li>
        <li><strong>The super guarantee charge:</strong> the shortfall, daily interest and an administrative uplift of up to <strong>60% of the shortfall</strong>, reduced for employers who voluntarily disclose (Treasury factsheet, September 2024).</li>
        <li><strong>The first year:</strong> Treasury said in November 2025 that the ATO was consulting on its compliance approach for the 12 months after the start; check the ATO’s current guidance rather than planning around it.</li>
      </ul>

      <h2>What it means if you pay weekly</h2>
      <ul>
        <li><strong>More payments:</strong> a business that pays wages weekly now makes 52 super payments a year instead of 4 quarterly ones.</li>
        <li><strong>Cash flow:</strong> super you used to hold until the quarterly due date now leaves with every pay run, so check the working-capital effect.</li>
        <li><strong>New starters:</strong> wrong or missing super-fund details can hold up a contribution while the 7-business-day window runs.</li>
        <li><strong>Clearing house:</strong> Treasury said the ATO’s free Small Business Superannuation Clearing House would be retired from 1 July 2026. If your quarterly routine ran through it, payroll software can pay super with each pay run.</li>
      </ul>

      <h2>The payroll platforms in our AU directory</h2>
      <p>
        Payday super is paid from the <strong>payroll layer</strong>. From our <a href="/au/">Australian trades directory</a>, these are the payroll platforms. MYOB, Employment Hero, Xero and Reckon each describe Payday Super support on their payroll pages, and Deputy’s payroll page covers the change, so the buyer’s job is confirming it’s switched on for <em>your</em> plan:
      </p>
    </section>

    <section class="mb-10 overflow-x-auto">
      <table class="w-full text-sm border border-slate-200 rounded-lg overflow-hidden">
        <thead class="bg-slate-50 text-left text-slate-700">
          <tr>
            <th class="p-3 font-semibold">Platform</th>
            <th class="p-3 font-semibold">What it offers</th>
            <th class="p-3 font-semibold">Confirm on your plan</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 bg-white">
          {payrollPlatforms.map((v) => (
            <tr>
              <td class="p-3 font-semibold text-slate-900"><a href={`/au/${v.slug}/`} class="text-orange-700 hover:underline">{v.name}</a></td>
              <td class="p-3 text-slate-600">{v.fit}</td>
              <td class="p-3 text-slate-600">{v.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="mt-3 text-xs text-slate-500">Source: WrenchStack AU directory entries, re-checked against vendor pages on 30 September 2026. Confirm the specifics for your plan with the vendor.</p>
    </section>

    <section class="mb-10 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-2 text-lg font-bold text-slate-900">Your job-management app doesn’t pay super</h2>
      <p class="text-sm text-slate-700 leading-relaxed">
        {fsmTools.map((v, i) => (<><a href={`/au/${v.slug}/`} class="font-medium text-orange-700 hover:underline">{v.name}</a>{i < fsmTools.length - 1 ? ', ' : ''}</>))} run quotes, scheduling and invoicing, and our entries for them describe no payroll or super payments. Super is paid from payroll software such as Xero, MYOB or Employment Hero. The job app still matters for payday super: late timesheets mean late pay runs, and late pay runs now mean late super.
      </p>
    </section>

    <section class="mb-10 prose prose-slate max-w-none">
      <h2>Payday super checklist for trades employers</h2>
      <ol>
        <li><strong>Confirm your payroll platform’s payday super support is switched on</strong>, and that your plan includes it.</li>
        <li><strong>Model the cash-flow shift.</strong> Take last quarter’s super bill, spread it across your actual pay cycles, and check the working-capital effect.</li>
        <li><strong>Check employee super data:</strong> fund details, member numbers and stapled-fund checks for new hires.</li>
        <li><strong>Replace the ATO clearing house</strong> if SBSCH was your route: Treasury said it would be retired from 1 July 2026, so pay super through your payroll software or another clearing service.</li>
        <li><strong>Tighten the timesheet pipeline</strong> from your job-management app: late timesheets now mean late super, not only late wages.</li>
        <li><strong>Watch your pay runs.</strong> Track each cycle to confirm contributions reach funds within 7 business days.</li>
      </ol>
    </section>

    <section class="mb-10">
      <h2 class="mb-5 text-2xl font-bold text-slate-900">Frequently asked questions</h2>
      <div class="space-y-3">
        {faqs.map((f) => (
          <details class="rounded-lg border border-slate-200 bg-white p-4">
            <summary class="cursor-pointer font-semibold text-slate-900">{f.q}</summary>
            <p class="mt-3 text-slate-700 leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mb-10 rounded-lg bg-slate-50 p-5 text-xs text-slate-500 leading-relaxed">
      <strong class="text-slate-700">Sources &amp; verification:</strong> Checked on 1 October 2026: Treasury’s <a href="https://ministers.treasury.gov.au/ministers/daniel-mulino-2025/media-releases/new-legislation-passes-ensure-super-paid-time" rel="nofollow noopener" target="_blank">media release of 4 November 2025</a> (legislation passed; start on 1 July 2026; contributions received within 7 business days of payday; ATO consulting on its first-year compliance approach) and Treasury’s <a href="https://treasury.gov.au/sites/default/files/2024-09/p2024-581438-payday-super-factsheet.pdf" rel="nofollow noopener" target="_blank">payday super factsheet</a> of 17 September 2024 (super guarantee charge components, administrative uplift of up to 60% of the shortfall, SBSCH retirement from 1 July 2026). The <a href="https://www.ato.gov.au/businesses-and-organisations/super-for-employers/about-payday-super" rel="nofollow noopener" target="_blank">ATO’s payday super guidance</a> could not be read by our checker on 1 October 2026. Vendor positions from each vendor’s published material, re-checked 30 September 2026. General information, not financial or tax advice. Spotted an error? <a href="/contact/" class="underline">Tell us</a>.
    </section>

    <section class="rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">Compare the Australian options side by side</h2>
      <p class="mt-2 text-slate-300 leading-relaxed">Independent reviews of {vendors.length} Australian entries: software, payroll, insurance, lead generation and state regulators, with no pay-to-play.</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/au/" class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600">🇦🇺 Australian directory →</a>
        <a href="/au/compare/" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">Compare vendors</a>
        <a href="/for-vendors/" class="rounded-md border border-white/30 bg-white/10 px-5 py-3 text-sm font-semibold text-white hover:bg-white/20">Are you a vendor? Work with us</a>
      </div>
    </section>
  </article>
</Layout>
