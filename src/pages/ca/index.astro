---
import Layout from '../../layouts/Layout.astro';
import { EN_MARKET_HREFLANG } from '../../lib/intl';
import caData from '../../data/international/ca.json';

interface CaVendor {
  slug: string;
  name: string;
  category: string;
  vendor_url: string;
  tagline: string;
  market_position: string;
  ca_specific_note?: string | null;
  au_specific_note?: string | null;
  tier: 'S' | 'A' | 'F';
  reputation_flag: string | null;
  pros: string[];
  cons: string[];
  typical_pricing: string;
  is_cross_market: boolean;
  cross_market_link: string | null;
}

const vendors = (caData as { vendors: CaVendor[] }).vendors;

const categories = ['software', 'lead-gen', 'insurance', 'payroll', 'certification'];
const categoryMeta: Record<string, { label: string; description: string }> = {
  'software': { label: 'Field service software', description: 'Field service and job management software sold to Canadian contractors. Canadian-based options include Jobber (founded in Edmonton in 2011; plans listed in US dollars), ServiceBox (Regina; Canadian customers billed in local currency), ProgressionLIVE (Quebec; app listed in English, French and Spanish) and Method:CRM (Toronto; Canadian customers billed in CAD). Housecall Pro (San Diego) and ServiceTitan (Glendale, California, with a Canadian subsidiary) are US-based, and Housecall Pro lists several payment and tax features as unavailable in Canada. LMN, sold by Granum, is built for landscaping and priced in US dollars.' },
  'lead-gen': { label: 'Lead-generation platforms', description: 'HomeStars is owned by Angi Inc., also the parent of HomeAdvisor; Angi Inc. says its international businesses, HomeStars included, earn mainly from lead fees and membership subscriptions paid by pros. HomeStars carries a reputation warning. TrustedPros is a separate Toronto directory and referral service, RenovationFind certifies and grades the contractors it lists, Jiffy (owned by Intact since 2024) sends pre-priced booked jobs, and Bark sells credits to respond to requests shared with up to five pros, also with a reputation warning.' },
  'insurance': { label: 'Business insurance', description: 'Brokers and insurers for Canadian contractors: Zensurance, a Toronto brokerage and Travelers subsidiary that says it works with more than 50 insurance providers; APOLLO, a Vancouver digital broker owned by Gallagher since August 2026, whose business pages are built around professions rather than trades; Intact Insurance, sold through independent brokers; and Foxquilt, a Toronto-founded insurtech that underwrites its own products. Neither Zensurance nor APOLLO includes Quebec among the provinces on its site.' },
  'payroll': { label: 'Payroll software', description: 'Canadian payroll for CRA remittances and Records of Employment. Quebec handling differs: Wagepoint added built-in Quebec payroll on September 22, 2026, Employment Hero points Quebec businesses to Humi by Employment Hero, and Payworks and Knit People do not describe Quebec payroll on their main pages. Wagepoint and Knit People publish plan prices; Payworks is quote-based, and Employment Hero publishes add-on prices but quotes its core plans.' },
  'certification': { label: 'National + provincial certifications', description: 'The Red Seal Program sets interprovincial standards for more than 50 trades, and its endorsement facilitates labour mobility, but provinces and territories remain responsible for trade certification. In Ontario, Skilled Trades Ontario issues trade certificates, ESA licenses electrical contractors, TSSA registers fuels contractors and certifies gas technicians, and WSIB runs workplace insurance and construction clearance certificates. HRAI is a national HVACR trade association, not a licensing body.' },
};

const vendorsByCategory: Record<string, CaVendor[]> = {};
categories.forEach(c => { vendorsByCategory[c] = vendors.filter(v => v.category === c); });

const pageTitle = 'CA Trades Vendor Directory | WrenchStack Canada';
const pageDescription = `WrenchStack's Canada trades directory: ${vendors.length} entries across field service software, lead generation, insurance, payroll, and national and Ontario certification bodies, with published prices where vendors list them, currency notes, Quebec payroll support and provincial rules.`;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Canada', url: '/ca/' },
];
---

<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs} alternateUrls={EN_MARKET_HREFLANG}>
  <article class="mx-auto max-w-5xl px-4 py-12">

    <header class="mb-10">
      <div class="mb-3 flex items-center gap-2">
        <span class="text-2xl" aria-hidden="true">🇨🇦</span>
        <p class="text-sm font-semibold uppercase tracking-wider text-orange-600">Canada</p>
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">
        Canada Trades Vendor Directory
      </h1>
      <p class="mt-4 text-lg text-slate-600 leading-relaxed">
        Independent reviews of {vendors.length} Canada-relevant vendors and regulators across 5 categories, for Canadian contractors: which software lists prices in US dollars or bills in CAD, GST and PST on invoices, Quebec payroll support, CRA remittances and Records of Employment, the Red Seal Program, and Ontario rules from Skilled Trades Ontario, ESA, TSSA and WSIB.
      </p>
    </header>

    <section class="mb-10 grid gap-3 grid-cols-2 sm:grid-cols-5">
      {categories.map(c => (
        <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
          <div class="text-2xl font-bold text-slate-900">{vendorsByCategory[c].length}</div>
          <div class="mt-1 text-xs text-slate-600 capitalize">{c.replace('-', ' ')}</div>
        </div>
      ))}
    </section>

    <section class="mb-10 flex flex-wrap items-center justify-between gap-4 rounded-lg border border-orange-200 bg-orange-50 p-5">
      <div>
        <h2 class="text-base font-bold text-slate-900">Deciding between two options?</h2>
        <p class="mt-1 text-sm text-slate-700">See CA vendors compared side by side: pros and cons, CA-specific notes and pricing, head to head.</p>
      </div>
      <a href="/ca/compare/" class="shrink-0 rounded-md bg-slate-900 px-5 py-3 text-sm font-semibold text-white hover:bg-slate-700">Compare CA vendors →</a>
    </section>

    <section class="mb-10 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-3 text-base font-bold text-slate-900">What's different about CA trades vendor selection</h2>
      <p class="text-sm text-slate-700 leading-relaxed">
        Three things shape the Canadian picture. First, <strong>currency and sales tax vary by vendor</strong>: Jobber, founded in Edmonton in 2011, lists its plans in US dollars and adds sales tax where the province taxes software as a service; Housecall Pro prices in US dollars and applies only one tax rate per invoice; Method:CRM and ServiceBox say Canadian customers are billed in CAD or local currency. Second, <strong>trade certification is provincial</strong>: a Red Seal endorsement facilitates labour mobility across more than 50 trades, but provinces and territories remain responsible for apprenticeship and certification, and the program states that the endorsement does not by itself certify a person to carry on a trade. Third, <strong>Quebec payroll needs checking</strong>: it adds Revenu Québec remittances, QPP, QPIP and RL-1 reporting, per Wagepoint, which added built-in Quebec payroll in September 2026; Employment Hero directs Quebec businesses to Humi by Employment Hero, and Payworks and Knit People do not describe Quebec payroll on their main pages.
      </p>
    </section>

    {categories.map(c => {
      const cat = categoryMeta[c];
      const cv = vendorsByCategory[c];
      if (cv.length === 0) return null;
      return (
        <section class="mb-12">
          <div class="mb-5">
            <h2 class="text-2xl font-bold text-slate-900 capitalize">{cat.label}</h2>
            <p class="mt-1 text-sm text-slate-600 leading-relaxed">{cat.description}</p>
          </div>
          <div class="space-y-4">
            {cv.map(v => {
              const tierColor = v.tier === 'S' ? 'border-emerald-300' : v.tier === 'F' ? 'border-rose-300' : 'border-blue-300';
              const tierLabel = v.tier === 'S' ? 'Published prices' : v.tier === 'F' ? 'Reputation warning' : 'Listed';
              const tierBadge = v.tier === 'S' ? 'bg-emerald-100 text-emerald-900' : v.tier === 'F' ? 'bg-rose-100 text-rose-900' : 'bg-blue-100 text-blue-900';
              return (
                <article class={`rounded-lg border-2 ${tierColor} bg-white p-5`}>
                  <div class="mb-3 flex items-start justify-between gap-3">
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-2 mb-1 flex-wrap">
                        <h3 class="text-xl font-bold text-slate-900">{v.name}</h3>
                        <span class={`rounded-full px-2 py-0.5 text-xs font-bold ${tierBadge}`}>Tier {v.tier} · {tierLabel}</span>
                        </div>
                      <p class="text-sm italic text-slate-500">{v.tagline}</p>
                    </div>
                  </div>

                  {v.reputation_flag && (
                    <div class="mb-3 rounded-md border-l-4 border-rose-500 bg-rose-50 px-4 py-3 text-sm text-rose-900">
                      <p class="font-bold uppercase tracking-wider text-xs text-rose-700 mb-1">⚠ Reputation warning</p>
                      <p class="leading-relaxed">{v.reputation_flag}</p>
                    </div>
                  )}

                  <p class="mb-3 text-sm text-slate-700 leading-relaxed">{v.market_position}</p>

                  {v.ca_specific_note && (
                    <div class="mb-3 rounded-md bg-slate-50 px-4 py-3">
                      <p class="text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">CA-specific note</p>
                      <p class="text-sm text-slate-700 leading-relaxed">{v.ca_specific_note}</p>
                    </div>
                  )}

                  <div class="mb-3 grid gap-3 sm:grid-cols-2">
                    <div>
                      <p class="text-xs font-bold uppercase tracking-wider text-emerald-700 mb-1">Pros</p>
                      <ul class="space-y-1 text-sm text-slate-700">
                        {v.pros.slice(0, 4).map(p => <li class="leading-snug">+ {p}</li>)}
                      </ul>
                    </div>
                    <div>
                      <p class="text-xs font-bold uppercase tracking-wider text-rose-700 mb-1">Cons</p>
                      <ul class="space-y-1 text-sm text-slate-700">
                        {v.cons.slice(0, 4).map(con => <li class="leading-snug">− {con}</li>)}
                      </ul>
                    </div>
                  </div>

                  <div class="mb-3 text-xs text-slate-600">
                    <strong class="text-slate-900">Typical CA pricing:</strong> {v.typical_pricing}
                  </div>

                  <div class="flex flex-wrap gap-2">
                    <a href={`/ca/${v.slug}/`} class="rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700">Full CA review →</a>
                    <a href={v.vendor_url} rel="sponsored nofollow noopener" target="_blank" class="rounded-md bg-orange-500 px-4 py-2 text-sm font-semibold text-white hover:bg-orange-600">Visit {v.name} →</a>
                    {v.cross_market_link && (
                      <a href={v.cross_market_link} class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">Full review (US market context)</a>
                    )}
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      );
    })}

    <section class="mt-12 rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">Missing a CA vendor?</h2>
      <p class="mt-2 text-slate-300 leading-relaxed">
        {vendors.length} CA entries covered today across {categories.length} categories. Want a CA vendor reviewed? Submit them via our <a href="/for-vendors/" class="underline">vendor program</a>.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/" class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600">Back to US directory →</a>
        <a href="/for-vendors/" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">Submit a CA vendor</a>
        <a href="/methodology/" class="rounded-md border border-white/30 bg-white/10 px-5 py-3 text-sm font-semibold text-white hover:bg-white/20">Methodology</a>
      </div>
    </section>
  </article>
</Layout>
