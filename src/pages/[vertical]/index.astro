---
import Layout from '../../layouts/Layout.astro';
import { asSentence,
  verticals,
  rankToolsForVertical,
  verticalToUrl,
  formatPrice,
  wrenchStackScore,
  readingTimeMinutes,
  medianUsd,
  verticalFitScore,
  priceTier,
  isQuoteOnly,
  hasFreeTier,
  type Vertical,
  type Tool,
} from '../../lib/data';
import Byline from '../../components/Byline.astro';
import WrenchScore from '../../components/WrenchScore.astro';
import ToolLogo from '../../components/ToolLogo.astro';
import AffiliateDisclosure from '../../components/AffiliateDisclosure.astro';
import { reportBuyerCount } from '../../lib/reportLedger';

export async function getStaticPaths() {
  // A trade with no tools would publish an empty ranking and a "pricing verified"
  // date with nothing verified behind it, so it gets no page.
  return verticals.filter((v) => rankToolsForVertical(v.slug).length > 0).map((v) => ({
    params: { vertical: verticalToUrl(v.slug) },
    props: { vertical: v },
  }));
}

interface Props {
  vertical: Vertical;
}

const { vertical } = Astro.props;
const ranked: Tool[] = rankToolsForVertical(vertical.slug);
const reportBuyers = reportBuyerCount(ranked);

// Compute most recent verified date across tools shown
const verifiedDates = ranked.map(t => t.pricing.verified_date).filter(Boolean).sort();
// No build-date fallback (removed 2026-10-01): the Byline labels this date "Latest price
// check", so a build date there would read as a price check that never happened.
// getStaticPaths drops trades with no tools, so the build stops here only if none of a
// trade's tools carries a verified_date.
const lastVerifiedDate = verifiedDates[verifiedDates.length - 1];
if (!lastVerifiedDate) {
  throw new Error(`No pricing verified_date for any ${vertical.name} tool; refusing to publish a price-check date.`);
}

const topPicks = ranked.slice(0, 5);
// The Visit buttons render only in the topPicks cards; the disclosure beside them shows
// only when at least one of those buttons uses a tracked link.
const topPicksTracked = topPicks.some((t) => t.affiliate_url.startsWith('http'));
// Keep acronyms (HVAC) in capitals and use the singular trade name, so copy reads
// "HVAC software" and "general contractor software", not "hvac" or "general contractors software".
const verticalLower = vertical.name
  .split(' ')
  .map((w) => (/^[A-Z]{2,}$/.test(w) ? w : w.toLowerCase()))
  .join(' ')
  .replace(/^general contractors$/, 'general contractor');
// Singular forms, so a one-tool trade never reads "1 platforms" or "1 tools".
const plat = ranked.length === 1 ? 'platform' : 'platforms';
const toolsWord = ranked.length === 1 ? 'tool' : 'tools';

// Quotable, dated stats computed from THIS vertical's tools: the answer-first
// numbers AI assistants and journalists can lift with attribution. All derived
// live from the data, so they update with every verification pass.
const publicPrices = ranked
  .map((t) => t.pricing.starting_at_usd)
  .filter((p): p is number => p !== null && p > 0)
  .sort((a, b) => a - b);
// Shared helper rather than a fifth hand-rolled median. This copy happened to be
// correct, which is exactly how the last one survived long enough to publish $79.
// Rounded to whole dollars for display only (Math.round, half up). For an odd count
// medianUsd() returns the middle price itself, so on 2026-10-08 cleaning, handyman and
// appliance repair showed "$45.95/mo" (Markate) and waste removal "$79.95/mo"
// (Dumpster Rental Systems). Nothing on this page computes with the median.
const medianPrice = publicPrices.length ? Math.round(medianUsd(publicPrices)) : null;
// Quote-only = pricing_model 'quote_only'. A null starting price is not the test: two
// tools publish one-time or per-project prices instead of a monthly plan, and they are
// counted separately (otherPricing) rather than as hiding their price.
const hidePricingCount = ranked.filter(isQuoteOnly).length;
const otherPricing = ranked.filter((t) => t.pricing.starting_at_usd === null && !isQuoteOnly(t));
const qbCount = ranked.filter((t) => t.integrations.some((i) => i.includes('quickbooks'))).length;
// Verified dates are YYYY-MM-DD; format in UTC so a build in a US timezone does not
// print the 1st of a month as the previous month. Show the range of months, because
// a page's tools are not all verified in the same month.
const monthLabel = (d: string, withYear = true) =>
  new Date(d + 'T00:00:00Z').toLocaleDateString('en-US', withYear ? { month: 'long', year: 'numeric', timeZone: 'UTC' } : { month: 'long', timeZone: 'UTC' });
const firstVerifiedDate = verifiedDates[0] ?? lastVerifiedDate;
const lastVerifiedLabel = monthLabel(lastVerifiedDate);
const verifiedLabel = monthLabel(firstVerifiedDate) === lastVerifiedLabel
  ? lastVerifiedLabel
  : `${monthLabel(firstVerifiedDate, firstVerifiedDate.slice(0, 4) !== lastVerifiedDate.slice(0, 4))} to ${lastVerifiedLabel}`;
const showStatStrip = ranked.length >= 3;

// "Tightest budget" callout: the lowest starting price among tools with no free tier,
// naming every tool at that price. Tools with a free tier are left out because their
// paid tiers can cost less than this (busybusy Pro is $9.99), and every trade page
// has at least one free-tier tool, so no paid tool has "the lowest entry price".
const paidEntries = ranked.filter((t) => (t.pricing.starting_at_usd ?? 0) > 0);
const lowestPaid = paidEntries.length ? Math.min(...paidEntries.map((t) => t.pricing.starting_at_usd as number)) : null;
const budgetPicks = paidEntries.filter((t) => t.pricing.starting_at_usd === lowestPaid);

// "What it actually costs" pricing guide: buckets ranked tools by published
// entry price into honest bands (custom-quote tools surfaced separately). The
// most AI-citable answer to "how much does [trade] software cost", all derived
// live from verified pricing, so it can't go stale silently.
// Bands come from priceTier, which compares cost per user (flat plans split across a
// 5-person team). Until 2026-09-27 they used the starting price alone, so a $297/mo
// flat company plan was listed as Premium next to per-user plans.
const inTier = (tier: string) => ranked.filter((t) => priceTier(t) === tier);
const pricingBands = [
  { label: 'Free / freemium', range: '$0 to start', tools: inTier('free') },
  { label: 'Budget', range: 'under $100/user/mo', tools: inTier('entry') },
  { label: 'Mid-market', range: '$100-$249/user/mo', tools: inTier('mid') },
  { label: 'Premium', range: '$250+/user/mo', tools: inTier('enterprise') },
  // Published prices that are not a monthly plan (one-time license, per-project fee).
  { label: 'Other published pricing', range: 'not a monthly plan', tools: otherPricing },
  { label: 'Custom quote only', range: 'sales call required', tools: inTier('quote-only').filter(isQuoteOnly) },
].filter((b) => b.tools.length > 0);
const priceLo = publicPrices.length ? `$${publicPrices[0]}/mo` : null;
const priceHi = publicPrices.length ? `$${publicPrices[publicPrices.length - 1]}/mo` : null;
const showPricingGuide = ranked.length >= 4 && pricingBands.length >= 2;
const publishedPriceCount = ranked.filter((t) => t.pricing.starting_at_usd !== null).length;
const freeTierCount = ranked.filter(hasFreeTier).length;

// "How to choose" brackets, filled from this trade's ranking (2026-10-01). They
// used to name the same tools and plan prices on all 21 trade pages, including
// tools that do not serve the trade (Joist, Service Fusion, FieldEdge and BuildOps
// on /pest-control/). A tool belongs to every bracket its stated best team size
// range overlaps, so "1-30" counts as solo, growing and established. Bucketing by
// the top of the range told solo shops on seven pages that nothing fit, although
// 8 to 20 tools on each listed a range that includes 1-3 techs.
// Tools with no stated team size are left out, because their bracket is a guess.
const teamRange = (t: Tool): [number, number] | null => {
  const s = t.best_team_size ?? '';
  const plus = s.match(/^\s*(\d+)\s*\+\s*$/);
  if (plus) return [Number(plus[1]), Infinity];
  const m = s.match(/(\d+)-(\d+)/);
  return m ? [Number(m[1]), Number(m[2])] : null;
};
const sizeBracket = (heading: string, rule: string, lo: number, hi: number, advice: string) => {
  const fits = ranked.filter((t) => {
    const r = teamRange(t);
    return r !== null && r[0] <= hi && r[1] >= lo;
  });
  return { heading, rule, advice, total: fits.length, picks: fits.slice(0, 3) };
};
const sizeBrackets = [
  sizeBracket("If you're solo or have 1-3 techs", 'overlaps 1 to 3 techs', 1, 3,
    "Don't pay for enterprise features you won't touch."),
  sizeBracket('If you have 4-15 techs and are growing', 'overlaps 4 to 15 techs', 4, 15,
    'Check whether each plan is priced per user or per company, because that decides how the bill changes as you add techs.'),
  sizeBracket('If you have more than 15 techs', 'goes past 15 techs', 16, Infinity,
    'Get any quote in writing before you sign.'),
];

// Glossary: name only the tools on this page whose integrations list Google Local
// Services, instead of the old unsourced "Housecall Pro and Workiz lead here".
const glsTools = ranked.filter((t) => t.integrations.includes('google_local_services'));

// Phase 3 custom content flags: use deep content when present
const hasIndustryContext = !!vertical.industry_context;
const hasBuyingPersonas = !!vertical.buying_personas;
const hasFeaturePriorities = !!vertical.feature_priorities;
const hasRegulatoryNotes = !!vertical.regulatory_notes;
const hasSeasonality = !!vertical.seasonality;

// The templated fallback FAQs were deleted 2026-10-01. Every trade has its own
// vertical_faqs, so they never rendered, but they carried fixed plan prices,
// "best value" and "every major tool" claims that would have published verbatim
// on any trade added without FAQs. A trade without FAQs now gets only the
// ranking FAQ below.
const baseFaqs = vertical.vertical_faqs ?? [];

// Lead the FAQ (and its FAQPage schema) with the exact high-intent query plus
// a full ranked answer, the most AI-citable FAQ we can publish, and the only
// place the complete ranking lands in structured data. Skip if the curated set
// already answers the general "best … in 2026" form, to avoid a duplicate.
// Tools tied with #1 on both trade fit and Fit Score; the order among them is alphabetical,
// so the page must not present the first of them as a unique pick.
const topTied = ranked.length
  ? ranked.filter((t) => verticalFitScore(t, vertical.slug) === verticalFitScore(ranked[0], vertical.slug) && wrenchStackScore(t, vertical.slug) === wrenchStackScore(ranked[0], vertical.slug))
  : [];

const rankingFaq = {
  q: `What is the best ${verticalLower} software in 2026?`,
  a: `Ranked first by fit for the trade, with our independent WrenchStack Fit Score (vertical fit, pricing transparency and integration coverage) breaking ties and then name, the top of our 2026 ${verticalLower} software ranking is: ${ranked
    .slice(0, 8)
    .map((t, i) => `${i + 1}. ${t.name}`)
    .join('; ')}. ${topPicks[0]?.name ?? 'The top pick'} ${topTied.length > 1 ? `is listed first of ${topTied.length} tools tied on trade fit and Fit Score` : 'ranks first'}${topPicks[0] ? ` (${formatPrice(topPicks[0])})` : ''}, but the right choice depends on your team size and budget; see the decision guide on this page for size-specific picks.`,
};
const alreadyHasRankingFaq = baseFaqs.some((f) => /\bbest\b/i.test(f.q) && /2026/.test(f.q));
const faqs = alreadyHasRankingFaq ? baseFaqs : [rankingFaq, ...baseFaqs];

// Reading time, estimated from this page's own content (2026-10-01). It was a fixed
// readingTimeMinutes(4500), so all 21 pages said "20 min read" while their article text
// ran from about 3,200 to 5,300 words. The words each page draws from the data are
// counted here; TEMPLATE_WORDS approximates the fixed template prose (headings, guide
// text, glossary, labels), measured from the built pages on 2026-10-01, where it came
// to 1,650-1,800 words on every trade.
const TEMPLATE_WORDS = 1750;
const wc = (s?: string | null) => (s ?? '').split(/\s+/).filter(Boolean).length;
const pageWords = TEMPLATE_WORDS
  + [vertical.industry_context, vertical.buying_personas, vertical.feature_priorities, vertical.regulatory_notes, vertical.seasonality]
    .reduce((n, s) => n + wc(s), 0)
  + faqs.reduce((n, f) => n + wc(f.q) + wc(f.a), 0)
  + ranked.reduce((n, t) => n + wc(t.name) + wc(t.best_for) + wc(formatPrice(t)) + 2, 0)
  + topPicks.reduce((n, t) => n + wc(t.tagline) + wc(t.best_for) + wc(t.weaknesses)
    + t.key_features.slice(0, 6).length * 2 + t.integrations.length * 2, 0)
  + topPicks.slice(0, 4).reduce((n, t) => n + wc(t.best_for) + wc(t.weaknesses?.split(';')[0]), 0);
const estimatedReadingMin = readingTimeMinutes(pageWords);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const pageTitle = `Best ${vertical.name} Software 2026: Compared and Ranked`;
const pageDescription = `Compare ${ranked.length} ${verticalLower} software ${ranked.length === 1 ? 'option' : 'options'} for 2026, ranked by fit for the trade. Pricing verified ${verifiedLabel}.`;

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: pageTitle,
  itemListElement: topPicks.map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'SoftwareApplication',
      name: t.name,
      applicationCategory: 'BusinessApplication',
      url: `https://wrenchstack.com/tools/${t.slug}/`,
    },
  })),
};

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: vertical.name, url: `/${verticalToUrl(vertical.slug)}/` },
];
---

<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  <article class="mx-auto max-w-4xl px-4 py-12">
    <nav class="mb-6 text-sm text-slate-500">
      <a href="/" class="hover:text-slate-900">Home</a>
      <span class="mx-2">/</span>
      <span class="text-slate-900">{vertical.name}</span>
    </nav>

    <header class="mb-10">
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 md:text-5xl">
        Best {vertical.name} Software in 2026
      </h1>
      <p class="mt-4 text-lg text-slate-600">
        A comparison of {ranked.length} {plat} for {verticalLower} businesses, ranked by fit for the trade, then by Fit Score, then by name.
      </p>
      <Byline updatedDate={lastVerifiedDate} readingMinutes={estimatedReadingMin} />
    </header>

    {topPicks.length > 0 && (
      <section class="mb-10 rounded-lg border-l-4 border-orange-500 bg-orange-50/40 p-5">
        <p class="text-xs font-bold uppercase tracking-wider text-orange-600">The short answer</p>
        <p class="mt-2 text-slate-800 leading-relaxed">
          {topTied.length > 1 ? (<>For {verticalLower} businesses in 2026, {topTied.map((t, i) => (<>{i > 0 ? (i === topTied.length - 1 ? ' and ' : ', ') : ''}<a href={`/tools/${t.slug}/`} class="font-semibold text-orange-700 hover:underline">{t.name}</a></>))}{' '}tie at the top of our ranking on trade fit and Fit Score (ties are listed alphabetically). Picks are ordered by fit for the trade, then by our independent <a href="/methodology/" class="underline hover:text-orange-700">Fit Score</a> (vertical fit, pricing transparency and integration coverage), then by name, and no vendor pays for placement. Full ranking, pricing and trade-offs below.</>) : (<>
          For {verticalLower} businesses in 2026, <a href={`/tools/${topPicks[0].slug}/`} class="font-semibold text-orange-700 hover:underline">{topPicks[0].name}</a> is our top pick ({formatPrice(topPicks[0])}{topPicks[0].best_team_size ? `, best for ${topPicks[0].best_team_size} techs` : ''}){topPicks.length > 1 ? (<>, followed by {topPicks.slice(1, 3).map((t, i) => (<>{i > 0 ? ' and ' : ''}<a href={`/tools/${t.slug}/`} class="font-semibold text-orange-700 hover:underline">{t.name}</a></>))}</>) : null}. Picks are ordered by fit for the trade, then by our independent <a href="/methodology/" class="underline hover:text-orange-700">Fit Score</a> (vertical fit, pricing transparency and integration coverage), then by name, and no vendor pays for placement. Full ranking, pricing and trade-offs below.</>)}
        </p>
      </section>
    )}

    {showStatStrip && (
      <section class="mb-10 rounded-lg border border-orange-200 bg-orange-50/60 p-5">
        <div class="grid gap-3 grid-cols-2 sm:grid-cols-4">
          <div class="text-center">
            <div class="text-2xl font-bold text-slate-900">{ranked.length}</div>
            <div class="mt-1 text-xs text-slate-600">{verticalLower} {plat} compared</div>
          </div>
          {medianPrice !== null && (
            <div class="text-center">
              <div class="text-2xl font-bold text-slate-900">${medianPrice}/mo</div>
              <div class="mt-1 text-xs text-slate-600">median paid entry price (published tiers)</div>
            </div>
          )}
          <div class="text-center">
            <div class="text-2xl font-bold text-slate-900">{hidePricingCount} of {ranked.length}</div>
            <div class="mt-1 text-xs text-slate-600">hide pricing behind a sales call</div>
          </div>
          <div class="text-center">
            <div class="text-2xl font-bold text-slate-900">{Math.round((qbCount / ranked.length) * 100)}%</div>
            <div class="mt-1 text-xs text-slate-600">integrate with QuickBooks</div>
          </div>
        </div>
        <p class="mt-3 text-center text-xs text-slate-500">
          WrenchStack analysis of {ranked.length} {verticalLower} {plat} · pricing verified {verifiedLabel} · free to cite with attribution
        </p>
      </section>
    )}

    <nav class="mb-8 rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 md:sticky md:top-2 md:z-30 md:bg-white/95 md:backdrop-blur">
      <div class="text-xs font-semibold uppercase tracking-wider text-slate-700">On this page</div>
      <div class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-sm">
        <a href="#top-picks" class="text-orange-600 hover:underline">Top picks</a>
        <span class="text-slate-300">·</span>
        <a href="#which-to-choose" class="text-orange-600 hover:underline">Which to choose</a>
        <span class="text-slate-300">·</span>
        <a href="#pricing" class="text-orange-600 hover:underline">Pricing</a>
        <span class="text-slate-300">·</span>
        <a href="#reviews" class="text-orange-600 hover:underline">Reviews</a>
        <span class="text-slate-300">·</span>
        <a href="#how-to-choose" class="text-orange-600 hover:underline">How to choose</a>
        <span class="text-slate-300">·</span>
        <a href="#faqs" class="text-orange-600 hover:underline">FAQ</a>
      </div>
    </nav>

    <section class="mb-12">
      <h2 id="top-picks" class="mb-4 scroll-mt-20 text-2xl font-bold text-slate-900">Top picks at a glance</h2>
      <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
        <table class="w-full text-sm">
          <thead class="bg-slate-50 text-left text-slate-700">
            <tr>
              <th class="p-3 font-semibold">#</th>
              <th class="p-3 font-semibold">Tool</th>
              <th class="p-3 font-semibold whitespace-nowrap">Trade fit</th>
              <th class="p-3 font-semibold">Score</th>
              <th class="p-3 font-semibold">Starting price</th>
              <th class="p-3 font-semibold">Best for</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {topPicks.map((t, i) => {
              const score = wrenchStackScore(t, vertical.slug);
              return (
                <tr class="hover:bg-slate-50">
                  <td class="p-3 font-bold text-slate-900">#{i + 1}</td>
                  <td class="p-3">
                    <a href={`/tools/${t.slug}/`} class="flex items-center gap-3 hover:text-orange-600">
                      <ToolLogo tool={t} size={32} />
                      <span class="font-semibold text-slate-900">{t.name}</span>
                    </a>
                    {verticalFitScore(t, vertical.slug) === verticalFitScore(topPicks[0], vertical.slug) && (
                      <div class="ml-11 mt-1">
                        <span class="inline-block rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-emerald-800">Highest trade fit</span>
                      </div>
                    )}
                  </td>
                  <td class="p-3 whitespace-nowrap text-slate-700">{verticalFitScore(t, vertical.slug)}/10</td>
                  <td class="p-3">
                    <WrenchScore score={score} size="sm" />
                  </td>
                  <td class="p-3 text-slate-700">{formatPrice(t)}</td>
                  <td class="p-3 text-slate-600">{t.best_team_size ?? '-'} techs</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <p class="mt-2 text-xs text-slate-500">
        Order: trade fit first, then Score, then name. Score combines vertical fit (60%), pricing transparency (20%), and integration coverage (20%).
        <a href="/methodology/" class="underline hover:text-slate-700">Full methodology →</a>
      </p>
    </section>

    {topPicks.length >= 2 && (
      <section class="mb-12">
        <h2 id="which-to-choose" class="mb-1 scroll-mt-20 text-2xl font-bold text-slate-900">Which {verticalLower} software should you choose?</h2>
        <p class="mb-5 text-sm text-slate-600">The top {['', 'one', 'two', 'three', 'four'][Math.min(4, topPicks.length)]} picks in brief; full reasoning in the reviews below.</p>
        <div class="space-y-3">
          {topPicks.slice(0, 4).map((t) => {
            const watch = t.weaknesses ? t.weaknesses.split(';')[0].trim() : null;
            return (
              <div class="rounded-lg border border-slate-200 bg-white p-4 sm:flex sm:items-baseline sm:gap-4">
                <div class="mb-1 shrink-0 sm:mb-0 sm:w-48">
                  <a href={`/tools/${t.slug}/`} class="font-bold text-slate-900 hover:text-orange-600">{t.name}</a>
                  <div class="text-xs text-slate-500">{formatPrice(t)}{t.best_team_size ? ` · ${t.best_team_size} techs` : ''}</div>
                </div>
                <div class="text-sm leading-relaxed text-slate-700">
                  <span class="font-semibold text-slate-900">Best for:</span> {asSentence(t.best_for)}
                  {watch && (<><br /><span class="text-slate-500"><span class="font-semibold text-slate-600">Watch-out:</span> {asSentence(watch)}</span></>)}
                </div>
              </div>
            );
          })}
          {budgetPicks.length > 0 && (
            <div class="rounded-lg border border-dashed border-slate-300 bg-slate-50 p-4 text-sm text-slate-700">
              <span class="font-semibold text-slate-900">Tightest budget:</span>{' '}{budgetPicks.map((t, i) => (<>{i > 0 ? (i === budgetPicks.length - 1 ? ' and ' : ', ') : ''}<a href={`/tools/${t.slug}/`} class="font-semibold text-orange-700 hover:underline">{t.name}</a></>))}{' '}{budgetPicks.length === 1 ? 'has' : 'share'} the lowest monthly starting price among tools with no free tier: {formatPrice(budgetPicks[0])}.{freeTierCount > 0 ? ` ${freeTierCount} ${freeTierCount === 1 ? 'tool' : 'tools'} on this page ${freeTierCount === 1 ? 'lists' : 'list'} a free tier.` : ''}
            </div>
          )}
        </div>
      </section>
    )}

    {showPricingGuide && (
      <section class="mb-12">
        <h2 id="pricing" class="mb-1 scroll-mt-20 text-2xl font-bold text-slate-900">What does {verticalLower} software actually cost?</h2>
        <p class="mb-5 text-sm text-slate-600 leading-relaxed">
          {priceLo && priceHi && (<>Across the {ranked.length}{' '}{plat} we track, {freeTierCount > 0 ? <>{freeTierCount}{' '}{freeTierCount === 1 ? 'offers' : 'offer'} a free tier and the other</> : 'the'}{' '}published monthly starting prices run from {priceLo} to {priceHi}{medianPrice !== null ? <>, with a median of ${medianPrice}/mo</> : null}. </>)}
          {hidePricingCount > 0 && (<>{hidePricingCount} of {ranked.length}{' '}{hidePricingCount === 1 ? 'publishes' : 'publish'} no price and {hidePricingCount === 1 ? 'quotes' : 'quote'} only on a sales call. </>)}
