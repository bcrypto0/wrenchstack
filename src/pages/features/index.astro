---
import Layout from '../../layouts/Layout.astro';
import featuresData from '../../data/features.json';
import { tools } from '../../lib/data';

interface FeatureData {
  name: string;
  definition: string;
  description: string;
  why_matters: string;
  buying_tips: string;
  related_features: string[];
  best_for_verticals: string[];
  faqs: { q: string; a: string }[];
}

const features = (featuresData as { features: Record<string, FeatureData> }).features;

function featureToUrl(slug: string): string {
  return slug.replace(/_/g, '-');
}

// Build list with tool count per feature: tools that name the feature (or one of its
// other names below) among their key features, and for QuickBooks also tools whose
// integrations list it (the rule the feature pages use; 9 tools name
// "quickbooks_integration" as a key feature, 97 list a QuickBooks integration).
// Keep FEATURE_ALIASES in step with pages/features/[feature]/index.astro (2026-10-01:
// AI Receptionist and Automated Marketing showed 0 tools without them).
const FEATURE_ALIASES: Record<string, string[]> = {
  ai_receptionist: ['ai_phone_agent'],
  automated_marketing: ['marketing_automation'],
  customer_portal: ['client_portal'],
  phone_system: ['voip_phone'],
};
const featureList = Object.entries(features).map(([slug, data]) => {
  const aliases = FEATURE_ALIASES[slug] ?? [];
  const toolCount = tools.filter((t) =>
    t.key_features.includes(slug)
    || aliases.some((a) => t.key_features.includes(a))
    || (slug === 'quickbooks_integration' && t.integrations.some((i) => i.includes('quickbooks')))
  ).length;
  return { slug, data, toolCount };
});

// Group features by how many tools list them: 10 or more, 3 to 9, fewer than 3. The
// groups were headed "Common", "Specialty" and "Niche" until 2026-10-01, with copy
// calling the first "table-stakes" on "most major FSM platforms" (10 is 8% of the
// directory) and saying how buyers use the others. Key-feature names are not
// standardised, so a low count can mean a feature is named differently.
const common = featureList.filter((f) => f.toolCount >= 10);
const specialty = featureList.filter((f) => f.toolCount >= 3 && f.toolCount < 10);
const niche = featureList.filter((f) => f.toolCount < 3);

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Features', url: '/features/' },
];

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Trades software features',
  itemListElement: featureList.map((f, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: f.data.name,
    url: `https://wrenchstack.com/features/${featureToUrl(f.slug)}/`,
  })),
};
---

<Layout
  title="Trades software features: browse by capability"
  description={`${featureList.length} trades software features, each with a page listing which of the ${tools.length} tools we list name it among their key features, with starting prices.`}
  breadcrumbs={breadcrumbs}
>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  <article class="mx-auto max-w-5xl px-4 py-12">

    <header class="mb-10">
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 md:text-5xl">
        Browse trades software by feature
      </h1>
      <p class="mt-4 text-lg text-slate-600">
        {`${featureList.length} features, each with a page listing which of the ${tools.length} tools we list name it among their key features. Key-feature names are not standardised across tools, so a tool can offer a feature without being counted under it; check its review.`}
      </p>
    </header>

    <section class="mb-12">
      <h2 class="mb-4 text-2xl font-bold text-slate-900">{`Listed by 10 or more tools (${common.length})`}</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {common.map(({ slug, data, toolCount }) => (
          <a
            href={`/features/${featureToUrl(slug)}/`}
            class="group rounded-lg border border-slate-200 bg-white p-5 hover:border-orange-400"
          >
            <div class="mb-1 flex items-start justify-between gap-2">
              <h3 class="font-bold text-slate-900 group-hover:text-orange-600">{data.name}</h3>
              <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-medium text-emerald-700 shrink-0">{`${toolCount} ${toolCount === 1 ? 'tool' : 'tools'}`}</span>
            </div>
            <p class="text-sm text-slate-600 leading-snug">{data.definition}</p>
          </a>
        ))}
      </div>
    </section>

    {specialty.length > 0 && (
      <section class="mb-12">
        <h2 class="mb-4 text-2xl font-bold text-slate-900">{`Listed by 3 to 9 tools (${specialty.length})`}</h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {specialty.map(({ slug, data, toolCount }) => (
            <a
              href={`/features/${featureToUrl(slug)}/`}
              class="group rounded-lg border border-slate-200 bg-white p-5 hover:border-orange-400"
            >
              <div class="mb-1 flex items-start justify-between gap-2">
                <h3 class="font-bold text-slate-900 group-hover:text-orange-600">{data.name}</h3>
                <span class="rounded-full bg-blue-100 px-2 py-0.5 text-xs font-medium text-blue-700 shrink-0">{`${toolCount} ${toolCount === 1 ? 'tool' : 'tools'}`}</span>
              </div>
              <p class="text-sm text-slate-600 leading-snug">{data.definition}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    {niche.length > 0 && (
      <section class="mb-12">
        <h2 class="mb-4 text-2xl font-bold text-slate-900">{`Listed by fewer than 3 tools (${niche.length})`}</h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {niche.map(({ slug, data, toolCount }) => (
            <a
              href={`/features/${featureToUrl(slug)}/`}
              class="group rounded-lg border border-slate-200 bg-white p-5 hover:border-orange-400"
            >
              <div class="mb-1 flex items-start justify-between gap-2">
                <h3 class="font-bold text-slate-900 group-hover:text-orange-600">{data.name}</h3>
                <span class="rounded-full bg-slate-200 px-2 py-0.5 text-xs font-medium text-slate-700 shrink-0">{`${toolCount} ${toolCount === 1 ? 'tool' : 'tools'}`}</span>
              </div>
              <p class="text-sm text-slate-600 leading-snug">{data.definition}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="mb-12 rounded-lg bg-slate-50 p-8">
      <h2 class="mb-4 text-2xl font-bold text-slate-900">How to use this index</h2>
      <div class="prose prose-slate max-w-none">
        <p>
          Each feature page lists the tools in our directory that name that feature, or another name for it that the page states, among their key features (for QuickBooks, also the tools whose integrations list it). Use it when you have a must-have feature (QuickBooks integration, AI dispatcher, consumer financing), then confirm the feature on each tool's review and the vendor's site.
        </p>
        <p>
          For shops still scoping requirements, start with the <a href="/quiz/">matching quiz</a>: answer 5 questions, get 3 ranked picks. For comparing two specific tools head-to-head, see our <a href="/compare/">comparison directory</a>.
        </p>
      </div>
    </section>
  </article>
</Layout>
