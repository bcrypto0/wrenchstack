---
import Layout from '../layouts/Layout.astro';
import { tools, priceTier, isQuoteOnly, getTool } from '../lib/data';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Cost of switch calculator', url: '/cost-of-switch/' },
];

// Tool data passed to client-side JS. Strip down to the fields the
// calculator actually needs to keep the payload small.
const calculatorTools = tools.map((t) => ({
  slug: t.slug,
  name: t.name,
  startingPrice: t.pricing.starting_at_usd,
  tier: priceTier(t),
  pricingNote: t.pricing.pricing_note ?? '',
  pricingModel: t.pricing.pricing_model ?? '',
  bestTeamSize: t.best_team_size ?? '',
  // Quote-only = isQuoteOnly. Two tools with no monthly starting price (module or
  // per-project prices) are not quote-only and get their own message.
  quoteOnly: isQuoteOnly(t),
}));

const listJoin = (names: string[]) =>
  names.length <= 1 ? (names[0] ?? '') : `${names.slice(0, -1).join(', ')} and ${names[names.length - 1]}`;

// Named examples in the pricing-model FAQ are checked against pricing_model at build
// (2026-10-01): Service Fusion's note says unlimited users at every tier; Jobber, Housecall
// Pro and JobTread include a set number of users per plan. A tool whose model changes
// drops out of the sentence instead of being misdescribed.
const flatExamples = ['servicefusion']
  .map((s) => getTool(s))
  .filter((t): t is NonNullable<typeof t> => !!t && t.pricing.pricing_model === 'flat')
  .map((t) => t.name);
const seatExamples = ['jobber', 'housecall-pro', 'jobtread']
  .map((s) => getTool(s))
  .filter((t): t is NonNullable<typeof t> => !!t && t.pricing.pricing_model === 'flat_plus_seat')
  .map((t) => t.name);
const flatModelAnswer = [
  `Flat-rate plans charge one price per company${flatExamples.length ? ` (${listJoin(flatExamples)}, for example, lists unlimited users on every plan)` : ''}, so the calculator does not multiply them by team size.`,
  `Base-plus-seat plans include a set number of users and cost more as you add users${seatExamples.length ? ` (${listJoin(seatExamples)}, for example)` : ''}; the calculator shows them at the base price, with a note.`,
  "The calculator reads each tool's pricing model (per user, flat, or base plus seats) from our data and multiplies only per-user prices by team size. If a vendor has changed its pricing since we last checked it, the math will be wrong; enter your real monthly cost in the override fields.",
].join(' ');

const faqs = [
  {
    q: 'Does the calculator include an implementation fee?',
    a: 'The calculator does not assume an implementation fee. Vendors differ too much: some include onboarding in the subscription, some charge for guided setup, and quote-only vendors set the fee in the quote. Enter the fee from your quote; until you do, the totals and break-even exclude it and say so. A tool that publishes no monthly price also needs a monthly figure from you: your current bill or the cost you were quoted.',
  },
  {
    q: 'Why include a parallel-run month?',
    a: 'Running both systems for a while lets you check jobs, customers and invoices in the new tool before you cancel the old one. The calculator assumes one month of your current subscription on top of the new one; that is our assumption, not a measured figure. If you plan a same-day cutover, subtract one month of your current bill from the total.',
  },
  {
    q: 'What does "training cost" actually include?',
    a: 'It is the wage cost of techs and office staff while they learn the new tool. The calculator assumes 8 hours per tech at $50 an hour (wages plus employer costs), plus 60 hours of office-staff transition work at $35 an hour. These are our planning assumptions, not survey results; scale the result up or down if your hours or wages differ. It is separate from the implementation fee, which is what the vendor charges you.',
  },
  {
    q: 'How accurate is the break-even calculation?',
    a: 'It is a rough estimate, not a P&L line. The calculator divides the total switching cost by the monthly savings (or shows "never on price alone" if the new tool costs the same or more). Real break-even depends on how fast your team adopts the tool, integration delays, and whether recovered admin time turns into billable work. Because it applies the same assumptions to every pair of tools, it is more useful for comparing two switch options than for a precise business case; for that, use your own spreadsheet with your quotes.',
  },
  {
    q: 'What if the new tool costs more per month?',
    a: 'The calculator shows a monthly premium instead of savings, and break-even "never on price alone": the switch has to pay back through something other than the subscription price, such as features you need, time saved or more jobs. Pair this calculator with the ROI calculator to estimate that side from its stated assumptions.',
  },
  {
    q: 'Why is a flat-rate plan not multiplied by team size?',
    a: flatModelAnswer,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="Cost of switch calculator: what does switching field service software actually cost?"
  description="Switching field service software can cost more than the new subscription. Pick your current tool, target tool and team size to estimate the 12-month cost of switching, with every assumption stated."
  breadcrumbs={breadcrumbs}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <article class="mx-auto max-w-4xl px-4 py-12">
    <header class="mb-10">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-orange-600">
        Free · live calculation · no email required
      </p>
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 md:text-5xl">
        Cost of switching field service software
      </h1>
      <p class="mt-4 text-lg text-slate-600">
        Switching field service software can cost more than the new subscription: an implementation fee if the vendor charges one, staff time to learn the new tool, and any overlap month of paying for both tools while you check the new one. Pick your current tool, target tool and team size to estimate the 12-month total. Prices come from each vendor's published starting price; training time and the overlap month are our stated assumptions, listed below.
      </p>
    </header>

    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm md:p-10">
      <form id="cos-form" class="space-y-6">
        <div class="grid gap-6 md:grid-cols-2">
          <div>
            <label for="from-tool" class="mb-2 block text-sm font-semibold text-slate-900">
              Current tool (switching FROM)
            </label>
            <select
              id="from-tool"
              class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-orange-500 focus:outline-none focus:ring-1 focus:ring-orange-500"
            >
              <option value="">Select your current tool</option>
              {calculatorTools.map((t) => (
                <option value={t.slug}>{t.name}</option>
              ))}
            </select>
          </div>

          <div>
            <label for="to-tool" class="mb-2 block text-sm font-semibold text-slate-900">
              Target tool (switching TO)
            </label>
            <select
              id="to-tool"
              class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-orange-500 focus:outline-none focus:ring-1 focus:ring-orange-500"
            >
              <option value="">Select target tool</option>
              {calculatorTools.map((t) => (
                <option value={t.slug}>{t.name}</option>
              ))}
            </select>
          </div>
        </div>

        <div class="grid gap-6 md:grid-cols-2">
          <div>
            <label for="techs" class="mb-2 block text-sm font-semibold text-slate-900">
              Number of techs
            </label>
            <input
              id="techs"
              type="number"
              value="5"
              min="1"
              max="500"
              class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-orange-500 focus:outline-none focus:ring-1 focus:ring-orange-500"
            />
          </div>
          <div>
            <label for="current-cost" class="mb-2 block text-sm font-semibold text-slate-900">
              Current monthly cost ($)
            </label>
            <input
              id="current-cost"
              type="number"
              placeholder="auto"
              min="0"
              class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-orange-500 focus:outline-none focus:ring-1 focus:ring-orange-500"
            />
            <p class="mt-1 text-xs text-slate-500">Override if your actual bill differs from published pricing. Required if your current tool publishes no monthly price.</p>
          </div>
          <div>
            <label for="target-cost" class="mb-2 block text-sm font-semibold text-slate-900">
              Quoted monthly cost for the new tool ($)
            </label>
            <input
              id="target-cost"
              type="number"
              placeholder="auto"
              min="0"
              class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-orange-500 focus:outline-none focus:ring-1 focus:ring-orange-500"
            />
            <p class="mt-1 text-xs text-slate-500">Required if the new tool publishes no monthly price; enter the monthly cost you were quoted.</p>
          </div>
          <div>
            <label for="impl-fee" class="mb-2 block text-sm font-semibold text-slate-900">
              Target implementation fee ($)
            </label>
            <input
              id="impl-fee"
              type="number"
              placeholder="not entered"
              min="0"
              class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-orange-500 focus:outline-none focus:ring-1 focus:ring-orange-500"
            />
            <p class="mt-1 text-xs text-slate-500">Enter the fee from your quote; totals exclude it until you do.</p>
          </div>
        </div>
      </form>

      <div id="cos-output" class="mt-8 hidden">
        <!-- populated by JS -->
      </div>

      <div id="cos-prompt" class="mt-8 rounded-md bg-slate-50 p-6 text-center text-sm text-slate-500">
        Pick a current tool and a target tool above to calculate.
      </div>
    </div>

    <section class="mt-12 prose prose-slate max-w-none">
      <h2>What the calculator includes</h2>

      <p>
        Switching field service software is not just "cancel the old subscription, start the new one." Real cost components include:
      </p>

      <ul>
        <li><strong>New subscription cost</strong> for the target tool, scaled by team size if per-user; plans with a base price plus seat fees are shown at the base price, with a note.</li>
        <li><strong>Implementation fee</strong>: what the vendor charges to set up your account. Enter it from your quote; the calculator does not guess one, and totals exclude it until you do.</li>
        <li><strong>Training cost</strong>: wages of techs and office staff while they learn the new tool. Assumption: 8 hours per tech at $50 an hour (wages plus employer costs), plus 60 office-staff hours at $35 an hour. These are planning assumptions, not measured figures.</li>
        <li><strong>Parallel-run cost</strong>: one extra month of your current subscription while both systems run, so you can check the new one before cancelling. One month is our assumption.</li>
        <li><strong>Net monthly savings</strong> (or premium): the recurring difference between old and new subscription, post-cutover.</li>
        <li><strong>Break-even month</strong>: when monthly savings cover the total switching cost. Shows "never on price alone" if the new tool costs the same or more.</li>
      </ul>

      <h2>What the calculator does not include</h2>

      <ul>
        <li><strong>Revenue uplift</strong> from better dispatching, faster quoting, or improved customer experience. Use the <a href="/roi-calculator/">ROI calculator</a> for the revenue side.</li>
        <li><strong>Integration migration costs</strong> if you need to rebuild custom integrations.</li>
        <li><strong>Data migration consulting</strong> if you're hiring help to move from one system to another.</li>
        <li><strong>Productivity lost</strong> while staff learn the new system.</li>
      </ul>

      <p>
        The subscription figures here come from published prices; the ROI calculator's revenue figures rest on planning assumptions, so treat them as the less certain of the two.
      </p>
    </section>

    <section class="mt-12">
      <h2 class="mb-6 text-2xl font-bold tracking-tight text-slate-900">FAQ</h2>
      <div class="space-y-4">
        {faqs.map((f) => (
          <details class="rounded-lg border border-slate-200 bg-white p-4">
            <summary class="cursor-pointer font-semibold text-slate-900">{f.q}</summary>
            <p class="mt-3 text-slate-700 leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mt-12 rounded-lg bg-slate-50 p-6 text-sm text-slate-600">
      <p>
        Need to evaluate the new tool's fit first? Take the
        <a href="/quiz/" class="text-orange-600 hover:underline">5-question matching quiz</a>
        for ranked picks, or run the
        <a href="/roi-calculator/" class="text-orange-600 hover:underline">ROI calculator</a>
        to estimate revenue uplift from its stated assumptions.
      </p>
    </section>
  </article>

  <script define:vars={{ toolData: calculatorTools }}>
    const tools = toolData;
    const fromSelect = document.getElementById('from-tool');
    const toSelect = document.getElementById('to-tool');
    const techsInput = document.getElementById('techs');
    const currentCostInput = document.getElementById('current-cost');
    const targetCostInput = document.getElementById('target-cost');
    const implFeeInput = document.getElementById('impl-fee');
    const outputDiv = document.getElementById('cos-output');
    const promptDiv = document.getElementById('cos-prompt');

    // No implementation-fee defaults: vendors differ too much (some include
    // onboarding, some charge, quote-only vendors set it in the quote), so the
    // user enters it and totals say when it is missing.
    const TRAINING_HOURS_PER_TECH = 8;
    const TECH_RATE_PER_HOUR = 50;
    const OFFICE_HOURS = 60;
    const OFFICE_RATE_PER_HOUR = 35;

    // Pre-fill from URL params: ?from=jobber&to=servicetitan
    const params = new URLSearchParams(window.location.search);
    const fromParam = params.get('from');
    const toParam = params.get('to');
    if (fromParam && tools.some((t) => t.slug === fromParam)) fromSelect.value = fromParam;
    if (toParam && tools.some((t) => t.slug === toParam)) toSelect.value = toParam;

    function findTool(slug) {
      return tools.find((t) => t.slug === slug);
    }

    function isFlatRate(t) {
      // From pricing_model (2026-09-10).
      return t.pricingModel === 'flat';
    }

    function isBasePlusSeat(t) {
      // Base price with some seats included plus a per-seat fee. The included-seat
      // count and seat fee aren't stored as data, so these are costed at the base
      // and the result shows a caveat rather than a made-up per-head figure.
      return t.pricingModel === 'flat_plus_seat';
    }

    function monthlyCostOf(t, techs) {
      if (t.startingPrice === null || t.startingPrice === undefined) {
        // No published monthly price: the user has to supply one; we do not invent it.
        return null;
      }
      if (t.startingPrice === 0) return 0;
      if (isFlatRate(t) || isBasePlusSeat(t)) return t.startingPrice;
      return t.startingPrice * techs;
    }

    function formatCurrency(n) {
      return '$' + Math.round(n).toLocaleString('en-US');
    }

    function calculate() {
      const fromSlug = fromSelect.value;
      const toSlug = toSelect.value;
      if (!fromSlug || !toSlug) {
        outputDiv.classList.add('hidden');
        promptDiv.classList.remove('hidden');
        return;
      }
      if (fromSlug === toSlug) {
        outputDiv.classList.remove('hidden');
        promptDiv.classList.add('hidden');
        outputDiv.innerHTML = '<div class="rounded-md border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">You picked the same tool for both. Please choose different current and target tools.</div>';
        return;
      }

      const fromTool = findTool(fromSlug);
      const toTool = findTool(toSlug);
      const techsRaw = parseInt(techsInput.value, 10);
      const techs = Number.isNaN(techsRaw) ? 5 : Math.max(1, techsRaw);

      const fromEntered = parseInt(currentCostInput.value, 10);
      const toEntered = parseInt(targetCostInput.value, 10);
      const fromMonthly = !isNaN(fromEntered) && fromEntered >= 0 ? fromEntered : monthlyCostOf(fromTool, techs);
      const toMonthly = !isNaN(toEntered) && toEntered >= 0 ? toEntered : monthlyCostOf(toTool, techs);
      if (fromMonthly === null || toMonthly === null) {
        const missing = [];
        const noPrice = (t) => t.quoteOnly ? t.name + ' publishes no price.' : t.name + ' publishes no monthly plan (see its pricing note for module or per-project prices).';
        if (fromMonthly === null) missing.push(noPrice(fromTool) + ' Enter your current monthly bill.');
        if (toMonthly === null) missing.push(noPrice(toTool) + ' Enter the monthly cost you were quoted.');
        outputDiv.classList.remove('hidden');
        promptDiv.classList.add('hidden');
        outputDiv.innerHTML = '<div class="rounded-md border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">' + missing.join(' ') + ' We do not estimate a monthly price the vendor does not publish.</div>';
        return;
      }

      const implFee = parseInt(implFeeInput.value, 10);
      const implKnown = !isNaN(implFee) && implFee >= 0;
      const targetImplFee = implKnown ? implFee : 0;
      const exclNote = implKnown ? '' : ' (excluding the implementation fee you have not entered)';

      const trainingCost = techs * TRAINING_HOURS_PER_TECH * TECH_RATE_PER_HOUR + OFFICE_HOURS * OFFICE_RATE_PER_HOUR;
      const parallelRunCost = fromMonthly; // one extra month of source subscription

      const totalSwitchingCost = targetImplFee + trainingCost + parallelRunCost;
      const monthlySavings = fromMonthly - toMonthly;
      const annualDelta = monthlySavings * 12;

      const fromTCO12 = fromMonthly * 12;
      const toTCO12 = toMonthly * 12 + totalSwitchingCost;
      const netDelta12 = toTCO12 - fromTCO12;

      const seatTools = [...new Set([...(!isNaN(toEntered) && toEntered >= 0 ? [] : [toTool]), ...(!isNaN(fromEntered) && fromEntered >= 0 ? [] : [fromTool])])].filter(isBasePlusSeat);
      const seatNote = seatTools.length
        ? `<p class="mb-6 rounded-lg border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900">${seatTools.map((t) => t.name).join(' and ')} ${seatTools.length === 1 ? 'charges' : 'charge'} a base price that includes some users, plus a fee for each extra seat. This estimate uses the base price only, so the real monthly cost is higher for larger teams; check the pricing note on the tool page.</p>`
        : '';
      // A $0 starting price is the free plan, which has its own user, job or feature limits.
      const freeTools = [...new Set([...(!isNaN(toEntered) && toEntered >= 0 ? [] : [toTool]), ...(!isNaN(fromEntered) && fromEntered >= 0 ? [] : [fromTool])])].filter((t) => t.startingPrice === 0);
      const freeNote = freeTools.length
        ? `<p class="mb-6 rounded-lg border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900">${freeTools.map((t) => t.name).join(' and ')} ${freeTools.length === 1 ? 'is' : 'are'} costed at $0, the free plan. Check the free plan's limits in the pricing note on the tool page; if your team needs a paid plan, enter its monthly price above.</p>`
        : '';

      let breakEvenLabel;
      if (monthlySavings <= 0) {
        breakEvenLabel = 'Never on price alone: new tool costs the same or more';
      } else {
        const months = Math.ceil(totalSwitchingCost / monthlySavings);
        if (months > 60) breakEvenLabel = months + ' months (over 5 years)';
        else breakEvenLabel = months + ' month' + (months === 1 ? '' : 's');
      }
      if (monthlySavings > 0) breakEvenLabel += exclNote;

      let recommendation;
      let recommendationStyle;
      if (monthlySavings > 0 && totalSwitchingCost / monthlySavings <= 18) {
        recommendation = 'On these inputs, switching pays back within 18 months from subscription savings alone.';
        recommendationStyle = 'border-emerald-200 bg-emerald-50 text-emerald-900';
      } else if (monthlySavings > 0) {
        recommendation = 'On these inputs, switching saves money each month, but break-even takes over 18 months. Weigh the other reasons for switching (the ROI calculator estimates the revenue side) before committing.';
        recommendationStyle = 'border-amber-200 bg-amber-50 text-amber-900';
      } else if (monthlySavings === 0) {
        recommendation = 'No monthly savings: the new tool costs the same. The case for switching rests on features or fit; the ROI calculator estimates the revenue side.';
        recommendationStyle = 'border-amber-200 bg-amber-50 text-amber-900';
      } else {
        const premium = -monthlySavings;
        recommendation = 'The new tool costs ' + formatCurrency(premium) + '/mo more. The switch pays back only if something else, such as revenue or time saved, covers the premium; the ROI calculator estimates the revenue side.';
        recommendationStyle = 'border-rose-200 bg-rose-50 text-rose-900';
      }

      if (!implKnown && monthlySavings > 0) recommendation = 'Excluding the implementation fee you have not entered: ' + recommendation.charAt(0).toLowerCase() + recommendation.slice(1);

      outputDiv.classList.remove('hidden');
      promptDiv.classList.add('hidden');

      outputDiv.innerHTML = `
        <h2 class="mb-4 text-2xl font-bold text-slate-900">Your switching cost: ${fromTool.name} → ${toTool.name}</h2>
        <p class="mb-6 text-sm text-slate-500">At ${techs} tech${techs === 1 ? '' : 's'}.</p>
        ${seatNote}
        ${freeNote}

        <div class="grid gap-4 sm:grid-cols-2">
          <div class="rounded-lg border border-slate-200 bg-white p-4">
            <div class="text-xs font-semibold uppercase tracking-wider text-slate-500">${fromTool.name} 12-mo cost</div>
            <div class="mt-2 text-2xl font-bold text-slate-900">${formatCurrency(fromTCO12)}</div>
            <div class="mt-1 text-xs text-slate-500">${formatCurrency(fromMonthly)}/mo × 12 months</div>
          </div>
          <div class="rounded-lg border ${netDelta12 > 0 ? 'border-rose-200 bg-rose-50' : 'border-emerald-200 bg-emerald-50'} p-4">
            <div class="text-xs font-semibold uppercase tracking-wider ${netDelta12 > 0 ? 'text-rose-700' : 'text-emerald-700'}">${toTool.name} 12-mo total${implKnown ? '' : ' (excl. implementation fee)'}</div>
            <div class="mt-2 text-2xl font-bold ${netDelta12 > 0 ? 'text-rose-900' : 'text-emerald-900'}">${formatCurrency(toTCO12)}</div>
            <div class="mt-1 text-xs ${netDelta12 > 0 ? 'text-rose-700' : 'text-emerald-700'}">${formatCurrency(toMonthly)}/mo × 12 + ${formatCurrency(totalSwitchingCost)} switching cost</div>
          </div>
        </div>

        <div class="mt-6 rounded-lg border ${recommendationStyle} p-4 text-sm">
          <strong class="block mb-1">Net 12-month difference: ${formatCurrency(Math.abs(netDelta12))} ${netDelta12 > 0 ? 'more' : 'less'}</strong>
          ${recommendation}
        </div>

        <h3 class="mt-8 mb-3 text-lg font-bold text-slate-900">Switching cost breakdown</h3>
        <table class="w-full text-sm">
          <tbody class="divide-y divide-slate-100">
            <tr>
              <td class="py-2 text-slate-700">${toTool.name} implementation fee${implKnown ? '' : ' (not entered; add it from your quote)'}</td>
              <td class="py-2 text-right font-medium text-slate-900">${implKnown ? formatCurrency(targetImplFee) : 'Not entered'}</td>
            </tr>
            <tr>
              <td class="py-2 text-slate-700">Training cost (assumed: ${techs} tech${techs === 1 ? '' : 's'} × ${TRAINING_HOURS_PER_TECH}h at $${TECH_RATE_PER_HOUR}/h + ${OFFICE_HOURS}h office at $${OFFICE_RATE_PER_HOUR}/h)</td>
              <td class="py-2 text-right font-medium text-slate-900">${formatCurrency(trainingCost)}</td>
            </tr>
            <tr>
              <td class="py-2 text-slate-700">Parallel run (assumed: 1 month of ${fromTool.name})</td>
              <td class="py-2 text-right font-medium text-slate-900">${formatCurrency(parallelRunCost)}</td>
            </tr>
            <tr class="font-bold">
              <td class="pt-3 text-slate-900">Total switching cost${exclNote}</td>
              <td class="pt-3 text-right text-slate-900">${formatCurrency(totalSwitchingCost)}</td>
            </tr>
          </tbody>
        </table>

        <h3 class="mt-8 mb-3 text-lg font-bold text-slate-900">Recurring cost change</h3>
        <table class="w-full text-sm">
          <tbody class="divide-y divide-slate-100">
            <tr>
              <td class="py-2 text-slate-700">${fromTool.name} monthly</td>
              <td class="py-2 text-right font-medium text-slate-900">${formatCurrency(fromMonthly)}</td>
            </tr>
            <tr>
              <td class="py-2 text-slate-700">${toTool.name} monthly</td>
              <td class="py-2 text-right font-medium text-slate-900">${formatCurrency(toMonthly)}</td>
            </tr>
            <tr class="font-bold">
              <td class="pt-3 text-slate-900">Monthly ${monthlySavings >= 0 ? 'savings' : 'premium'}</td>
              <td class="pt-3 text-right ${monthlySavings >= 0 ? 'text-emerald-700' : 'text-rose-700'}">${formatCurrency(Math.abs(monthlySavings))}</td>
            </tr>
            <tr class="font-bold">
              <td class="py-2 text-slate-900">Annual ${annualDelta >= 0 ? 'savings' : 'premium'}</td>
              <td class="py-2 text-right ${annualDelta >= 0 ? 'text-emerald-700' : 'text-rose-700'}">${formatCurrency(Math.abs(annualDelta))}</td>
            </tr>
            <tr class="font-bold">
              <td class="py-2 text-slate-900">Break-even month</td>
              <td class="py-2 text-right text-slate-900">${breakEvenLabel}</td>
            </tr>
          </tbody>
        </table>
      `;
    }

    fromSelect.addEventListener('change', calculate);
    toSelect.addEventListener('change', calculate);
    techsInput.addEventListener('input', calculate);
    currentCostInput.addEventListener('input', calculate);
    targetCostInput.addEventListener('input', calculate);
    implFeeInput.addEventListener('input', calculate);

    // Run once on load in case URL params pre-filled
    calculate();
  </script>
</Layout>
