---
import Layout from '../../../../layouts/Layout.astro';
import { marketingAgencies, agencyTier, verticalToUrl, getVertical, type MarketingAgency } from '../../../../lib/data';

export async function getStaticPaths() {
  const TARGET_VERTICALS = ['hvac', 'plumbing', 'roofing'];
  return TARGET_VERTICALS.map((slug) => {
    const v = getVertical(slug);
    if (!v) return null;
    return { params: { vertical: verticalToUrl(slug) }, props: { verticalSlug: slug } };
  }).filter((p): p is NonNullable<typeof p> => !!p);
}

interface Props { verticalSlug: string; }
const { verticalSlug } = Astro.props;
const vertical = getVertical(verticalSlug)!;

// Match agencies to this vertical: specialty agencies first, then home-services generalists
const matched = marketingAgencies.filter(
  (a) => a.verticals_specialty.includes(verticalSlug) || a.agency_type === 'home-services-focus' || a.agency_type === 'generalist'
);

const byTier: Record<'S' | 'A' | 'F', MarketingAgency[]> = { S: [], A: [], F: [] };
for (const a of matched) byTier[agencyTier(a)].push(a);

function joinNames(names: string[]): string {
  if (names.length <= 1) return names.join('');
  return `${names.slice(0, -1).join(', ')} and ${names[names.length - 1]}`;
}

// Keep acronyms such as HVAC in capitals; lowercase ordinary trade names.
const tradeLower = vertical.name === vertical.name.toUpperCase() ? vertical.name : vertical.name.toLowerCase();
const listingTrade = matched.filter((a) => a.verticals_specialty.includes(verticalSlug));
const pricePublished = matched.filter((a) => a.pricing_published);
const flaggedNames = byTier.F.map((a) => a.name);
const coverageLine = `${listingTrade.length} of the ${matched.length} agencies on this page list ${tradeLower} among the trades they serve; the other ${matched.length - listingTrade.length} ${matched.length - listingTrade.length === 1 ? 'is a home-services or general agency' : 'are home-services or general agencies'} whose listing here does not include ${tradeLower}.`;

const pageTitle = `Best Marketing Agencies for ${vertical.name} Contractors (2026)`;
const pageDescription = `Independent reviews of marketing agencies for ${tradeLower} contractors: agencies that list ${tradeLower} among the trades they serve, plus home-services and general agencies, with published prices where they exist${flaggedNames.length > 0 ? ` and reputation warnings on ${joinNames(flaggedNames)}` : ''}.`;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Marketing agencies', url: '/agencies/' },
  { name: vertical.name, url: `/agencies/trade/${verticalToUrl(verticalSlug)}/` },
];

const tierMeta = {
  S: { label: 'Tier S: price published, no warning', description: `No reputation warning, and the agency's own site publishes the price of its core service, so you can compare cost before a sales call. This is not a ranking of quality or results.`, color: 'bg-emerald-100 text-emerald-900 ring-emerald-300', cardBorder: 'border-emerald-300' },
  A: { label: 'Tier A: no reputation warning', description: `No reputation warning, but the agency's own site does not publish the price of its core service, so the price comes in a quote${byTier.A.some((a) => a.slug === 'service-direct-marketing') ? '; Service Direct sells pay-per-call leads at a price you set instead of a retainer' : ''}. Get the fee, any setup fee and the minimum term in writing.`, color: 'bg-blue-100 text-blue-900 ring-blue-300', cardBorder: 'border-blue-300' },
  F: { label: 'Tier F: reputation warning applies', description: `Each of these agencies carries a reputation warning. Read it on the card and in the full review before you sign.`, color: 'bg-rose-100 text-rose-900 ring-rose-300', cardBorder: 'border-rose-300' },
};

function tradeIntro(slug: string): string {
  switch (slug) {
    case 'hvac':
      return 'Marketing agencies for HVAC contractors, with prices and contract terms where the agency publishes them. Before you sign, ask how the agency paces ad spend across the year and how after-hours calls are handled.';
    case 'plumbing':
      return 'Marketing agencies for plumbing contractors, with prices and contract terms where the agency publishes them. Before you sign, ask how the agency plans campaigns for emergency calls and for planned remodel work.';
    case 'roofing':
      return 'Marketing agencies for roofing contractors, with prices and contract terms where the agency publishes them. Before you sign, ask how the agency handles storm-driven demand and whether it has run insurance-restoration campaigns.';
    default:
      return `Marketing agencies for ${tradeLower} contractors, with prices and contract terms where the agency publishes them.`;
  }
}

const faqs = [
  {
    q: `How do I choose a marketing agency for ${tradeLower} contractors?`,
    a: byTier.S.length > 0
      ? `We do not rank agencies on quality. Tier S marks the agencies on this page that carry no reputation warning and publish the price of their core service on their own site: ${joinNames(byTier.S.map((a) => a.name))}. A published price lets you compare cost before a sales call. Whichever agency you consider, compare the price, the minimum contract and who owns your website and ad accounts before you sign.`
      : `We do not rank agencies on quality. Start with the agencies below that list ${tradeLower} among the trades they serve, then the broader agencies. Compare the price, the minimum contract and who owns your website and ad accounts before you sign.`,
  },
  {
    q: `What do marketing agencies for ${tradeLower} contractors charge?`,
    a: pricePublished.length > 0
      ? `${pricePublished.length} of the ${matched.length} agencies on this page publish the price of their core service on their own site: ${joinNames(pricePublished.map((a) => a.name))}. Each card above shows the published price. The others do not publish the price of their core service, so get the monthly fee, setup fee and minimum term in writing.`
      : `None of the agencies on this page publishes the price of its core service, so get the monthly fee, setup fee and minimum term in writing.`,
  },
  {
    q: `What should I know about Townsquare Interactive and Marketing 360?`,
    a: `Read their terms before you sign. Townsquare Interactive's Terms of Service do not let a client terminate during the commitment period set in its order, and make the fees for the rest of that period due if the agreement ends early. Marketing 360's terms say websites built on its platform must be hosted by Marketing 360 and cannot be moved to another host, and the agreement renews automatically. Both carry reputation warnings here; each review has the details.`,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <article class="mx-auto max-w-5xl px-4 py-12">
    <header class="mb-10">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-orange-600">
        Marketing agencies · {vertical.name}
      </p>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">
        Best Marketing Agencies for {vertical.name} Contractors (2026)
      </h1>
      <p class="mt-4 text-lg text-slate-600 leading-relaxed">{tradeIntro(verticalSlug)}</p>
      <p class="mt-3 text-sm text-slate-600 leading-relaxed">{coverageLine}</p>
    </header>

    {(['S', 'A', 'F'] as const).map((tier) => {
      const agencies = byTier[tier];
      if (agencies.length === 0) return null;
      const meta = tierMeta[tier];
      return (
        <section class="mb-12">
          <div class="mb-5">
            <div class="flex items-baseline gap-3">
              <h2 class="text-2xl font-bold text-slate-900">{meta.label}</h2>
              <span class={`inline-block rounded-full px-2 py-0.5 text-xs font-bold ring-1 ${meta.color}`}>{agencies.length}</span>
            </div>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">{meta.description}</p>
          </div>

          <div class="space-y-4">
            {agencies.map((a) => (
              <article class={`rounded-lg border-2 ${meta.cardBorder} bg-white p-5`}>
                <div class="mb-3 flex items-start justify-between gap-3">
                  <div class="min-w-0 flex-1">
                    <h3 class="text-xl font-bold text-slate-900">
                      <a href={`/agencies/${a.slug}/`} class="hover:text-orange-600">{a.name}</a>
                    </h3>
                    <p class="text-sm italic text-slate-500">{a.tagline}</p>
                  </div>
                  <div class="shrink-0 text-right text-xs">
                    <p class="font-bold text-slate-900 uppercase tracking-wider">{a.agency_type.replace(/-/g, ' ')}</p>
                    <p class="text-slate-500">{a.typical_retainer_usd}</p>
                  </div>
                </div>

                {a.reputation_flag && (
                  <div class="mb-3 rounded-md border-l-4 border-rose-500 bg-rose-50 px-4 py-3 text-sm text-rose-900">
                    <p class="font-bold uppercase tracking-wider text-xs text-rose-700 mb-1">⚠ Reputation warning</p>
                    <p class="leading-relaxed">{a.reputation_flag.split('.')[0]}.</p>
                  </div>
                )}

                {!a.verticals_specialty.includes(verticalSlug) && (
                  <p class="mb-3 text-xs text-slate-500 leading-relaxed">{`${vertical.name} is not among the trades listed for this agency; it appears here as a ${a.agency_type === 'generalist' ? 'general' : 'home-services'} agency.`}</p>
                )}

                <p class="mb-3 text-sm text-slate-700 leading-relaxed">
                  <strong class="text-slate-900">Best for:</strong> {a.best_for}
                </p>

                <div class="flex flex-wrap gap-2">
                  <a href={`/agencies/${a.slug}/`} class="rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800">Read full review →</a>
                  <a href={a.affiliate_url.startsWith('http') ? a.affiliate_url : a.vendor_url} rel="sponsored nofollow noopener" target="_blank" class="rounded-md border border-orange-300 bg-white px-4 py-2 text-sm font-semibold text-orange-700 hover:bg-orange-50">Visit {a.name.replace(/ \(.*\)$/, '')}</a>
                </div>
              </article>
            ))}
          </div>
        </section>
      );
    })}

    <section class="mb-10">
      <h2 class="mb-5 text-2xl font-bold text-slate-900">Frequently asked for {tradeLower} contractors</h2>
      <div class="space-y-3">
        {faqs.map((f) => (
          <details class="rounded-lg border border-slate-200 bg-white p-4">
            <summary class="cursor-pointer font-semibold text-slate-900">{f.q}</summary>
            <p class="mt-3 text-slate-700 leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">More for {tradeLower} contractors</h2>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href={`/${verticalToUrl(verticalSlug)}/`} class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600">{vertical.name} software directory →</a>
        <a href={`/lead-gen/trade/${verticalToUrl(verticalSlug)}/`} class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">Lead-gen for {tradeLower}</a>
        <a href={`/insurance/trade/${verticalToUrl(verticalSlug)}/`} class="rounded-md border border-white/30 bg-white/10 px-5 py-3 text-sm font-semibold text-white hover:bg-white/20">Insurance for {tradeLower}</a>
      </div>
    </section>
  </article>
</Layout>
