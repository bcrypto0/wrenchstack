---
import Layout from '../../layouts/Layout.astro';
import triosData from '../../data/trios.json';
import { tools, verticals, getTool, isQuoteOnly, toolType, type Tool } from '../../lib/data';

// Rewritten 2026-10-01. The list now comes from trios.json, the file the trio pages are
// built from: this page kept its own copy, which had drifted (one trio listed twice, two
// labels different from the pages'). The trios.json segment labels are no longer shown
// (several are contradicted by our data, e.g. "non-US" for a trio that includes Simpro,
// headquartered in Miami); each card states what the data shows instead: the trades all
// three serve and how many publish a price. Removed: "most-searched", "budget-friendly
// platforms emphasized", "implementation timeline comparison" (no longer on the pages),
// the fixed FAQ count, and the hard-coded "1,100+" pair count (now computed).

interface ResolvedTrio {
  tools: Tool[];
  url: string;
  title: string;
  shared: string[];
  published: number;
}

const vName = (slug: string) => verticals.find((v) => v.slug === slug)?.name ?? slug.replace(/_/g, ' ');

const resolved: ResolvedTrio[] = triosData.trios
  .map((def) => {
    const sorted = [...def.slugs].sort();
    const ts = sorted.map((slug) => getTool(slug)).filter((t): t is Tool => !!t);
    if (ts.length !== 3) return null;
    const shared = ts[0].verticals.filter((v) => ts[1].verticals.includes(v) && ts[2].verticals.includes(v)).map(vName);
    return {
      tools: ts,
      url: `/multi-compare/${sorted.join('-vs-')}/`,
      title: ts.map((t) => t.name).join(' vs '),
      shared,
      published: ts.filter((t) => !isQuoteOnly(t)).length,
    };
  })
  .filter((r): r is ResolvedTrio => r !== null)
  .sort((x, y) => x.title.localeCompare(y.title));

// Grouped by how many trades all three tools serve, from the data.
const specialist = resolved.filter((r) => r.shared.length > 0 && r.shared.length <= 2);
const broad = resolved.filter((r) => r.shared.length > 2);
const noShared = resolved.filter((r) => r.shared.length === 0);
const groups = [
  { id: 'specialist', title: 'Trios with one or two trades in common', blurb: 'All three tools serve the trade named on each card.', items: specialist },
  { id: 'broad', title: 'Trios with three or more trades in common', blurb: 'Tools that overlap across several trades.', items: broad },
  { id: 'none', title: 'Trios with no trade in common', blurb: 'All three tools are in our data, but no single trade is served by all three.', items: noShared },
].filter((g) => g.items.length > 0);

const sharedLine = (r: ResolvedTrio) =>
  r.shared.length <= 3 ? `Shared: ${r.shared.join(', ')}` : `Shared: ${r.shared.slice(0, 3).join(', ')} and ${r.shared.length - 3} more`;
const priceLine = (r: ResolvedTrio) =>
  r.published === 3 ? 'All three publish prices' : r.published === 0 ? 'None publishes a price' : `${r.published} of 3 publish prices`;

// Two-way comparison pages, counted the way /compare/[pair]/ builds them.
const isCmms = (t: Tool) => toolType(t) === 'cmms';
let pairPages = 0;
for (let i = 0; i < tools.length; i++) {
  for (let j = i + 1; j < tools.length; j++) {
    if (tools[i].verticals.some((v) => tools[j].verticals.includes(v)) || (isCmms(tools[i]) && isCmms(tools[j]))) pairPages++;
  }
}

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Multi-tool comparisons', url: '/multi-compare/' },
];

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: '3-way trades software comparisons',
  numberOfItems: resolved.length,
  itemListElement: resolved.map((r, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: r.title,
    url: `https://wrenchstack.com${r.url}`,
  })),
};
---

<Layout
  title={`3-way trades software comparisons: ${resolved.length} matchups`}
  description={`${resolved.length} three-way comparisons of trades software, each with a decision matrix, pricing, listed features and integrations, fit by trade and FAQs.`}
  breadcrumbs={breadcrumbs}
>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  <section class="mx-auto max-w-5xl px-4 py-12">
    <header class="mb-10">
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 md:text-5xl">
        Multi-tool comparisons
      </h1>
      <p class="mt-4 max-w-3xl text-lg text-slate-600">
        {resolved.length} three-way comparisons, for when a two-way comparison isn't enough.
      </p>
      <p class="mt-3 text-sm text-slate-500">
        Each page compares three tools from our data: a decision matrix ("Pick X if…"), pricing, features and integrations as listed in our entries, fit in each trade all three serve, the weaknesses in each entry, and FAQs.
      </p>
    </header>

    {groups.map((g) => (
      <section class="mb-12" id={g.id}>
        <h2 class="mb-2 text-2xl font-bold tracking-tight text-slate-900">{g.title}</h2>
        <p class="mb-6 text-slate-600">{g.blurb}</p>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {g.items.map((r) => (
            <a
              href={r.url}
              class="group rounded-lg border border-slate-200 bg-white p-5 transition hover:border-orange-400 hover:shadow-sm"
            >
              <div class="font-semibold text-slate-900 group-hover:text-orange-600">{r.title}</div>
              {r.shared.length > 0 && <div class="mt-1 text-xs text-slate-500">{sharedLine(r)}</div>}
              <div class="mt-1 text-xs text-slate-500">{priceLine(r)}</div>
            </a>
          ))}
        </div>
      </section>
    ))}

    <section class="mt-12 rounded-lg bg-slate-50 p-6 text-sm text-slate-600">
      <p>
        Looking for a 2-way comparison instead? Head-to-head pages exist for {pairPages.toLocaleString('en-US')} pairs: see the <a href="/compare/" class="text-orange-600 hover:underline">comparisons</a> or pick any 2 to 5 tools in the <a href="/compare-builder/" class="text-orange-600 hover:underline">comparison builder</a>. You can also take the <a href="/quiz/" class="text-orange-600 hover:underline">matching quiz</a>.
      </p>
    </section>
  </section>
</Layout>
