---
import Layout from '../../../layouts/Layout.astro';
import triosData from '../../../data/trios.json';
import { asSentence,
  getTool,
  formatPrice,
  wrenchStackScore,
  verticals,
  verticalToUrl,
  isQuoteOnly,
  nonMonthlyPricingOnly,
  entryPriceLabel,
  priceScaling,
  seatUnit,
  formatUsd,
  type Tool,
} from '../../../lib/data';
import WrenchScore from '../../../components/WrenchScore.astro';
import ToolLogo from '../../../components/ToolLogo.astro';
import FreshnessBadge from '../../../components/FreshnessBadge.astro';

export async function getStaticPaths() {
  return triosData.trios.flatMap(def => {
    const sorted = [...def.slugs].sort();
    const tools = sorted.map(slug => getTool(slug));
    if (tools.some(t => !t)) return [];
    const slugUrl = sorted.join('-vs-');
    return [{
      params: { trio: slugUrl },
      props: { tools: tools as Tool[] },
    }];
  });
}

interface Props {
  tools: Tool[];
}

// Rewritten 2026-10-01. Removed: implementation timelines by price tier ("3-6 months",
// "4-8 weeks", "1-3 weeks") and the parallel-run and migration durations (no vendor
// publishes them and our data does not record them); "only X has" feature claims
// (feature lists are our entries' labels, not a controlled vocabulary); "quotes only"
// for tools that publish one-time or per-project prices (quote-only is isQuoteOnly);
// "ranks highest for {segment}" (the Fit Score is not computed per buyer segment);
// the trios.json segment labels, several of which our data contradicts (Simpro is
// headquartered in Miami, not outside the US; FieldPulse and Workiz publish no price,
// so "affordable" cannot be shown); and claims that a tool lacking an integration in
// our list "requires Zapier workarounds".

const { tools: trioTools } = Astro.props;
const [a, b, c] = trioTools;
const othersOf = (t: Tool) => trioTools.filter((o) => o.slug !== t.slug);
const listNames = (ts: Tool[]) =>
  ts.length <= 1 ? ts.map((t) => t.name).join('') : `${ts.slice(0, -1).map((t) => t.name).join(', ')} and ${ts[ts.length - 1].name}`;

const titleStr = `${a.name} vs ${b.name} vs ${c.name}`;
// The year in the title is the year of the oldest price check, so a rebuild in a later
// year does not claim a fresher comparison than the data.
const checkedDates = [...new Set(trioTools.map((t) => t.pricing.verified_date).filter(Boolean))].sort();
const titleYear = checkedDates.length ? checkedDates[0].slice(0, 4) : String(new Date().getFullYear());
const pageTitle = `${titleStr} (${titleYear}): 3-Way Comparison`;
const pageDescription = `${titleStr} compared side by side from our data: pricing, listed features and integrations, fit in each shared trade, and a decision matrix.${checkedDates.length ? ` Prices checked ${checkedDates.join(', ')}.` : ''}`;

// --- Fit Score (context-free: each tool's best trade) ---
const scored = trioTools.map((t) => ({ tool: t, score: wrenchStackScore(t) }));
const topScore = Math.max(...scored.map((s) => s.score));
const scoreLeaders = scored.filter((s) => s.score === topScore).map((s) => s.tool);
const scoreSentence =
  scoreLeaders.length === 1
    ? `${scoreLeaders[0].name} has the highest WrenchStack Fit Score of the three (${topScore})`
    : scoreLeaders.length === trioTools.length
      ? `All three have the same WrenchStack Fit Score (${topScore})`
      : `${listNames(scoreLeaders)} share the highest WrenchStack Fit Score of the three (${topScore})`;

// --- Entry price ---
const priced = trioTools.filter((t) => t.pricing.starting_at_usd !== null);
const lowestPrice = priced.length ? Math.min(...priced.map((t) => t.pricing.starting_at_usd as number)) : null;
const lowestTools = priced.filter((t) => t.pricing.starting_at_usd === lowestPrice);
// Only call a tool the cheapest when at least two of the three have a monthly entry price,
// one alone has the lowest, and no tool without a monthly price could undercut it (a
// quote-only tool may be cheaper; a $0 free tier cannot be undercut). Until 2026-10-01
// "Jobber has the lowest entry price of the three" ran beside a quote-only Workiz.
const unpriced = trioTools.filter((t) => t.pricing.starting_at_usd === null);
const cheapest =
  priced.length >= 2 && lowestTools.length === 1 && (unpriced.length === 0 || lowestPrice === 0) ? lowestTools[0] : null;
// "publishes no price" / "publishes one-time or per-project prices" / "has a free tier" /
// "starts at $47 per user a month".
const priceClause = (t: Tool) =>
  isQuoteOnly(t)
    ? 'publishes no price'
    : nonMonthlyPricingOnly(t)
      ? 'publishes one-time or per-project prices, not a monthly plan'
      : t.pricing.starting_at_usd === 0
        ? 'has a free tier'
        : `starts at ${entryPriceLabel(t)}`;
const priceSummary = trioTools.map((t) => `${t.name} ${priceClause(t)}.`).join(' ');
const shortPrice = (t: Tool) => (nonMonthlyPricingOnly(t) ? 'one-time or per-project prices, not a monthly plan' : formatPrice(t));

// --- Lists ---
const label = (s: string) => s.replace(/_/g, ' ');
const sharedFeatures = a.key_features.filter(f => b.key_features.includes(f) && c.key_features.includes(f));
const sharedIntegrations = a.integrations.filter(i => b.integrations.includes(i) && c.integrations.includes(i));
const uniqueFeatures = (t: Tool) => t.key_features.filter((f) => othersOf(t).every((o) => !o.key_features.includes(f)));
const uniqueIntegrations = (t: Tool) => t.integrations.filter((i) => othersOf(t).every((o) => !o.integrations.includes(i)));

const QB_NAMES: Record<string, string> = {
  quickbooks_online: 'QuickBooks Online',
  quickbooks_desktop: 'QuickBooks Desktop',
  quickbooks_enterprise: 'QuickBooks Enterprise',
  quickbooks_time: 'QuickBooks Time',
  quickbooks: 'QuickBooks (product not specified)',
};
const qbList = (t: Tool) => t.integrations.filter((i) => i.includes('quickbooks')).map((i) => QB_NAMES[i] ?? label(i));
const hasGLS = (t: Tool) => t.integrations.some((i) => i.includes('google_local_services'));
const hasTrial = (t: Tool) => (t.pricing.free_trial_days ?? 0) > 0;

// --- Trades all three serve, and who fits each best ---
const sharedVerticals = a.verticals
  .filter(v => b.verticals.includes(v) && c.verticals.includes(v))
  .map(v => verticals.find(x => x.slug === v))
  .filter((v): v is NonNullable<typeof v> => !!v);

function verticalWinner(verticalSlug: string): { winner: Tool | null; scores: { tool: Tool; fit: number }[] } {
  const scores = trioTools.map(t => ({ tool: t, fit: t.vertical_fit?.[verticalSlug] ?? 5 }));
  const sorted = [...scores].sort((x, y) => y.fit - x.fit);
  const winner = sorted[1].fit < sorted[0].fit ? sorted[0].tool : null; // null if tied at the top
  return { winner, scores };
}

const fitWins = new Map<string, { name: string; fit: number; next: number }[]>(
  trioTools.map((t) => [t.slug, [] as { name: string; fit: number; next: number }[]]),
);
for (const v of sharedVerticals) {
  const { winner: vw, scores } = verticalWinner(v.slug);
  if (!vw) continue;
  const fits = scores.map((s) => s.fit).sort((x, y) => y - x);
  fitWins.get(vw.slug)!.push({ name: v.name, fit: fits[0], next: fits[1] });
}
const fitRanking = [...trioTools].sort((x, y) => fitWins.get(y.slug)!.length - fitWins.get(x.slug)!.length);
const fitLeader =
  fitWins.get(fitRanking[0].slug)!.length > fitWins.get(fitRanking[1].slug)!.length ? fitRanking[0] : null;
const fitLeaderWins = fitLeader ? fitWins.get(fitLeader.slug)!.length : 0;

function joinOr(names: string[]): string {
  if (names.length <= 1) return names.join('');
  return `${names.slice(0, -1).join(', ')} or ${names[names.length - 1]}`;
}

// Shown under the H1 instead of the trios.json segment label: what the three share.
const segmentLine = sharedVerticals.length === 0
  ? 'No trade in common in our data'
  : sharedVerticals.length <= 3
    ? `Trades all three serve: ${sharedVerticals.map((v) => v.name).join(', ')}`
    : `${sharedVerticals.length} trades all three serve`;

// --- Decision matrix: every line states a difference in our data ---
function getDecisionReasonsFor(t: Tool): string[] {
  const reasons: string[] = [];
  const others = othersOf(t);

  reasons.push(`**Your situation matches ${t.name}'s target profile**: ${t.best_for}`);

  if (cheapest && cheapest.slug === t.slug) {
    reasons.push(`**Entry price matters most**: ${t.name} ${priceClause(t)}; ${others.map((o) => `${o.name} ${priceClause(o)}`).join('; ')}`);
  }

  const wins = fitWins.get(t.slug) ?? [];
  if (wins.length > 0) {
    reasons.push(`**You work in ${joinOr(wins.slice(0, 3).map((w) => w.name))}**: ${t.name} has the highest vertical-fit score of the three there (${wins[0].name}: ${wins[0].fit}/10 against ${wins[0].next}/10 for the next)`);
  }

  const quoteOnlyOthers = others.filter(isQuoteOnly);
  if (!isQuoteOnly(t) && quoteOnlyOthers.length > 0) {
    reasons.push(`**You want to budget before asking for a quote**: ${t.name} publishes its prices (${shortPrice(t)}); ${listNames(quoteOnlyOthers)} ${quoteOnlyOthers.length === 1 ? 'quotes' : 'quote'} only`);
  }

  const noQb = others.filter((o) => qbList(o).length === 0);
  if (qbList(t).length > 0 && noQb.length > 0) {
    reasons.push(`**QuickBooks matters**: ${t.name} lists a QuickBooks integration (${qbList(t).join(', ')}); our ${noQb.length === 1 ? 'entry' : 'entries'} for ${listNames(noQb)} ${noQb.length === 1 ? 'lists' : 'list'} none`);
  }

  const noGls = others.filter((o) => !hasGLS(o));
  if (hasGLS(t) && noGls.length > 0) {
    reasons.push(`**Google Local Services Ads bring in your calls**: ${t.name} lists a Google Local Services Ads integration; our ${noGls.length === 1 ? 'entry' : 'entries'} for ${listNames(noGls)} ${noGls.length === 1 ? 'does' : 'do'} not`);
  }

  if (hasTrial(t) && others.every((o) => !hasTrial(o) && o.pricing.starting_at_usd !== 0)) {
    reasons.push(`**You want to try before buying**: ${t.name} offers a ${t.pricing.free_trial_days}-day free trial; our data records none for ${listNames(others)}`);
  }

  const maxOtherTrades = Math.max(...others.map((o) => o.verticals.length));
  if (t.verticals.length > maxOtherTrades + 1) {
    reasons.push(`**You serve several trades**: ${t.name} serves ${t.verticals.length} trades in our data, against ${maxOtherTrades} at most for the others`);
  }

  const maxOtherInts = Math.max(...others.map((o) => o.integrations.length));
  if (t.integrations.length > maxOtherInts + 1) {
    reasons.push(`**Integrations matter**: ${t.name} lists ${t.integrations.length} integrations in our data, against ${maxOtherInts} at most for the others`);
  }

  return reasons.slice(0, 6);
}

const decisionMatrix = trioTools.map(t => ({ tool: t, reasons: getDecisionReasonsFor(t) }));

// --- Pricing table (same cell rules as the two-way pages) ---
function tierCell(t: Tool, i: number): string {
  const tierName = t.pricing.tiers[i];
  if (!tierName) return '-';
  const p = t.pricing.tier_prices_usd?.[i];
  if (nonMonthlyPricingOnly(t)) return tierName;
  if (p === null || p === undefined) return `${tierName}: quote`;
  if (p === 0) return `${tierName}: free`;
  if (t.pricing.pricing_model === 'annual_per_user') return `${tierName}: $${formatUsd(p)} per ${seatUnit(t)} a year`;
  return `${tierName}: $${formatUsd(p)}/mo`;
}

// "A per-user price rises with every user" generalises over the three entry prices; it
// says "per-seat ... every seat" when one of them charges per route or per driver
// (seat_unit, 2026-10-05), since entryPriceLabel then names that seat.
const seatWord = trioTools.every((t) => priceScaling(t) !== 'per_user' || seatUnit(t) === 'user') ? 'user' : 'seat';

// --- FAQs (from data only) ---
function cheapestAnswer(): string {
  const quoteOnly = trioTools.filter(isQuoteOnly);
  const labels = trioTools.map((t) => `${t.name}: ${entryPriceLabel(t)}`).join('; ');
  if (quoteOnly.length === trioTools.length) {
    return 'None of the three publishes a price. Request quotes from each for the same team size and features, and get what is included in writing.';
  }
  if (cheapest) {
    return `${cheapest.name} has the lowest entry price of the three. Entry prices: ${labels}. A per-${seatWord} price rises with every ${seatWord} and a company price does not, so compare them at your team size; see the pricing table.`;
  }
  return `Our data cannot rank them on price. Entry prices: ${labels}.${quoteOnly.length ? ` Ask ${listNames(quoteOnly)} for a written quote at your team size.` : ''}`;
}

function qbAnswer(): string {
  const withQb = trioTools.filter((t) => qbList(t).length > 0);
  const without = trioTools.filter((t) => qbList(t).length === 0);
  const listed = withQb.map((t) => `${t.name} lists ${qbList(t).join(' and ')}`).join('; ');
  if (withQb.length === 0) return 'Our entries list no QuickBooks integration for any of the three. Ask each vendor how it exports to your accounting software.';
  return `${listed}.${without.length ? ` Our ${without.length === 1 ? 'entry' : 'entries'} for ${listNames(without)} ${without.length === 1 ? 'lists' : 'list'} none.` : ''} Check which way each sync runs, and on which plans, in each tool's full review before you buy.`;
}

const faqs = [
  {
    q: `Which is best: ${a.name}, ${b.name}, or ${c.name}?`,
    a: `It depends on your trade, team size and budget. ${scoreSentence}. That score weighs trade fit (60%), price transparency (20%) and integrations (20%), using each tool's best trade; ${sharedVerticals.length ? 'if you work in one trade, use the fit table above, and see the decision matrix for situations.' : 'see the decision matrix above for situations.'}`,
  },
  {
    q: `Which is the cheapest of the three?`,
    a: cheapestAnswer(),
  },
  {
    q: `Do they all integrate with QuickBooks?`,
    a: qbAnswer(),
  },
  {
    q: `Can I move from one of these to another later?`,
    a: `Our data does not record migration support for these tools. Ask each vendor which records they import and export (customers, jobs, invoices, recurring agreements, price books), in which file format, and whether they help with the import.`,
  },
  {
    q: `Which suits my team size?`,
    a: `Our data puts the best team size at ${trioTools.map((t) => `${t.best_team_size ?? 'unrecorded'} for ${t.name}`).join(', ')}. Entry prices: ${trioTools.map((t) => `${t.name}, ${entryPriceLabel(t)}`).join('; ')}. A per-${seatWord} price rises with every ${seatWord}; a company price changes when you need a bigger plan, so check each plan's user limits and price each at the team size you expect to have.`,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const trioUrl = trioTools.map(t => t.slug).sort().join('-vs-');
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Multi-tool comparisons', url: '/multi-compare/' },
  { name: titleStr, url: `/multi-compare/${trioUrl}/` },
];
---

<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs} affiliate>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <article class="mx-auto max-w-5xl px-4 py-12">

    <header class="mb-10">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-orange-600">3-way comparison · {segmentLine}</p>
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 md:text-5xl">
        {a.name} vs {b.name} vs {c.name}
      </h1>
      <p class="mt-4 text-lg text-slate-600">
        Three tools side by side from our data: a decision matrix, pricing, features and integrations as listed in our entries, and fit in each trade all three serve.
      </p>
    </header>

    <section class="mb-12 grid gap-4 md:grid-cols-3">
      {trioTools.map((t) => {
        const score = wrenchStackScore(t);
        return (
          <div class="rounded-lg border border-slate-200 bg-white p-5">
            <div class="mb-3 flex items-center gap-3">
              <ToolLogo tool={t} size={40} />
              <div class="flex-1">
                <h2 class="text-lg font-bold text-slate-900">
                  <a href={`/tools/${t.slug}/`} class="hover:text-orange-600">{t.name}</a>
                </h2>
                <p class="text-xs italic text-slate-500">{t.tagline}</p>
              </div>
            </div>
            <div class="mb-3 flex items-center justify-between gap-2">
              <WrenchScore score={score} size="sm" />
              <FreshnessBadge tool={t} variant="compact" />
            </div>
            <dl class="space-y-1 text-sm">
              <div class="flex justify-between">
                <dt class="text-slate-500">Starting price</dt>
                <dd class="font-semibold text-slate-900">{formatPrice(t)}</dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-slate-500">Best team size</dt>
                <dd class="font-semibold text-slate-900">{t.best_team_size ?? 'n/a'}</dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-slate-500">Free trial</dt>
                <dd class="font-semibold text-slate-900">{hasTrial(t) ? `${t.pricing.free_trial_days} days` : t.pricing.starting_at_usd === 0 ? 'Free tier instead' : 'None listed'}</dd>
              </div>
            </dl>
            <a
              href={t.affiliate_url.startsWith('http') ? t.affiliate_url : t.vendor_url}
              rel="sponsored nofollow noopener"
              target="_blank"
              class="mt-4 block w-full rounded-md bg-orange-500 px-4 py-2 text-center text-sm font-semibold text-white hover:bg-orange-600"
            >
              Visit {t.name} →
            </a>
          </div>
        );
      })}
    </section>

    <section class="mb-12 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-4 text-2xl font-bold text-slate-900">Quick verdict</h2>
      <div class="space-y-3 text-slate-800">
        {trioTools.map((t) => (
          <p>
            <strong class="text-slate-900">{t.name}:</strong> {asSentence(t.best_for)}
          </p>
        ))}
        <ul class="mt-3 space-y-1 text-sm text-slate-600">
          {cheapest && <li><strong>{cheapest.name}</strong> has the lowest entry price of the three ({formatPrice(cheapest)}).</li>}
          {fitLeader && <li>Vertical fit favors <strong>{fitLeader.name}</strong> in {fitLeaderWins} of {sharedVerticals.length} shared {sharedVerticals.length === 1 ? 'trade' : 'trades'}.</li>}
          <li>{scoreSentence}.</li>
        </ul>
      </div>
    </section>

    <section class="mb-12">
      <h2 class="mb-4 text-2xl font-bold text-slate-900">Decision matrix: which to pick</h2>
      <div class="grid gap-4 md:grid-cols-3">
        {decisionMatrix.map(({ tool: t, reasons }) => (
          <div class="rounded-lg border border-slate-200 bg-white p-5">
            <h3 class="mb-3 text-lg font-bold text-slate-900">Pick {t.name} if…</h3>
            <ul class="space-y-2 text-sm text-slate-700">
              {reasons.map((r) => (
                <li class="flex gap-2">
                  <span class="font-bold text-orange-600">→</span>
                  <span set:html={r.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')} />
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="mb-12">
      <h2 class="mb-4 text-2xl font-bold text-slate-900">Pricing side-by-side</h2>
      <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
        <table class="w-full text-sm">
          <thead class="bg-slate-50 text-left text-slate-700">
            <tr>
              <th class="p-3 font-semibold">Tier</th>
              {trioTools.map(t => <th class="p-3 font-semibold">{t.name}</th>)}
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {[0, 1, 2, 3].map(i => {
              if (trioTools.every(t => !t.pricing.tiers[i])) return null;
              return (
                <tr>
                  <td class="p-3 font-semibold text-slate-900">Tier {i + 1}</td>
                  {trioTools.map((t) => (
                    <td class="p-3 text-slate-700">{tierCell(t, i)}</td>
                  ))}
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-sm text-slate-600">
        {priceSummary}
      </p>
    </section>

    <section class="mb-12">
      <h2 class="mb-4 text-2xl font-bold text-slate-900">Features listed for all three</h2>
      {sharedFeatures.length > 0 ? (
        <div class="flex flex-wrap gap-2">
          {sharedFeatures.map(f => (
            <span class="rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-sm font-medium text-emerald-900">
              ✓ {label(f)}
            </span>
          ))}
        </div>
      ) : (
        <p class="text-slate-600">No feature label appears in all three entries.</p>
      )}
      <p class="mt-3 text-sm text-slate-600">
        Features as listed in our entries. The lists use different words for similar features, and a feature missing from one list means our entry does not record it, not that the tool lacks it, so check a feature you need on each vendor's site.
      </p>
    </section>

    <section class="mb-12">
      <h2 class="mb-4 text-2xl font-bold text-slate-900">Features listed for one tool only</h2>
      <div class="grid gap-4 md:grid-cols-3">
        {trioTools.map(t => {
          const unique = uniqueFeatures(t);
          return (
            <div class="rounded-lg border border-slate-200 bg-white p-4">
              <h3 class="mb-2 font-semibold text-slate-900">Listed for {t.name} only</h3>
              {unique.length > 0 ? (
                <ul class="space-y-1 text-sm text-slate-700">
                  {unique.map(f => <li>+ {label(f)}</li>)}
                </ul>
              ) : (
                <p class="text-sm text-slate-500">None</p>
              )}
            </div>
          );
        })}
      </div>
    </section>

    <section class="mb-12">
      <h2 class="mb-4 text-2xl font-bold text-slate-900">Integrations</h2>
      <div class="grid gap-4 md:grid-cols-2">
        <div class="rounded-lg border border-green-200 bg-green-50 p-4">
          <h3 class="mb-2 text-sm font-semibold uppercase tracking-wider text-green-700">
            Listed for all three
          </h3>
          {sharedIntegrations.length > 0 ? (
            <ul class="space-y-1 text-sm text-green-900">
              {sharedIntegrations.map(i => <li>✓ {label(i)}</li>)}
            </ul>
          ) : (
            <p class="text-sm text-green-700">None in common in our data</p>
          )}
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-4">
          <h3 class="mb-2 text-sm font-semibold uppercase tracking-wider text-slate-500">
            Listed for one tool only
          </h3>
          <ul class="space-y-2 text-sm text-slate-700">
            {trioTools.map(t => {
              const unique = uniqueIntegrations(t);
              if (unique.length === 0) return null;
              return (
                <li>
                  <strong class="text-slate-900">{t.name}:</strong> {unique.map(label).join(', ')}
                </li>
              );
            })}
          </ul>
        </div>
      </div>
    </section>

    {sharedVerticals.length > 0 && (
      <section class="mb-12">
        <h2 class="mb-4 text-2xl font-bold text-slate-900">Which fits best in each trade</h2>
        <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
          <table class="w-full text-sm">
            <thead class="bg-slate-50 text-left text-slate-700">
              <tr>
                <th class="p-3 font-semibold">Trade</th>
                {trioTools.map(t => <th class="p-3 font-semibold text-center">{t.name}</th>)}
                <th class="p-3 font-semibold">Highest fit</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {sharedVerticals.map(v => {
                const { winner: vw, scores } = verticalWinner(v.slug);
                return (
                  <tr>
                    <td class="p-3 font-semibold text-slate-900">
                      <a href={`/${verticalToUrl(v.slug)}/`} class="hover:text-orange-600">{v.name}</a>
                    </td>
                    {scores.map(s => (
                      <td class="p-3 text-center text-slate-700">{s.fit} / 10</td>
                    ))}
                    <td class="p-3 text-slate-700">
                      {vw ? <span class="font-semibold text-slate-900">{vw.name}</span> : <span class="text-slate-500">Tie</span>}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
        <p class="mt-2 text-xs text-slate-500">
          Vertical-fit scores (1-10) rate how well each tool is built for the trade, checked against the trades the vendor's own pages say it serves. See <a href="/methodology/" class="underline hover:text-slate-700">methodology</a>.
        </p>
      </section>
    )}

    <section class="mb-12">
      <h2 class="mb-4 text-2xl font-bold text-slate-900">Weaknesses noted in our entries</h2>
      <div class="grid gap-4 md:grid-cols-3">
        {trioTools.map(t => (
          <div class="rounded-lg border border-orange-200 bg-orange-50 p-4">
            <h3 class="mb-2 font-semibold text-orange-900">{t.name}</h3>
            <p class="text-sm text-orange-900">{asSentence(t.weaknesses)}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mb-12">
      <h2 class="mb-6 text-2xl font-bold text-slate-900">Frequently asked questions</h2>
      <div class="space-y-4">
        {faqs.map(f => (
          <details class="rounded-lg border border-slate-200 bg-white p-4">
            <summary class="cursor-pointer font-semibold text-slate-900">{f.q}</summary>
            <p class="mt-3 text-slate-700 leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">Need a deeper look?</h2>
      <p class="mt-2 text-slate-300">See our full reviews of each tool, take the matching quiz, or compare any two head-to-head.</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/quiz/" class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600">Take the matching quiz →</a>
        <a href="/compare/" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">All comparisons</a>
        {trioTools.map(t => (
          <a href={`/tools/${t.slug}/`} class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">{t.name} review</a>
        ))}
      </div>
    </section>
  </article>
</Layout>
