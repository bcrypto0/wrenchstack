---
import Layout from '../layouts/Layout.astro';
import { tools, verticals, leadGenPlatforms, insuranceProviders, payrollServices, marketingAgencies, usVendorTotal, usVendorLists, totalReputationFlags, awards } from '../lib/data';
import { intlMarketCount } from '../lib/intl';

const toolCount = tools.length;
const verticalCount = verticals.length;
const phase2Count = tools.filter((t) => (t as { long_description?: string }).long_description).length;

// Cross-category coverage stats (multi-category positioning)
const leadGenCount = leadGenPlatforms.length;
const insuranceCount = insuranceProviders.length;
const payrollCount = payrollServices.length;
const agencyCount = marketingAgencies.length;
// Shared helpers, so this page matches every other surface (2026-10-01). It used
// to sum 5 of the 10 US datasets (224 against 276) and count flags in only 3 of
// the 9 flagged categories (13 against 25).
const totalVendorCount = usVendorTotal();
const categoryCount = usVendorLists().length;
const reputationFlagCount = totalReputationFlags();
// Computed (2026-10-01): "18 editorial designations" and "4,900+ pages" were
// hard-coded; the page count was stale (the build has about twice that) and is
// not something a page can count, so it was removed rather than updated.
const awardCount = awards.categories.length;
const awardsPublished = new Date(awards.published_date + 'T00:00:00Z').toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  timeZone: 'UTC',
});

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'About', url: '/about/' },
];

// Organization schema (not Person, repositioning as research firm)
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'WrenchStack',
  url: 'https://wrenchstack.com',
  description: `WrenchStack is an independent research desk covering trades-contractor vendors across ${categoryCount} US categories: field-service software, payments, accounting, banking, financing, payroll, insurance, lead generation, marketing agencies and AI tools. We publish the WrenchStack Fit Score™ methodology and per-vendor affiliate disclosure for every recommendation.`,
  foundingDate: '2026',
  knowsAbout: [
    'Field service management software',
    'Trades contractor lead generation',
    'Business insurance for contractors',
    'SMB payroll services',
    'Home-services marketing agencies',
  ],
  email: 'hello@wrenchstack.com',
  sameAs: [],
  contactPoint: [
    { '@type': 'ContactPoint', contactType: 'editorial', email: 'hello@wrenchstack.com' },
    { '@type': 'ContactPoint', contactType: 'press', email: 'press@wrenchstack.com' },
    { '@type': 'ContactPoint', contactType: 'vendor listings', email: 'partners@wrenchstack.com' },
  ],
};
---

<Layout
  title="About WrenchStack: independent trades vendor research desk"
  description={`WrenchStack is an independent research desk covering ${totalVendorCount} US trades-contractor vendors across ${categoryCount} categories (software, payments, accounting, payroll, insurance, financing, banking, lead-gen, marketing and AI) plus ${intlMarketCount} international markets. Published methodology, per-vendor affiliate disclosure, sourced reputation flags.`}
  breadcrumbs={breadcrumbs}
>
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

  <article class="mx-auto max-w-3xl px-4 py-12">

    <header class="mb-12">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-orange-600">About WrenchStack</p>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">
        The independent research desk for trades vendors.
      </h1>
      <p class="mt-6 text-lg text-slate-700 leading-relaxed sm:text-xl">
        WrenchStack covers the vendors a trades contractor buys from (field-service software, payments, accounting, banking, financing, payroll, insurance, lead generation, marketing agencies and AI tools) with published standards and per-vendor affiliate disclosure. {totalVendorCount} US vendors evaluated. {reputationFlagCount} reputation flags issued. Zero pay-to-play.
      </p>
    </header>

    <section class="mb-12 grid gap-3 grid-cols-2 sm:grid-cols-4">
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">{totalVendorCount}</div>
        <div class="mt-1 text-xs text-slate-600">US vendors evaluated</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">{categoryCount}</div>
        <div class="mt-1 text-xs text-slate-600">Categories covered</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">{verticalCount}</div>
        <div class="mt-1 text-xs text-slate-600">Trade verticals</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">{intlMarketCount}</div>
        <div class="mt-1 text-xs text-slate-600">International markets</div>
      </div>
    </section>

    <section class="prose prose-slate max-w-none">

      <h2>What we do</h2>

      <p>
        We are an independent research desk publishing comparative analysis of the vendors trades contractors buy from. Across {categoryCount} US categories (field-service software, payments, accounting, banking, financing, payroll, insurance, lead generation, marketing agencies and AI tools), we publish per-vendor affiliate disclosure and reputation flags on the vendors whose records earn them. Field-service software is ranked by the published <a href="/methodology/">WrenchStack Fit Score™</a> methodology.
      </p>

      <p>
        Our editorial position is uncomplicated: contractors deserve evaluation that's not paid for by the vendors being evaluated. The same rules apply to every vendor in a category, whether we have an active affiliate relationship, a pending application, or no commercial alignment at all. Reputation flags are attached only where a regulator order, court record, BBB profile or the vendor's own terms supports them, regardless of whether a flagged vendor pays us anything. Some vendors buy pricing benchmark reports from us. Whether a vendor bought a report is not an input to any listing, Fit Score, ranking, award or reputation flag, or to whether a product is listed, and every buyer is listed in the <a href="/methodology/#report-ledger">report ledger</a>.
      </p>

      <h2>Why this exists</h2>

      <p>
        A contractor comparing software should be able to see who pays whom. WrenchStack sells no placement
        and no leads, vendors cannot pay for a higher score or an award, and our affiliate status with every
        software tool and every pricing benchmark report sale are listed on the
        <a href="/methodology/">methodology page</a>.
      </p>

      <p>
        What we publish instead: a versioned methodology, prices that show the date they were last verified,
        and reputation flags only where a regulator order, court record, BBB profile or the vendor's own terms
        supports them.
      </p>

      <h2>Editorial structure</h2>

      <p>
        WrenchStack is run by one person today, who holds each of these roles:
      </p>

      <ul class="not-prose space-y-3">
        <li class="rounded-lg border border-slate-200 bg-white p-4">
          <div class="font-semibold text-slate-900">Editor-in-Chief</div>
          <div class="text-sm text-slate-600 mt-1">Editorial direction, methodology stewardship, vendor relationship boundaries. Reviews every reputation flag before publication.</div>
        </li>
        <li class="rounded-lg border border-slate-200 bg-white p-4">
          <div class="font-semibold text-slate-900">Methodology Lead</div>
          <div class="text-sm text-slate-600 mt-1">Owns the <a href="/methodology/" class="text-orange-600 hover:underline">WrenchStack Fit Score™</a> formula, weights, version history, scoring rubric. Documents every change to the methodology in the versioned changelog.</div>
        </li>
        <li class="rounded-lg border border-slate-200 bg-white p-4">
          <div class="font-semibold text-slate-900">Data Operations</div>
          <div class="text-sm text-slate-600 mt-1">Pricing verification (monthly refresh), feature data sourcing, integration directory cross-referencing, reputation checks against regulator orders, court records, BBB profiles and vendor terms.</div>
        </li>
        <li class="rounded-lg border border-slate-200 bg-white p-4">
          <div class="font-semibold text-slate-900">Vendor Relations</div>
          <div class="text-sm text-slate-600 mt-1">Vendor correspondence, affiliate program applications, pricing benchmark report orders and correction requests. Held by the same person as the editorial roles; the safeguards are in the method, set out in our <a href="/editorial-standards/" class="text-orange-600 hover:underline">editorial standards</a>.</div>
        </li>
      </ul>

      <p>
        For the full process behind every review (how we research, verify, source, flag, and correct), see our <a href="/editorial-standards/">editorial standards</a>.
      </p>

      <h2>What makes us structurally different</h2>

      <p>Four operating rules:</p>

      <ol>
        <li>
          <strong>Multi-category coverage under one set of rules.</strong> All {usVendorLists().length} US categories share the same independence rules and reputation-flag standards, and field-service software is also ranked by the WrenchStack Fit Score™.
        </li>
        <li>
          <strong>Verified pricing with visible dates.</strong> Every software tool's pricing shows the date it was last verified. On software pages, a price verified 90 days ago or less gets a green freshness pill; 91-180 days gets amber; over 180 gets red. The freshness signal is a UI element, not buried metadata.
        </li>
        <li>
          <strong>Buyer-side decision tools.</strong> <a href="/quiz/">Matching quiz</a>, <a href="/roi-calculator/">ROI calculator</a>, <a href="/cost-of-switch/">cost-of-switch calculator</a>, per-tool pricing widgets, interactive <a href="/compare-builder/">comparison builder</a>. Tools that make the decision real. Competitor directories don't ship these because their business model depends on form-fills, not self-service.
        </li>
        <li>
          <strong>Honest reputation flags.</strong> {reputationFlagCount} vendors carry a reputation_flag warning based on sources we could read: regulator and court actions (HomeAdvisor's FTC order of up to $7.2 million, Angi's Vermont Attorney General settlement, GreenSky's CFPB consent order, Paycom's 2021 SEC order), contract terms that are hard to exit (Townsquare Interactive, Marketing 360), and BBB complaint records (Bark, BuildZoom, Pie Insurance, Melio). Each flag names its source, and a warning we could not verify is removed.
        </li>
      </ol>

      <h2>What we ship</h2>

      <ul>
        <li><strong>{toolCount} software platforms</strong> across {verticalCount} trade verticals, each with a full review: pros and cons, pricing and FAQs</li>
        <li><strong>{leadGenCount} lead-gen platforms</strong>, each showing its lead model (shared, exclusive, pay-per-call, bid marketplace and others), with {leadGenPlatforms.filter((p) => p.reputation_flag).length} documented reputation warnings</li>
        <li><strong>{insuranceCount} insurance providers</strong>, each showing how it is sold (online, through agents, or both), with per-trade buyer guides</li>
        <li><strong>{payrollCount} payroll services</strong> with company-size guides (1-5, 6-20, 20+ employees)</li>
        <li><strong>{agencyCount} marketing agencies</strong> with trade-specific specialists flagged and documented lock-in contract warnings</li>
        <li><strong>Methodology page</strong> with version number, effective date, scoring rubric, evaluation timeline, per-vendor affiliate ledger and report ledger</li>
        <li><strong>WrenchStack Awards 2026</strong>: {awardCount} editorial designations, published {awardsPublished}, no paid placement; chosen when the Fit Score still included third-party review ratings and not re-selected since (see the methodology changelog)</li>
        <li><strong>Comparison pages</strong>: head-to-head pages for pairs of tools that share a trade (CMMS tools are compared with each other), three-way comparisons, and a builder for comparing several tools at once</li>
      </ul>

      <h2>Geographic coverage</h2>

      <p>
        WrenchStack covers the United States plus {intlMarketCount} international markets. Each international market has its own vendor directory, with per-vendor profiles and head-to-head comparisons, covering local software, lead-generation platforms, insurance providers and certification bodies: for example Checkatrade and the Gas Safe Register (UK), Hipages (AU), HomeStars and the Red Seal Program (CA), Fergus and the PGDB (NZ), and MyBuilder.ie and RGI (IE). A separate <a href="/certifications/">certification guide</a> compares the certification and licensing bodies of the UK, Australia, Canada, New Zealand, Ireland and South Africa.
      </p>

      <h2>What we do not do</h2>

      <ul>
        <li>Accept payment for placement in a "best of" list or award category</li>
        <li>Accept payment to raise a vendor's WrenchStack Fit Score™</li>
        <li>Accept payment to omit or soften cons in a vendor review</li>
        <li>Accept payment to remove a reputation_flag warning</li>
        <li>Hide an affiliate relationship: every software vendor's status is on the <a href="/methodology/#affiliate-ledger">methodology page ledger</a>, and reviews in the other {categoryCount - 1} categories state it on the page</li>
        <li>Hide a report sale: every pricing benchmark report sold to a vendor is in the <a href="/methodology/#report-ledger">report ledger</a></li>
        <li>Recommend a vendor we wouldn't recommend if no commission or report sale existed</li>
        <li>Gate pricing data behind a sales call</li>
        <li>Publish "experts agree" content with no editorial accountability</li>
      </ul>

      <h2>For vendors interested in inclusion</h2>

      <p>
        We accept inbound submissions from vendors who believe they serve trades contractors well and want editorial review. Read the <a href="/methodology/">WrenchStack Fit Score™ methodology</a> first to understand how we evaluate. Then reach out via <a href="mailto:partners@wrenchstack.com">partners@wrenchstack.com</a> with: company name, website, primary trade verticals served, distinguishing characteristics vs comparable vendors, and current customer count.
      </p>

      <p>
        Inclusion does not guarantee a positive review or absence of a reputation_flag. Editorial honesty applies identically to vendors who submit themselves and vendors we discover through other means.
      </p>

      <h2 id="contact">Contact</h2>

      <ul>
        <li><strong>General questions, corrections:</strong> <a href="mailto:hello@wrenchstack.com">hello@wrenchstack.com</a></li>
        <li><strong>Vendor listings, affiliate inquiries:</strong> <a href="mailto:partners@wrenchstack.com">partners@wrenchstack.com</a></li>
        <li><strong>Pricing benchmark report orders:</strong> <a href="mailto:bilal@wrenchstack.com?subject=Report%20order">bilal@wrenchstack.com</a></li>
        <li><strong>Press, media, syndication:</strong> <a href="mailto:press@wrenchstack.com">press@wrenchstack.com</a></li>
      </ul>

      <p class="not-prose mt-8 rounded-lg border border-slate-200 bg-slate-50 p-4 text-sm text-slate-600">
        <strong class="text-slate-900">Editorial integrity</strong> is what makes the directory useful. If readers cannot trust that the cons section is honest, the reputation flags are documented and the pricing is verified, WrenchStack is not useful to anyone. That is the test we apply to content, scoring, partnerships and methodology.
      </p>

    </section>
  </article>
</Layout>
