---
import Layout from '../../layouts/Layout.astro';
import { tools, verticals, accountingSoftware, paymentProcessors, bankingProviders, financingProviders, insuranceProviders, leadGenPlatforms, payrollServices, marketingAgencies, aiTools } from '../../lib/data';

const stackCats = [accountingSoftware, paymentProcessors, bankingProviders, financingProviders, insuranceProviders, leadGenPlatforms, payrollServices, marketingAgencies, aiTools];
const totalVendorCount = tools.length + stackCats.reduce((s, c) => s + c.length, 0);
const categoryCount = stackCats.length + 1; // + FSM software
const verticalCount = verticals.length;

const intlModules = import.meta.glob('../../data/international/*.json', { eager: true });
const intlMarkets = Object.keys(intlModules).length;
const intlVendorCount = Object.values(intlModules).reduce(
  (s: number, m: any) => s + (m.default?.vendors?.length ?? m.vendors?.length ?? 0),
  0
);

const pageTitle = 'Submit your product for review | WrenchStack vendor program';
const pageDescription = 'WrenchStack accepts submissions from trades-contractor vendors across software, lead-gen, insurance, payroll, and marketing agencies. Published methodology. No pay-to-play.';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'For vendors', url: '/for-vendors/' },
];

const WEB3FORMS_ACCESS_KEY = (import.meta.env.PUBLIC_WEB3FORMS_KEY as string | undefined) ?? 'b5170603-ae15-4e9d-b2a3-10e0bef38253';
---

<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>
  <article class="mx-auto max-w-4xl px-4 py-12">

    <header class="mb-10">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-orange-600">For vendors</p>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">
        Submit your product for editorial review
      </h1>
      <p class="mt-4 text-lg text-slate-600 leading-relaxed">
        WrenchStack covers {totalVendorCount} US vendors across {categoryCount} categories, plus {intlVendorCount} listings across {intlMarkets} international markets, serving trades and construction businesses. If your platform serves the trades and you believe it deserves coverage, submit it below. We reply in writing, by email.
      </p>
    </header>

    <section class="mb-10 grid gap-3 grid-cols-2 sm:grid-cols-4">
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">{totalVendorCount}</div>
        <div class="mt-1 text-xs text-slate-600">US vendors listed</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">{verticalCount}</div>
        <div class="mt-1 text-xs text-slate-600">Trade verticals served</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">{intlMarkets}</div>
        <div class="mt-1 text-xs text-slate-600">International markets</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">{categoryCount}</div>
        <div class="mt-1 text-xs text-slate-600">US categories</div>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="mb-5 text-2xl font-bold text-slate-900">How editorial review works</h2>
      <div class="grid gap-4 md:grid-cols-2">
        <div class="rounded-lg border border-slate-200 bg-white p-5">
          <div class="mb-2 text-xs font-bold uppercase tracking-wider text-orange-600">1. Submit</div>
          <p class="text-sm text-slate-700 leading-relaxed">
            Send us your company name, website, primary trade verticals served, distinguishing characteristics vs comparable vendors, and current customer count. Form below, or email <a href="mailto:partners@wrenchstack.com" class="text-orange-600 hover:underline">partners@wrenchstack.com</a> directly.
          </p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-5">
          <div class="mb-2 text-xs font-bold uppercase tracking-wider text-orange-600">2. Editorial review</div>
          <p class="text-sm text-slate-700 leading-relaxed">
            We evaluate whether your platform fits an existing category and reply with a fit assessment, a link to the methodology and any clarifying questions.
          </p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-5">
          <div class="mb-2 text-xs font-bold uppercase tracking-wider text-orange-600">3. Data collection</div>
          <p class="text-sm text-slate-700 leading-relaxed">
            Pricing tiers verified directly from your public pricing page. Feature list compiled from documentation and product pages. Reputation checked against regulator orders, court records, BBB profiles and your published terms. <a href="/methodology/" class="text-orange-600 hover:underline">Full methodology →</a>
          </p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-5">
          <div class="mb-2 text-xs font-bold uppercase tracking-wider text-orange-600">4. Publication</div>
          <p class="text-sm text-slate-700 leading-relaxed">
            If the evaluation ends in a listing, the entry follows the format of its section. US entries carry long-form editorial, pros and cons, pricing, FAQs and a verified date; field-service software reviews also carry the WrenchStack Fit Score™. International market entries are shorter profiles with pros, cons, pricing and a market note. An evaluation can also end without a listing.
          </p>
        </div>
      </div>
    </section>

    <section class="mb-10 rounded-lg border-2 border-emerald-200 bg-emerald-50 p-6">
      <h2 class="mb-3 text-lg font-bold text-emerald-900">What inclusion means (and doesn't)</h2>
      <ul class="space-y-2 text-sm text-emerald-900 leading-relaxed">
        <li><strong>✓ Inclusion is editorial.</strong> We evaluate, write, and publish the same way whether or not you have an affiliate program, and whether or not you buy a pricing benchmark report from us.</li>
        <li><strong>✓ Same methodology applies.</strong> Your listing follows the same rules as every other vendor in your category, and field-service software is ranked with the same WrenchStack Fit Score™ formula.</li>
        <li><strong>✓ Affiliate relationships disclosed.</strong> If you run a program we join, it's flagged in our per-vendor ledger. Recommendation isn't conditional on it.</li>
        <li><strong>✗ Inclusion does not guarantee a positive review.</strong> If our research finds a regulator order, court record, BBB complaint record or contract term that puts contractors at risk, the review documents it with citations.</li>
        <li><strong>✗ Inclusion does not guarantee absence of a reputation_flag.</strong> Reputation flags get attached based on documented patterns regardless of vendor relationship.</li>
        <li><strong>✗ Inclusion is not for sale.</strong> We don't accept payment to be included, to influence ranking, to remove cons, or to soften reputation flags. See <a href="/methodology/" class="underline">methodology</a> for the full list.</li>
      </ul>
    </section>

    <section class="mb-10 rounded-lg border border-slate-200 bg-white p-6">
      <h2 class="mb-2 text-lg font-bold text-slate-900">Already listed? Show it.</h2>
      <p class="text-sm text-slate-700 leading-relaxed">
        If you're already in the directory, you can embed a free <a href="/badges/" class="text-orange-600 hover:underline font-semibold">"Rated on WrenchStack" badge</a> on your site; it links back to your independent review, signals to your customers that a neutral third party assessed you, and costs nothing. Displaying it does not change your listing, your ranking or your score. <a href="/badges/" class="text-orange-600 hover:underline">Get your badge →</a>
      </p>
    </section>

    <section id="submit" class="mb-10 scroll-mt-8">
      <h2 class="mb-5 text-2xl font-bold text-slate-900">Submission form</h2>

      <div class="rounded-lg border-2 border-orange-200 bg-gradient-to-br from-orange-50 to-white p-6">
        <form
          id="vendor-submission-form"
          action="https://api.web3forms.com/submit"
          method="POST"
          class="space-y-5"
        >
          <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
          <input type="hidden" name="subject" value="New vendor submission: WrenchStack" />
          <input type="hidden" name="from_name" value="WrenchStack Vendor Submission" />
          <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="vs-company" class="block text-sm font-semibold text-slate-900">Company name <span class="text-rose-600">*</span></label>
              <input type="text" id="vs-company" name="company_name" required maxlength="80" class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm focus:border-orange-500 focus:outline-none focus:ring-1 focus:ring-orange-500" />
            </div>
            <div>
              <label for="vs-website" class="block text-sm font-semibold text-slate-900">Website URL <span class="text-rose-600">*</span></label>
              <input type="url" id="vs-website" name="website" required placeholder="https://yourcompany.com" class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm focus:border-orange-500 focus:outline-none focus:ring-1 focus:ring-orange-500" />
            </div>
            <div>
              <label for="vs-category" class="block text-sm font-semibold text-slate-900">Category <span class="text-rose-600">*</span></label>
              <select id="vs-category" name="category" required class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm focus:border-orange-500 focus:outline-none focus:ring-1 focus:ring-orange-500">
                <option value="">Select</option>
                <option>Software (FSM / CMMS / Construction PM / CRM)</option>
                <option>Payments / payment processing</option>
                <option>Accounting software</option>
                <option>Business banking</option>
                <option>Financing (consumer / contractor)</option>
                <option>Lead-generation platform</option>
                <option>Business insurance</option>
                <option>Payroll service</option>
                <option>Marketing agency</option>
                <option>AI tools</option>
                <option>International market (specify country below)</option>
                <option>Other (please describe below)</option>
              </select>
            </div>
            <div>
              <label for="vs-trades" class="block text-sm font-semibold text-slate-900">Primary trades served <span class="text-rose-600">*</span></label>
              <input type="text" id="vs-trades" name="trades_served" required placeholder="e.g. HVAC, plumbing, roofing" class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm focus:border-orange-500 focus:outline-none focus:ring-1 focus:ring-orange-500" />
            </div>
            <div>
              <label for="vs-markets" class="block text-sm font-semibold text-slate-900">Geographic markets <span class="text-rose-600">*</span></label>
              <input type="text" id="vs-markets" name="geographic_markets" required placeholder="e.g. US nationwide, UK, AU" class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm focus:border-orange-500 focus:outline-none focus:ring-1 focus:ring-orange-500" />
            </div>
            <div>
              <label for="vs-customers" class="block text-sm font-semibold text-slate-900">Current customer count (approximate)</label>
              <input type="text" id="vs-customers" name="customer_count" placeholder="e.g. 500, 5000, confidential" class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm focus:border-orange-500 focus:outline-none focus:ring-1 focus:ring-orange-500" />
            </div>
          </div>

          <div>
            <label for="vs-pitch" class="block text-sm font-semibold text-slate-900">What makes your platform distinct? <span class="text-rose-600">*</span></label>
            <textarea id="vs-pitch" name="distinguishing_features" required rows="4" minlength="100" maxlength="800" placeholder="What does your platform do better than the obvious comparable vendors? 100-800 characters." class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm focus:border-orange-500 focus:outline-none focus:ring-1 focus:ring-orange-500"></textarea>
          </div>

          <div>
            <label for="vs-affiliate" class="block text-sm font-semibold text-slate-900">Affiliate or partnership program URL (optional)</label>
            <input type="url" id="vs-affiliate" name="affiliate_program_url" placeholder="https://yourcompany.com/affiliate (if any)" class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm focus:border-orange-500 focus:outline-none focus:ring-1 focus:ring-orange-500" />
            <p class="mt-1 text-xs text-slate-500">Optional. Inclusion doesn't depend on affiliate availability.</p>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="vs-name" class="block text-sm font-semibold text-slate-900">Your name <span class="text-rose-600">*</span></label>
              <input type="text" id="vs-name" name="contact_name" required maxlength="60" class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm focus:border-orange-500 focus:outline-none focus:ring-1 focus:ring-orange-500" />
            </div>
            <div>
              <label for="vs-email" class="block text-sm font-semibold text-slate-900">Your email <span class="text-rose-600">*</span></label>
              <input type="email" id="vs-email" name="contact_email" required class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm focus:border-orange-500 focus:outline-none focus:ring-1 focus:ring-orange-500" />
            </div>
            <div>
              <label for="vs-role" class="block text-sm font-semibold text-slate-900">Your role at the company</label>
              <input type="text" id="vs-role" name="contact_role" placeholder="e.g. Founder, Head of Marketing, BD" class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm focus:border-orange-500 focus:outline-none focus:ring-1 focus:ring-orange-500" />
            </div>
            {/*
              Added 2026-09-01. Eight submissions had arrived by this date and we could not
              say how any of them found us, which made every decision about promoting this
              form a guess. One required dropdown turns the next ten into a map.
              Required deliberately: optional fields on a long form go unanswered, and a
              half-empty column answers nothing. A single click is the least friction a
              required field can cost.
            */}
            <div>
              <label for="vs-heard" class="block text-sm font-semibold text-slate-900">How did you find us? <span class="text-rose-600">*</span></label>
              <select id="vs-heard" name="how_did_you_find_us" required class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm focus:border-orange-500 focus:outline-none focus:ring-1 focus:ring-orange-500">
                <option value="">Select one</option>
                <option value="search-own">Search: I was looking for my own product</option>
                <option value="search-competitor">Search: I found a competitor listed here</option>
                <option value="search-category">Search: I was researching the category</option>
                <option value="wrenchstack-contacted">WrenchStack contacted me</option>
                <option value="recommendation">Someone recommended you</option>
                <option value="social">Social (X, LinkedIn, Reddit, forum)</option>
                <option value="product-hunt">Product Hunt</option>
                <option value="newsletter-article">A newsletter or article</option>
                <option value="ai-assistant">An AI assistant suggested you</option>
                <option value="other">Something else</option>
              </select>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-3">
            <button type="submit" class="rounded-md bg-orange-500 px-6 py-3 text-sm font-semibold text-white hover:bg-orange-600 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:ring-offset-2">
              Submit for editorial review →
            </button>
            <p class="text-xs text-slate-500">
              We reply by email. By submitting you confirm the information provided is accurate.
            </p>
          </div>

          <div id="vendor-submission-status" class="hidden rounded-md border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-900">
            Thanks. Your submission was received. Replies go to the email you provided.
          </div>
        </form>

        <script>
          (() => {
            const form = document.getElementById('vendor-submission-form');
            const status = document.getElementById('vendor-submission-status');
            if (!form || !status) return;
            form.addEventListener('submit', async (e) => {
              e.preventDefault();
              const fd = new FormData(form as HTMLFormElement);
              if (fd.get('botcheck')) return;
              try {
                const res = await fetch((form as HTMLFormElement).action, {
                  method: 'POST',
                  body: fd,
                  headers: { Accept: 'application/json' },
                });
                const data = await res.json();
                if (data.success) {
                  (form as HTMLFormElement).reset();
                  (form as HTMLFormElement).style.display = 'none';
                  status.classList.remove('hidden');
                } else {
                  alert('Submission failed: ' + (data.message || 'unknown error'));
                }
              } catch (err) {
                alert('Submission failed. Please email partners@wrenchstack.com instead.');
              }
            });
          })();
        </script>
      </div>
    </section>

    <section class="mb-10 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-3 text-lg font-bold text-slate-900">Frequently asked by vendors</h2>
      <div class="space-y-3">
        <details class="rounded-lg border border-slate-200 bg-white p-4">
          <summary class="cursor-pointer font-semibold text-slate-900">Do I have to pay to be listed?</summary>
          <p class="mt-3 text-sm text-slate-700">No. Inclusion is editorial and free. We do not accept payment for inclusion, ranking, awards, or content modifications. Where we have an affiliate relationship with a listed vendor, it's disclosed transparently in our per-vendor ledger.</p>
        </details>
        <details class="rounded-lg border border-slate-200 bg-white p-4">
          <summary class="cursor-pointer font-semibold text-slate-900">How long does editorial review take?</summary>
          <p class="mt-3 text-sm text-slate-700">It varies by submission. We reply by email with a fit assessment and any clarifying questions. Whether a listing follows, and when, depends on the evaluation; some submissions end without one.</p>
        </details>
        <details class="rounded-lg border border-slate-200 bg-white p-4">
          <summary class="cursor-pointer font-semibold text-slate-900">Can I review or approve the editorial before it publishes?</summary>
          <p class="mt-3 text-sm text-slate-700">No. Vendor review/approval would undermine editorial independence. We do verify factual claims against your public materials (pricing pages, documentation) and welcome corrections to factual errors after publication.</p>
        </details>
        <details class="rounded-lg border border-slate-200 bg-white p-4">
          <summary class="cursor-pointer font-semibold text-slate-900">What if the review surfaces concerns about our product?</summary>
          <p class="mt-3 text-sm text-slate-700">Our reviews include both pros and cons; sometimes the cons are significant. Where a regulator order, court record, BBB profile or the vendor's own terms supports a reputation_flag, the warning appears prominently. Concerns get cited to documented sources.</p>
        </details>
        <details class="rounded-lg border border-slate-200 bg-white p-4">
          <summary class="cursor-pointer font-semibold text-slate-900">Can I update my listing after publication?</summary>
          <p class="mt-3 text-sm text-slate-700">Yes. For factual updates (pricing changes, new features, new integrations, geographic expansion), email <a href="mailto:partners@wrenchstack.com" class="text-orange-600 hover:underline">partners@wrenchstack.com</a> with documentation. Pricing is verified on a monthly cycle, as the <a href="/methodology/" class="text-orange-600 hover:underline">methodology</a> sets out, and documented factual updates are applied once confirmed. Buying a report is not needed for this.</p>
        </details>
        <details class="rounded-lg border border-slate-200 bg-white p-4">
          <summary class="cursor-pointer font-semibold text-slate-900">Do you cover international vendors?</summary>
          <p class="mt-3 text-sm text-slate-700">Yes. Alongside US coverage, we run {intlMarkets} international markets: the UK, Canada, Australia, New Zealand, Ireland, the six GCC states, South Africa, France, Morocco, Jordan, Egypt and Malaysia, with Arabic-language pages for the UAE, Saudi Arabia, Kuwait, Qatar, Jordan and Egypt, and French-language pages for France and Morocco. International entries are shorter profiles than US reviews. Non-US vendors are welcome to submit; the editorial timeline depends on category readiness in your market.</p>
        </details>
        <details class="rounded-lg border border-slate-200 bg-white p-4">
          <summary class="cursor-pointer font-semibold text-slate-900">Does buying a pricing benchmark report affect my listing?</summary>
          <p class="mt-3 text-sm text-slate-700">No. Whether a vendor bought a report is not an input to any listing, Fit Score, ranking, award or reputation flag, or to whether a product is listed. Each sale is listed in the <a href="/methodology/#report-ledger" class="text-orange-600 hover:underline">report ledger</a> with the buyer's Fit Score, rank, award and reputation flag when it ordered and today, so anyone can check. See <a href="#reports" class="text-orange-600 hover:underline">pricing benchmark reports</a>.</p>
        </details>
      </div>
    </section>

    {/* Pricing benchmark reports (offers/pricing-benchmark/decisions/site_copy.md A2). This text departs from
        site_copy.md A2 in three places, on 5 October 2026: payment is by invoice paid by USD wire
        (route change, decisions/route/ROUTE.md); the invoice states the delivery time counted from
        the day the payment arrives, because a wire's arrival date is not known when the invoice is sent;
        and re-read prices go through the same second check as routine re-checks (DECISIONS.md decision 6,
        as-of rule). site_copy.md A2 and D still need the same edits before they are the single source again. */}
    <section id="reports" class="mb-10 scroll-mt-8">
      <h2 class="mb-3 text-2xl font-bold text-slate-900">Pricing benchmark reports</h2>
      <p class="text-sm font-semibold text-slate-900 leading-relaxed">
        Buying a report is separate from a listing. The submission form above is free and does not depend on it.
      </p>
      <p class="mt-3 text-sm text-slate-700 leading-relaxed">
        A pricing benchmark report shows where your product's published price and packaging sit against the other platforms on one of our trade pages. It is written from vendors' public pages and our published data. Each price in it is read from the vendor's own page while the report is written, where that page can be read; where it cannot, the report says so and shows the page used and the date it was last read. Every price carries the date it was read.
      </p>

      <div class="mt-5 grid gap-4 md:grid-cols-2">
        <div class="rounded-lg border border-slate-200 bg-white p-5">
          <div class="mb-2 text-xs font-bold uppercase tracking-wider text-orange-600">What it contains</div>
          <ul class="list-disc space-y-1 pl-5 text-sm text-slate-700 leading-relaxed">
            <li>Every platform on our page for that trade, in page order, with its published starting price, its pricing model (per seat, per company, base plus users, free tier or quote only), the billing term behind that price and the date the price was read.</li>
            <li>Each platform's price ladder: tier prices, the users each tier includes, added-user prices and which tiers are priced by quote.</li>
            <li>What each pricing page puts in a higher tier or prices separately (accounting, routing, texting and phone, AI, customer portal, payments, fleet tracking), and the setup fees and contract terms the pages state.</li>
            <li>What the quote-only platforms say their quote is based on.</li>
            <li>The medians for that trade, overall and by pricing model, with the number of platforms behind each figure.</li>
            <li>Your product's published price, packaging and pricing terms placed against the field, from your public pages and your WrenchStack listing.</li>
          </ul>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-5">
          <div class="mb-2 text-xs font-bold uppercase tracking-wider text-orange-600">Price, delivery and ordering</div>
          <ul class="list-disc space-y-1 pl-5 text-sm text-slate-700 leading-relaxed">
            <li><strong>$249 per report</strong>, for one trade, in US dollars. The same price for every vendor and every trade.</li>
            <li>A PDF in English, delivered by email. The invoice states the delivery time in business days, counted from the day your payment arrives. You can cancel for a full refund until the report is delivered, and also if it is late. A refund is sent by bank transfer (USD wire) to the account you name; each party pays its own bank's charges.</li>
            <li>Questions go by email. There are no calls or meetings.</li>
            <li>To order, email <a href="mailto:bilal@wrenchstack.com?subject=Report%20order" class="text-orange-600 hover:underline">bilal@wrenchstack.com</a> with a subject starting "Report order", your product name, the trade and the email address for the invoice. We reply with an invoice that states the delivery time and your product's Fit Score, rank, award and reputation flag on that trade page that day. The invoice is paid by bank transfer (USD wire) to the account named on it, due on receipt. We add no fee; each party pays its own bank's charges. Work starts when the funds arrive.</li>
            <li>We do not quote, invoice or take an order while an evaluation, a correction, a pricing question, a dispute or a reputation-flag review is open between your company and us, or within 30 days after the latest listing verdict, correction or reputation-flag email we sent you. If you ask during that time, we reply with the date from which we can take the order, or with this rule if that date is not yet known.</li>
            <li>To see the format first, ask the same address for the sample: a pest control excerpt covering 6 platforms, with the vendor section shown as a template.</li>
            <li>Every report is sold under the <a href="/report-terms/" class="text-orange-600 hover:underline">report terms</a>.</li>
          </ul>
        </div>
      </div>

      <div class="mt-4 rounded-lg border border-slate-200 bg-white p-5">
        <div class="mb-2 text-xs font-bold uppercase tracking-wider text-orange-600">What it is not</div>
        <ul class="list-disc space-y-1 pl-5 text-sm text-slate-700 leading-relaxed">
          <li>Not a listing, and not a route to one.</li>
          <li>Not a ranking change, a Fit Score change or an award.</li>
          <li>Not a review of your product.</li>
          <li>Not a consulting call, and not advice on how to rank on WrenchStack.</li>
          <li>Not a forecast or a guarantee of any result.</li>
        </ul>
      </div>

      <div class="mt-4 rounded-lg border-2 border-emerald-200 bg-emerald-50 p-6">
        <h3 class="mb-3 text-lg font-bold text-emerald-900">How reports are kept apart from rankings</h3>
        <ul class="space-y-2 text-sm text-emerald-900 leading-relaxed">
          <li><strong>✓ Not an input.</strong> Whether a vendor bought a report is not an input to any listing, Fit Score, ranking, award or reputation flag, or to whether a product is listed. No vendor pays for placement or scores.</li>
          <li><strong>✓ Every sale is public.</strong> Each sale is listed in the <a href="/methodology/#report-ledger" class="underline">report ledger</a>: company and product, trade, month, price, order status, and the product's Fit Score, rank, award and reputation flag when it ordered and today, with the cause of any difference. Refunded orders stay listed. The buyer's tool page notes the order, and each trade page that lists the buyer counts it.</li>
          <li><strong>✓ Same data for everyone.</strong> Prices we re-read while writing a report go through the same second check of the vendor's page as routine re-checks and are updated on the site for every platform in that trade, buyer or not, no later than the day the report is delivered. What we find on a vendor's own pages is corrected on that vendor's WrenchStack listing, with the date, whether or not it buys.</li>
          <li><strong>✗ No inside track.</strong> A buyer gets no preview of anything we publish, no advance notice of ranking changes and no say over what we publish.</li>
          <li><strong>✗ No ranking advice.</strong> A report does not explain or recalculate any Fit Score and does not say how any vendor could change its position. Whether a product publishes a price is one of the three Fit Score factors (pricing transparency, 20%, set out on the <a href="/methodology/" class="underline">methodology page</a>); the report describes published pricing for every platform, the buyer's included, and computes no score.</li>
          <li><strong>✗ No sale during an open editorial matter.</strong> We do not take an order while an evaluation, correction, pricing question, dispute or reputation-flag review with that vendor is open, or within 30 days after the latest verdict, correction or reputation-flag email we sent it.</li>
        </ul>
      </div>
