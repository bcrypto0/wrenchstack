---
import Layout from '../layouts/Layout.astro';
import { EN_MARKET_HREFLANG, intlVendorOnlyCount, intlCertificationCount, intlMarketCount } from '../lib/intl';
import categories from '../data/categories.json';
import toolsData from '../data/tools.json';
import featuresData from '../data/features.json';
import { tools, toolsForVertical, freshnessStats, directoryVerifiedWithinDays, daysSinceVerified, formatPrice, getTool, awards, usVendorLists, totalReputationFlags, leadGenPlatforms, insuranceProviders, payrollServices, marketingAgencies, aiTools, paymentProcessors, financingProviders, accountingSoftware, bankingProviders } from '../lib/data';
import FreshnessBadge from '../components/FreshnessBadge.astro';

const verticals = categories.verticals;
const toolCount = tools.length;
const leadGenCount = leadGenPlatforms.length;
const insuranceCount = insuranceProviders.length;
const payrollCount = payrollServices.length;
const agencyCount = marketingAgencies.length;
// One number system, generated from the data (audit 2026-08-27: the homepage
// sold a 5-category product while the site had grown to 10 categories plus
// international; every public surface now derives from these three counts).
const adjacentCount = leadGenCount + insuranceCount + payrollCount + agencyCount +
  aiTools.length + paymentProcessors.length + financingProviders.length +
  accountingSoftware.length + bankingProviders.length;
// International 'certification' entries (licensing bodies, tax offices, regulators,
// codes) are not vendors, so "vendors tracked" leaves them out (2026-10-01).
const totalVendorCount = toolCount + adjacentCount + intlVendorOnlyCount;
// Computed (2026-10-01): the stats row hard-coded "10 US categories", the awards
// card "18 categories" and the feature link "All 20 features".
const usCategoryCount = usVendorLists().length;
const flagCount = totalReputationFlags();
const awardCount = awards.categories.length;
const awardsPublished = new Date(awards.published_date + 'T00:00:00Z').toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  timeZone: 'UTC',
});
// The hero's 30-day count is computed at build time, so it is anchored to the build
// date (2026-10-01): "in the last 30 days" was true only on the day of the deploy.
const buildDateLabel = new Date().toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});

// Compute most-recent pricing-verified date across all tools (for the "Last refreshed" indicator).
const lastVerifiedDate = tools
  .map((t) => t.pricing.verified_date)
  .filter(Boolean)
  .sort()
  .at(-1) ?? new Date().toISOString().slice(0, 10);
const formattedLastVerified = new Date(lastVerifiedDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Live freshness stats: surfacing this on the homepage is our direct
// attack on competitors' staleness (Capterra ServiceTitan profile last
// updated Aug 2025 = 9 months stale at time of this writing).
const freshness = freshnessStats();

// 6 most-recently-verified tools (lowest days-since-verified). Surfaces
// our freshness discipline directly on the homepage.
const recentlyVerified = [...tools]
  .sort((a, b) => daysSinceVerified(a) - daysSinceVerified(b))
  .slice(0, 6);

// Tool count per vertical (for the "Pick your trade" cards)
const verticalsWithCounts = verticals.map((v) => ({
  ...v,
  toolCount: toolsForVertical(v.slug).length,
}));

// Featured head-to-head comparisons: hand-picked pairs of well-known tools.
// Each pair must share at least one vertical so the comparison page exists.
// The line under each label is computed from the tools data (2026-10-01): the
// hand-written lines claimed search volume ("most-searched") and positions
// ("residential leader", "enterprise reporting") that no data supported.
const featuredComparisons = [
  { a: 'jobber', b: 'housecall-pro', label: 'Jobber vs Housecall Pro' },
  { a: 'jobber', b: 'servicetitan', label: 'Jobber vs ServiceTitan' },
  { a: 'housecall-pro', b: 'servicetitan', label: 'Housecall Pro vs ServiceTitan' },
  { a: 'fieldedge', b: 'servicetitan', label: 'FieldEdge vs ServiceTitan' },
  { a: 'buildops', b: 'servicetitan', label: 'BuildOps vs ServiceTitan' },
  { a: 'buildertrend', b: 'procore', label: 'Buildertrend vs Procore' },
  { a: 'acculynx', b: 'jobnimbus', label: 'AccuLynx vs JobNimbus' },
  { a: 'workiz', b: 'jobber', label: 'Workiz vs Jobber' },
].map((c) => {
  const ta = getTool(c.a);
  const tb = getTool(c.b);
  const context = ta && tb ? `${ta.name}: ${formatPrice(ta)} · ${tb.name}: ${formatPrice(tb)}` : '';
  return { ...c, context };
});

// Helper to build comparison URL; slugs must be sorted alphabetically (template convention)
function comparisonUrl(a: string, b: string): string {
  const [first, second] = [a, b].sort();
  return `/compare/${first}-vs-${second}/`;
}

// Featured features: surface the new features axis with highest-value entries
const features = (featuresData as { features: Record<string, { name: string; definition: string }> }).features;
const featureCount = Object.keys(features).length;
const featuredFeatures = [
  'quickbooks_integration',
  'ai_dispatcher',
  'consumer_financing',
  'membership_management',
  'online_booking',
  'gps_tracking',
];

function featureToUrl(slug: string): string {
  return slug.replace(/_/g, '-');
}
---

<Layout
  title="WrenchStack | The trades vendor directory: software, lead-gen, insurance, payroll, marketing"
  description={`Independent reviews of ${totalVendorCount} vendors: ${toolCount} field-service platforms, ${adjacentCount} adjacent US vendors (insurance, payroll, lead-gen, payments, financing, banking, accounting, agencies, AI), and ${intlVendorOnlyCount} vendors across ${intlMarketCount} international markets. Sourced reputation flags. Dated prices from vendor pages. No lead-gen sales calls.`}
  alternateUrls={EN_MARKET_HREFLANG}
>
  <section class="bg-gradient-to-b from-white to-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-28">
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 md:text-6xl">
        The software and services contractors buy,<br />
        reviewed honestly.
      </h1>
      <p class="mt-6 max-w-3xl text-lg text-slate-600 md:text-xl">
        An independent directory of the vendors trades contractors buy from: {toolCount} field-service platforms, {adjacentCount} adjacent US vendors (lead-gen, insurance, payroll, payments, financing, banking, accounting, agencies, AI tools), and {intlVendorOnlyCount} vendors (plus {intlCertificationCount} licensing, tax and regulatory entries) across {intlMarketCount} international markets. {flagCount} US vendors carry a reputation warning that cites its source.
      </p>

      <div class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium text-slate-600">
        <span><span class="font-bold text-slate-900">{totalVendorCount}</span> vendors tracked</span>
        <span class="text-slate-300">·</span>
        <span><span class="font-bold text-slate-900">{usCategoryCount}</span> US categories</span>
        <span class="text-slate-300">·</span>
        <span><span class="font-bold text-slate-900">{verticals.length}</span> trades</span>
        <span class="text-slate-300">·</span>
        <span><span class="font-bold text-slate-900">{intlMarketCount}</span> international markets</span>
        <span class="text-slate-300">·</span>
        <a href="/verification-log/" class="inline-flex items-center gap-1.5 hover:text-slate-900">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 ring-2 ring-emerald-200"></span>
          <span class="font-bold text-slate-900">{directoryVerifiedWithinDays(30)}</span> entries verified in the 30 days to {buildDateLabel}
        </a>
      </div>
      <p class="mt-5 max-w-2xl text-sm text-slate-500 leading-relaxed">
        Independent. We may earn an affiliate commission when you sign up with some software vendors through our links, but <strong class="font-semibold text-slate-700">vendors can't pay for a higher score or to be featured</strong>, and a reputation warning goes on a vendor only when a regulator order, court record, BBB profile or the vendor's own terms supports it. <a href="/methodology/" class="underline hover:text-slate-700">How we rate</a> · <a href="/disclosure/" class="underline hover:text-slate-700">how we make money</a>.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/quiz/"
          class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-orange-600"
        >
          Take the matching quiz →
        </a>
        <a
          href="/tools/"
          class="rounded-md bg-slate-900 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-slate-800"
        >
          Browse software
        </a>
        <a
          href="/lead-gen/"
          class="rounded-md border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:border-slate-400"
        >
          Lead-gen platforms
        </a>
      </div>
    </div>
  </section>

  <section class="bg-white border-t border-slate-100">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <div class="mb-8 flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Pick your category</h2>
        <a href="/methodology/" class="text-sm font-medium text-orange-600 hover:underline">How we rate →</a>
      </div>
      <p class="mb-8 max-w-3xl text-slate-600">
        Five of the {usCategoryCount} US categories we cover. The others: <a href="/payments/" class="underline hover:text-slate-900">payments</a>, <a href="/financing/" class="underline hover:text-slate-900">financing</a>, <a href="/banking/" class="underline hover:text-slate-900">banking</a>, <a href="/accounting/" class="underline hover:text-slate-900">accounting</a> and <a href="/ai-tools/" class="underline hover:text-slate-900">AI tools</a>.
      </p>
      <div class="grid gap-4 md:grid-cols-3 lg:grid-cols-5">
        <a href="/tools/" class="group rounded-lg border-2 border-slate-200 bg-white p-5 transition hover:border-orange-400 hover:shadow-sm">
          <div class="text-xs font-bold uppercase tracking-wider text-orange-600">Software</div>
          <div class="mt-2 text-2xl font-bold text-slate-900 group-hover:text-orange-600">{toolCount} tools</div>
          <p class="mt-2 text-sm text-slate-600 leading-snug">Field service, CMMS, construction PM, CRM: the operational stack.</p>
        </a>
        <a href="/lead-gen/" class="group rounded-lg border-2 border-slate-200 bg-white p-5 transition hover:border-orange-400 hover:shadow-sm">
          <div class="text-xs font-bold uppercase tracking-wider text-orange-600">Lead-gen</div>
          <div class="mt-2 text-2xl font-bold text-slate-900 group-hover:text-orange-600">{leadGenCount} platforms</div>
          <p class="mt-2 text-sm text-slate-600 leading-snug">Google LSA, Service Direct, Thumbtack, and sourced warnings on Bark, HomeAdvisor and Angi.</p>
        </a>
        <a href="/insurance/" class="group rounded-lg border-2 border-slate-200 bg-white p-5 transition hover:border-orange-400 hover:shadow-sm">
          <div class="text-xs font-bold uppercase tracking-wider text-orange-600">Insurance</div>
          <div class="mt-2 text-2xl font-bold text-slate-900 group-hover:text-orange-600">{insuranceCount} providers</div>
          <p class="mt-2 text-sm text-slate-600 leading-snug">ERGO NEXT, Hiscox, Simply Business, Acuity, Erie: direct carriers, brokers and mutuals.</p>
        </a>
        <a href="/payroll/" class="group rounded-lg border-2 border-slate-200 bg-white p-5 transition hover:border-orange-400 hover:shadow-sm">
          <div class="text-xs font-bold uppercase tracking-wider text-orange-600">Payroll</div>
          <div class="mt-2 text-2xl font-bold text-slate-900 group-hover:text-orange-600">{payrollCount} services</div>
          <p class="mt-2 text-sm text-slate-600 leading-snug">Online payroll (Gusto, OnPay, Patriot), Hourly.io, and legacy payroll such as ADP Run and Paychex Flex.</p>
        </a>
        <a href="/agencies/" class="group rounded-lg border-2 border-slate-200 bg-white p-5 transition hover:border-orange-400 hover:shadow-sm">
          <div class="text-xs font-bold uppercase tracking-wider text-orange-600">Agencies</div>
          <div class="mt-2 text-2xl font-bold text-slate-900 group-hover:text-orange-600">{agencyCount} agencies</div>
          <p class="mt-2 text-sm text-slate-600 leading-snug">Hook Agency, Plumbing & HVAC SEO, and sourced contract warnings on Townsquare Interactive and Marketing 360.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-4 py-12">
      <div class="mb-6 flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Recently verified pricing</h2>
        <a href="/methodology/" class="text-sm font-medium text-orange-600 hover:underline">How we verify →</a>
      </div>
      <p class="mb-6 text-slate-600">
        Each software tool's price carries the date we last verified it. These are the tools verified most recently, with the date stamp underneath. Capterra's ServiceTitan profile, by comparison, is dated August 2025.
      </p>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {recentlyVerified.map((t) => {
          return (
            <a
              href={`/tools/${t.slug}/`}
              class="group rounded-lg border border-slate-200 bg-white p-4 transition hover:border-orange-400 hover:shadow-sm"
            >
              <div class="flex items-baseline justify-between gap-2">
                <div class="font-semibold text-slate-900 group-hover:text-orange-600">{t.name}</div>
              </div>
              <div class="mt-1 text-xs text-slate-500">{formatPrice(t)}</div>
              <div class="mt-2 border-t border-slate-100 pt-2">
                <FreshnessBadge tool={t} variant="compact" />
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="mb-2 text-2xl font-bold tracking-tight text-slate-900">Pick your trade</h2>
    <p class="mb-8 text-slate-600">
      Each trade page ranks the platforms that serve that trade, with prices, key features and links to head-to-head comparisons.
    </p>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {verticalsWithCounts.map((v) => (
        <a
          href={`/${v.slug.replace(/_/g, '-')}/`}
          class="group rounded-lg border border-slate-200 bg-white p-5 transition hover:border-slate-400 hover:shadow-sm"
        >
          <div class="flex items-center justify-between">
            <h3 class="text-lg font-semibold text-slate-900 group-hover:text-orange-600">
              {v.name}
            </h3>
            <span class="text-slate-400 group-hover:text-orange-600">→</span>
          </div>
          <p class="mt-1 text-sm text-slate-500">
            {v.toolCount} {v.toolCount === 1 ? 'tool' : 'tools'} ranked · pricing, features, head-to-head
          </p>
        </a>
      ))}
    </div>
  </section>

  <section class="bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <h2 class="mb-2 text-2xl font-bold tracking-tight text-slate-900">Head-to-head comparisons</h2>
      <p class="mb-8 text-slate-600">
        Selected pairs that share at least one trade, with their prices side by side.
      </p>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {featuredComparisons.map((c) => (
          <a
            href={comparisonUrl(c.a, c.b)}
            class="group rounded-lg border border-slate-200 bg-white p-5 transition hover:border-orange-400 hover:shadow-sm"
          >
            <h3 class="text-base font-semibold text-slate-900 group-hover:text-orange-600">
              {c.label}
            </h3>
            <p class="mt-2 text-xs text-slate-500 leading-snug">
              {c.context}
            </p>
          </a>
        ))}
      </div>
      <div class="mt-6 text-center">
        <a href="/compare/" class="text-sm font-semibold text-orange-600 hover:underline">
          More comparisons →
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="mb-2 text-2xl font-bold tracking-tight text-slate-900">Browse by feature</h2>
    <p class="mb-8 text-slate-600">
      Have a specific must-have feature? Jump straight to tools that have it.
    </p>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {featuredFeatures.map((slug) => (
        <a
          href={`/features/${featureToUrl(slug)}/`}
          class="group rounded-lg border border-slate-200 bg-white p-5 transition hover:border-orange-400 hover:shadow-sm"
        >
          <h3 class="font-semibold text-slate-900 group-hover:text-orange-600">
            {features[slug].name}
          </h3>
          <p class="mt-1 text-sm text-slate-500 leading-snug">
            {features[slug].definition}
          </p>
        </a>
      ))}
    </div>
    <div class="mt-6 text-center">
      <a href="/features/" class="text-sm font-semibold text-orange-600 hover:underline">
        All {featureCount} features →
      </a>
    </div>
  </section>

  <section class="bg-white border-t border-slate-100">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <h2 class="mb-3 text-2xl font-bold tracking-tight text-slate-900">
        The editorial position no competitor can copy
      </h2>
      <p class="mb-8 max-w-3xl text-slate-600">
        WrenchStack compares vendors for trades businesses in {usCategoryCount} US categories, with the same independence rules and reputation-warning standards in each. We name regulator orders and settlements with their sources, and we list carriers we earn nothing from on the same terms as the rest.
      </p>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-lg border border-rose-200 bg-rose-50 p-5">
          <div class="mb-2 text-xs font-bold uppercase tracking-wider text-rose-700">⚠ Reputation warnings, with sources</div>
          <p class="text-sm text-rose-900 leading-relaxed">
            HomeAdvisor's <strong>FTC order of up to $7.2M</strong>. Angi's Vermont Attorney General settlement. GreenSky's CFPB consent order. Townsquare Interactive's and Marketing 360's contract terms. BBB records for Bark, BuildZoom and Pie Insurance. We name them and cite the source.
          </p>
        </div>
        <div class="rounded-lg border border-emerald-200 bg-emerald-50 p-5">
          <div class="mb-2 text-xs font-bold uppercase tracking-wider text-emerald-700">✓ We list the unaffiliated</div>
          <p class="text-sm text-emerald-900 leading-relaxed">
            We have no affiliate arrangement with <strong>Acuity Insurance</strong>, <strong>Erie Insurance</strong> or <strong>Google Local Services Ads</strong>, so we earn nothing from them, and they are listed on the same terms as every other vendor. Commission does not decide what we list or how we rank it.
          </p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-slate-50 p-5">
          <div class="mb-2 text-xs font-bold uppercase tracking-wider text-slate-700">📋 Verified, transparent, dated</div>
          <p class="text-sm text-slate-700 leading-relaxed">
            Each software tool's price shows the date we last verified it. Every software tool's affiliate status is in our <a href="/methodology/#affiliate-ledger" class="underline hover:text-slate-900">per-vendor ledger</a>, and reviews in the other categories state it on the page. The <a href="/methodology/">WrenchStack Fit Score</a> formula is published and applied the same way to every software tool.
          </p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-5">
          <div class="mb-2 text-xs font-bold uppercase tracking-wider text-slate-700">🛠 Decision tools</div>
          <p class="text-sm text-slate-700 leading-relaxed">
            Filter the <a href="/tools/" class="text-orange-600 hover:underline">software directory</a> by trade, price, team size and QuickBooks or Stripe support. Or use the <a href="/quiz/" class="text-orange-600 hover:underline">matching quiz</a>, the <a href="/roi-calculator/" class="text-orange-600 hover:underline">ROI calculator</a> and the <a href="/cost-of-switch/" class="text-orange-600 hover:underline">cost-of-switch calculator</a>.
          </p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-5">
          <div class="mb-2 text-xs font-bold uppercase tracking-wider text-slate-700">🏆 WrenchStack Awards 2026</div>
          <p class="text-sm text-slate-700 leading-relaxed">
            Editorial designations across {awardCount} categories, published {awardsPublished}, when the Fit Score still included third-party review ratings; the winners have not been re-selected since. <a href="/awards/2026/" class="text-orange-600 hover:underline">No vendor paid for placement</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-slate-900 text-white">
    <div class="mx-auto max-w-4xl px-4 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight md:text-4xl">
        Not sure where to start?
      </h2>
      <p class="mt-4 text-lg text-slate-300">
        Answer 5 questions about your trade, team size, budget, top priority and key integration,
        and get ranked picks. Or browse by category below.
      </p>
      <a
        href="/quiz/"
        class="mt-8 inline-block rounded-md bg-orange-500 px-6 py-4 text-base font-semibold text-white hover:bg-orange-600"
      >
        Start the matching quiz →
      </a>
      <p class="mt-4 text-xs text-slate-500">
        No email required. No sales calls. Just answers.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3 text-sm">
        <a href="/tools/" class="rounded-md bg-white/10 px-4 py-2 font-semibold text-white hover:bg-white/20">Software</a>
        <a href="/lead-gen/" class="rounded-md bg-white/10 px-4 py-2 font-semibold text-white hover:bg-white/20">Lead-gen</a>
        <a href="/insurance/" class="rounded-md bg-white/10 px-4 py-2 font-semibold text-white hover:bg-white/20">Insurance</a>
        <a href="/payroll/" class="rounded-md bg-white/10 px-4 py-2 font-semibold text-white hover:bg-white/20">Payroll</a>
        <a href="/agencies/" class="rounded-md bg-white/10 px-4 py-2 font-semibold text-white hover:bg-white/20">Agencies</a>
      </div>
    </div>
  </section>
</Layout>
