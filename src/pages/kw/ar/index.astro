---
import Layout from '../../../layouts/Layout.astro';
import kwData from '../../../data/international/kw.json';

interface KwVendor {
  slug: string; name: string; category: string; vendor_url: string;
  tagline: string; tier: 'S' | 'A' | 'F';
  is_cross_market: boolean;
}
const vendors = (kwData as { vendors: KwVendor[] }).vendors;

// Concise Arabic positioning per vendor (detailed reviews remain in English for now).
const ar: Record<string, string> = {
  'oracle-aconex': 'منصة سحابية من Oracle للتحكم بالوثائق والمراسلات وسير عمل المراجعة في سجل مشترك لجميع أطراف المشروع. الأسعار بطلب عرض سعر.',
  'autodesk-construction-cloud': 'منصة Autodesk للإنشاءات، تُباع منذ مارس ٢٠٢٦ تحت علامة Autodesk Forma: تنسيق النماذج وإدارة الوثائق والحصر والتسعير. لم يُتحقق من وجود موزّع أو مكتب لها في الكويت.',
  'planradar': 'تطبيق لتوثيق الموقع والفحص ومتابعة العيوب بأسعار منشورة لكل مستخدم بالدولار. لا مكتب له في الكويت، وأقرب مكاتبه في دبي.',
  'focus-softnet': 'نظام تخطيط موارد يغطي ميزانيات مشاريع الإنشاءات والمشتريات ومراقبة التكاليف والرواتب، مع Focus CAFM لإدارة المرافق، ومكتب في مدينة الكويت.',
  'in4suite': 'نظام تخطيط موارد للعقارات والإنشاءات من In4Velocity في الهند: الأراضي والمشاريع والمبيعات والتأجير والرواتب. لا مكتب له في الكويت، ومكتبه في الشرق الأوسط في دبي.',
  'matiyas-kuwait': 'منفّذ لنظام ERPNext المفتوح المصدر، يدرج مكتباً في الفحيحيل ويقول إن إعداده يغطي رواتب قانون العمل الكويتي واشتراكات التأمينات الاجتماعية وملفات WPS.',
  'capt': 'الجهاز المركزي للمناقصات العامة: يدير المناقصات الحكومية ويعتمد ترسيتها، وتصنّف لجنته المقاولين العامين في أربع فئات. وأفادت Arab Times في أواخر سبتمبر ٢٠٢٦ بأن المرسوم بقانون رقم ٩٤ لسنة ٢٠٢٦ يعدّل قانون المناقصات.',
  'kuwait-tax': 'ضرائب الكويت (وزارة المالية): ضريبة دخل ١٥٪ على الكيانات الأجنبية، واحتجاز ٥٪ من دفعات العقود حتى تقديم شهادة براءة الذمة الضريبية، ولا ضريبة قيمة مضافة.',
  'pam-kuwaitization': 'الهيئة العامة للقوى العاملة: قانون العمل في القطاع الخاص وأذونات العمل، ونسبة العمالة الكويتية التي تحددها الجهات في العقود الحكومية.',
  'kuwait-municipality': 'بلدية الكويت: رخص البناء وترخيص المكاتب الهندسية إلكترونياً، وأكثر من ٨٥٪ من الخدمات البلدية المباشرة عبر تطبيق سهل (بحسب أرقام البلدية).',
  'kuwait-fire-force': 'قوة الإطفاء الكويتية: تراخيص السلامة من الحريق للمنشآت التجارية والصناعية والتفتيش عليها، واشتراط الرشاشات في جميع مباني السكن الاستثماري.',
};

const tierAr: Record<string, string> = { S: 'أسعار منشورة', A: 'مدرج', F: 'تنبيه بشأن السمعة' };
const cats = [
  { key: 'software', label: 'برامج المقاولات والإنشاءات', desc: 'منصات التحكم بالوثائق ونمذجة معلومات البناء (Oracle Aconex وAutodesk)، وتطبيق فحص الموقع PlanRadar، وأنظمة تخطيط الموارد: Focus Softnet بمكتبها في مدينة الكويت، وIn4Suite للعقارات والإنشاءات، وMatiyas Solutions لإعدادات ERPNext مع رواتب الكويت.' },
  { key: 'certification', label: 'التراخيص والامتثال', desc: 'الجهات الكويتية المدرجة: الجهاز المركزي للمناقصات العامة، وضرائب وزارة المالية، والهيئة العامة للقوى العاملة، وبلدية الكويت، وقوة الإطفاء.' },
];

const enUrl = new URL('/kw/', Astro.site).toString();
const arUrl = new URL('/kw/ar/', Astro.site).toString();
const pageTitle = 'دليل برامج المقاولات والإنشاءات في الكويت';
const pageDescription = 'دليل مستقل لبرامج المقاولات والإنشاءات في الكويت: منصات إدارة المشاريع وأنظمة تخطيط الموارد، مع جهات الترخيص والامتثال المحلية (المناقصات، الضرائب، التكويت، البلدية، تراخيص الإطفاء).';
---

<Layout
  title={pageTitle}
  description={pageDescription}
  lang="ar"
  dir="rtl"
  alternateUrls={[{ hreflang: 'en', href: enUrl }, { hreflang: 'ar', href: arUrl }, { hreflang: 'x-default', href: enUrl }]}
>
  <article class="mx-auto max-w-5xl px-4 py-12">

    <div class="mb-6 flex items-center justify-between gap-3">
      <div class="flex items-center gap-2">
        <span class="text-2xl" aria-hidden="true">🇰🇼</span>
        <p class="text-sm font-semibold uppercase tracking-wider text-orange-600">دولة الكويت</p>
      </div>
      <a href="/kw/" class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">English</a>
    </div>

    <header class="mb-10">
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">دليل برامج المقاولات والإنشاءات في الكويت</h1>
      <p class="mt-4 text-lg text-slate-600 leading-relaxed">
        مراجعات مستقلة لـ {vendors.length} إدراجاً ذا صلة بالسوق الكويتي، منها منصات المشاريع ونمذجة معلومات البناء (Oracle Aconex وAutodesk)، وأنظمة تخطيط الموارد (Focus Softnet وMatiyas Solutions وIn4Suite)، وتطبيق فحص الموقع PlanRadar، مع سياق الامتثال المحلي: المناقصات، والتكويت في العقود الحكومية، والبلدية، وتراخيص الإطفاء. أما شركات التأمين ومنصات معلومات المشاريع فتُعرض في الدليل الإنجليزي.
      </p>
    </header>

    <section class="mb-10 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-3 text-base font-bold text-slate-900">ما الذي يميّز اختيار البرامج في الكويت</h2>
      <p class="text-sm text-slate-700 leading-relaxed">
        أولاً، <strong>لم تطبّق الكويت ضريبة القيمة المضافة</strong>، لذا لا تنطبق هنا ميزات الفوترة الإلكترونية لضريبة القيمة المضافة التي تُباع للسعودية أو الإمارات. أما النقاط الضريبية للمقاول فهي <strong>ضريبة دخل الشركات ١٥٪</strong> على الكيانات الأجنبية وعلى حصة الملكية الأجنبية في الشركات الخليجية (والشركات المملوكة بالكامل لمواطنين كويتيين أو خليجيين معفاة)، و<strong>احتجاز ٥٪</strong> من دفعات العقود حتى تقديم شهادة براءة الذمة الضريبية. ثانياً، تمر المناقصات الحكومية عبر <strong>الجهاز المركزي للمناقصات العامة</strong>، وتصنّف لجنته المقاولين العامين في أربع فئات بحسب القدرة المالية والفنية، وأفادت Arab Times في أواخر سبتمبر ٢٠٢٦ بأن المرسوم بقانون رقم ٩٤ لسنة ٢٠٢٦ يعدّل قانون المناقصات، فراجع قواعد الجهاز بعد نفاذه. ثالثاً، يخضع العمل في القطاع الخاص لـ<strong>الهيئة العامة للقوى العاملة</strong>، وفي العقود الحكومية تحدد كل جهة طارحة للمناقصة نسبة العمالة الكويتية بموجب قرار مجلس الوزراء رقم ١١٧٩ لسنة ٢٠٢٣. رابعاً، في أعمال التشطيب والأعمال الكهروميكانيكية تهمّ تراخيص <strong>قوة الإطفاء</strong>: لا يُرخَّص محل في مبنى مشترك ما لم يحمل المبنى ترخيصاً سارياً. وبعض مزوّدي البرامج المدرجين هنا ليس لهم مكتب في الكويت، فاسأل عن الدعم المحلي قبل الشراء.
      </p>
    </section>

    {cats.map((cat) => {
      const cv = vendors.filter((v) => v.category === cat.key);
      if (cv.length === 0) return null;
      return (
        <section class="mb-12">
          <div class="mb-5">
            <h2 class="text-2xl font-bold text-slate-900">{cat.label}</h2>
            <p class="mt-1 text-sm text-slate-600 leading-relaxed">{cat.desc}</p>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            {cv.map((v) => {
              const isCert = v.category === 'certification';
              const tierColor = v.tier === 'S' ? 'border-emerald-300' : v.tier === 'F' ? 'border-rose-300' : 'border-blue-300';
              const tierBadge = v.tier === 'S' ? 'bg-emerald-100 text-emerald-900' : v.tier === 'F' ? 'bg-rose-100 text-rose-900' : 'bg-blue-100 text-blue-900';
              const label = isCert ? 'جهة رسمية' : tierAr[v.tier];
              return (
                <article class={`rounded-lg border-2 ${tierColor} bg-white p-4`}>
                  <div class="mb-1 flex items-center gap-2 flex-wrap">
                    <h3 class="text-lg font-bold text-slate-900">{v.name}</h3>
                    <span class={`rounded-full px-2 py-0.5 text-xs font-bold ${tierBadge}`}>{label}</span>
                  </div>
                  <p class="text-sm text-slate-700 leading-relaxed">{ar[v.slug] ?? v.tagline}</p>
                  <div class="mt-3 flex flex-wrap gap-2">
                    <a href={`/kw/${v.slug}/`} class="rounded-md bg-slate-900 px-3 py-1.5 text-xs font-semibold text-white hover:bg-slate-700">التفاصيل (بالإنجليزية) ←</a>
                    <a href={v.vendor_url} rel="sponsored nofollow noopener" target="_blank" class="rounded-md bg-orange-500 px-3 py-1.5 text-xs font-semibold text-white hover:bg-orange-600">{isCert ? 'الموقع الرسمي' : 'زيارة الموقع'} ←</a>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      );
    })}

    <section class="mb-10 rounded-lg border border-slate-200 bg-white p-5 text-sm text-slate-600">
      <p>المراجعات التفصيلية لكل إدراج متاحة <a href="/kw/" class="font-medium text-orange-600 hover:underline">بالإنجليزية</a>، ويعرض الدليل الإنجليزي أيضاً شركات التأمين ومنصات معلومات المشاريع.</p>
    </section>

    <section class="rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">هل أنت مزوّد برامج كويتي؟</h2>
      <p class="mt-2 text-slate-300 leading-relaxed">إذا كنت تطوّر برامج للمقاولات أو تخطيط الموارد أو الخدمة الميدانية للسوق الكويتي/الخليجي وترغب في المراجعة أو الإدراج، تواصل معنا عبر <a href="/for-vendors/" class="underline">برنامج المزوّدين</a>.</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/for-vendors/" class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600">العمل معنا ←</a>
        <a href="/kw/" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">English directory</a>
      </div>
    </section>
  </article>
</Layout>
