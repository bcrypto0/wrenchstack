---
import Layout from '../layouts/Layout.astro';
import {
  tools,
  aiTools,
  leadGenPlatforms,
  insuranceProviders,
  payrollServices,
  marketingAgencies,
  paymentProcessors,
  financingProviders,
  accountingSoftware,
  bankingProviders,
} from '../lib/data';

// Proof-of-life page: every verification date in the directory, aggregated at
// build time. A "verified" claim only means something if the dates are alive;
// this page makes the heartbeat public.

interface Dated {
  name: string;
  url: string;
  category: string;
  date: string; // YYYY-MM-DD
}

const all: Dated[] = [];

for (const t of tools) {
  if (t.pricing?.verified_date) {
    all.push({ name: t.name, url: `/tools/${t.slug}/`, category: 'Field service software', date: t.pricing.verified_date });
  }
}
function addCat(
  arr: Array<{ name: string; slug: string; verified_date?: string }>,
  category: string,
  prefix: string
) {
  for (const e of arr) {
    if (e.verified_date) {
      all.push({ name: e.name, url: `/${prefix}/${e.slug}/`, category, date: e.verified_date });
    }
  }
}
addCat(aiTools as unknown as Array<{ name: string; slug: string; verified_date?: string }>, 'AI tools', 'ai-tools');
addCat(leadGenPlatforms, 'Lead generation', 'lead-gen');
addCat(insuranceProviders, 'Insurance', 'insurance');
addCat(payrollServices, 'Payroll', 'payroll');
addCat(marketingAgencies, 'Marketing agencies', 'agencies');
addCat(paymentProcessors, 'Payments', 'payments');
addCat(financingProviders, 'Consumer financing', 'financing');
addCat(accountingSoftware, 'Accounting', 'accounting');
addCat(bankingProviders, 'Business banking', 'banking');

all.sort((a, b) => b.date.localeCompare(a.date));

const buildDate = new Date();
const buildISO = buildDate.toISOString().slice(0, 10);
const daysAgo = (iso: string) =>
  Math.max(0, Math.round((buildDate.getTime() - new Date(iso + 'T00:00:00Z').getTime()) / 86400000));

const within30 = all.filter((d) => daysAgo(d.date) <= 30).length;
const within90 = all.filter((d) => daysAgo(d.date) <= 90).length;
const newest = all.slice(0, 20);

// Month histogram (last 8 months with any activity)
const byMonth = new Map<string, number>();
for (const d of all) {
  const m = d.date.slice(0, 7);
  byMonth.set(m, (byMonth.get(m) ?? 0) + 1);
}
const months = [...byMonth.entries()].sort((a, b) => b[0].localeCompare(a[0])).slice(0, 8);
const monthLabel = (ym: string) => {
  const [y, m] = ym.split('-').map(Number);
  return new Date(Date.UTC(y, m - 1, 1)).toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
};
const maxMonth = Math.max(...months.map(([, n]) => n));

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Verification Log', url: '/verification-log/' },
];
---

<Layout
  title="Verification Log: When Every Price Was Last Checked"
  description={`Live proof of freshness: ${all.length} dated verifications across the WrenchStack directory, ${within90} of them in the last 90 days. Every date on this page comes from the data itself and regenerates on every build.`}
  breadcrumbs={breadcrumbs}
>
  <article class="mx-auto max-w-3xl px-4 py-12 prose prose-slate">
    <div class="not-prose mb-8">
      <p class="mb-2 text-sm font-semibold uppercase tracking-wider text-orange-600">Proof of freshness</p>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl m-0">The verification log</h1>
      <p class="mt-3 text-lg text-slate-600">
        "Verified" only means something if the dates are alive. This page aggregates every verification date in the directory, straight from the data, rebuilt on every deploy. Page generated {buildISO}.
      </p>
    </div>

    <div class="not-prose mb-10 grid grid-cols-1 gap-4 sm:grid-cols-3">
      <div class="rounded-lg border border-slate-200 bg-white p-5 text-center">
        <div class="text-3xl font-bold text-slate-900">{all.length}</div>
        <div class="mt-1 text-xs text-slate-600">dated verifications on record</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-5 text-center">
        <div class="text-3xl font-bold text-orange-600">{within90}</div>
        <div class="mt-1 text-xs text-slate-600">verified in the last 90 days</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-5 text-center">
        <div class="text-3xl font-bold text-slate-900">{within30}</div>
        <div class="mt-1 text-xs text-slate-600">verified in the last 30 days</div>
      </div>
    </div>

    <h2>What a verification is here</h2>
    <p>
      A <strong>human checked the claim against a named primary source on the date shown</strong>, almost always the vendor's own pricing page. Not a crawler reading marketing copy, not an AI inference, not a vendor-supplied form. When a vendor is quote-only, the verification records that no public price existed on that date, which is itself a finding: <a href="/trends-2026/">36% of the category publishes no price at all</a>.
    </p>
    <p>
      The full directory re-verifies on a monthly cycle, and any vendor correction backed by a primary source is applied the same day. The complete rules live on the <a href="/methodology/">methodology page</a>; the warnings this process produces live on the <a href="/reputation-flags/">reputation ledger</a>.
    </p>

    <h2>Verification activity by month</h2>
    <div class="not-prose mb-8">
      <table class="w-full text-sm">
        <tbody>
          {months.map(([ym, n]) => (
            <tr class="border-b border-slate-100">
              <td class="py-2 pr-4 whitespace-nowrap text-slate-700">{monthLabel(ym)}</td>
              <td class="py-2 w-full">
                <div class="h-4 rounded bg-orange-500" style={`width: ${Math.max(3, Math.round((n / maxMonth) * 100))}%`}></div>
              </td>
              <td class="py-2 pl-3 text-right tabular-nums text-slate-600">{n}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="mt-2 text-xs text-slate-500">
        Count of vendors whose current verification date falls in each month. A vendor re-verified later moves to the newer month, so old months drain as the directory refreshes; that is the point.
      </p>
    </div>

    <h2>Most recently verified</h2>
    <div class="not-prose">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-slate-300 text-left text-xs uppercase tracking-wide text-slate-500">
            <th class="py-2 pr-4">Vendor</th>
            <th class="py-2 pr-4">Category</th>
            <th class="py-2 text-right">Verified</th>
          </tr>
        </thead>
        <tbody>
          {newest.map((d) => (
            <tr class="border-b border-slate-100">
              <td class="py-2 pr-4"><a href={d.url} class="text-orange-700 hover:underline">{d.name}</a></td>
              <td class="py-2 pr-4 text-slate-600">{d.category}</td>
              <td class="py-2 text-right tabular-nums text-slate-600">{d.date}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="mt-8 text-sm text-slate-500">
      Want the underlying data? The pricing dataset is published openly under CC BY 4.0, with a per-row verification date: <a href="/trends-2026/">details and downloads on the market report</a>.
    </p>
  </article>
</Layout>
