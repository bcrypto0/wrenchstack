---
import Layout from '../../layouts/Layout.astro';
import baData from '../../data/international/ba.json';

interface BaVendor {
  slug: string; name: string; category: string; vendor_url: string;
  tagline: string; market_position: string; ba_specific_note?: string | null;
  tier: 'S' | 'A' | 'F'; reputation_flag: string | null;
  pros: string[]; cons: string[]; typical_pricing: string;
  is_cross_market: boolean; cross_market_link: string | null;
}

const vendors = (baData as { vendors: BaVendor[] }).vendors;
const categories = ['software', 'insurance', 'lead-gen', 'certification'];
const categoryMeta: Record<string, { label: string; description: string }> = {
  'insurance': { label: 'Contractor insurance', description: `Contractor and engineering cover from Bahrain insurers, all quote-based: BKIC, which trades as GIG Bahrain; its Takaful subsidiary GIG Takaful (Takaful International), which lists Contractors All Risks cover; and Solidarity Bahrain, which acquired Bahrain National Insurance (bni) in 2025. BKIC and Takaful International are one group, so quotes from both are not independent.` },
  'lead-gen': { label: 'Lead generation & project intelligence', description: `ProTenders, operated by NuServ Ltd, sells construction project intelligence and eTendering across the six GCC states, including Bahrain. A free company profile lists your firm and lets it bid on private tenders; project leads and participant details are in custom-priced paid plans.` },
  'software': { label: 'Construction & trades software', description: `Global project, scheduling and design platforms: Oracle Primavera P6, Oracle Aconex, Autodesk Forma (formerly Autodesk Construction Cloud, part of Forma since March 2026), Bentley Systems, Procore and PlanRadar. ERPs with a Manama office or partner: Focus Softnet, PACT ERP (through Aramis Enterprise Solutions WLL) and Diamond Software. Accounting software: Zoho Books, Wafeq and TallyPrime. Bentley, PlanRadar, Zoho Books and Wafeq publish prices on their own sites; TallyPrime's Gulf-currency prices could not be read, and the rest are quote-based.` },
  'certification': { label: 'Licensing & compliance', description: 'The Bahrain bodies and systems behind VAT, licensing, permits and government work: the NBR (VAT at 10%), CRPEP (licences for engineers and engineering offices), Ministry of Works contractor prequalification, the Tender Board (eTendering for the government purchases it oversees), LMRA and Bahrainisation (expatriate work permits), Benayat (building permits) and Civil Defence (fire safety approvals).' },
};
const vendorsByCategory: Record<string, BaVendor[]> = {};
categories.forEach(c => { vendorsByCategory[c] = vendors.filter(v => v.category === c); });

const pageTitle = 'Bahrain Construction & Trades Software | WrenchStack';
const pageDescription = `Independent directory of ${vendors.length} construction and trades listings for Bahrain: project and design platforms, ERPs with a Manama office or partner, accounting software, contractor insurers and project leads, plus the NBR, CRPEP, Ministry of Works, Tender Board, LMRA, Benayat and Civil Defence rules for VAT, licensing, permits and government tenders.`;
const breadcrumbs = [ { name: 'Home', url: '/' }, { name: 'Bahrain', url: '/ba/' } ];
---
<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>
  <article class="mx-auto max-w-5xl px-4 py-12">
    <header class="mb-10">
      <div class="mb-3 flex items-center gap-2">
        <span class="text-2xl" aria-hidden="true">🇧🇭</span>
        <p class="text-sm font-semibold uppercase tracking-wider text-orange-600">Bahrain · مملكة البحرين</p>
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">Bahrain Construction & Trades Software Directory</h1>
      <p class="mt-4 text-lg text-slate-600 leading-relaxed">
        Independent reviews of {vendors.length} Bahrain-relevant listings: global project, scheduling and design platforms (Oracle Primavera P6, Oracle Aconex, Autodesk Forma, Bentley Systems, Procore, PlanRadar), ERPs with a Manama office or partner (Focus Softnet, PACT ERP, Diamond Software), accounting software (Zoho Books, Wafeq, TallyPrime), contractor insurers and ProTenders project intelligence, plus the Bahrain bodies for VAT, licensing, permits and government tenders (NBR, CRPEP, Ministry of Works, Tender Board, LMRA, Benayat, Civil Defence).
      </p>
    </header>

    <section class="mb-10 grid gap-3 grid-cols-2 sm:grid-cols-4">
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">{vendors.length}</div>
        <div class="mt-1 text-xs text-slate-600">listings reviewed</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">10%</div>
        <div class="mt-1 text-xs text-slate-600">standard VAT rate since 1 January 2022</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">BHD 37,500</div>
        <div class="mt-1 text-xs text-slate-600">annual taxable revenue for mandatory VAT registration (PwC)</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">BHD 195</div>
        <div class="mt-1 text-xs text-slate-600">LMRA work permit per expatriate a year, plus admin fee</div>
      </div>
    </section>

    <section class="mb-10 flex flex-wrap items-center justify-between gap-4 rounded-lg border border-orange-200 bg-orange-50 p-5">
      <div>
        <h2 class="text-base font-bold text-slate-900">Deciding between two options?</h2>
        <p class="mt-1 text-sm text-slate-700">See Bahrain vendors compared side by side: pros and cons, Bahrain-specific notes and pricing, head to head.</p>
      </div>
      <a href="/ba/compare/" class="shrink-0 rounded-md bg-slate-900 px-5 py-3 text-sm font-semibold text-white hover:bg-slate-700">Compare Bahrain vendors →</a>
    </section>

    <section class="mb-10 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-3 text-base font-bold text-slate-900">What's different about choosing software in Bahrain</h2>
      <p class="text-sm text-slate-700 leading-relaxed">
        Four points to check when choosing software and planning work in Bahrain. First, <strong>who supports the product locally</strong>: no Bahrain office or reseller was confirmed for Autodesk, Bentley, Procore or PlanRadar (Procore lists a UAE site and a Dubai phone number; Bentley's nearest listed offices are in Dubai and Al Khobar), while Focus Softnet and Diamond Software have Manama offices and PACT ERP sells through a Manama partner. Second, <strong>VAT is 10%</strong> (raised from 5% on 1 January 2022), so check that your accounting tool applies Bahrain's rate: Zoho Books has a Bahrain edition with VAT reports, but Wafeq's Bahrain pages do not describe Bahrain VAT returns and Tally's site has no Bahrain VAT page, so ask to see a Bahrain VAT report in a demo. Third, <strong>an e-invoicing mandate was not yet in force</strong> as of PwC's July 2026 review; PwC notes the market expects one similar to Saudi Arabia's, and Gulf Daily News reported an e-invoicing push in July 2026, with no confirmed start date, so choose software that can adapt. Fourth, <strong>public work and permits have separate gates</strong>: the <strong>Tender Board</strong> oversees purchases above BHD 50,000 by government purchasing authorities (above BHD 100,000 for fully government-owned companies) through its eTendering system, the <strong>Ministry of Works</strong> runs its own contractor prequalification by category for its building, roads, sanitary and landscape works, and new buildings and large additions must be filed on <strong>Benayat</strong> through a <strong>CRPEP</strong>-licensed engineering office, while owners can file small additions and demolitions themselves.
      </p>
    </section>

    {categories.map(c => {
      const cat = categoryMeta[c];
      const cv = vendorsByCategory[c];
      if (cv.length === 0) return null;
      return (
        <section class="mb-12">
          <div class="mb-5">
            <h2 class="text-2xl font-bold text-slate-900">{cat.label}</h2>
            <p class="mt-1 text-sm text-slate-600 leading-relaxed">{cat.description}</p>
          </div>
          <div class="space-y-4">
            {cv.map(v => {
              const isCert = v.category === 'certification';
              const tierColor = v.tier === 'S' ? 'border-emerald-300' : v.tier === 'F' ? 'border-rose-300' : 'border-blue-300';
              const tierLabel = isCert ? 'Official body / regime' : v.tier === 'S' ? 'Published prices' : v.tier === 'F' ? 'Reputation warning' : 'Listed';
              const tierBadge = v.tier === 'S' ? 'bg-emerald-100 text-emerald-900' : v.tier === 'F' ? 'bg-rose-100 text-rose-900' : 'bg-blue-100 text-blue-900';
              return (
                <article class={`rounded-lg border-2 ${tierColor} bg-white p-5`}>
                  <div class="mb-3 flex items-start justify-between gap-3">
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-2 mb-1 flex-wrap">
                        <h3 class="text-xl font-bold text-slate-900">{v.name}</h3>
                        <span class={`rounded-full px-2 py-0.5 text-xs font-bold ${tierBadge}`}>{isCert ? tierLabel : `Tier ${v.tier} · ${tierLabel}`}</span>
                        </div>
                      <p class="text-sm italic text-slate-500">{v.tagline}</p>
                    </div>
                  </div>
                  <p class="mb-3 text-sm text-slate-700 leading-relaxed">{v.market_position}</p>
                  {v.ba_specific_note && (
                    <div class="mb-3 rounded-md bg-slate-50 px-4 py-3">
                      <p class="text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Bahrain-specific note</p>
                      <p class="text-sm text-slate-700 leading-relaxed">{v.ba_specific_note}</p>
                    </div>
                  )}
                  <div class="mb-3 grid gap-3 sm:grid-cols-2">
                    <div>
                      <p class="text-xs font-bold uppercase tracking-wider text-emerald-700 mb-1">{isCert ? 'What it covers' : 'Pros'}</p>
                      <ul class="space-y-1 text-sm text-slate-700">{v.pros.slice(0, 4).map(p => <li class="leading-snug">+ {p}</li>)}</ul>
                    </div>
                    <div>
                      <p class="text-xs font-bold uppercase tracking-wider text-rose-700 mb-1">{isCert ? 'Watch out for' : 'Cons'}</p>
                      <ul class="space-y-1 text-sm text-slate-700">{v.cons.slice(0, 4).map(con => <li class="leading-snug">− {con}</li>)}</ul>
                    </div>
                  </div>
                  <div class="mb-3 text-xs text-slate-600"><strong class="text-slate-900">{isCert ? 'Cost / access:' : 'Typical Bahrain pricing:'}</strong> {v.typical_pricing}</div>
                  <div class="flex flex-wrap gap-2">
                    <a href={`/ba/${v.slug}/`} class="rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700">Full Bahrain review →</a>
                    <a href={v.vendor_url} rel="sponsored nofollow noopener" target="_blank" class="rounded-md bg-orange-500 px-4 py-2 text-sm font-semibold text-white hover:bg-orange-600">{isCert ? 'Official site' : `Visit ${v.name}`} →</a>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      );
    })}

    <section class="mt-12 rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">Are you a Bahrain vendor?</h2>
      <p class="mt-2 text-slate-300 leading-relaxed">If you build software or services for Bahrain construction and trades businesses and want to be reviewed or featured, get in touch through our <a href="/for-vendors/" class="underline">vendor program</a>.</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/for-vendors/" class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600">Work with us →</a>
        <a href="/software-by-country/" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">🌍 Software by country</a>
        <a href="/methodology/" class="rounded-md border border-white/30 bg-white/10 px-5 py-3 text-sm font-semibold text-white hover:bg-white/20">Methodology</a>
      </div>
    </section>
  </article>
</Layout>
