---
import Layout from '../../../layouts/Layout.astro';
import frData from '../../../data/international/fr.json';

interface FrVendor {
  slug: string; name: string; category: string; vendor_url: string;
  tagline: string; tier: 'S' | 'A' | 'F';
  is_cross_market: boolean;
}
const vendors = (frData as { vendors: FrVendor[] }).vendors;

// Concise French positioning per vendor (the detailed reviews remain in English for now).
const fr: Record<string, string> = {
  'obat': 'Logiciel de devis, factures et suivi de chantier pour le bâtiment (Obat SAS, Nantes), avec des offres micro-entreprise ; facturation électronique via Iopole, plateforme agréée.',
  'tolteck': 'Application de devis et factures pour artisans du bâtiment, utilisable sans réseau ; Tolteck SAS a été rachetée par Saint-Gobain en 2017.',
  'ebp-batiment': 'Gamme bâtiment d’EBP (groupe Cegid depuis juillet 2024), en trois éditions ; facturation électronique via la plateforme agréée Shine, intégrée.',
  'batappli': 'Logiciel BTP de Systemlog (groupe Isagri) avec la bibliothèque Batichiffrage intégrée ; facturation électronique incluse via Cecurity, plateforme agréée.',
  'mediabat': 'Devis, factures, métré et suivi de chantier pour le BTP (Mediabat SARL, Montpellier) ; le site ne nomme pas sa plateforme agréée.',
  'vertuoza': 'Gestion de chantier tout-en-un d’une société belge (Nivelles), avec devis dictés à la voix par IA ; tarifs sur devis, plateforme agréée non nommée.',
  'organilog': 'Gestion d’interventions, planning et contrats de maintenance (SARL Adalgo), avec une offre Basique gratuite et des prix publiés par utilisateur.',
  'axonaut': 'Gestion d’entreprise généraliste (devis, factures, CRM, trésorerie), non spécifique au bâtiment ; Axonaut figure elle-même sur la liste DGFiP des plateformes agréées.',
  'habitatpresto': 'Mise en relation entre particuliers et professionnels de la rénovation ; cotisation annuelle et aucune commission sur les travaux, selon ses conditions.',
  'quotatis': 'Le site présente désormais des forfaits de pose ; un article de La Poste de 2019 le rattachait au groupe ADEO (Leroy Merlin).',
  'travaux-com': 'Place de marché travaux détenue par l’américain Angi Inc. ; inscription gratuite, abonnement payant pour répondre aux demandes.',
  'starofservice': 'Place de marché de services locaux généraliste (StarOfService SAS, Paris), avec des abonnements publiés dans ses conditions, plus des frais mensuels.',
  'payfit': 'Paie et RH en ligne pour TPE/PME, avec des prix publiés ; PayFit indique que les conventions collectives du BTP ne sont pas encore intégrées.',
  'silae': 'Logiciel de paie distribué par des cabinets comptables et des intégrateurs ; Silae indique 900 conventions collectives intégrées. Rapprochement avec Cegid annoncé le 9 septembre 2026.',
  'ebp-paie': 'Paie d’EBP (groupe Cegid), en logiciel ou externalisée, sur devis ; la page paie ne décrit pas de fonctions propres au BTP.',
  'sage-paie-fr': 'Sage Business Cloud Paie : paie en ligne pour petites entreprises, du groupe britannique Sage, avec un prix d’entrée publié.',
  'smabtp': 'Mutuelle d’assurance de la construction fondée en 1859 : décennale artisan avec responsabilité civile et protection juridique, sur devis.',
  'april-construction': 'Décennale PROBAT via le courtier APRIL Partenaires, avec des prix « à partir de » publiés par métier, chacun pour un profil donné.',
  'orus': 'Courtier en ligne : devis décennale en 3 minutes environ et attestation sous 24 h selon Orus, prix de départ publié.',
  'axa-batissur': 'Contrat BATISSUR Concept d’AXA France : décennale, dommages en cours de travaux et responsabilité civile, sur devis.',
  'maaf-pro': 'Mutuelle française du groupe Covéa ; la CAPEB la cite comme partenaire proposant la responsabilité civile décennale. Sur devis.',
  'facturation-electronique': 'Réception des factures électroniques obligatoire pour toutes les entreprises depuis le 1ᵉʳ septembre 2026, via une plateforme agréée ; émission pour les TPE/PME et micro-entreprises au plus tard le 1ᵉʳ septembre 2027.',
  'assurance-decennale': 'Assurance décennale obligatoire avant le début des travaux ; à défaut, jusqu’à 6 mois d’emprisonnement et/ou 75 000 euros d’amende, selon service-public.fr.',
  'rge': 'Label RGE : ce n’est pas une autorisation d’exercer, mais selon le ministère chargé de l’écologie, vos clients n’obtiennent MaPrimeRénov’, les CEE ou l’éco-PTZ qu’avec un professionnel RGE.',
  'tva-batiment': 'TVA à 20 %, 10 % (amélioration, transformation, aménagement, entretien) ou 5,5 % (rénovation énergétique) pour les logements achevés depuis plus de deux ans.',
  'urssaf-micro': 'Régime micro-entrepreneur : cotisations Urssaf de 21,2 % du chiffre d’affaires pour les prestations artisanales en 2026 ; franchise de TVA jusqu’à 37 500 euros pour les services.',
  'cma-immatriculation': 'Immatriculation au RNE via le guichet des formalités des entreprises (INPI) : gratuite pour une micro-entreprise, 45 euros pour une entreprise individuelle artisanale ; la CMA conseille.',
  'qualification-professionnelle': 'Métiers du bâtiment réglementés : CAP, BEP, BP ou titre RNCP équivalent, ou 3 ans d’expérience, pour vous ou un salarié qui contrôle les travaux de façon effective et permanente (Code de l’artisanat).',
  'qualibat': 'Organisme de qualification volontaire fondé en 1949, l’un des organismes habilités à délivrer la mention RGE ; grille de tarifs publiée.',
};

const tierFr: Record<string, string> = { S: 'Prix publiés', A: 'Référencé', F: 'Alerte de réputation' };
const cats = [
  { key: 'software', label: 'Logiciels devis-facture & gestion', desc: 'Logiciels de devis, factures et suivi de chantier utilisés par les entreprises du bâtiment. Obat, Tolteck, EBP Bâtiment, Batappli et Mediabat sont conçus pour le bâtiment ; Vertuoza est un logiciel de gestion de chantier d’une société belge ; Organilog est centré sur les interventions et les contrats de maintenance ; Axonaut est un logiciel de gestion généraliste. Chacun dit couvrir la facturation électronique : Obat (Iopole), EBP (Shine), Batappli (Cecurity) et Tolteck (Pennylane, pour la réception) nomment leur plateforme agréée, Axonaut figure elle-même sur la liste DGFiP, et Mediabat, Vertuoza et Organilog ne nomment pas la leur.' },
  { key: 'lead-gen', label: 'Génération de prospects', desc: 'Sites qui apportent des chantiers de particuliers, chacun avec son mode de facturation : Habitatpresto (cotisation annuelle et aucune commission sur les travaux, selon ses conditions), Travaux.com (inscription gratuite, abonnement payant pour répondre aux demandes ; détenu par Angi Inc.), StarOfService (place de marché généraliste, abonnements publiés dans ses conditions) et Quotatis, dont le site présente désormais des forfaits de pose et qu’un article de La Poste de 2019 rattachait au groupe ADEO (Leroy Merlin).' },
  { key: 'payroll', label: 'Paie', desc: 'Paie pour les petites entreprises : PayFit en direct avec des prix publiés, Silae via les cabinets comptables et intégrateurs, EBP Paie (logiciel ou externalisé) et Sage Business Cloud Paie. PayFit indique que les conventions collectives du BTP ne sont pas encore intégrées, et les trois autres ne décrivent pas de gestion propre au BTP sur les pages consultées : faites confirmer par écrit votre convention BTP et les déclarations aux caisses CIBTP.' },
  { key: 'insurance', label: 'Assurance : décennale & RC Pro', desc: 'Décennale obligatoire (responsabilité de dix ans) et garanties associées : SMABTP, mutuelle de la construction fondée en 1859 ; APRIL Construction et Orus, courtiers qui publient des prix de départ ; le contrat BATISSUR Concept d’AXA ; et MAAF, mutuelle du groupe Covéa. SMABTP, AXA et MAAF ne publient pas de prix : demandez des devis et comparez les activités couvertes.' },
  { key: 'certification', label: 'Conformité & qualifications', desc: 'Règles et dispositifs pour les entreprises du bâtiment : facturation électronique via une plateforme agréée, assurance décennale obligatoire, les trois taux de TVA, l’Urssaf et le régime micro-entrepreneur, l’immatriculation et la qualification professionnelle des métiers réglementés, plus deux dispositifs volontaires : le label RGE, sans lequel vos clients n’obtiennent pas MaPrimeRénov’, les CEE ou l’éco-PTZ, et la qualification Qualibat.' },
];

const enUrl = new URL('/fr/', Astro.site).toString();
const frUrl = new URL('/fr/fr/', Astro.site).toString();
const pageTitle = 'Annuaire des logiciels et services pour artisans du bâtiment | WrenchStack';
const pageDescription = `Avis indépendants sur ${vendors.length} solutions et dispositifs pour les artisans du bâtiment français : logiciels de devis-facture, sources de chantiers, paie et assurance décennale, ainsi que les règles de facturation électronique, de TVA, d’immatriculation et de qualification, et le label RGE pour la rénovation énergétique.`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  lang="fr"
  alternateUrls={[{ hreflang: 'en', href: enUrl }, { hreflang: 'fr', href: frUrl }, { hreflang: 'x-default', href: enUrl }]}
>
  <article class="mx-auto max-w-5xl px-4 py-12">

    <div class="mb-6 flex items-center justify-between gap-3">
      <div class="flex items-center gap-2">
        <span class="text-2xl" aria-hidden="true">🇫🇷</span>
        <p class="text-sm font-semibold uppercase tracking-wider text-orange-600">France · Artisans du bâtiment</p>
      </div>
      <a href="/fr/" class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">English</a>
    </div>

    <header class="mb-10">
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">Annuaire des logiciels et services pour artisans du bâtiment</h1>
      <p class="mt-4 text-lg text-slate-600 leading-relaxed">
        Avis indépendants sur {vendors.length} solutions et dispositifs pertinents pour les artisans du bâtiment français : logiciels de devis-facture (Obat, Tolteck, EBP Bâtiment), sources de chantiers (Habitatpresto, Travaux.com), paie (PayFit, Silae) et assurance décennale (SMABTP, APRIL Construction, Orus), au regard des règles françaises : la facturation électronique via une plateforme agréée, les trois taux de TVA, le label RGE pour les aides à la rénovation énergétique et le régime micro-entrepreneur.
      </p>
    </header>

    <section class="mb-10 flex flex-wrap items-center justify-between gap-4 rounded-lg border-2 border-emerald-300 bg-emerald-50 p-5">
      <div>
        <p class="text-xs font-bold tracking-wider text-emerald-700">⏰ Guide de conformité · Réception pour tous depuis le 1ᵉʳ sept. 2026 · Émission TPE/PME au plus tard le 1ᵉʳ sept. 2027</p>
        <h2 class="mt-1 text-base font-bold text-slate-900">La facturation électronique pour les artisans</h2>
        <p class="mt-1 text-sm text-slate-700">Le calendrier par étapes, le fonctionnement des plateformes agréées (l’État ne propose pas de plateforme publique gratuite de facturation) et quels logiciels sont des plateformes agréées.</p>
      </div>
      <a href="/fr/fr/guides/facturation-electronique-artisans/" class="shrink-0 rounded-md bg-emerald-700 px-5 py-3 text-sm font-semibold text-white hover:bg-emerald-800">Lire le guide →</a>
    </section>

    <section class="mb-10 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-3 text-base font-bold text-slate-900">Ce qui distingue la gestion d’une entreprise artisanale en France</h2>
      <p class="text-sm text-slate-700 leading-relaxed">
        Le choix d’un logiciel pour artisan en France diffère des États-Unis ou du Royaume-Uni sur plusieurs points. D’abord, <strong>la facturation électronique est entrée en vigueur</strong> : depuis le 1ᵉʳ septembre 2026, toute entreprise doit pouvoir recevoir des factures électroniques via une plateforme agréée, et au plus tard le 1ᵉʳ septembre 2027 les PME, TPE et micro-entreprises devront aussi les émettre. L’État ne propose pas de plateforme publique gratuite de facturation, mais la DGFiP indique que plus de dix des 150 plateformes agréées proposaient au 1ᵉʳ août 2026 des services gratuits ou sans surcoût ; le choix du logiciel a donc un poids de conformité. Ensuite, <strong>l’assurance décennale est obligatoire</strong> : elle couvre pendant dix ans à compter de la réception (loi Spinetta), doit être souscrite avant le début des travaux, et construire sans elle est passible de 6 mois d’emprisonnement et/ou de 75 000 euros d’amende selon service-public.fr ; l’attestation d’assurance doit être jointe à chaque devis et facture. De plus, <strong>la TVA est à taux multiples</strong> (20 % normal, 10 % pour l’amélioration et l’entretien, 5,5 % pour la rénovation énergétique, dans les logements achevés depuis plus de deux ans), donc le logiciel de devis devrait permettre de fixer le taux par ligne. Le <strong>label RGE</strong> n’est pas une autorisation d’exercer, mais selon le ministère chargé de l’écologie, vos clients ne peuvent obtenir MaPrimeRénov’, les CEE ou l’éco-PTZ que si les travaux sont réalisés par un professionnel RGE. Enfin, en <strong>micro-entreprise</strong>, les cotisations Urssaf sont un pourcentage du chiffre d’affaires (21,2 % pour les prestations artisanales en 2026) et, sous le seuil de franchise de TVA (37 500 euros pour les services), les factures portent la mention « TVA non applicable - article 293 B du CGI ».
      </p>
    </section>

    {cats.map((cat) => {
      const cv = vendors.filter((v) => v.category === cat.key);
      if (cv.length === 0) return null;
      return (
        <section class="mb-12">
          <div class="mb-5">
            <h2 class="text-2xl font-bold text-slate-900">{cat.label}</h2>
            <p class="mt-1 text-sm text-slate-600 leading-relaxed">{cat.desc}</p>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            {cv.map((v) => {
              const isCert = v.category === 'certification';
              const tierColor = v.tier === 'S' ? 'border-emerald-300' : v.tier === 'F' ? 'border-rose-300' : 'border-blue-300';
              const tierBadge = v.tier === 'S' ? 'bg-emerald-100 text-emerald-900' : v.tier === 'F' ? 'bg-rose-100 text-rose-900' : 'bg-blue-100 text-blue-900';
              const label = isCert ? 'Organisme officiel' : tierFr[v.tier];
              return (
                <article class={`rounded-lg border-2 ${tierColor} bg-white p-4`}>
                  <div class="mb-1 flex items-center gap-2 flex-wrap">
                    <h3 class="text-lg font-bold text-slate-900">{v.name}</h3>
                    <span class={`rounded-full px-2 py-0.5 text-xs font-bold ${tierBadge}`}>{label}</span>
                  </div>
                  <p class="text-sm text-slate-700 leading-relaxed">{fr[v.slug] ?? v.tagline}</p>
                  <div class="mt-3 flex flex-wrap gap-2">
                    <a href={`/fr/${v.slug}/`} class="rounded-md bg-slate-900 px-3 py-1.5 text-xs font-semibold text-white hover:bg-slate-700">Détails (en anglais) →</a>
                    <a href={v.vendor_url} rel="sponsored nofollow noopener" target="_blank" class="rounded-md bg-orange-500 px-3 py-1.5 text-xs font-semibold text-white hover:bg-orange-600">{isCert ? 'Site officiel' : 'Visiter le site'} →</a>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      );
    })}

    <section class="mb-10 rounded-lg border border-slate-200 bg-white p-5 text-sm text-slate-600">
      <p>Les avis détaillés par solution sont actuellement disponibles <a href="/fr/" class="font-medium text-orange-600 hover:underline">en anglais</a>, et nous étendons progressivement le contenu en français.</p>
    </section>

    <section class="rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">Vous êtes éditeur ou prestataire français ?</h2>
      <p class="mt-2 text-slate-300 leading-relaxed">Si vous proposez un logiciel ou un service pour les artisans français et souhaitez être évalué ou mis en avant, contactez-nous via notre <a href="/for-vendors/" class="underline">programme prestataires</a>.</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/for-vendors/" class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600">Travailler avec nous →</a>
        <a href="/fr/" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">English directory</a>
      </div>
    </section>
  </article>
</Layout>
