---
import Layout from '../../../../../layouts/Layout.astro';
import frData from '../../../../../data/international/fr.json';

interface FrVendor {
  slug: string; name: string; category: string; tier: 'S' | 'A' | 'F';
}
const vendors = (frData as { vendors: FrVendor[] }).vendors;
const bySlug = new Map(vendors.map((v) => [v.slug, v]));

// La voie de facturation électronique que nomme chaque logiciel de devis-facture
// de notre annuaire France, d'après les fiches revérifiées le 30 septembre 2026
// sur les sites des éditeurs et la liste DGFiP, qui fait foi.
const tools = [
  { slug: 'axonaut', route: 'Figure elle-même sur la liste DGFiP des plateformes agréées (immatriculation du 8 janvier 2026) ; facturation électronique incluse sans surcoût, selon Axonaut', fit: 'Gestion d’entreprise généraliste (devis, factures, CRM, trésorerie), non spécifique au bâtiment' },
  { slug: 'obat', route: 'Via Iopole, inscrite sur la liste DGFiP ; incluse dans toutes les offres, selon Obat', fit: 'Devis, factures et suivi de chantier pour le bâtiment' },
  { slug: 'ebp-batiment', route: 'Via la plateforme agréée Shine, intégrée et inscrite sur la liste DGFiP, selon EBP', fit: 'Devis, factures, situations de travaux et suivi de chantier' },
  { slug: 'batappli', route: 'Via eFacture by Cecurity, immatriculée par la DGFiP le 18 décembre 2025 ; incluse gratuitement, selon Batappli', fit: 'Devis, factures et gestion de chantier, avec la bibliothèque Batichiffrage' },
  { slug: 'tolteck', route: 'Émission et réception incluses dans le prix, la réception passant par son intégration Pennylane (Pennylane figure sur la liste DGFiP), selon Tolteck', fit: 'Devis et factures pour artisans du bâtiment, utilisable sans réseau' },
  { slug: 'mediabat', route: 'Cite la facturation électronique parmi les règles couvertes, sans nommer sa plateforme agréée', fit: 'Devis, factures, métré et suivi de chantier' },
  { slug: 'vertuoza', route: 'Dit inclure la facturation électronique dans chaque pack, sans nommer sa plateforme agréée ; absente elle-même de la liste DGFiP', fit: 'Gestion de chantier, par une société belge' },
  { slug: 'organilog', route: 'Émission à partir de l’offre Business, réception seulement en Premium ; ne nomme pas sa plateforme agréée', fit: 'Interventions, planning et contrats de maintenance' },
]
  .filter((r) => bySlug.has(r.slug))
  .map((r) => {
    const v = bySlug.get(r.slug);
    return { ...r, name: v?.name ?? r.slug, prices: v?.tier === 'S' ? 'Prix publiés' : 'Sur devis' };
  });

const faqs = [
  { q: 'Quand la facturation électronique devient-elle obligatoire pour un petit artisan ?', a: 'Deux dates comptent. Depuis le 1ᵉʳ septembre 2026, TOUTES les entreprises, y compris les micro-entrepreneurs, doivent pouvoir RECEVOIR des factures électroniques structurées via une plateforme agréée. Au plus tard le 1ᵉʳ septembre 2027, les PME, TPE et micro-entreprises doivent aussi les ÉMETTRE via une plateforme agréée. Les grandes entreprises et ETI émettent obligatoirement depuis le 1ᵉʳ septembre 2026. La DGFiP indique qu’aucune sanction ne sera appliquée en 2026, le temps que les entreprises s’adaptent.' },
  { q: 'Qu’est-ce qu’une PDP, et en ai-je vraiment besoin ?', a: 'Une PDP (Plateforme de Dématérialisation Partenaire), désormais officiellement « plateforme agréée », est une plateforme privée immatriculée par l’État qui émet, transmet et reçoit les factures électroniques. Oui, vous en avez besoin : l’État gère l’annuaire national qui indique la plateforme de chaque entreprise, mais aucune plateforme publique gratuite de facturation. Toute entreprise passe donc par une plateforme agréée, directement ou via son logiciel. La DGFiP indique que plus de dix des 150 plateformes agréées proposaient au 1ᵉʳ août 2026 des services gratuits ou sans surcoût.' },
  { q: 'Mon logiciel de devis-facture n’est pas une PDP, est-ce un problème ?', a: 'Pas nécessairement. Plusieurs outils de notre annuaire France passent par une plateforme agréée partenaire : EBP intègre Shine, Obat passe par Iopole, Batappli par Cecurity, et Tolteck reçoit les factures via son intégration Pennylane. L’essentiel est que votre logiciel de facturation puisse envoyer et recevoir des factures conformes via une plateforme agréée avant votre échéance. Posez la question directement : « Êtes-vous une plateforme immatriculée, ou via quelle plateforme passez-vous, et à partir de quand ? »' },
  { q: 'Quel format pour les factures électroniques ?', a: 'Un PDF envoyé par e-mail n’est pas une facture électronique : c’est une donnée structurée, et notre fiche DGFiP relève que 34 données structurées sont exigées. Votre plateforme agréée gère le format : demandez-lui quels formats elle accepte. En parallèle, l’e-reporting transmet à l’administration les données des ventes aux particuliers (B2C) et des opérations à l’étranger, selon service-public.fr.' },
  { q: 'Je suis micro-entrepreneur en franchise de TVA, suis-je quand même concerné ?', a: 'Oui. Notre fiche facturation électronique, établie à partir des sources DGFiP, indique que toute entreprise, micro-entrepreneurs compris, doit pouvoir recevoir des factures électroniques depuis septembre 2026, et que les micro-entreprises doivent les émettre au plus tard en septembre 2027. Si vous facturez en franchise en base, vos factures portent toujours la mention « TVA non applicable, art. 293 B du CGI ».' },
  { q: 'Que dois-je faire maintenant ?', a: 'Vérifiez la position de votre logiciel de facturation : est-il (ou se connecte-t-il à) une plateforme agréée, depuis quand et à quel coût ? Si vous facturez encore sur papier, Word ou Excel, choisissez dès maintenant un outil conforme : la réception est obligatoire depuis septembre 2026, et les PME, TPE et micro-entreprises devront émettre via une plateforme agréée d’ici septembre 2027. Prévoyez du temps de test : cela concerne chaque facture que vous envoyez.' },
];

const pageTitle = 'Facturation électronique pour les artisans du bâtiment (guide 2026)';
const pageDescription = 'La facturation électronique expliquée aux artisans : réception pour toutes les entreprises depuis le 1ᵉʳ septembre 2026, émission pour les TPE/PME et micro-entreprises au plus tard le 1ᵉʳ septembre 2027, le modèle de plateforme agréée (PDP), sans plateforme publique gratuite de l’État, et la voie que nomme chaque logiciel de notre annuaire France. Mis à jour en octobre 2026.';

const enUrl = new URL('/fr/guides/facturation-electronique-artisans/', Astro.site).toString();
const frUrl = new URL('/fr/fr/guides/facturation-electronique-artisans/', Astro.site).toString();
const breadcrumbs = [
  { name: 'Accueil', url: '/' },
  { name: 'France', url: '/fr/fr/' },
  { name: 'Facturation électronique', url: '/fr/fr/guides/facturation-electronique-artisans/' },
];

const articleSchema = {
  '@context': 'https://schema.org', '@type': 'Article', headline: pageTitle, description: pageDescription,
  datePublished: '2026-06-17', dateModified: '2026-10-01', inLanguage: 'fr',
  author: { '@type': 'Organization', name: 'WrenchStack Research', url: 'https://wrenchstack.com/research/' },
  publisher: { '@type': 'Organization', name: 'WrenchStack', url: 'https://wrenchstack.com' },
  mainEntityOfPage: frUrl,
};
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  lang="fr"
  breadcrumbs={breadcrumbs}
  alternateUrls={[{ hreflang: 'en', href: enUrl }, { hreflang: 'fr', href: frUrl }, { hreflang: 'x-default', href: enUrl }]}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <article class="mx-auto max-w-4xl px-4 py-12">
    <header class="mb-8">
      <div class="mb-3 flex items-center justify-between gap-3">
        <p class="text-sm font-semibold uppercase tracking-wider text-orange-600">🇫🇷 France · Guide de conformité</p>
        <a href="/fr/guides/facturation-electronique-artisans/" class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">English</a>
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        La facturation électronique pour les artisans du bâtiment
      </h1>
      <p class="mt-3 text-lg text-slate-600 leading-relaxed">
        Ce que le calendrier obligatoire de la facturation électronique signifie pour les artisans : les étapes, le modèle de plateforme agréée (PDP), sans plateforme publique gratuite de l’État, et la voie que nomme chaque logiciel de notre annuaire France.
      </p>
      <p class="mt-3 text-sm text-slate-500">Par WrenchStack Research · Publié en juin 2026 · Mis à jour le 1ᵉʳ octobre 2026 (calendrier et e-reporting vérifiés sur service-public.fr) · Ceci n’est pas un conseil fiscal : vérifiez votre situation auprès de la DGFiP (impots.gouv.fr) ou de votre expert-comptable.</p>
    </header>

    <section class="mb-8 rounded-lg border-2 border-orange-300 bg-orange-50 p-6">
      <h2 class="mb-2 text-lg font-bold text-slate-900">⏰ L’essentiel</h2>
      <p class="text-slate-800 leading-relaxed">
        Depuis le <strong>1ᵉʳ septembre 2026</strong>, toute entreprise française, y compris les auto-entrepreneurs, doit pouvoir <strong>recevoir</strong> des factures électroniques structurées. Au plus tard le <strong>1ᵉʳ septembre 2027</strong>, les TPE/PME et micro-entreprises doivent aussi les <strong>émettre</strong>. Les factures transitent par une plateforme immatriculée par l’État (une <strong>PDP / plateforme agréée</strong>) ; l’État ne propose pas de plateforme publique gratuite, mais la DGFiP indique que certaines plateformes agréées proposent des services gratuits. La tâche concrète : vérifier que votre logiciel de facturation est (ou se connecte à) une plateforme agréée avant votre échéance.
      </p>
    </section>

    <section class="mb-10 grid gap-3 sm:grid-cols-3">
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">1ᵉʳ sept. 2026</div>
        <div class="mt-1 text-xs text-slate-600">RÉCEPTION obligatoire pour TOUTES les entreprises</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">1ᵉʳ sept. 2027</div>
        <div class="mt-1 text-xs text-slate-600">ÉMISSION pour les TPE/PME et micro-entreprises</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">PDP</div>
        <div class="mt-1 text-xs text-slate-600">plateforme agréée (pas de plateforme gratuite de l’État)</div>
      </div>
    </section>

    <section class="mb-10 prose prose-slate max-w-none">
      <h2>Le calendrier par étapes</h2>
      <p>L’obligation repose sur l’article 289 bis du CGI et la loi de finances pour 2024 (loi n° 2023-1322), selon service-public.fr. La DGFiP indique qu’aucune sanction ne sera appliquée en 2026, le temps que les entreprises s’adaptent.</p>
      <ul>
        <li><strong>1ᵉʳ septembre 2026, réception :</strong> toutes les entreprises doivent pouvoir <em>recevoir</em> des factures électroniques (toutes tailles, y compris les auto-entrepreneurs).</li>
        <li><strong>1ᵉʳ septembre 2026, émission (grandes &amp; moyennes) :</strong> les grandes entreprises et ETI doivent <em>émettre</em> des factures électroniques et faire de l’e-reporting.</li>
        <li><strong>1ᵉʳ septembre 2027, émission (TPE/PME &amp; micro) :</strong> les PME, TPE et micro-entreprises doivent <em>émettre</em> des factures électroniques et faire de l’e-reporting.</li>
      </ul>

      <h2>Ce que la réforme exige</h2>
      <ul>
        <li><strong>Utiliser une plateforme agréée (PDP).</strong> Les factures sont émises, transmises et reçues via une plateforme immatriculée par l’État : l’État ne propose pas de plateforme publique gratuite pour l’émission, mais la DGFiP indique que plus de dix des 150 plateformes agréées proposaient au 1ᵉʳ août 2026 des services gratuits ou sans surcoût.</li>
        <li><strong>Des données structurées.</strong> Un PDF envoyé par e-mail n’est pas une facture électronique ; notre fiche DGFiP relève que 34 données structurées sont exigées. Votre plateforme gère le format.</li>
        <li><strong>L’annuaire.</strong> L’État gère l’annuaire national, qui indique la plateforme de chaque entreprise et son adresse de facturation électronique.</li>
        <li><strong>E-reporting.</strong> Une obligation parallèle transmet à l’administration les données des ventes aux particuliers (B2C) et des opérations à l’étranger, selon service-public.fr.</li>
        <li><strong>Clients publics.</strong> Organilog, par exemple, indique que ses offres Business et supérieures incluent un connecteur Chorus Pro pour les clients du secteur public ; demandez à votre éditeur comment il gère les factures aux organismes publics.</li>
      </ul>

      <h2>Les points propres au bâtiment</h2>
      <p>
        Deux points comptent pour les artisans. D’abord, vos factures peuvent porter <strong>plusieurs taux de TVA (20 / 10 / 5,5 %)</strong>, et chaque ligne doit porter le bon taux. Ensuite, si vous êtes <strong>micro-entrepreneur en franchise de TVA</strong>, vos factures portent toujours la mention « TVA non applicable, art. 293 B du CGI », et les micro-entreprises suivent le même calendrier que les autres petites entreprises.
      </p>

      <h2>Ce que disent les logiciels de notre annuaire France</h2>
      <p>
        Chaque logiciel de devis-facture de notre <a href="/fr/fr/">annuaire France</a> dit couvrir la facturation électronique ; voici la voie que nomme chacun. Vérifiez toujours la <a href="https://www.impots.gouv.fr/je-consulte-la-liste-des-plateformes-agreees" rel="nofollow noopener" target="_blank">liste officielle DGFiP des plateformes agréées</a> avant de vous engager.
      </p>
    </section>

    <section class="mb-10 overflow-x-auto">
      <table class="w-full text-sm border border-slate-200 rounded-lg overflow-hidden">
        <thead class="bg-slate-50 text-left text-slate-700">
          <tr>
            <th class="p-3 font-semibold">Logiciel</th>
            <th class="p-3 font-semibold">Voie de facturation électronique</th>
            <th class="p-3 font-semibold">De quoi s’agit-il</th>
            <th class="p-3 font-semibold">Tarif</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 bg-white">
          {tools.map((t) => (
            <tr>
              <td class="p-3 font-semibold text-slate-900"><a href={`/fr/${t.slug}/`} class="text-orange-700 hover:underline">{t.name}</a></td>
              <td class="p-3 text-slate-700">{t.route}</td>
              <td class="p-3 text-slate-600">{t.fit}</td>
              <td class="p-3 text-slate-600">{t.prices}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="mt-3 text-xs text-slate-500">Source : fiches de l’annuaire France de WrenchStack, revérifiées le 30 septembre 2026 sur les sites des éditeurs et la liste DGFiP. Vérifiez le statut actuel sur la liste officielle impots.gouv.fr.</p>
    </section>

    <section class="mb-10 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-2 text-lg font-bold text-slate-900">Et mon logiciel de devis-facture (Obat, Tolteck, EBP…) ?</h2>
      <p class="text-sm text-slate-700 leading-relaxed">
        Votre <a href="/fr/fr/" class="font-medium text-orange-700 hover:underline">logiciel de gestion / devis-facture</a> émet vos factures : il doit donc pouvoir les envoyer et les recevoir via une plateforme agréée avant votre échéance, soit en étant lui-même une plateforme immatriculée, soit en passant par une plateforme agréée. La question à poser à tout éditeur : <strong>« Êtes-vous une plateforme immatriculée, ou via quelle plateforme passez-vous, et à partir de quand ? »</strong> Ne présumez pas qu’un outil de devis couvre l’obligation : vérifiez le raccordement à une plateforme.
      </p>
    </section>

    <section class="mb-10 prose prose-slate max-w-none">
      <h2>Check-list de préparation pour les artisans</h2>
      <ol>
        <li><strong>Assurez-vous de pouvoir recevoir des factures électroniques dès maintenant</strong> : c’est obligatoire pour toutes les entreprises, y compris les micro-entrepreneurs, depuis le 1ᵉʳ septembre 2026.</li>
        <li><strong>Posez la question de la plateforme à votre logiciel :</strong> êtes-vous une plateforme agréée, ou via laquelle passez-vous, et à partir de quand ?</li>
        <li><strong>Si vous êtes encore sur papier / Word / Excel,</strong> choisissez un outil conforme bien avant les échéances.</li>
        <li><strong>Vérifiez la gestion de la TVA à taux multiples</strong> (20 / 10 / 5,5 %) et, en franchise, la mention art. 293 B.</li>
        <li><strong>Prévoyez d’émettre via une plateforme agréée d’ici le 1ᵉʳ septembre 2027</strong> (TPE/PME et micro) ; les grandes entreprises et ETI émettent obligatoirement depuis le 1ᵉʳ septembre 2026.</li>
        <li><strong>Testez avant l’échéance</strong> : cela touche chaque facture que vous envoyez et recevez.</li>
      </ol>
    </section>

    <section class="mb-10">
      <h2 class="mb-5 text-2xl font-bold text-slate-900">Questions fréquentes</h2>
      <div class="space-y-3">
        {faqs.map((f) => (
          <details class="rounded-lg border border-slate-200 bg-white p-4">
            <summary class="cursor-pointer font-semibold text-slate-900">{f.q}</summary>
            <p class="mt-3 text-slate-700 leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mb-10 rounded-lg bg-slate-50 p-5 text-xs text-slate-500 leading-relaxed">
      <strong class="text-slate-700">Sources et vérification :</strong> calendrier par taille d’entreprise, périmètre de l’e-reporting, annuaire et références légales (article 289 bis du CGI ; loi n° 2023-1322) vérifiés le 1ᵉʳ octobre 2026 sur service-public.fr (<a href="https://entreprendre.service-public.gouv.fr/vosdroits/F39785" rel="nofollow noopener" target="_blank">fiche F39785</a>, vérifiée par service-public.fr le 7 août 2026). Offres gratuites, 150 plateformes agréées et absence de sanction en 2026 selon la DGFiP, d’après notre fiche facturation électronique (revérifiée le 30 septembre 2026). Positions des logiciels issues des fiches de notre annuaire France et de la liste DGFiP ; à vérifier sur la liste officielle. Information générale, pas un conseil fiscal. Une erreur ? <a href="/contact/" class="underline">Signalez-la</a>.
    </section>

    <section class="rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">Comparez les logiciels et services pour artisans</h2>
      <p class="mt-2 text-slate-300 leading-relaxed">Avis indépendants sur les logiciels de devis-facture, la génération de prospects, la paie et l’assurance décennale obligatoire, sans favoritisme payant.</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/fr/fr/" class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600">🇫🇷 Annuaire France →</a>
        <a href="/fr/compare/" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">Comparer</a>
        <a href="/for-vendors/" class="rounded-md border border-white/30 bg-white/10 px-5 py-3 text-sm font-semibold text-white hover:bg-white/20">Éditeur ? Travaillez avec nous</a>
      </div>
    </section>
  </article>
</Layout>
