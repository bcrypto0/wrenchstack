---
import Layout from '../../../../layouts/Layout.astro';
import frData from '../../../../data/international/fr.json';

interface FrVendor {
  slug: string; name: string; category: string; tier: 'S' | 'A' | 'F';
}
const vendors = (frData as { vendors: FrVendor[] }).vendors;
const bySlug = new Map(vendors.map((v) => [v.slug, v]));

// The e-invoicing route each devis-facture tool in our France directory names,
// from the entries re-verified against vendor pages and the DGFiP list on
// 30 September 2026. The DGFiP list on impots.gouv.fr is the source of truth.
const tools = [
  { slug: 'axonaut', route: 'Itself on the DGFiP list of plateformes agréées (registration issued 8 January 2026); e-invoicing included at no extra cost, per Axonaut', fit: 'General business software (quotes, invoices, CRM, cash flow), not specific to building' },
  { slug: 'obat', route: 'Through Iopole, which is on the DGFiP list; included in every plan, per Obat', fit: 'Quotes, invoices and worksite tracking for building trades' },
  { slug: 'ebp-batiment', route: 'Through the integrated plateforme agréée Shine, which is on the DGFiP list, per EBP', fit: 'Quotes, invoices, progress billing and worksite tracking for building trades' },
  { slug: 'batappli', route: 'Through eFacture by Cecurity, registered by the DGFiP on 18 December 2025; included free, per Batappli', fit: 'Quotes, invoices and site management, with the Batichiffrage library' },
  { slug: 'tolteck', route: 'Issuing and receipt included in the price, with receipt through its Pennylane integration (Pennylane is on the DGFiP list), per Tolteck', fit: 'Quotes and invoices for building artisans, usable offline' },
  { slug: 'mediabat', route: 'Lists e-invoicing among the rules it covers but does not name its plateforme agréée', fit: 'Quotes, invoices, métré and worksite tracking' },
  { slug: 'vertuoza', route: 'Says e-invoicing is in every pack but does not name its plateforme agréée; not on the DGFiP list itself', fit: 'Construction management from a Belgian company' },
  { slug: 'organilog', route: 'Issuing from the Business plan and receipt only on Premium; does not name its plateforme agréée', fit: 'Interventions, planning and maintenance contracts' },
]
  .filter((r) => bySlug.has(r.slug))
  .map((r) => {
    const v = bySlug.get(r.slug);
    return { ...r, name: v?.name ?? r.slug, prices: v?.tier === 'S' ? 'Published prices' : 'Quote only' };
  });

const faqs = [
  { q: 'When does French e-invoicing become mandatory for a small artisan?', a: 'Two dates matter. Since 1 September 2026, every business, micro-entrepreneurs included, must be able to RECEIVE structured e-invoices through a plateforme agréée. By 1 September 2027, PME, TPE and micro-entreprises must also ISSUE them through an approved platform. Large companies and ETI have had to issue since 1 September 2026. DGFiP says there are no sanctions in 2026 while businesses adapt.' },
  { q: 'What is a PDP, and do I really need one?', a: 'A PDP (Plateforme de Dématérialisation Partenaire), now officially a "plateforme agréée," is a private platform registered by the State that issues, transmits and receives e-invoices. Yes, you need one: the State runs the national directory (annuaire) that records which platform each company uses, but no free public invoicing platform, so every business uses an approved platform, either directly or through its software. DGFiP says more than ten of the 150 approved platforms offered free or no-extra-cost services on 1 August 2026.' },
  { q: 'My devis-facture software isn\'t a PDP: is that a problem?', a: 'Not necessarily. Several tools in our France directory work through a partner plateforme agréée: EBP integrates Shine, Obat works through Iopole, Batappli through Cecurity, and Tolteck receives e-invoices through its Pennylane integration. What matters is that your invoicing software can send and receive compliant e-invoices via an approved platform by your deadline. Ask your vendor directly: "Are you a registered platform, or which platform do you route through, and from when?"' },
  { q: 'What format will e-invoices use?', a: 'A PDF sent by email is not an e-invoice: an e-invoice is structured data, and our DGFiP entry notes 34 structured data items are required. Your plateforme agréée handles the format, so ask it which formats it accepts. Alongside invoicing, e-reporting sends data on sales to private customers (B2C) and on operations abroad to the tax administration, per service-public.fr.' },
  { q: 'I\'m a micro-entrepreneur under the VAT franchise: am I still concerned?', a: 'Yes. Our facturation électronique entry, based on DGFiP sources, says every business, micro-entrepreneurs included, must be able to receive e-invoices since September 2026, and micro-entreprises must issue them by September 2027. If you invoice under the franchise en base, your invoices still carry the "TVA non applicable, art. 293 B du CGI" mention.' },
  { q: 'What should I do now?', a: 'Confirm your invoicing software\'s position: is it (or does it connect to) a registered platform, from when, and at what cost? If you\'re still on paper, Word or Excel invoices, choose a compliant tool now: receiving e-invoices has been compulsory since September 2026, and PME, TPE and micro-entreprises must issue via an approved platform by September 2027. Leave time to test: this affects every invoice you send.' },
];

const pageTitle = 'Facturation Électronique (E-Invoicing) for French Artisans (2026 Guide)';
const pageDescription = 'France\'s e-invoicing mandate explained for tradespeople: reception for all businesses since 1 September 2026, issuance for SMEs and micro-entreprises by 1 September 2027, the plateforme agréée model with no free public invoicing platform run by the State, and the e-invoicing route each software in our France directory names. Updated October 2026.';

const guideUrl = new URL('/fr/guides/facturation-electronique-artisans/', Astro.site).toString();
const frUrl = new URL('/fr/fr/guides/facturation-electronique-artisans/', Astro.site).toString();
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'France', url: '/fr/' },
  { name: 'E-invoicing for artisans', url: '/fr/guides/facturation-electronique-artisans/' },
];

const articleSchema = {
  '@context': 'https://schema.org', '@type': 'Article', headline: pageTitle, description: pageDescription,
  datePublished: '2026-06-17', dateModified: '2026-10-01', inLanguage: 'en',
  author: { '@type': 'Organization', name: 'WrenchStack Research', url: 'https://wrenchstack.com/research/' },
  publisher: { '@type': 'Organization', name: 'WrenchStack', url: 'https://wrenchstack.com' },
  mainEntityOfPage: guideUrl,
};
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs} alternateUrls={[{ hreflang: 'en', href: guideUrl }, { hreflang: 'fr', href: frUrl }, { hreflang: 'x-default', href: guideUrl }]}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <article class="mx-auto max-w-4xl px-4 py-12">
    <header class="mb-8">
      <div class="mb-3 flex items-center justify-between gap-3">
        <p class="text-sm font-semibold uppercase tracking-wider text-orange-600">🇫🇷 France · Compliance guide</p>
        <a href="/fr/fr/guides/facturation-electronique-artisans/" class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">Français</a>
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        Facturation Électronique (E-Invoicing) for French Artisans
      </h1>
      <p class="mt-3 text-lg text-slate-600 leading-relaxed">
        What France's phased e-invoicing mandate means for tradespeople: the timeline, the plateforme agréée model (the State runs no free public invoicing platform), and the e-invoicing route each software in our France directory names.
      </p>
      <p class="mt-3 text-sm text-slate-500">By WrenchStack Research · Published June 2026 · Updated 1 October 2026 (calendar and e-reporting checked on service-public.fr) · Not tax advice: confirm your situation with the DGFiP (impots.gouv.fr) or your expert-comptable.</p>
    </header>

    <section class="mb-8 rounded-lg border-2 border-orange-300 bg-orange-50 p-6">
      <h2 class="mb-2 text-lg font-bold text-slate-900">⏰ The short version</h2>
      <p class="text-slate-800 leading-relaxed">
        Since <strong>1 September 2026</strong>, every French business, including auto-entrepreneurs, must be able to <strong>receive</strong> structured e-invoices. By <strong>1 September 2027</strong>, PME, TPE and micro-entreprises must also <strong>issue</strong> them. Invoices flow through a platform registered by the State (a <strong>PDP / plateforme agréée</strong>); the State runs no free public invoicing platform, though DGFiP says some approved platforms offer free services. The practical task: make sure your invoicing software is (or connects to) a registered platform before your deadline.
      </p>
    </section>

    <section class="mb-10 grid gap-3 sm:grid-cols-3">
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">1 Sept 2026</div>
        <div class="mt-1 text-xs text-slate-600">RECEPTION mandatory for ALL businesses</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">1 Sept 2027</div>
        <div class="mt-1 text-xs text-slate-600">ISSUANCE for SMEs &amp; micro-entreprises</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">PDP</div>
        <div class="mt-1 text-xs text-slate-600">approved platform (no free State platform)</div>
      </div>
    </section>

    <section class="mb-10 prose prose-slate max-w-none">
      <h2>The phased timeline</h2>
      <p>The obligation rests on article 289 bis of the CGI and the loi de finances pour 2024 (loi n° 2023-1322), per service-public.fr. DGFiP says there are no sanctions in 2026 while businesses adapt.</p>
      <ul>
        <li><strong>1 September 2026, reception:</strong> every business must be able to <em>receive</em> e-invoices (every size, including auto-entrepreneurs).</li>
        <li><strong>1 September 2026, issuance (large &amp; mid-size):</strong> grandes entreprises and ETI must <em>issue</em> e-invoices and do e-reporting.</li>
        <li><strong>1 September 2027, issuance (SMEs &amp; micro):</strong> PME, TPE and micro-entreprises must <em>issue</em> e-invoices and do e-reporting.</li>
      </ul>

      <h2>What the reform requires</h2>
      <ul>
        <li><strong>Use an approved platform (PDP / plateforme agréée).</strong> Invoices are issued, transmitted and received through a platform registered by the State: the State runs no free public platform for issuing, though DGFiP says more than ten of the 150 approved platforms offered free or no-extra-cost services on 1 August 2026.</li>
        <li><strong>Structured data.</strong> A PDF sent by email is not an e-invoice; our DGFiP entry notes 34 structured data items are required. Your platform handles the format.</li>
        <li><strong>The annuaire.</strong> The State runs the national directory that records which platform each company uses and its e-invoicing address.</li>
        <li><strong>E-reporting.</strong> A parallel obligation sends data on sales to private customers (B2C) and on operations abroad to the tax administration, per service-public.fr.</li>
        <li><strong>Public-sector clients.</strong> Organilog, for example, says its Business plan and above include a Chorus Pro connector for public-sector clients; ask your vendor how it handles invoices to public bodies.</li>
      </ul>

      <h2>Points for building trades</h2>
      <p>
        Two points matter for artisans. First, your invoices can carry <strong>several TVA rates (20 / 10 / 5.5%)</strong>, and each line must carry the right rate. Second, if you are a <strong>micro-entrepreneur under the VAT franchise</strong>, your invoices still carry the "TVA non applicable, art. 293 B du CGI" mention, and micro-entreprises are in scope on the same calendar as other small firms.
      </p>

      <h2>What the software in our France directory says about e-invoicing</h2>
      <p>
        Each devis-facture tool in our <a href="/fr/">France directory</a> says it covers e-invoicing; here is the route each one names. Always check the official <a href="https://www.impots.gouv.fr/je-consulte-la-liste-des-plateformes-agreees" rel="nofollow noopener" target="_blank">DGFiP list of approved platforms</a> before committing.
      </p>
    </section>

    <section class="mb-10 overflow-x-auto">
      <table class="w-full text-sm border border-slate-200 rounded-lg overflow-hidden">
        <thead class="bg-slate-50 text-left text-slate-700">
          <tr>
            <th class="p-3 font-semibold">Software</th>
            <th class="p-3 font-semibold">E-invoicing route</th>
            <th class="p-3 font-semibold">What it is</th>
            <th class="p-3 font-semibold">Pricing</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 bg-white">
          {tools.map((t) => (
            <tr>
              <td class="p-3 font-semibold text-slate-900"><a href={`/fr/${t.slug}/`} class="text-orange-700 hover:underline">{t.name}</a></td>
              <td class="p-3 text-slate-700">{t.route}</td>
              <td class="p-3 text-slate-600">{t.fit}</td>
              <td class="p-3 text-slate-600">{t.prices}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="mt-3 text-xs text-slate-500">Source: WrenchStack France directory entries, re-verified against vendor pages and the DGFiP list on 30 September 2026. Confirm current status on the official impots.gouv.fr list.</p>
    </section>

    <section class="mb-10 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-2 text-lg font-bold text-slate-900">What about my devis-facture software (Obat, Tolteck, EBP…)?</h2>
      <p class="text-sm text-slate-700 leading-relaxed">
        Your <a href="/fr/" class="font-medium text-orange-700 hover:underline">job-management / devis-facture tool</a> issues your invoices, so it must be able to send and receive them through an approved platform by your deadline, either by being a registered platform itself, or by routing through one. The question for any vendor: <strong>"Are you a registered platform, or which platform do you connect to, and from when?"</strong> Don't assume a quoting tool covers the mandate; confirm the platform path.
      </p>
    </section>

    <section class="mb-10 prose prose-slate max-w-none">
      <h2>Readiness checklist for artisans</h2>
      <ol>
        <li><strong>Confirm you can receive e-invoices now</strong>: this has applied to every business, including micro-entrepreneurs, since 1 September 2026.</li>
        <li><strong>Ask your invoicing software the platform question:</strong> are you a registered platform, or which one do you route through, and from when?</li>
        <li><strong>If you're still on paper / Word / Excel,</strong> choose a compliant tool well ahead of the deadlines.</li>
        <li><strong>Check multi-rate TVA handling</strong> (20 / 10 / 5.5%) and, if you're under the franchise, the art. 293 B mention.</li>
        <li><strong>Plan to issue via an approved platform by 1 September 2027</strong> (SMEs / micro); large and mid-size firms have had to issue since 1 September 2026.</li>
        <li><strong>Test before the deadline</strong>: this touches every invoice you send and receive.</li>
      </ol>
    </section>

    <section class="mb-10">
      <h2 class="mb-5 text-2xl font-bold text-slate-900">Frequently asked questions</h2>
      <div class="space-y-3">
        {faqs.map((f) => (
          <details class="rounded-lg border border-slate-200 bg-white p-4">
            <summary class="cursor-pointer font-semibold text-slate-900">{f.q}</summary>
            <p class="mt-3 text-slate-700 leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mb-10 rounded-lg bg-slate-50 p-5 text-xs text-slate-500 leading-relaxed">
      <strong class="text-slate-700">Sources &amp; verification:</strong> Calendar by company size, e-reporting scope, the annuaire and the legal references (CGI art. 289 bis; loi n° 2023-1322) checked on 1 October 2026 on service-public.fr (<a href="https://entreprendre.service-public.gouv.fr/vosdroits/F39785" rel="nofollow noopener" target="_blank">page F39785</a>, verified by service-public.fr on 7 August 2026). Free platform offers, the 150 approved platforms and the no-sanctions-in-2026 position from DGFiP, per our facturation électronique entry (re-verified 30 September 2026). Software positions from our France directory entries and the DGFiP list; confirm on the official list. General information, not tax advice. Spotted an error? <a href="/contact/" class="underline">Tell us</a>.
    </section>

    <section class="rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">Compare French trades software & services</h2>
      <p class="mt-2 text-slate-300 leading-relaxed">Independent reviews of French devis-facture software, lead-gen, payroll and mandatory décennale insurance, with no pay-to-play.</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/fr/" class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600">🇫🇷 France directory →</a>
        <a href="/fr/compare/" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">Compare vendors</a>
        <a href="/for-vendors/" class="rounded-md border border-white/30 bg-white/10 px-5 py-3 text-sm font-semibold text-white hover:bg-white/20">Are you a vendor? Work with us</a>
      </div>
    </section>
  </article>
</Layout>
