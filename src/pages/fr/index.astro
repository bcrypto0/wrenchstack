---
import Layout from '../../layouts/Layout.astro';
import frData from '../../data/international/fr.json';

interface FrVendor {
  slug: string; name: string; category: string; vendor_url: string;
  tagline: string; market_position: string; fr_specific_note?: string | null;
  tier: 'S' | 'A' | 'F'; reputation_flag: string | null;
  pros: string[]; cons: string[]; typical_pricing: string;
  is_cross_market: boolean; cross_market_link: string | null;
}

const vendors = (frData as { vendors: FrVendor[] }).vendors;
const categories = ['software', 'lead-gen', 'payroll', 'insurance', 'certification'];
const categoryMeta: Record<string, { label: string; description: string }> = {
  'software': { label: 'Devis-facture & job-management software', description: `Quote (devis), invoice (facture) and worksite software used by French building firms. Obat, Tolteck, EBP Bâtiment, Batappli and Mediabat are built for the building trades; Vertuoza is construction-management software from a Belgian company; Organilog is built around interventions and maintenance contracts; Axonaut is general business software. Each says it covers French e-invoicing: Obat (Iopole), EBP (Shine), Batappli (Cecurity) and Tolteck (Pennylane, for receipt) name their plateforme agréée, Axonaut is on the DGFiP list itself, and Mediabat, Vertuoza and Organilog do not name theirs.` },
  'lead-gen': { label: 'Lead generation', description: `Sites that bring homeowner work to building firms, each charging differently: Habitatpresto (annual membership fee and no commission on work, per its terms), Travaux.com (free sign-up, paid subscription to answer requests; owned by Angi Inc.), StarOfService (a generalist services marketplace with subscription plans published in its terms) and Quotatis, whose site now presents fixed-price installation packages and which a 2019 La Poste article linked to ADEO (Leroy Merlin).` },
  'payroll': { label: 'Payroll (paie)', description: `Payroll for small French firms: PayFit sold direct with published prices, Silae through accounting firms and integrators, EBP Paie (software or outsourced) and Sage Business Cloud Paie. PayFit says BTP collective agreements are not yet integrated, and the other three do not describe BTP-specific handling on the pages checked, so get your BTP convention and CIBTP leave-fund declarations confirmed in writing.` },
  'insurance': { label: 'Insurance: décennale & RC Pro', description: `Compulsory ten-year décennale cover and related liability: SMABTP, a construction mutual founded in 1859; APRIL Construction and Orus, brokers that publish starting prices; AXA's BATISSUR Concept contract; and MAAF, a mutual in the Covéa group. SMABTP, AXA and MAAF publish no prices, so get quotes and compare the activities covered.` },
  'certification': { label: 'Compliance & qualifications', description: `Rules and schemes French building firms deal with: e-invoicing through a plateforme agréée, compulsory décennale insurance, the three VAT rates, Urssaf and the micro-entrepreneur regime, business registration and the professional qualification for regulated trades, plus two voluntary schemes: the RGE label, which clients need to claim energy-renovation aid, and Qualibat qualification.` },
};
const vendorsByCategory: Record<string, FrVendor[]> = {};
categories.forEach(c => { vendorsByCategory[c] = vendors.filter(v => v.category === c); });

const pageTitle = 'France Trades Software & Services (Artisans du Bâtiment) | WrenchStack';
const pageDescription = `Independent directory of ${vendors.length} vendors and official schemes for French building trades: devis-facture software, lead sources, payroll and décennale insurance, plus the e-invoicing, VAT, registration and qualification rules and the RGE label for energy-renovation work.`;
const breadcrumbs = [ { name: 'Home', url: '/' }, { name: 'France', url: '/fr/' } ];
const enUrl = new URL('/fr/', Astro.site).toString();
const frUrl = new URL('/fr/fr/', Astro.site).toString();
---
<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs} alternateUrls={[{ hreflang: 'en', href: enUrl }, { hreflang: 'fr', href: frUrl }, { hreflang: 'x-default', href: enUrl }]}>
  <article class="mx-auto max-w-5xl px-4 py-12">
    <header class="mb-10">
      <div class="mb-3 flex items-center justify-between gap-3">
        <div class="flex items-center gap-2">
          <span class="text-2xl" aria-hidden="true">🇫🇷</span>
          <p class="text-sm font-semibold uppercase tracking-wider text-orange-600">France · Artisans du bâtiment</p>
        </div>
        <a href="/fr/fr/" class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">Français</a>
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">France Trades Software & Services Directory</h1>
      <p class="mt-4 text-lg text-slate-600 leading-relaxed">
        Independent reviews of {vendors.length} France-relevant vendors and official schemes for artisans du bâtiment: devis-facture software (Obat, Tolteck, EBP Bâtiment), lead sources (Habitatpresto, Travaux.com), payroll (PayFit, Silae) and décennale insurance (SMABTP, APRIL Construction, Orus), with the French rules that shape the choice: e-invoicing through a plateforme agréée, three VAT rates, the RGE label for energy-renovation aid and the micro-entrepreneur regime.
      </p>
    </header>

    <section class="mb-10 grid gap-3 grid-cols-2 sm:grid-cols-4">
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">{vendors.length}</div>
        <div class="mt-1 text-xs text-slate-600">vendors &amp; schemes</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">10 years</div>
        <div class="mt-1 text-xs text-slate-600">décennale cover from reception</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">20 / 10 / 5.5%</div>
        <div class="mt-1 text-xs text-slate-600">TVA rates on housing work</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">1 Sept 2027</div>
        <div class="mt-1 text-xs text-slate-600">e-invoice issuing for artisans</div>
      </div>
    </section>

    <section class="mb-10 flex flex-wrap items-center justify-between gap-4 rounded-lg border-2 border-emerald-300 bg-emerald-50 p-5">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-emerald-700">⏰ Compliance guide · Reception for all since 1 Sept 2026 · SME issuance by 1 Sept 2027</p>
        <h2 class="mt-1 text-base font-bold text-slate-900">Facturation électronique (e-invoicing) for artisans</h2>
        <p class="mt-1 text-sm text-slate-700">The phased timeline, how the plateformes agréées work (the State runs no free public invoicing platform) and which software is a registered platform.</p>
      </div>
      <a href="/fr/guides/facturation-electronique-artisans/" class="shrink-0 rounded-md bg-emerald-700 px-5 py-3 text-sm font-semibold text-white hover:bg-emerald-800">Read the guide →</a>
    </section>

    <section class="mb-10 flex flex-wrap items-center justify-between gap-4 rounded-lg border border-orange-200 bg-orange-50 p-5">
      <div>
        <h2 class="text-base font-bold text-slate-900">Deciding between two options?</h2>
        <p class="mt-1 text-sm text-slate-700">See French vendors side by side: pros and cons, France-specific notes and pricing for each.</p>
      </div>
      <a href="/fr/compare/" class="shrink-0 rounded-md bg-slate-900 px-5 py-3 text-sm font-semibold text-white hover:bg-slate-700">Compare French vendors →</a>
    </section>

    <section class="mb-10 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-3 text-base font-bold text-slate-900">What's different about running a trades business in France</h2>
      <p class="text-sm text-slate-700 leading-relaxed">
        French artisan software selection differs from the US or UK in several ways. First, <strong>structured e-invoicing is now in force</strong>: since 1 September 2026 every business must be able to receive e-invoices through a plateforme agréée, and by 1 September 2027 PME, TPE and micro-entreprises must also issue them. The State runs no free public invoicing platform, though DGFiP says more than ten of the 150 approved platforms offered free or no-extra-cost services on 1 August 2026. Software choice therefore carries compliance weight. Second, <strong>assurance décennale is mandatory</strong>: ten-year liability from reception under the Loi Spinetta, taken out before work starts; building without it is punishable by up to 6 months' imprisonment and/or a 75,000 euro fine, per service-public.fr, and the insurance certificate must be attached to every devis and invoice. Third, <strong>TVA is multi-rate</strong> (20% standard, 10% for improvement and maintenance, 5.5% for energy-renovation work, on dwellings completed more than two years ago), so quoting software should let you set the rate per line. Fourth, <strong>RGE is not a licence to work</strong>, but the French ecology ministry says clients can only get MaPrimeRénov', CEE bonuses or an éco-PTZ if the work is done by an RGE professional. And under the <strong>micro-entrepreneur</strong> regime, Urssaf contributions are a share of turnover (21.2% for artisanal services in 2026), and below the VAT franchise threshold (37,500 euros for services) invoices carry the "TVA non applicable - article 293 B du CGI" mention.
      </p>
    </section>

    {categories.map(c => {
      const cat = categoryMeta[c];
      const cv = vendorsByCategory[c];
      if (cv.length === 0) return null;
      return (
        <section class="mb-12">
          <div class="mb-5">
            <h2 class="text-2xl font-bold text-slate-900">{cat.label}</h2>
            <p class="mt-1 text-sm text-slate-600 leading-relaxed">{cat.description}</p>
          </div>
          <div class="space-y-4">
            {cv.map(v => {
              const isCert = v.category === 'certification';
              const tierColor = v.tier === 'S' ? 'border-emerald-300' : v.tier === 'F' ? 'border-rose-300' : 'border-blue-300';
              const tierLabel = isCert ? 'Official body / regime' : v.tier === 'S' ? 'Published prices' : v.tier === 'F' ? 'Reputation warning' : 'Listed';
              const tierBadge = v.tier === 'S' ? 'bg-emerald-100 text-emerald-900' : v.tier === 'F' ? 'bg-rose-100 text-rose-900' : 'bg-blue-100 text-blue-900';
              return (
                <article class={`rounded-lg border-2 ${tierColor} bg-white p-5`}>
                  <div class="mb-3 flex items-start justify-between gap-3">
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-2 mb-1 flex-wrap">
                        <h3 class="text-xl font-bold text-slate-900">{v.name}</h3>
                        <span class={`rounded-full px-2 py-0.5 text-xs font-bold ${tierBadge}`}>{isCert ? tierLabel : `Tier ${v.tier} · ${tierLabel}`}</span>
                        {v.is_cross_market && (<span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-700">Cross-market</span>)}
                      </div>
                      <p class="text-sm italic text-slate-500">{v.tagline}</p>
                    </div>
                  </div>
                  <p class="mb-3 text-sm text-slate-700 leading-relaxed">{v.market_position}</p>
                  {v.fr_specific_note && (
                    <div class="mb-3 rounded-md bg-slate-50 px-4 py-3">
                      <p class="text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">France-specific note</p>
                      <p class="text-sm text-slate-700 leading-relaxed">{v.fr_specific_note}</p>
                    </div>
                  )}
                  <div class="mb-3 grid gap-3 sm:grid-cols-2">
                    <div>
                      <p class="text-xs font-bold uppercase tracking-wider text-emerald-700 mb-1">{isCert ? 'What it covers' : 'Pros'}</p>
                      <ul class="space-y-1 text-sm text-slate-700">{v.pros.slice(0, 4).map(p => <li class="leading-snug">+ {p}</li>)}</ul>
                    </div>
                    <div>
                      <p class="text-xs font-bold uppercase tracking-wider text-rose-700 mb-1">{isCert ? 'Watch out for' : 'Cons'}</p>
                      <ul class="space-y-1 text-sm text-slate-700">{v.cons.slice(0, 4).map(con => <li class="leading-snug">− {con}</li>)}</ul>
                    </div>
                  </div>
                  <div class="mb-3 text-xs text-slate-600"><strong class="text-slate-900">{isCert ? 'Cost / access:' : 'Typical French pricing:'}</strong> {v.typical_pricing}</div>
                  <div class="flex flex-wrap gap-2">
                    <a href={`/fr/${v.slug}/`} class="rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700">Full France review →</a>
                    <a href={v.vendor_url} rel="sponsored nofollow noopener" target="_blank" class="rounded-md bg-orange-500 px-4 py-2 text-sm font-semibold text-white hover:bg-orange-600">{isCert ? 'Official site' : `Visit ${v.name}`} →</a>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      );
    })}

    <section class="mt-12 rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">Are you a French vendor?</h2>
      <p class="mt-2 text-slate-300 leading-relaxed">If you build software or services for French artisans and want to be reviewed or featured, get in touch through our <a href="/for-vendors/" class="underline">vendor program</a>.</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/for-vendors/" class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600">Work with us →</a>
        <a href="/software-by-country/" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">🌍 Software by country</a>
        <a href="/methodology/" class="rounded-md border border-white/30 bg-white/10 px-5 py-3 text-sm font-semibold text-white hover:bg-white/20">Methodology</a>
      </div>
    </section>
  </article>
</Layout>
