---
import Layout from '../../layouts/Layout.astro';
import VendorLogo from '../../components/VendorLogo.astro';
import { accountingSoftware, accountingByPosition, ACCOUNTING_POSITION_META, tools } from '../../lib/data';
import MissingFromList from '../../components/MissingFromList.astro';

const grouped = accountingByPosition();

// Software tools in the directory that list any QuickBooks integration (Online, Desktop or unspecified).
const qbToolCount = tools.filter((t) => t.integrations.some((i) => /quickbooks/i.test(i))).length;
const qbToolLine = `${qbToolCount} of the ${tools.length} software tools in this directory list a QuickBooks integration`;

const pageTitle = `Best Accounting Software for Contractors & Trades (2026)`;
const pageDescription = `Independent comparison of ${accountingSoftware.length} accounting and bill-pay tools for trades contractors, including QuickBooks Online, Xero, FreshBooks, Wave, Zoho Books and Sage 50, grouped by positioning: full accounting, invoicing-first, free, mid-market and bill pay. Published plan prices, plan limits and trade-offs for each.`;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Accounting', url: '/accounting/' },
];

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Accounting Software for Trades Contractors',
  numberOfItems: accountingSoftware.length,
  itemListElement: accountingSoftware.map((a, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'SoftwareApplication',
      name: a.name,
      description: a.tagline,
      url: `https://wrenchstack.com/accounting/${a.slug}/`,
    },
  })),
};
---

<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  <article class="mx-auto max-w-5xl px-4 py-12">
    <header class="mb-10">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-sky-600">Accounting</p>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">
        Best Accounting Software for Contractors & Trades (2026)
      </h1>
      <p class="mt-4 text-lg text-slate-600 leading-relaxed">
        Your accounting software is where your books live, and it may be what your field-service tool syncs to. We compare {accountingSoftware.length} options grouped by how much accounting they do: full double-entry books, invoicing-first, free, mid-market platforms with accounting built in, and bill pay that syncs to your books. Each review lists published prices, plan limits and an affiliate disclosure.
      </p>
    </header>

    <section class="mb-10 rounded-lg border-l-4 border-orange-500 bg-orange-50/40 p-5">
      <p class="text-xs font-bold uppercase tracking-wider text-orange-600">The short answer</p>
      <p class="mt-2 text-slate-800 leading-relaxed">
        No one tool fits every shop; match it to what your books need to do. <a href="/accounting/quickbooks-online/" class="font-semibold text-orange-700 hover:underline">QuickBooks Online</a> has a Free plan and paid plans from $20 to $340 a month at regular prices, with job costing and inventory from Plus ($140/mo); {qbToolLine}. <a href="/accounting/xero/" class="font-semibold text-orange-700 hover:underline">Xero</a> charges no per-user license fees; its US plans are $27, $59 and $97 a month from October 1, 2026. <a href="/accounting/freshbooks/" class="font-semibold text-orange-700 hover:underline">FreshBooks</a> is built around invoicing, with plans priced by how many clients you bill (Lite, $23/mo, covers up to 5). <a href="/accounting/wave/" class="font-semibold text-orange-700 hover:underline">Wave</a> has a free Starter plan with unlimited invoices and double-entry books. Whichever you pick, confirm that your field-service software syncs with it. No vendor pays for placement.
      </p>
    </section>

    <section class="mb-10 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-3 text-base font-bold text-slate-900">The headline filter: how much accounting do you need?</h2>
      <p class="text-sm text-slate-700 leading-relaxed">
        <strong>Full double-entry accounting</strong> (QuickBooks Online, Xero, Zoho Books, Sage 50, Patriot Accounting and QuickBooks Desktop Enterprise) covers bank reconciliation, invoicing, bills and financial reports. Job costing or project tracking starts at QuickBooks Online Plus, Xero Established and Zoho Books Professional, and is part of Sage 50 and QuickBooks Enterprise; Patriot Accounting has no job costing. <strong>Invoicing-first</strong> (FreshBooks) centers on quotes, invoices and getting paid, with plans priced by the number of clients you bill. <strong>Free</strong> (Wave) keeps double-entry books and unlimited invoices at $0 and charges for card and bank payments, payroll and its Pro plan. <strong>Mid-market</strong> (Striven) builds accounting into a per-user platform with job costing and technician scheduling. <strong>Bill pay</strong> (Melio) pays subs and suppliers and syncs to QuickBooks or Xero; it does not replace accounting software. Field-service sync varies by tool and plan, so check what your scheduling software supports before you choose.
      </p>
    </section>

    {grouped.map(({ position, software }) => {
      const meta = ACCOUNTING_POSITION_META[position];
      return (
        <section class="mb-12">
          <div class="mb-5">
            <span class="inline-block rounded-full bg-sky-100 px-3 py-1 text-xs font-bold uppercase tracking-wider text-sky-900 ring-1 ring-sky-300">{meta.label}</span>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">{meta.blurb}</p>
          </div>

          <div class="space-y-4">
            {software.map((a) => (
              <article class="rounded-lg border-2 border-sky-200 bg-white p-5">
                <div class="mb-3 flex items-start justify-between gap-3">
                  <div class="flex min-w-0 flex-1 items-center gap-3">
                    <VendorLogo name={a.name} url={a.vendor_url} size={40} />
                    <div class="min-w-0">
                      <h3 class="text-xl font-bold text-slate-900">
                        <a href={`/accounting/${a.slug}/`} class="hover:text-sky-600">{a.name}</a>
                      </h3>
                      <p class="text-sm italic text-slate-500">{a.tagline}</p>
                    </div>
                  </div>
                  <div class="shrink-0 text-right text-xs">
                    <p class="font-bold text-slate-900">{a.starting_price_usd === 0 ? 'Free' : a.starting_price_usd !== null ? `From $${a.starting_price_usd}/mo` : 'Custom'}</p>
                  </div>
                </div>

                {a.reputation_flag && (
                  <div class="mb-3 rounded-md border-l-4 border-rose-500 bg-rose-50 px-4 py-3 text-sm text-rose-900">
                    <p class="font-bold uppercase tracking-wider text-xs text-rose-700 mb-1">⚠ Heads up</p>
                    <p class="leading-relaxed">{a.reputation_flag.split('.')[0]}.</p>
                  </div>
                )}

                <dl class="mb-3 grid grid-cols-2 gap-2 text-xs sm:grid-cols-4">
                  <div>
                    <dt class="text-slate-500 uppercase tracking-wider">Founded</dt>
                    <dd class="font-semibold text-slate-900">{a.founded ?? '-'}</dd>
                  </div>
                  <div>
                    <dt class="text-slate-500 uppercase tracking-wider">Free trial</dt>
                    <dd class="font-semibold text-slate-900">{a.starting_price_usd === 0 ? 'Free plan' : a.free_trial_days > 0 ? `${a.free_trial_days} days` : 'No'}</dd>
                  </div>
                  <div>
                    <dt class="text-slate-500 uppercase tracking-wider">Best team size</dt>
                    <dd class="font-semibold text-slate-900">{a.best_team_size}</dd>
                  </div>
                  <div>
                    <dt class="text-slate-500 uppercase tracking-wider">Verified</dt>
                    <dd class="font-semibold text-slate-900">{a.verified_date}</dd>
                  </div>
                </dl>

                <p class="mb-3 text-sm text-slate-700 leading-relaxed">
                  <strong class="text-slate-900">Best for:</strong> {a.best_for}
                </p>

                <div class="flex flex-wrap gap-2">
                  <a href={`/accounting/${a.slug}/`} class="rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800">Read full review →</a>
                  <a href={a.affiliate_url.startsWith('http') ? a.affiliate_url : a.vendor_url} rel="sponsored nofollow noopener" target="_blank" class="rounded-md border border-sky-300 bg-white px-4 py-2 text-sm font-semibold text-sky-700 hover:bg-sky-50">Visit {a.name}</a>
                </div>
              </article>
            ))}
          </div>
        </section>
      );
    })}

    <section class="mt-12 rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">Where to start</h2>
      <p class="mt-2 text-slate-300 leading-relaxed">
        Start with what your books need to do. <strong>Job costing in the cloud:</strong> QuickBooks Online Plus ($140/mo list); or, on Windows with up to 40 users, QuickBooks Desktop Enterprise (from $2,210 a year). <strong>Several people in the books:</strong> Xero, with no per-user license fees, or Patriot Accounting ($20/mo, unlimited users). <strong>Solo, billing a few clients:</strong> FreshBooks (Lite $23/mo for up to 5 billable clients). <strong>New and watching every dollar:</strong> Wave's free Starter plan, or Zoho Books' free plan while revenue stays under $50K a year. <strong>Job costing by phase and cost code:</strong> Sage 50 Premium (from $182.50/mo on a one-year commitment). <strong>Paying subs and suppliers:</strong> Melio, which syncs bill payments to QuickBooks or Xero; read its BBB warning first. Before deciding, confirm what your field-service software syncs to.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/accounting/quickbooks-online/" class="rounded-md bg-sky-500 px-5 py-3 text-sm font-semibold text-white hover:bg-sky-600">See QuickBooks Online →</a>
        <a href="/payroll/" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">Payroll</a>
        <a href="/payments/" class="rounded-md border border-white/30 bg-white/10 px-5 py-3 text-sm font-semibold text-white hover:bg-white/20">Payments</a>
      </div>
    </section>
    <MissingFromList listName="accounting platforms for trades" count={accountingSoftware.length} />
  </article>
</Layout>
