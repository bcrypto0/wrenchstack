---
import Layout from '../../../../layouts/Layout.astro';
import {
  leadGenPlatforms,
  leadGenTier,
  verticals,
  verticalToUrl,
  getVertical,
  type LeadGenPlatform,
} from '../../../../lib/data';

// Trades we cover with dedicated lead-gen buyer guides
const TARGET_VERTICALS = [
  'hvac',
  'plumbing',
  'electrical',
  'roofing',
  'general_contractor',
  'landscaping',
  'cleaning',
  'pest_control',
];

export async function getStaticPaths() {
  const TARGET_VERTICALS = [
    'hvac', 'plumbing', 'electrical', 'roofing',
    'general_contractor', 'landscaping', 'cleaning', 'pest_control',
  ];
  return TARGET_VERTICALS.map((slug) => {
    const v = getVertical(slug);
    if (!v) return null;
    return {
      params: { vertical: verticalToUrl(slug) },
      props: { verticalSlug: slug },
    };
  }).filter((p): p is NonNullable<typeof p> => !!p);
}

interface Props {
  verticalSlug: string;
}

const { verticalSlug } = Astro.props;
const vertical = getVertical(verticalSlug)!;

// Platforms that serve this vertical, grouped by tier
const platformsForVertical = leadGenPlatforms.filter((p) =>
  p.verticals.includes(verticalSlug)
);

const byTier: Record<'S' | 'A' | 'F', LeadGenPlatform[]> = { S: [], A: [], F: [] };
for (const p of platformsForVertical) {
  byTier[leadGenTier(p)].push(p);
}

const pageTitle = `Best Lead-Gen Platforms for ${vertical.name} Contractors (2026)`;
const pageDescription = `Independent reviews of lead-gen platforms for ${vertical.name.toLowerCase()} contractors, including Google Local Services Ads and Service Direct: how each one charges, whether leads are shared or exclusive, and reputation warnings with their sources.`;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Lead-gen platforms', url: '/lead-gen/' },
  { name: vertical.name, url: `/lead-gen/trade/${verticalToUrl(verticalSlug)}/` },
];

const tierMeta = {
  S: { label: 'Tier S: exclusive leads or calls, no warning', color: 'bg-emerald-100 text-emerald-900 ring-emerald-300', cardBorder: 'border-emerald-300' },
  A: { label: 'Tier A: no warning, check the terms', color: 'bg-blue-100 text-blue-900 ring-blue-300', cardBorder: 'border-blue-300' },
  F: { label: 'Tier F: listed with a reputation warning', color: 'bg-rose-100 text-rose-900 ring-rose-300', cardBorder: 'border-rose-300' },
};

// Trade-specific intro framing
function tradeIntro(slug: string): string {
  switch (slug) {
    case 'hvac':
      return 'HVAC contractors can pay per exclusive lead on Google Local Services Ads, buy exclusive calls from Service Direct or eLocal, buy leads on marketplaces such as Thumbtack, Networx and Homeyou, or run self-serve ads on Nextdoor, Meta or Yelp. Service Direct publishes a vendor range of $65-$325 per heating and air conditioning call, at a price you set; many other sources here do not publish prices. Google lists HVAC among the US home service categories moving from Local Services Ads into Google Ads from August 2026.';
    case 'plumbing':
      return 'Plumbing contractors can pay per exclusive lead on Google Local Services Ads, buy exclusive calls from Service Direct or eLocal, or buy leads on marketplaces such as Thumbtack, Networx and Homeyou. Service Direct publishes a vendor range of $60-$255 per plumbing call, at a price you set; Google and eLocal do not publish prices. Google lists plumbing among the US home service categories moving from Local Services Ads into Google Ads from August 2026.';
    case 'electrical':
      return 'Google Local Services Ads screens US home service businesses before their ads run: Google lists background checks, state business and owner licenses, insurance (depending on category and location) and a verified Google Business Profile, says screening takes 3-4 weeks on average, and shows a Google Verified badge on businesses that pass. For exclusive calls, Service Direct publishes a vendor range of $55-$175 per electrician call at a price you set, and eLocal sells exclusive live calls without published prices. Houzz Pro, Thumbtack and Networx also list electrical work.';
    case 'roofing':
      return 'Roofers can buy exclusive calls from Service Direct (a vendor-published range of $85-$550 per roofing call, at a price you set), 33 Mile Radius (a flat rate per lead that varies by service area, quoted by sales and billed weekly) or eLocal, pay per exclusive lead on Google Local Services Ads, or buy leads from Modernize, a QuinStreet brand for replacement and remodeling work. 33 Mile Radius, part of EverConnect, which Ignite Visibility bought from EverCommerce in October 2025, says its partners average about 2-5 leads a month and that volume varies with season, service, area and weather.';
    case 'general_contractor':
      return 'Remodelers and design-build firms can use Houzz Pro, which combines project-management software with a Houzz profile (free plan; Design $99/mo and Pro $199/mo; Advertising Package from $499/mo), or lead sources such as Modernize, a QuinStreet brand for replacement and remodeling work, and Pro Referral, the Home Depot referral service with points-based leads and no cash lead fee (joining requires a $41.99 background check). Google Local Services Ads, Service Direct, 33 Mile Radius and eLocal also list general contracting.';
    case 'landscaping':
      return 'Lawn-care businesses have two marketplaces built for them. On GreenPal you bid your own price on each lawn and pay a 5% fee on each successful customer payment, plus card processing. LawnStarter sets each job price, keeps ownership of the customer and bars providers from soliciting or accepting business from those customers during the agreement and for a year after it ends (see its reputation warning). Google Local Services Ads, Service Direct, Thumbtack and Nextdoor also list landscaping.';
    case 'cleaning':
      return 'Cleaning businesses can pay per exclusive lead on Google Local Services Ads after passing Google screening, or set their own lead price and a weekly budget on Thumbtack. Thumbtack says some customers contact more than one pro for the same job, so respond quickly and track cost per booked job. Service Direct, Networx, Homeyou and Porch also list cleaning, as do self-serve ads on Nextdoor and Meta.';
    case 'pest_control':
      return 'Pest control businesses can buy exclusive calls from Service Direct, which publishes a vendor range of $40-$195 per pest control call at a price you set, or pay per exclusive lead on Google Local Services Ads. Google lists pest control among the US home service categories moving from Local Services Ads into Google Ads from August 2026. Thumbtack and Porch also list pest control, as do self-serve ads on Nextdoor, Meta and Yelp.';
    default:
      return `Lead-gen platforms that list ${vertical.name.toLowerCase()} work, with how each one charges and any reputation warning.`;
  }
}

const faqs = [
  {
    q: `Which lead-gen platforms are in Tier S for ${vertical.name.toLowerCase()} work?`,
    a: byTier.S.length > 0
      ? `For ${vertical.name.toLowerCase()} work, Tier S lists ${byTier.S.map((p) => p.name).join(', ')}. Tier S means no reputation warning and a lead model in which each lead or call goes to one business (exclusive leads or pay-per-call); it is not a ranking of lead quality or cost.${byTier.S.some((p) => p.slug === 'elocal') ? ` eLocal's live calls are exclusive, but its form leads can be shared.` : ''} These services charge in different ways, so compare the pricing and billing rules in each review, and track cost per booked job for every source you use.`
      : `No Tier S platform lists ${vertical.name.toLowerCase()} work. Compare the pricing and lead-sharing terms of the platforms above, and track cost per booked job for every source you use.`,
  },
  {
    q: `What does a lead cost for ${vertical.name.toLowerCase()} work?`,
    a: `Most lead sources we review publish no per-lead or per-call rate card, including Google Local Services Ads, Thumbtack, 33 Mile Radius, eLocal and Porch. Service Direct publishes vendor ranges per call by trade, from $15-$75 for locksmiths to $500-$2,250 for water damage restoration, and the Networx help center puts leads at about $10-$100+ on its shared plan and $15-$120+ on its exclusive plan. Compare cost per booked job, not cost per lead, and check what each source counts as a billable lead.`,
  },
  {
    q: `Should I use HomeAdvisor or Angi for ${vertical.name.toLowerCase()} leads?`,
    a: `Both carry a reputation warning. The FTC consent order against HomeAdvisor, finalized in April 2023, bars the deceptive lead-marketing claims the FTC alleged and requires HomeAdvisor to pay up to $7.2 million. Angi, a sister company under Angi Inc., settled with the Vermont Attorney General in October 2025 over its "Angi Certified Pro" term and agreed to pay the state $100,000. Our reviews list neither as a first choice for any trade. If you use one, cap a monthly lead budget and track cost per booked job; the full reviews have the details.`,
  },
  {
    q: `How do I tell whether a lead source is working for ${vertical.name.toLowerCase()} work?`,
    a: `Track calls, forms and booked jobs by source so you can compare cost per booked job. Call tracking such as CallRail (from $50/mo billed yearly) tracks and attributes calls, texts and forms from your other channels. Check each source's billing and credit rules as well: Google Local Services Ads can charge for missed calls you follow up on, eLocal counts unanswered and voicemail calls as valid, Bark refunds credits only for invalid contact details reported within 7 days, and Networx gives 14 days to request a credit.`,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <article class="mx-auto max-w-5xl px-4 py-12">
    <header class="mb-10">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-orange-600">
        Lead-gen · {vertical.name}
      </p>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">
        Best Lead-Gen Platforms for {vertical.name} Contractors (2026)
      </h1>
      <p class="mt-4 text-lg text-slate-600 leading-relaxed">
        {tradeIntro(verticalSlug)}
      </p>
    </header>

    {(['S', 'A', 'F'] as const).map((tier) => {
      const platforms = byTier[tier];
      if (platforms.length === 0) return null;
      const meta = tierMeta[tier];
      return (
        <section class="mb-12">
          <div class="mb-5 flex items-baseline gap-3">
            <h2 class="text-2xl font-bold text-slate-900">{meta.label}</h2>
            <span class={`inline-block rounded-full px-2 py-0.5 text-xs font-bold ring-1 ${meta.color}`}>{platforms.length}</span>
          </div>

          <div class="space-y-4">
            {platforms.map((p) => (
              <article class={`rounded-lg border-2 ${meta.cardBorder} bg-white p-5`}>
                <div class="mb-3 flex items-start justify-between gap-3">
                  <div class="min-w-0 flex-1">
                    <h3 class="text-xl font-bold text-slate-900">
                      <a href={`/lead-gen/${p.slug}/`} class="hover:text-orange-600">{p.name}</a>
                    </h3>
                    <p class="text-sm italic text-slate-500">{p.tagline}</p>
                  </div>
                  <div class="shrink-0 text-right text-xs">
                    <p class="font-bold text-slate-900 uppercase tracking-wider">{p.lead_model.replace(/-/g, ' ')}</p>
                    <p class="text-slate-500">{p.typical_cost}</p>
                  </div>
                </div>

                {p.reputation_flag && (
                  <div class="mb-3 rounded-md border-l-4 border-rose-500 bg-rose-50 px-4 py-3 text-sm text-rose-900">
                    <p class="font-bold uppercase tracking-wider text-xs text-rose-700 mb-1">⚠ Reputation warning</p>
                    <p class="leading-relaxed">{p.reputation_flag.split('.')[0]}.</p>
                  </div>
                )}

                <p class="mb-3 text-sm text-slate-700 leading-relaxed">
                  <strong class="text-slate-900">Best for:</strong> {p.best_for}
                </p>

                <div class="flex flex-wrap gap-2">
                  <a
                    href={`/lead-gen/${p.slug}/`}
                    class="rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800"
                  >
                    Read full review →
                  </a>
                  <a
                    href={p.affiliate_url.startsWith('http') ? p.affiliate_url : p.vendor_url}
                    rel="sponsored nofollow noopener"
                    target="_blank"
                    class="rounded-md border border-orange-300 bg-white px-4 py-2 text-sm font-semibold text-orange-700 hover:bg-orange-50"
                  >
                    Visit {p.name}
                  </a>
                </div>
              </article>
            ))}
          </div>
        </section>
      );
    })}

    <section class="mb-10">
      <h2 class="mb-5 text-2xl font-bold text-slate-900">Frequently asked for {vertical.name.toLowerCase()} contractors</h2>
      <div class="space-y-3">
        {faqs.map((f) => (
          <details class="rounded-lg border border-slate-200 bg-white p-4">
            <summary class="cursor-pointer font-semibold text-slate-900">{f.q}</summary>
            <p class="mt-3 text-slate-700 leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">More for {vertical.name.toLowerCase()} contractors</h2>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href={`/${verticalToUrl(verticalSlug)}/`} class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600">
          {vertical.name} software directory →
        </a>
        <a href="/lead-gen/" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">
          All lead-gen platforms
        </a>
        <a href="/quiz/" class="rounded-md border border-white/30 bg-white/10 px-5 py-3 text-sm font-semibold text-white hover:bg-white/20">
          Matching quiz
        </a>
      </div>
    </section>
  </article>
</Layout>
