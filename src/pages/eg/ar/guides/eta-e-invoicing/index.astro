---
import Layout from '../../../../../layouts/Layout.astro';

const tools = [
  { name: 'Daftra', status: 'تقول الشركة إنها متكاملة بالكامل مع الضرائب (توقيع، GS1، ضريبة القيمة المضافة المصرية)', fit: 'منشآت محاسبة/فوترة', note: 'من ٢٠$ شهرياً بالدفع السنوي', href: '/eg/daftra/' },
  { name: 'AccFlex', status: 'تقول الشركة إنها معتمدة من الضرائب؛ إصدار مقاولات بالمستخلصات', fit: 'منشآت ومنها المقاولون', note: 'غير مؤكد (نموذج طلب عرض سعر)', href: '/eg/accflex-erp/' },
  { name: 'DoubleClick ERP', status: 'تقول الشركة إنها ترسل المستخلصات والفواتير مباشرة إلى الضرائب', fit: 'مقاولون (المكتب الفني ← المالية)', note: 'حسب الطلب', href: '/eg/doubleclick-erp/' },
  { name: 'Voko ERP', status: 'وحدة فاتورة إلكترونية منفصلة + مستخلصات في وحدة المقاولات', fit: 'مقاولون', note: 'حسب الطلب', href: '/eg/voko-erp/' },
  { name: 'Edara', status: 'الفاتورة الإلكترونية المصرية في باقة Ultimate؛ وتقول الشركة إنها ترافق العميل حتى تشغيل الربط مع الضرائب', fit: 'منشآت التجارة والتوزيع', note: 'من ٢٩$ شهرياً + ٥$ لكل مستخدم (سنوياً)؛ باقة Ultimate من ٧٩$ + ١٢$ لكل مستخدم', href: '/eg/edara-erp/' },
  { name: 'Odoo', status: 'توطين مصري أصلي (API، GS1، توقيع USB) عبر شركاء', fit: 'نظام موارد كامل', note: 'اشتراك + تطبيق', href: '/eg/odoo/' },
  { name: 'OrchidaTax', status: 'وسيط للضرائب يربط SAP/Oracle/Dynamics/Odoo', fit: 'أبقِ نظامك وأضف الامتثال', note: 'حسب الطلب', href: '/eg/orchidatax/' },
  { name: 'QuickBooks', status: 'لا تذكر Intuit دعم الفاتورة الإلكترونية المصرية؛ تحتاج موصّلاً خارجياً (OrchidaTax يسرد QuickBooks)', fit: 'منشآت تستخدم QuickBooks', note: 'الموصّل بسعر منفصل', href: '/eg/quickbooks/' },
];

const faqs = [
  { q: 'هل الفاتورة الإلكترونية إلزامية الآن، ولمن؟', a: 'نعم، على الممولين المشمولين بقرارات المصلحة المرحلية. جعلت المصلحة الفاتورة الإلكترونية إلزامية على مراحل (بدأت المرحلة الخامسة في ١٥ ديسمبر ٢٠٢١، وامتدت المرحلة الثامنة من سبتمبر إلى ديسمبر ٢٠٢٢)، وتتيح أداة استعلام إلكترونية تبيّن ما إذا كانت منشأة بعينها مشمولة، فتحقّق من وضعك عبرها. أما معاملات المستهلك فيغطيها نظام الإيصال الإلكتروني الموازي. وحدّ التسجيل في ضريبة القيمة المضافة قيد المراجعة منذ أواخر ٢٠٢٥، لذا لا نذكر رقماً هنا.' },
  { q: 'ما هو نموذج «التخليص»؟', a: 'تعتمد مصر نموذج تخليص لحظي (رقابة مستمرة على المعاملات): تُرسَل كل وثيقة إلى مصلحة الضرائب وتُعتمَد قبل إصدارها للمتلقّي. تتحقّق المصلحة من البنية والحساب الضريبي والختم وأكواد الأصناف، ثم تمنح معرّفاً فريداً (UUID)، وتُعيد الوثائق المرفوضة أكواد أخطاء. وتحمل الإيصالات الإلكترونية رمز QR للتحقق. وهذا أكثر صرامة من الإبلاغ اللاحق.' },
  { q: 'ماذا يحدث إن لم ألتزم؟', a: 'نتيجتان: (١) قد تُمنَع المنشأة غير الملتزمة من التعامل مع الجهات الحكومية والمناقصات. (٢) غرامات بموجب قانون ٢٠٦/٢٠٢٠ (المادة ٧١) تتراوح بين ٢٠ ألف و١٠٠ ألف جنيه، مع تصعيد متدرّج للتأخير. وتُحفظ السجلات ٥ سنوات على الأقل.' },
  { q: 'ما الصيغة وما الأساس القانوني؟', a: 'الوثائق بصيغة JSON أو XML (لا PDF) وفق مخطط المصلحة، مع معرّف فريد، وبصمة تشفيرية، وتوقيع إلكتروني إلزامي عبر شهادة معتمدة (HSM أو توكن USB). وتُرمَّز الأصناف بأكواد GS1 أو الأكواد المصرية EGS. والأساس القانوني هو قانون الإجراءات الضريبية الموحّد رقم ٢٠٦ لسنة ٢٠٢٠ (المادة ٧١ للغرامات)، ولائحته التنفيذية (قرار ٢٨٦ لسنة ٢٠٢١)، وقانون ضريبة القيمة المضافة ٦٧ لسنة ٢٠١٦، وتديره مصلحة الضرائب المصرية تحت وزارة المالية.' },
  { q: 'هل يجب أن يكون برنامجي متكاملاً أصلاً مع الضرائب؟', a: 'إن كانت منشأتك مشمولة بقرارات المصلحة، فيجب أن يصل برنامجك إليها بطريقة ما. تقول Daftra وEdara (باقة Ultimate) وAccFlex وNamasoft وVoko إنها ترسل إلى المصلحة، وتقول DoubleClick إنها ترسل المستخلصات والفواتير مباشرة، ولدى Odoo وحدة مصرية للفاتورة الإلكترونية. أما صفحات Intuit العالمية فلا تذكر الفاتورة الإلكترونية المصرية لـ QuickBooks، فيحتاج موصّلاً مثل OrchidaTax الذي يسرد QuickBooks ضمن تكاملاته، وصفحات Wafeq المصرية لا تذكر المصلحة، فتأكّد منها. والسؤال الصحيح: «هل تُخلّص الوثائق عبر مصلحة الضرائب مباشرة، أم أي موصّل أحتاج؟»' },
  { q: 'ما السياق الضريبي الأوسع، وزاوية سعر الصرف؟', a: 'السعر العام لضريبة القيمة المضافة ١٤٪. وللمقاولين، تسرد المصلحة القرار الوزاري ٤١٨/٢٠٢٥ بشأن الأساس الضريبي لعقود المقاولات، وتصف تقارير صحفية في أكتوبر ٢٠٢٥ تطبيق ضريبة ١٤٪ على أعمال المقاولات بما فيها العقود القائمة. ويمنح القانون ٦/٢٠٢٥ حوافز وتيسيرات ضريبية للمشروعات التي لا يتجاوز رقم أعمالها السنوي ٢٠ مليون جنيه. وعن العملة: Daftra وEdara وOdoo وPlanRadar تنشر أسعارها بالدولار، فتتغيّر كلفتها بالجنيه مع سعر الصرف، بينما تنشر Wafeq أسعاراً بالجنيه لمصر.' },
];

const pageTitle = 'الفاتورة الإلكترونية (ETA) في مصر: دليل ٢٠٢٦ للمقاولين';
const pageDescription = 'شرح منظومة الفاتورة الإلكترونية المصرية للبناء والمقاولات: الأساس القانوني، ونموذج التخليص اللحظي، ومن يلتزم بموجب قرارات المصلحة المرحلية، وضريبة القيمة المضافة على أعمال المقاولات، وأي الأنظمة تقول إنها ترسل إلى المصلحة (بما فيها المستخلصات). حُدِّث في سبتمبر ٢٠٢٦.';

const enUrl = new URL('/eg/guides/eta-e-invoicing/', Astro.site).toString();
const arUrl = new URL('/eg/ar/guides/eta-e-invoicing/', Astro.site).toString();

const articleSchema = {
  '@context': 'https://schema.org', '@type': 'Article', headline: pageTitle, description: pageDescription,
  datePublished: '2026-06-20', dateModified: '2026-09-30', inLanguage: 'ar',
  author: { '@type': 'Organization', name: 'WrenchStack Research', url: 'https://wrenchstack.com/research/' },
  publisher: { '@type': 'Organization', name: 'WrenchStack', url: 'https://wrenchstack.com' },
  mainEntityOfPage: arUrl,
};
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Layout title={pageTitle} description={pageDescription} lang="ar" dir="rtl" alternateUrls={[{ hreflang: 'en', href: enUrl }, { hreflang: 'ar', href: arUrl }, { hreflang: 'x-default', href: enUrl }]}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <article class="mx-auto max-w-4xl px-4 py-12">
    <header class="mb-8">
      <div class="mb-3 flex items-center justify-between gap-3">
        <p class="text-sm font-semibold uppercase tracking-wider text-orange-600">🇪🇬 مصر · دليل امتثال</p>
        <a href="/eg/guides/eta-e-invoicing/" class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">English</a>
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        الفاتورة الإلكترونية (ETA) في مصر
      </h1>
      <p class="mt-3 text-lg text-slate-600 leading-relaxed">
        ماذا تعني منظومة الفاتورة الإلكترونية الوطنية للبناء والمقاولات: فهي إلزامية على الممولين المشمولين بقرارات المصلحة المرحلية. نموذج التخليص، ومن يلتزم، والعواقب، وأي الأنظمة تقول إنها ترسل إلى المصلحة (بما فيها المستخلصات).
      </p>
      <p class="mt-3 text-sm text-slate-500">إعداد WrenchStack Research · نُشر في يونيو ٢٠٢٦ وحُدِّث في سبتمبر ٢٠٢٦ · ليس استشارة ضريبية. تحقّق من وضعك مع المصلحة (eta.gov.eg) أو محاسبك.</p>
    </header>

    <section class="mb-8 rounded-lg border-2 border-orange-300 bg-orange-50 p-6">
      <h2 class="mb-2 text-lg font-bold text-slate-900">⏰ باختصار</h2>
      <p class="text-slate-800 leading-relaxed">
        منظومة <strong>الفاتورة الإلكترونية</strong> في مصر <strong>إلزامية على مراحل</strong>: تسري على الممولين المشمولين بقرارات المصلحة المرحلية (بدأت المرحلة الخامسة في ١٥ ديسمبر ٢٠٢١، وامتدت المرحلة الثامنة من سبتمبر إلى ديسمبر ٢٠٢٢)، وتبيّن أداة الاستعلام لدى المصلحة ما إذا كانت منشأتك مشمولة. وتعتمد نموذج <strong>تخليص لحظي</strong>: تُعتمَد كل وثيقة قبل إصدارها (JSON/XML، معرّف فريد، توقيع إلكتروني إلزامي). والغرامات بموجب قانون ٢٠٦/٢٠٢٠ تتراوح بين <strong>٢٠ ألف و١٠٠ ألف جنيه</strong>. والمهمة: تحقّق من وضعك، ثم تأكّد أن أداتك تُخلّص إلى المصلحة، مباشرة أو عبر موصّل.
      </p>
    </section>

    <section class="mb-10 grid gap-3 sm:grid-cols-3">
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">على مراحل</div>
        <div class="mt-1 text-xs text-slate-600">إلزام بقرارات المصلحة؛ تحقّق عبر أداة الاستعلام</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">١٤٪</div>
        <div class="mt-1 text-xs text-slate-600">السعر العام لضريبة القيمة المضافة</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">تخليص</div>
        <div class="mt-1 text-xs text-slate-600">اعتماد قبل الإصدار · معرّف + توقيع</div>
      </div>
    </section>

    <section class="mb-10 prose prose-slate max-w-none">
      <h2>الجدول الزمني</h2>
      <ul>
        <li><strong>١٥ نوفمبر ٢٠٢٠</strong>: تجربة (١٣٤ شركة كبرى).</li>
        <li><strong>فبراير-مايو ٢٠٢١</strong>: موجات توسّع لكبار الممولين.</li>
        <li><strong>١ يوليو ٢٠٢١</strong>: إلزامية للبيع للجهات الحكومية (B2G).</li>
        <li><strong>١٥ ديسمبر ٢٠٢١</strong>: بدء المرحلة الخامسة للممولين المشمولين بقرار المصلحة.</li>
        <li><strong>سبتمبر-ديسمبر ٢٠٢٢</strong>: المرحلة الثامنة.</li>
        <li><strong>٢٠٢٢ ← يناير ٢٠٢٥</strong>: انتشار نظام الإيصال الإلكتروني (B2C) على موجات متتالية.</li>
        <li><strong>٢٠٢٥-٢٠٢٦</strong>: تعديلات جديدة على قوانين القيمة المضافة والإجراءات الضريبية (منها القانون ١٤٩/٢٠٢٦)؛ وتسرد المصلحة القرار الوزاري ٤١٨/٢٠٢٥ بشأن الأساس الضريبي لعقود المقاولات؛ وحدّ التسجيل في القيمة المضافة قيد المراجعة منذ أواخر ٢٠٢٥.</li>
      </ul>

      <h2>ما يتطلّبه النظام</h2>
      <ul>
        <li><strong>تخليص، لا إبلاغ.</strong> تُرسَل كل وثيقة وتُعتمَد قبل إصدارها؛ ودون التخليص والمعرّف الفريد لا تكون صحيحة.</li>
        <li><strong>صيغة مهيكلة وتوقيع.</strong> JSON أو XML وفق مخطط المصلحة، بمعرّف فريد وبصمة تشفيرية وتوقيع إلكتروني إلزامي (HSM أو توكن USB).</li>
        <li><strong>ترميز الأصناف.</strong> أكواد GS1 أو الأكواد المصرية EGS؛ وتحمل الإيصالات رمز QR.</li>
        <li><strong>مسار التكامل.</strong> واجهة برمجية + SDK للكبار، أو بوابة/تطبيق مجاني للصغار، إضافة إلى موصّلات (مثل OrchidaTax) للأدوات التي لا تملك وحدة للمصلحة. وتنشر المصلحة قائمة بمقدّمي الخدمة.</li>
        <li><strong>تحقّق من نطاقك.</strong> يشمل الإلزام الممولين المسمّين في قرارات المصلحة المرحلية، وتبيّن أداة الاستعلام ما إذا كانت المنشأة ملزمة بالفاتورة أو الإيصال الإلكتروني.</li>
      </ul>

      <h2>لماذا يهمّ هذا المقاولين تحديداً</h2>
      <p>
        للمقاولين نقاط ضريبية خاصة. تسرد المصلحة <strong>القرار الوزاري ٤١٨/٢٠٢٥</strong> بشأن الأساس الضريبي لعقود المقاولات، وتصف تقارير صحفية في أكتوبر ٢٠٢٥ <strong>تطبيق ضريبة ١٤٪ على أعمال المقاولات</strong> بما فيها العقود القائمة. وبالنسبة إلى <strong>المستخلصات</strong>، تقول <a href="/eg/doubleclick-erp/">DoubleClick</a> إنها ترسل المستخلصات والفواتير مباشرة إلى المصلحة وتطبع رمز QR للفاتورة على المستخلص، وتقول <a href="/eg/voko-erp/">Voko</a> وNamasoft وAccFlex إن وحدات المقاولات لديها تعالج المستخلصات وإنها تدعم الفاتورة الإلكترونية. وانتبه للعملة: Daftra وEdara وOdoo تنشر أسعارها بالدولار، فتتغيّر كلفتها بالجنيه مع سعر الصرف.
      </p>

      <h2>السياق الضريبي الأوسع</h2>
      <ul>
        <li><strong>ضريبة القيمة المضافة:</strong> <strong>١٤٪</strong> (٥٪ مخفّضة أحياناً؛ الصادرات صفرية).</li>
        <li><strong>المشروعات الصغيرة:</strong> يمنح القانون ٦/٢٠٢٥ حوافز وتيسيرات ضريبية للمشروعات التي لا يتجاوز رقم أعمالها السنوي ٢٠ مليون جنيه.</li>
        <li><strong>زاوية الصرف:</strong> الجنيه متقلّب وغير مربوط، فالأدوات المسعّرة بالدولار تحمل مخاطر عملة على منشأة بالجنيه.</li>
      </ul>

      <h2>أي الأنظمة متكاملة مع الضرائب؟</h2>
      <p>
        من البرامج في <a href="/eg/ar/">دليل مصر</a>، إليك علاقتها بالمصلحة. الأدوات التي تملك وحدة للفاتورة الإلكترونية المصرية ترسل مباشرة (ولدى Odoo وحدة عبر توطينه المصري)؛ والأدوات التي لا تملكها، مثل QuickBooks، تحتاج موصّلاً. تحقّق دائماً من الحالة الحالية مع المزوّد.
      </p>
    </section>

    <section class="mb-10 overflow-x-auto">
      <table class="w-full text-sm border border-slate-200 rounded-lg overflow-hidden">
        <thead class="bg-slate-50 text-right text-slate-700">
          <tr>
            <th class="p-3 font-semibold">الأداة</th>
            <th class="p-3 font-semibold">الحالة مع الضرائب</th>
            <th class="p-3 font-semibold">الأنسب لـ</th>
            <th class="p-3 font-semibold">السعر</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 bg-white">
          {tools.map((t) => (
            <tr>
              <td class="p-3 font-semibold text-slate-900"><a href={t.href} class="hover:text-orange-600">{t.name}</a></td>
              <td class="p-3 text-slate-700">{t.status}</td>
              <td class="p-3 text-slate-600">{t.fit}</td>
              <td class="p-3 text-slate-600">{t.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="mt-3 text-xs text-slate-500">تعكس الحالة ما يقوله كل مزوّد، كما فُحص في سبتمبر ٢٠٢٦. تحقّق من التكامل الحالي مع المصلحة مباشرة لدى كل مزوّد.</p>
    </section>

    <section class="mb-10 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-2 text-lg font-bold text-slate-900">السؤال الواحد لأي مزوّد</h2>
      <p class="text-sm text-slate-700 leading-relaxed">
        لا تفترض أن أداة محاسبية جيدة تُخلّص إلى المصلحة. وإن كنت مقاولاً، اسأل عن المستخلصات أيضاً. اسأل: <strong>«هل تُخلّص الوثائق عبر المصلحة مباشرة، وهل تعالج المستخلصات، وهل تُسعّر بالجنيه أم بالدولار؟»</strong> الإجابة المبهمة إشارة. وإن كنت على QuickBooks، فخطّط لموصّل مثل OrchidaTax الذي يسرد QuickBooks ضمن تكاملاته.
      </p>
    </section>

    <section class="mb-10">
      <h2 class="mb-5 text-2xl font-bold text-slate-900">الأسئلة الشائعة</h2>
      <div class="space-y-3">
        {faqs.map((f) => (
          <details class="rounded-lg border border-slate-200 bg-white p-4">
            <summary class="cursor-pointer font-semibold text-slate-900">{f.q}</summary>
            <p class="mt-3 text-slate-700 leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

