---
import Layout from '../../../../../layouts/Layout.astro';

const tools = [
  { name: 'Daftra', status: 'تقول الشركة إنها متكاملة بالكامل مع الضرائب (توقيع، GS1، ضريبة القيمة المضافة المصرية)', fit: 'منشآت محاسبة/فوترة', note: 'من ٢٠$ شهرياً بالدفع السنوي', href: '/eg/daftra/' },
  { name: 'AccFlex', status: 'تقول الشركة إنها معتمدة من الضرائب؛ إصدار مقاولات بالمستخلصات', fit: 'منشآت ومنها المقاولون', note: 'إصدار المنشآت الصغيرة من ما يعادل ٢٩ دولاراً؛ الإصدار الأكبر بعرض سعر', href: '/eg/accflex-erp/' },
  { name: 'DoubleClick ERP', status: 'تقول الشركة إنها ترسل المستخلصات والفواتير مباشرة إلى الضرائب', fit: 'مقاولون (المكتب الفني ← المالية)', note: 'حسب الطلب', href: '/eg/doubleclick-erp/' },
  { name: 'Voko ERP', status: 'وحدة فاتورة إلكترونية منفصلة + مستخلصات في وحدة المقاولات', fit: 'مقاولون', note: 'حسب الطلب', href: '/eg/voko-erp/' },
  { name: 'Namasoft (NamaERP)', status: 'تقول الشركة إنها تغطي الفاتورة الإلكترونية (توقيع HSM وأكواد GS1/EGS) والإيصال الإلكتروني', fit: 'مقاولون وشركات عقارية (عطاءات، مقايسات، مستخلصات، محتجزات)', note: 'حسب الطلب', href: '/eg/namasoft/' },
  { name: 'Edara', status: 'الفاتورة الإلكترونية المصرية في باقة Ultimate؛ وتقول الشركة إنها ترافق العميل حتى تشغيل الربط مع الضرائب', fit: 'منشآت التجارة والتوزيع', note: 'من ٢٩$ شهرياً + ٥$ لكل مستخدم (سنوياً)؛ باقة Ultimate من ٧٩$ + ١٢$ لكل مستخدم', href: '/eg/edara-erp/' },
  { name: 'Odoo', status: 'توطين مصري بوحدة للفاتورة الإلكترونية (API، أكواد GS1/EGS، توقيع بتوكن USB) عبر شركاء', fit: 'نظام موارد كامل', note: 'اشتراك + تطبيق', href: '/eg/odoo/' },
  { name: 'OrchidaTax', status: 'وسيط للضرائب يربط SAP/Oracle/Dynamics/Odoo', fit: 'أبقِ نظامك وأضف الامتثال', note: 'حسب الطلب', href: '/eg/orchidatax/' },
  { name: 'QuickBooks', status: 'لا تذكر Intuit دعم الفاتورة الإلكترونية المصرية؛ تحتاج موصّلاً خارجياً (OrchidaTax يسرد QuickBooks)', fit: 'منشآت تستخدم QuickBooks', note: 'الموصّل بسعر منفصل', href: '/eg/quickbooks/' },
];

const faqs = [
  { q: 'هل الفاتورة الإلكترونية إلزامية الآن، ولمن؟', a: 'نعم، على الممولين المشمولين بقرارات المصلحة المرحلية. جعلت المصلحة الفاتورة الإلكترونية إلزامية على مراحل: تحدد صفحة الاستعلام لديها بداية الالتزام للمرحلة الخامسة من ١٥ ديسمبر ٢٠٢١، والسادسة من ١٥ فبراير ٢٠٢٢، والسابعة من ١٥ يونيو ٢٠٢٢، والثامنة على أربع مراحل فرعية من ١٥ سبتمبر إلى ١٥ ديسمبر ٢٠٢٢. وتبيّن أدوات الاستعلام لديها ما إذا كانت منشأة بعينها ملزمة بالفاتورة أو الإيصال الإلكتروني، فتحقّق من وضعك عبرها. وتدير المصلحة أيضاً منظومة منفصلة للإيصال الإلكتروني. وحدّ التسجيل في ضريبة القيمة المضافة قيد المراجعة منذ أواخر ٢٠٢٥، لذا لا نذكر رقماً هنا.' },
  { q: 'كيف تُوقَّع الوثائق ويُتحقَّق منها؟', a: 'تشترط المصلحة توقيع الفواتير الإلكترونية إلكترونياً وإرسالها عبر الربط مع منظومتها، ببرنامجك الخاص أو عبر أحد مقدّمي الخدمة الذين تسردهم. ويصف المزوّدون في دليلنا التفاصيل: تستخدم Daftra شهادة توقيع من Egypt Trust، ويوقّع Odoo بتوكن USB من المصلحة أو Egypt Trust، وتصف Namasoft التوقيع عبر HSM، ويربط Odoo وVoko وNamasoft الأصناف بأكواد GS1 أو EGS. وتقول DoubleClick إنها تفحص الوثائق قبل الإرسال وتسجّل اعتماد المصلحة بعده. اطلب من المزوّد أن يعرض لك الإرسال كاملاً قبل الشراء.' },
  { q: 'ماذا يحدث إن لم ألتزم؟', a: 'تسرد صفحات المصلحة التي قرأناها لهذا الدليل قرارات الإلزام المرحلية، لكنها لا تذكر مبالغ الغرامات، فتحقّق من الغرامات الحالية لدى المصلحة أو مستشارك الضريبي. وفي الأثناء، تحقّق من وضعك عبر أداة الاستعلام، وتأكّد أن برنامجك يستطيع توقيع الفواتير الإلكترونية وإرسالها عبر الربط مع منظومة المصلحة.' },
  { q: 'ما الصيغة وما الأساس القانوني؟', a: 'تقدّم صفحات الفاتورة الإلكترونية لدى المصلحة إرشادات عن التوقيع الإلكتروني والربط مع المنظومة وترميز الأصناف؛ ويصف المزوّدون في دليلنا أكواد GS1 أو EGS والتوقيع عبر HSM أو توكن USB. وتُفرض ضريبة القيمة المضافة بموجب القانون ٦٧ لسنة ٢٠١٦ المعدّل في ٢٠٢٥ و٢٠٢٦ (ومنه القانون ١٤٩/٢٠٢٦)، وتدير مصلحة الضرائب المصرية منظومتي الفاتورة والإيصال الإلكترونيين.' },
  { q: 'هل يجب أن يكون برنامجي متكاملاً أصلاً مع الضرائب؟', a: 'إن كانت منشأتك مشمولة بقرارات المصلحة، فيجب أن يصل برنامجك إليها بطريقة ما. تقول Daftra وEdara (باقة Ultimate) وAccFlex وNamasoft وVoko إنها ترسل إلى المصلحة، وتقول DoubleClick إنها ترسل المستخلصات والفواتير مباشرة، ولدى Odoo وحدة مصرية للفاتورة الإلكترونية. أما صفحات Intuit العالمية فلا تذكر الفاتورة الإلكترونية المصرية لـ QuickBooks، فيحتاج موصّلاً مثل OrchidaTax الذي يسرد QuickBooks ضمن تكاملاته، وصفحات Wafeq المصرية لا تذكر المصلحة، فتأكّد منها. والسؤال الصحيح: «هل ترسل الوثائق إلى مصلحة الضرائب مباشرة، أم أي موصّل أحتاج؟»' },
  { q: 'ما السياق الضريبي الأوسع، وزاوية سعر الصرف؟', a: 'السعر العام لضريبة القيمة المضافة ١٤٪. وللمقاولين، تسرد المصلحة القرار الوزاري ٤١٨/٢٠٢٥ بشأن الأساس الضريبي لعقود المقاولات، وتصف تقارير صحفية في أكتوبر ٢٠٢٥ تطبيق ضريبة ١٤٪ على أعمال المقاولات بما فيها العقود القائمة. ويمنح القانون ٦/٢٠٢٥ حوافز وتيسيرات ضريبية للمشروعات التي لا يتجاوز رقم أعمالها السنوي ٢٠ مليون جنيه. وعن العملة: Daftra وEdara وOdoo وPlanRadar تنشر أسعارها بالدولار، فتتغيّر كلفتها بالجنيه مع سعر الصرف، بينما تنشر Wafeq أسعاراً بالجنيه لمصر.' },
];

const pageTitle = 'الفاتورة الإلكترونية (ETA) في مصر: دليل ٢٠٢٦ للمقاولين';
const pageDescription = 'شرح منظومة الفاتورة الإلكترونية المصرية للبناء والمقاولات: من يلتزم بموجب قرارات المصلحة المرحلية، وكيف تُوقَّع الفواتير الإلكترونية وتُرسل، وضريبة القيمة المضافة على أعمال المقاولات، وأي الأنظمة تقول إنها ترسل إلى المصلحة (بما فيها المستخلصات). حُدِّث في أكتوبر ٢٠٢٦.';

const enUrl = new URL('/eg/guides/eta-e-invoicing/', Astro.site).toString();
const arUrl = new URL('/eg/ar/guides/eta-e-invoicing/', Astro.site).toString();

const articleSchema = {
  '@context': 'https://schema.org', '@type': 'Article', headline: pageTitle, description: pageDescription,
  datePublished: '2026-06-20', dateModified: '2026-10-01', inLanguage: 'ar',
  author: { '@type': 'Organization', name: 'WrenchStack Research', url: 'https://wrenchstack.com/research/' },
  publisher: { '@type': 'Organization', name: 'WrenchStack', url: 'https://wrenchstack.com' },
  mainEntityOfPage: arUrl,
};
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Layout title={pageTitle} description={pageDescription} lang="ar" dir="rtl" alternateUrls={[{ hreflang: 'en', href: enUrl }, { hreflang: 'ar', href: arUrl }, { hreflang: 'x-default', href: enUrl }]}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <article class="mx-auto max-w-4xl px-4 py-12">
    <header class="mb-8">
      <div class="mb-3 flex items-center justify-between gap-3">
        <p class="text-sm font-semibold uppercase tracking-wider text-orange-600">🇪🇬 مصر · دليل امتثال</p>
        <a href="/eg/guides/eta-e-invoicing/" class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">English</a>
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        الفاتورة الإلكترونية (ETA) في مصر
      </h1>
      <p class="mt-3 text-lg text-slate-600 leading-relaxed">
        ماذا تعني منظومة الفاتورة الإلكترونية الوطنية للبناء والمقاولات: فهي إلزامية على الممولين المشمولين بقرارات المصلحة المرحلية. من يلتزم، وكيف تُوقَّع الفواتير الإلكترونية وتُرسل، وأي الأنظمة تقول إنها ترسل إلى المصلحة (بما فيها المستخلصات).
      </p>
      <p class="mt-3 text-sm text-slate-500">إعداد WrenchStack Research · نُشر في يونيو ٢٠٢٦ وحُدِّث في ١ أكتوبر ٢٠٢٦ · ليس استشارة ضريبية. تحقّق من وضعك مع المصلحة (eta.gov.eg) أو محاسبك.</p>
    </header>

    <section class="mb-8 rounded-lg border-2 border-orange-300 bg-orange-50 p-6">
      <h2 class="mb-2 text-lg font-bold text-slate-900">⏰ باختصار</h2>
      <p class="text-slate-800 leading-relaxed">
        منظومة <strong>الفاتورة الإلكترونية</strong> في مصر <strong>إلزامية على مراحل</strong>: تسري على الممولين المشمولين بقرارات المصلحة المرحلية (تحدد صفحة الاستعلام لدى المصلحة بداية الالتزام للمرحلة الخامسة من ١٥ ديسمبر ٢٠٢١، وللمرحلة الثامنة على أربع مراحل فرعية من ١٥ سبتمبر إلى ١٥ ديسمبر ٢٠٢٢)، وتبيّن أداة الاستعلام لدى المصلحة ما إذا كانت منشأتك مشمولة. وتشترط المصلحة <strong>توقيع الفواتير الإلكترونية إلكترونياً</strong> وإرسالها عبر الربط مع منظومتها، ببرنامجك الخاص أو عبر أحد مقدّمي الخدمة الذين تسردهم. والمهمة: تحقّق من وضعك، ثم تأكّد أن أداتك توقّع الفواتير وترسلها إلى المصلحة، مباشرة أو عبر موصّل.
      </p>
    </section>

    <section class="mb-10 grid gap-3 sm:grid-cols-3">
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">على مراحل</div>
        <div class="mt-1 text-xs text-slate-600">إلزام بقرارات المصلحة؛ تحقّق عبر أداة الاستعلام</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">١٤٪</div>
        <div class="mt-1 text-xs text-slate-600">السعر العام لضريبة القيمة المضافة</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">توقيع إلكتروني</div>
        <div class="mt-1 text-xs text-slate-600">تُوقَّع الفواتير وتُرسل عبر الربط مع منظومة المصلحة</div>
      </div>
    </section>

    <section class="mb-10 prose prose-slate max-w-none">
      <h2>الجدول الزمني</h2>
      <ul>
        <li><strong>١٥ ديسمبر ٢٠٢١</strong>: بداية الالتزام للمرحلة الخامسة، للممولين المشمولين بقرار المصلحة.</li>
        <li><strong>١٥ فبراير ٢٠٢٢</strong>: بداية المرحلة السادسة.</li>
        <li><strong>١٥ يونيو ٢٠٢٢</strong>: بداية المرحلة السابعة.</li>
        <li><strong>١٥ سبتمبر - ١٥ ديسمبر ٢٠٢٢</strong>: المرحلة الثامنة، على أربع مراحل فرعية تبدأ في الخامس عشر من كل شهر.</li>
        <li><strong>٢٠٢٥-٢٠٢٦</strong>: تعديلات جديدة على قوانين القيمة المضافة والإجراءات الضريبية (منها القانون ١٤٩/٢٠٢٦)؛ وتسرد المصلحة القرار الوزاري ٤١٨/٢٠٢٥ بشأن الأساس الضريبي لعقود المقاولات؛ وحدّ التسجيل في القيمة المضافة قيد المراجعة منذ أواخر ٢٠٢٥.</li>
      </ul>

      <h2>ما يتطلّبه النظام</h2>
      <ul>
        <li><strong>التوقيع الإلكتروني.</strong> تشترط المصلحة توقيع الفواتير الإلكترونية إلكترونياً؛ ويصف المزوّدون في دليلنا شهادة من Egypt Trust (Daftra)، أو توكن USB من المصلحة أو Egypt Trust (Odoo)، أو التوقيع عبر HSM (Namasoft).</li>
        <li><strong>ترميز الأصناف.</strong> يصف Odoo وVoko وNamasoft ربط الأصناف بأكواد GS1 أو EGS، وتقدّم صفحات الفاتورة الإلكترونية لدى المصلحة إرشادات عن ترميز الأصناف.</li>
        <li><strong>مسار التكامل.</strong> الربط مع منظومة المصلحة ببرنامجك الخاص أو عبر أحد مقدّمي الخدمة الذين تسردهم المصلحة، أو عبر موصّل (مثل OrchidaTax) للأدوات التي لا تملك وحدة للمصلحة.</li>
        <li><strong>تحقّق من نطاقك.</strong> يشمل الإلزام الممولين المسمّين في قرارات المصلحة المرحلية، وتبيّن أداة الاستعلام ما إذا كانت المنشأة ملزمة بالفاتورة أو الإيصال الإلكتروني.</li>
      </ul>

      <h2>لماذا يهمّ هذا المقاولين تحديداً</h2>
      <p>
        للمقاولين نقاط ضريبية خاصة. تسرد المصلحة <strong>القرار الوزاري ٤١٨/٢٠٢٥</strong> بشأن الأساس الضريبي لعقود المقاولات، وتصف تقارير صحفية في أكتوبر ٢٠٢٥ <strong>تطبيق ضريبة ١٤٪ على أعمال المقاولات</strong> بما فيها العقود القائمة. وبالنسبة إلى <strong>المستخلصات</strong>، تقول <a href="/eg/doubleclick-erp/">DoubleClick</a> إنها ترسل المستخلصات والفواتير مباشرة إلى المصلحة وتطبع رمز QR للفاتورة على المستخلص، وتقول <a href="/eg/voko-erp/">Voko</a> وNamasoft وAccFlex إن وحدات المقاولات لديها تعالج المستخلصات وإنها تدعم الفاتورة الإلكترونية. وانتبه للعملة: Daftra وEdara وOdoo تنشر أسعارها بالدولار، فتتغيّر كلفتها بالجنيه مع سعر الصرف.
      </p>

      <h2>السياق الضريبي الأوسع</h2>
      <ul>
        <li><strong>ضريبة القيمة المضافة:</strong> السعر العام <strong>١٤٪</strong>، بحسب تقارير صحفية عن تعديلات ٢٠٢٥ و٢٠٢٦.</li>
        <li><strong>المشروعات الصغيرة:</strong> يمنح القانون ٦/٢٠٢٥ حوافز وتيسيرات ضريبية للمشروعات التي لا يتجاوز رقم أعمالها السنوي ٢٠ مليون جنيه.</li>
        <li><strong>زاوية الصرف:</strong> تتغيّر كلفة الأدوات المسعّرة بالدولار على المنشأة التي تعمل بالجنيه مع تغيّر سعر الصرف.</li>
      </ul>

      <h2>أي الأنظمة متكاملة مع الضرائب؟</h2>
      <p>
        من البرامج في <a href="/eg/ar/">دليل مصر</a>، إليك علاقتها بالمصلحة. الأدوات التي تملك وحدة للفاتورة الإلكترونية المصرية ترسل مباشرة (ولدى Odoo وحدة عبر توطينه المصري)؛ والأدوات التي لا تملكها، مثل QuickBooks، تحتاج موصّلاً. تحقّق دائماً من الحالة الحالية مع المزوّد.
      </p>
    </section>

    <section class="mb-10 overflow-x-auto">
      <table class="w-full text-sm border border-slate-200 rounded-lg overflow-hidden">
        <thead class="bg-slate-50 text-right text-slate-700">
          <tr>
            <th class="p-3 font-semibold">الأداة</th>
            <th class="p-3 font-semibold">الحالة مع الضرائب</th>
            <th class="p-3 font-semibold">يناسب</th>
            <th class="p-3 font-semibold">السعر</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 bg-white">
          {tools.map((t) => (
            <tr>
              <td class="p-3 font-semibold text-slate-900"><a href={t.href} class="hover:text-orange-600">{t.name}</a></td>
              <td class="p-3 text-slate-700">{t.status}</td>
              <td class="p-3 text-slate-600">{t.fit}</td>
              <td class="p-3 text-slate-600">{t.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="mt-3 text-xs text-slate-500">تعكس الحالة ما يقوله كل مزوّد، كما فُحص في سبتمبر ٢٠٢٦. تحقّق من التكامل الحالي مع المصلحة مباشرة لدى كل مزوّد.</p>
    </section>

    <section class="mb-10 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-2 text-lg font-bold text-slate-900">السؤال الواحد لأي مزوّد</h2>
      <p class="text-sm text-slate-700 leading-relaxed">
