const cats = [
  { key: 'software', label: 'برامج المحاسبة والفوترة والإنشاءات', desc: 'أنظمة محاسبة وERP تقول إنها تدعم الفاتورة الإلكترونية لمصلحة الضرائب (Daftra وEdara ERP وAccFlex ERP وOdoo)، وأنظمة مقاولات مصرية تقول شركاتها إنها تعالج المستخلصات والإرسال إلى المصلحة (DoubleClick ERP وVoko ERP وNamasoft)، وأدوات مشاريع دولية بلا دور ضريبي (Oracle Primavera P6 وRIB Candy وAutodesk Forma وPlanRadar)، وطبقة الربط OrchidaTax التي تصل الأنظمة القائمة بالمصلحة، وأداتا محاسبة لا تذكر صفحاتهما المصرية الفاتورة الإلكترونية المصرية (Wafeq وQuickBooks).' },
  { key: 'lead-gen', label: 'المناقصات والفرص والخدمات', desc: 'بوابة التعاقدات الحكومية الإلكترونية (etenders.gov.eg)، وخدمة تنبيهات المناقصات المدفوعة EgyptTenders، وقاعدة بيانات المشاريع الإقليمية BNC Network (صفحاتها المقروءة لا تذكر مصر)، ودليل الموردين المجاني MadeInEgypt (عليه تحذير سمعة: إخلاء المسؤولية فيه يقول إنه لا يتحقّق من كل إدراج)، وتطبيق الخدمات المنزلية FilKhedma (القاهرة والإسكندرية والساحل الشمالي).' },
  { key: 'insurance', label: 'تأمين الإنشاءات: كل أخطار المقاولين', desc: 'التأمين الهندسي لدى شركات تأمين مصرية: Misr Insurance المملوكة للدولة، وAllianz Egypt، وGIG Egypt، وSuez Canal Insurance، وMohandes Insurance المدرجة في البورصة المصرية. تسرد كلٌّ منها تأمين كل أخطار المقاولين والتركيب، ولا تنشر أيّ منها أسعاراً، والتأمين العشري مذكور لدى Mohandes Insurance وحدها، فاسأل الباقين إن كان عقدك يتطلّبه.' },
  { key: 'payroll', label: 'الرواتب: التأمينات وضريبة الدخل', desc: 'ZenHR التي تقول إن رواتبها المصرية تعالج ضريبة الدخل والتأمينات الاجتماعية وضريبة الشهداء (دون مكتب في مصر)، وMenaitech (MenaPAY) بمكتب في القاهرة الجديدة وباقة رواتب مجانية حتى ٣٠ موظفاً، وPaySpace التي تُباع الآن باسم Deel Local Payroll ومصر ضمن قائمة دولها الـ ٤٩، وEgyBell المصرية التي تدير الرواتب كخدمة تعهيد. ويدفع صاحب العمل اشتراكات التأمينات الاجتماعية عن كل عامل مؤمَّن عليه بموجب القانون ١٤٨ لسنة ٢٠١٩.' },
  { key: 'certification', label: 'الامتثال والجهات الرسمية', desc: 'الجهات الرسمية التي يتعامل معها المقاول: تأسيس الشركة عبر الهيئة العامة للاستثمار، والتسجيل الضريبي والقيمة المضافة والفاتورة الإلكترونية لدى مصلحة الضرائب، وعضوية الاتحاد المصري لمقاولي التشييد والبناء (شرط بالقانون ١٠٤ لسنة ١٩٩٢ لأعمال المقاولات فوق ٥٠ ألف جنيه للعملية)، ونقابة المهندسين (لا تُسند الأعمال الهندسية إلا لمهندسين مسجّلين)، والتأمينات الاجتماعية، وتراخيص البناء في المدن الجديدة من هيئة المجتمعات العمرانية الجديدة.' },
];

const enUrl = new URL('/eg/', Astro.site).toString();
const arUrl = new URL('/eg/ar/', Astro.site).toString();
const pageTitle = 'دليل برامج المقاولات والإنشاءات في مصر: الفاتورة الإلكترونية';
const pageDescription = 'دليل مستقل لبرامج المقاولات والإنشاءات في مصر: أنظمة محاسبة وإنشاءات (منها ما يقول إنه يدعم الفاتورة الإلكترونية والمستخلصات)، ومصادر المناقصات، والرواتب، وتأمين كل أخطار المقاولين، مع سياق الامتثال المحلي (الفاتورة الإلكترونية، عضوية الاتحاد، نقابة المهندسين).';
---

<Layout
  title={pageTitle}
  description={pageDescription}
  lang="ar"
  dir="rtl"
  alternateUrls={[{ hreflang: 'en', href: enUrl }, { hreflang: 'ar', href: arUrl }, { hreflang: 'x-default', href: enUrl }]}
>
  <article class="mx-auto max-w-5xl px-4 py-12">

    <div class="mb-6 flex items-center justify-between gap-3">
      <div class="flex items-center gap-2">
        <span class="text-2xl" aria-hidden="true">🇪🇬</span>
        <p class="text-sm font-semibold uppercase tracking-wider text-orange-600">جمهورية مصر العربية</p>
      </div>
      <a href="/eg/" class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">English</a>
    </div>

    <header class="mb-10">
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">دليل برامج المقاولات والإنشاءات في مصر</h1>
      <p class="mt-4 text-lg text-slate-600 leading-relaxed">
        مراجعات مستقلة لـ {vendors.length} منتجاً وجهة رسمية ذات صلة بالسوق المصري، محورها منظومة الفاتورة الإلكترونية لمصلحة الضرائب (ETA) التي أصبحت إلزامية على مراحل. أنظمة مقاولات تقول شركاتها إنها تعالج المستخلصات والإرسال إلى المصلحة (DoubleClick ERP وVoko ERP وNamasoft وAccFlex ERP)، ومحاسبة سحابية مثل Daftra (مسعّرة بالدولار)، وأدوات مشاريع دولية (Oracle Primavera P6 وRIB Candy وAutodesk Forma وPlanRadar)، والرواتب، وتأمين كل أخطار المقاولين، مع السياق المحلي: ضريبة القيمة المضافة ١٤٪، وعضوية الاتحاد لأعمال المقاولات فوق ٥٠ ألف جنيه للعملية، وبرامج مسعّرة بالدولار تتغيّر كلفتها بالجنيه مع سعر الصرف.
      </p>
    </header>

    <section class="mb-10 flex flex-wrap items-center justify-between gap-4 rounded-lg border-2 border-emerald-300 bg-emerald-50 p-5">
      <div>
        <p class="text-xs font-bold tracking-wider text-emerald-700">⏰ دليل امتثال · الفاتورة الإلكترونية إلزامية على الممولين المشمولين بقرارات المصلحة المرحلية</p>
        <h2 class="mt-1 text-base font-bold text-slate-900">الفاتورة الإلكترونية (ETA) لشركات المقاولات المصرية</h2>
        <p class="mt-1 text-sm text-slate-700">كيف تُوقَّع الفواتير الإلكترونية وتُرسل إلى المصلحة، ومن يلتزم وكيف تتحقّق، وضريبة القيمة المضافة على أعمال المقاولات، وأي الأنظمة في هذا الدليل تقول إنها ترسل إلى المصلحة، بما فيها المستخلصات.</p>
      </div>
      <a href="/eg/ar/guides/eta-e-invoicing/" class="shrink-0 rounded-md bg-emerald-700 px-5 py-3 text-sm font-semibold text-white hover:bg-emerald-800">اقرأ الدليل ←</a>
    </section>

    <section class="mb-10 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-3 text-base font-bold text-slate-900">ما الذي يميّز اختيار البرامج في مصر</h2>
      <p class="text-sm text-slate-700 leading-relaxed">
        يؤثّر في اختيار البرامج في مصر عامل رئيسي: <strong>الفاتورة الإلكترونية لمصلحة الضرائب.</strong> جعلت المصلحة الفاتورة الإلكترونية إلزامية على مراحل بقرارات (تحدد صفحة الاستعلام لديها بداية الالتزام للمرحلة الخامسة من ١٥ ديسمبر ٢٠٢١، وللمرحلة الثامنة على أربع مراحل فرعية من ١٥ سبتمبر إلى ١٥ ديسمبر ٢٠٢٢)، وتبيّن أداة الاستعلام لديها ما إذا كانت المنشأة مشمولة. ويجب توقيع الفاتورة إلكترونياً وإرسالها عبر الربط مع منظومة المصلحة، ببرنامجك الخاص أو عبر أحد مقدّمي الخدمة الذين تسردهم المصلحة؛ وتدير المصلحة أيضاً منظومة الإيصال الإلكتروني. وتصف الشركات هنا مسارات مختلفة: تقول Daftra وEdara ERP (باقة Ultimate) وAccFlex ERP وNamasoft وVoko ERP وOdoo إنها تدعم الفاتورة الإلكترونية؛ وتقول DoubleClick ERP إنها ترسل <strong>المستخلصات</strong> والفواتير مباشرة إلى المصلحة؛ وتربط OrchidaTax الأنظمة القائمة مثل SAP وOracle وMicrosoft Dynamics بالمصلحة؛ ولا تذكر صفحات Wafeq وQuickBooks الموجّهة لمصر الفاتورة الإلكترونية المصرية. والعملة مهمة أيضاً: Daftra وEdara ERP وOdoo وPlanRadar تنشر أسعارها بالدولار، فتتغيّر كلفتها بالجنيه مع سعر الصرف، بينما تنشر Wafeq أسعاراً بالجنيه. أضف أن السعر العام لضريبة القيمة المضافة <strong>١٤٪</strong>، وتصف تقارير صحفية في أكتوبر ٢٠٢٥ تطبيقه على أعمال المقاولات؛ وأن أعمال المقاولات فوق <strong>٥٠ ألف جنيه</strong> للعملية تتطلّب <strong>عضوية الاتحاد</strong> بموجب القانون ١٠٤ لسنة ١٩٩٢.
      </p>
    </section>

    {cats.map((cat) => {
      const cv = vendors.filter((v) => v.category === cat.key);
      if (cv.length === 0) return null;
      return (
        <section class="mb-12">
          <div class="mb-5">
            <h2 class="text-2xl font-bold text-slate-900">{cat.label}</h2>
            <p class="mt-1 text-sm text-slate-600 leading-relaxed">{cat.desc}</p>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            {cv.map((v) => {
              const isCert = v.category === 'certification';
              const tierColor = v.tier === 'S' ? 'border-emerald-300' : v.tier === 'F' ? 'border-rose-300' : 'border-blue-300';
              const tierBadge = v.tier === 'S' ? 'bg-emerald-100 text-emerald-900' : v.tier === 'F' ? 'bg-rose-100 text-rose-900' : 'bg-blue-100 text-blue-900';
              const label = isCert ? 'جهة رسمية' : tierAr[v.tier];
              return (
                <article class={`rounded-lg border-2 ${tierColor} bg-white p-4`}>
                  <div class="mb-1 flex items-center gap-2 flex-wrap">
                    <h3 class="text-lg font-bold text-slate-900">{v.name}</h3>
                    <span class={`rounded-full px-2 py-0.5 text-xs font-bold ${tierBadge}`}>{label}</span>
                  </div>
                  <p class="text-sm text-slate-700 leading-relaxed">{ar[v.slug] ?? v.tagline}</p>
                  <div class="mt-3 flex flex-wrap gap-2">
                    <a href={`/eg/${v.slug}/`} class="rounded-md bg-slate-900 px-3 py-1.5 text-xs font-semibold text-white hover:bg-slate-700">التفاصيل (بالإنجليزية) ←</a>
                    <a href={v.vendor_url} rel="sponsored nofollow noopener" target="_blank" class="rounded-md bg-orange-500 px-3 py-1.5 text-xs font-semibold text-white hover:bg-orange-600">{isCert ? 'الموقع الرسمي' : 'زيارة الموقع'} ←</a>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      );
    })}

    <section class="mb-10 rounded-lg border border-slate-200 bg-white p-5 text-sm text-slate-600">
      <p>المراجعات التفصيلية لكل منتج متاحة <a href="/eg/" class="font-medium text-orange-600 hover:underline">بالإنجليزية</a>.</p>
    </section>

    <section class="rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">هل أنت مزوّد برامج مصري؟</h2>
      <p class="mt-2 text-slate-300 leading-relaxed">إذا كنت تطوّر برامج للمقاولات أو المحاسبة أو الفاتورة الإلكترونية أو الرواتب للسوق المصري وترغب في المراجعة أو الإدراج، تواصل معنا عبر <a href="/for-vendors/" class="underline">برنامج المزوّدين</a>.</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/for-vendors/" class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600">العمل معنا ←</a>
        <a href="/eg/" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">English directory</a>
      </div>
    </section>
  </article>
</Layout>
