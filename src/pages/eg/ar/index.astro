  slug: string; name: string; category: string; vendor_url: string;
  tagline: string; tier: 'S' | 'A' | 'F';
  is_cross_market: boolean;
}
const vendors = (egData as { vendors: EgVendor[] }).vendors;

// Concise Arabic positioning per vendor (the detailed reviews remain in English for now).
const ar: Record<string, string> = {
  'daftra': 'نظام محاسبة وإدارة أعمال سحابي تشغّله Izam, Inc.، وتقول إن لها مقرّين في الولايات المتحدة ومصر. تقول Daftra إنها متكاملة بالكامل مع منظومة الفاتورة الإلكترونية لمصلحة الضرائب دون رسوم إضافية. أسعار منشورة بالدولار (Basic من ٢٠$ شهرياً بالدفع السنوي)، فتتغيّر الكلفة بالجنيه مع سعر الصرف.',
  'edara-erp': 'نظام ERP سحابي من Edrak Software في مدينة نصر بالقاهرة، تقول إنها أطلقته عام ٢٠٠٦ وتوجّهه لشركات التجارة والتوزيع الصغيرة والمتوسطة في مصر والسعودية. أسعار منشورة بالدولار (رسم أساسي شهري + رسم لكل مستخدم)، والفاتورة الإلكترونية المصرية مدرجة في باقة Ultimate فقط.',
  'accflex-erp': 'برامج ERP ومحاسبة لشركات في مصر والسعودية بإصدارات قطاعية، منها إصدار للمقاولات يغطي العقود والمستخلصات وتوزيع التكاليف بحسب الشركة. تقول AccFlex إن برامجها معتمدة من مصلحة الضرائب وتدعم الفاتورة الإلكترونية (لم يُتحقَّق من ذلك في قائمة رسمية). يبدأ إصدار الشركات الناشئة والصغيرة (حتى ١٠ مستخدمين) من ما يعادل ٢٩ دولاراً، وإصدار الشركات المتوسطة والكبيرة بعرض سعر.',
  'wafeq': 'محاسبة سحابية من Wafeq FZ-LLC الإماراتية، بموقع مصري بالعربية والإنجليزية وأسعار منشورة بالجنيه. صفحاتها المصرية لا تذكر الفاتورة الإلكترونية لمصلحة الضرائب المصرية (الفوترة الإلكترونية الموثّقة لديها هي لهيئة الزكاة السعودية ZATCA)، فتأكّد من الدعم قبل الشراء.',
  'doubleclick-erp': 'نظام ERP للمقاولات من Click Enterprise (مكاتب في مصر والسعودية بحسب الشركة) يربط المكتب الفني بالمالية. تقول الشركة إن برنامجها يرسل المستخلصات والفواتير مباشرة إلى مصلحة الضرائب ويطبع رمز QR للفاتورة على المستخلص. الأسعار حسب الطلب.',
  'voko-erp': 'نظام ERP من Business Force في مدينة نصر بالقاهرة (تأسست ٢٠٠٧ بحسب الشركة)، بوحدة مقاولات تشمل العقود والمقايسات والعطاءات والمستخلصات، ووحدة منفصلة للفاتورة الإلكترونية مع التوقيع الإلكتروني وأكواد GS1/EGS. الأسعار حسب الطلب.',
  'namasoft': 'Nama ERP من Namasoft (تأسست ٢٠١١، ومقرها المهندسين بالجيزة)، وتقول إن لديها أكثر من ٧٠٠ عميل في ١٠ دول. يضم وحدة للعقارات والمقاولات (عطاءات، مقايسات، مستخلصات، محتجزات، مقاولو باطن)، ويغطي الفاتورة والإيصال الإلكترونيين بحسب الشركة. الأسعار حسب الطلب.',
  'oracle-primavera-p6': 'نظام Oracle لتخطيط وإدارة المشاريع والبرامج والمحافظ، وتوجّهه Oracle للقطاعات كثيفة الأصول. يعمل محلياً أو على سحابة Oracle، وهو أداة تخطيط ومراقبة لا نظام محاسبة، فلا دور له في الفاتورة الإلكترونية. السعر عبر Oracle أو شركائها.',
  'rib-candy': 'برنامج حصر وتسعير وتخطيط ومراقبة للمقاولين من RIB Software (جزء من Schneider Electric بحسب الشركة). تنشر RIB دراسة حالة لشركة Hassan Allam Construction في مصر، ومكتبها الإقليمي في دبي. تجربة مجانية ١٤ يوماً، والسعر حسب الطلب.',
  'autodesk-construction-cloud': 'سحابة الإنشاءات من Autodesk، وأصبحت جزءاً من Autodesk Forma في ٢٤ مارس ٢٠٢٦ (Autodesk Build صار Forma Build). تُباع في ثلاث باقات: إدارة النماذج، وما قبل الإنشاء (حصر وتسعير وإدارة عطاءات)، وعمليات الإنشاء. لا دور لها في الفاتورة الإلكترونية، والسعر حسب الطلب عبر موزّع معتمد من Autodesk.',
  'planradar': 'منصة من فيينا (تأسست ٢٠١٣) لمهام المواقع على المخططات الرقمية وقوائم الفحص والتقارير. أسعار منشورة بالدولار لكل مستخدم شهرياً (Basic ٣٢$، Starter ١٠٧$، Pro ١٥٩$) وتجربة مجانية ٣٠ يوماً. مكتبها الإقليمي في دبي، ولا مكتب مصرياً في صفحة التواصل.',
  'odoo': 'نظام ERP معياري مفتوح المصدر، بتوطين مصري يتضمّن وحدة للفاتورة الإلكترونية منذ Odoo 15.0 (ربط API، أكواد GS1/EGS، توقيع بتوكن USB). أسعار منشورة بالدولار وباقة مجانية لتطبيق واحد، ويسرد دليل Odoo ٢٠٤ شركاء تطبيق في مصر.',
  'orchidatax': 'طبقة ربط للفاتورة الإلكترونية تصل أنظمة ERP والمحاسبة ونقاط البيع القائمة (مثل SAP وOracle وMicrosoft Dynamics وOdoo وQuickBooks) بمنظومة مصلحة الضرائب المصرية، مع مكتب في القاهرة (النزهة الجديدة). ليست نظام محاسبة، والأسعار حسب الطلب.',
  'quickbooks': 'محاسبة Intuit السحابية، تُباع في مصر بنسخة QuickBooks Global. صفحات Intuit العالمية لا تذكر منظومة الفاتورة أو الإيصال الإلكتروني المصرية، فتحتاج موصّلاً خارجياً مثل OrchidaTax. الأسعار تظهر حسب موقع الزائر، مع تجربة مجانية ٣٠ يوماً.',
  'egypt-etenders-gov': 'بوابة التعاقدات الحكومية الإلكترونية في مصر، وتصف نفسها بأنها تديرها هيئة الخدمات الحكومية التابعة لوزارة المالية. تنشر فيها جهات التعاقد المناقصات والمزايدات والترسيات، ويقدّم الموردون المعتمدون عروضهم الفنية والمالية إلكترونياً. الرسوم غير مؤكدة.',
  'egypttenders-com': 'خدمة مدفوعة لمعلومات المناقصات المصرية، تقول إنها جزء من Global Tenders Services Pvt. Ltd.، مع تنبيهات بريدية يومية وبيانات الترسية من باقة Premium. أسعار منشورة: ٢٩٥-٤٩٥ دولاراً لمدة ١٢ شهراً. المناقصات الرسمية منشورة أيضاً على البوابة الحكومية.',
  'bnc-network': 'قاعدة بيانات لمعلومات مشاريع الإنشاءات تقول إنها تعمل منذ ٢٠٠٤ وتغطي ٧٢ دولة في الشرق الأوسط وأفريقيا وجنوب آسيا، ومقرها الشارقة. الصفحات المقروءة في هذا الفحص لا تذكر مصر تحديداً، فاطلب عيّنة من المشاريع المصرية قبل الاشتراك. لا أسعار منشورة.',
  'madeinegypt-com': 'دليل مجاني للموردين والعلامات المصرية، يضم قسم الإنشاءات فيه ٢١ شركة (أسمنت، حديد، زجاج، جبس، بلاط، رخام). تحذير: يصف الموقع إدراجاته بأنها «Verified»، لكن إخلاء المسؤولية فيه يقول إنه لا يتحقّق من كل إدراج، ولا يذكر اسم الشركة المشغّلة.',
  'filkhedma': 'تطبيق خدمات منزلية في مصر (تكييف، سباكة، كهرباء، نجارة، ألومنيوم، سخانات غاز، تنظيف)، ويقول موقعه إنه «A Shift South Company»، وقد اشترته SweepSouth الجنوب أفريقية في ديسمبر ٢٠٢١ بحسب تقارير إخبارية. المناطق المفعّلة: القاهرة والإسكندرية والساحل الشمالي، ولا شروط منشورة لأجور الفنيين.',
  'misr-insurance-egypt': 'شركة تأمين مصرية مملوكة للدولة أسسها طلعت حرب عام ١٩٣٤، وتعود ملكيتها إلى صندوق مصر السيادي عبر مصر القابضة للتأمين بحسب الشركة. خاضعة لرقابة الهيئة العامة للرقابة المالية (ترخيص رقم ١)، وخطها الهندسي يشمل كل أخطار المقاولين والتركيب ومعدات المقاولين. لا أسعار منشورة.',
  'allianz-egypt': 'الذراع غير الحياتية لمجموعة Allianz في مصر: تقول إنها بدأت عام ١٩٧٦ مساهمةً في Arab International Insurance Company، وتعمل باسم Allianz منذ ٢٠٠٤، ومرخّصة من الهيئة العامة للرقابة المالية (رقم ٢٠٠١/١٣). تسرد صفحتها الهندسية خمس تغطيات منها كل أخطار المقاولين والتركيب، مع استشارات لإدارة المخاطر. لا أسعار منشورة.',
  'gig-egypt': 'تقول GIG Egypt إنها بدأت التأمين في يوليو ١٩٩٤ وإن Gulf Insurance Group تملك ٩٩٪ منها. مرخّصة من الهيئة العامة للرقابة المالية (رقم ٩ لسنة ١٩٩٤)، وتسرد كل أخطار المقاولين والتركيب ومعدات المقاولين، مع المسؤولية المهنية للمعماريين والمهندسين والمسؤولية العامة، ونموذج طلب تسعير هندسي عبر الإنترنت. لا تأمين عشري في صفحات منتجاتها.',
  'suez-canal-insurance-egypt': 'تقول الشركة إنها تأسست في أكتوبر ١٩٧٩ كأول شركة تأمين من القطاع الخاص في مصر، تحت مظلة المقاولون العرب وهيئة قناة السويس، وإن لها ٢٩ فرعاً. مرخّصة من الهيئة العامة للرقابة المالية (رقم ٥ لسنة ١٩٧٩)، وخطها الهندسي يشمل كل أخطار المقاولين والتركيب والأعمال المدنية، مع نموذج استفسار إلكتروني لكل منتج. لا أسعار منشورة.',
  'mohandes-insurance-egypt': 'شركة تأمين مصرية مساهمة مرخّصة عام ١٩٨٠ (ترخيص رقم ٦) ومدرجة في البورصة المصرية (MOIN)، وأكبر مساهميها صندوق معاشات نقابة المهندسين (٣٣٫٢٪). خطها الهندسي يشمل كل أخطار المقاولين والتركيب ومعدات المقاولين، مع المسؤولية المهنية للمهندسين والمسؤولية العشرية. لا أسعار منشورة، وتستقبل طلبات التسعير عبر موقعها.',
  'zenhr': 'منصة موارد بشرية ورواتب سحابية تقول إنها موطّنة لـ ١١ دولة في المنطقة منها مصر. تقول صفحتها المصرية إنها تؤتمت الرواتب وضريبة الدخل واشتراكات التأمينات الاجتماعية واستماراتها وضريبة الشهداء ومكافأة نهاية الخدمة، وتدفع الرواتب بالجنيه أو الدولار. لا مكتب مصرياً في موقعها، ولا أسعار منشورة.',
  'menaitech': 'تبيع Menaitech أنظمة موارد بشرية ورواتب في المنطقة (MenaPAY للرواتب وMenaSME للمنشآت الصغيرة والمتوسطة)، ولها مكتب في القاهرة الجديدة (التجمع الخامس). باقة Freemium مجانية للرواتب حتى ٣٠ موظفاً؛ وصفحاتها المصرية لا تفصّل ضريبة الدخل أو صندوق الشهداء، فتأكّد من الإعداد المصري في العرض التجريبي.',
  'payspace': 'PaySpace، التي تأسست في جنوب أفريقيا عام ٢٠٠١ واشترتها Deel في ٢٠٢٤، تُباع الآن باسم Deel Local Payroll. قائمة دولها (٤٩ دولة) تشمل مصر مع ضريبة الموظفين والتأمينات الاجتماعية والتأمين الصحي الشامل وصندوق الشهداء. لا مكتب مصرياً ولا واجهة عربية مذكورة في موقعها، والسعر لكل موظف شهرياً حسب الطلب.',
  'egybell': 'شركة تعهيد مصرية تقول إنها تقدّم تعهيد الموارد البشرية منذ ٢٠١٥، ثم أضافت المحاسبة والضرائب والمشتريات والخدمات القانونية وتقنية المعلومات. تدير الرواتب الشهرية كخدمة، وتتولّى في خدمة منفصلة ملفات التأمينات الاجتماعية وأوراق مكتب العمل. الأسعار بعد استشارة، ولا عنوان منشور في موقعها.',
  'egyptian-federation-construction-building-contractors': 'أُنشئ بالقانون ١٠٤ لسنة ١٩٩٢، وكل من يعمل في المقاولات عضو عامل فيه. لا يجوز إسناد أو تنفيذ أعمال مقاولات تزيد قيمتها على ٥٠ ألف جنيه للعملية الواحدة لغير الأعضاء، ويصنّف الاتحاد أعضاءه حسب التخصص والقدرة. الرسوم الحالية غير منشورة بصيغة مقروءة في موقعه.',
  'egyptian-engineers-syndicate': 'أُنشئت بالقانون ٦٦ لسنة ١٩٧٤، ومقرها القاهرة ولها فروع في المحافظات. بموجب المادة ٧ لا تُسند الوظائف والأعمال الهندسية إلا لمهندسين أو مكاتب استشارية مسجّلة فيها، ويحتاج المهندسون الأجانب إلى تصريح مزاولة خاص تطلبه الجهة المتعاقدة معهم.',
  'gafi-commercial-registry-tax-card': 'الهيئة العامة للاستثمار والمناطق الحرة تدير مراكز خدمات المستثمرين (١٥ مركزاً تضم ٦٧ جهة حكومية بحسب الهيئة) التي تُؤسَّس فيها الشركات، ويمكن منذ سبتمبر ٢٠٢٣ تأسيس المنشأة الفردية وشركات الأشخاص وذات المسؤولية المحدودة إلكترونياً. التأسيس خطوة أولى يليها التسجيل الضريبي والتراخيص والعضويات.',
  'egyptian-tax-authority-eta': 'مصلحة الضرائب المصرية تدير ضريبة الدخل والقيمة المضافة (السعر العام ١٤٪) ومنظومتي الفاتورة والإيصال الإلكترونيين. أصبحت الفاتورة الإلكترونية إلزامية على مراحل بقرارات من المصلحة، وتتيح أداة استعلام إلكترونية لمعرفة ما إذا كانت منشأتك مشمولة.',
  'national-social-insurance-authority-egypt': 'تدير التأمينات الاجتماعية والمعاشات بموجب القانون ١٤٨ لسنة ٢٠١٩ (سارٍ منذ ١ يناير ٢٠٢٠). يدفع صاحب العمل اشتراكات عن أجر كل عامل مؤمَّن عليه (١٢٪ للشيخوخة والعجز والوفاة وحدها)، ويجب إخطار الهيئة فوراً بكل إصابة عمل.',
  'new-urban-communities-authority-nuca': 'الجهة المختصة بالتخطيط والتنظيم في المدن الجديدة بموجب قانون البناء ١١٩ لسنة ٢٠٠٨ (المادة ٤)، فتصدر تراخيص البناء لمواقع مثل القاهرة الجديدة والعبور الجديدة. الترخيص لكل مشروع وموقع لا للشركة، وخارج المدن الجديدة تصدره الجهة الإدارية المحلية.',
};

