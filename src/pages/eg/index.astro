---
import Layout from '../../layouts/Layout.astro';
import egData from '../../data/international/eg.json';

interface EgVendor {
  slug: string; name: string; category: string; vendor_url: string;
  tagline: string; market_position: string; eg_specific_note?: string | null;
  tier: 'S' | 'A' | 'F'; reputation_flag: string | null;
  pros: string[]; cons: string[]; typical_pricing: string;
  is_cross_market: boolean; cross_market_link: string | null;
}

const vendors = (egData as { vendors: EgVendor[] }).vendors;
const categories = ['software', 'lead-gen', 'insurance', 'payroll', 'certification'];
const categoryMeta: Record<string, { label: string; description: string }> = {
  'software': { label: 'Accounting / invoicing & construction software', description: 'Accounting and ERP systems that say they support Egyptian Tax Authority (ETA) e-invoicing (Daftra, Edara ERP, AccFlex ERP, Odoo); Egyptian construction ERPs whose vendors say they handle payment certificates (مستخلصات) and ETA submission (DoubleClick ERP, Voko ERP, Namasoft); international project tools with no ETA role (Oracle Primavera P6, RIB Candy, Autodesk Forma, PlanRadar); the OrchidaTax connector, which links existing ERPs to the ETA; and two accounting tools whose Egypt-facing pages make no ETA e-invoicing claim (Wafeq, QuickBooks).' },
  'lead-gen': { label: 'Tenders, project intelligence & home services', description: 'The government e-procurement portal (etenders.gov.eg), the paid tender-alert service EgyptTenders, the regional project database BNC Network (its readable pages do not name Egypt), the free supplier directory MadeInEgypt (reputation warning: its own disclaimer says it does not verify every listing), and the home-services app FilKhedma (Cairo, Alexandria and the North Coast).' },
  'insurance': { label: 'Construction insurance: Contractors All Risks', description: `Engineering cover from Egyptian insurers: state-owned Misr Insurance, Allianz Egypt, GIG Egypt, Suez Canal Insurance and EGX-listed Mohandes Insurance. Each lists contractors' all risks (CAR) and erection all risks (EAR) cover and none publishes rates. Decennial liability appears only on Mohandes's list, so ask the others if your contract requires it.` },
  'payroll': { label: 'Payroll: social insurance & income tax', description: 'ZenHR, which says its Egypt payroll handles income tax, social insurance and the Martyrs Tax (no Egypt office listed); Menaitech (MenaPAY), with a New Cairo office and a free payroll plan for up to 30 employees; PaySpace, now sold as Deel Local Payroll, with Egypt on its 49-country list; and EgyBell, an Egyptian firm that runs payroll as an outsourced service. Employers pay social insurance contributions on each insured worker under Law 148 of 2019 (see NOSI below).' },
  'certification': { label: 'Compliance & official bodies', description: 'The official bodies a contractor deals with: company incorporation through GAFI; tax registration, VAT and e-invoicing with the ETA; membership of the contractors federation (EFCBC), which Law 104/1992 requires for contracting work above EGP 50,000 per operation; the Engineers Syndicate, since engineering posts and engineering work may only go to registered engineers (Law 66/1974); social insurance with NOSI (Law 148 of 2019); and, for sites in new cities, building permits from NUCA.' },
};
const vendorsByCategory: Record<string, EgVendor[]> = {};
categories.forEach(c => { vendorsByCategory[c] = vendors.filter(v => v.category === c); });

const pageTitle = 'Egypt Construction & Trades Software (ETA e-Invoicing) | WrenchStack';
const pageDescription = `Independent directory of ${vendors.length} vendors and official bodies for Egypt: accounting and construction software (including tools that say they handle ETA e-invoicing and مستخلصات), tender sources, payroll, and Contractors All Risks insurance, plus the ETA e-invoicing system, EFCBC membership and the other registrations Egyptian contractors deal with.`;
const breadcrumbs = [ { name: 'Home', url: '/' }, { name: 'Egypt', url: '/eg/' } ];
const enUrl = new URL('/eg/', Astro.site).toString();
const arUrl = new URL('/eg/ar/', Astro.site).toString();
---
<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs} alternateUrls={[{ hreflang: 'en', href: enUrl }, { hreflang: 'ar', href: arUrl }, { hreflang: 'x-default', href: enUrl }]}>
  <article class="mx-auto max-w-5xl px-4 py-12">
    <header class="mb-10">
      <div class="mb-3 flex items-center justify-between gap-3">
        <div class="flex items-center gap-2">
          <span class="text-2xl" aria-hidden="true">🇪🇬</span>
          <p class="text-sm font-semibold uppercase tracking-wider text-orange-600">Egypt · مصر</p>
        </div>
        <a href="/eg/ar/" class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">العربية</a>
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">Egypt Construction & Trades Software Directory</h1>
      <p class="mt-4 text-lg text-slate-600 leading-relaxed">
        Independent reviews of {vendors.length} Egypt-relevant vendors and official bodies, organised around the <strong>ETA</strong> (Egyptian Tax Authority) e-invoicing system, which ETA made mandatory in phases. Construction ERPs whose vendors say they handle <span dir="rtl">مستخلصات</span> (payment certificates) and ETA submission (DoubleClick ERP, Voko ERP, Namasoft, AccFlex ERP), cloud accounting such as Daftra (priced in USD; it says it has headquarters in the United States and in Egypt), international project tools (Oracle Primavera P6, RIB Candy, Autodesk Forma, PlanRadar), payroll and Contractors All Risks insurance, with the local context: a general VAT rate of 14%, EFCBC membership for contracting work above EGP 50,000, and USD-priced software whose EGP cost moves with the exchange rate.
      </p>
    </header>

    <section class="mb-10 grid gap-3 grid-cols-2 sm:grid-cols-4">
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">{vendors.length}</div>
        <div class="mt-1 text-xs text-slate-600">vendors and official bodies</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">EGP 50,000</div>
        <div class="mt-1 text-xs text-slate-600">EFCBC membership threshold per operation</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">14%</div>
        <div class="mt-1 text-xs text-slate-600">VAT</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">12%</div>
        <div class="mt-1 text-xs text-slate-600">employer social insurance share for old age, disability and death (Law 148/2019)</div>
      </div>
    </section>

    <section class="mb-10 flex flex-wrap items-center justify-between gap-4 rounded-lg border-2 border-emerald-300 bg-emerald-50 p-5">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-emerald-700">⏰ Compliance guide · ETA e-invoicing is mandatory for taxpayers named in ETA's phased decisions</p>
        <h2 class="mt-1 text-base font-bold text-slate-900">ETA e-invoicing (الفاتورة الإلكترونية) for Egyptian contractors</h2>
        <p class="mt-1 text-sm text-slate-700">How e-invoices are signed and sent to the ETA, who must comply and how to check, VAT on contracting works, and which tools in this directory say they submit to the ETA, including <span dir="rtl">مستخلصات</span>.</p>
      </div>
      <a href="/eg/guides/eta-e-invoicing/" class="shrink-0 rounded-md bg-emerald-700 px-5 py-3 text-sm font-semibold text-white hover:bg-emerald-800">Read the guide →</a>
    </section>

    <section class="mb-10 flex flex-wrap items-center justify-between gap-4 rounded-lg border border-orange-200 bg-orange-50 p-5">
      <div>
        <h2 class="text-base font-bold text-slate-900">Deciding between two options?</h2>
        <p class="mt-1 text-sm text-slate-700">See Egyptian vendors compared side by side: a short verdict, pros and cons, Egypt-specific notes, and pricing, head to head.</p>
      </div>
      <a href="/eg/compare/" class="shrink-0 rounded-md bg-slate-900 px-5 py-3 text-sm font-semibold text-white hover:bg-slate-700">Compare Egyptian vendors →</a>
    </section>

    <section class="mb-10 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-3 text-base font-bold text-slate-900">What’s different about choosing software in Egypt</h2>
      <p class="text-sm text-slate-700 leading-relaxed">
        One thing shapes Egyptian software selection: <strong>ETA e-invoicing.</strong> The Egyptian Tax Authority made e-invoicing mandatory in phases by decision (its inquiry page dates the obligation for phase 5 from 15 December 2021 and for phase 8 in four sub-phases from 15 September to 15 December 2022), and its online inquiry tool shows whether a business is covered. E-invoices must be electronically signed and sent through integration with ETA's system, through your own software or one of the service providers ETA lists; ETA also runs an e-receipt system. The vendors here describe different routes: Daftra, Edara ERP (Ultimate plan), AccFlex ERP, Namasoft, Voko ERP and Odoo say they support ETA e-invoicing; DoubleClick ERP says it sends <span dir="rtl">مستخلصات</span> (payment certificates) and invoices to the ETA directly; OrchidaTax links existing ERPs such as SAP, Oracle and Microsoft Dynamics to the ETA; and the Egypt-facing pages of Wafeq and QuickBooks make no ETA e-invoicing claim. Currency matters too: Daftra, Edara ERP, Odoo and PlanRadar list prices in USD, so their EGP cost moves with the exchange rate, while Wafeq publishes EGP prices. Beyond that: the general VAT rate is <strong>14%</strong>, and October 2025 press reports describe it being applied to contracting works; and under Law 104/1992, contracting work above <strong>EGP 50,000</strong> per operation needs <strong>EFCBC membership</strong>.
      </p>
    </section>

    {categories.map(c => {
      const cat = categoryMeta[c];
      const cv = vendorsByCategory[c];
      if (cv.length === 0) return null;
      return (
        <section class="mb-12">
          <div class="mb-5">
            <h2 class="text-2xl font-bold text-slate-900">{cat.label}</h2>
            <p class="mt-1 text-sm text-slate-600 leading-relaxed">{cat.description}</p>
          </div>
          <div class="space-y-4">
            {cv.map(v => {
              const isCert = v.category === 'certification';
              const tierColor = v.tier === 'S' ? 'border-emerald-300' : v.tier === 'F' ? 'border-rose-300' : 'border-blue-300';
              const tierLabel = isCert ? 'Official body / regime' : v.tier === 'S' ? 'Published prices' : v.tier === 'F' ? 'Reputation warning' : 'Listed';
              const tierBadge = v.tier === 'S' ? 'bg-emerald-100 text-emerald-900' : v.tier === 'F' ? 'bg-rose-100 text-rose-900' : 'bg-blue-100 text-blue-900';
              return (
                <article class={`rounded-lg border-2 ${tierColor} bg-white p-5`}>
                  <div class="mb-3 flex items-start justify-between gap-3">
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-2 mb-1 flex-wrap">
                        <h3 class="text-xl font-bold text-slate-900">{v.name}</h3>
                        <span class={`rounded-full px-2 py-0.5 text-xs font-bold ${tierBadge}`}>{isCert ? tierLabel : `Tier ${v.tier} · ${tierLabel}`}</span>
                        </div>
                      <p class="text-sm italic text-slate-500">{v.tagline}</p>
                    </div>
                  </div>
                  <p class="mb-3 text-sm text-slate-700 leading-relaxed">{v.market_position}</p>
                  {v.reputation_flag && (
                    <div class="mb-3 rounded-md border-l-4 border-amber-400 bg-amber-50 px-4 py-2">
                      <p class="text-sm text-amber-900 leading-relaxed"><strong>Heads up:</strong> {v.reputation_flag}</p>
                    </div>
                  )}
                  {v.eg_specific_note && (
                    <div class="mb-3 rounded-md bg-slate-50 px-4 py-3">
                      <p class="text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Egypt-specific note</p>
                      <p class="text-sm text-slate-700 leading-relaxed">{v.eg_specific_note}</p>
                    </div>
                  )}
                  <div class="mb-3 grid gap-3 sm:grid-cols-2">
                    <div>
                      <p class="text-xs font-bold uppercase tracking-wider text-emerald-700 mb-1">{isCert ? 'What it covers' : 'Pros'}</p>
                      <ul class="space-y-1 text-sm text-slate-700">{v.pros.slice(0, 4).map(p => <li class="leading-snug">+ {p}</li>)}</ul>
                    </div>
                    <div>
                      <p class="text-xs font-bold uppercase tracking-wider text-rose-700 mb-1">{isCert ? 'Watch out for' : 'Cons'}</p>
                      <ul class="space-y-1 text-sm text-slate-700">{v.cons.slice(0, 4).map(con => <li class="leading-snug">− {con}</li>)}</ul>
                    </div>
                  </div>
                  <div class="mb-3 text-xs text-slate-600"><strong class="text-slate-900">{isCert ? 'Cost / access:' : 'Typical Egypt pricing:'}</strong> {v.typical_pricing}</div>
                  <div class="flex flex-wrap gap-2">
                    <a href={`/eg/${v.slug}/`} class="rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700">Full Egypt review →</a>
                    <a href={v.vendor_url} rel="sponsored nofollow noopener" target="_blank" class="rounded-md bg-orange-500 px-4 py-2 text-sm font-semibold text-white hover:bg-orange-600">{isCert ? 'Official site' : `Visit ${v.name}`} →</a>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      );
    })}

    <section class="mt-12 rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">Are you an Egyptian software vendor?</h2>
      <p class="mt-2 text-slate-300 leading-relaxed">If you build software or services for Egyptian contractors and the building trades and want to be reviewed or listed, get in touch through our <a href="/for-vendors/" class="underline">vendor program</a>.</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/for-vendors/" class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600">Work with us →</a>
        <a href="/sa/" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">🇸🇦 Saudi directory</a>
        <a href="/methodology/" class="rounded-md border border-white/30 bg-white/10 px-5 py-3 text-sm font-semibold text-white hover:bg-white/20">Methodology</a>
      </div>
    </section>
  </article>
</Layout>
