---
import Layout from '../../../../layouts/Layout.astro';

// Tools from our Jordan directory and what each vendor says about JoFotara.
// Verify current status with each vendor before relying on it.
const tools = [
  { name: 'InvoiceQ', status: 'E-invoicing layer that links existing ERP and accounting systems to the ISTD', fit: 'Firms keeping their current back office', note: 'From JOD 120/yr', href: '/jo/invoiceq/' },
  { name: 'Mozon', status: 'Amman ERP with a contracting module; its ERP page lists JoFotara integration', fit: 'Contractors wanting an ERP with contracting features', note: 'Quote-based', href: '/jo/mozon/' },
  { name: 'Odoo', status: 'Ships a JoFotara module (l10n_jo_edi; UBL 2.1, QR code); needs ISTD credentials', fit: 'Firms wanting one ERP system', note: 'Published USD per-user prices; implementation extra', href: '/jo/odoo/' },
  { name: 'Daftra', status: 'Says it links directly to the national e-invoicing platform with automatic QR code', fit: 'Firms wanting accounting, inventory, CRM and HR in one subscription', note: 'Published USD prices; 14-day trial', href: '/jo/daftra/' },
  { name: 'FawtraPlus', status: 'Issues JoFotara invoices with QR code and 16% sales tax; says it is ISTD-approved', fit: 'Firms and self-employed professionals wanting one low-cost annual plan', note: '50 JOD/yr', href: '/jo/fawtraplus/' },
  { name: 'Fatwarti', status: 'Says it sends invoices directly to JoFotara via the official API; accounting + POS', fit: 'Firms wanting accounting, inventory and POS', note: 'No public prices (free trial)', href: '/jo/fatwarti/' },
  { name: 'Tax2Gov (T2G)', status: 'API connector linking existing ERP and POS systems to JoFotara', fit: 'Keep your existing system, add the JoFotara link', note: 'Quote-based', href: '/jo/tax2gov/' },
  { name: 'Zoho Books / QuickBooks', status: 'No JoFotara integration named by Zoho or Intuit; InvoiceQ lists QuickBooks among the systems it connects', fit: 'Firms already on these global tools', note: 'See each review', href: '/jo/zoho-books/' },
];

const faqs = [
  { q: 'Is JoFotara mandatory yet, and for whom?', a: 'Jordanian press reported that use of the national e-invoicing system became mandatory from the start of April 2025. The ISTD invoicing regulation, as amended in 2023, recognises electronic invoices issued through JoFotara or through software linked to it. General sales tax registration becomes mandatory once sales pass thresholds that differ for goods and services, so confirm your own obligations with the ISTD or your accountant.' },
  { q: 'How are JoFotara invoices validated?', a: 'Odoo’s documentation for its JoFotara module says invoices are generated in UBL 2.1 and submitted for real-time validation, and that the JoFotara QR code is embedded in the invoice PDF so it can be checked in the Sanad app. FawtraPlus says it adds a QR code and a UUID to each invoice. The ISTD pages read for this guide do not set out the technical model, so ask your vendor how its integration submits and validates invoices.' },
  { q: 'What happens if I don\'t comply?', a: 'The ISTD invoicing regulation recognises electronic invoices issued through JoFotara or through software linked to it, so make sure yours are. Late sales tax payment is fined four per thousand of the tax due for each week of delay, per the ISTD sales tax FAQ. The ISTD pages read for this guide do not state the fines for invoicing violations, so confirm them with the ISTD or your accountant.' },
  { q: 'What format and what\'s the legal basis?', a: 'Odoo’s JoFotara module generates invoices in UBL 2.1 and needs an Activity Number, Client ID and Secret Key from the ISTD. The legal basis is the ISTD invoicing regulation, as amended in 2023, which recognises electronic invoices issued through JoFotara or through software linked to it. The system is run by the Income & Sales Tax Department (ISTD) under the Ministry of Finance, which administers Income Tax Law No. 34 of 2014 and General Sales Tax Law No. 6 of 1994.' },
  { q: 'Does my accounting software need to be JoFotara-native?', a: 'Not necessarily, but invoices must be issued through JoFotara or software linked to it. InvoiceQ, Daftra, FawtraPlus and Fatwarti say their products send invoices to JoFotara, the Mozon ERP page lists JoFotara integration, and Odoo ships a JoFotara module (l10n_jo_edi) that needs an Activity Number, Client ID and Secret Key from the ISTD. InvoiceQ and Tax2Gov sell connectors for existing systems, and InvoiceQ lists QuickBooks among the systems it connects. Zoho names no JoFotara integration for Zoho Books. The ISTD publishes no list of approved software. The right question for any vendor: "Do you send invoices to JoFotara directly, or which connector do I need?"' },
  { q: 'What\'s the wider Jordanian tax context?', a: 'General Sales Tax (GST) is a standard 16% under Law No. 6 of 1994, with reduced, zero and exempt rates for listed goods and services, so your software must be set to Jordan’s rates. Social Security (SSC) contributions are 14.25% of the insured wage from the employer and 7.5% from the employee, 21.75% in total, per PwC. The ISTD runs the online portal; tax bills can be paid through eFawateercom.' },
];

const pageTitle = 'JoFotara E-Invoicing in Jordan: 2026 Guide for Contractors';
const pageDescription = 'Jordan\'s JoFotara national e-invoicing system explained for the building trades: the legal basis, how vendors describe invoice validation, the April 2025 mandatory start reported by the press, and which tools in our directory say they link to JoFotara. Independent; published June 2026, updated October 2026.';

const guideUrl = new URL('/jo/guides/jofotara-e-invoicing/', Astro.site).toString();
const arUrl = new URL('/jo/ar/guides/jofotara-e-invoicing/', Astro.site).toString();
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Jordan', url: '/jo/' },
  { name: 'JoFotara e-invoicing for contractors', url: '/jo/guides/jofotara-e-invoicing/' },
];

const articleSchema = {
  '@context': 'https://schema.org', '@type': 'Article', headline: pageTitle, description: pageDescription,
  datePublished: '2026-06-20', dateModified: '2026-10-01', inLanguage: 'en',
  author: { '@type': 'Organization', name: 'WrenchStack Research', url: 'https://wrenchstack.com/research/' },
  publisher: { '@type': 'Organization', name: 'WrenchStack', url: 'https://wrenchstack.com' },
  mainEntityOfPage: guideUrl,
};
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs} alternateUrls={[{ hreflang: 'en', href: guideUrl }, { hreflang: 'ar', href: arUrl }, { hreflang: 'x-default', href: guideUrl }]}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <article class="mx-auto max-w-4xl px-4 py-12">
    <header class="mb-8">
      <div class="mb-3 flex items-center justify-between gap-3">
        <p class="text-sm font-semibold uppercase tracking-wider text-orange-600">🇯🇴 Jordan · Compliance guide</p>
        <a href="/jo/ar/guides/jofotara-e-invoicing/" class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">العربية</a>
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        JoFotara E-Invoicing in Jordan
      </h1>
      <p class="mt-3 text-lg text-slate-600 leading-relaxed">
        What Jordan's national e-invoicing system means for the building trades: what the ISTD invoicing regulation recognises, how vendors describe invoice validation, what to check before a public tender, and which tools say they link to JoFotara.
      </p>
      <p class="mt-3 text-sm text-slate-500">By WrenchStack Research · Published June 2026 · Updated 1 October 2026 · Not tax advice; confirm your situation with the ISTD (istd.gov.jo) or your accountant.</p>
    </header>

    <section class="mb-8 rounded-lg border-2 border-orange-300 bg-orange-50 p-6">
      <h2 class="mb-2 text-lg font-bold text-slate-900">⏰ The short version</h2>
      <p class="text-slate-800 leading-relaxed">
        Jordan's <strong>JoFotara</strong> national e-invoicing system is run by the Income and Sales Tax Department (ISTD). The ISTD invoicing regulation, as amended in 2023, recognises electronic invoices issued through JoFotara or through software linked to it, and Jordanian press reported that use became <strong>mandatory from the start of April 2025</strong>. Odoo's documentation says its JoFotara module submits invoices in UBL 2.1 for real-time validation and puts a JoFotara <strong>QR code</strong> on the invoice that can be checked in the Sanad app. The ISTD publishes no list of approved software. The practical task: make sure your invoicing tool links to JoFotara, directly or through a connector, and confirm the integration scope with the vendor.
      </p>
    </section>

    <section class="mb-10 grid gap-3 sm:grid-cols-3">
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">Apr 2025</div>
        <div class="mt-1 text-xs text-slate-600">mandatory start, per press reports</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">16%</div>
        <div class="mt-1 text-xs text-slate-600">general sales tax</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">UBL 2.1 + QR</div>
        <div class="mt-1 text-xs text-slate-600">real-time validation, per Odoo's JoFotara module documentation</div>
      </div>
    </section>

    <section class="mb-10 prose prose-slate max-w-none">
      <h2>The timeline</h2>
      <ul>
        <li><strong>Amended 2023:</strong> the ISTD invoicing regulation, which recognises electronic invoices issued through JoFotara or through software linked to it.</li>
        <li><strong>Start of April 2025:</strong> Jordanian press reported that use of the national e-invoicing system became mandatory.</li>
      </ul>

      <h2>What the system requires</h2>
      <ul>
        <li><strong>Validation and QR code.</strong> Odoo's JoFotara documentation describes invoices submitted for real-time validation, with a JoFotara QR code on the PDF that can be checked in the Sanad app; FawtraPlus says it adds a QR code and a UUID to each invoice.</li>
        <li><strong>Structured format and credentials.</strong> Odoo's module generates invoices in <strong>UBL 2.1</strong> and needs an Activity Number, Client ID and Secret Key from the ISTD.</li>
        <li><strong>Integration path.</strong> Via the ISTD JoFotara web portal or the Fawatiri app, or through software linked to JoFotara, which is where vendors such as InvoiceQ, Mozon, Daftra, Odoo and Tax2Gov come in. The ISTD publishes no list of approved software.</li>
        <li><strong>Check your own scope.</strong> General sales tax registration becomes mandatory once sales pass thresholds that differ for goods and services, and invoices must be issued through JoFotara or software linked to it; confirm your obligations with the ISTD or your accountant.</li>
      </ul>

      <h2>Why this matters for contractors specifically</h2>
      <p>
        <strong>Invoices must be issued through JoFotara or software linked to it</strong>, so check that your accounting software is linked. Public tenders have their own requirements: the Government Tenders Department says contractors must activate the Sanad service to submit bids electronically on <a href="/jo/joneps/">JONEPS</a>, and no ministry, municipality or company may sign a works contract with a contractor who is not registered and classified with the Jordan Construction Contractors Association. Among the software in our directory, Mozon sells a contracting module (budgets, subcontractors and progress invoicing) and Odoo covers projects alongside accounting; most of the other tools are e-invoicing or accounting software, so you may need separate project tracking.
      </p>

      <h2>The wider Jordanian tax context</h2>
      <ul>
        <li><strong>GST:</strong> standard <strong>16%</strong> under Law No. 6 of 1994, with reduced, zero and exempt rates for listed goods and services, so software must be set to Jordan's rates.</li>
        <li><strong>Social Security (SSC):</strong> contributions of 14.25% of the insured wage from the employer and 7.5% from the employee (21.75% in total), per PwC; tax bills can be paid through eFawateercom.</li>
      </ul>

      <h2>Which tools link to JoFotara?</h2>
      <p>
        From the software in our <a href="/jo/">Jordan directory</a>, here is what each vendor says about JoFotara. Neither Zoho nor Intuit names a JoFotara integration for Zoho Books or QuickBooks; InvoiceQ lists QuickBooks among the systems it connects. The ISTD publishes no list of approved software, so confirm the current status with the vendor.
      </p>
    </section>

    <section class="mb-10 overflow-x-auto">
      <table class="w-full text-sm border border-slate-200 rounded-lg overflow-hidden">
        <thead class="bg-slate-50 text-left text-slate-700">
          <tr>
            <th class="p-3 font-semibold">Tool</th>
            <th class="p-3 font-semibold">JoFotara status</th>
            <th class="p-3 font-semibold">Fit</th>
            <th class="p-3 font-semibold">Pricing</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 bg-white">
          {tools.map((t) => (
            <tr>
              <td class="p-3 font-semibold text-slate-900"><a href={t.href} class="hover:text-orange-600">{t.name}</a></td>
              <td class="p-3 text-slate-700">{t.status}</td>
              <td class="p-3 text-slate-600">{t.fit}</td>
              <td class="p-3 text-slate-600">{t.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="mt-3 text-xs text-slate-500">JoFotara status is as each vendor describes it, checked September 2026. The ISTD publishes no list of approved software, so confirm the integration scope with each vendor before relying on it.</p>
    </section>

    <section class="mb-10 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-2 text-lg font-bold text-slate-900">The one question to ask any vendor</h2>
      <p class="text-sm text-slate-700 leading-relaxed">
        Don't assume a good accounting tool links to JoFotara. Ask: <strong>"Do you send invoices to JoFotara directly, or do I need a third-party connector, and what exactly does the integration cover?"</strong> If you're on QuickBooks, InvoiceQ lists it among the systems it connects; Zoho names no JoFotara integration for Zoho Books, so confirm how you will issue e-invoices before relying on it. And remember the press-reported mandatory start of April 2025 has already passed; this isn't a "later" task.
      </p>
    </section>

    <section class="mb-10">
      <h2 class="mb-5 text-2xl font-bold text-slate-900">Frequently asked questions</h2>
      <div class="space-y-3">
        {faqs.map((f) => (
          <details class="rounded-lg border border-slate-200 bg-white p-4">
            <summary class="cursor-pointer font-semibold text-slate-900">{f.q}</summary>
            <p class="mt-3 text-slate-700 leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mb-10 rounded-lg bg-slate-50 p-5 text-xs text-slate-500 leading-relaxed">
      <strong class="text-slate-700">Sources &amp; verification:</strong> The legal basis is the ISTD invoicing regulation, as amended in 2023; the April 2025 mandatory start comes from Jordanian press reports; GST is 16% under General Sales Tax Law No. 6 of 1994 and the late-payment fine comes from the ISTD sales tax FAQ; UBL 2.1, real-time validation and the QR code come from Odoo's JoFotara module documentation; SSC rates (14.25% employer, 7.5% employee) are from PwC; vendor positions are as each vendor publishes them, checked September 2026. Claims in the June 2026 version that rested on secondary sources (a clearance model, digital-signature and format details, fine amounts, a 2022-2023 rollout timeline, a grace period and an inspection campaign) were removed on 1 October 2026 because they could not be confirmed on the ISTD's pages. General information, not tax advice. Spotted an error? <a href="/contact/" class="underline">Tell us</a>.
    </section>

    <section class="rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">Compare Jordanian trades software & services</h2>
      <p class="mt-2 text-slate-300 leading-relaxed">Independent reviews of Jordanian accounting and invoicing software, tender access, payroll and Contractors All Risks insurance, with no pay-to-play.</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/jo/" class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600">🇯🇴 Jordan directory →</a>
        <a href="/jo/compare/" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">Compare vendors</a>
        <a href="/for-vendors/" class="rounded-md border border-white/30 bg-white/10 px-5 py-3 text-sm font-semibold text-white hover:bg-white/20">Are you a vendor? Work with us</a>
      </div>
    </section>
  </article>
</Layout>
