---
import Layout from '../../../layouts/Layout.astro';
import joData from '../../../data/international/jo.json';

interface JoVendor {
  slug: string; name: string; category: string; vendor_url: string;
  tagline: string; tier: 'S' | 'A' | 'F';
  is_cross_market: boolean;
}
const vendors = (joData as { vendors: JoVendor[] }).vendors;

// Concise Arabic positioning per vendor (the detailed reviews remain in English for now).
const ar: Record<string, string> = {
  'invoiceq': 'منصة فوترة إلكترونية تقول إنها تأسست في الأردن عام ٢٠٢٠، وتربط أنظمة ERP والمحاسبة القائمة بنظام الفوترة الوطني لدى دائرة ضريبة الدخل والمبيعات. أسعار سنوية منشورة بالدينار: من ١٢٠ ديناراً (حتى ٢٠٠ فاتورة) إلى ٥٠٠ دينار (فواتير غير محدودة).',
  'mozon': 'شركة برمجيات تقول إنها تأسست عام ٢٠٠٢ ومقرها عمّان، تبيع نظام ERP ووحدة لإدارة المقاولات (MCM) تشمل الموازنات ومقاولي الباطن والفواتير المرحلية. تذكر صفحة ERP لديها التكامل مع الفوترة الوطنية. الأسعار حسب الطلب.',
  'odoo': 'نظام ERP معياري من Odoo S.A. يتضمّن توطيناً أردنياً (دليل حسابات وضريبة مبيعات ١٦٪) ووحدة للفوترة الوطنية (l10n_jo_edi) تتطلّب بيانات اعتماد من الدائرة. أسعار منشورة بالدولار لكل مستخدم، والتنفيذ بتكلفة إضافية عبر باقات Odoo أو الشركاء.',
  'daftra': 'نظام محاسبة وإدارة أعمال سحابي تشغّله Izam, Inc. بحسب شروط الخدمة، ويقول إن منتجه الأردني للفاتورة الإلكترونية يرتبط مباشرة بالمنصة الوطنية ويضيف رمز QR تلقائياً. أسعار منشورة بالدولار وتجربة مجانية لمدة ١٤ يوماً.',
  'fawtraplus': 'تطبيق فوترة إلكترونية سحابي من شركة JoPython في عمّان (تأسست عام ٢٠١٤)، يصدر فواتير الفوترة الوطنية برمز QR ويحسب ضريبة المبيعات ١٦٪. السعر المنشور ٥٠ ديناراً سنوياً. تقول الشركة إنه معتمد من الدائرة، والدائرة لا تنشر قائمة بالبرامج المعتمدة.',
  'fatwarti': 'نظام محاسبة ونقاط بيع سحابي باللغة العربية مقره عمّان، يقول إنه يرسل الفواتير مباشرة إلى الفوترة الوطنية عبر الواجهة البرمجية الرسمية. لا أسعار منشورة، مع تجربة مجانية.',
  'stride-bs': 'شركة في عمّان تنفّذ نظام Odoo وتخصّصه وتدعمه، ويدرجها دليل شركاء Odoo كشريك Ready في الأردن. لا يذكر موقعها الفوترة الوطنية، فاسأل عن إعداد الربط. الأسعار حسب الطلب.',
  'tax2gov': 'وسيط برمجي من SB International, Inc. (مكتب رئيسي في ديلاوير بالولايات المتحدة ومكتب في طنجة بالمغرب) يربط أنظمة ERP ونقاط البيع القائمة بالفوترة الوطنية. لا مكتب في الأردن ولا أسعار منشورة.',
  'eskadenia': 'شركة برمجيات تأسست عام ٢٠٠٠ ومقرها عمّان، مع مكتبين في دبي وستوكهولم، تبيع نظام ERP عبر الويب (ESKA Business Manager). لا يصف موقعها وحدة للمقاولات أو ربطاً بالفوترة الوطنية، فاسأل عن ذلك أولاً.',
  'zoho-books': 'محاسبة سحابية عالمية من Zoho بأسعار منشورة بالدولار وخطة مجانية. لا توجد نسخة أردنية، ولا تذكر Zoho أي تكامل مع الفوترة الوطنية، فتأكّد من طريقة إصدار الفواتير الإلكترونية قبل اختيارها.',
  'quickbooks': 'محاسبة سحابية من Intuit عبر موقعها العالمي، دون سعر أردني منشور. لا تذكر Intuit أي ربط بالفوترة الوطنية، وتدرج InvoiceQ نظام QuickBooks ضمن الأنظمة التي تربطها.',
  'joneps': 'منصة الشراء الإلكتروني الحكومية (JONEPS) التي تنشر عليها الجهات العامة دعوات العطاءات ويقدّم الموردون عروضهم إلكترونياً، ويذكر تذييلها دائرة المشتريات الحكومية ودائرة العطاءات الحكومية. يلزم التسجيل وتفعيل خدمة «سند» لتقديم العروض إلكترونياً.',
  'jordantenders': 'خدمة تنبيهات عطاءات مدفوعة تقول إنها جزء من Global Tenders Services Pvt. Ltd.، وتشمل فئة للإنشاءات والعقارات. أسعار سنوية منشورة من ٢٩٥ إلى ٤٩٥ دولاراً. دعوات العطاءات الحكومية تُنشر أيضاً على منصة JONEPS الرسمية.',
  'jofico': 'الشركة الأردنية الفرنسية للتأمين (JOFICO)، تقول إنها تأسست عام ١٩٧٦، ومدرجة في بورصة عمّان (JOFR). تدرج صفحتها الهندسية تأمين جميع أخطار المقاولين وآليات المقاولين والمسؤولية العشرية. الأسعار حسب الطلب، وأفادت «سرايا نيوز» في فبراير ٢٠٢٦ بتوقيعها مذكرة تفاهم لدراسة اندماج محتمل مع مجموعة الخليج للتأمين.',
  'gig-jordan': 'gig الأردن، تقول إنها تأسست عام ١٩٩٦ باسم الشرق العربي للتأمين وانضمت إلى مجموعة الخليج للتأمين (الكويت) عام ٢٠٠٩، ورفعت Fairfax Financial Holdings الكندية حصتها في المجموعة إلى ٩٧٪ بحسب gig الأردن. مدرجة في بورصة عمّان (GIGJ)، وتتيح نموذجاً لطلب عرض سعر لكل وثيقة هندسية.',
  'jordan-insurance-company': 'شركة التأمين الأردنية (JIC)، تأسست في مارس ١٩٥١ بحسب ملفها في بورصة عمّان (JOIN)، وثبّتت AM Best تصنيف قوتها المالية عند B (Fair) في يوليو ٢٠٢٦. لم تظهر منتجاتها الهندسية على موقعها عند التحقّق، فاسأل الشركة أو الوسيط مباشرة.',
  'meico-jordan': 'شركة الشرق الأوسط للتأمين (MEICO)، تقول إنها تعمل في الأردن منذ ١٩٦٢، ومدرجة في بورصة عمّان (MEIN). تدرج صفحتها الهندسية تأمين جميع أخطار المقاولين وجميع أخطار التركيب وآليات المقاولين، مع نموذج لطلب عرض سعر. أوقفت ترخيص تأمين المركبات اعتباراً من ١ يناير ٢٠٢٦.',
  'zenhr': 'منصة سحابية للموارد البشرية والرواتب في الشرق الأوسط وشمال أفريقيا، تقول صفحتها الأردنية إنها «متوافقة ١٠٠٪ مع قانون العمل الأردني والضمان الاجتماعي»، وتحتسب اشتراكات الضمان ومكافأة نهاية الخدمة. بالعربية والإنجليزية، والأسعار حسب الطلب.',
  'menaitech-menapay': 'حزمة موارد بشرية ورواتب إقليمية مكتبها الرئيسي في الرياض ولها مكتب في عمّان، وMenaPAY هو منتج الرواتب فيها. تقول إن لديها «قرابة ٢٠٠٠ عميل». صفحة MenaPAY تذكر قواعد التأمينات الاجتماعية السعودية لا الضمان الأردني، فاسأل عن ذلك في العرض التوضيحي.',
  'yomly': 'منصة سحابية للموارد البشرية والرواتب تُدار من دبي (EmiratesHR سابقاً، تأسست عام ٢٠١٨ بحسب قولها)، ولها صفحة رواتب للأردن تقول إنها متوافقة مع قوانين العمل والضرائب المحلية، لكنها لا تذكر الضمان الاجتماعي. لا مكتب في الأردن ولا أسعار منشورة.',
  'gts-one-erp': 'نظام موارد بشرية ورواتب باللغة العربية ضمن حزمة ERP من GTS Software، بمكتب في جبل الحسين بعمّان ومكتبين في رام الله والخليل. لا يذكر موقعها اشتراكات الضمان الاجتماعي أو ضريبة الدخل الأردنية، فتحقّق من ذلك أولاً. الأسعار حسب الطلب.',
  'jordan-construction-contractors-association': 'نقابة مقاولي الإنشاءات الأردنيين: بموجب قانون مقاولي الإنشاءات رقم ١٣ لسنة ١٩٨٧ وتعديلاته، لا تجوز مزاولة المقاولات دون التسجيل المسبق في النقابة، ويُعدّ باطلاً أي عقد أشغال مع مقاول غير مسجّل ومصنّف فيها. غرامة المزاولة دون تسجيل ١٠٠٠-٥٠٠٠ دينار.',
  'jordan-engineers-association': 'نقابة المهندسين الأردنيين: التسجيل فيها شرط لمزاولة الهندسة بموجب قانون نقابة المهندسين (رقم ١٥ لسنة ١٩٧٢ وتعديلاته)، ويُظهر موقعها ١٩٢٬٢٧٥ مهندساً مسجّلاً. يدفع خرّيجو الجامعات الأردنية ١٣٦ ديناراً عند تقديم الطلب.',
  'companies-control-department': 'دائرة مراقبة الشركات: تسجّل الشركات وتراقبها بموجب قانون الشركات رقم ٢٢ لسنة ١٩٩٧ وتعديلاته، وتتبع وزارة الصناعة والتجارة والتموين. التسجيل إلكتروني، ويمكن تسجيل شركة ذات مسؤولية محدودة خلال ٢٤ ساعة إذا لم تلزم موافقات مسبقة.',
  'income-and-sales-tax-department': 'دائرة ضريبة الدخل والمبيعات: تتبع وزارة المالية، وتدير ضريبة الدخل والضريبة العامة على المبيعات (١٦٪) ونظام الفوترة الوطني (JoFotara). وأفادت الصحافة الأردنية بأن استخدام النظام أصبح إلزامياً منذ مطلع أبريل ٢٠٢٥.',
  'social-security-corporation': 'المؤسسة العامة للضمان الاجتماعي: تدير التأمينات الاجتماعية الإلزامية (الشيخوخة والعجز والوفاة وإصابات العمل)، وتموّلها اشتراكات صاحب العمل (١٤٫٢٥٪ من الأجر المؤمَّن عليه) والعامل (٧٫٥٪) بحسب ملخص PwC الضريبي.',
};

const tierAr: Record<string, string> = { S: 'أسعار منشورة', A: 'مدرج', F: 'تنبيه بشأن السمعة' };
const cats = [
  { key: 'software', label: 'برامج المحاسبة والفوترة والإنشاءات', desc: 'خدمات فوترة إلكترونية تربط الأنظمة القائمة بالفوترة الوطنية (InvoiceQ، Tax2Gov)؛ وتطبيقات محاسبة وفوترة تقول إنها ترسل الفواتير إليها (Daftra، FawtraPlus، Fatwarti)؛ وأنظمة ERP (Mozon التي تبيع وحدة للمقاولات، وOdoo الذي يتضمّن توطينه الأردني وحدة للفوترة الوطنية، وESKADENIA)؛ وشريك تنفيذ Odoo في عمّان (Stride)؛ وأدوات محاسبة عالمية لا يذكر مزوّدوها أي تكامل مع الفوترة الوطنية (Zoho Books، QuickBooks).' },
  { key: 'lead-gen', label: 'العطاءات وتوليد الفرص', desc: 'منصة الشراء الإلكتروني الحكومية (JONEPS) التي تنشر عليها الجهات العامة دعوات العطاءات ويسجّل فيها الموردون ويقدّمون عروضهم إلكترونياً، وخدمة تنبيهات عطاءات مدفوعة (JordanTenders) تنشر أسعاراً سنوية بالدولار.' },
  { key: 'insurance', label: 'تأمين الإنشاءات: مخاطر المقاولين', desc: 'شركات تأمين تدرج مواقعها تأميناً هندسياً مثل تأمين جميع أخطار المقاولين (JOFICO، gig الأردن، MEICO)، إضافة إلى شركة التأمين الأردنية (JIC) التي تعذّر تأكيد منتجاتها الهندسية على موقعها. لا تنشر أي منها أسعاراً والتغطية حسب الطلب، وتستقبل gig الأردن وMEICO طلبات عروض الأسعار عبر نماذج على الإنترنت. وأوقفت MEICO تأمين المركبات اعتباراً من ١ يناير ٢٠٢٦.' },
  { key: 'payroll', label: 'الرواتب: الضمان وضريبة الدخل', desc: 'أنظمة سحابية للموارد البشرية والرواتب: ZenHR (تذكر صفحتها الأردنية احتساب اشتراكات الضمان ومتطلبات قانون العمل)، وMenaITech (MenaPAY، بمكتب في عمّان)، وYomly (مقرها دبي، ولها صفحة رواتب للأردن)، وGTS One (عمّان). لا تنشر أي منها أسعاراً. يدفع صاحب العمل اشتراكات ضمان بنسبة ١٤٫٢٥٪ من الأجر المؤمَّن عليه والعامل ٧٫٥٪ بحسب PwC، فاسأل كل مزوّد عن طريقة احتسابها.' },
  { key: 'certification', label: 'الامتثال والجهات الرسمية', desc: 'الجهات الرسمية التي يتعامل معها المقاول الأردني. بموجب قانون مقاولي الإنشاءات يحصل المقاول على الرخصة، ثم يسجّل لدى وزارة الصناعة والتجارة (عبر دائرة مراقبة الشركات) ولدى نقابة المقاولين، ثم يُصنَّف. وتشمل القائمة أيضاً دائرة ضريبة الدخل والمبيعات (التي تدير الفوترة الوطنية)، ونقابة المهندسين، والمؤسسة العامة للضمان الاجتماعي.' },
];

const enUrl = new URL('/jo/', Astro.site).toString();
const arUrl = new URL('/jo/ar/', Astro.site).toString();
const pageTitle = 'دليل برامج المقاولات والإنشاءات في الأردن: الفوترة الوطنية';
const pageDescription = 'دليل مستقل لبرامج المقاولات والإنشاءات في الأردن: أنظمة المحاسبة والفوترة وERP وصلتها بالفوترة الوطنية، والوصول إلى العطاءات الحكومية (JONEPS)، وأنظمة الرواتب، وتأمين جميع أخطار المقاولين، مع سياق الامتثال المحلي (الفوترة الوطنية، والتسجيل والتصنيف لدى نقابة المقاولين، واشتراكات الضمان الاجتماعي).';
---

<Layout
  title={pageTitle}
  description={pageDescription}
  lang="ar"
  dir="rtl"
  alternateUrls={[{ hreflang: 'en', href: enUrl }, { hreflang: 'ar', href: arUrl }, { hreflang: 'x-default', href: enUrl }]}
>
  <article class="mx-auto max-w-5xl px-4 py-12">

    <div class="mb-6 flex items-center justify-between gap-3">
      <div class="flex items-center gap-2">
        <span class="text-2xl" aria-hidden="true">🇯🇴</span>
        <p class="text-sm font-semibold uppercase tracking-wider text-orange-600">المملكة الأردنية الهاشمية</p>
      </div>
      <a href="/jo/" class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">English</a>
    </div>

    <header class="mb-10">
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">دليل برامج المقاولات والإنشاءات في الأردن</h1>
      <p class="mt-4 text-lg text-slate-600 leading-relaxed">
        مراجعات مستقلة لـ {vendors.length} من المزوّدين والجهات الرسمية ذات الصلة بالسوق الأردني. تصدر الفواتير في الأردن عبر نظام الفوترة الوطني (JoFotara) لدى دائرة ضريبة الدخل والمبيعات أو عبر برامج مرتبطة به، وأفادت الصحافة الأردنية بأن استخدامه أصبح إلزامياً منذ مطلع أبريل ٢٠٢٥. في الدليل: أدوات محاسبة وفوترة وERP تقول إنها ترتبط بالفوترة الوطنية (InvoiceQ، Mozon، Daftra، Odoo وغيرها)، والوصول إلى العطاءات الحكومية (JONEPS)، وأنظمة الرواتب (ZenHR، MenaITech)، وشركات تأمين تدرج تأمين جميع أخطار المقاولين (JOFICO، gig الأردن، MEICO)، مع السياق المحلي: ضريبة المبيعات ١٦٪، والتسجيل والتصنيف لدى نقابة المقاولين، واشتراكات الضمان الاجتماعي.
      </p>
    </header>

    <section class="mb-10 flex flex-wrap items-center justify-between gap-4 rounded-lg border-2 border-emerald-300 bg-emerald-50 p-5">
      <div>
        <p class="text-xs font-bold tracking-wider text-emerald-700">⏰ دليل امتثال · الفوترة الوطنية · إلزامية منذ أبريل ٢٠٢٥ بحسب تقارير صحفية</p>
        <h2 class="mt-1 text-base font-bold text-slate-900">الفوترة الوطنية (JoFotara) لشركات المقاولات الأردنية</h2>
        <p class="mt-1 text-sm text-slate-700">كيف يعمل نظام الفوترة الوطني للمقاولين، وما الفواتير التي يعترف بها نظام الفوترة لدى الدائرة، وما الذي يجب التحقّق منه قبل العطاءات الحكومية، وأي الأنظمة في هذا الدليل تقول إنها ترتبط به.</p>
      </div>
      <a href="/jo/ar/guides/jofotara-e-invoicing/" class="shrink-0 rounded-md bg-emerald-700 px-5 py-3 text-sm font-semibold text-white hover:bg-emerald-800">اقرأ الدليل ←</a>
    </section>

    <section class="mb-10 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-3 text-base font-bold text-slate-900">ما الذي يميّز اختيار البرامج في الأردن</h2>
      <p class="text-sm text-slate-700 leading-relaxed">
        الفوترة أول ما يجب التحقّق منه. يعترف نظام الفوترة لدى دائرة ضريبة الدخل والمبيعات، بصيغته المعدّلة عام ٢٠٢٣، بالفواتير الإلكترونية الصادرة عبر <strong>نظام الفوترة الوطني (JoFotara)</strong> أو عبر برامج مرتبطة به، وأفادت الصحافة الأردنية بأن استخدام النظام أصبح إلزامياً منذ مطلع أبريل ٢٠٢٥. ولا تنشر الدائرة قائمة بالبرامج المعتمدة، فاعتبر أي ادعاء بالاعتماد ادعاءً من المزوّد نفسه، وتحقّق من نطاق الربط قبل الشراء. ومن البرامج المدرجة هنا، تبيع Mozon وحدة لإدارة المقاولات (الموازنات ومقاولو الباطن والفواتير المرحلية)، وتدرج Daftra ملفاً لقطاع العقارات والإنشاءات مع إدارة المشاريع، ويغطي Odoo المشاريع إلى جانب المحاسبة؛ أما البقية فأدوات وخدمات للفوترة الإلكترونية أو المحاسبة أو أنظمة ERP عامة. وإلى جانب الفوترة: <strong>الضريبة العامة على المبيعات ١٦٪</strong> بموجب القانون رقم ٦ لسنة ١٩٩٤، مع نسب مخفّضة وصفرية وإعفاءات لسلع وخدمات محدّدة؛ والتسجيل والتصنيف لدى <strong>نقابة مقاولي الإنشاءات</strong>، إذ لا يجوز لأي وزارة أو بلدية أو شركة توقيع عقد أشغال مع مقاول غير مسجّل ومصنّف فيها؛ و<strong>اشتراكات الضمان الاجتماعي</strong>: ١٤٫٢٥٪ من الأجر المؤمَّن عليه على صاحب العمل و٧٫٥٪ على العامل، بحسب ملخص PwC الضريبي.
      </p>
    </section>

    {cats.map((cat) => {
      const cv = vendors.filter((v) => v.category === cat.key);
      if (cv.length === 0) return null;
      return (
        <section class="mb-12">
          <div class="mb-5">
            <h2 class="text-2xl font-bold text-slate-900">{cat.label}</h2>
            <p class="mt-1 text-sm text-slate-600 leading-relaxed">{cat.desc}</p>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            {cv.map((v) => {
              const isCert = v.category === 'certification';
              const tierColor = v.tier === 'S' ? 'border-emerald-300' : v.tier === 'F' ? 'border-rose-300' : 'border-blue-300';
              const tierBadge = v.tier === 'S' ? 'bg-emerald-100 text-emerald-900' : v.tier === 'F' ? 'bg-rose-100 text-rose-900' : 'bg-blue-100 text-blue-900';
              const label = isCert ? 'جهة رسمية' : tierAr[v.tier];
              return (
                <article class={`rounded-lg border-2 ${tierColor} bg-white p-4`}>
                  <div class="mb-1 flex items-center gap-2 flex-wrap">
                    <h3 class="text-lg font-bold text-slate-900">{v.name}</h3>
                    <span class={`rounded-full px-2 py-0.5 text-xs font-bold ${tierBadge}`}>{label}</span>
                  </div>
                  <p class="text-sm text-slate-700 leading-relaxed">{ar[v.slug] ?? v.tagline}</p>
                  <div class="mt-3 flex flex-wrap gap-2">
                    <a href={`/jo/${v.slug}/`} class="rounded-md bg-slate-900 px-3 py-1.5 text-xs font-semibold text-white hover:bg-slate-700">التفاصيل (بالإنجليزية) ←</a>
                    <a href={v.vendor_url} rel="sponsored nofollow noopener" target="_blank" class="rounded-md bg-orange-500 px-3 py-1.5 text-xs font-semibold text-white hover:bg-orange-600">{isCert ? 'الموقع الرسمي' : 'زيارة الموقع'} ←</a>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      );
    })}

    <section class="mb-10 rounded-lg border border-slate-200 bg-white p-5 text-sm text-slate-600">
      <p>المراجعات التفصيلية لكل منتج متاحة <a href="/jo/" class="font-medium text-orange-600 hover:underline">بالإنجليزية</a>.</p>
    </section>

    <section class="rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">هل أنت مزوّد برامج أردني؟</h2>
      <p class="mt-2 text-slate-300 leading-relaxed">إذا كنت تطوّر برامج للمقاولات أو المحاسبة أو الفوترة الوطنية أو الرواتب للسوق الأردني وترغب في المراجعة أو الإدراج، تواصل معنا عبر <a href="/for-vendors/" class="underline">برنامج المزوّدين</a>.</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/for-vendors/" class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600">العمل معنا ←</a>
        <a href="/jo/" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">English directory</a>
      </div>
    </section>
  </article>
</Layout>
