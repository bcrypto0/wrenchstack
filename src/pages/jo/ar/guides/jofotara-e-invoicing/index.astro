---
import Layout from '../../../../../layouts/Layout.astro';

const tools = [
  { name: 'InvoiceQ', status: 'طبقة فوترة إلكترونية تربط أنظمة ERP والمحاسبة القائمة بالدائرة', fit: 'منشآت تريد الإبقاء على نظامها المحاسبي الحالي', note: 'من ١٢٠ ديناراً/سنة', href: '/jo/invoiceq/' },
  { name: 'Mozon', status: 'نظام ERP من عمّان بوحدة مقاولات؛ تذكر صفحة ERP لديها التكامل مع الفوترة الوطنية', fit: 'مقاولون يريدون نظام ERP بميزات للمقاولات', note: 'حسب الطلب', href: '/jo/mozon/' },
  { name: 'Odoo', status: 'وحدة فوترة وطنية مدمجة (l10n_jo_edi؛ UBL 2.1 ورمز QR) تتطلّب بيانات اعتماد من الدائرة', fit: 'منشآت تريد نظام ERP واحداً', note: 'أسعار منشورة بالدولار لكل مستخدم؛ التنفيذ بتكلفة إضافية', href: '/jo/odoo/' },
  { name: 'Daftra', status: 'تقول إنها ترتبط مباشرة بالمنصة الوطنية مع رمز QR تلقائي', fit: 'محاسبة ومخزون وعلاقات عملاء وموارد بشرية في اشتراك واحد', note: 'أسعار منشورة بالدولار؛ تجربة ١٤ يوماً', href: '/jo/daftra/' },
  { name: 'FawtraPlus', status: 'يصدر فواتير الفوترة الوطنية برمز QR وضريبة ١٦٪؛ يقول إنه معتمد من الدائرة', fit: 'منشآت ومهنيون مستقلون يريدون خطة سنوية واحدة منخفضة التكلفة', note: '٥٠ ديناراً/سنة', href: '/jo/fawtraplus/' },
  { name: 'Fatwarti', status: 'يقول إنه يرسل الفواتير مباشرة عبر الواجهة البرمجية الرسمية؛ محاسبة + نقاط بيع', fit: 'منشآت تريد محاسبة ومخزوناً ونقاط بيع', note: 'بلا أسعار منشورة (تجربة مجانية)', href: '/jo/fatwarti/' },
  { name: 'Tax2Gov (T2G)', status: 'موصّل برمجي يربط أنظمة ERP ونقاط البيع القائمة بالفوترة الوطنية', fit: 'أبقِ نظامك وأضف الربط', note: 'حسب الطلب', href: '/jo/tax2gov/' },
  { name: 'Zoho Books / QuickBooks', status: 'لا تذكر Zoho ولا Intuit أي تكامل مع الفوترة الوطنية؛ وتدرج InvoiceQ نظام QuickBooks ضمن الأنظمة التي تربطها', fit: 'منشآت تستخدم هذه الأدوات العالمية', note: 'راجع المراجعة التفصيلية', href: '/jo/zoho-books/' },
];

const faqs = [
  { q: 'هل الفوترة الوطنية إلزامية الآن، ولمن؟', a: 'أفادت الصحافة الأردنية بأن استخدام نظام الفوترة الوطني أصبح إلزامياً منذ مطلع أبريل ٢٠٢٥. ويعترف نظام الفوترة لدى الدائرة، بصيغته المعدّلة عام ٢٠٢٣، بالفواتير الإلكترونية الصادرة عبر النظام أو عبر برامج مرتبطة به. ويصبح التسجيل في الضريبة العامة على المبيعات إلزامياً عند تجاوز المبيعات حدوداً تختلف بين السلع والخدمات، فتحقّق من التزاماتك مع الدائرة أو محاسبك. وكانت هناك فترة سماح من الغرامات حتى ٣١ مايو ٢٠٢٥ لمن سجّل وتكامل في حينه.' },
  { q: 'ما هو نموذج «التخليص»؟', a: 'تعتمد الفوترة الوطنية نموذج تخليص مركزي (رقابة لحظية على المعاملات): يجب إرسال كل فاتورة إلى الدائرة عبر المنصة وتخليصها قبل إصدارها قانونياً للمشتري. وعند التخليص تُعيد الدائرة رمز QR فريداً يجب أن يظهر على الفاتورة النهائية. وهذا أكثر صرامة من الإبلاغ اللاحق، إذ ترى السلطة الفاتورة وتوافق عليها فورياً.' },
  { q: 'ماذا يحدث إن لم ألتزم؟', a: 'يعترف نظام الفوترة لدى الدائرة بالفواتير الإلكترونية الصادرة عبر الفوترة الوطنية أو عبر برامج مرتبطة بها، فتأكّد أن فواتيرك كذلك. والغرامات تصل إلى ٥٠٠ دينار لكل مخالفة. وتُفرض على التأخّر في دفع ضريبة المبيعات غرامة أربعة بالألف من الضريبة المستحقة عن كل أسبوع تأخير، بحسب الأسئلة الشائعة للدائرة. كما نفّذت الدائرة حملات تفتيش ميدانية؛ ففي مطلع ٢٠٢٦ أبلغت رسمياً ٣٧٩ منشأة ومنحتها مهلة أسبوع للتصويب قبل الإجراء القانوني.' },
  { q: 'ما الصيغة وما الأساس القانوني؟', a: 'الفواتير بصيغة XML أو JSON متوافقة مع معيار UBL 2.1، مع توقيع رقمي إلزامي ورمز QR المخلّص. ويعترف نظام الفوترة لدى الدائرة، بصيغته المعدّلة عام ٢٠٢٣، بالفواتير الإلكترونية الصادرة عبر الفوترة الوطنية أو عبر برامج مرتبطة بها. ويدير النظام دائرة ضريبة الدخل والمبيعات التابعة لوزارة المالية، وهي التي تدير قانون ضريبة الدخل رقم ٣٤ لسنة ٢٠١٤ وقانون الضريبة العامة على المبيعات رقم ٦ لسنة ١٩٩٤.' },
  { q: 'هل يجب أن يكون برنامجي متكاملاً أصلاً مع الفوترة الوطنية؟', a: 'ليس بالضرورة، لكن يجب إصدار الفواتير عبر الفوترة الوطنية أو عبر برامج مرتبطة بها. تقول InvoiceQ وDaftra وFawtraPlus وFatwarti إن منتجاتها ترسل الفواتير إلى الفوترة الوطنية، وتذكر صفحة ERP لدى Mozon التكامل معها، ويتضمّن Odoo وحدة للفوترة الوطنية (l10n_jo_edi) تتطلّب رقم النشاط ومعرّف العميل والمفتاح السري من الدائرة. وتبيع InvoiceQ وTax2Gov موصّلات للأنظمة القائمة، وتدرج InvoiceQ نظام QuickBooks ضمن الأنظمة التي تربطها. ولا تذكر Zoho أي تكامل مع الفوترة الوطنية لـ Zoho Books. ولا تنشر الدائرة قائمة بالبرامج المعتمدة. والسؤال الصحيح لأي مزوّد: «هل ترسل الفواتير إلى الفوترة الوطنية مباشرة، أم أي موصّل أحتاج؟»' },
  { q: 'ما السياق الضريبي الأردني الأوسع؟', a: 'ضريبة المبيعات العامة ١٦٪ (تختلف عن ١٥٪ في السعودية و٥٪ في الإمارات، فيجب ضبط البرنامج على الأردن). وضريبة دخل الشركات ٢٠٪ عموماً (أعلى لبعض القطاعات). واشتراكات الضمان الاجتماعي نحو ٢١٫٧٥٪ من الأجر المؤمَّن عليه (١٤٫٢٥٪ على صاحب العمل و٧٫٥٪ على العامل) بحسب PwC. وتُدفع الضرائب عبر «إي فواتيركم».' },
];

const pageTitle = 'الفوترة الوطنية (JoFotara) في الأردن: دليل ٢٠٢٦ للمقاولين';
const pageDescription = 'شرح نظام الفوترة الوطنية الأردني للبناء والمقاولات: الأساس القانوني، وكيف تُتحقَّق الفواتير، وبدء الإلزام في أبريل ٢٠٢٥ بحسب تقارير صحفية، وأي الأنظمة في دليلنا تقول إنها ترتبط بالفوترة الوطنية. نُشر في يونيو ٢٠٢٦ وحُدّث في سبتمبر ٢٠٢٦.';

const enUrl = new URL('/jo/guides/jofotara-e-invoicing/', Astro.site).toString();
const arUrl = new URL('/jo/ar/guides/jofotara-e-invoicing/', Astro.site).toString();

const articleSchema = {
  '@context': 'https://schema.org', '@type': 'Article', headline: pageTitle, description: pageDescription,
  datePublished: '2026-06-20', dateModified: '2026-09-30', inLanguage: 'ar',
  author: { '@type': 'Organization', name: 'WrenchStack Research', url: 'https://wrenchstack.com/research/' },
  publisher: { '@type': 'Organization', name: 'WrenchStack', url: 'https://wrenchstack.com' },
  mainEntityOfPage: arUrl,
};
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Layout title={pageTitle} description={pageDescription} lang="ar" dir="rtl" alternateUrls={[{ hreflang: 'en', href: enUrl }, { hreflang: 'ar', href: arUrl }, { hreflang: 'x-default', href: enUrl }]}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <article class="mx-auto max-w-4xl px-4 py-12">
    <header class="mb-8">
      <div class="mb-3 flex items-center justify-between gap-3">
        <p class="text-sm font-semibold uppercase tracking-wider text-orange-600">🇯🇴 الأردن · دليل امتثال</p>
        <a href="/jo/guides/jofotara-e-invoicing/" class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">English</a>
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        الفوترة الوطنية (JoFotara) في الأردن
      </h1>
      <p class="mt-3 text-lg text-slate-600 leading-relaxed">
        ماذا يعني نظام الفوترة الإلكترونية الوطني للبناء والمقاولات: كيف تُتحقَّق الفواتير، وما الذي يعترف به نظام الفوترة لدى الدائرة، وما الذي يجب التحقّق منه قبل العطاءات الحكومية، وأي الأنظمة تقول إنها ترتبط بالفوترة الوطنية.
      </p>
      <p class="mt-3 text-sm text-slate-500">إعداد WrenchStack Research · نُشر في يونيو ٢٠٢٦ وحُدّث في سبتمبر ٢٠٢٦ · ليس استشارة ضريبية. تحقّق من وضعك مع الدائرة (istd.gov.jo) أو محاسبك.</p>
    </header>

    <section class="mb-8 rounded-lg border-2 border-orange-300 bg-orange-50 p-6">
      <h2 class="mb-2 text-lg font-bold text-slate-900">⏰ باختصار</h2>
      <p class="text-slate-800 leading-relaxed">
        نظام <strong>الفوترة الوطنية</strong> الأردني تديره دائرة ضريبة الدخل والمبيعات. ويعترف نظام الفوترة لدى الدائرة، بصيغته المعدّلة عام ٢٠٢٣، بالفواتير الإلكترونية الصادرة عبر النظام أو عبر برامج مرتبطة به، وأفادت الصحافة الأردنية بأن استخدامه أصبح <strong>إلزامياً منذ مطلع أبريل ٢٠٢٥</strong>. وتُتحقَّق الفواتير لحظياً وتحمل <strong>رمز QR</strong> من الفوترة الوطنية يمكن فحصه في تطبيق «سند» (بمعيار UBL 2.1 بحسب Odoo). ولا تنشر الدائرة قائمة بالبرامج المعتمدة. والمهمة العملية: تأكّد أن أداة الفوترة لديك مرتبطة بالفوترة الوطنية، مباشرة أو عبر موصّل، وتحقّق من نطاق الربط مع المزوّد.
      </p>
    </section>

    <section class="mb-10 grid gap-3 sm:grid-cols-3">
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">أبريل ٢٠٢٥</div>
        <div class="mt-1 text-xs text-slate-600">بدء الإلزام بحسب تقارير صحفية</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">١٦٪</div>
        <div class="mt-1 text-xs text-slate-600">الضريبة العامة على المبيعات</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">تخليص</div>
        <div class="mt-1 text-xs text-slate-600">قبل الإصدار · UBL 2.1 + QR</div>
      </div>
    </section>

    <section class="mb-10 prose prose-slate max-w-none">
      <h2>الجدول الزمني</h2>
      <ul>
        <li><strong>ديسمبر ٢٠٢٢</strong>: إطلاق منصة الفوترة الوطنية، تسجيل اختياري.</li>
        <li><strong>يناير ٢٠٢٣</strong>: بدء التسجيل الإلزامي للمرحلة الأولى (كبار المكلّفين).</li>
        <li><strong>مطلع أبريل ٢٠٢٥</strong>: أفادت الصحافة الأردنية بأن استخدام نظام الفوترة الوطني أصبح إلزامياً.</li>
        <li><strong>٣١ مايو ٢٠٢٥</strong>: نهاية فترة الإعفاء من الغرامات لمن سجّل وتكامل في حينه.</li>
        <li><strong>~فبراير ٢٠٢٦</strong>: حملة تفتيش ميدانية (إبلاغ ٣٧٩ منشأة رسمياً بعدم الامتثال)، مع مهلة أسبوع للتصويب قبل الإجراء القانوني.</li>
      </ul>

      <h2>ما يتطلّبه النظام</h2>
      <ul>
        <li><strong>تخليص، لا إبلاغ.</strong> تُرسل كل فاتورة إلى الدائرة وتُخلَّص قبل إصدارها قانونياً؛ ودون التخليص والمعرّف/الرمز لا تكون الفاتورة صحيحة.</li>
        <li><strong>صيغة مهيكلة.</strong> XML أو JSON متوافقة مع <strong>UBL 2.1</strong> وبتوقيع رقمي إلزامي؛ وتُعيد الدائرة رمز <strong>QR</strong> فريداً يجب أن يظهر على الفاتورة.</li>
        <li><strong>مسار التكامل.</strong> عبر بوابة الفوترة الوطنية أو تطبيق «فواتيري»، أو عبر برامج مرتبطة بالنظام، وهنا يأتي دور مزوّدين مثل InvoiceQ وMozon وDaftra وOdoo وTax2Gov. ولا تنشر الدائرة قائمة بالبرامج المعتمدة.</li>
        <li><strong>تحقّق من نطاق التزامك.</strong> يصبح التسجيل في الضريبة العامة على المبيعات إلزامياً عند تجاوز المبيعات حدوداً تختلف بين السلع والخدمات، ويجب إصدار الفواتير عبر الفوترة الوطنية أو عبر برامج مرتبطة بها؛ تحقّق من التزاماتك مع الدائرة أو محاسبك.</li>
      </ul>

      <h2>لماذا يهمّ هذا المقاولين تحديداً</h2>
      <p>
        بالنسبة للمقاول، يشمل ذلك الفواتير التي تصدرها لعملائك والفواتير التي تتلقّاها من مقاولي الباطن والموردين. <strong>يجب إصدار الفواتير عبر الفوترة الوطنية أو عبر برامج مرتبطة بها</strong>، فتأكّد أن برنامجك المحاسبي مرتبط بها. وللعطاءات الحكومية متطلّباتها الخاصة: تقول دائرة العطاءات الحكومية إن على المقاولين تفعيل خدمة «سند» لتقديم العروض إلكترونياً على <a href="/jo/joneps/">JONEPS</a>، ولا يجوز لأي وزارة أو بلدية أو شركة توقيع عقد أشغال مع مقاول غير مسجّل ومصنّف لدى نقابة مقاولي الإنشاءات. ومن البرامج في دليلنا، تبيع Mozon وحدة لإدارة المقاولات (الموازنات ومقاولو الباطن والفواتير المرحلية)، ويغطي Odoo المشاريع إلى جانب المحاسبة؛ ومعظم الأدوات الأخرى برامج فوترة إلكترونية أو محاسبة، فقد تحتاج إلى أداة منفصلة لإدارة المشاريع.
      </p>

      <h2>السياق الضريبي الأوسع</h2>
      <ul>
        <li><strong>ضريبة المبيعات:</strong> ١٦٪ (تختلف عن ١٥٪ بالسعودية و٥٪ بالإمارات، فاضبط البرنامج على الأردن).</li>
        <li><strong>ضريبة دخل الشركات:</strong> ٢٠٪ عموماً (أعلى لبعض القطاعات).</li>
        <li><strong>الضمان الاجتماعي:</strong> اشتراكات بنحو ٢١٫٧٥٪ من الأجر المؤمَّن عليه (١٤٫٢٥٪ على صاحب العمل و٧٫٥٪ على العامل) بحسب PwC؛ ويمكن دفع الفواتير الضريبية عبر «إي فواتيركم».</li>
      </ul>

      <h2>أي الأنظمة ترتبط بالفوترة الوطنية؟</h2>
      <p>
        من البرامج في <a href="/jo/ar/">دليل الأردن</a>، إليك ما يقوله كل مزوّد عن الفوترة الوطنية. لا تذكر Zoho ولا Intuit أي تكامل مع الفوترة الوطنية لـ Zoho Books أو QuickBooks، وتدرج InvoiceQ نظام QuickBooks ضمن الأنظمة التي تربطها. ولا تنشر الدائرة قائمة بالبرامج المعتمدة، فتحقّق دائماً من الحالة الحالية مع المزوّد.
      </p>
    </section>

    <section class="mb-10 overflow-x-auto">
      <table class="w-full text-sm border border-slate-200 rounded-lg overflow-hidden">
        <thead class="bg-slate-50 text-right text-slate-700">
          <tr>
            <th class="p-3 font-semibold">الأداة</th>
            <th class="p-3 font-semibold">حالة الفوترة الوطنية</th>
            <th class="p-3 font-semibold">يناسب</th>
            <th class="p-3 font-semibold">السعر</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 bg-white">
          {tools.map((t) => (
            <tr>
              <td class="p-3 font-semibold text-slate-900"><a href={t.href} class="hover:text-orange-600">{t.name}</a></td>
              <td class="p-3 text-slate-700">{t.status}</td>
              <td class="p-3 text-slate-600">{t.fit}</td>
              <td class="p-3 text-slate-600">{t.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="mt-3 text-xs text-slate-500">تعكس الحالة ما يقوله كل مزوّد عند التحقّق في سبتمبر ٢٠٢٦. لا تنشر الدائرة قائمة بالبرامج المعتمدة، فتحقّق من نطاق الربط مع كل مزوّد قبل الاعتماد عليه.</p>
    </section>

    <section class="mb-10 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-2 text-lg font-bold text-slate-900">السؤال الواحد لأي مزوّد</h2>
      <p class="text-sm text-slate-700 leading-relaxed">
