---
import Layout from '../../layouts/Layout.astro';
import joData from '../../data/international/jo.json';

interface JoVendor {
  slug: string; name: string; category: string; vendor_url: string;
  tagline: string; market_position: string; jo_specific_note?: string | null;
  tier: 'S' | 'A' | 'F'; reputation_flag: string | null;
  pros: string[]; cons: string[]; typical_pricing: string;
  is_cross_market: boolean; cross_market_link: string | null;
}

const vendors = (joData as { vendors: JoVendor[] }).vendors;
const categories = ['software', 'lead-gen', 'insurance', 'payroll', 'certification'];
const categoryMeta: Record<string, { label: string; description: string }> = {
  'software': { label: 'Accounting / invoicing & construction software', description: 'E-invoicing services that link existing systems to JoFotara (InvoiceQ and Tax2Gov); accounting and invoicing apps that say they send invoices to JoFotara (Daftra, FawtraPlus, Fatwarti); ERP suites (Mozon, which sells a contracting module; Odoo, whose Jordan localization includes a JoFotara module; ESKADENIA); an Amman Odoo implementation partner (Stride); and global accounting tools for which the vendor names no JoFotara integration (Zoho Books, QuickBooks).' },
  'lead-gen': { label: 'Tenders & lead generation', description: 'The government e-procurement portal (JONEPS), where public buyers post tender invitations and suppliers register and submit electronic bids, plus a paid tender-alert service (JordanTenders) that publishes annual prices in USD.' },
  'insurance': { label: 'Construction insurance: Contractors All Risks', description: 'Insurers whose own sites list engineering cover such as Contractors All Risks (JOFICO, gig Jordan, MEICO), plus Jordan Insurance Company (JIC), whose engineering products could not be confirmed on its site. None publishes prices; cover is quoted, and gig Jordan and MEICO take quote requests through online forms. MEICO stopped writing motor insurance from 1 January 2026.' },
  'payroll': { label: 'Payroll: SSC & income tax', description: 'Cloud HR and payroll suites: ZenHR (whose Jordan page states SSC and Labor Law calculations), MenaITech (MenaPAY, with an Amman office), Yomly (Dubai-based, with a Jordan payroll page) and GTS One (Amman). None publishes prices. Employers pay SSC contributions of 14.25% of insured wages and employees 7.5%, per PwC; ask each vendor how it calculates them.' },
  'certification': { label: 'Compliance & official bodies', description: 'The official bodies a Jordanian contractor deals with. Under the Construction Contractors Law a contractor is licensed, registers with the Ministry of Industry and Trade (through the CCD) and with the contractors association (JCCA), and is then classified. The list also covers the tax authority (ISTD, which runs JoFotara), the Jordan Engineers Association and Social Security (SSC).' },
};
const vendorsByCategory: Record<string, JoVendor[]> = {};
categories.forEach(c => { vendorsByCategory[c] = vendors.filter(v => v.category === c); });

const pageTitle = 'Jordan Construction & Trades Software (JoFotara) | WrenchStack';
const pageDescription = `Independent directory of ${vendors.length} vendors and official bodies for Jordan: accounting, invoicing and ERP software and its JoFotara links, public-tender access (JONEPS), payroll, and Contractors All Risks insurance, plus JoFotara e-invoicing (mandatory from April 2025, per press reports), JCCA registration and classification, and SSC contributions.`;
const breadcrumbs = [ { name: 'Home', url: '/' }, { name: 'Jordan', url: '/jo/' } ];
const enUrl = new URL('/jo/', Astro.site).toString();
const arUrl = new URL('/jo/ar/', Astro.site).toString();
---
<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs} alternateUrls={[{ hreflang: 'en', href: enUrl }, { hreflang: 'ar', href: arUrl }, { hreflang: 'x-default', href: enUrl }]}>
  <article class="mx-auto max-w-5xl px-4 py-12">
    <header class="mb-10">
      <div class="mb-3 flex items-center justify-between gap-3">
        <div class="flex items-center gap-2">
          <span class="text-2xl" aria-hidden="true">🇯🇴</span>
          <p class="text-sm font-semibold uppercase tracking-wider text-orange-600">Jordan · الأردن</p>
        </div>
        <a href="/jo/ar/" class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">العربية</a>
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">Jordan Construction & Trades Software Directory</h1>
      <p class="mt-4 text-lg text-slate-600 leading-relaxed">
        Independent reviews of {vendors.length} Jordan-relevant vendors and official bodies. Invoices in Jordan are issued through <strong>JoFotara</strong>, the national e-invoicing system of the Income and Sales Tax Department, or through software linked to it; Jordanian press reported that use became mandatory from the start of April 2025. Listed here: accounting, invoicing and ERP tools that say they link to JoFotara (InvoiceQ, Mozon, Daftra, Odoo and others), public-tender access (JONEPS), payroll software (ZenHR, MenaITech) and insurers that list Contractors All Risks cover (JOFICO, gig Jordan, MEICO), with local context: 16% general sales tax, JCCA registration and classification, and SSC contributions.
      </p>
    </header>

    <section class="mb-10 grid gap-3 grid-cols-2 sm:grid-cols-4">
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">{vendors.length}</div>
        <div class="mt-1 text-xs text-slate-600">vendors and official bodies</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">14.25%</div>
        <div class="mt-1 text-xs text-slate-600">employer SSC share (per PwC)</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">16%</div>
        <div class="mt-1 text-xs text-slate-600">General Sales Tax</div>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
        <div class="text-2xl font-bold text-slate-900">Apr 2025</div>
        <div class="mt-1 text-xs text-slate-600">JoFotara mandatory (press reports)</div>
      </div>
    </section>

    <section class="mb-10 flex flex-wrap items-center justify-between gap-4 rounded-lg border-2 border-emerald-300 bg-emerald-50 p-5">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-emerald-700">⏰ Compliance guide · JoFotara e-invoicing · mandatory from April 2025, per press reports</p>
        <h2 class="mt-1 text-base font-bold text-slate-900">JoFotara (الفوترة الوطنية) e-invoicing for Jordanian contractors</h2>
        <p class="mt-1 text-sm text-slate-700">How JoFotara works for contractors, which invoices the ISTD invoicing regulation recognises, what to check before a public tender, and which tools in this directory say they link to JoFotara.</p>
      </div>
      <a href="/jo/guides/jofotara-e-invoicing/" class="shrink-0 rounded-md bg-emerald-700 px-5 py-3 text-sm font-semibold text-white hover:bg-emerald-800">Read the guide →</a>
    </section>

    <section class="mb-10 flex flex-wrap items-center justify-between gap-4 rounded-lg border border-orange-200 bg-orange-50 p-5">
      <div>
        <h2 class="text-base font-bold text-slate-900">Deciding between two options?</h2>
        <p class="mt-1 text-sm text-slate-700">See Jordanian vendors compared side by side: a clear verdict, pros and cons, Jordan-specific notes, and pricing, head to head.</p>
      </div>
      <a href="/jo/compare/" class="shrink-0 rounded-md bg-slate-900 px-5 py-3 text-sm font-semibold text-white hover:bg-slate-700">Compare Jordanian vendors →</a>
    </section>

    <section class="mb-10 rounded-lg bg-slate-50 p-6">
      <h2 class="mb-3 text-base font-bold text-slate-900">What’s different about choosing software in Jordan</h2>
      <p class="text-sm text-slate-700 leading-relaxed">
        Invoicing is the first thing to check. The invoicing regulation of the Income and Sales Tax Department (ISTD), as amended in 2023, recognises electronic invoices issued through the national <strong>JoFotara</strong> system or through software linked to it, and Jordanian press reported that use of the system became mandatory from the start of April 2025. ISTD publishes no list of approved software, so treat any approval claim as the vendor's own and confirm the integration scope before you buy. Among the software listed here, Mozon sells a contracting module (budgets, subcontractors and progress invoicing), Daftra lists a Real Estate & Construction industry profile with project management, and Odoo covers projects alongside accounting; the rest are e-invoicing, accounting or general ERP tools and services. Beyond invoicing: <strong>16% general sales tax</strong> under Law No. 6 of 1994, with reduced, zero and exempt rates for listed goods and services; registration and classification with the <strong>Jordan Construction Contractors Association</strong>, without which no ministry, municipality or company may sign a works contract with you; and <strong>Social Security contributions</strong> of 14.25% of insured wages from the employer and 7.5% from the employee, per PwC's tax summary.
      </p>
    </section>

    {categories.map(c => {
      const cat = categoryMeta[c];
      const cv = vendorsByCategory[c];
      if (cv.length === 0) return null;
      return (
        <section class="mb-12">
          <div class="mb-5">
            <h2 class="text-2xl font-bold text-slate-900">{cat.label}</h2>
            <p class="mt-1 text-sm text-slate-600 leading-relaxed">{cat.description}</p>
          </div>
          <div class="space-y-4">
            {cv.map(v => {
              const isCert = v.category === 'certification';
              const tierColor = v.tier === 'S' ? 'border-emerald-300' : v.tier === 'F' ? 'border-rose-300' : 'border-blue-300';
              const tierLabel = isCert ? 'Official body / regime' : v.tier === 'S' ? 'Published prices' : v.tier === 'F' ? 'Reputation warning' : 'Listed';
              const tierBadge = v.tier === 'S' ? 'bg-emerald-100 text-emerald-900' : v.tier === 'F' ? 'bg-rose-100 text-rose-900' : 'bg-blue-100 text-blue-900';
              return (
                <article class={`rounded-lg border-2 ${tierColor} bg-white p-5`}>
                  <div class="mb-3 flex items-start justify-between gap-3">
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-2 mb-1 flex-wrap">
                        <h3 class="text-xl font-bold text-slate-900">{v.name}</h3>
                        <span class={`rounded-full px-2 py-0.5 text-xs font-bold ${tierBadge}`}>{isCert ? tierLabel : `Tier ${v.tier} · ${tierLabel}`}</span>
                        {v.is_cross_market && (<span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-700">Cross-market</span>)}
                      </div>
                      <p class="text-sm italic text-slate-500">{v.tagline}</p>
                    </div>
                  </div>
                  <p class="mb-3 text-sm text-slate-700 leading-relaxed">{v.market_position}</p>
                  {v.reputation_flag && (
                    <div class="mb-3 rounded-md border-l-4 border-amber-400 bg-amber-50 px-4 py-2">
                      <p class="text-sm text-amber-900 leading-relaxed"><strong>Heads up:</strong> {v.reputation_flag}</p>
                    </div>
                  )}
                  {v.jo_specific_note && (
                    <div class="mb-3 rounded-md bg-slate-50 px-4 py-3">
                      <p class="text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Jordan-specific note</p>
                      <p class="text-sm text-slate-700 leading-relaxed">{v.jo_specific_note}</p>
                    </div>
                  )}
                  <div class="mb-3 grid gap-3 sm:grid-cols-2">
                    <div>
                      <p class="text-xs font-bold uppercase tracking-wider text-emerald-700 mb-1">{isCert ? 'What it covers' : 'Pros'}</p>
                      <ul class="space-y-1 text-sm text-slate-700">{v.pros.slice(0, 4).map(p => <li class="leading-snug">+ {p}</li>)}</ul>
                    </div>
                    <div>
                      <p class="text-xs font-bold uppercase tracking-wider text-rose-700 mb-1">{isCert ? 'Watch out for' : 'Cons'}</p>
                      <ul class="space-y-1 text-sm text-slate-700">{v.cons.slice(0, 4).map(con => <li class="leading-snug">− {con}</li>)}</ul>
                    </div>
                  </div>
                  <div class="mb-3 text-xs text-slate-600"><strong class="text-slate-900">{isCert ? 'Cost / access:' : 'Typical Jordan pricing:'}</strong> {v.typical_pricing}</div>
                  <div class="flex flex-wrap gap-2">
                    <a href={`/jo/${v.slug}/`} class="rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700">Full Jordan review →</a>
                    <a href={v.vendor_url} rel="sponsored nofollow noopener" target="_blank" class="rounded-md bg-orange-500 px-4 py-2 text-sm font-semibold text-white hover:bg-orange-600">{isCert ? 'Official site' : `Visit ${v.name}`} →</a>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      );
    })}

    <section class="mt-12 rounded-lg bg-slate-900 p-8 text-white">
      <h2 class="text-2xl font-bold">Are you a Jordanian software vendor?</h2>
      <p class="mt-2 text-slate-300 leading-relaxed">If you build software or services for Jordanian contractors and the building trades and want to be reviewed or featured, get in touch through our <a href="/for-vendors/" class="underline">vendor program</a>.</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/for-vendors/" class="rounded-md bg-orange-500 px-5 py-3 text-sm font-semibold text-white hover:bg-orange-600">Work with us →</a>
        <a href="/sa/" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">🇸🇦 Saudi directory</a>
        <a href="/methodology/" class="rounded-md border border-white/30 bg-white/10 px-5 py-3 text-sm font-semibold text-white hover:bg-white/20">Methodology</a>
      </div>
    </section>
  </article>
</Layout>
